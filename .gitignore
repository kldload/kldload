# Build artifacts
live-build/chroot/
live-build/binary/
live-build/cache/
live-build/output/
live-build/.build/
*.hybrid.iso
*.iso

# Darksite build output (downloaded packages — regenerated at build time)
live-build/config/includes.chroot/root/darksite/

# Docker builder cache
builder/.cache/

# Logs
*.log
logs/

# Secrets
*.key
*.crt
*.pem
/etc/kldload/

# Editor
.vscode/
*.swp
*~

# Python bytecode (kldload-webui + kldload-doctor are scripts)
__pycache__/
*.pyc
html/
kldload.env

# Local-only files (per-operator, seeded from a separate setup repo).
# These paths can appear in the working tree but never belong in git.
CLAUDE.md
# ...and the timestamped backups the setup repo's restore leaves behind.
# Only the bare name was ignored, so CLAUDE.md.bak.<stamp> sat untracked and
# committable in a repo whose rule is that no such file ever appears in it.
# One `git add -A` was all it would have taken (found 2026-08-15).
CLAUDE.md.bak.*
anaconda/
live-build/zxplore-cache/
live-build/wgxplore-cache/
live-build/vmxplore-cache/
# A local vmxplore checkout or a stray build lands here on some machines.
# The ISO builds it from github.com/vmxplore/vmxplore (build-iso.sh), never
# from this path, so anything here is scratch — see the 62dd863 rationale.
vmxplore/
live-build/darksite-debian-cache/
live-build/darksite-ubuntu-cache/
live-build/darksite-arch-cache/
live-build/darksite-fedora-cache/
live-build/darksite-bsd-cache/
live-build/darksite-ubuntu-cache.bak/
live-build/darksite-bsd-cache.bak/
live-build/darksite-alpine-cache/
live-build/darksite-arch-cache/
autoinstall.env

# Darksite caches (built artifacts, regenerated at build time)
live-build/darksite-ollama-cache/
live-build/darksite-fedora-cache/
live-build/darksite-alpine-cache/
live-build/darksite-bsd-cache/
live-build/darksite-ollama-cache*

# Local user-config state directory — per-machine, may contain credentials
.claude/

# Workflow launcher / standing-orders (live in /root, contain secrets — never track)
go.sh
standing-orders.md
standing-orders-guard.sh

# Local-only planning drafts / orphaned release notes — keep on disk, out of git
/plan-*.md
/RELEASE_NOTES-*.md
wg/.gotmp/

# Renamed caches fell OUTSIDE the patterns above and got committed once
# (2410 .deb files, commit 00783095). Catch any future rename.
live-build/darksite-*-cache.old/
live-build/*-cache.bak/
wg/wgx
wg/wgx-tui
wg/.buildnum
wg/.gotmp/
