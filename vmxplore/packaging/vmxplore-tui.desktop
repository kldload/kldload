# vmxplore terminal edition — the static TUI (vmx), for people who live in
# a terminal. Terminal=true: the desktop's default terminal hosts it, so
# the running window groups under the terminal's dock identity — accepted,
# same as zxplore-tui (a second terminal emulator just for the icon was
# operator-vetoed 2026-08-07).
#
# NoDisplay=true (operator call 2026-08-09): "only the GUI version needs the
# icon, the TUI version is launchable from terminal." Two grid tiles for one
# tool, differing only in which surface starts, is the duplication the app
# grid was just cleaned up to remove. The file stays because it is still the
# window matcher and remains launchable by name — `vmx --tui` from any shell,
# or gtk-launch vmxplore-tui — it simply does not take a tile.
[Desktop Entry]
Type=Application
Name=vmxplore (terminal)
GenericName=VM Console — TUI
Comment=The ZFS-aware VM estate console, terminal edition
Exec=vmx --tui
Icon=vmxplore
Terminal=true
Categories=System;Monitor;ConsoleOnly;
Keywords=vm;kvm;libvirt;virsh;zfs;zvol;snapshot;estate;console;tui;
NoDisplay=true
