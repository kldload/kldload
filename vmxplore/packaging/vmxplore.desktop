# vmxplore launcher — the native GUI (the primary surface). Terminal=false:
# the Fyne window titles itself EXACTLY "vmxplore", GLFW turns that into the
# WM_CLASS, and the shell maps it to this file for the dock icon — so the
# window title, this file's basename and StartupWMClass must all agree
# (the zxplore lesson; change one, change all three).
[Desktop Entry]
Type=Application
Name=vmxplore
GenericName=VM Console
Comment=The ZFS-aware VM estate console — every domain joined to the zvol under it, lineage and all
Exec=vmxplore
Icon=vmxplore
Terminal=false
StartupWMClass=vmxplore
Categories=System;Monitor;
Keywords=vm;kvm;libvirt;virsh;zfs;zvol;clone;snapshot;estate;console;
