[Desktop Entry]
Type=Application
Name=OpenZFS Test Lab
GenericName=OpenZFS test suite, metrics and tracing
Comment=Run zfs-tests.sh across the distro matrix and watch the kernel while it happens
# Categories: System ONLY as the main category. Listing Development as well
# is accurate — the audience is people who work ON OpenZFS — but two main
# categories means two entries in the app grid, and "one grid, no duplicates"
# was hard-won. The Development audience is served by Keywords instead.
Categories=System;Monitor;
Keywords=zfs;openzfs;test;zfs-tests;ztest;ebpf;arc;kernel;lab;
Exec=/usr/local/bin/ztx
Icon=ztxplore
Terminal=false
StartupNotify=true
# StartupWMClass must match the app_id the toolkit actually emits or the
# window gets a generic icon and a second dock entry. Fyne derives the X11
# class from the WINDOW TITLE, so this is windowTitle in main.go verbatim.
StartupWMClass=OpenZFS Test Lab
