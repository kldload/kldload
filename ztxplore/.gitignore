# Build artefacts. Two binaries come out of this tree and neither belongs in
# git; builder/build-iso.sh compiles both from source.
ztx
ztx-tui
# `go build ./...` names the executable after the DIRECTORY.
/ztxplore
.buildnum

# `go test` execs its compiled test binary out of TMPDIR, and hardened hosts
# mount /tmp noexec — an opaque "fork/exec: permission denied" that looks
# like a broken suite. The Makefile points TMPDIR here instead.
.testtmp/
