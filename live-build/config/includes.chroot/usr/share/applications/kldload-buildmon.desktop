[Desktop Entry]
Type=Application
Name=kldload Build & Audit
GenericName=Build progress and install audit
Comment=What the system is still building, and whether the install actually worked
# Categories: System so it lands in the System folder beside the other
# operator tools rather than in Utilities, where nobody looks for it during an
# install. X-GNOME-Settings-Panel is deliberately absent — this is a window,
# not a settings page.
Categories=System;Monitor;
Keywords=build;progress;install;audit;doctor;components;
Exec=/usr/local/bin/kldload-buildmon
Icon=kldload-buildmon
Terminal=false
StartupNotify=true
# StartupWMClass must match the app_id the toolkit actually emits, or the
# window gets a generic icon and a second entry in the dock. Fyne sets it from
# the binary name.
StartupWMClass=kldload-buildmon
