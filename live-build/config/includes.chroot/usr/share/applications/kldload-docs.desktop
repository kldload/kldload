[Desktop Entry]
Name=KLDload Documentation
GenericName=KLDload Help and Docs
Comment=Command reference, ZFS guides, and kldload documentation
Exec=gnome-terminal -- bash -c 'kldload-help; echo ""; echo "Online docs: https://kldload.com/docs"; echo "Press Enter to close."; read'
Icon=help-browser
Terminal=false
Type=Application
Categories=System;Documentation;
Keywords=kldload;help;docs;zfs;documentation;
StartupNotify=false
