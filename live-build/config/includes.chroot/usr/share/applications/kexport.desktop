[Desktop Entry]
Name=Export Disk Image
GenericName=Disk Image Exporter
Comment=Export this system to qcow2, VMDK, VHD, OVA, or raw image
Exec=gnome-terminal -- bash -c 'echo "kexport — export this disk to a VM image"; echo ""; kexport --help 2>/dev/null || kexport; echo ""; echo "Example: sudo kexport /dev/vda qcow2 ~/Desktop"; echo ""; exec bash'
Icon=media-floppy
Terminal=false
Type=Application
Categories=System;Utility;
Keywords=kexport;kldload;image;qcow2;vmdk;vhd;ova;export;
StartupNotify=false
