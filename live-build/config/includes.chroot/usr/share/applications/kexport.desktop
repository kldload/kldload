[Desktop Entry]
Name=Export Disk Image
GenericName=Disk Image Exporter
Comment=Export this system to qcow2, VMDK, VHD, OVA, or raw image
Exec=kldload-term kexport
Icon=kexport
Terminal=false
Type=Application
Categories=Utility;
Keywords=kexport;kldload;image;qcow2;vmdk;vhd;ova;export;
StartupNotify=false
# Hidden on the grid since 2026-08-09: Export Disk Image is a tile in
# vmxplore's kldload tab. The launcher stays so the window matcher and any
# existing pin keep working.
NoDisplay=true
