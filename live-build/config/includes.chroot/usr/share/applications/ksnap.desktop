[Desktop Entry]
Name=Snapshot Manager
GenericName=ZFS Snapshot Manager
Comment=Create, list, rollback, and destroy ZFS snapshots
Exec=kldload-term ksnap list
Icon=ksnap
Terminal=false
Type=Application
Categories=System;Filesystem;
Keywords=ksnap;kldload;zfs;snapshot;rollback;
StartupNotify=false
# Consolidated into the single zexplore console (kldload-zexplore.desktop) — its snapshot
# create/list/rollback/destroy all live there now. Hidden from the grid; the
# `ksnap` CLI still works for scripts. (2026-07-26 ZFS-tool consolidation.)
NoDisplay=true
