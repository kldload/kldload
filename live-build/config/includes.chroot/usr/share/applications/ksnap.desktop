[Desktop Entry]
Name=Snapshot Manager
GenericName=ZFS Snapshot Manager
Comment=Create, list, rollback, and destroy ZFS snapshots
Exec=gnome-terminal -- bash -c 'ksnap list; echo ""; echo "Type ksnap --help for usage. Dropping to shell."; exec bash'
Icon=drive-harddisk
Terminal=false
Type=Application
Categories=System;Filesystem;
Keywords=ksnap;kldload;zfs;snapshot;rollback;
StartupNotify=false
