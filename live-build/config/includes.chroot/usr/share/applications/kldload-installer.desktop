[Desktop Entry]
# Window-matching entry for the INSTALLER window.
#
# The installer runs as a Chrome app with --class=com.kldload.installer, which
# kldload-webui-launch sets when the machine is in live/install mode. Nothing
# claimed that app id, so GNOME's window tracker found no match and fell back
# to its generic mark — the operator saw a blue diamond in the title bar
# (2026-09-13).
#
# kldload-webui.desktop claims com.kldload.webui, which is the id the CONTROL
# PLANE window uses. The two ids are different on purpose: the installer is a
# different thing wearing a different icon, and during an unattended install it
# is the only window on the screen.
#
# NoDisplay=true keeps it out of the app grid. It does not affect matching a
# running window to an icon, which is the only job this file has.
Type=Application
Name=kldload Installer
Comment=Install kldload to a disk
Exec=/usr/local/bin/kldload-webui-launch
Icon=kldload-installer
Terminal=false
Categories=System;
StartupWMClass=com.kldload.installer
NoDisplay=true
