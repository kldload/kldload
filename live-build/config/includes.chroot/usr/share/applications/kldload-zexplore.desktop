[Desktop Entry]
Name=zexplore
GenericName=ZFS Console
Comment=Browse, snapshot, replicate ZFS + explore VM filesystems — the one ZFS console (k9s for ZFS)
Exec=kldload-term --app zexplore
Icon=kldload-zfs
Terminal=false
Type=Application
Categories=System;Filesystem;
Keywords=zexplore;zfs;snapshot;replicate;dataset;pool;bookmark;boot environment;clone;send;receive;
StartupNotify=false
NoDisplay=true
