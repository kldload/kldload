[Desktop Entry]
Type=Application
Name=Bob: Banish / Summon
Comment=Click to toggle Bob in/out of VRAM. Loaded → unload (free ~9 GB for games). Unloaded → load (Bob ready in the webui). bobctl toggle handles either direction.
Exec=/usr/local/bin/bobctl toggle
Icon=bob-gaming
Terminal=false
Categories=Game;
Keywords=bob;ai;gpu;game;vram;ollama;
# Hidden on the live ISO (no Bob/Ollama to load until installed). The installer
# reveals it on the desktop profile — see profiles.sh.
NoDisplay=true
