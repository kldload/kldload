[Desktop Entry]
Type=Application
Name=wgxplore
GenericName=WireGuard Console
Comment=See and manage the WireGuard estate — every device, every peer, handshake-fresh or stale
Exec=wgx
Icon=wgxplore
Terminal=false
Categories=System;Network;
Keywords=wireguard;wg;vpn;mesh;network;peers;tunnel;
# WM_CLASS is derived by GLFW from the WINDOW TITLE ("wgxplore"), not from the
# Fyne app id — so this must match the title, and the file must be named after
# it, or the shell shows a generic dock icon. (zxplore lesson, 2026-08-02.)
StartupWMClass=wgxplore
