[Desktop Entry]
# Window-matching entry for the kldload Web UI / installer window.
#
# The UI window is opened by kldload-webui-launch (autostart) as a Chrome
# app with --class=com.kldload.webui. GNOME Shell matches a running window
# to a .desktop ONLY by files under /usr/share/applications (or
# ~/.local/share/applications) — NEVER the ~/.config/autostart entry. The
# autostart .desktop carried Icon=/StartupWMClass= but, living in autostart,
# was invisible to the window tracker, so the running UI fell back to the
# generic blue-diamond icon (live installer, 10.100.10.123 2026-06-14).
# This entry gives the window tracker the StartupWMClass→Icon binding it
# needs. NoDisplay=true keeps it out of the app grid (the UI is opened by
# autostart, not launched from the menu); NoDisplay does not affect
# running-window icon matching.
Type=Application
Name=kldload Web UI
Comment=kldload control plane and installer
Exec=/usr/local/bin/kldload-webui-launch
Icon=kldload-webui
Terminal=false
Categories=System;
StartupWMClass=com.kldload.webui
NoDisplay=true
