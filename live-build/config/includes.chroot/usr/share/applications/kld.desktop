[Desktop Entry]
Name=kld
GenericName=kldload operator console
Comment=Machines, storage, mesh, cluster, Ansible, Helm, estate and the rack — one terminal console
Exec=kldload-term --app kld
Icon=kldload-console
Terminal=false
Type=Application
Categories=System;
Keywords=kld;console;kldload;vms;zfs;wireguard;kubernetes;ansible;helm;tui;
StartupNotify=true
# Hidden on the live ISO like the other tool launchers (nothing to manage
# until something is installed); the installer reveals it on the desktop
# profile — see profiles.sh, which strips NoDisplay from the tool entries.
NoDisplay=true
