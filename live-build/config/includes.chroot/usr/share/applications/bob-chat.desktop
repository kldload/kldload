[Desktop Entry]
Type=Application
Name=Ollama
Comment=Local AI — chat, voice, and model management. Runs on this machine; nothing leaves it.
# Chrome app-mode (not kldload-webview/WebKit): Bob is voice-first and the Web
# Speech API (SpeechRecognition) only exists in Chromium. --class matches
# StartupWMClass so the window still groups under the Bob icon. Chrome already
# trusts the localhost:8443 cert (seeded at firstboot) and grants mic on
# localhost (secure context).
Exec=/usr/local/bin/kldload-chrome-app com.kldload.bob "https://localhost:8443/app/bob?app=1#bob"
Icon=bob-chat
Terminal=false
Categories=System;
StartupWMClass=chrome-localhost__app_bob-Default
# Hidden on the live ISO (Bob needs Ollama + the model, not installed on a USB
# live). The installer reveals it on the desktop profile — see profiles.sh.
NoDisplay=true
