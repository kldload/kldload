[Desktop Entry]
Type=Application
Name=Ollama
Comment=Local AI — chat, voice, and documents. Runs on this machine; nothing leaves it.
# Chrome app-mode (not kldload-webview/WebKit): the voice call uses the Web
# Speech API, which only exists in Chromium.
#
# The host is "ollama", not "localhost", and that is load-bearing. On native
# Wayland, Chrome derives the surface app_id from the URL host+path with the
# PORT STRIPPED, so http://localhost:8080/ collapses to the same
# "chrome-localhost__-Default" the kldload console at :8443/ already owns —
# and this window would group under the console's icon instead of its own.
# A distinct single-label host gives a distinct id. firstboot adds the
# 127.0.0.1 entry to /etc/hosts.
# Measured, not assumed: WAYLAND_DEBUG set_app_id on onyx, 2026-08-13.
Exec=/usr/local/bin/kldload-chrome-app com.kldload.ollama "http://ollama:8080/"
# Icon is ollama, not bob-chat: the tile is called Ollama now, and the
# bob-chat artwork is a genie's lamp. A menu entry that says one thing
# and draws another teaches the operator to distrust the labels. The
# FILENAME stays bob-chat.desktop on purpose — the dock pins in
# 50-kldload-installed-favorites reference it by name, so renaming the
# file silently drops it from the dash.
Icon=ollama
Terminal=false
Categories=System;
StartupWMClass=chrome-ollama__-Default
# Hidden on the live ISO (Bob needs Ollama + the model, not installed on a USB
# live). The installer reveals it on the desktop profile — see profiles.sh.
NoDisplay=true
