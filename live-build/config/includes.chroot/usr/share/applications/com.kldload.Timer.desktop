[Desktop Entry]
Type=Application
Name=Timer
GenericName=Stopwatch
Comment=Millisecond stopwatch and countdown for a live demo or capture feed
# Utility, not System: this is a general-purpose clock, not an operator tool.
Categories=Utility;Clock;
Keywords=timer;stopwatch;countdown;demo;capture;
Exec=/usr/local/bin/timer
Icon=com.kldload.Timer
Terminal=false
StartupNotify=true
