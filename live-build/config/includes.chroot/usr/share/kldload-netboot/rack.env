# rack.env — the answers file the live USB's rack mode arms for ANY machine.
#
# Read by kldload-netboot-live.service (arm-install any) on a live session
# booted with kldload.netboot=1; served to every machine that netboots and
# picks "install" on the menu. Missing, the unit fails to start and says so.
#
# Deliberately incomplete: no KLDLOAD_PASSWORD, no KLDLOAD_ZFS_PASSPHRASE, no
# KLDLOAD_DISK. This file is served unauthenticated to the whole wire, so it
# must carry nothing secret, and a rack of different boxes has no one right
# disk. The installer asks for each of those on the target's own screen before
# it erases anything. The menu lets the person at that screen change the
# profile, distro, hostname, user, time zone and keyboard; the hostname
# defaults to kldload-<mac> so two machines never collide.
KLDLOAD_DISTRO=fedora
KLDLOAD_PROFILE=server
KLDLOAD_USERNAME=admin
KLDLOAD_TIMEZONE=UTC
KLDLOAD_KEYBOARD_LAYOUT=us
# The server preset the menu also applies; here so the armed default and the
# menu's "server" item are the same install.
KLDLOAD_ENABLE_DEVOPS=1
KLDLOAD_ENABLE_EBPF=1
KLDLOAD_ENABLE_WEBUI=1
KLDLOAD_WIREGUARD=1
KLDLOAD_ENABLE_AI=0
KLDLOAD_K8S_BOOTSTRAP=0
KLDLOAD_BUILD_IMAGES=0
KLDLOAD_ZFS_ENCRYPT=0
KLDLOAD_ENABLE_SECURE_BOOT=0
