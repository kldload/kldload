[Unit]
Description=kldload RAG corpus indexer (one-shot)
Documentation=man:kldload-rag-index
After=kldload-rag.service ollama.service
Wants=ollama.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/kldload-rag-index --quiet
TimeoutStartSec=900
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
