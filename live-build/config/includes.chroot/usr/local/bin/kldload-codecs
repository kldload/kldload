#!/usr/bin/env bash
# kldload-codecs — OPTIONAL, user-initiated. Enables full multimedia codecs
# (H.264/H.265/AAC/MP3 + GStreamer + VLC) by turning on the RPM Fusion repos
# ON THIS MACHINE and pulling the packages. kldload ships 100% open source and
# does NOT redistribute these — this just helps you fetch them yourself.
# Needs internet + root.

set -Eeuo pipefail
trap 'echo "kldload-codecs: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

# This file's own options line is `set -eo pipefail`, and that is the author's
# intent. The 2026-09-15 strict sweep put `set -Eeuo pipefail` above it, which
# additionally forced nounset here; a LATER set line cannot clear an
# option an earlier one set, so the file ran that way regardless. That is the
# mechanic that killed build 21 on onyx through dracut. The drop has to be
# explicit. See project_strict-sweep-overrode-soft-set-lines.
set +u

# --help answers first, before anything is created, installed or run (rule
# 9; found by the sandboxed --help capture, 2026-09-30: this ran or wrote
# something instead).
case "${1:-}" in
-h | --help)
    awk 'NR > 1 && /^#/ { p = 1 } p && !/^#/ { exit } p { sub(/^# ?/, ""); print }' "$0"
    exit 0
    ;;
esac

[[ $EUID -eq 0 ]] || {
    echo "Run as root:  sudo kldload-codecs" >&2
    exit 1
}

. /etc/os-release 2>/dev/null || true
# RPM Fusion keeps Fedora and the RHEL family apart: fedora/<release> and
# el/<major>. It asked for el/ everywhere, and on Fedora 44 -- kldload's main
# substrate -- el/...-release-44 is a 404, so the first dnf failed
# (2026-09-30).
_rel="${VERSION_ID%%.*}"
case "${ID:-}" in
fedora) _fusion=fedora ;;
rhel | centos | rocky | almalinux) _fusion=el ;;
*)
    echo "kldload-codecs: RPM Fusion is for Fedora and the RHEL family; this is ${ID:-unknown}" >&2
    exit 1
    ;;
esac
[[ -n "$_rel" ]] || {
    echo "Cannot determine the release from /etc/os-release" >&2
    exit 1
}

cat <<EOF
This enables RPM Fusion (free + nonfree) on THIS machine and installs full
codecs. These are third-party, patent-encumbered packages — not part of
kldload. Continue?
EOF
read -rp "[y/N] " ans
[[ "$ans" == [yY] ]] || {
    echo "Aborted."
    exit 0
}

echo "==> Enabling RPM Fusion for ${_fusion} ${_rel}..."
dnf install -y \
    "https://download1.rpmfusion.org/free/${_fusion}/rpmfusion-free-release-${_rel}.noarch.rpm" \
    "https://download1.rpmfusion.org/nonfree/${_fusion}/rpmfusion-nonfree-release-${_rel}.noarch.rpm"

echo "==> Installing codecs (full ffmpeg + GStreamer + VLC)..."
dnf install -y --allowerasing \
    ffmpeg ffmpeg-libs \
    gstreamer1-plugins-ugly gstreamer1-plugins-bad-freeworld gstreamer1-plugin-libav \
    lame vlc

echo "==> Verifying H.264/HEVC/AAC decoders..."
# Read once, then searched: `ffmpeg | grep -q` under pipefail can read as
# MISSING when grep leaves first. And a missing decoder is a failure.
_dec="$(ffmpeg -hide_banner -decoders 2>/dev/null)" || _dec=""
_missing=0
for c in h264 hevc aac; do
    if grep -q " $c " <<<"$_dec"; then
        echo "   $c: ok"
    else
        echo "   $c: MISSING"
        _missing=1
    fi
done
((_missing == 0)) || {
    echo "kldload-codecs: a decoder is missing -- see above" >&2
    exit 1
}
echo "Done. Every app (browsers, players, VLC) can now decode common media."
