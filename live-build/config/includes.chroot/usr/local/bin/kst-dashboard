#!/usr/bin/env bash
set -euo pipefail

# kst-dashboard — live tmux dashboard for kldloadOS
# Launches a multi-pane tmux session with system monitoring.
#
# Usage:
#   kst-dashboard             # create/attach dashboard session
#   kst-dashboard --detach    # create in background
#   kst-dashboard --kill      # destroy the dashboard

SESSION="dashboard"

case "${1:-}" in
  --kill|-k)
    tmux kill-session -t "$SESSION" 2>/dev/null && echo "Dashboard killed." || echo "No dashboard running."
    exit 0
    ;;
  --help|-h)
    echo "kst-dashboard — live system monitoring in tmux"
    echo ""
    echo "Usage: kst-dashboard [--detach|--kill|--help]"
    echo ""
    echo "Layout:"
    echo "  ┌─────────────────────┬──────────────────┐"
    echo "  │                     │    ZFS pools      │"
    echo "  │   kst (health)      │──────────────────│"
    echo "  │                     │    snapshots      │"
    echo "  ├─────────────────────┼──────────────────│"
    echo "  │   htop              │    services       │"
    echo "  │                     │                   │"
    echo "  └─────────────────────┴──────────────────┘"
    echo ""
    echo "Keys (inside dashboard):  C-a d = detach  |  C-a x = close pane"
    exit 0
    ;;
esac

# If session exists, just attach
if tmux has-session -t "$SESSION" 2>/dev/null; then
  [[ "${1:-}" == "--detach" ]] && exit 0
  exec tmux attach-session -t "$SESSION"
fi

# Colors
G='\033[0;32m'
C='\033[0;36m'
B='\033[1m'
N='\033[0m'

# ── Build the dashboard layout ─────────────────────────────────────────────

# Main window: kst on the left (auto-refreshing)
tmux new-session -d -s "$SESSION" -n "monitor" -x 160 -y 45 \
  "while true; do clear; kst 2>/dev/null; sleep 10; done"

# Right-top: ZFS pool + snapshot summary
tmux split-window -t "$SESSION:monitor" -h \
  "while true; do
    clear
    printf '\033[1;36m── ZFS Pools ──\033[0m\n'
    zpool list -o name,size,alloc,free,frag,health 2>/dev/null || echo 'No ZFS pools'
    echo ''
    printf '\033[1;36m── Datasets ──\033[0m\n'
    zfs list -o name,used,avail,refer,compress 2>/dev/null | head -20 || true
    echo ''
    printf '\033[1;36m── Snapshots (newest 15) ──\033[0m\n'
    zfs list -t snapshot -o name,used,creation -S creation 2>/dev/null | head -16 || echo 'No snapshots'
    sleep 10
  done"

# Bottom-left: htop
tmux split-window -t "$SESSION:monitor.0" -v \
  "btop 2>/dev/null || htop 2>/dev/null || top"

# Bottom-right: services + network
tmux split-window -t "$SESSION:monitor.1" -v \
  "while true; do
    clear
    printf '\033[1;36m── Services ──\033[0m\n'
    for svc in sshd zfs-zed sanoid.timer kldload-webui kldload-firstboot NetworkManager nftables; do
      state=\$(systemctl is-active \"\$svc\" 2>/dev/null || echo 'missing')
      case \"\$state\" in
        active)  printf '\033[0;32m● \033[0m%-30s %s\n' \"\$svc\" \"\$state\" ;;
        inactive) printf '\033[0;33m○ \033[0m%-30s %s\n' \"\$svc\" \"\$state\" ;;
        *)       printf '\033[0;31m✗ \033[0m%-30s %s\n' \"\$svc\" \"\$state\" ;;
      esac
    done
    echo ''
    printf '\033[1;36m── Network ──\033[0m\n'
    ip -4 addr show scope global 2>/dev/null | grep -E 'inet |^[0-9]' | sed 's/^/  /'
    echo ''
    printf '\033[1;36m── Disk I/O ──\033[0m\n'
    iostat -d -h 1 1 2>/dev/null | tail -n +4 | head -10 || echo '  iostat not available'
    echo ''
    printf '\033[1;36m── Listeners ──\033[0m\n'
    ss -tlnp 2>/dev/null | head -15
    sleep 10
  done"

# Balance the panes
tmux select-layout -t "$SESSION:monitor" tiled 2>/dev/null || true

# Second window: shell ready for work
tmux new-window -t "$SESSION" -n "shell"

# Go back to monitor window
tmux select-window -t "$SESSION:monitor"

# Attach or stay detached
if [[ "${1:-}" == "--detach" || "${1:-}" == "--attach" ]]; then
  echo "Dashboard running in tmux session '$SESSION'. Attach with: tmux attach -t $SESSION"
else
  exec tmux attach-session -t "$SESSION"
fi
