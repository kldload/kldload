#!/usr/bin/env bash
# kldload-dash — single-pane "is everything OK?" dashboard.
# Live-refreshing overview of host + Kubernetes + ZFS + VMs + recent
# warnings. Every data source gracefully degrades: no cluster → skip
# K8s block; no goldens → skip VMs block. Nothing crashes.
#
# Wired to F3 in kldload-console so it's one keystroke from any pane.
set -u

REFRESH="${KLDLOAD_DASH_REFRESH:-3}"

# ── Colours (soft, dark-theme friendly) ───────────────────────────────
if [[ -t 1 ]] && [[ "${TERM:-}" != "dumb" ]]; then
    G=$'\e[38;5;85m'
    C=$'\e[38;5;117m'
    Y=$'\e[38;5;221m'
    P=$'\e[38;5;177m'
    M=$'\e[38;5;245m'
    W=$'\e[1;38;5;255m'
    R=$'\e[38;5;203m'
    D=$'\e[38;5;240m'
    N=$'\e[0m'
    B=$'\e[1m'
else
    G= C= Y= P= M= W= R= D= N= B=
fi

export KUBECONFIG="${KUBECONFIG:-/root/.kube/config}"
hr() { printf "${D}%*s${N}\n" 74 "" | tr ' ' '─'; }
head() { printf "\n${C}${B}═══ %s ═══%s${N}\n" "$1" "$(printf '%.0s═' $(seq 1 $((66 - ${#1}))))"; }

# ── Data collectors (quiet on failure) ────────────────────────────────
_host() {
    local load mem_total mem_used mem_pct cpu disk_pct up
    up="$(uptime -p 2>/dev/null | sed 's/^up //')"
    load="$(awk '{print $1, $2, $3}' /proc/loadavg)"
    read -r _ mem_total _ mem_used _ < <(free -g | awk '/Mem:/ {print "mem", $2, "used", $3}')
    mem_pct=$((100 * mem_used / (mem_total + 1)))
    cpu="$(LC_ALL=C top -bn1 -d 0.1 2>/dev/null | awk '/Cpu\(s\)/ {printf "%d%%", 100-$8; exit}')"
    disk_pct="$(df -P / | awk 'NR==2 {print $5}')"
    printf "  ${W}up ${up}${N}${M}  ·${N}  ${W}load ${load}${N}${M}  ·${N}  "
    printf "${W}mem ${mem_used}/${mem_total}GB${N} ${M}(${mem_pct}%%)${N}${M}  ·${N}  "
    printf "${W}cpu ${cpu}${N}${M}  ·${N}  ${W}root ${disk_pct}${N}\n"
}

_kube() {
    if ! command -v kubectl >/dev/null 2>&1 || ! kubectl --request-timeout=2s get nodes >/dev/null 2>&1; then
        printf "  ${D}(no cluster — kube-cluster bootstrap not run)${N}\n"
        return
    fi
    local total ready
    read -r total ready < <(kubectl get nodes --no-headers 2>/dev/null |
        awk '{t++; if ($2=="Ready") r++} END {print t+0, r+0}')
    local color
    [[ "$ready" == "$total" && "$total" -gt 0 ]] && color="$G" || color="$Y"
    printf "  ${color}${ready}/${total} nodes ready${N}"

    # Pod states
    local running pending cl bad
    eval "$(kubectl get pods -A --no-headers 2>/dev/null |
        awk '{s[$4]++} END {printf "running=%d; pending=%d; cl=%d; bad=%d\n",
            s["Running"]+0, s["Pending"]+0, s["CrashLoopBackOff"]+0,
            (s["Error"]+s["Failed"]+s["ImagePullBackOff"]+s["ErrImagePull"])+0}')"
    printf "${M}  ·${N}  ${G}${running} Running${N}"
    [[ "$pending" -gt 0 ]] && printf "${M}  ·${N}  ${Y}${pending} Pending${N}"
    [[ "$cl" -gt 0 ]] && printf "${M}  ·${N}  ${R}${cl} CrashLoop${N}"
    [[ "$bad" -gt 0 ]] && printf "${M}  ·${N}  ${R}${bad} Error${N}"
    printf "\n"

    # Key system components
    local comps="cilium hubble-relay metrics-server coredns"
    for c in $comps; do
        local ready_cnt total_cnt
        read -r ready_cnt total_cnt < <(kubectl -n kube-system get pods -l "k8s-app=${c}" --no-headers 2>/dev/null |
            awk '{t++; if ($3=="Running") r++} END {print r+0, t+0}')
        [[ "$total_cnt" -eq 0 ]] && continue
        local col
        [[ "$ready_cnt" == "$total_cnt" ]] && col="$G" || col="$R"
        printf "  ${col}${c} ${ready_cnt}/${total_cnt}${N}"
    done
    printf "\n"
}

_zfs() {
    if ! command -v zpool >/dev/null 2>&1 || ! zpool list >/dev/null 2>&1; then
        printf "  ${D}(no zfs pools)${N}\n"
        return
    fi
    while read -r name size alloc free health frag cap; do
        local col="$G"
        [[ "$health" != "ONLINE" ]] && col="$R"
        printf "  ${W}${name}${N}${M}:${N} ${W}${alloc}${N}${M} alloc ·${N} ${W}${free}${N}${M} free ·${N} ${col}${health}${N}${M} · frag ${frag} · ${cap} used${N}\n"
    done < <(zpool list -H -o name,size,alloc,free,health,frag,cap 2>/dev/null)
    # ARC hit ratio — if arcstats present
    if [[ -r /proc/spl/kstat/zfs/arcstats ]]; then
        awk '
        /^hits/ {h=$3} /^misses/ {m=$3}
        END {
            if (h+m > 0) printf "  arc hit ratio: %s%.2f%%%s\n", "'"$G"'", 100*h/(h+m), "'"$N"'"
        }' /proc/spl/kstat/zfs/arcstats
    fi
}

_vms() {
    if ! command -v virsh >/dev/null 2>&1; then
        printf "  ${D}(no libvirt)${N}\n"
        return
    fi
    local running stopped
    running="$(virsh list --state-running --name 2>/dev/null | awk 'NF' | wc -l)"
    stopped="$(virsh list --state-shutoff --name 2>/dev/null | awk 'NF' | wc -l)"
    printf "  ${G}${running} running${N}${M}  ·${N}  ${D}${stopped} stopped${N}\n"
    # Show first 6 running VMs + IPs
    local shown=0
    while read -r name; do
        [[ -z "$name" ]] && continue
        ((shown++)) && ((shown > 6)) && {
            printf "  ${D}  +$((running - 6)) more${N}\n"
            break
        }
        local ip
        ip="$(virsh domifaddr "$name" 2>/dev/null | awk '/ipv4/ {split($4,a,"/"); print a[1]; exit}')"
        [[ -z "$ip" ]] && ip="${D}(no dhcp lease)${N}"
        printf "  ${M}·${N} ${W}%-24s${N} ${M}%s${N}\n" "$name" "$ip"
    done < <(virsh list --state-running --name 2>/dev/null)
}

_events() {
    if ! command -v kubectl >/dev/null 2>&1 || ! kubectl --request-timeout=2s get nodes >/dev/null 2>&1; then
        printf "  ${D}(no cluster)${N}\n"
        return
    fi
    local count=0
    while IFS= read -r line; do
        ((count++)) && ((count > 4)) && break
        printf "  ${Y}%s${N}\n" "$line"
    done < <(kubectl get events -A --field-selector type=Warning --sort-by=.lastTimestamp --no-headers 2>/dev/null |
        awk '{printf "%s %s/%s: %s\n", $1, $2, $5, $7}' | tail -4 | tac)
    [[ "$count" -eq 0 ]] && printf "  ${G}(no warnings in the last 5 minutes)${N}\n"
}

# ── Main refresh loop ─────────────────────────────────────────────────
trap 'clear; exit 0' INT TERM
while :; do
    clear
    tput cup 0 0 2>/dev/null || true
    printf "${D}┌${N}  ${W}${B}kldload-dash${N}  ${M}·  refresh ${REFRESH}s · Ctrl+C to exit${N}  ${D}[$(date '+%H:%M:%S')]${N}\n"
    head "Host"
    _host
    head "Kubernetes"
    _kube
    head "ZFS"
    _zfs
    head "VMs"
    _vms
    head "Recent warnings"
    _events
    sleep "$REFRESH"
done
