#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# zexplore — a direct, keyboard-driven interface to your ZFS primitives: browse
#        datasets/snapshots with a full properties + permissions view, snapshot on
#        tap, and point-and-shoot replicate (local pool OR remote host over SSH).
#        A primitives manager, not a dashboard — and it runs on ANY ZFS box (plain
#        zfs/zpool everywhere; kldload systems light up the extra primitives).
#
# WHAT IT IS / WHY:
#   Everything in kldload is ZFS (datasets, boot environments, VM zvols), so ONE
#   console manages it all. sanoid keeps taking + pruning snapshots underneath;
#   zexplore adds the human layer on top — see what you have, snapshot ad-hoc, and
#   replicate a snapshot/dataset/BE/VM anywhere with two picks and a keypress.
#   Think Midnight Commander × WinSCP × ssh, but ZFS-native.
#
# HOW (in order):
#   1. `zexplore` with no args → the browser: an fzf list of datasets (used, refer,
#      snap count, sanoid coverage) with a live preview (properties + recent
#      snapshots). Keys act on the highlighted dataset:
#        enter  drill into its snapshots     ctrl-s  snapshot now (ad-hoc)
#        ctrl-r replicate (point-and-shoot)  ctrl-d  destroy (confirm)
#        ctrl-p properties                   ctrl-o  browse files (mount ro)
#   2. Replicate flow: pick a snapshot → pick a destination (a local pool, or a
#      remote host over ssh) → zexplore sends it (incremental when a common snapshot
#      exists, else full), streamed through pv/mbuffer, into a readonly target so
#      it never drifts.
#   3. `zexplore mc [target]` → the commander (WinSCP-for-ZFS): browse local datasets
#      with a PINNED target (local pool or remote host:pool); F5 replicates the
#      highlighted dataset there in one keypress, ctrl-v views the target.
#   4. Subcommands (also used by the fzf key-binds; usable on their own / in CI):
#        zexplore snap <dataset> [name]          zexplore destroy <snapshot>
#        zexplore replicate <snapshot> [dest]    zexplore browse <dataset|snapshot|zvol>
#        zexplore snaps <dataset>                zexplore props <dataset>
#        zexplore mc [pool|host:pool]            (dual-location commander)
#
# INPUTS/OUTPUTS: reads local ZFS (zfs/zpool); replication writes to a local
#   pool or `ssh <host> zfs recv`. Root required (zfs send/recv, mount). fzf +
#   pv/mbuffer are optional-but-recommended (graceful fallback if absent).
#
# NOTES / INVARIANTS:
#   - Replication TARGETS are received with `recv -F` + set readonly=on,
#     canmount=noauto so an auto-mount can't drift them out of an incremental
#     chain ("since most recent snapshot", .111 2026-07-25).
#   - Never destroys without an explicit confirm; the whole tool is read-only
#     until you press an action key.
#   - Remote = `ssh <host>` with the operator's key/agent; zexplore does not manage
#     credentials.
# ─────────────────────────────────────────────────────────────────────────────
set -Eeuo pipefail
trap 'echo -e "\033[1;31m[zexplore]\033[0m FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

# Auto-elevate — zfs send/recv + mount need root.
if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

# ── Colors + tiny helpers ────────────────────────────────────────────────────
C=$'\033[1;36m' G=$'\033[1;32m' Y=$'\033[1;33m' R=$'\033[1;31m' M=$'\033[1;35m' N=$'\033[0m'
say() { echo -e "${C}[zexplore]${N} $*"; }
warn() { echo -e "${Y}[zexplore]${N} $*" >&2; }
die() {
    echo -e "${R}[zexplore]${N} $*" >&2
    exit 1
}
have() { command -v "$1" >/dev/null 2>&1; }
confirm() { read -r -p "$(echo -e "${Y}$1${N} [y/N] ")" a && [[ "$a" =~ ^[Yy]$ ]]; }

# ── Data helpers ─────────────────────────────────────────────────────────────

# _snap_is_sanoid <snapname> — 0 if the snapshot looks sanoid-managed. sanoid
# names snapshots autosnap_<date>_<period> — we only flag them so the operator
# can tell "automatic" from "mine" (zexplore never prunes sanoid's).
_snap_is_sanoid() { [[ "$1" == *@autosnap_* || "$1" == *@auto-* ]]; }

# datasets_table — one line per dataset: NAME  USED  REFER  #SNAPS  SANOID?
# (used by the browser's fzf source). Filesystems + volumes (VM zvols included).
datasets_table() {
    local ds used refer
    while IFS=$'\t' read -r ds used refer; do
        local nsnap sano
        nsnap="$(zfs list -H -t snapshot -o name -r "$ds" 2>/dev/null | grep -c "^${ds}@" || true)"
        sano="$(zfs list -H -t snapshot -o name -r "$ds" 2>/dev/null | grep -cE "^${ds}@autosnap_" || true)"
        printf '%s\t%s\t%s\t%s\t%s\n' "$ds" "$used" "$refer" "$nsnap" \
            "$([[ "${sano:-0}" -gt 0 ]] && echo "sanoid:${sano}" || echo "-")"
    done < <(zfs list -H -o name,used,refer -t filesystem,volume 2>/dev/null)
}

# preview <dataset> — the detail pane: a full dossier on the highlighted dataset.
# Everything a ZFS operator wants at a glance — space accounting, the meaningful
# properties, BOTH permission layers (POSIX/ACL on the mountpoint AND ZFS
# delegated `zfs allow`), and recent snapshots. Sections are colour-ruled so a
# dense pane still scans. fzf's preview window scrolls, so we can afford the
# detail. (`zfs allow` here is also the surface the delegation model will hang
# off — see the security roadmap.)
preview() {
    local ds="${1%@*}" typ mp allow # strip @snap so restore-point rows preview their dataset
    typ="$(zfs get -H -o value type "$ds" 2>/dev/null)"
    echo -e "${C}${ds}${N}  ${M}[${typ}]${N}"

    echo -e "${G}── space ─────────────────────────${N}"
    zfs get -H -o property,value \
        used,referenced,available,usedbysnapshots,usedbydataset,usedbychildren,logicalused,compressratio \
        "$ds" 2>/dev/null | awk -F'\t' '$2!="-"{printf "  %-18s %s\n",$1,$2}'

    echo -e "${G}── properties ────────────────────${N}"
    zfs get -H -o property,value \
        compression,recordsize,volblocksize,mountpoint,readonly,atime,quota,refquota,reservation,dedup,encryption,keystatus,sync,canmount,origin,creation \
        "$ds" 2>/dev/null | awk -F'\t' '$2!="-"{printf "  %-14s %s\n",$1,$2}'

    echo -e "${G}── permissions ───────────────────${N}"
    mp="$(zfs get -H -o value mountpoint "$ds" 2>/dev/null)"
    if [[ "$mp" == /* && -e "$mp" ]]; then
        echo "  POSIX  $(ls -ldh "$mp" 2>/dev/null | awk '{print $1, $3":"$4}')"
    fi
    # zfs allow — the kernel-delegated permissions on this dataset (who may
    # snapshot/send/rollback/etc. without root). Empty on most datasets today.
    allow="$(zfs allow "$ds" 2>/dev/null | sed '/^$/d;s/^/  /')"
    if [[ -n "$allow" ]]; then
        echo -e "  ${Y}zfs delegated:${N}"
        echo "$allow"
    else
        echo "  zfs delegated  (none — root-only)"
    fi

    echo -e "${G}── snapshots (newest last) ───────${N}"
    zfs list -H -t snapshot -o name,used,creation -s creation -r "$ds" 2>/dev/null | tail -12 |
        while IFS=$'\t' read -r n u c; do
            local mark=""
            _snap_is_sanoid "$n" && mark="${Y}[auto]${N}"
            printf "  %-30s %8s  %s %b\n" "${n#*@}" "$u" "$c" "$mark"
        done
}

# ── Replication (the point-and-shoot core) ───────────────────────────────────

# _pipe — the throughput stage: mbuffer if present (best for network), else pv,
# else a plain cat. Keeps replication showing live progress without a hard dep.
_pipe() {
    if have mbuffer; then
        mbuffer -q -m 128M 2>/dev/null
    elif have pv; then
        pv -prb
    else
        cat
    fi
}

# replicate <source-snapshot> [dest] — send <source-snapshot> to <dest>. dest is
# either "pool[/path]" (local) or "host:pool[/path]" (remote over ssh). Picks an
# incremental base automatically when the target already holds a common snapshot;
# otherwise a full send. Target is forced readonly + non-automounting so it stays
# a clean replica.
replicate() {
    local src="$1" dest="${2:-}"
    [[ "$src" == *@* ]] || die "replicate: source must be a snapshot (dataset@snap), got '$src'"
    local src_ds="${src%@*}"

    if [[ -z "$dest" ]]; then
        dest="$(_pick_dest "$src_ds")" || exit 0
        [[ -n "$dest" ]] || exit 0
    fi

    # Split host:path
    local host="" tpath="$dest"
    if [[ "$dest" == *:* && "$dest" != /* ]]; then
        host="${dest%%:*}"
        tpath="${dest#*:}"
    fi
    local recv=(zfs recv -F -o readonly=on -o canmount=noauto "$tpath")
    local rrun=()
    # dest host may be "host" (ssh as root) or "user@host" (e.g. a zexp user that
    # holds `zfs allow receive` on the target — no root needed on the remote).
    if [[ -n "$host" ]]; then
        local sshdest="$host"
        [[ "$host" == *@* ]] || sshdest="root@${host}"
        rrun=(ssh -o StrictHostKeyChecking=no -o ConnectTimeout=8 "$sshdest")
    fi

    # Does the target already have a snapshot we can go incremental from? Look for
    # the newest source snapshot that also exists on the target.
    local base="" tsnaps
    # </dev/null is load-bearing: for a REMOTE target rrun is `ssh …`, and ssh
    # slurps our stdin — which would eat the `y` a caller pipes to confirm() and
    # silently abort the send. Detach this probe's stdin so confirm still reads it.
    tsnaps="$("${rrun[@]}" zfs list -H -t snapshot -o name -r "$tpath" </dev/null 2>/dev/null |
        sed "s#^${tpath}#${src_ds}#" || true)"
    if [[ -n "$tsnaps" ]]; then
        local s
        while read -r s; do
            [[ -z "$s" ]] && continue
            # base = the NEWEST source snapshot that ALSO exists on the target
            # (the incremental origin). Checking local existence alone is the bug
            # that made every replication a full send (.111 2026-07-25).
            grep -qxF "$s" <<<"$tsnaps" && base="$s"
        done < <(zfs list -H -t snapshot -o name -s creation -r "$src_ds" 2>/dev/null)
    fi

    local est
    if [[ -n "$base" && "$base" != "$src" ]]; then
        est="$(zfs send -nP -i "$base" "$src" 2>/dev/null | awk '/^size/{print $2}' | tail -1)"
        say "Incremental: ${G}${base#*@}${N} → ${G}${src#*@}${N}  →  ${M}${dest}${N}  (~${est:-?} bytes)"
        confirm "Replicate incrementally?" || exit 0
        zfs send -i "$base" "$src" | _pipe | "${rrun[@]}" "${recv[@]}"
    else
        est="$(zfs send -nP "$src" 2>/dev/null | awk '/^size/{print $2}' | tail -1)"
        say "Full send: ${G}${src}${N}  →  ${M}${dest}${N}  (~${est:-?} bytes)"
        confirm "Replicate (full)?" || exit 0
        zfs send "$src" | _pipe | "${rrun[@]}" "${recv[@]}"
    fi
    say "${G}✓ replicated${N} ${src} → ${dest}"
    _remember_target "$dest" # so it's a one-keypress pick next time
}

# Recent replication targets — remembered so the common case is "pick and go",
# not retyping a host:pool string every time. One dest per line, most-recent
# first, capped at 20. Lives under the operator's config dir. Failing to write
# it must never break a replication, hence the trailing `|| true`.
_targets_file() { printf '%s/zexplore/targets' "${XDG_CONFIG_HOME:-${HOME}/.config}"; }

_remember_target() { # record a REMOTE dest (host:pool/path) for next time
    local dest="$1" tf existing=""
    tf="$(_targets_file)"
    # Only remember remote targets — local pools are always auto-listed anyway.
    [[ "$dest" == *:* && "$dest" != /* ]] || return 0
    mkdir -p "$(dirname "$tf")" 2>/dev/null || return 0
    [[ -f "$tf" ]] && existing="$(grep -vxF -- "$dest" "$tf" 2>/dev/null || true)"
    {
        printf '%s\n' "$dest"
        [[ -n "$existing" ]] && printf '%s\n' "$existing"
    } | awk 'NF' | head -n 20 >"${tf}.tmp" 2>/dev/null && mv -f "${tf}.tmp" "$tf" 2>/dev/null || true
}

# _pick_dest <source-dataset> — fzf-pick a replication target: a local pool, a
# REMEMBERED remote target (arrow + Enter = go), or "new remote…" to type one.
# Echoes the chosen dest (host:path or path).
_pick_dest() {
    local src_ds="$1" leaf="${1##*/}" choice tf
    tf="$(_targets_file)"
    if have fzf; then
        choice="$({
            zpool list -H -o name 2>/dev/null | sed 's#$#/'"${leaf}"'  (local pool)#'
            [[ -f "$tf" ]] && sed 's#$#  (recent)#' "$tf"
            echo "+ new remote  (type host:pool/path)"
        } | fzf --prompt="replicate ${src_ds} → " --height=40% --reverse)" || return 1
    else
        echo "Local pools:" >&2
        zpool list -H -o name >&2
        [[ -f "$tf" ]] && {
            echo "Recent targets:" >&2
            cat "$tf" >&2
        }
        read -r -p "Destination (pool/path or host:pool/path, or blank to cancel): " choice
        printf '%s' "$choice"
        return 0
    fi
    case "$choice" in
    "+ new remote"*) read -r -p "Remote destination host:pool/path : " choice ;;
    *"  (local pool)") choice="${choice%  (local pool)}" ;;
    *"  (recent)") choice="${choice%  (recent)}" ;;
    esac
    printf '%s' "$choice"
}

# ── Actions (also the fzf key-bind targets) ──────────────────────────────────
snap() {
    local ds="$1" name="${2:-}"
    [[ -n "$ds" ]] || die "snap: dataset required"
    [[ -n "$name" ]] || { read -r -p "Snapshot name for ${ds}@ : " name; }
    [[ -n "$name" ]] || exit 0
    zfs snapshot "${ds}@${name}" && say "${G}✓${N} ${ds}@${name}"
}
destroy() {
    local target="$1"
    [[ -n "$target" ]] || die "destroy: target required"
    _snap_is_sanoid "$target" && warn "${target} is sanoid-managed — sanoid will just re-take/prune on schedule."
    confirm "Destroy ${R}${target}${N}? This cannot be undone." || exit 0
    zfs destroy "$target" && say "destroyed ${target}"
}
snaps() { # list a dataset's snapshots (fzf → replicate the picked one)
    local ds="$1"
    [[ -n "$ds" ]] || die "snaps: dataset required"
    if have fzf; then
        local pick
        pick="$(zfs list -H -t snapshot -o name,used,creation -s creation -r "$ds" 2>/dev/null |
            fzf --prompt="${ds} snapshots (enter → replicate) → " --height=60% --reverse \
                --with-nth=1,2,3 --delimiter='\t')" || exit 0
        [[ -n "$pick" ]] && replicate "$(printf '%s' "$pick" | cut -f1)"
    else
        zfs list -t snapshot -o name,used,creation -s creation -r "$ds"
    fi
}
# _explore_cleanup — tear down a zvol-explore session (globals set by browse_zvol,
# so they survive into the EXIT trap after the function returns).
_explore_cleanup() {
    [[ -n "${_EX_MNT:-}" && -d "${_EX_MNT}" ]] && {
        umount "$_EX_MNT" 2>/dev/null || true
        rmdir "$_EX_MNT" 2>/dev/null || true
    }
    [[ -n "${_EX_CLONE:-}" ]] && zfs destroy "$_EX_CLONE" 2>/dev/null || true
    [[ -n "${_EX_SNAP:-}" ]] && zfs destroy "$_EX_SNAP" 2>/dev/null || true
}

# browse_zvol <zvol> — explore a VM/zvol's FILESYSTEM read-only + consistently.
# A zvol is a block device; the guest's filesystem is inside it. We NEVER touch
# the live device: snapshot → clone → partprobe the clone → mount its biggest
# partition read-only → drop into it. Auto-cleans (umount + destroy clone/snap)
# when the explore shell exits. This is zexplore pointed at rpool/vms/<vm>.
browse_zvol() {
    local zv="$1"
    have partprobe || die "browse: 'partprobe' not found (install parted) — needed to read zvol partitions"
    local tag="zexplore-explore-$$"
    _EX_SNAP="${zv}@${tag}"
    _EX_CLONE="$(dirname "$zv")/${tag}"
    _EX_MNT="$(mktemp -d /tmp/zexplore-explore.XXXXXX)"
    trap _explore_cleanup EXIT

    say "Snapshot + clone of ${zv} for a consistent read-only view (live VM untouched)…"
    zfs snapshot "$_EX_SNAP" || die "could not snapshot ${zv}"
    zfs clone "$_EX_SNAP" "$_EX_CLONE" || die "could not clone ${_EX_SNAP}"
    local cdev="/dev/zvol/${_EX_CLONE}"
    local i
    for i in $(seq 1 20); do
        [[ -b "$cdev" ]] && break
        sleep 0.5
    done
    [[ -b "$cdev" ]] || die "clone device did not appear: ${cdev}"
    partprobe "$cdev" 2>/dev/null || true
    sleep 1

    # Pick the biggest partition (usually root); fall back to the whole device.
    local part target="$cdev"
    part="$(lsblk -rno NAME,SIZE,TYPE "$cdev" 2>/dev/null | awk '$3=="part"{print $2"\t"$1}' | sort -h | tail -1 | cut -f2)"
    [[ -n "$part" ]] && target="/dev/${part}"
    # norecovery lets us mount journaling FS (ext4/xfs) read-only without replay.
    mount -o ro,norecovery "$target" "$_EX_MNT" 2>/dev/null ||
        mount -o ro "$target" "$_EX_MNT" 2>/dev/null ||
        die "could not mount ${target} read-only (LVM/encrypted/unsupported FS?)"
    say "${G}Exploring ${zv}${N} at ${_EX_MNT} (read-only, point-in-time). Ctrl-D to leave — auto-cleanup."
    (cd "$_EX_MNT" && exec "${SHELL:-bash}") || true
}

browse() { # mount a dataset/snapshot/zvol read-only and drop into it
    local t="$1" mp typ
    [[ -n "$t" ]] || die "browse: target required"
    if [[ "$t" == *@* ]]; then
        # snapshots are browsable via the dataset's hidden .zfs/snapshot dir
        mp="$(zfs get -H -o value mountpoint "${t%@*}" 2>/dev/null)"
        [[ "$mp" == /* ]] || die "browse: ${t%@*} has no mountpoint (a zvol? browse the dataset, not the snapshot)"
        say "Browsing ${t} (read-only). Ctrl-D to leave."
        (cd "${mp}/.zfs/snapshot/${t#*@}" 2>/dev/null && exec "${SHELL:-bash}") ||
            die "could not enter snapshot dir"
    else
        typ="$(zfs get -H -o value type "$t" 2>/dev/null)"
        if [[ "$typ" == "volume" ]]; then
            browse_zvol "$t" # VM / zvol → snapshot+clone+mount-ro explore
            return
        fi
        mp="$(zfs get -H -o value mountpoint "$t" 2>/dev/null)"
        [[ "$mp" == /* ]] || die "browse: ${t} is not a mounted filesystem"
        say "Browsing ${t} at ${mp}. Ctrl-D to leave."
        (cd "$mp" && exec "${SHELL:-bash}")
    fi
}
# props <dataset> — the FULL dossier (Ctrl-P): every ZFS property, the delegated
# permissions, and the POSIX/ACL on the mountpoint — everything, paged. The
# preview pane is the glance; this is the deep dive.
props() {
    local ds="$1" mp
    mp="$(zfs get -H -o value mountpoint "$ds" 2>/dev/null)"
    {
        echo "═══ ${ds} — full property + permission dossier ═══"
        echo
        echo "─── all ZFS properties (zfs get all) ───"
        zfs get all "$ds" 2>/dev/null
        echo
        echo "─── delegated permissions (zfs allow) ───"
        zfs allow "$ds" 2>/dev/null || echo "(none)"
        if [[ "$mp" == /* && -e "$mp" ]]; then
            echo
            echo "─── POSIX / ACL (${mp}) ───"
            ls -ldh "$mp" 2>/dev/null
            getfacl -p "$mp" 2>/dev/null
        fi
    } | less -R
}

# ── The browser (default, no args) ───────────────────────────────────────────
browser() {
    have fzf || {
        datasets_table | column -t -s $'\t'
        echo
        say "Install fzf for the interactive console; subcommands work without it (zexplore --help)."
        return 0
    }
    local self="$0"
    datasets_table | fzf \
        --prompt="zexplore ▸ filesystems › " \
        --height=100% --reverse --with-nth=1,2,3,4,5 --delimiter='\t' \
        --header=$'[F1 files]  F2 transfer  F3 restore  F4 pools   esc quit\n↵ snaps  ^s snap  ^r replicate  ^o explore  ^d destroy  ^p props  ? help\nNAME\tUSED\tREFER\tSNAPS\tAUTO' \
        --preview="sudo $self --preview {1}" --preview-window=right,50%,wrap \
        --bind="f2:become(sudo $self mc)" \
        --bind="f3:become(sudo $self restore)" \
        --bind="f4:become(sudo $self pools)" \
        --bind="?:preview(sudo $self --keys)" \
        --bind="enter:execute(sudo $self snaps {1})" \
        --bind="ctrl-s:execute(sudo $self snap {1})+reload(sudo $self --table)" \
        --bind="ctrl-r:execute(sudo $self replicate \$(sudo $self --latest {1}))" \
        --bind="ctrl-o:execute(sudo $self browse {1})" \
        --bind="ctrl-d:execute(sudo $self destroy {1})+reload(sudo $self --table)" \
        --bind="ctrl-p:execute(sudo $self props {1})" \
        --bind="ctrl-/:toggle-preview" >/dev/null || true
}

# --latest <dataset> — echo its newest snapshot (for the ctrl-r bind).
_latest() { zfs list -H -t snapshot -o name -s creation -r "$1" 2>/dev/null | tail -1; }

# --keys — the '?' help screen (rendered in the browser's preview pane).
_keys() {
    cat <<EOF
${C}zexplore${N} — a direct interface to your ZFS primitives

${G}navigate${N}
  ↑ ↓ / type      move · fuzzy-filter
  enter           open the highlighted dataset's snapshots
  esc / ctrl-c    ${Y}back one level / quit  ← this is "back"${N}
  ctrl-/          toggle this detail pane
  ?               this help (move, or press ? again, to return)

${G}act on the highlighted dataset${N}
  ctrl-s          snapshot now
  ctrl-r          replicate — point-and-shoot to a pool or host:pool
  ctrl-o          explore files (mount read-only; VM zvols clone+mount)
  ctrl-p          full properties + permissions dossier
  ctrl-d          destroy (asks first)

${G}mouse${N}   click a row to select · scroll to move
${G}also${N}    zexplore mc <target>   pinned-target commander
EOF
}

# ── The commander (dual-location, WinSCP-for-ZFS) ─────────────────────────────
# The MC/WinSCP layer: browse LOCAL datasets (the source) with a PINNED target —
# a local pool or a remote "host:pool". F5 replicates the highlighted dataset's
# newest snapshot to the target (same leaf name) with no re-picking; ctrl-v flips
# to a read-only view of the target so you can confirm replicas landed. This is
# the "manage the real host, push its datasets/BEs somewhere" console. Direction
# is push-only (local source) by design — the robust, common case; remote-source
# pull is a later addition.

# _pick_target — fzf-pick the pinned replication target: a local pool, or type a
# remote "host:pool". Echoes the normalized target ("pool" or "host:pool").
_pick_target() {
    local choice
    if ! have fzf; then
        zpool list -H -o name >&2
        read -r -p "Pin target (pool or host:pool): " choice
        printf '%s' "$choice"
        return 0
    fi
    choice="$({
        zpool list -H -o name 2>/dev/null | sed 's/$/   (local pool)/'
        echo "remote…   (type host:pool)"
    } | fzf --prompt='pin replication target → ' --height=40% --reverse)" || return 1
    if [[ "$choice" == remote…* ]]; then
        read -r -p "Remote target host:pool : " choice
    else
        choice="${choice%%   (local pool)*}"
    fi
    printf '%s' "$choice"
}

# _mcsend <dataset> <target> — replicate <dataset>'s newest snapshot to
# <target>/<leaf>. Snapshots first (ad-hoc) if the dataset has none, so F5 always
# has something to send. Delegates the actual transfer to replicate() (incremental
# when the target already holds a common snapshot).
_mcsend() {
    local ds="$1" target="$2" snap leaf nm
    [[ -n "$ds" && -n "$target" ]] || die "mc: dataset and target required"
    snap="$(_latest "$ds")"
    if [[ -z "$snap" ]]; then
        confirm "No snapshot on ${ds} yet — snapshot now to replicate?" || return 0
        nm="mc-$(date +%Y%m%d-%H%M%S)"
        zfs snapshot "${ds}@${nm}" && snap="${ds}@${nm}"
    fi
    leaf="${ds##*/}"
    replicate "$snap" "${target}/${leaf}"
    echo -e "\n(press enter to return to the commander)"
    read -r
}

# _mcview <target> — read-only listing of the pinned target's datasets/snapshots,
# so you can confirm what replicas exist. Local pool or remote host:pool.
_mcview() {
    local target="$1" host="" pool="$1"
    [[ -n "$target" ]] || die "mc: target required"
    if [[ "$target" == *:* && "$target" != /* ]]; then
        host="${target%%:*}"
        pool="${target#*:}"
    fi
    local rrun=()
    if [[ -n "$host" ]]; then
        local sshdest="$host"
        [[ "$host" == *@* ]] || sshdest="root@${host}"
        rrun=(ssh -o StrictHostKeyChecking=no -o ConnectTimeout=8 "$sshdest")
    fi
    {
        echo "── target: ${target} ──"
        "${rrun[@]}" zfs list -o name,used,refer,creation -r "$pool" 2>/dev/null ||
            echo "(could not reach ${target})"
    } | less
}

# commander [target] — the dual-location commander loop (see section banner).
commander() {
    have fzf || die "mc: the commander needs fzf (the plain subcommands work without it — see --help)"
    local target="${1:-}"
    [[ -n "$target" ]] || target="$(_pick_target)" || exit 0
    [[ -n "$target" ]] || exit 0

    # If the target is REMOTE, probe SSH up front and say clearly whether it
    # worked. Transfers use KEY-BASED ssh (no password prompt by design), so
    # without this a bad/unauthorised key just yields a silent empty remote pane
    # that looks broken. On failure, tell the operator exactly how to grant it.
    local rhost=""
    if [[ "$target" == *:* && "$target" != /* ]]; then
        rhost="${target%%:*}"
        [[ "$rhost" == *@* ]] || rhost="root@${rhost}"
        say "Connecting to ${M}${rhost}${N} over SSH (key-based)…"
        if ssh -o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=8 "$rhost" true </dev/null 2>/dev/null; then
            say "${G}✓ connected${N} — ${rhost}"
        else
            say "${R}✗ cannot reach ${rhost}${N} — SSH is key-based (no password)."
            echo "    grant access:  ssh-copy-id ${rhost}" >&2
            echo "    or pin a delegated user:  user@host:pool  (needs 'zfs allow receive')" >&2
            confirm "Continue anyway (remote pane stays empty until access works)?" || exit 0
        fi
    fi

    local self="$0"
    # Right pane shows the LIVE remote side when a remote target is pinned (so you
    # actually SEE what's on the target — local list left, remote list right),
    # else the local dataset dossier. ^e / ^w flip between remote and local view.
    local pv_remote="sudo $self --mcview-preview '$target'"
    local pv_local="sudo $self --preview {1}"
    local pv="$pv_local"
    [[ -n "$rhost" ]] && pv="$pv_remote"

    datasets_table | fzf \
        --prompt="zexplore ▸ transfer → ${target} › " \
        --height=100% --reverse --with-nth=1,2,3,4,5 --delimiter='\t' \
        --header=$'F1 files  [F2 transfer]  F3 restore  F4 pools   esc quit\nF5 replicate → '"${target}"$'   ^e remote view  ^w local view  ^v full  ^g retarget  ↵ snaps  ^d destroy\nNAME\tUSED\tREFER\tSNAPS\tAUTO' \
        --preview="$pv" --preview-window=right,50%,wrap \
        --bind="f1:become(sudo $self)" \
        --bind="f3:become(sudo $self restore)" \
        --bind="f4:become(sudo $self pools)" \
        --bind="f5:execute(sudo $self _mcsend {1} '$target')" \
        --bind="ctrl-t:execute(sudo $self _mcsend {1} '$target')" \
        --bind="enter:execute(sudo $self snaps {1})" \
        --bind="ctrl-s:execute(sudo $self snap {1})+reload(sudo $self --table)" \
        --bind="ctrl-d:execute(sudo $self destroy {1})+reload(sudo $self --table)" \
        --bind="ctrl-v:execute(sudo $self _mcview '$target')" \
        --bind="ctrl-e:change-preview(sudo $self --mcview-preview '$target')" \
        --bind="ctrl-w:change-preview(sudo $self --preview {1})" \
        --bind="ctrl-g:execute(sudo $self mc)+abort" \
        --bind="ctrl-p:execute(sudo $self props {1})" \
        --bind="ctrl-/:toggle-preview" >/dev/null || true
}

# _mcview_preview <target> — the LIVE remote (or local) target listing rendered
# INTO the fzf preview pane (no pager). This is what makes the right pane "the
# remote side" in the commander. Honours user@host; </dev/null so the ssh probe
# doesn't eat fzf's input; BatchMode so an unauthorised key fails fast instead
# of hanging the pane on a password prompt.
_mcview_preview() {
    local target="${1:-}" host="" pool="${1:-}" rrun=()
    [[ -n "$target" ]] || {
        echo "(no target pinned)"
        return 0
    }
    if [[ "$target" == *:* && "$target" != /* ]]; then
        host="${target%%:*}"
        pool="${target#*:}"
    fi
    if [[ -n "$host" ]]; then
        local sshdest="$host"
        [[ "$host" == *@* ]] || sshdest="root@${host}"
        rrun=(ssh -o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=6 "$sshdest")
    fi
    echo -e "${C}remote target${N}  ${target}"
    echo
    "${rrun[@]}" zfs list -o name,used,refer -r "$pool" </dev/null 2>/dev/null ||
        echo "(cannot reach ${target} — key-based SSH not yet authorised: ssh-copy-id ${host:-$target})"
}

# ── Restore points (F3): every snapshot + boot environment on the box ─────────
# Newest first. Roll back, clone into a new dataset, or destroy. The F-keys jump
# to the other sections (fzf `become` swaps the view cleanly, no nesting).
restore() {
    have fzf || {
        zfs list -t snapshot -o name,used,creation -s creation 2>/dev/null
        return 0
    }
    local self="$0"
    zfs list -H -t snapshot -o name,used,creation -S creation 2>/dev/null | fzf \
        --prompt="zexplore ▸ restore points › " \
        --height=100% --reverse --with-nth=1,2,3 --delimiter='\t' \
        --header=$'F1 files  F2 transfer  [F3 restore]  F4 pools   esc quit\n↵ rollback   ^k clone   ^d destroy   ^p props   ? help\nSNAPSHOT\tUSED\tCREATED' \
        --preview="sudo $self --preview {1}" --preview-window=right,50%,wrap \
        --bind="f1:become(sudo $self)" \
        --bind="f2:become(sudo $self mc)" \
        --bind="f4:become(sudo $self pools)" \
        --bind="enter:execute(sudo $self rollback {1})" \
        --bind="ctrl-k:execute(sudo $self clone {1})" \
        --bind="ctrl-d:execute(sudo $self destroy {1})+reload(zfs list -H -t snapshot -o name,used,creation -S creation)" \
        --bind="ctrl-p:execute(sudo $self props {1})" \
        --bind="?:preview(sudo $self --keys)" \
        --bind="ctrl-/:toggle-preview" >/dev/null || true
}

# ── Pool topology + vdev design ──────────────────────────────────────────────
# The definitive part: zexplore reads AND builds any topology — mirror,
# raidz1/2/3, stripe, RAID10 (striped mirrors) — with SLOG (log/ZIL), L2ARC
# (cache), and special (metadata) vdevs. Not just single-disk pools.

# _free_disks — whole disks not already in a pool and not hosting root. Best-
# effort (you confirm the final command; zpool itself refuses in-use disks).
_free_disks() {
    local inuse rootsrc rootdisk d s
    inuse="$(zpool status -LP 2>/dev/null | grep -oE '/dev/[^ ]+' | sort -u)"
    rootsrc="$(findmnt -no SOURCE / 2>/dev/null)"
    rootdisk="$(lsblk -pno PKNAME "$rootsrc" 2>/dev/null | awk 'NF{print;exit}')"
    lsblk -dpno NAME,SIZE,TYPE 2>/dev/null | awk '$3=="disk"{print $1"\t"$2}' |
        while IFS=$'\t' read -r d s; do
            grep -qF "$d" <<<"$inuse" && continue
            [ -n "$rootdisk" ] && [ "$d" = "$rootdisk" ] && continue
            printf '%s\t%s\n' "$d" "$s"
        done
}

# _pool_dossier <pool> — the Pools preview: the vdev tree with per-vdev capacity
# (zpool list -v), then health / scan / errors.
_pool_dossier() {
    local p="$1"
    echo -e "${C}${p}${N}  — topology + capacity"
    zpool list -v "$p" 2>/dev/null | sed 's/^/  /'
    echo -e "\n${G}── health · scan · errors ──${N}"
    zpool status "$p" 2>/dev/null | sed -n '/scan:/,/errors:/p' | sed 's/^/  /'
}

# pool_create — interactive vdev-design wizard. NEVER uses -f; prints the exact
# zpool command and confirms before running, so nothing is destroyed by surprise.
pool_create() {
    local name lay p a
    local -a disks picks dd spec
    say "── create a pool ─────────────────────────────────"
    mapfile -t disks < <(_free_disks)
    if [ "${#disks[@]}" -eq 0 ]; then
        warn "no free whole disks found (existing disks/pools are protected)."
        read -r -p "enter to return " _
        return 0
    fi
    echo "  free disks:"
    p=1
    for a in "${disks[@]}"; do
        printf "   [%d] %s\n" "$p" "$a"
        p=$((p + 1))
    done
    echo
    read -r -p "  pool name: " name
    [ -n "$name" ] || return 0
    echo "  layout:  1) mirror  2) raidz1  3) raidz2  4) raidz3  5) stripe  6) raid10 (striped mirrors)"
    read -r -p "  choose [1-6]: " lay
    read -r -a picks -p "  data disk #s (e.g. 1 2 3 4): "
    for p in "${picks[@]}"; do
        [[ "$p" =~ ^[0-9]+$ ]] && dd+=("$(awk '{print $1}' <<<"${disks[$((p - 1))]}")")
    done
    [ "${#dd[@]}" -gt 0 ] || {
        warn "no disks chosen"
        return 0
    }
    case "$lay" in
    1) spec=(mirror "${dd[@]}") ;;
    2) spec=(raidz1 "${dd[@]}") ;;
    3) spec=(raidz2 "${dd[@]}") ;;
    4) spec=(raidz3 "${dd[@]}") ;;
    5) spec=("${dd[@]}") ;;
    6)
        ((${#dd[@]} % 2 == 0)) || {
            warn "raid10 needs an even number of disks"
            return 0
        }
        for ((p = 0; p < ${#dd[@]}; p += 2)); do spec+=(mirror "${dd[p]}" "${dd[p + 1]}"); done
        ;;
    *)
        warn "invalid layout"
        return 0
        ;;
    esac
    # optional accelerator / aux vdevs
    for a in "log:SLOG (write log / ZIL)" "cache:L2ARC (read cache)" "special:special (metadata)"; do
        read -r -p "  add ${a#*:} — disk # (blank = none): " p
        [[ "$p" =~ ^[0-9]+$ ]] && spec+=("${a%%:*}" "$(awk '{print $1}' <<<"${disks[$((p - 1))]}")")
    done
    echo
    say "will run:  ${G}zpool create ${name} ${spec[*]}${N}"
    confirm "create pool '${name}'?" || return 0
    if zpool create "$name" "${spec[@]}"; then
        say "${G}✓${N} pool ${name} created"
        zpool status "$name"
    else
        warn "zpool create failed — a disk may be in use (add -f by hand only if sure)"
    fi
    read -r -p "enter to return " _
}

# disk_replace <pool> — swap a failed/old device for a new one (resilvers).
disk_replace() {
    local pool="$1" old new
    [ -n "$pool" ] || die "disk_replace: pool required"
    zpool status "$pool" 2>/dev/null | sed 's/^/  /'
    read -r -p "  replace which device (old): " old
    read -r -p "  with new device: " new
    [ -n "$old" ] && [ -n "$new" ] || return 0
    confirm "zpool replace ${pool} ${old} ${new}?" || return 0
    zpool replace "$pool" "$old" "$new" && say "${G}✓${N} resilvering ${old} → ${new}"
    read -r -p "enter to return " _
}

# pool_add <pool> — grow an existing pool with another vdev (data or accelerator).
pool_add() {
    local pool="$1" lay p a
    local -a disks picks dd spec
    [ -n "$pool" ] || die "pool_add: pool required"
    say "── add a vdev to ${pool} ──────────────────────────"
    mapfile -t disks < <(_free_disks)
    if [ "${#disks[@]}" -eq 0 ]; then
        warn "no free whole disks found."
        read -r -p "enter to return " _
        return 0
    fi
    echo "  free disks:"
    p=1
    for a in "${disks[@]}"; do
        printf "   [%d] %s\n" "$p" "$a"
        p=$((p + 1))
    done
    echo "  vdev:  1) mirror  2) raidz1  3) raidz2  4) raidz3  5) stripe  6) log(SLOG)  7) cache(L2ARC)  8) special"
    read -r -p "  choose [1-8]: " lay
    read -r -a picks -p "  disk #s: "
    for p in "${picks[@]}"; do
        [[ "$p" =~ ^[0-9]+$ ]] && dd+=("$(awk '{print $1}' <<<"${disks[$((p - 1))]}")")
    done
    [ "${#dd[@]}" -gt 0 ] || {
        warn "no disks chosen"
        return 0
    }
    case "$lay" in
    1) spec=(mirror "${dd[@]}") ;;
    2) spec=(raidz1 "${dd[@]}") ;;
    3) spec=(raidz2 "${dd[@]}") ;;
    4) spec=(raidz3 "${dd[@]}") ;;
    5) spec=("${dd[@]}") ;;
    6) spec=(log "${dd[@]}") ;;
    7) spec=(cache "${dd[@]}") ;;
    8) spec=(special "${dd[@]}") ;;
    *)
        warn "invalid"
        return 0
        ;;
    esac
    say "will run:  ${G}zpool add ${pool} ${spec[*]}${N}"
    confirm "add vdev to ${pool}?" || return 0
    if zpool add "$pool" "${spec[@]}"; then
        say "${G}✓${N} added to ${pool}"
        zpool status "$pool"
    else
        warn "zpool add failed"
    fi
    read -r -p "enter to return " _
}

# ── Pools (F4): zpool health + topology + vdev operations ────────────────────
pools() {
    have fzf || {
        zpool list
        return 0
    }
    local self="$0"
    zpool list -H -o name,size,alloc,free,cap,health 2>/dev/null | fzf \
        --prompt="zexplore ▸ pools › " \
        --height=100% --reverse --with-nth=1,2,3,4,5,6 --delimiter='\t' \
        --header=$'F1 files  F2 transfer  F3 restore  [F4 pools]   esc quit\n^n new-pool  ^a add-vdev  ^r replace-disk  ^s scrub  ^t trim  ^c clear  ? help\nPOOL\tSIZE\tALLOC\tFREE\tCAP\tHEALTH' \
        --preview="sudo $self --pool-dossier {1}" --preview-window=right,58%,wrap \
        --bind="f1:become(sudo $self)" \
        --bind="f2:become(sudo $self mc)" \
        --bind="f3:become(sudo $self restore)" \
        --bind="ctrl-n:execute(sudo $self pool-create)+reload(zpool list -H -o name,size,alloc,free,cap,health)" \
        --bind="ctrl-a:execute(sudo $self pool-add {1})+reload(zpool list -H -o name,size,alloc,free,cap,health)" \
        --bind="ctrl-r:execute(sudo $self disk-replace {1})" \
        --bind="ctrl-s:execute(zpool scrub {1} && echo 'scrub started {1}'; sleep 1)" \
        --bind="ctrl-t:execute(zpool trim {1} 2>&1 | head; sleep 1)" \
        --bind="ctrl-c:execute(zpool clear {1} && echo 'cleared {1}'; sleep 1)" \
        --bind="?:preview(sudo $self --keys)" \
        --bind="ctrl-/:toggle-preview" >/dev/null || true
}

# rollback <snapshot> — revert a dataset to a snapshot (destroys newer ones).
rollback() {
    local snap="$1"
    [[ "$snap" == *@* ]] || die "rollback: select a snapshot (dataset@snap)"
    confirm "Roll ${snap%@*} back to ${R}${snap#*@}${N}? Snapshots newer than it are destroyed." || exit 0
    zfs rollback -r "$snap" && say "${G}✓${N} rolled back ${snap%@*} → ${snap#*@}"
    read -r -p "done — enter to return" _
}

# clone <snapshot> — fork a snapshot into a new writable dataset.
clone() {
    local snap="$1" dest
    [[ "$snap" == *@* ]] || die "clone: select a snapshot (dataset@snap)"
    read -r -p "Clone ${snap} → new dataset name: " dest
    [[ -n "$dest" ]] || exit 0
    zfs clone "$snap" "$dest" && say "${G}✓${N} cloned ${snap} → ${dest}"
    read -r -p "done — enter to return" _
}

usage() {
    sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
}

# ── Dispatch ─────────────────────────────────────────────────────────────────
case "${1:-}" in
"") browser ;;
mc | transfer) commander "${2:-}" ;;
restore) restore ;;
pools) pools ;;
pool-create) pool_create ;;
pool-add) pool_add "${2:-}" ;;
disk-replace) disk_replace "${2:-}" ;;
--pool-dossier) _pool_dossier "${2:-}" ;;
rollback) rollback "${2:-}" ;;
clone) clone "${2:-}" ;;
snap) snap "${2:-}" "${3:-}" ;;
snaps) snaps "${2:-}" ;;
replicate) replicate "${2:-}" "${3:-}" ;;
destroy) destroy "${2:-}" ;;
browse) browse "${2:-}" ;;
props) props "${2:-}" ;;
_mcsend) _mcsend "${2:-}" "${3:-}" ;;         # internal: fzf F5 bind
_mcview) _mcview "${2:-}" ;;                  # internal: fzf ctrl-v bind
--mcview-preview) _mcview_preview "${2:-}" ;; # internal: fzf right-pane remote view
--preview) preview "${2:-}" ;;
--table) datasets_table ;;
--latest) _latest "${2:-}" ;;
--keys) _keys ;;
-h | --help) usage ;;
*) die "unknown command: $1 (try --help)" ;;
esac
