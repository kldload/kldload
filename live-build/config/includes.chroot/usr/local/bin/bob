#!/usr/bin/env bash
# bob — main CLI with live system context injection
# Usage: bob "why is my system slow"
#        bob --model deepseek-r1:7b "explain kubernetes"
#        bob --no-context "tell me a joke"
#        bob --list-models
set -euo pipefail

BOB_MODEL="${BOB_MODEL:-bob}"
BOB_CONTEXT="${BOB_CONTEXT:-true}"
BOB_RAG="${BOB_RAG:-true}"
BOB_RAG_URL="${BOB_RAG_URL:-http://localhost:8400}"
BOB_HISTORY="${BOB_HISTORY:-$HOME/.bob/history}"

# ── Model management: `bob models …` ─────────────────────────────────────────
# Download / load / unload / set-default of Bob's model catalog. Delegates to
# bob-models (the engine the app also calls to swap the resident model). Kept
# on the `bob` command so there's a single entry point.
if [[ "${1:-}" == "models" || "${1:-}" == "model" ]]; then
    shift
    exec bob-models "$@"
fi

# ── Parse flags ──────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
    --model)
        BOB_MODEL="$2"
        shift 2
        ;;
    --no-context)
        BOB_CONTEXT=false
        shift
        ;;
    --no-rag)
        BOB_RAG=false
        shift
        ;;
    --list-models)
        ollama list 2>/dev/null
        exit 0
        ;;
    --help | -h)
        echo "bob — talk to Bob with live system context + RAG over kldload docs"
        echo ""
        echo "Usage: bob \"your question\""
        echo "       bob --model deepseek-r1:7b \"your question\""
        echo "       bob --no-context \"just chat\""
        echo "       bob --no-rag \"skip kldload documentation retrieval\""
        echo "       bob --list-models"
        echo ""
        echo "Models: bob models             list catalog + installed/loaded"
        echo "        bob models pull all    download the whole catalog"
        echo "        bob models load 70b    warm a model into memory"
        echo "        bob models unload all  evict models from memory"
        echo ""
        echo "Env: BOB_MODEL, BOB_CONTEXT, BOB_RAG, BOB_RAG_URL"
        exit 0
        ;;
    *) break ;;
    esac
done

Q="${*:-Hey Bob, what can you help me with?}"

# ── Gather system context ────────────────────────────────────────────────────
CTX=""
if [[ "$BOB_CONTEXT" == "true" ]]; then
    # Always include basics
    _cpu=$(grep 'model name' /proc/cpuinfo 2>/dev/null | head -1 | sed 's/.*: //')
    _cores=$(nproc 2>/dev/null || echo "?")
    _ram=$(awk '/MemTotal/{printf "%.1f", $2/1024/1024}' /proc/meminfo 2>/dev/null)
    _ram_free=$(awk '/MemAvailable/{printf "%.1f", $2/1024/1024}' /proc/meminfo 2>/dev/null)
    _disk=$(df -h / 2>/dev/null | awk 'NR==2{print $3"/"$2" ("$5" used)"}')
    _load=$(cat /proc/loadavg 2>/dev/null | cut -d' ' -f1-3)
    _uptime=$(uptime -p 2>/dev/null | sed 's/up //')
    _os=$(cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d= -f2 | tr -d '"')
    _gpu=$(lspci 2>/dev/null | grep -iE 'vga|3d|display' | head -1 | sed 's/.*: //' | sed 's/ \[.*//')
    _hostname=$(hostname 2>/dev/null)

    CTX="[System context — ${_hostname}]
OS: ${_os}
CPU: ${_cpu} (${_cores} cores)
RAM: ${_ram_free}GB free / ${_ram}GB total
Disk: ${_disk}
GPU: ${_gpu:-none}
Load: ${_load}
Uptime: ${_uptime}"

    # Failed services
    _failed=$(systemctl --failed --no-legend 2>/dev/null | head -5)
    if [[ -n "$_failed" ]]; then
        CTX="${CTX}
Failed services:
${_failed}"
    fi

    # Smart context — add more info based on question keywords
    _q_lower=$(echo "$Q" | tr '[:upper:]' '[:lower:]')

    if echo "$_q_lower" | grep -qE 'slow|hang|freeze|lag|performance|cpu|load'; then
        _top=$(ps aux --sort=-%cpu 2>/dev/null | head -8)
        CTX="${CTX}

Top processes by CPU:
${_top}"
    fi

    if echo "$_q_lower" | grep -qE 'network|internet|wifi|dns|ip|ping|connect|ssh|port'; then
        _net=$(ip -br addr 2>/dev/null | grep -v '^lo')
        _dns=$(cat /etc/resolv.conf 2>/dev/null | grep nameserver | head -3)
        CTX="${CTX}

Network interfaces:
${_net}
DNS: ${_dns}"
    fi

    if echo "$_q_lower" | grep -qE 'disk|storage|space|full|mount'; then
        _mounts=$(df -h 2>/dev/null | grep -v tmpfs | grep -v overlay)
        CTX="${CTX}

Disk usage:
${_mounts}"
    fi

    if echo "$_q_lower" | grep -qE 'memory|ram|oom|swap'; then
        _mem=$(free -h 2>/dev/null)
        CTX="${CTX}

Memory:
${_mem}"
    fi

    if echo "$_q_lower" | grep -qE 'service|systemd|unit|daemon|running'; then
        _svcs=$(systemctl list-units --type=service --state=running --no-legend 2>/dev/null | head -15 | awk '{print $1}')
        CTX="${CTX}

Running services:
${_svcs}"
    fi

    if echo "$_q_lower" | grep -qE 'gpu|nvidia|amd|cuda|graphics'; then
        if command -v nvidia-smi &>/dev/null; then
            _nv=$(nvidia-smi --query-gpu=name,memory.total,memory.used,utilization.gpu --format=csv,noheader 2>/dev/null)
            CTX="${CTX}

GPU (nvidia-smi):
${_nv}"
        fi
    fi
fi

# ── Log query ──────────────────────────────────────────────────────────────
mkdir -p "$(dirname "$BOB_HISTORY")"
echo "[$(date '+%F %T')] Q: ${Q}" >>"${BOB_HISTORY}.log" 2>/dev/null || true

# ── Route through RAG service (preferred) ──────────────────────────────────
# The RAG service at $BOB_RAG_URL adds retrieved kldload-doc context to the
# prompt and streams the answer. Falls back to plain ollama if RAG is down
# or --no-rag was passed.
if [[ "$BOB_RAG" == "true" ]] && command -v curl >/dev/null 2>&1 &&
    curl -sf --max-time 2 "${BOB_RAG_URL}/health" >/dev/null 2>&1; then
    # Build JSON safely; jq if available, else hand-craft
    if command -v jq >/dev/null 2>&1; then
        BODY=$(jq -n --arg q "$Q" --arg c "$CTX" '{question: $q, system_context: $c}')
    else
        # Crude escaping fallback
        _esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/$/\\n/g' | tr -d '\n'; }
        BODY="{\"question\":\"$(_esc "$Q")\",\"system_context\":\"$(_esc "$CTX")\"}"
    fi
    curl -sN --no-buffer -X POST "${BOB_RAG_URL}/query" \
        -H 'Content-Type: application/json' \
        -d "$BODY"
    echo
    exit 0
fi

# ── Fallback: build prompt locally + pipe to ollama directly ──────────────
if [[ -n "$CTX" ]]; then
    PROMPT="${CTX}

User question: ${Q}"
else
    PROMPT="$Q"
fi

echo "$PROMPT" | ollama run "$BOB_MODEL"
