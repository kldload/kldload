#!/usr/bin/env bash
# =============================================================================
# kldload-build-monitor-autostart — open the BUILDING screen, but only when
# there is actually something to say.
#
# WHAT IT DOES, IN ORDER:
#   1. exits silently if the machine has finished building;
#   2. otherwise finds a terminal emulator this desktop actually has;
#   3. opens it full-screen running kldload-build-monitor, which closes itself
#      when the build completes.
#
# WHY IT IS SEPARATE FROM THE .desktop:
#   XDG autostart has no conditional. Without this wrapper every login on a
#   finished machine would open a window that immediately closed — a flash of
#   black on every login, forever, to communicate nothing. The condition has to
#   live in a script, so it does.
#
# INPUTS / OUTPUTS:
#   Reads /var/lib/kldload/all-ready. Opens one terminal window. Never writes.
#   Exits 0 in every path: an autostart entry that fails is a login error
#   dialog, which is a worse outcome than a missing progress window.
#
# NOTES:
#   - Terminal preference follows what kldload actually ships, most modern
#     first. gnome-terminal is last because it is the one most likely to be
#     absent on a trimmed profile, not because it works worst.
#   - No `exec`: the wrapper returns immediately and the terminal owns its own
#     lifetime, so a session manager waiting on autostart is never blocked by
#     a window that intentionally lives for hours.
# =============================================================================
set -Eeuo pipefail

readonly ALL_READY=/var/lib/kldload/all-ready
readonly MONITOR=/usr/local/bin/kldload-build-monitor
readonly GUI=/usr/local/bin/kldload-buildmon

# Nothing to report on a finished machine — and no window either.
[[ -f "$ALL_READY" ]] && exit 0

# ── Never on the live ISO ──────────────────────────────────────────────────
# This window says "the post-install build is still running, do not reboot".
# On the live ISO nothing has been installed, so there is no build and the
# window is pure noise over the installer.
#
# The structural fix is that the .desktop is staged under the installer's
# target-files/ tree and only placed on the TARGET (build-iso.sh + profiles.sh),
# so on live there is normally nothing to run. This is the failsafe for the day
# a copy path puts it back — the same class of mistake that had the live copy
# doubling as the staging copy in the first place. (2026-08-17.)
#
# Detection is positive: look for a mounted live medium, the same three paths
# kldload-install-target probes, rather than inferring "not installed" from a
# missing file — a missing file is also what a half-finished install looks like,
# and that is exactly when this window is most needed.
for _live in /run/live/medium /run/initramfs/live /lib/live/mount/medium; do
    [[ -d "$_live" ]] && exit 0
done

# ── The GUI is the real one; the terminal monitor is the fallback ────────────
#
# kldload-buildmon shows the same build state plus the install audit, the
# health checks and the component list, in a window that cannot corrupt itself
# the way two terminal repainters did on 2026-08-15. It asks for the
# foreground once on its first paint, because during an install this window's
# job is telling the operator NOT to reboot — which it cannot do from behind a
# browser.
#
# Conditions, all of which have to hold:
#   - the binary exists (a headless rootfs ships only the static one);
#   - there is a display to open on. WAYLAND_DISPLAY or DISPLAY, because this
#     runs from XDG autostart inside a session, and a GUI launched without
#     either just fails with a message nobody sees.
if [[ -x "$GUI" ]] && [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]]; then
    if pgrep -f "[k]ldload-buildmon$" >/dev/null 2>&1; then
        exit 0 # already up — see the single-instance note below
    fi
    setsid "$GUI" >/dev/null 2>&1 &
    exit 0
fi

# No GUI available: fall back to the terminal monitor below.
[[ -x "$MONITOR" ]] || exit 0

# ── One monitor, ever ────────────────────────────────────────────────────────
#
# The monitor paints by homing the cursor and overwriting the previous frame in
# place (3b29f22c, to stop the screen flashing on every refresh). That design
# has exactly one requirement: it must be the ONLY thing writing to that
# screen. Two instances interleave into unreadable mush — duplicated Phase /
# Elapsed / Progress blocks carrying different numbers, half-overwritten words
# ("doneing", "done12s"), and a banner whose block capitals overlap into a
# smear. It does not recover, because neither writer ever clears.
#
# HISTORY: 2026-08-15, .145. A screenshot showed one pane being painted by two
# monitors whose elapsed times were 23 minutes apart — a second one had been
# started while the first was still running. Nothing prevented it: this wrapper
# launched a monitor every time it was invoked, and XDG autostart can fire more
# than once (a second session, a re-login, a manual run).
#
# pgrep -f against the interpreter line, because the script runs as
# `bash /usr/local/bin/kldload-build-monitor` and a bare -x match misses it.
if pgrep -f "[k]ldload-build-monitor$" >/dev/null 2>&1; then
    exit 0
fi

# find_term — echo a command line that opens $MONITOR in a NORMAL WINDOW.
#
# WHY NOT FULL-SCREEN: it used to open maximised/full-screen on every emulator,
# which hijacked the desktop the operator had just logged into. The job here is
# to be *unmissable*, not to be *modal* — the banner is already 5 rows of block
# capitals, so a normal window carries the message perfectly well while leaving
# the machine usable. A progress display that has to be dismissed before you can
# work is a worse experience than the problem it solves.
# HISTORY: 2026-08-14, operator feedback — "the build box should just be a
# window and doesn't need to try and hide the whole desktop."
#
# 100x30 is chosen to fit the banner (it is 53 columns wide, centred) plus the
# phase block and a 10-line log tail, with margin — so nothing wraps into mush
# at the default font size.
#
# Returns: 0 and a command on stdout, or 1 when the session has no terminal
# emulator at all (a headless or heavily trimmed profile), in which case the
# caller gives up quietly rather than erroring into the login sequence.
find_term() {
    if command -v ptyxis >/dev/null 2>&1; then
        printf 'ptyxis --new-window -- %s' "$MONITOR"
    elif command -v kgx >/dev/null 2>&1; then
        printf 'kgx -- %s' "$MONITOR"
    elif command -v konsole >/dev/null 2>&1; then
        printf 'konsole --geometry 100x30 -e %s' "$MONITOR"
    elif command -v gnome-terminal >/dev/null 2>&1; then
        printf 'gnome-terminal --geometry=100x30 -- %s' "$MONITOR"
    elif command -v xterm >/dev/null 2>&1; then
        printf 'xterm -geometry 100x30 -e %s' "$MONITOR"
    else
        return 1
    fi
}

_cmd="$(find_term)" || exit 0

# bash -c with a fixed command string built above from literals only — no
# operator- or network-supplied data reaches a shell here.
setsid bash -c "$_cmd" >/dev/null 2>&1 &
exit 0
