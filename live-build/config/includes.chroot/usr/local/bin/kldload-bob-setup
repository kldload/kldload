#!/usr/bin/env python3
"""kldload-bob-setup — create Bob inside Open WebUI, once.

What it does, in order:
    1. Checks Open WebUI is actually set up — reachable, and past onboarding
       (an account exists). Refuses politely if not, because there is nothing
       to own the knowledge collection yet.
    2. Authenticates as that operator, by password or an existing API key.
    3. Generates the OS corpus if it is missing, uploads each file, and binds
       them into a knowledge collection.
    4. Creates a workspace model named "Bob" carrying the kldload persona and
       that collection, so Bob appears in the model picker.
    5. Removes its own desktop launcher, because it is a one-shot.

Why it exists:
    Open WebUI's API requires a token for everything, and the installer
    deliberately does not keep the operator's password (it is redacted in
    effective-config.env). So nothing running unattended can create Bob on the
    operator's behalf — the account has to be handed over once, by the person
    who owns it. This is that one action, made small.

Why not an Ollama Modelfile instead:
    `ollama create bob -f Modelfile` starts pulling the FROM model
    immediately — 4.9 GB on a machine that asked for no downloads. Measured on
    .110, 2026-08-21. A workspace model references a base by name without
    fetching it, which is exactly the "Bob is visible but greyed out until you
    pull a model" behaviour that was asked for.

Inputs:
    OPEN_WEBUI_URL   default http://127.0.0.1:8080
    --api-key KEY    skip the password prompt
    --email/--password  non-interactive login
Outputs:
    A knowledge collection, a workspace model, and a marker at
    /var/lib/kldload/.bob-setup-done. Exit 0 when Bob exists, 2 when Open WebUI
    is not ready yet (a retry-later condition, not a failure).

Notes:
    - Idempotent. A second run updates the collection rather than making a
      duplicate Bob.
    - The persona is read from a file so it can be edited without touching code.
"""

from __future__ import annotations

import argparse
import getpass
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

BASE = os.environ.get("OPEN_WEBUI_URL", "http://127.0.0.1:8080").rstrip("/")
CORPUS_DIR = Path(os.environ.get("KLDLOAD_CORPUS_DIR", "/var/lib/kldload/corpus"))
PERSONA = Path("/usr/local/share/kldload-ai/bob-persona.txt")
MARKER = Path("/var/lib/kldload/.bob-setup-done")
LAUNCHERS = [
    Path("/usr/share/applications/kldload-bob-setup.desktop"),
    Path("/etc/xdg/autostart/kldload-bob-setup.desktop"),
]
COLLECTION = "kldload — this machine"
MODEL_ID = "bob"
BASE_MODEL = os.environ.get("BOB_BASE_MODEL", "llama3.1:8b")
# Open WebUI indexes knowledge through this; kldload sets RAG_EMBEDDING_ENGINE=ollama.
EMBED_MODEL = os.environ.get("BOB_EMBED_MODEL", "nomic-embed-text")


def _say(msg: str) -> None:
    print(f"[bob-setup] {msg}", flush=True)


def _req(
    path: str, token: str | None = None, data: Any = None, method: str | None = None
) -> Any:
    """One JSON call. Returns parsed body, or raises urllib.error.HTTPError."""
    url = f"{BASE}{path}"
    body = None
    headers = {"Accept": "application/json"}
    if data is not None:
        body = json.dumps(data).encode()
        headers["Content-Type"] = "application/json"
    if token:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, data=body, headers=headers, method=method)
    with urllib.request.urlopen(req, timeout=30) as r:
        raw = r.read()
    return json.loads(raw) if raw else None


def check_ready() -> None:
    """Refuse early and clearly if Open WebUI is not usable yet.

    Two distinct not-ready states, and they need different advice: the service
    may be down, or it may be up but with nobody signed up. The second is the
    common one on a fresh install and is not an error — it just means the
    operator has not opened the web UI yet.
    """
    try:
        cfg = _req("/api/config")
    except Exception as exc:  # noqa: BLE001 - any failure here means "not up"
        _say(f"Open WebUI is not answering on {BASE} ({exc.__class__.__name__}).")
        _say("Start it, then run this again:  systemctl start open-webui")
        sys.exit(2)

    if cfg.get("onboarding"):
        _say("Open WebUI is running but nobody has signed up yet.")
        _say(f"Open {BASE} , create your account, then run this again.")
        _say("Bob is created under whichever account is the admin.")
        sys.exit(2)


def login(args: argparse.Namespace) -> str:
    if args.api_key:
        return args.api_key
    email = args.email or input("Open WebUI email: ").strip()
    password = args.password or getpass.getpass("Open WebUI password: ")
    try:
        out = _req("/api/v1/auths/signin", data={"email": email, "password": password})
    except urllib.error.HTTPError as exc:
        _say(f"Sign-in failed ({exc.code}). Check the email and password.")
        sys.exit(1)
    token = out.get("token")
    if not token:
        _say("Sign-in returned no token.")
        sys.exit(1)
    return token


def _have_embed_model() -> bool:
    """Is the embedding model pulled? Ollama is the authority, not an error string."""
    try:
        url = os.environ.get("OLLAMA_URL", "http://127.0.0.1:11434")
        with urllib.request.urlopen(f"{url}/api/tags", timeout=10) as r:
            tags = json.loads(r.read()).get("models", [])
        return any(str(t.get("name", "")).startswith(EMBED_MODEL) for t in tags)
    except Exception:  # noqa: BLE001 - unreachable Ollama means "cannot index"
        return False


def ensure_corpus() -> list[Path]:
    if not CORPUS_DIR.is_dir() or not any(CORPUS_DIR.glob("*.md")):
        _say("Corpus missing — generating it from this machine...")
        # kldload-corpus reads tool banners; it needs no network and no auth.
        subprocess.run(["kldload-corpus", "build"], check=False)
    files = sorted(CORPUS_DIR.glob("*.md"))
    if not files:
        _say(f"No corpus at {CORPUS_DIR}. Run: kldload-corpus build")
        sys.exit(1)
    return files


def upload(token: str, path: Path) -> str | None:
    """Upload one file as multipart. Returns its file id.

    Hand-rolled multipart rather than a dependency: this runs on a fresh
    install where nothing beyond the standard library is guaranteed.
    """
    boundary = "----kldloadbob"
    payload = b"".join(
        [
            f"--{boundary}\r\n".encode(),
            f'Content-Disposition: form-data; name="file"; filename="{path.name}"\r\n'.encode(),
            b"Content-Type: text/markdown\r\n\r\n",
            path.read_bytes(),
            f"\r\n--{boundary}--\r\n".encode(),
        ]
    )
    req = urllib.request.Request(
        f"{BASE}/api/v1/files/",
        data=payload,
        method="POST",
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": f"multipart/form-data; boundary={boundary}",
            "Accept": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            return json.loads(r.read()).get("id")
    except urllib.error.HTTPError as exc:
        _say(f"  upload failed for {path.name} ({exc.code})")
        return None


def main() -> int:
    ap = argparse.ArgumentParser(description="Create Bob in Open WebUI (one-shot).")
    ap.add_argument("--api-key", help="Open WebUI API key, instead of a password")
    ap.add_argument("--email")
    ap.add_argument("--password")
    ap.add_argument(
        "--pull-embed",
        action="store_true",
        help="pull the embedding model (~274 MB) if it is missing",
    )
    ap.add_argument(
        "--keep-launcher",
        action="store_true",
        help="do not remove the desktop launcher afterwards",
    )
    args = ap.parse_args()

    check_ready()
    token = login(args)
    files = ensure_corpus()

    # Reuse an existing collection so a re-run updates rather than duplicates.
    kb_id = None
    try:
        # The listing is {"items": [...], "total": N}, not a bare list — a
        # plain `for kb in resp` iterates the DICT KEYS and hands you strings.
        listing = _req("/api/v1/knowledge/", token) or {}
        items = listing.get("items", listing) if isinstance(listing, dict) else listing
        for kb in items or []:
            if isinstance(kb, dict) and kb.get("name") == COLLECTION:
                kb_id = kb.get("id")
                break
    except urllib.error.HTTPError:
        pass
    if not kb_id:
        _say(f"Creating knowledge collection: {COLLECTION}")
        kb = _req(
            "/api/v1/knowledge/create",
            token,
            {
                "name": COLLECTION,
                "description": "Commands, man pages and docs harvested from this install.",
            },
        )
        kb_id = (kb or {}).get("id")
    if not kb_id:
        _say("Could not create the knowledge collection.")
        return 1

    # ASK OLLAMA whether the embedder exists, rather than inferring it from a
    # failed attach.
    #
    # Indexing a file into a collection runs it through an embedding model —
    # kldload sets RAG_EMBEDDING_ENGINE=ollama, so Open WebUI asks Ollama for
    # nomic-embed-text. On a fresh install nothing is pulled and every attach
    # returns a 400 whose body names the model. Parsing that body is fragile
    # (and silently failed here, reporting "0/6 attached" with no reason, which
    # reads as a bug in this tool rather than a missing 274 MB download).
    # Checking up front is deterministic and gives a better message.
    embed_missing = not _have_embed_model()
    if embed_missing and args.pull_embed:
        _say(f"Pulling the embedding model {EMBED_MODEL} (~274 MB)...")
        subprocess.run(["ollama", "pull", EMBED_MODEL], check=False)
        embed_missing = not _have_embed_model()

    if embed_missing:
        _say("")
        _say("Knowledge needs an embedding model, which is not pulled yet.")
        _say(f"  ollama pull {EMBED_MODEL}      # ~274 MB, one time")
        _say("  kldload-bob-setup --pull-embed  # or let this do it")
        _say("")
        _say("Creating Bob anyway — he just has no documentation attached")
        _say("until the embedder exists. Re-run afterwards to attach it.")

    _say(f"Uploading {len(files)} file(s)...")
    added = 0
    for f in [] if embed_missing else files:
        fid = upload(token, f)
        if not fid:
            continue
        try:
            _req(f"/api/v1/knowledge/{kb_id}/file/add", token, {"file_id": fid})
            added += 1
        except urllib.error.HTTPError as exc:
            detail = ""
            try:
                detail = json.loads(exc.read()).get("detail", "")
            except Exception:  # noqa: BLE001 - detail is best effort
                pass
            # THE EMBEDDING MODEL IS A SEPARATE DEPENDENCY, and this is the one
            # failure worth naming precisely rather than counting.
            #
            # Uploading a file succeeds without any model; INDEXING it into a
            # collection runs it through an embedder, and kldload configures
            # RAG_EMBEDDING_ENGINE=ollama, so Open WebUI asks Ollama for
            # nomic-embed-text. On a fresh install nothing is pulled and every
            # attach fails with a 400 that says so. Reported as "0/6 attached"
            # it looks like a bug in this tool; reported by name it is a
            # 274 MB download away from working.
            if "embed" in detail.lower() or "nomic" in detail.lower():
                embed_missing = True
                break
            if exc.code not in (400, 409):
                _say(f"  attach failed for {f.name} ({exc.code})")

    if embed_missing:
        if args.pull_embed:
            _say(f"Pulling the embedding model {EMBED_MODEL} (~274 MB)...")
            subprocess.run(["ollama", "pull", EMBED_MODEL], check=False)
            added = 0
            for f in files:
                fid = upload(token, f)
                if not fid:
                    continue
                try:
                    _req(f"/api/v1/knowledge/{kb_id}/file/add", token, {"file_id": fid})
                    added += 1
                except urllib.error.HTTPError:
                    pass
        else:
            _say("")
            _say("Knowledge needs an embedding model, which is not pulled yet.")
            _say(f"  ollama pull {EMBED_MODEL}      # ~274 MB, one time")
            _say("  kldload-bob-setup --pull-embed  # or let this do it")
            _say("")
            _say("Bob is still created below — he just has no documentation")
            _say("attached until the embedder exists. Re-run to attach it.")
    _say(f"  {added}/{len(files)} attached")

    persona = (
        PERSONA.read_text(encoding="utf-8")
        if PERSONA.is_file()
        else "You are Bob. Direct, warm, practical. Answer from the attached kldload documentation."
    )

    _say(f"Creating the Bob model (base {BASE_MODEL} — not downloaded)")
    try:
        _req(
            "/api/v1/models/create",
            token,
            {
                "id": MODEL_ID,
                "base_model_id": BASE_MODEL,
                "name": "Bob",
                "meta": {
                    "description": "kldload's assistant — knows this machine's commands.",
                    "knowledge": [{"id": kb_id, "type": "collection"}],
                },
                "params": {"temperature": 0.7, "num_ctx": 8192, "system": persona},
                "is_active": True,
            },
        )
    except urllib.error.HTTPError as exc:
        if exc.code in (400, 409):
            _say("Bob already exists — knowledge refreshed.")
        else:
            _say(f"Could not create the Bob model ({exc.code}).")
            return 1

    MARKER.parent.mkdir(parents=True, exist_ok=True)
    MARKER.write_text("done\n", encoding="utf-8")

    if not args.keep_launcher:
        for lp in LAUNCHERS:
            try:
                lp.unlink()
                _say(f"Removed launcher {lp}")
            except FileNotFoundError:
                pass
            except PermissionError:
                _say(f"Could not remove {lp} — run with sudo to tidy it up.")

    _say("Bob is in the model picker.")
    _say(
        f"He stays greyed out until a model is pulled: ollama pull {BASE_MODEL}"
        "  (or pick any model in Open WebUI and set it as Bob's base)"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
