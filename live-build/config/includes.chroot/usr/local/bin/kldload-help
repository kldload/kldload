#!/usr/bin/env bash
# kldload-help — operator command reference + workflow recipes.
#
# Topic dispatch:
#   kldload-help                  — overview + topic list
#   kldload-help <topic>          — deep-dive on one topic with examples
#   kldload-help recipes          — "I want to ..." workflow cookbook
#   kldload-help all              — print every topic (long; pipe to less)
#
# Each topic prints its full content with worked examples so you can copy-
# paste a command and have it work the first time. Run `kldload-help recipes`
# for end-to-end workflows (deploy → clone → replicate → export to AWS).

set -u

if [[ -t 1 ]] && [[ "${TERM:-}" != "dumb" ]]; then
    G=$'\e[38;5;85m'      # accent green
    C=$'\e[38;5;117m'     # accent cyan
    Y=$'\e[38;5;221m'     # warn amber
    P=$'\e[38;5;177m'     # accent purple
    M=$'\e[38;5;245m'     # muted
    W=$'\e[1;38;5;255m'   # bright white
    D=$'\e[38;5;240m'     # dim
    N=$'\e[0m'
    B=$'\e[1m'
else
    G= C= Y= P= M= W= D= N= B=
fi

# ── helper: render a single topic block ───────────────────────────────────
_t_overview() {
cat <<EOF

${B}${G}kldloadOS — operator command reference${N}

  Type ${C}kldload-help <topic>${N} for a topic, or ${C}kldload-help recipes${N}
  for end-to-end workflows ("I want to clone, replicate, ship to AWS").

${B}${G}Topics${N}
  ${C}status${N}        what's running, what's healthy, where to look
  ${C}storage${N}       ZFS pools, datasets, snapshots
  ${C}vms${N}           create, clone, snap, list, console, delete VMs
  ${C}k8s${N}           bootstrap a Kubernetes cluster, scale, status, reset
  ${C}klab${N}          multi-distro test lab (CentOS/Rocky/Fedora/Debian/Ubuntu/RHEL)
  ${C}replication${N}   ZFS send/recv between datasets and between hosts
  ${C}export${N}        ship VMs as qcow2/vmdk/vhd/ova/raw to disk or AWS
  ${C}backup${N}        sanoid snapshots, boot environments, recovery
  ${C}ai${N}            Bob (local LLM), model swap, voice, agentic mode
  ${C}observability${N} Grafana, Hubble, Tetragon, klab dashboards
  ${C}cockpit${N}       F-key console — what each cockpit answers and when to use it
  ${C}firstboot${N}     what runs unattended at first boot, where the logs are
  ${C}recipes${N}       end-to-end workflows with worked examples
  ${C}all${N}           print every topic (for grep / less)

${B}${G}Five commands to know first${N}
  ${C}kst${N}                                              system health one-pager
  ${C}kldload-overview${N}                                 unified status (ZFS + VMs + K8s + AI)
  ${C}kvm-list${N}                                         every VM with state
  ${C}KUBECONFIG=/root/.kube/config kubectl get nodes${N}  cluster nodes (or use ${C}k9s${N})
  ${C}klab status${N}                                      which goldens are built

${B}${G}Web UI${N}
  ${C}https://<host>:8443/${N}              kldload Dashboard
  ${C}https://<host>:8443/grafana/${N}      metrics + flow logs
  ${C}https://<host>:8443/k9s/${N}          browser terminal (tmux + F-keys)
  Login on installed system: ${Y}admin / Passw0rd${N}   |   Live ISO: ${Y}live / live${N}

EOF
}

_t_status() {
cat <<EOF

${B}${G}── status — what's running, what's healthy ─────────────────────────────────${N}

  ${C}kst${N}                          one-page health: pool, disks, snapshots, services
  ${C}kst-dashboard${N}                live four-pane tmux (refresh every 5s)
  ${C}kldload-overview${N}             unified status across all subsystems
  ${C}kldload-doctor${N}               run diagnostics, output JSON
  ${C}kldload-inventory${N}            list every kldload-managed asset
  ${C}kldload-lh${N}                   log hunter — interactive multi-source log search

${B}${Y}Examples${N}
  ${D}# Is the system healthy?${N}
  ${C}kst${N}

  ${D}# Watch health live${N}
  ${C}kst-dashboard${N}

  ${D}# Find errors across every log file on the box${N}
  ${C}kldload-lh${N}

EOF
}

_t_storage() {
cat <<EOF

${B}${G}── storage — ZFS pools, datasets, snapshots ────────────────────────────────${N}

  ${C}kdf${N}                          disk usage, ZFS-aware
  ${C}ksnap${N}                        snapshot manager (list / create / destroy / rollback)
  ${C}kclone${N}                       clone a dataset or zvol
  ${C}zpool list ; zpool status${N}    raw ZFS tools also available
  ${C}zfs list -t snapshot${N}         every snapshot
  ${C}sanoid${N}                       runs hourly via timer; policy in /etc/sanoid/

${B}${Y}Examples${N}
  ${D}# Snapshot everything important right now${N}
  ${C}ksnap${N}

  ${D}# List recent snapshots of one dataset${N}
  ${C}zfs list -t snapshot rpool/root | tail -10${N}

  ${D}# Rollback to a snapshot (DESTRUCTIVE — destroys newer snaps too)${N}
  ${C}zfs rollback -r rpool/root@autosnap_2026-05-12_16:00:02_hourly${N}

  ${D}# Clone a snapshot to a new dataset (cheap, copy-on-write)${N}
  ${C}zfs clone rpool/vms/klab-golden-centos@golden rpool/vms/my-test${N}

  ${D}# Find what's eating space${N}
  ${C}zfs list -o name,used,refer -s used${N}

EOF
}

_t_vms() {
cat <<EOF

${B}${G}── vms — create, clone, snap, console, delete ─────────────────────────────${N}

  ${C}kvm-create <name> [--ram MB] [--cpus N] [--disk GB] [--os <variant>]${N}
                                  create a VM on a ZFS zvol
  ${C}kvm-clone <src> <dst>${N}         instant copy-on-write clone (~100ms, zero bytes)
  ${C}kvm-snap <vm> [--name <s>]${N}    snapshot a VM
  ${C}kvm-list${N}                      every VM with state + size
  ${C}kvm-delete <vm>${N}               destroy VM + zvol (irreversible)
  ${C}virsh console <vm>${N}            serial console (Ctrl-] to detach)

${B}${Y}Examples${N}
  ${D}# Create a generic 4G/2cpu/40G VM${N}
  ${C}kvm-create webserver-01${N}

  ${D}# Create a fat VM${N}
  ${C}kvm-create db-master --ram 16384 --cpus 8 --disk 200 --os centos-stream9${N}

  ${D}# Clone instantly (CoW)${N}
  ${C}kvm-clone webserver-01 webserver-02${N}        ${D}# 100ms, no bytes copied${N}

  ${D}# Snapshot before risky change${N}
  ${C}kvm-snap webserver-01 --name pre-upgrade${N}

  ${D}# List everything${N}
  ${C}kvm-list${N}

  ${D}# Open the console (Ctrl-] to exit)${N}
  ${C}virsh console webserver-01${N}

  ${D}# Destroy${N}
  ${C}kvm-delete webserver-02${N}

${B}${Y}Run a demo${N}
  ${C}kvm-demo${N}                      interactive demo of clones + zfs + containers

EOF
}

_t_k8s() {
cat <<EOF

${B}${G}── k8s — Kubernetes cluster ────────────────────────────────────────────────${N}

  ${C}kube-cluster bootstrap [--workers N]${N}    build golden + deploy cluster (one cmd)
  ${C}kube-cluster scale N${N}                   add N more workers
  ${C}kube-cluster status${N}                    cluster state
  ${C}kube-cluster destroy${N}                   tear down everything
  ${C}kube-cluster golden${N}                    build only the golden image
  ${C}kubectl <args>${N}                         standard kubectl on the host
  ${C}k9s${N}                                    full-screen TUI for the cluster
  ${C}kube-init${N}                              kubeadm init + Cilium + MetalLB + ZFS-CSI
  ${C}kube-demo${N}                              24 interactive demos
  ${C}kube-smoke-test${N}                        automated cluster verification

${B}${Y}Examples${N}
  ${D}# Build a full cluster: 1 CP + 3 workers (~12 min)${N}
  ${C}kube-cluster bootstrap --workers 3${N}

  ${D}# Add 2 more workers later${N}
  ${C}kube-cluster scale 2${N}

  ${D}# Status${N}
  ${C}kube-cluster status${N}
  ${C}kubectl get nodes -o wide${N}
  ${C}kubectl get pods -A${N}

  ${D}# Watch flows in real time${N}
  ${C}hubble observe --follow --output compact${N}

  ${D}# Tear it all down${N}
  ${C}kube-cluster destroy${N}

${B}${Y}Per-worker join logs live at${N}
  ${C}/var/log/kldload/kube-join-<name>.log${N}

EOF
}

_t_klab() {
cat <<EOF

${B}${G}── klab — multi-distro test lab on ZFS clones ─────────────────────────────${N}

  ${C}klab golden <distro>${N}          build one golden (centos|rocky|fedora|debian|ubuntu|rhel)
  ${C}klab golden all${N}               build every supported golden
  ${C}klab status${N}                   show which goldens are ready
  ${C}klab deploy blue|green${N}        spin up a colored test environment from goldens
  ${C}klab test --full${N}              run zfs-tests.sh across every golden
  ${C}kztest-tail${N}                   tail the current klab test run

${B}${Y}Examples${N}
  ${D}# Show which goldens are present${N}
  ${C}klab status${N}

  ${D}# Build just the Fedora golden (faster than 'all')${N}
  ${C}klab golden fedora${N}

  ${D}# Deploy a green test environment (clones from goldens)${N}
  ${C}klab deploy green${N}

  ${D}# Tail the live klab test log${N}
  ${C}kztest-tail${N}

${B}${Y}RHEL note${N}
  RHEL golden needs both ${C}/var/lib/klab/images/rhel-10-cloud.qcow2${N} (or ${C}KLAB_RHEL_IMAGE_URL${N}
  env var) AND credentials. Without those, ${C}klab golden rhel${N} skips silently (rc=0).
  Add credentials via webui Dashboard → RHEL Subscription panel.

${B}${Y}Where klab logs go${N}
  ${C}/root/klab/goldens/<distro>-<ts>.log${N}     ${D}# klab driver log per attempt${N}
  ${C}/var/log/klab/klab-golden-<distro>-console.log${N}  ${D}# VM serial output${N}

EOF
}

_t_replication() {
cat <<EOF

${B}${G}── replication — ZFS send/recv between datasets and hosts ─────────────────${N}

  ${C}zfs send / zfs receive${N}        the bedrock primitives
  ${C}ksnap${N}                         takes snapshots that you replicate
  ${C}sanoid + syncoid${N}              policy-driven snapshot + replicate (in repo)

${B}${Y}Examples${N}
  ${D}# Snapshot then send a dataset to another pool, locally${N}
  ${C}zfs snapshot rpool/data@before-move${N}
  ${C}zfs send rpool/data@before-move | zfs receive tank/data${N}

  ${D}# Incremental followup (only changed blocks)${N}
  ${C}zfs snapshot rpool/data@after-edit${N}
  ${C}zfs send -i @before-move rpool/data@after-edit | zfs receive tank/data${N}

  ${D}# Send to another host over SSH (compression in flight)${N}
  ${C}zfs send -c rpool/vms/web-01@today | ssh root@dr-host \\${N}
  ${C}  'zfs receive -F backup/vms/web-01'${N}

  ${D}# Resumable streams (survive network blips on large datasets)${N}
  ${C}zfs send -c rpool/vms/web-01@today | mbuffer -s 128k -m 1G | \\${N}
  ${C}  ssh root@dr-host 'mbuffer -s 128k -m 1G | zfs receive -s -F backup/vms/web-01'${N}

  ${D}# Replicate hourly via sanoid+syncoid${N}
  ${C}syncoid rpool/vms/web-01 root@dr-host:backup/vms/web-01${N}

${B}${Y}Sanoid is already snapshot-cycling${N}
  Hourly timer. To list what it's taken:
  ${C}zfs list -t snapshot | grep autosnap${N}

EOF
}

_t_export() {
cat <<EOF

${B}${G}── export — ship VMs as qcow2 / vmdk / vhd / ova / raw / AMI ──────────────${N}

  ${C}kexport <vm> [--format <fmt>] [--scp <host>:<path>]${N}
                                  export a VM into a portable image
  Formats: ${C}qcow2${N} (default) ${C}raw${N} ${C}vmdk${N} ${C}vhd${N} ${C}ova${N}
  Output:  ${C}/var/lib/libvirt/images/exports/${N}

${B}${Y}Examples${N}
  ${D}# Default export (qcow2)${N}
  ${C}kexport webserver-01${N}

  ${D}# Export as raw + scp to a remote host${N}
  ${C}kexport webserver-01 --format raw --scp ops@bastion:/tank/images/${N}

  ${D}# Export as VMDK for VMware import${N}
  ${C}kexport webserver-01 --format vmdk${N}

  ${D}# Export as OVA (packages disk + manifest, broadest hypervisor support)${N}
  ${C}kexport webserver-01 --format ova${N}

${B}${Y}Push the resulting raw image to AWS as an AMI${N}
  ${C}kexport webserver-01 --format raw${N}
  ${C}aws s3 cp /var/lib/libvirt/images/exports/webserver-01.raw s3://my-bucket/${N}
  ${C}aws ec2 import-snapshot --disk-container \\${N}
  ${C}    'Format=raw,UserBucket={S3Bucket=my-bucket,S3Key=webserver-01.raw}'${N}
  ${C}aws ec2 register-image --name webserver-01 ...${N}

${B}${Y}Image sealing${N}
  Before exporting a VM you plan to redeploy: kexport runs the seal step
  for you (clears machine-id, regenerates SSH host keys on first boot,
  enables cloud-init for multi-datasource).

EOF
}

_t_backup() {
cat <<EOF

${B}${G}── backup — sanoid policy, boot environments, recovery ────────────────────${N}

${B}${C}Snapshots${N}
  Sanoid runs hourly and keeps a policy-driven retention.
  Config: ${C}/etc/sanoid/sanoid.conf${N}

  ${C}zfs list -t snapshot${N}        list every snapshot
  ${C}ksnap${N}                       interactive snapshot tool
  ${C}sanoid --cron${N}               run sanoid on demand

${B}${C}Boot environments${N}
  Every kldload install can host multiple bootable system states.
  ${C}kbe${N}                          list / activate / destroy boot environments
  ${C}kbe create <name>${N}            snapshot the current root and make it bootable
  ${C}kbe activate <name>${N}          flip the next-boot target
  ${C}kbe rollback${N}                 emergency: revert to the previous BE

${B}${C}Disaster recovery${N}
  ${C}krecovery${N}                    interactive recovery wizard (boot from rescue ISO)

${B}${Y}Example: snapshot before a risky upgrade${N}
  ${C}kbe create pre-kernel-bump${N}
  ${C}# do dnf upgrade${N}
  ${C}# if it blows up:${N}
  ${C}kbe activate pre-kernel-bump${N}
  ${C}reboot${N}

EOF
}

_t_ai() {
cat <<EOF

${B}${G}── ai — Bob (local LLM), models, voice ────────────────────────────────────${N}

  Bob is a local AI assistant on Ollama + qwen2.5:14b by default.
  No data leaves the box. The webui hosts a chat panel.

  ${C}bob${N}                          interactive CLI session
  ${C}bob-do "<task>"${N}              one-shot: ask Bob to do something
  ${C}bob-voice${N}                    voice-driven Bob (whisper.cpp transcription)
  ${C}bob-model${N}                    list / swap LLM models
  ${C}bob-agent${N}                    agentic mode: Bob runs shell tools autonomously
  ${C}ollama list${N}                  every model on disk
  ${C}ollama pull <model>${N}          download another model

${B}${Y}Examples${N}
  ${D}# Ask Bob a question${N}
  ${C}bob${N}

  ${D}# One-shot${N}
  ${C}bob-do "investigate disk usage and report"${N}

  ${D}# Switch to a smaller model on a small machine${N}
  ${C}ollama pull qwen2.5:7b${N}
  ${C}bob-model qwen2.5:7b${N}

  ${D}# See model size + VRAM use${N}
  ${C}ollama ps${N}

${B}${Y}Bob in the webui${N}
  Open ${C}https://<host>:8443/${N} and click the Bob panel (right side).

EOF
}

_t_observability() {
cat <<EOF

${B}${G}── observability — Grafana / Prometheus / Hubble / Tetragon ──────────────${N}

${B}${C}Web UIs${N}
  ${C}https://<host>:8443/grafana/${N}     dashboards
  ${C}https://<host>:8443/${N}             kldload Dashboard (overview)
  ${C}https://<host>:8443/k9s/${N}         browser terminal (F1-F12 = panes)

${B}${C}CLI${N}
  ${C}cilium status${N}                Cilium + Hubble health
  ${C}hubble observe --follow${N}      live flow tap (L3/L4/L7)
  ${C}hubble observe --port 443 -f${N} filter by port
  ${C}cilium policy get${N}            installed network policies
  ${C}kubectl top nodes${N}            node resource usage
  ${C}kubectl top pods -A${N}          pod resource usage

${B}${C}eBPF tools (on the host)${N}
  ${C}bpftrace -l 'tracepoint:*'${N}      list every available tracepoint
  ${C}/usr/share/bcc/tools/execsnoop${N}  every exec system-wide
  ${C}/usr/share/bcc/tools/tcplife${N}    TCP session summaries
  ${C}/usr/share/bcc/tools/biolatency${N} block-layer latency histograms

${B}${C}Tetragon (in-cluster syscall observability)${N}
  ${C}kubectl -n kube-system logs ds/tetragon -c tetragon -f${N}

${B}${Y}Grafana login${N}
  user ${Y}admin${N}, pass ${Y}kldload${N} (or anonymous via proxy passthrough)

EOF
}

# ── cockpit topic — F-key console reference ───────────────────────────────
# Documents the value of each F-key window rather than just what it shows.
# Anyone can grep ss(8) man-page output; the point of these cockpits is
# that they answer specific *operator questions* in one keystroke. Each
# section leads with the question, names the kernel data source, and ends
# with a demo line operators can read aloud to a customer.
_t_cockpit() {
cat <<EOF

${B}${G}── cockpit — the F-key console (kernel + cluster on one keystroke) ──────${N}

The kldload console (browser: ${C}https://<host>:8443/k9s/${N}, or SSH +
${C}sudo kldload-console${N}) is a tmux session pre-wired so that every
F-key toggles one cockpit on or off. Press it once → cockpit windows
appear. Press it again → they all disappear. Nav: ${C}Alt+←/→${N} or
${C}Alt+h/l${N} between windows, ${C}Alt+1..9${N} jumps direct.

${B}${C}F1${N}  Help — this page (toggle popup)
  This document, in a floating 90%×90% less(1) overlay. Press F1
  again to dismiss, or q / Esc inside less. Appears once as a
  welcome the first time the browser console attaches; after that
  it's silent until you press F1.

${B}${C}F2${N}  k9s — interactive cluster TUI
  Best general-purpose K8s window: type ${Y}:pods${N}, ${Y}:nodes${N},
  ${Y}:svc${N}, ${Y}:deploy${N}, ${Y}:events${N}, etc. Tab through, drill in.

${B}${C}F3${N}  Terminal — new scratch shell every press
  Not a toggle: F3 twice opens two shells. Close with ${C}Ctrl+q${N}
  or with ${C}F4${N} (close everything).

${B}${C}F4${N}  Close everything — kill every non-klab window in one keystroke
  Wipes out every cockpit + every scratch shell, returns you to the
  klab home pane. The "I'm done demoing, give me a clean slate"
  button. The klab home is never killed.

${B}${C}F5${N}  Logs — every kldload log in one ${C}tail -F${N}
  Drives ${C}kldload-follow${N}, which multiplexes ${C}/var/log/kldload/*.log${N}
  (firstboot, autodeploy, kube-bootstrap, klab-build, webui).
  ${Y}Answers:${N} "did first-boot finish?", "why did the K8s join fail?"

${B}${C}F6${N}  Syscall cockpit — what programs are doing to the kernel
  5 windows: ${Y}execsnoop${N}, ${Y}opensnoop${N}, ${Y}killsnoop${N}, ${Y}syscount${N}, ${Y}capable${N}
  Source: bcc-tools BPF programs attached to syscall tracepoints.
  ${Y}Answers:${N} "what just ran?", "who killed my pod?", "what files is
  X touching?", "which syscall is the hot path?", "what cap does a
  container actually need (so I can drop the rest)?"
  ${P}Demo line:${N} every ${Y}exec${N} on the box, named, with args and pid —
  zero application instrumentation, kernel-resident, ~0% overhead.

${B}${C}F7${N}  I/O + ZFS latency cockpit
  7 windows: ${Y}biosnoop${N}, ${Y}biolatency${N}, ${Y}tcpconnect${N}, ${Y}tcpretrans${N},
  ${Y}tcplife${N}, ${Y}fileslower${N}, ${Y}zfsdist${N}
  Source: bcc-tools on block + TCP + VFS layers; ${Y}zfsdist${N} is a
  bpftrace kprobe on zfs_read/zfs_write that yields a latency hist.
  ${Y}Answers:${N} "is the disk slow?" (biolatency hist), "who issued the
  slow op?" (biosnoop), "how long do TCP sessions live?" (tcplife),
  "is anything being retransmitted?" (tcpretrans).
  ${P}Demo line:${N} block-layer + transport + VFS + ZFS latency, all from
  the live kernel — no log shipping, no APM, no agent.

${B}${C}F8${N}  Kernel cockpit — Cilium / Tetragon / ZFS / cluster
  15 windows, single command per window, full screen each:
    ${Y}bpf-prog${N}      every BPF program loaded
    ${Y}hubble${N}        L3/L4/L7 flow stream from the datapath
    ${Y}cilium-lb${N}     in-kernel service→backend map (replaces kube-proxy)
    ${Y}conntrack${N}     every connection the datapath is tracking
    ${Y}bpf-maps${N}      Cilium's BPF map fullness (policy/identity/lb)
    ${Y}cilium-status${N} agent verbose snapshot
    ${Y}netpol${N}        Cilium identities + NetPols + CiliumNetPols
    ${Y}tetragon${N}      every kernel event Tetragon shipped
    ${Y}tracingpol${N}    TracingPolicies (kernel-rule analog of NetPol)
    ${Y}zfs-internals${N} txg counter + ARC composition + zfs-dbgmsg
    ${Y}zpool-io${N}      per-vdev I/O rate (zpool iostat 5)
    ${Y}virsh-vms${N}     libvirt domains (klab + K8s + blue/green VMs)
    ${Y}k8s-top${N}       kubectl top nodes + top 30 pods by CPU
    ${Y}kernel-log${N}    live kernel ring buffer (dmesg / journalctl -kf)
    ${Y}gpu${N}           nvidia-smi (only present if NVIDIA detected)
  ${Y}Answers:${N} "is the cluster healthy from a kernel POV?", "is BPF
  enforcement actually loaded?", "which pods are exchanging which
  bytes?", "is ZFS hung on a txg?", "is my GPU pegged?"
  ${P}Demo line:${N} this is the cluster's kernel state in fifteen windows
  with one keystroke. Splunk doesn't have this. Datadog doesn't have
  this. It's free because it's already in the kernel.

${B}${C}F9${N}  Kubernetes events — live event stream
  Runs ${C}kubectl get events -A --watch${N}. Anything K8s wants to tell
  you (scheduling, image pulls, restarts, evictions) flows here.

${B}${C}F10${N} htop — host CPU / memory / processes
  The classic. Sorted by CPU by default; F6 inside htop re-sorts.

${B}${C}F11${N} kernel-tcp — every TCP socket's kernel-side state
  Two panes:
    Top:    ${C}ss -tnHpi state established${N} through a custom awk
            formatter that humanizes bytes, computes per-second rates
            from a state file, colour-codes RTT (green<10ms, amber<50,
            red≥50) and retransmits, draws a unicode sparkline of
            rate-by-rank, and rolls up by process at the bottom.
    Bottom: ${C}nethogs${N} for per-process bandwidth attribution.
  ${Y}Answers:${N} "why is this specific connection slow?" (RTT/retrans),
  "is BBR loaded per-socket?" (cubic vs bbr in the algo column), "is
  the app the bottleneck or the wire?" (send-Q depth vs cwnd), "what
  process is eating my pipe?" (nethogs).
  ${P}Demo line:${N} every number on this screen came out of
  ${C}struct tcp_sock${N} in the kernel — no APM agent, no sidecar, no
  application instrumentation. The data has always been there; we're
  just finally letting you read it. Run ${C}sudo kldload-loadtest${N}
  and watch RTT spike → retrans yellow → cwnd collapse → recover, all
  in this one pane.

${B}${C}F12${N} nethogs — per-process bandwidth (alone, full screen)
  Same tool as the bottom pane of F11, but on its own when you want
  to dedicate the whole window to it.

${B}${C}Shift+F<N>${N} (deep-dive variants)
  S-F2  k8s warnings only       S-F6  iotop per-process disk I/O
  S-F3  root shell (sudo -i)    S-F7  kubectl top pods by memory
  S-F4  dmesg                   S-F8  cilium monitor --type drop
  S-F5  kldload-doctor loop

${B}${C}Alt+letter heads-up popups (auto-dismiss on Enter)${N}
  Alt+v VMs & net    Alt+c cluster      Alt+z ZFS         Alt+w WireGuard
  Alt+d disk/mem     Alt+u uptime       Alt+p iftop       Alt+n nethogs

${B}${C}Restart-loop guarantee (2026-05-19)${N}
  Every F4/F5/F6/F9 pane runs inside an infinite restart loop. If a
  tool exits — kubectl context blip, cilium-agent restart, sudo TTY
  glitch, transient bcc detach — the pane prints the exit code and
  restarts after 3 seconds. The audience never sees "pane is dead";
  the demo doesn't break on the first transient hiccup.

${B}${Y}Driving the cockpits with synthetic load${N}
  ${C}sudo kldload-loadtest${N}              60 seconds of HTTP + fio + fork-storm
  ${C}sudo kldload-loadtest 300 --http-only${N}  5 minutes of HTTP only
  Lights up F4 (exec/syscount), F5 (bio/tcp), F6 (hubble/tetragon),
  F9 (RTT/retrans/cwnd) all at once. Best demo command on the box.

EOF
}

_t_firstboot() {
cat <<EOF

${B}${G}── firstboot — what runs after install, where the logs are ────────────────${N}

${B}${C}Service order${N}
  1. ${C}kldload-firstboot.service${N}    — Prometheus, Grafana, dashboards (oneshot)
  2. ${C}klab-firstboot.service${N}       — build all distro goldens (~30-60 min)
  3. ${C}kldload-autodeploy.service${N}   — AI + K8s + observability (parallel where safe)

${B}${C}Where to look${N}
  ${C}/var/log/kldload/firstboot.log${N}        kldload-firstboot output
  ${C}/var/log/kldload/autodeploy.log${N}       autodeploy phases + AI + K8s
  ${C}/var/log/kldload/kube-bootstrap.log${N}   K8s cluster build
  ${C}/var/log/kldload/kube-join-<n>.log${N}    per-worker join (one per worker)
  ${C}/root/klab/goldens/<distro>-<ts>.log${N}  klab per-distro build driver
  ${C}/var/log/klab/<vm>-console.log${N}        VM serial output

${B}${C}Marker files (read by webui to flip status banners)${N}
  ${C}/var/lib/kldload/firstboot-done${N}       kldload-firstboot finished
  ${C}/var/lib/kldload/ai-ready${N}             Ollama + model loaded
  ${C}/var/lib/kldload/k8s-ready${N}            cluster up + Cilium rolled out
  ${C}/var/lib/kldload/klab-firstboot-done${N}  every klab golden attempted

${B}${C}Forcing a re-run${N}
  ${D}# Re-run autodeploy${N}
  ${C}sudo rm /var/lib/kldload/{ai,k8s,klab}-ready${N}
  ${C}sudo systemctl restart kldload-autodeploy${N}

EOF
}

_t_recipes() {
cat <<EOF

${B}${G}── recipes — "I want to ..." workflows ────────────────────────────────────${N}

${B}${P}❶ Deploy a single VM${N}
  ${C}kvm-create webapp-01 --ram 4096 --cpus 4 --disk 60${N}
  ${C}virsh console webapp-01${N}   ${D}# Ctrl-] to detach${N}

${B}${P}❷ Clone a VM (instant, copy-on-write)${N}
  ${C}kvm-clone webapp-01 webapp-02${N}
  ${C}virsh start webapp-02${N}

${B}${P}❸ Snapshot, modify, rollback if it broke${N}
  ${C}kvm-snap webapp-01 --name pre-deploy${N}
  ${C}ssh root@webapp-01 'systemctl stop nginx && ./bad-upgrade.sh'${N}
  ${C}# It broke. Roll back:${N}
  ${C}zfs rollback -r rpool/vms/webapp-01@pre-deploy${N}
  ${C}virsh reboot webapp-01${N}

${B}${P}❹ Replicate a VM to another kldload host${N}
  ${C}kvm-snap webapp-01 --name 2026-05-12${N}
  ${C}zfs send -c rpool/vms/webapp-01@2026-05-12 | \\${N}
  ${C}    ssh root@dr-host 'zfs receive -F backup/vms/webapp-01'${N}

${B}${P}❺ Build a Kubernetes cluster${N}
  ${C}kube-cluster bootstrap --workers 3${N}   ${D}# ~12 min for 1 CP + 3 workers${N}
  ${C}kubectl get nodes -o wide${N}
  ${C}k9s${N}                                  ${D}# browse the cluster${N}

${B}${P}❻ Add more workers later${N}
  ${C}kube-cluster scale 2${N}

${B}${P}❼ Tear down K8s, build it fresh${N}
  ${C}kube-cluster destroy${N}
  ${C}kube-cluster bootstrap --workers 5${N}

${B}${P}❽ Build a multi-distro test lab${N}
  ${C}klab golden all${N}                      ${D}# build every distro golden${N}
  ${C}klab status${N}
  ${C}klab deploy blue${N}

${B}${P}❾ Ship a VM to AWS as an AMI${N}
  ${C}kexport webapp-01 --format raw${N}
  ${C}aws s3 cp /var/lib/libvirt/images/exports/webapp-01.raw s3://mybucket/${N}
  ${C}aws ec2 import-snapshot --disk-container \\${N}
  ${C}    'Format=raw,UserBucket={S3Bucket=mybucket,S3Key=webapp-01.raw}'${N}
  ${C}aws ec2 register-image --name webapp-01 ...${N}

${B}${P}❿ Run zfs-tests across every distro${N}
  ${C}klab golden all${N}
  ${C}klab test --full${N}
  ${C}kztest-tail${N}

${B}${P}⓫ Recover when the system won't boot${N}
  ${C}# Boot the kldload ISO again, choose "Recovery"${N}
  ${C}krecovery${N}
  ${C}kbe activate <previous-be>${N}
  ${C}reboot${N}

EOF
}

_t_all() {
  _t_overview
  _t_status
  _t_storage
  _t_vms
  _t_k8s
  _t_klab
  _t_replication
  _t_export
  _t_backup
  _t_ai
  _t_observability
  _t_firstboot
  _t_recipes
}

# ── Dispatch ──────────────────────────────────────────────────────────────
topic="${1:-overview}"
case "$topic" in
    overview|"")                          _t_overview ;;
    status)                               _t_status ;;
    storage|zfs)                          _t_storage ;;
    vms|vm|kvm)                           _t_vms ;;
    k8s|kube|kubernetes)                  _t_k8s ;;
    klab|lab)                             _t_klab ;;
    replication|replicate|repl|send|recv) _t_replication ;;
    export|kexport|aws|ami)               _t_export ;;
    backup|snapshot|be|rollback|recovery) _t_backup ;;
    ai|bob|ollama)                        _t_ai ;;
    observability|obs|grafana|hubble|tetragon|metrics) _t_observability ;;
    cockpit|console|fkeys|f-keys|tmux)    _t_cockpit ;;
    firstboot|fb|autodeploy)              _t_firstboot ;;
    recipes|howto|examples)               _t_recipes ;;
    all|full|everything)                  _t_all ;;
    *)
        _t_overview
        echo "${Y}Unknown topic '${topic}'. Try one of the topics above.${N}"
        exit 1
        ;;
esac
