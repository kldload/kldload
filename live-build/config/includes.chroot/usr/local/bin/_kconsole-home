#!/usr/bin/env bash
# Render the kldload-console klab-tab reference card. Two-column layout
# so the cheatsheet uses the whole terminal width and fits on one screen
# instead of scrolling. Called by kldload-console at session start and
# available any time via the `menu` shell alias.
set -u

if [[ -t 1 ]] && [[ "${TERM:-}" != "dumb" ]]; then
    G=$'\e[38;5;85m'     # accent green
    C=$'\e[38;5;117m'    # accent cyan
    Y=$'\e[38;5;221m'    # warn amber
    P=$'\e[38;5;177m'    # accent purple
    M=$'\e[38;5;245m'    # muted
    W=$'\e[1;38;5;255m'  # bright white
    D=$'\e[38;5;240m'    # dim
    N=$'\e[0m'
    B=$'\e[1m'
else
    G= C= Y= P= M= W= D= N= B=
fi

clear

cat <<BANNER
${D}┌────────────────────────────────────────────────────────────────────┐${N}
${D}│${N}  ${W}${B}klab console${N}  ${M}— one-pane ops + operator + kernel cockpit${N}           ${D}│${N}
${D}└────────────────────────────────────────────────────────────────────┘${N}
BANNER

printf "\n${M}  F-keys toggle watch windows — press to open, press again to close.${N}\n"
printf "${M}  Type ${G}menu${M} to redraw this cheatsheet, ${G}help${M} for full kldload-mgmt.${N}\n\n"

LEFT=()
RIGHT=()

_emit() {
    local side="$1" key="$2" label="$3" desc="$4" kcolor="$5"
    local trimmed="${desc:0:32}"
    local row
    row="   ${kcolor}$(printf '%-9s' "$key")${N}  ${W}$(printf '%-22s' "$label")${N}  ${M}$(printf '%-32s' "$trimmed")${N}"
    if [[ "$side" == "L" ]]; then LEFT+=("$row"); else RIGHT+=("$row"); fi
}

_head() {
    local side="$1" title="$2" hint="$3" color="$4"
    local row
    row="  ${color}${B}$(printf '%-22s' "$title")${N}  ${D}$(printf '%-44s' "$hint")${N}"
    if [[ "$side" == "L" ]]; then LEFT+=("$row"); else RIGHT+=("$row"); fi
}

_blank() {
    if [[ "${1}" == "L" ]]; then LEFT+=(""); else RIGHT+=(""); fi
}

# ── LEFT column: F-keys (each row explains the actual contents) ──────
_head  L "▸ F-keys (toggle)" "press once = open; press again = close" "$C"
_emit  L "F1"  "help"                 "toggle popup — F1 to close"    "$G"
_emit  L "F2"  "k9s"                  "cluster TUI"                   "$G"
_emit  L "F3"  "terminal"             "new scratch shell"             "$G"
_emit  L "F4"  "close everything"     "kill every non-klab window"    "$Y"
_emit  L "F5"  "logs"                 "kldload-follow — every log"    "$G"
_emit  L "F6"  "syscall cockpit"      "5w: exec/open/kill/sysc/cap"   "$G"
_emit  L "F7"  "I/O + ZFS cockpit"    "7w: bio/lat/tcp×3/file/zfsdist" "$G"
_emit  L "F8"  "kernel cockpit"       "15w: bpf/cilium/tetragon/zfs"  "$G"
_emit  L "F9"  "k8s events"           "kubectl events --watch"        "$G"
_emit  L "F10" "htop"                 "host CPU / mem / procs"        "$G"
_emit  L "F11" "kernel-tcp"           "ss -i awk + nethogs split"     "$G"
_emit  L "F12" "nethogs"              "per-process bandwidth"         "$G"
_blank L
_head  L "▸ Navigation (browser-safe)" "Alt-key only — arrows blocked by browser" "$C"
_emit  L "Alt+1..9"    "jump to win N" "fastest — direct by number"   "$C"
_emit  L "Alt+←/→"     "prev/next win" "browser-iframe arrow keys"    "$C"
_emit  L "Alt+h / l"   "prev/next win" "vim direction (same as ←/→)"  "$C"
_emit  L "Alt+↑/↓"     "walk panes"    "up/down within a window"      "$C"
_emit  L "Alt+k / j"   "walk panes"    "vim direction (same as ↑/↓)"  "$C"
_emit  L "Alt+Enter"   "new window"    "blank shell window"           "$C"
_emit  L "Alt+\\\\"    "vsplit"        "pane to the right"            "$C"
_emit  L "Alt+-"       "hsplit"        "pane below"                   "$C"
_emit  L "Ctrl+q"      "close pane"    "kills pane, then window"      "$C"

# ── RIGHT column: Heads-up popups + Window nav + Scroll + Deep-dive ──
_head  R "▸ Heads-up popups" "(Alt+letter — auto-dismiss on Enter)" "$Y"
_emit  R "Alt+v" "VMs & net"          "virsh + DHCP + interfaces"     "$Y"
_emit  R "Alt+c" "cluster"            "nodes + sad pods + warnings"   "$Y"
_emit  R "Alt+z" "ZFS"                "pools + datasets + ARC"        "$Y"
_emit  R "Alt+w" "WireGuard / net"    "wg show + routes + conns"      "$Y"
_emit  R "Alt+d" "disk / mem / cpu"   "df + free + lscpu snapshot"    "$Y"
_emit  R "Alt+u" "uptime"             "uptime + who + last logins"    "$Y"
_emit  R "Alt+p" "iftop"              "per-connection bandwidth"      "$Y"
_emit  R "Alt+n" "nethogs"            "per-process bandwidth"         "$Y"
_blank R
_head  R "▸ Scrollback" "(no prefix needed)" "$C"
_emit  R "PageUp"      "scrollback"   "into copy-mode, scroll up"     "$C"
_emit  R "S-PageUp"    "jump top"     "history-top"                   "$C"
_emit  R "S-PageDown"  "jump bottom"  "back to live"                  "$C"
_emit  R "Mouse wheel" "scrollback"   "auto-enters copy-mode"         "$C"
_emit  R "q  or Enter" "exit scroll"  "back to live view"             "$C"
_blank R
_head  R "▸ Deep-dive" "(Shift+F<N>, toggle)" "$P"
_emit  R "S-F2"  "k8s warnings"       "warning-only events"           "$P"
_emit  R "S-F3"  "root shell"         "sudo -i"                       "$P"
_emit  R "S-F4"  "dmesg"              "kernel ring buffer"            "$P"
_emit  R "S-F5"  "doctor loop"        "kldload-doctor live"           "$P"
_emit  R "S-F6"  "iotop"              "per-process disk I/O"          "$P"
_emit  R "S-F7"  "kubectl top pods"   "pod mem/cpu top"               "$P"
_emit  R "S-F8"  "cilium drops"       "cilium monitor --type drop"    "$P"

# ── Print columns side by side ────────────────────────────────────────
_blankL=$(printf '%.0s ' {1..70})
max=${#LEFT[@]}
(( ${#RIGHT[@]} > max )) && max=${#RIGHT[@]}
for ((i=0; i<max; i++)); do
    printf "%s%s\n" "${LEFT[i]:-$_blankL}" "${RIGHT[i]:-}"
done

printf "\n${D}   ${G}F4${D} = syscall traces (5 wins)  ·  ${G}F5${D} = I/O + ZFS latency (7 wins)  ·  ${G}F6${D} = kernel deep-dive (15 wins).${N}\n"
printf "${D}   To light up every pane at once for a demo:  ${G}sudo kldload-loadtest 60${D}  — drives HTTP + block I/O + exec fork-storm in parallel.${N}\n"
printf "${D}   Window list is in the status strip below — clickable.${N}\n\n"
