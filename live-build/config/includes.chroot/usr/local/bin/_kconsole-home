#!/usr/bin/env bash
# Render the kldload-console home-tab reference card. Two-column layout
# so the cheatsheet uses the whole terminal width and fits on one screen
# instead of scrolling. Called by kldload-console at session start and
# available any time via the `menu` shell alias.
set -u

if [[ -t 1 ]] && [[ "${TERM:-}" != "dumb" ]]; then
    G=$'\e[38;5;85m'     # accent green
    C=$'\e[38;5;117m'    # accent cyan
    Y=$'\e[38;5;221m'    # warn amber
    P=$'\e[38;5;177m'    # accent purple
    M=$'\e[38;5;245m'    # muted
    W=$'\e[1;38;5;255m'  # bright white
    D=$'\e[38;5;240m'    # dim
    N=$'\e[0m'
    B=$'\e[1m'
else
    G= C= Y= P= M= W= D= N= B=
fi

clear

# ── Banner (full width) ────────────────────────────────────────────────
# Box inner width = 72 cols (matches top/bottom ───). Each banner line is
# 2sp + KLDLAB(48) + 2sp + tagline-area(20) = 72 inner. The right │ now
# lines up with ┐ — the old layout had 78-wide banner lines in a 72-wide
# box, so the right border was 4 cols past the corner.
cat <<BANNER
${D}┌────────────────────────────────────────────────────────────────────┐${N}
${D}│${N}  ${W}██╗  ██╗██╗     ██████╗ ██╗      █████╗ ██████╗ ${N}  ${C}c o n s o l e${N}     ${D}│${N}
${D}│${N}  ${W}██║ ██╔╝██║     ██╔══██╗██║     ██╔══██╗██╔══██╗${N}                    ${D}│${N}
${D}│${N}  ${W}█████╔╝ ██║     ██║  ██║██║     ███████║██████╔╝${N}  ${G}one-pane ops${N}      ${D}│${N}
${D}│${N}  ${W}██╔═██╗ ██║     ██║  ██║██║     ██╔══██║██╔══██╗${N}  ${G}lab + operator${N}    ${D}│${N}
${D}│${N}  ${W}██║  ██╗███████╗██████╔╝███████╗██║  ██║██████╔╝${N}                    ${D}│${N}
${D}│${N}  ${W}╚═╝  ╚═╝╚══════╝╚═════╝ ╚══════╝╚═╝  ╚═╝╚═════╝ ${N}                    ${D}│${N}
${D}└────────────────────────────────────────────────────────────────────┘${N}
BANNER

printf "\n${M}  F-keys toggle watch windows — press to open, press again to close.${N}\n"
printf "${M}  Nothing runs until you ask. Type ${G}menu${M} to redraw this cheatsheet.${N}\n\n"

# ── Two-column layout ──────────────────────────────────────────────────
# Lines are built into LEFT[] and RIGHT[] arrays with ANSI colour codes.
# Each visible row has the same padded length; we use a `-%-*s` format
# where the width compensates for invisible ANSI escape bytes, so the
# right column aligns even when the left has colour sequences.
LEFT=()
RIGHT=()

# ANSI colour sequences occupy bytes but zero visible width. We build
# two counters: raw byte length (for printf %s) and visible columns
# (for alignment). Easiest: strip ANSI when measuring, then print the
# coloured version with a padding calculated from the stripped length.
_emit() {
    # _emit <side> <key> <label> <desc>   — colours chosen by caller
    local side="$1" key="$2" label="$3" desc="$4" kcolor="$5"
    # Raw (coloured) output; fixed visible widths: key 9, label 18, desc 30
    # Description is trimmed to 30 visible chars so the row stays within
    # ~60 visible columns — half of an 80-wide drawer / 1/3 of 120-wide.
    local trimmed="${desc:0:30}"
    local row
    row="   ${kcolor}$(printf '%-9s' "$key")${N}  ${W}$(printf '%-18s' "$label")${N}  ${M}$(printf '%-30s' "$trimmed")${N}"
    if [[ "$side" == "L" ]]; then LEFT+=("$row"); else RIGHT+=("$row"); fi
}

_head() {
    # Pad header to exactly 64 visible cols: 2sp + title(20) + 2sp + hint(40)
    # so every LEFT row — header, _emit, or blank — starts RIGHT at col 64.
    # %-22s (not %-20s) because every title starts with `▸` — 3 bytes for
    # 1 visible col, so we pad 2 extra bytes to land on 20 visible cols.
    local side="$1" title="$2" hint="$3" color="$4"
    local row
    row="  ${color}${B}$(printf '%-22s' "$title")${N}  ${D}$(printf '%-40s' "$hint")${N}"
    if [[ "$side" == "L" ]]; then LEFT+=("$row"); else RIGHT+=("$row"); fi
}

_blank() {
    if [[ "${1}" == "L" ]]; then LEFT+=(""); else RIGHT+=(""); fi
}

# ── LEFT column: Primary panes + Bandwidth top + Trace group ──────────
_head  L "▸ Primary panes" "(F2-F12, toggle)" "$C"
_emit  L "F2"  "k9s"               "cluster-at-a-glance"          "$G"
_emit  L "F3"  "doctor (once)"     "compliance + sanity report"   "$G"
_emit  L "F4"  "logs"              "webui + ttyd journal"         "$G"
_emit  L "F5"  "lh (cluster logs)" "LogHog menu, all nodes"       "$G"
_emit  L "F6"  "htop"              "host CPU / mem / procs"       "$G"
_emit  L "F7"  "k8s events"        "kubectl get events --watch"   "$G"
_emit  L "F8"  "hubble observe"    "live pod packet flows"        "$G"
_emit  L "F9"  "zpool iostat"      "ZFS per-vdev latency"         "$G"
_emit  L "F10" "scratch"           "throwaway shell"              "$G"
_emit  L "F11" "tcplife"           "TCP sessions src->dst"        "$G"
_emit  L "F12" "tcptop"            "top active TCP conns"         "$G"
_blank L
_head  L "▸ HUD popups" "(Alt+letter, auto-dismiss)" "$C"
_emit  L "Alt+v" "VMs & net"        "virsh + DHCP + interfaces"    "$C"
_emit  L "Alt+c" "cluster"          "nodes + sad pods + warnings"  "$C"
_emit  L "Alt+z" "ZFS"              "pools + top datasets + ARC"   "$C"
_emit  L "Alt+w" "WireGuard/net"    "wg show + routes + conns"     "$C"
_emit  L "Alt+d" "disk/mem/cpu"     "df + free + lscpu snapshot"   "$C"
_emit  L "Alt+u" "uptime"           "uptime + who + last logins"   "$C"
_blank L
_head  L "▸ Bandwidth top" "(pftop equivalents)" "$Y"
_emit  L "Alt+p" "iftop"           "per-connection bandwidth"     "$Y"
_emit  L "Alt+n" "nethogs"         "per-process bandwidth"        "$Y"
_blank L
_head  L "▸ Trace group" "(bcc-tools)" "$Y"
_emit  L "Alt+e" "execsnoop"       "every exec() + cmdline"       "$Y"
_emit  L "Alt+o" "opensnoop"       "every open() + path"          "$Y"
_emit  L "Alt+b" "biosnoop"        "every block I/O + latency"    "$Y"
_emit  L "Alt+k" "killsnoop"       "every signal / OOM kill"      "$Y"

# ── RIGHT column: Deep-dive + Window/pane ops + Navigation ────────────
_head  R "▸ Deep-dive" "(Shift+F<N>, toggle)" "$P"
_emit  R "S-F2"  "k8s warnings"     "warning-only events"         "$P"
_emit  R "S-F3"  "root shell"       "sudo -i (spawns new)"        "$P"
_emit  R "S-F4"  "dmesg"            "kernel ring buffer"          "$P"
_emit  R "S-F5"  "doctor"           "kldload-doctor loop"         "$P"
_emit  R "S-F6"  "iotop"            "per-process disk I/O"        "$P"
_emit  R "S-F7"  "kubectl top pods" "pod mem/cpu heavyweights"    "$P"
_emit  R "S-F8"  "cilium drops"     "cilium monitor --type drop"  "$P"
_emit  R "S-F9"  "zfs iostat -l"    "per-dataset latency"         "$P"
_emit  R "S-F10" "kinspect picker"  "pick 2 endpoints, inspect"   "$P"
_emit  R "S-F11" "tcpretrans"       "TCP retransmit events"       "$P"
_emit  R "S-F12" "tcpconnect"       "every outbound TCP connect"  "$P"
_blank R
_head  R "▸ Window + pane ops" "" "$C"
_emit  R "Alt+Enter" "new window"    "blank shell window"         "$C"
_emit  R "Alt+\\\\"  "vsplit"        "pane to the right"          "$C"
_emit  R "Alt+-"   "hsplit"          "pane below"                 "$C"
_emit  R "Alt+x"   "close pane"      "kill current pane"          "$C"
_emit  R "Alt+q"   "close window"    "kill current window"        "$C"
_emit  R "Ctrl+q"  "close window"    "alias for Alt+q"            "$C"
_blank R
_head  R "▸ Navigation" "(Shift+Arrow, Alt+Arrow)" "$C"
_emit  R "Alt+arrow" "walk panes"    "move focus between panes"   "$C"
_emit  R "S-Right"  "next window"    "F-key tab forward"          "$C"
_emit  R "S-Left"   "prev window"    "F-key tab back"             "$C"

# ── Print columns side by side ─────────────────────────────────────────
# Every LEFT row is exactly 64 visible cols (matches _emit/_head padding).
# Empty rows get a 64-space fallback so RIGHT starts at the same column
# whether LEFT has a row, header, or blank.
_blankL=$(printf '%.0s ' {1..64})
max=${#LEFT[@]}
(( ${#RIGHT[@]} > max )) && max=${#RIGHT[@]}
for ((i=0; i<max; i++)); do
    printf "%s%s\n" "${LEFT[i]:-$_blankL}" "${RIGHT[i]:-}"
done

printf "\n${D}   ${G}kztest-tail${D} follows the latest zfs test run's full.log.${N}\n"
printf "${D}   ${G}kinspect <a> <b>${D} opens a 3-pane layout watching comms between two endpoints.${N}\n\n"
