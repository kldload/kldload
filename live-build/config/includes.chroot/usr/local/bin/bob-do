#!/usr/bin/env bash
# bob-do — plan + confirm + execute commands
# "The Sergeant reads orders back before executing."
#
# Usage: bob-do "install nginx and configure reverse proxy for port 3000"
#        bob-do "create a user account for deploy"
#        bob-do "set up wireguard tunnel to 10.0.0.1"
set -euo pipefail

BOB_MODEL="${BOB_MODEL:-bob}"
BOB_DIR="${HOME}/.bob"
HISTORY_DIR="${BOB_DIR}/history"

mkdir -p "$HISTORY_DIR"

# ── Colors ───────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

if [[ $# -eq 0 ]]; then
    echo -e "${CYAN}bob-do${NC} — translate natural language to planned commands"
    echo ""
    echo "Usage: bob-do \"your request in plain English\""
    echo ""
    echo "The Sergeant reads orders back before executing."
    exit 0
fi

REQUEST="$*"

# ── Gather system context ────────────────────────────────────────────────────
_os=$(cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d= -f2 | tr -d '"')
_pkg_mgr="dnf"
command -v apt &>/dev/null && _pkg_mgr="apt"
command -v pacman &>/dev/null && _pkg_mgr="pacman"
_user=$(whoami)
_is_root=$([[ "$_user" == "root" ]] && echo "yes" || echo "no (has sudo)")

CTX="OS: ${_os}
Package manager: ${_pkg_mgr}
User: ${_user} (root: ${_is_root})
Shell: bash"

# ── Ask Bob to plan ──────────────────────────────────────────────────────────
echo -e "${DIM}The Sergeant reads orders back before executing.${NC}"
echo -e "${BLUE}Planning:${NC} ${REQUEST}"
echo ""

PLAN_PROMPT="You are a command planner. Given a request, output ONLY a JSON object with this exact structure:
{
  \"plan\": \"one line description of what will happen\",
  \"risk\": \"low|medium|high\",
  \"risk_reason\": \"why this risk level\",
  \"commands\": [
    {\"cmd\": \"the exact shell command\", \"desc\": \"what this does\"}
  ]
}

System context:
${CTX}

Request: ${REQUEST}

Output ONLY valid JSON. No explanation. No markdown fences."

PLAN_JSON=$(echo "$PLAN_PROMPT" | ollama run "$BOB_MODEL" 2>/dev/null)

# ── Parse the plan ───────────────────────────────────────────────────────────
# Try to extract JSON from response (model might add extra text)
PLAN_JSON=$(echo "$PLAN_JSON" | python3 -c "
import sys, json, re
text = sys.stdin.read()
# Find JSON object in text
match = re.search(r'\{[\s\S]*\}', text)
if match:
    try:
        obj = json.loads(match.group())
        print(json.dumps(obj))
    except:
        print('{}')
else:
    print('{}')
" 2>/dev/null)

if [[ "$PLAN_JSON" == "{}" ]] || [[ -z "$PLAN_JSON" ]]; then
    echo -e "${RED}Bob couldn't plan that. Try rephrasing.${NC}"
    exit 1
fi

# Extract fields
_plan=$(echo "$PLAN_JSON" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('plan',''))")
_risk=$(echo "$PLAN_JSON" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('risk','medium'))")
_risk_reason=$(echo "$PLAN_JSON" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('risk_reason',''))")
_commands=$(echo "$PLAN_JSON" | python3 -c "
import sys,json
d=json.load(sys.stdin)
for c in d.get('commands',[]):
    print(c.get('desc',''))
    print('  $ ' + c.get('cmd',''))
    print()
")

# ── Display the plan ─────────────────────────────────────────────────────────
echo -e "${BOLD}Plan:${NC} ${_plan}"
echo ""

# Risk badge
case "$_risk" in
low) echo -e "Risk: ${GREEN}LOW${NC} — ${_risk_reason}" ;;
medium) echo -e "Risk: ${YELLOW}MEDIUM${NC} — ${_risk_reason}" ;;
high) echo -e "Risk: ${RED}HIGH${NC} — ${_risk_reason}" ;;
*) echo -e "Risk: ${YELLOW}${_risk}${NC} — ${_risk_reason}" ;;
esac
echo ""

echo -e "${BOLD}Commands:${NC}"
echo "$_commands"

# ── Confirm ──────────────────────────────────────────────────────────────────
echo ""
if [[ "$_risk" == "high" ]]; then
    echo -e "${RED}${BOLD}HIGH RISK — type YES to proceed:${NC}"
    read -rp "> " _confirm
    if [[ "$_confirm" != "YES" ]]; then
        echo -e "${DIM}Aborted.${NC}"
        exit 0
    fi
else
    read -rp "Execute? [y/N] " _confirm
    if [[ "$_confirm" != "y" ]] && [[ "$_confirm" != "Y" ]]; then
        echo -e "${DIM}Aborted.${NC}"
        exit 0
    fi
fi

# ── Execute ──────────────────────────────────────────────────────────────────
echo ""
_log="${HISTORY_DIR}/$(date +%Y%m%d-%H%M%S)-bob-do.log"
echo "# bob-do: ${REQUEST}" >"$_log"
echo "# plan: ${_plan}" >>"$_log"
echo "# risk: ${_risk}" >>"$_log"
echo "# date: $(date)" >>"$_log"
echo "" >>"$_log"

_cmds=$(echo "$PLAN_JSON" | python3 -c "
import sys,json
d=json.load(sys.stdin)
for c in d.get('commands',[]):
    print(c.get('cmd',''))
")

while IFS= read -r _cmd; do
    [[ -z "$_cmd" ]] && continue
    echo -e "${CYAN}\$ ${_cmd}${NC}"
    echo "$ ${_cmd}" >>"$_log"

    set +e
    eval "$_cmd" 2>&1 | tee -a "$_log"
    _exit=$?
    set -e

    if [[ $_exit -ne 0 ]]; then
        echo -e "${RED}Command failed (exit ${_exit})${NC}"
        echo "# FAILED: exit ${_exit}" >>"$_log"
        read -rp "Continue with remaining commands? [y/N] " _cont
        if [[ "$_cont" != "y" ]] && [[ "$_cont" != "Y" ]]; then
            echo -e "${DIM}Stopped.${NC}"
            exit 1
        fi
    else
        echo -e "${GREEN}✔${NC}"
        echo "# OK" >>"$_log"
    fi
    echo "" >>"$_log"
done <<<"$_cmds"

echo ""
echo -e "${GREEN}${BOLD}Done.${NC} Log: ${_log}"
