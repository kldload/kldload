#!/usr/bin/env bash
# kldload-rag-index — bash wrapper around the python indexer.
# Invokes /usr/local/lib/kldload-rag/kldload_rag_index.py with the right env.
#
# Usage:
#   kldload-rag-index           # full re-index, verbose
#   kldload-rag-index --quiet   # silent (cron/systemd)
#   kldload-rag-index --paths /opt/extra-docs
set -euo pipefail

# Rule 9: --help answers before the root re-exec below, straight from the
# header banner above. The explanation was already written -- it just could not
# be reached without a password, and on a machine with no sudo rights not at
# all. Prints every consecutive comment line from line 2, the banner idiom
# used by the other tools here.
case "${1:-}" in
-h | --help)
    sed -n '2,${/^#/!q; s/^# \{0,1\}//; p}' "$0"
    exit 0
    ;;
esac

if [[ $EUID -ne 0 ]]; then
    exec sudo "$0" "$@"
fi

exec /usr/bin/python3 /usr/local/lib/kldload-rag/kldload_rag_index.py "$@"
