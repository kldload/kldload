#!/usr/bin/env bash
# kldload-rag-index — bash wrapper around the python indexer.
# Invokes /usr/local/lib/kldload-rag/kldload_rag_index.py with the right env.
#
# Usage:
#   kldload-rag-index           # full re-index, verbose
#   kldload-rag-index --quiet   # silent (cron/systemd)
#   kldload-rag-index --paths /opt/extra-docs
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    exec sudo "$0" "$@"
fi

exec /usr/bin/python3 /usr/local/lib/kldload-rag/kldload_rag_index.py "$@"
