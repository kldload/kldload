#!/usr/bin/env bash
set -euo pipefail

# kimage — build, export, and deploy golden cloud-init images
# Usage:
#   kimage build                     Prep this system as a golden image
#   kimage export [format] [outdir]  Export disk to image (default: qcow2)
#   kimage deploy <image> <count>    Stamp out N VMs from an image
#   kimage full [count]              Build + export + deploy in one shot

DISK="${KIMAGE_DISK:-}"
OUTDIR="${KIMAGE_OUTDIR:-/srv/images}"
NAME="${KIMAGE_NAME:-kldload-golden-$(date -u +%Y%m%d)}"

die() { echo "ERROR: $*" >&2; exit 1; }
log() { echo "[kimage] $*"; }
ok()  { echo "[kimage] OK: $*"; }

# Auto-detect the root disk
detect_disk() {
  if [[ -n "$DISK" ]]; then return; fi
  local rootdev
  rootdev="$(findmnt -no SOURCE / 2>/dev/null || true)"
  if [[ "$rootdev" == *"zfs"* ]] || [[ -z "$rootdev" ]]; then
    # ZFS root — find the disk backing rpool
    local pool_disk
    pool_disk="$(zpool status rpool 2>/dev/null | awk '/ONLINE/{print $1}' | grep -E '^(sd|vd|nvme)' | head -1 || true)"
    if [[ -n "$pool_disk" ]]; then
      # Strip partition number to get whole disk
      DISK="/dev/$(echo "$pool_disk" | sed 's/[0-9]*$//' | sed 's/p$//')"
    fi
  else
    DISK="/dev/$(lsblk -no PKNAME "$rootdev" 2>/dev/null | head -1)"
  fi
  [[ -b "$DISK" ]] || die "Could not detect root disk — set KIMAGE_DISK=/dev/sdX"
  log "Detected root disk: ${DISK}"
}

cmd_build() {
  log "Preparing golden image..."

  # Install cloud-init if not present
  if ! command -v cloud-init >/dev/null 2>&1; then
    log "Installing cloud-init..."
    kpkg install cloud-init
  fi
  ok "cloud-init installed"

  # Enable cloud-init services
  for svc in cloud-init-local cloud-init cloud-config cloud-final; do
    systemctl enable "$svc" 2>/dev/null || true
  done
  ok "cloud-init services enabled"

  # Clean machine identity
  log "Cleaning machine identity..."
  cloud-init clean --logs 2>/dev/null || true
  rm -f /etc/ssh/ssh_host_*
  rm -f /etc/machine-id && touch /etc/machine-id
  truncate -s 0 /etc/hostname 2>/dev/null || true

  # Clear logs and history
  truncate -s 0 /var/log/wtmp 2>/dev/null || true
  truncate -s 0 /var/log/lastlog 2>/dev/null || true
  rm -rf /tmp/* /var/tmp/* 2>/dev/null || true
  history -c 2>/dev/null || true

  # ZFS snapshot
  local root_ds
  root_ds="$(zfs list -Ho name / 2>/dev/null || echo "rpool/ROOT/kldload")"
  log "Snapshotting ${root_ds}@golden..."
  zfs snapshot "${root_ds}@golden" 2>/dev/null || \
    zfs destroy "${root_ds}@golden" 2>/dev/null && \
    zfs snapshot "${root_ds}@golden"
  ok "Golden snapshot: ${root_ds}@golden"

  ok "Golden image ready — run 'kimage export' to export"
}

cmd_export() {
  local fmt="${1:-qcow2}"
  local outdir="${2:-$OUTDIR}"

  detect_disk
  mkdir -p "$outdir"

  command -v qemu-img >/dev/null || die "qemu-img not found — kpkg install qemu-img"

  log "Exporting ${DISK} → ${outdir}/${NAME}.${fmt}"

  case "$fmt" in
    qcow2)
      qemu-img convert -f raw -O qcow2 -c -p "$DISK" "${outdir}/${NAME}.qcow2"
      ;;
    raw)
      dd if="$DISK" of="${outdir}/${NAME}.raw" bs=4M status=progress conv=sparse
      ;;
    vhd)
      qemu-img convert -f raw -O vpc -o subformat=fixed,force_size "$DISK" "${outdir}/${NAME}.vhd"
      ;;
    vmdk)
      qemu-img convert -f raw -O vmdk -o subformat=streamOptimized "$DISK" "${outdir}/${NAME}.vmdk"
      ;;
    all)
      for f in qcow2 vmdk vhd raw; do
        cmd_export "$f" "$outdir"
      done
      return
      ;;
    *)
      die "Unknown format: $fmt (qcow2, raw, vhd, vmdk, all)"
      ;;
  esac

  local size
  size="$(du -sh "${outdir}/${NAME}.${fmt}" 2>/dev/null | cut -f1)"
  ok "Exported: ${outdir}/${NAME}.${fmt} (${size})"
}

cmd_deploy() {
  local image="${1:-}"
  local count="${2:-3}"
  local vm_ram="${KIMAGE_RAM:-4096}"
  local vm_cores="${KIMAGE_CORES:-4}"
  local base_vmid="${KIMAGE_VMID_START:-300}"

  [[ -f "$image" ]] || die "Image not found: $image"

  # Check for virt-install
  command -v virt-install >/dev/null || die "virt-install not found — kpkg install virt-install"

  log "Deploying ${count} VMs from ${image}..."

  for i in $(seq 1 "$count"); do
    local vm_name="kldload-node-${i}"
    local vm_disk="/var/lib/libvirt/images/${vm_name}.qcow2"

    log "Creating ${vm_name}..."

    # Destroy existing
    virsh destroy "$vm_name" 2>/dev/null || true
    virsh undefine "$vm_name" --nvram --remove-all-storage 2>/dev/null || true

    # Create disk from golden image (instant CoW copy if on same FS)
    cp --reflink=auto "$image" "$vm_disk"
    chown qemu:qemu "$vm_disk" 2>/dev/null || true

    # Create cloud-init ISO with unique hostname
    local ci_dir
    ci_dir="$(mktemp -d)"
    cat > "${ci_dir}/meta-data" <<EOF
instance-id: ${vm_name}
local-hostname: ${vm_name}
EOF
    cat > "${ci_dir}/user-data" <<EOF
#cloud-config
hostname: ${vm_name}
manage_etc_hosts: true
users:
  - name: admin
    groups: wheel
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: Passw0rd
    ssh_authorized_keys:
      - $(cat ~/.ssh/id_ed25519.pub 2>/dev/null || echo "# no key found")
runcmd:
  - systemctl restart sshd
EOF

    local ci_iso="/var/lib/libvirt/images/${vm_name}-cidata.iso"
    genisoimage -output "$ci_iso" -volid cidata -joliet -rock \
      "${ci_dir}/meta-data" "${ci_dir}/user-data" 2>/dev/null \
      || mkisofs -output "$ci_iso" -volid cidata -joliet -rock \
        "${ci_dir}/meta-data" "${ci_dir}/user-data" 2>/dev/null \
      || die "Could not create cloud-init ISO — install genisoimage"
    rm -rf "$ci_dir"

    virt-install \
      --name "$vm_name" \
      --ram "$vm_ram" --vcpus "$vm_cores" \
      --disk "path=${vm_disk},format=qcow2,bus=virtio" \
      --disk "path=${ci_iso},device=cdrom" \
      --os-variant centos-stream9 \
      --network network=default,model=virtio \
      --boot uefi,firmware.feature0.name=secure-boot,firmware.feature0.enabled=no \
      --graphics vnc,listen=0.0.0.0 \
      --noautoconsole \
      --import

    local vm_ip
    vm_ip="$(virsh domifaddr "$vm_name" 2>/dev/null | awk '/ipv4/{print $4}' | cut -d/ -f1 || echo "pending")"
    ok "${vm_name} deployed (IP: ${vm_ip})"
  done

  echo ""
  log "All ${count} VMs deployed:"
  virsh list --all 2>/dev/null | grep kldload-node || true
  echo ""
  log "Wait ~60s for cloud-init, then: ssh admin@<ip>"
}

cmd_full() {
  local count="${1:-3}"

  cmd_build

  log "Syncing disks before export..."
  sync

  detect_disk
  mkdir -p "$OUTDIR"
  cmd_export qcow2 "$OUTDIR"

  cmd_deploy "${OUTDIR}/${NAME}.qcow2" "$count"
}

# ── Usage ──────────────────────────────────────────────────────────────────────

usage() {
  echo "kimage — build and deploy golden cloud-init images"
  echo ""
  echo "Usage: kimage <command> [args]"
  echo ""
  echo "Commands:"
  echo "  build                     Prep this system as a cloud-init golden image"
  echo "  export [format] [outdir]  Export disk image (qcow2, raw, vhd, vmdk, all)"
  echo "  deploy <image> <count>    Stamp out N VMs from an image"
  echo "  full [count]              Build + export + deploy in one shot"
  echo ""
  echo "Environment:"
  echo "  KIMAGE_DISK        Override root disk detection (default: auto)"
  echo "  KIMAGE_OUTDIR      Output directory (default: /srv/images)"
  echo "  KIMAGE_NAME        Image name (default: kldload-golden-YYYYMMDD)"
  echo "  KIMAGE_RAM         VM RAM in MB (default: 4096)"
  echo "  KIMAGE_CORES       VM cores (default: 4)"
  echo ""
  echo "Demo workflow:"
  echo "  1. Install kldloadOS from USB"
  echo "  2. kimage full 3"
  echo "  3. Watch 3 VMs boot with unique hostnames"
}

case "${1:-help}" in
  build)    cmd_build ;;
  export)   shift; cmd_export "$@" ;;
  deploy)   shift; cmd_deploy "$@" ;;
  full)     shift; cmd_full "${1:-3}" ;;
  help|*)   usage ;;
esac
