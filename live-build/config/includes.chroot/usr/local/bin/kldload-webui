                    await websocket.send(json.dumps({"type": "service_saved", "id": id_}))
                elif action == "service_load":
                    svc = db_load_service(msg.get("id", ""))
                    if svc:
                        await websocket.send(json.dumps({"type": "service_data", "service": svc}))
                    else:
                        await websocket.send(json.dumps({"type": "error", "msg": "service not found"}))
                elif action == "service_delete":
                    db_delete_service(msg.get("id", ""))
                    db_log_event("service_delete", msg.get("id",""), "Service deleted")
                    await websocket.send(json.dumps({"type": "service_deleted", "id": msg.get("id")}))
                elif action == "service_deploy":
                    await _service_deploy(websocket, msg)
                elif action == "db_export":
                    export = db_export_all()
                    await websocket.send(json.dumps({"type": "db_export", "data": export}))
                elif action == "db_import":
                    counts = db_import_all(msg.get("data", {}), merge=msg.get("merge", True))
                    db_log_event("db_import", "system", f"DB import: {counts}")
                    await websocket.send(json.dumps({"type": "db_imported", "counts": counts}))
                elif action == "ui_mode":
                    live = is_live_mode()
                    nenv = get_node_env()
                    role = nenv.get("KLDLOAD_NODE_ROLE", "live" if live else "node")
                    ui_title = nenv.get("KLDLOAD_UI_TITLE", "kldload")
                    hostname = nenv.get("KLDLOAD_NODE_HOSTNAME", "")
                    await websocket.send(json.dumps({
                        "type": "ui_mode",
                        "live": live,
                        "role": role,
                        "ui_title": ui_title,
                        "hostname": hostname,
                        "db_path": str(DB_PATH),
                        "db_exists": DB_PATH.exists(),
                        "db_size_kb": round(DB_PATH.stat().st_size / 1024, 1) if DB_PATH.exists() else 0,
                    }))
                elif action == "infra_status":
                    clusters = db_list_clusters()
                    nodes    = db_list_nodes()
                    vms      = db_list_vms()
                    events   = db_list_events(50)
                    # Augment nodes with live virsh VM count per host.
                    # Async — virsh can stall briefly on a busy libvirtd.
                    vm_counts = {}
                    _rc, _out = await _run_text(
                        ["virsh", "list", "--all", "--name"], timeout=5)
                    if _rc == 0:
                        vm_counts["localhost"] = len([l for l in _out.strip().splitlines() if l.strip()])
                    await websocket.send(json.dumps({
                        "type": "infra_status",
                        "clusters": clusters,
                        "nodes": nodes,
                        "vms": vms,
                        "events": events,
                        "vm_counts": vm_counts,
                    }))
                elif action == "cluster_save":
                    # Save a cluster definition to DB (called from Cluster Designer deploy flow)
                    id_ = db_upsert_cluster(
                        msg.get("name", "unnamed"),
                        msg.get("data", {}),
                        template_id=msg.get("template_id", ""),
                        status=msg.get("status", "designing"),
                    )
                    db_log_event("cluster_save", id_, f"Cluster saved: {msg.get('name')}")
                    await websocket.send(json.dumps({"type": "cluster_saved", "id": id_}))
                elif action == "vm_clone":
                    # Backgrounded — virt-install/qemu-img take 5-10s of
                    # SYNC subprocess work that would block the recv loop
                    # and starve the WS heartbeat. Running as a task lets
                    # the recv loop keep accepting more messages (so
                    # qty=N from the Create form actually fires N times
                    # concurrently instead of timing out the connection
                    # after the first). Caught .113 2026-05-17.
                    asyncio.create_task(_vm_clone(websocket, msg))
                elif action == "vm_snaps":
                    await _vm_snaps(websocket, msg)
                elif action == "vm_rollback":
                    await _vm_rollback(websocket, msg)
                elif action == "vm_replace":
                    asyncio.create_task(_vm_replace(websocket, msg))
                elif action == "vm_create_cloud":
                    # Same reason as vm_clone — back-to-back create
                    # requests would block the connection serially.
                    asyncio.create_task(_vm_create_cloud(websocket, msg))
                elif action == "vm_delete_full":
                    await _vm_delete_full(websocket, msg)

                # ── Free-edition actions (ZFS / snapshots / logs) ──────────────
                elif action == "zfs_status":
                    # Async to avoid blocking the event loop on a slow
                    # `zpool status -v` (can take seconds when a scrub is
                    # mid-flight or a vdev is degraded).
                    _, out = await _run_text(["zpool", "status", "-v"], timeout=10)
                    await websocket.send(json.dumps({"type": "zfs_status", "output": out}))

                elif action == "zfs_scrub_all":
                    # Kicks zpool scrub on every imported pool. Scrub is a
                    # background operation — the call returns immediately;
                    # progress shows in `zpool status -v` and on the
                    # ZFS Pool Health Grafana dashboard. Safe to invoke on
                    # an already-scrubbing pool (zpool refuses gracefully).
                    lines = []
                    rc, pools_out = await _run_text(
                        ["zpool", "list", "-H", "-o", "name"], timeout=5)
                    pools = pools_out.split() if rc == 0 else []
                    if not pools:
                        lines.append("no imported pools — nothing to scrub"
                                     if rc == 0 else f"zpool list failed: {pools_out.strip()}")
                    for p in pools:
                        rc, out = await _run_text(["zpool", "scrub", p], timeout=5)
                        lines.append(f"started: {p}" if rc == 0 else f"{p}: {out.strip()}")
                    _, status_out = await _run_text(["zpool", "status", "-v"], timeout=10)
                    await websocket.send(json.dumps({
                        "type": "zfs_status",
                        "output": "\n".join(lines) + "\n\n--- zpool status ---\n" + status_out,
                    }))

                elif action == "snapshot_list":
                    # Sort newest-first (-S creation) so the most recent
                    # snaps land at the top of the panel. Previously
                    # zfs returned creation-ascending and the JS sliced
                    # to first 20 — newest manual snaps got cut off.
                    # Async exec so a slow `zfs list` on a large pool
                    # doesn't freeze every other client's event loop.
                    _rc, out = await _run_text(
                        ["zfs", "list", "-t", "snapshot", "-o", "name,used,creation",
                         "-S", "creation", "-H"], timeout=15)
                    snaps = []
                    if _rc == 0:
                        for line in out.strip().splitlines():
                            parts = line.split('\t')
                            if len(parts) >= 2:
                                snaps.append({
                                    "name":     parts[0],
                                    "used":     parts[1],
                                    "creation": parts[2] if len(parts) >= 3 else "",
                                })
                    await websocket.send(json.dumps({"type": "snapshot_list", "snapshots": snaps}))

                elif action == "snapshot_take":
                    # `path` is optional — if present, snapshot that dataset
                    # specifically (e.g. rpool/vms/<name> from the VM Snap
                    # button). If absent, snapshot the whole rpool recursively
                    # (the global Take-Snapshot button). Both produce a
                    # snapshot tagged @manual-<ts>. Previously this ignored
                    # `path` and always snapped rpool — VM Snap button looked
                    # like a no-op because the snap landed at rpool level, not
                    # per-VM. Caught .133 2026-05-16.
                    import datetime as _dt
                    # ISO-ish timestamp — readable in the rollback dropdown.
                    # ZFS allows ':' in snap names; sanoid uses the same style.
                    ts = _dt.datetime.now().strftime("%Y-%m-%d_%H:%M:%S")
                    _ds = msg.get("path") or "rpool"
                    if not re.match(r'^[A-Za-z0-9_/.\-]+$', _ds):
                        await websocket.send(json.dumps({"type": "error", "msg": "invalid snapshot path"}))
                        continue
                    try:
                        subprocess.check_call(
                            ["zfs", "snapshot", "-r", f"{_ds}@manual-{ts}"],
                            stderr=subprocess.DEVNULL)
                        # Retention: when snapping a specific dataset (not the
                        # whole rpool), keep only the 5 newest @manual-* snaps
                        # so the Rollback dropdown stays bounded. Pool-wide
                        # snaps (the global takeSnapshot button) skip pruning —
                        # those are explicit operator action with their own
                        # cadence and may matter for cross-dataset rollback.
                        if msg.get("path"):
                            try:
                                _snap_list = subprocess.check_output(
                                    ["zfs", "list", "-H", "-t", "snapshot",
                                     "-o", "name", "-s", "creation", _ds],
                                    text=True, stderr=subprocess.DEVNULL
                                ).strip().splitlines()
                                _manual = [s for s in _snap_list if "@manual-" in s]
                                # Drop oldest until at most 5 remain.
                                for _old in _manual[:-5]:
                                    subprocess.call(
                                        ["zfs", "destroy", "-r", _old],
                                        stderr=subprocess.DEVNULL)
                            except Exception:
                                # Prune failure is non-fatal — the snap was
                                # taken, retention just didn't run this round.
                                pass
                        await websocket.send(json.dumps({"type": "snapshot_done", "ts": ts, "dataset": _ds}))
                    except Exception as e:
                        await websocket.send(json.dumps({"type": "error", "msg": str(e)}))

                elif action == "snapshot_rollback":
                    snap = msg.get("name", "")
                    try:
                        subprocess.check_call(
                            ["zfs", "rollback", "-r", snap],
                            stderr=subprocess.DEVNULL)
                        await websocket.send(json.dumps({"type": "snapshot_done", "name": snap}))
                    except Exception as e:
                        await websocket.send(json.dumps({"type": "error", "msg": str(e)}))

                elif action == "be_list":
                    # Async — kbe list runs zfs commands that can stall
                    # briefly on a busy pool.
                    _, out = await _run_text(
                        ["/usr/lib/kldload-installer/backend/bin/kbe", "list"], timeout=15)
                    await websocket.send(json.dumps({"type": "be_list", "output": out}))

                elif action == "be_create":
                    name = msg.get("name", "")
                    try:
                        subprocess.check_call(
                            ["/usr/lib/kldload-installer/backend/bin/kbe", "create", name],
                            stderr=subprocess.DEVNULL)
                        await websocket.send(json.dumps({"type": "be_list", "output": f"Created: {name}"}))
                    except Exception as e:
                        await websocket.send(json.dumps({"type": "error", "msg": str(e)}))

                elif action == "read_log":
                    key = msg.get("log", "firstboot")
                    log_path = LOG_FILES.get(key, f"/var/log/kldload/{key}.log")
                    try:
                        content = Path(log_path).read_text(errors="replace")[-32768:]
                    except Exception:
                        content = f"(log not found: {log_path})"
                    await websocket.send(json.dumps({"type": "log_content", "key": key, "content": content}))

                elif action == "install_state":
                    state = {"running": False, "rc": None}
                    try:
                        state = json.loads(INSTALL_STATE_PATH.read_text())
                    except Exception:
                        pass
                    # Cross-check with systemd: if a kldinstall-* unit is
                    # actually active, the install IS running regardless of
                    # what the state file says. Caught .133 2026-05-18: state
                    # file said running:false rc:0 (stale from a prior run)
                    # while a new install was mid-flight, so the UI hid the
                    # running panel. Trust systemd over the file.
                    try:
                        _q = await asyncio.create_subprocess_exec(
                            "systemctl", "list-units", "--no-legend",
                            "--state=active", "kldinstall-*.service",
                            stdout=asyncio.subprocess.PIPE,
                            stderr=asyncio.subprocess.DEVNULL,
                        )
                        _out, _ = await _q.communicate()
                        if (_out or b"").strip():
                            state["running"] = True
                            state["rc"] = None
                    except Exception:
                        pass
                    await websocket.send(json.dumps({"type": "install_state", **state}))
                elif action == "rhel_creds_prefill":
                    # Surface the saved RHEL secrets to the Install-to-Disk
                    # form so the operator sees the credentials state and
                    # can override per-install without re-typing. Loopback
                    # WS only — same trust boundary as the saved secrets
                    # themselves. Empty string for any missing secret.
                    await websocket.send(json.dumps({
                        "type":     "rhel_creds_prefill",
                        "username": secret_get("rhel-username") or "",
                        "password": secret_get("rhel-password") or "",
                        "key":      secret_get("rhel-activation-key") or "",
                        "org":      secret_get("rhel-organization") or "",
                    }))
                elif action == "install_reboot":
                    # Reboot the host into the installed system. Fires
                    # `systemctl reboot` via systemd-run so the command
                    # survives the webui's own SIGTERM during shutdown.
                    # 2-second delay so this WS reply can flush before
                    # the network goes down.
                    await websocket.send(json.dumps({
                        "type": "log_line", "target": "install",
                        "line": "[reboot] firing systemctl reboot in 2s — webui going down…",
                    }))
                    try:
                        await asyncio.create_subprocess_exec(
                            "systemd-run", "--on-active=2s", "--unit=kldload-postinstall-reboot",
                            "systemctl", "reboot",
                            stdout=asyncio.subprocess.DEVNULL,
                            stderr=asyncio.subprocess.DEVNULL,
                        )
                    except Exception as e:
                        await websocket.send(json.dumps({
                            "type": "error",
                            "msg": f"reboot failed to schedule: {e}",
                        }))
                elif action == "install_abort":
                    # Stop the active kldinstall-* systemd unit. The
                    # subprocess is in its own cgroup so systemctl stop
                    # kills the whole tree (debootstrap, dnf, pacstrap,
                    # whatever's mid-execution). Marks state.running=false
                    # with rc=-15 (SIGTERM) so the UI flips back to idle.
                    aborted = []
                    try:
                        _q = await asyncio.create_subprocess_exec(
                            "systemctl", "list-units", "--no-legend",
                            "--state=active", "kldinstall-*.service",
                            stdout=asyncio.subprocess.PIPE,
                            stderr=asyncio.subprocess.DEVNULL,
                        )
                        _out, _ = await _q.communicate()
                        for ln in (_out or b"").decode().splitlines():
                            parts = ln.strip().split()
                            if parts and parts[0].startswith("kldinstall-"):
                                unit = parts[0]
                                _s = await asyncio.create_subprocess_exec(
                                    "systemctl", "stop", unit,
                                    stdout=asyncio.subprocess.DEVNULL,
                                    stderr=asyncio.subprocess.PIPE,
                                )
                                await _s.wait()
                                aborted.append(unit)
                    except Exception as e:
                        await websocket.send(json.dumps({
                            "type": "error",
                            "msg": f"install_abort failed: {e}",
                        }))
                        continue
                    try:
                        INSTALL_STATE_PATH.write_text(
                            json.dumps({"running": False, "rc": -15}))
                    except Exception:
                        pass
                    await websocket.send(json.dumps({
                        "type": "log_line", "target": "install",
                        "line": f"[abort] stopped {len(aborted)} install unit(s)"
                                + (f": {', '.join(aborted)}" if aborted else ""),
                    }))
                    # Emit exec_done so the UI tears the running panel down.
                    await websocket.send(json.dumps({
                        "type": "exec_done", "target": "install", "rc": -15,
                    }))
                elif action == "install_reattach":
                    # Page refreshed mid-install — find the active kldinstall-*
                    # unit, grab its MainPID, and resume tailing the install
                    # log to this socket. Without this the UI shows the
                    # "Installing — do not power off" panel but the log box
                    # stays empty because the tail handler from the original
                    # _install() call died when the prior WS dropped.
                    log_path = "/var/log/kldload/install-direct.log"
                    main_pid = 0
                    unit_name = ""
                    try:
                        _q = await asyncio.create_subprocess_exec(
                            "systemctl", "list-units", "--no-legend",
                            "--state=active", "kldinstall-*.service",
                            stdout=asyncio.subprocess.PIPE,
                            stderr=asyncio.subprocess.DEVNULL,
                        )
                        _out, _ = await _q.communicate()
                        for ln in (_out or b"").decode().splitlines():
                            parts = ln.strip().split()
                            if parts and parts[0].startswith("kldinstall-"):
                                unit_name = parts[0]
                                break
                    except Exception:
                        unit_name = ""
                    if unit_name:
                        try:
                            _q = await asyncio.create_subprocess_exec(
                                "systemctl", "show", unit_name,
                                "--property=MainPID", "--value",
                                stdout=asyncio.subprocess.PIPE,
                                stderr=asyncio.subprocess.DEVNULL,
                            )
                            _out, _ = await _q.communicate()
                            out = (_out or b"").decode().strip()
                            if out.isdigit():
                                main_pid = int(out)
                        except Exception:
                            pass
                    if main_pid > 0:
                        # Client may pass `since_lines` to skip lines it
                        # already has in its DOM — prevents the replay
                        # storm where every reconnect re-dumps the last
                        # 400 lines (2026-05-18 fix).
                        try:
                            since_lines = int(msg.get("since_lines") or 0)
                        except Exception:
                            since_lines = 0
                        await websocket.send(json.dumps({
                            "type": "install_reattached",
                            "pid": main_pid, "unit": unit_name, "log": log_path,
                        }))
                        await _klab_test_tail(websocket, main_pid, log_path,
                                              target="install",
                                              since_lines=since_lines)
                    else:
                        await websocket.send(json.dumps({
                            "type": "install_reattach_noop",
                            "msg": "no active install unit found",
                        }))

                elif action == "network_info":
                    # Async — `ip addr` is fast but blocks the loop if
                    # netlink is congested (large numbers of veth/cilium
                    # interfaces on K8s nodes).
                    ifaces = []
                    _rc, _out = await _run_text(["ip", "-j", "addr"], timeout=5, merge_stderr=False)
                    if _rc == 0:
                        try:
                            import json as _json
                            for iface in _json.loads(_out):
                                name = iface.get("ifname", "")
                                up   = iface.get("operstate", "") in ("UP", "UNKNOWN")
                                addrs = [a.get("local", "") for a in iface.get("addr_info", [])
                                         if a.get("family") in ("inet", "inet6")]
                                ifaces.append({"name": name, "up": up, "addr": ", ".join(addrs)})
                        except Exception:
                            pass
                    await websocket.send(json.dumps({"type": "network_info", "interfaces": ifaces}))

                elif action == "ansible_status":
                    await _ansible_status(websocket)
                elif action == "ansible_list":
                    await _ansible_list(websocket)
                elif action == "ansible_run":
                    await _ansible_run(websocket, msg)
                elif action == "ansible_cancel":
                    _proc = RUNNING_PROCS.get("ansible_log")
                    if _proc and _proc.returncode is None:
                        try: _proc.kill()
                        except Exception: pass
                    await websocket.send(json.dumps({"type": "log_line", "target": "ansible_log", "line": "[cancel] killed"}))
                elif action == "playbook_upload":
                    await _playbook_upload(websocket, msg)
                elif action == "playbook_delete":
                    await _playbook_delete(websocket, msg)

                elif action == "helm_status":
                    await _helm_status(websocket)
                elif action == "helm_repo_list":
                    await _helm_repo_list(websocket)
                elif action == "helm_repo_add":
                    await _helm_repo_add(websocket, msg)
                elif action == "helm_repo_remove":
                    await _helm_repo_remove(websocket, msg)
                elif action == "helm_repo_update":
                    await _stream_proc(websocket, ["helm", "repo", "update"], target="helm_log")
                elif action == "helm_list":
                    await _helm_list(websocket)
                elif action == "helm_install":
                    await _helm_install(websocket, msg, upgrade=False)
                elif action == "helm_upgrade":
                    await _helm_install(websocket, msg, upgrade=True)
                elif action == "helm_uninstall":
                    await _helm_uninstall(websocket, msg)
                elif action == "helm_release_status":
                    await _helm_release_status(websocket, msg)

                # ── K8s extended actions ──────────────────────────────
                elif action == "k8s_status":
                    await _k8s_status(websocket)
                elif action == "k8s_pods":
                    await _k8s_pods(websocket)
                elif action == "k8s_bootstrap":
                    await _k8s_bootstrap(websocket, msg)
                elif action == "k8s_destroy_cluster":
                    # Destroy ALL K8s resources (cp + workers + zvols + kubelet state).
                    # No rebuild. Used by the "die-and-rebuild" demo flow on the
                    # K8s Overview lifecycle bar (2026-05-18). Followed by an
                    # explicit `k8s_bootstrap` if the operator wants it back.
                    await _stream_proc_detached(websocket,
                        ["kube-cluster", "destroy", "--yes"], target="k8s")
                    await _k8s_status(websocket)
                elif action == "k8s_cluster_scale":
                    await _k8s_cluster_scale(websocket, msg)
                elif action == "k8s_reset":
                    await _k8s_reset(websocket)
                elif action == "k8s_drain":
                    node = msg.get("node", "")
                    if node:
                        await _stream_proc(websocket, ["kubectl", "drain", node, "--ignore-daemonsets", "--delete-emptydir-data"], target="k8s")
                elif action == "k8s_uncordon":
                    node = msg.get("node", "")
                    if node:
                        await _stream_proc(websocket, ["kubectl", "uncordon", node], target="k8s")
                elif action == "k8s_cordon":
                    # Single-node cordon — bulk version exists in k8sBulk but
                    # the per-row UI needs an inline action. cordon blocks new
                    # pods without evicting existing ones (vs drain which does
                    # both).
                    node = msg.get("node", "")
                    if node:
                        await _stream_proc(websocket, ["kubectl", "cordon", node], target="k8s")
                elif action == "k8s_node_reboot":
                    # Graceful node reboot: cordon → virsh reboot (klab VMs)
                    # → uncordon once kubelet re-registers. We don't await the
                    # uncordon here because the node will be unreachable
                    # during boot; let the user re-uncordon manually or use
                    # a follow-up timer if needed.
                    node = msg.get("node", "")
                    if node:
                        await _stream_proc(websocket, ["kubectl", "cordon", node], target="k8s")
                        # klab VMs run on this host — virsh sees them by name.
                        # Falls back to SSH if not a libvirt domain.
                        check = await asyncio.create_subprocess_exec(
                            "virsh", "list", "--all", "--name",
                            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
                        out, _ = await check.communicate()
                        vm_names = (out.decode() if out else "").split()
                        if node in vm_names:
                            await _stream_proc(websocket, ["virsh", "reboot", node], target="k8s")
                        else:
                            # Non-klab node — SSH reboot via the install key
                            await _stream_proc(websocket, [
                                "ssh", "-i", "/root/.ssh/id_kldload",
                                "-o", "StrictHostKeyChecking=no",
                                "-o", "UserKnownHostsFile=/dev/null",
                                f"admin@{node}", "sudo systemctl reboot"
                            ], target="k8s")
                elif action == "k8s_kubelet_restart":
                    # Targeted recovery — restart just kubelet without a full
                    # VM reboot. Useful when kubelet is wedged but the rest of
                    # the node is fine. SSH-based; node must have the install
                    # admin key (klab/kube-cluster set this up automatically).
                    node = msg.get("node", "")
                    if node:
                        await _stream_proc(websocket, [
                            "ssh", "-i", "/root/.ssh/id_kldload",
                            "-o", "StrictHostKeyChecking=no",
                            "-o", "UserKnownHostsFile=/dev/null",
                            f"admin@{node}", "sudo systemctl restart kubelet"
                        ], target="k8s")
                elif action == "k8s_node_label":
                    # Add / remove labels on a node. msg.labels is a dict
                    # {key: value}; an empty value removes the label
                    # (`kubectl label node X key-`). Existing labels are
                    # overwritten with --overwrite to avoid the "already set"
                    # error.
                    node = msg.get("node", "")
                    labels = msg.get("labels", {})
                    if node and isinstance(labels, dict):
                        for k, v in labels.items():
                            if v == "" or v is None:
                                await _stream_proc(websocket, ["kubectl", "label", "node", node, f"{k}-"], target="k8s")
                            else:
                                await _stream_proc(websocket, ["kubectl", "label", "node", node, f"{k}={v}", "--overwrite"], target="k8s")
                elif action == "k8s_node_taint":
                    # Add / remove taints. msg.taints = list of dicts:
                    #   [{"key": "dedicated", "value": "gpu", "effect": "NoSchedule"}, ...]
                    # An item with no "value" / "effect" but a key alone
                    # removes that taint (`kubectl taint node X key-`).
                    node = msg.get("node", "")
                    taints = msg.get("taints", [])
                    if node and isinstance(taints, list):
                        for t in taints:
                            key = t.get("key", "")
                            if not key:
                                continue
                            value = t.get("value", "")
                            effect = t.get("effect", "")
                            if t.get("remove") or not effect:
                                await _stream_proc(websocket, ["kubectl", "taint", "node", node, f"{key}-"], target="k8s")
                            else:
                                spec = f"{key}={value}:{effect}" if value else f"{key}:{effect}"
                                await _stream_proc(websocket, ["kubectl", "taint", "node", node, spec, "--overwrite"], target="k8s")
                elif action == "k8s_node_shell_info":
                    # Open the SSH session in the existing kldload tmux
                    # session (the one ttyd-k9s renders at /k9s/) so the
                    # user just opens the modal and is already connected
                    # — no copy/paste needed. Falls back to showing the
                    # command if tmux isn't available.
                    #
                    # Auth on klab/kube-cluster VMs: root + password
                    # "kldload" (cloud-init seeded, key auth not set up
                    # for cross-host). sshpass handles password feed.
                    node = msg.get("node", "")
                    if not node:
                        return
                    # Look up node IP from kubectl
                    proc = await asyncio.create_subprocess_exec(
                        "kubectl", "get", "node", node,
                        "-o", "jsonpath={.status.addresses[?(@.type=='InternalIP')].address}",
                        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
                    out, _ = await proc.communicate()
                    ip = (out.decode() if out else "").strip() or node
                    # Display command (for the modal fallback / copy)
                    cmd_display = f"sshpass -p kldload ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@{ip}"
                    # Real command piped into tmux — use exec-style ssh
                    # so closing the shell closes the tmux window cleanly.
                    ssh_inner = (
                        f"sshpass -p kldload ssh -o StrictHostKeyChecking=no "
                        f"-o UserKnownHostsFile=/dev/null root@{ip}"
                    )
                    window_name = f"ssh-{node}"
                    # Switch to existing window if already open, else create
                    auto_ok = False
                    try:
                        check = await asyncio.create_subprocess_exec(
                            "tmux", "list-windows", "-t", "kldload", "-F", "#{window_name}",
                            stdout=asyncio.subprocess.PIPE,
                            stderr=asyncio.subprocess.DEVNULL)
                        wout, _ = await check.communicate()
                        windows = (wout.decode() if wout else "").split()
                        if window_name in windows:
                            await (await asyncio.create_subprocess_exec(
                                "tmux", "select-window", "-t", f"kldload:{window_name}",
                                stderr=asyncio.subprocess.DEVNULL)).wait()
                        else:
                            await (await asyncio.create_subprocess_exec(
                                "tmux", "new-window", "-t", "kldload",
                                "-n", window_name, ssh_inner,
                                stderr=asyncio.subprocess.DEVNULL)).wait()
                        auto_ok = True
                    except Exception:
                        # tmux unavailable — fallback to copy-paste path
                        pass
                    await websocket.send(json.dumps({
                        "type": "k8s_node_shell",
                        "node": node, "ip": ip,
                        "cmd": cmd_display,
                        "auto": auto_ok,
                        "window": window_name,
                    }))
                elif action == "k8s_logs":
                    # Pod logs — tail last N lines, return as one chunk.
                    # Used by the per-row Logs button on the Pods table.
                    name = msg.get("name", "")
                    ns = msg.get("namespace", "")
                    tail = msg.get("tail", 200)
                    container = msg.get("container", "")
                    if not name or not ns:
                        return
                    cmd = ["kubectl", "logs", name, "-n", ns, f"--tail={int(tail)}"]
                    if container:
                        cmd.extend(["-c", container])
                    try:
                        out = subprocess.check_output(
                            cmd, text=True, stderr=subprocess.STDOUT, timeout=20,
                            env={**os.environ, "KUBECONFIG": "/root/.kube/config", "HOME": "/root"})
                    except subprocess.CalledProcessError as e:
                        out = (e.output or str(e))
                    except Exception as e:
                        out = f"error fetching logs: {e}"
                    await websocket.send(json.dumps({
                        "type": "k8s_logs",
                        "name": name, "namespace": ns,
                        "container": container,
                        "logs": out[-200000:]  # safety cap at ~200KB
                    }))
                elif action == "k8s_pod_exec":
                    # Interactive shell into a pod via the kldload tmux session
                    # (the one ttyd-k9s renders at /k9s/). Frontend opens /k9s/
                    # in an iframe; tmux session has the new window selected so
                    # the user lands directly inside the pod shell.
                    #
                    # Wrap kubectl exec in a hold-on-exit fallback so:
                    #   - if kubectl fails (auth, network, pod restart) the
                    #     user sees the error instead of a vanishing window
                    #   - PS1 is forced so the pod's shell shows a prompt
                    #     (busybox/alpine often have empty PS1; user sees a
                    #     "blank pane" otherwise and assumes nothing happened)
                    name = msg.get("name", "")
                    ns = msg.get("namespace", "")
                    container = msg.get("container", "")
                    if not name or not ns:
                        return
                    # Force a visible PS1 so even minimal images show a prompt.
                    # `exec` for the shell so PID-1-style behavior is clean.
                    pod_shell = (
                        "PS1='[\\u@$(hostname) \\w]# ' "
                        "exec bash --norc 2>/dev/null || "
                        "PS1='# ' exec sh"
                    )
                    inner_cmd = (
                        f"kubectl exec -it -n {shlex.quote(ns)} {shlex.quote(name)}"
                        + (f" -c {shlex.quote(container)}" if container else "")
                        + f" -- /bin/sh -c {shlex.quote(pod_shell)}"
                    )
                    # Tmux command — keep the pane alive if kubectl exec fails
                    # so the user sees the error instead of an empty / vanished
                    # window. `read` blocks forever; user closes the modal.
                    tmux_cmd = (
                        f"echo '── kubectl exec → {ns}/{name} ──'; "
                        f"{inner_cmd}; "
                        "rc=$?; "
                        "echo; echo \"[exec exited rc=$rc] press Enter to close\"; "
                        "read"
                    )
                    window_name = f"pod-{ns}-{name}"[:40]
                    auto_ok = False
                    err_msg = ""
                    try:
                        # Bootstrap the kldload tmux session if missing.
                        # ttyd-k9s creates it lazily on browser connect — if
                        # the user clicks Shell BEFORE the /k9s/ iframe loads
                        # (or if no client ever connected this boot), there's
                        # no session for us to attach windows to. `has-session`
                        # is the canonical check; nonzero exit = session
                        # missing. We create it detached so ttyd will attach
                        # to it later as if it had been there all along.
                        hs = await asyncio.create_subprocess_exec(
                            "tmux", "has-session", "-t", "kldload",
                            stderr=asyncio.subprocess.DEVNULL)
                        if (await hs.wait()) != 0:
                            await (await asyncio.create_subprocess_exec(
                                "tmux", "new-session", "-d", "-s", "kldload", "-n", "home",
                                stderr=asyncio.subprocess.DEVNULL)).wait()
                        # Check existing windows
                        check = await asyncio.create_subprocess_exec(
                            "tmux", "list-windows", "-t", "kldload", "-F", "#{window_name}",
                            stdout=asyncio.subprocess.PIPE,
                            stderr=asyncio.subprocess.PIPE)
                        wout, werr = await check.communicate()
                        windows = (wout.decode() if wout else "").split()
                        if window_name in windows:
                            # Already open — just bring to front
                            p = await asyncio.create_subprocess_exec(
                                "tmux", "select-window", "-t", f"kldload:{window_name}",
                                stderr=asyncio.subprocess.PIPE)
                            _, err = await p.communicate()
                            if p.returncode != 0:
                                err_msg = f"select-window: {err.decode()[:200]}"
                            else:
                                auto_ok = True
                        else:
                            # New window — pass tmux_cmd as a single shell-command
                            # arg; tmux will run it via /bin/sh -c. Use absolute
                            # path to bash for tmux's command shell so PATH issues
                            # don't bite.
                            p = await asyncio.create_subprocess_exec(
                                "tmux", "new-window", "-t", "kldload",
                                "-n", window_name, tmux_cmd,
                                stderr=asyncio.subprocess.PIPE)
                            _, err = await p.communicate()
                            if p.returncode != 0:
                                err_msg = f"new-window: {err.decode()[:200]}"
                            else:
                                # Explicit select for safety — new-window should
                                # auto-select but be defensive about edge cases.
                                p2 = await asyncio.create_subprocess_exec(
                                    "tmux", "select-window", "-t", f"kldload:{window_name}",
                                    stderr=asyncio.subprocess.DEVNULL)
                                await p2.wait()
                                auto_ok = True
                    except Exception as ex:
                        err_msg = f"exception: {ex}"
                    await websocket.send(json.dumps({
                        "type": "k8s_pod_shell",
                        "name": name, "namespace": ns,
                        "auto": auto_ok, "window": window_name,
                        "cmd": inner_cmd,
                        "error": err_msg,
                    }))
                elif action == "k8s_delete_service":
                    # Per-row Delete button on the Services table. There was
                    # no UI surface for deleting a service before; if you
                    # built a LoadBalancer with the wrong externalTrafficPolicy
                    # you had to drop to kubectl.
                    name = msg.get("name", "")
                    ns = msg.get("namespace", "")
                    if not name or not ns:
                        return
                    await _stream_proc(websocket, ["kubectl", "delete", "service", name, "-n", ns], target="k8s")
                elif action == "k8s_describe":
                    # Surface kubectl describe in a modal — useful for "why
                    # is this pod pending" / "why does this service have no
                    # endpoints". Reuses the same handler shape as k8s_logs.
                    kind = msg.get("kind", "pod")
                    name = msg.get("name", "")
                    ns = msg.get("namespace", "")
                    if not name:
                        return
                    cmd = ["kubectl", "describe", kind, name]
                    if ns:
                        cmd.extend(["-n", ns])
                    try:
                        out = subprocess.check_output(
                            cmd, text=True, stderr=subprocess.STDOUT, timeout=20,
                            env={**os.environ, "KUBECONFIG": "/root/.kube/config", "HOME": "/root"})
                    except subprocess.CalledProcessError as e:
                        out = (e.output or str(e))
                    except Exception as e:
                        out = f"error: {e}"
                    await websocket.send(json.dumps({
                        "type": "k8s_describe",
                        "kind": kind, "name": name, "namespace": ns,
                        "text": out[-200000:]
                    }))
                elif action == "k8s_inspect":
                    await _k8s_inspect(websocket, msg)
                elif action == "k8s_top":
                    await _k8s_top(websocket)
                elif action == "k8s_namespaces":
                    await _k8s_namespaces(websocket)
                elif action == "k8s_deployments":
                    await _k8s_deployments(websocket, msg)
                elif action == "k8s_services":
                    await _k8s_services(websocket, msg)
                elif action == "k8s_scale":
                    await _k8s_scale(websocket, msg)
                elif action == "k8s_rollout_restart":
                    await _k8s_rollout_restart(websocket, msg)
                elif action == "k8s_rollout_undo":
                    await _k8s_rollout_undo(websocket, msg)
                elif action == "k8s_delete_pod":
                    await _k8s_delete_pod(websocket, msg)
                elif action == "k8s_delete_deployment":
                    await _k8s_delete_deployment(websocket, msg)
                elif action == "k8s_apply_yaml":
                    await _k8s_apply_yaml(websocket, msg)
                elif action == "k8s_bulk":
                    await _k8s_bulk(websocket, msg)
                elif action == "k8s_run_demo":
                    await _k8s_run_demo(websocket, msg)

                # ── klab actions ──────────────────────────────────────
                elif action == "klab_cancel":
                    await _klab_cancel(websocket, msg)
                elif action == "klab_status":
                    await _klab_status(websocket)
                elif action == "klab_golden":
                    await _klab_golden(websocket, msg)
                elif action == "klab_verify":
                    await _klab_verify(websocket, msg)
                elif action == "klab_deploy":
                    await _klab_deploy(websocket, msg)
                elif action == "klab_promote":
                    await _klab_promote(websocket, msg)
                elif action == "klab_rollback":
                    await _klab_rollback(websocket)
                elif action == "klab_test":
                    await _klab_test(websocket, msg)
                elif action == "klab_test_tail":
                    # Reconnecting client asking to re-attach to an already-
                    # running klab test — reads /var/run/klab/current-run.env
                    # and tails the live log back to this WS until the unit
                    # exits or this WS closes.
                    await _klab_test_reattach(websocket)
                elif action == "detached_reattach":
                    # Generic detached-job reattach: re-stream the log of an
                    # in-flight _stream_proc_detached job for {target}. Sent
                    # by the frontend on (re)connect when the active view
                    # has a build that may have outlived the prior WS.
                    await _detached_reattach(websocket, msg)
                elif action == "tmux_pull_buffer":
                    # Read the ttyd-k9s tmux session's paste-buffer so the UI
                    # can show its contents in a textarea where native browser
                    # copy works. Workaround for Clipboard API silently
                    # dropping the OSC 52 escape on self-signed-cert origins.
                    # The buffer is filled by `copy-selection` on mouse-drag
                    # release (see kldload-console binds).
                    try:
                        out = subprocess.check_output(
                            ["tmux", "-S", "/tmp/tmux-0/default",
                             "show-buffer"],
                            text=True, stderr=subprocess.DEVNULL, timeout=2)
                    except Exception:
                        out = ""
                    await websocket.send(json.dumps({
                        "type": "tmux_buffer", "text": out,
                    }))
                elif action == "klab_build_ztest_goldens":
                    target = msg.get("target", "all")
                    # Detached — a ztest golden build is 30-60 min per distro
                    # (compiles OpenZFS from source inside each VM). With the
                    # non-detached _stream_proc, any webui restart or WS drop
                    # killed the bash driver and left the half-built VM idling
                    # at a login prompt — observed .101 2026-05-18 where
                    # `klab golden-ztest all` was started, the WS bounced
                    # during the K8s scale chatter, and centos sat at the
                    # login screen for 12+ minutes with no driver.
                    await _stream_proc_detached(websocket, ["klab", "golden-ztest", target], target="klab")
                elif action == "klab_ztest_goldens":
                    await websocket.send(json.dumps({
                        "type": "klab_ztest_goldens",
                        "goldens": _klab_get_ztest_goldens(),
                    }))
                elif action == "klab_destroy":
                    await _klab_destroy(websocket, msg)
                elif action == "klab_vm_op":
                    await _klab_vm_op(websocket, msg)
                elif action == "klab_isolate":
                    await _klab_isolate(websocket, msg)
                elif action == "klab_metrics":
                    await _klab_metrics(websocket)
                elif action == "klab_flows":
                    await _klab_flows(websocket)
                elif action == "klab_test_results":
                    await _klab_test_results(websocket, msg)
                elif action == "klab_fault":
                    await _klab_fault(websocket, msg)
                elif action == "klab_what_happened":
                    await _klab_what_happened(websocket, msg)
                elif action == "klab_diff_capture":
                    await _klab_diff_capture(websocket, msg)
                elif action == "klab_diff_compare":
                    await _klab_diff_compare(websocket, msg)
                elif action == "klab_hubble_status":
                    await _klab_hubble_status(websocket)
                elif action == "klab_hubble_policy":
                    await _klab_hubble_policy(websocket, msg)
                elif action == "klab_hubble_capture":
                    await _klab_hubble_capture(websocket, msg)
                elif action == "klab_run_playbook":
                    await _klab_run_playbook(websocket, msg)
                elif action == "klab_explain":
                    await _klab_explain(websocket, msg)
                elif action == "bob_list":
                    convos = db_bob_list()
                    await websocket.send(json.dumps({"type": "bob_list", "conversations": convos}))
                elif action == "bob_load":
                    conv = db_bob_load(msg.get("id", ""))
                    if conv:
                        await websocket.send(json.dumps({"type": "bob_loaded", "conversation": conv}))
                    else:
                        await websocket.send(json.dumps({"type": "error", "msg": "conversation not found"}))
                elif action == "bob_save":
                    db_bob_save(msg.get("id", str(uuid.uuid4())), msg.get("title", ""), msg.get("messages", []))
                    await websocket.send(json.dumps({"type": "bob_saved"}))
                elif action == "bob_delete":
                    db_bob_delete(msg.get("id", ""))
                    await websocket.send(json.dumps({"type": "bob_deleted"}))
                elif action == "bob_exec":
                    await _bob_execute(websocket, msg)
                elif action == "bob_chat":
                    # Spawn as a task so this handler stays free to read the
                    # follow-up `bob_confirm_response` from the SAME
                    # connection while _bob_chat awaits the confirm Future.
                    # Awaiting _bob_chat here deadlocks the per-connection
                    # handler: it blocks on the confirm future; the user's
                    # Approve click reaches the socket but can't be read
                    # because the handler is still inside _bob_chat →
                    # future never resolves → 120s timeout fires.
                    asyncio.create_task(_bob_chat(websocket, msg))
                elif action == "bob_confirm_response":
                    cid = msg.get("confirm_id", "")
                    fut = PENDING_CONFIRMS.get(cid)
                    if fut and not fut.done():
                        fut.set_result({
                            "ok":   bool(msg.get("approved")),
                            "args": msg.get("args") or {},
                            "reason": msg.get("reason") or "",
                        })
                elif action == "bob_autonomy_get":
                    await websocket.send(json.dumps({
                        "type": "bob_autonomy_state",
                        "autonomous": _bob_autonomy_get(),
                    }))
                elif action == "bob_autonomy_set":
                    _bob_autonomy_set(bool(msg.get("autonomous", True)))
                    await websocket.send(json.dumps({
                        "type": "bob_autonomy_state",
                        "autonomous": _bob_autonomy_get(),
                    }))
                elif action == "bob_models":
                    await _bob_models(websocket)
                elif action == "klab_ebpf_trace":
                    await _klab_ebpf_trace(websocket, msg)
                elif action == "klab_ebpf_stop":
                    await _klab_ebpf_stop(websocket)
                elif action == "vm_console_open":
                    await _vm_console_open(websocket, msg)
                elif action == "vm_console_close":
                    await _vm_console_close(websocket, msg)
                elif action == "vm_console_list":
                    await _vm_console_list(websocket)
                elif action == "vm_ssh_open":
                    await _vm_ssh_open(websocket, msg)
                elif action == "vm_display_open":
                    await _vm_display_open(websocket, msg)
                elif action == "vm_display_close":
                    await _vm_display_close(websocket, msg)

                else:
                    await websocket.send(json.dumps({
                        "type": "error",
                        "msg": f"unknown action: {action}",
                    }))
            except websockets.exceptions.ConnectionClosed:
                # Browser closed/refreshed mid-flight — not an error, just
                # let the outer except handle the disconnect cleanly.
                raise
            except Exception as _action_err:
                # Don't log a traceback if it's just the ws keepalive timing
                # out — that's noise, not a code bug. Real exceptions still
                # get the full traceback.
                _emsg = str(_action_err)
                if "ConnectionClosed" in _emsg or "keepalive ping timeout" in _emsg:
                    LOG.info("Action %s skipped: client disconnected", action)
                else:
                    LOG.exception("Error handling action %s", action)
                try:
                    await websocket.send(json.dumps({
                        "type": "error",
                        "msg": f"action '{action}' failed: {_action_err}",
                    }))
                except Exception:
                    pass

    except websockets.exceptions.ConnectionClosed:
        LOG.info("WebSocket client disconnected")

async def _wg_gen_keypair(websocket):
    """Generate a fresh WireGuard keypair and return it to the client."""
    try:
        privkey = subprocess.check_output(["wg", "genkey"], text=True).strip()
        pubkey  = subprocess.check_output(["wg", "pubkey"], input=privkey, text=True).strip()
        await websocket.send(json.dumps({
            "type": "wg_keypair",
            "privkey": privkey,
            "pubkey":  pubkey,
        }))
    except Exception as exc:
        await websocket.send(json.dumps({"type": "error", "msg": f"wg genkey failed: {exc}"}))


async def _wg_add_peer(websocket, msg):
    """Add a peer to one or all WireGuard interfaces live via wg set.

    Expected msg fields:
      iface       - "wg0"|"wg1"|"wg2"|"wg3"|"all"
      pubkey      - peer's public key
      allowed_ips - CIDR(s) comma-separated, e.g. "10.77.100.5/32"
      endpoint    - optional "host:port"
    """
    iface       = msg.get("iface", "wg1")
    pubkey      = msg.get("pubkey", "").strip()
    allowed_ips = msg.get("allowed_ips", "").strip()
    endpoint    = msg.get("endpoint", "").strip()

    if not pubkey or not allowed_ips:
        await websocket.send(json.dumps({"type": "error", "msg": "wg_add_peer: pubkey and allowed_ips required"}))
        return

    targets = ["wg0", "wg1", "wg2", "wg3"] if iface == "all" else [iface]
    results = []
    for intf in targets:
        cmd = ["wg", "set", intf, "peer", pubkey, "allowed-ips", allowed_ips]
        if endpoint:
            cmd += ["endpoint", endpoint]
        try:
            subprocess.check_call(cmd, stderr=subprocess.DEVNULL)
            # Persist to wg-quick config if it exists
            conf = f"/etc/wireguard/{intf}.conf"
            if os.path.exists(conf):
                peer_block = f"\n[Peer]\nPublicKey = {pubkey}\nAllowedIPs = {allowed_ips}\n"
                if endpoint:
                    peer_block += f"Endpoint = {endpoint}\n"
                with open(conf, "a") as f:
                    f.write(peer_block)
            results.append({"iface": intf, "ok": True})
        except Exception as exc:
            results.append({"iface": intf, "ok": False, "error": str(exc)})

    await websocket.send(json.dumps({"type": "wg_add_peer_result", "results": results}))
    # Push updated status
    await websocket.send(json.dumps({"type": "wg_data", "data": get_wg_status()}))


async def _wg_remove_peer(websocket, msg):
    """Remove a peer from one or all WireGuard interfaces live via wg set.

    Expected msg fields:
      iface  - "wg0"|"wg1"|"wg2"|"wg3"|"all"
      pubkey - peer's public key to remove
    """
    iface  = msg.get("iface", "wg1")
    pubkey = msg.get("pubkey", "").strip()

    if not pubkey:
        await websocket.send(json.dumps({"type": "error", "msg": "wg_remove_peer: pubkey required"}))
        return

    targets = ["wg0", "wg1", "wg2", "wg3"] if iface == "all" else [iface]
    results = []
    for intf in targets:
        try:
            subprocess.check_call(
                ["wg", "set", intf, "peer", pubkey, "remove"],
                stderr=subprocess.DEVNULL
            )
            # Remove from wg-quick config if it exists
            conf = f"/etc/wireguard/{intf}.conf"
            if os.path.exists(conf):
                with open(conf, "r") as f:
                    content = f.read()
                # Strip the [Peer] block that contains this pubkey
                import re as _re
                content = _re.sub(
                    r"\[Peer\][^\[]*PublicKey\s*=\s*" + _re.escape(pubkey) + r"[^\[]*",
                    "", content, flags=_re.DOTALL
                )
                with open(conf, "w") as f:
                    f.write(content)
            results.append({"iface": intf, "ok": True})
        except Exception as exc:
            results.append({"iface": intf, "ok": False, "error": str(exc)})

    await websocket.send(json.dumps({"type": "wg_remove_peer_result", "results": results}))
    await websocket.send(json.dumps({"type": "wg_data", "data": get_wg_status()}))


async def _stream_proc_detached(websocket, cmd, env=None, target="log"):
    """Long-running variant of _stream_proc — subprocess runs as a systemd
    transient service so it survives webui restart (the default KillMode=
    control-group would otherwise kill every child of webui on restart).
    Output is captured to a per-invocation log file; we tail it line-by-line
    and stream to the websocket. If webui restarts mid-tail, the subprocess
    keeps running and writing to disk; the operator recovers state via the
    normal status polls on next webui start.

    Use this for any subprocess that takes more than ~30s and whose loss
    mid-execution would leave the system in a half-state (kube-cluster
    scale, kube-cluster bootstrap, klab golden — anything orchestrating
    VM lifecycle + cluster joins). Short ops (kubectl drain, helm install)
    should keep using _stream_proc — they're fast enough that a webui
    restart can't catch them mid-flight.

    Caught .131 2026-05-17: 4 consecutive `+ Add worker` clicks each died
    at the first VM clone because webui got restarted (manually + maybe
    self-restart on some condition). With KillMode=control-group the
    subprocess was in webui's cgroup and got SIGKILLed. systemd-run --unit
    puts it in a sibling cgroup that's independent of webui's lifecycle."""
    ts = int(time.time())
    suffix = f"{target}-{ts}"
    log_path = f"/var/log/kldload/{suffix}.log"
    done_path = f"/var/log/kldload/.{suffix}.done"
    unit = f"kldload-{suffix}.service"

    # Inner script: write start banner, run user cmd, capture rc, write
    # sentinel + rc-file. `set +e` so a nonzero rc doesn't skip the
    # bookkeeping. shlex.quote on every argument prevents shell-injection
    # via filenames that contain spaces / quotes.
    cmd_str = " ".join(shlex.quote(str(c)) for c in cmd)
    inner = (
        f"set +e; "
        f"echo '== {ts} {cmd_str} ==' > {shlex.quote(log_path)}; "
        f"{cmd_str} >> {shlex.quote(log_path)} 2>&1; "
        f"rc=$?; "
        f"echo \"== DONE rc=$rc ==\" >> {shlex.quote(log_path)}; "
        f"echo \"$rc\" > {shlex.quote(done_path)}"
    )

    setenv_args = []
    if env:
        for k, v in env.items():
            setenv_args.extend(["--setenv", f"{k}={v}"])

    await websocket.send(json.dumps({
        "type": "exec_start", "cmd": str(cmd), "target": target,
        "detached": True, "unit": unit, "log_path": log_path,
    }))

    # Launch via systemd-run as a transient service. --collect cleans up
    # the unit on exit; --quiet suppresses the "Running as unit" banner.
    launch = await asyncio.create_subprocess_exec(
        "systemd-run", "--unit", unit, "--collect", "--quiet",
        *setenv_args,
        "bash", "-c", inner,
        stdout=asyncio.subprocess.DEVNULL,
        stderr=asyncio.subprocess.PIPE,
    )
    _, launch_err = await launch.communicate()
    if launch.returncode != 0:
        # systemd-run unavailable / failed — fall back to in-process stream
        # so the user still gets the operation (just without restart-survival).
        err_msg = (launch_err or b"").decode(errors="replace")[:300]
        await websocket.send(json.dumps({
            "type": "log_line",
            "line": f"[systemd-run failed rc={launch.returncode}: {err_msg} — falling back to in-process exec]",
            "target": target,
        }))
        return await _stream_proc(websocket, cmd, env=env, target=target)

    # Tail the log file until the sentinel appears. The subprocess writes
    # to log_path independently of our reading; we just chase its tail.
    last_pos = 0
    while True:
        finished = os.path.exists(done_path)
        try:
            with open(log_path, "r") as f:
                f.seek(last_pos)
                chunk = f.read()
                last_pos = f.tell()
        except FileNotFoundError:
            chunk = ""
        if chunk:
            for line in chunk.splitlines():
                try:
                    await websocket.send(json.dumps({
                        "type": "log_line", "line": line, "target": target,
                    }))
                except Exception:
                    # websocket died — bail. The subprocess keeps running;
                    # its output continues going to log_path for the next
                    # webui connection to read on demand.
                    return None
        if finished:
            break
        await asyncio.sleep(0.4)

    # Read return code from sentinel file
    try:
        with open(done_path) as f:
            rc = int(f.read().strip())
    except Exception:
        rc = -1

    # Cleanup transient artifacts
    for p in (log_path, done_path):
        try:
            os.unlink(p)
        except Exception:
            pass

    await websocket.send(json.dumps({
        "type": "exec_done", "target": target, "rc": rc,
    }))
    return rc


async def _stream_proc(websocket, cmd, env=None, target="log"):
    """Run a command, stream stdout/stderr lines to websocket AND tee to
    /var/log/kldload/stream.log so the F5 firehose in the terminal
    drawer catches every UI-triggered subprocess (kube-cluster,
    klab, ansible, helm, demos). Also writes a per-target log
    (/var/log/kldload/<target>.log) so history per subsystem is
    grep-able. Trackable + cancellable."""
    _ansi_re = re.compile(r'\x1b\[[0-9;]*[mGKHF]')
    await websocket.send(json.dumps({"type": "exec_start", "cmd": str(cmd), "target": target}))

    # File logging — best-effort, never kills the run if /var/log is
    # read-only or somehow unwritable. Two streams so the firehose
    # interleaves everything AND per-target history stays clean.
    _stream_log = None
    _target_log = None
    try:
        os.makedirs("/var/log/kldload", exist_ok=True)
        _stream_log = open("/var/log/kldload/stream.log", "a", buffering=1)
        _target_log = open(f"/var/log/kldload/{target}.log", "a", buffering=1)
        _prefix = f"[{target}]"
        _stream_log.write(f"# --- exec: {' '.join(map(str, cmd))} ---\n")
        _target_log.write(f"# --- exec: {' '.join(map(str, cmd))} ---\n")
    except Exception:
        pass

    # start_new_session=True detaches the child into its own session +
    # process group so a webui restart (systemd SIGTERM cascade) does
    # NOT kill long-running orchestrators like `klab test --full` that
    # we launched on a websocket. The stream is lost on disconnect,
    # but state is still on disk and the UI re-reads it on reconnect.
    proc = await asyncio.create_subprocess_exec(
        *cmd,
        stdin=asyncio.subprocess.DEVNULL,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.STDOUT,
        env={**os.environ, **(env or {})},
        start_new_session=True,
    )
    RUNNING_PROCS[target] = proc
    try:
        async for line in proc.stdout:
            clean = _ansi_re.sub('', line.decode(errors="replace").rstrip())
            if _stream_log:
                try: _stream_log.write(f"{_prefix} {clean}\n")
                except Exception: pass
            if _target_log:
                try: _target_log.write(f"{clean}\n")
                except Exception: pass
            await websocket.send(json.dumps({
                "type": "log_line",
                "line": clean,
                "target": target,
            }))
        rc = await proc.wait()
    except Exception:
        rc = -1
    finally:
        RUNNING_PROCS.pop(target, None)
        for _f in (_stream_log, _target_log):
            try: _f and _f.close()
            except Exception: pass
    await websocket.send(json.dumps({"type": "exec_done", "rc": rc, "target": target}))
    return rc


async def _klab_cancel(websocket, msg):
    """Cancel a running klab operation — kill process, destroy VMs, clean ZFS."""
    target = msg.get("target", "klab")
    proc = RUNNING_PROCS.get(target)

    await websocket.send(json.dumps({
        "type": "log_line", "target": target,
        "line": "\n[cancel] Stopping operation...",
    }))

    # 1. Kill the tracked process
    if proc and proc.returncode is None:
        try:
            proc.kill()
            await proc.wait()
        except Exception:
            pass

    # 2a. If the current-run.env has a systemd unit, stop that — it's
    # cleaner than pkill -f (which can match other SSH sessions that
    # happen to mention "klab test" in their argv).
    run_state = "/var/run/klab/current-run.env"
    _current_unit = ""
    if os.path.exists(run_state):
        try:
            for line in open(run_state):
                if line.startswith("unit="):
                    _current_unit = line.split("=", 1)[1].strip()
                    break
        except Exception:
            pass
    if _current_unit:
        subprocess.call(["systemctl", "stop", _current_unit], stderr=subprocess.DEVNULL)
        await websocket.send(json.dumps({
            "type": "log_line", "target": target,
            "line": f"[cancel] stopped {_current_unit}",
        }))

    # 2b. Fall back to pattern kills for older state / goldens / demos
    # / CLI-started runs that aren't tracked via RUNNING_PROCS or
    # systemd-run units.
    #
    # IMPORTANT — `klab test` is the longest-running, most-cancellable
    # workload (ztest runs go 8+ hours). Not including it meant the UI
    # cancel button fired, killed nothing, and the run kept going —
    # exactly what Todd reported. Match both `klab test` and the
    # shorter `klab test-suite` variant.
    # `klab golden-ztest` contains "klab golden" so the existing
    # pattern covers both golden modes.
    for pattern in ["klab test", "klab golden", "klab golden-ztest",
                     "klab deploy", "klab destroy", "klab kubernetes",
                     "zfs-tests.sh", "virt-install", "qemu-img convert"]:
        subprocess.call(["pkill", "-TERM", "-f", pattern], stderr=subprocess.DEVNULL)
    await asyncio.sleep(1.5)
    for pattern in ["klab test", "klab golden", "klab golden-ztest",
                     "klab deploy", "klab destroy", "klab kubernetes",
                     "zfs-tests.sh"]:
        subprocess.call(["pkill", "-KILL", "-f", pattern], stderr=subprocess.DEVNULL)
    # Clear detached-run state file so the next `klab_test` doesn't
    # see a stale pid and refuse to launch.
    try:
        os.remove(run_state)
    except (FileNotFoundError, PermissionError):
        pass

    # 3. Destroy any in-progress golden/ztest/test VMs. Previously this only
    # matched klab-golden-* so ztest runs left behind a shut-off VM and a
    # stranded zvol, which made the UI cancel button look like it did nothing.
    _vm_prefixes = ("klab-golden-", "klab-ztest-", "klab-test-", "kspawn-")
    try:
        out = subprocess.check_output(["virsh", "list", "--all", "--name"],
                                       text=True, stderr=subprocess.DEVNULL)
        for line in out.strip().splitlines():
            name = line.strip()
            if name and name.startswith(_vm_prefixes):
                subprocess.call(["virsh", "destroy", name], stderr=subprocess.DEVNULL)
                subprocess.call(["virsh", "undefine", name, "--nvram"],
                                stderr=subprocess.DEVNULL)
                await websocket.send(json.dumps({
                    "type": "log_line", "target": target,
                    "line": f"[cancel] Destroyed VM: {name}",
                }))
    except Exception:
        pass

    # 4. Clean up incomplete ZFS datasets (golden/ztest builds that didn't
    # finish, and any kspawn clones). A completed regular golden keeps its
    # @golden snapshot; ztest keeps @ztest-golden — leave those intact.
    _zvol_prefixes = ("/vms/klab-golden-", "/vms/klab-ztest-",
                      "/vms/klab-test-", "/vms/kspawn-")
    _keep_snaps = {"@golden", "@ztest-golden"}
    try:
        out = subprocess.check_output(["zfs", "list", "-H", "-o", "name"],
                                       text=True, stderr=subprocess.DEVNULL)
        for line in out.strip().splitlines():
            ds = line.strip()
            if not any(p in ds for p in _zvol_prefixes):
                continue
            # Preserve datasets that have a completion snapshot — those are
            # finished artifacts, not leftovers from a cancelled run.
            has_completion_snap = False
            for snap in _keep_snaps:
                if subprocess.call(
                    ["zfs", "list", "-t", "snapshot", f"{ds}{snap}"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL) == 0:
                    has_completion_snap = True
                    break
            if has_completion_snap:
                continue
            subprocess.call(["zfs", "destroy", "-Rf", ds],
                            stderr=subprocess.DEVNULL)
            await websocket.send(json.dumps({
                "type": "log_line", "target": target,
                "line": f"[cancel] Cleaned up incomplete: {ds}",
            }))
    except Exception:
        pass

    # 5. Clean up cloud-init ISOs
    try:
        import glob as _glob
        for iso in _glob.glob("/var/lib/kldload/cloud-init/klab-golden-*-cloud-init.iso"):
            os.remove(iso)
    except Exception:
        pass

    RUNNING_PROCS.pop(target, None)
    await websocket.send(json.dumps({
        "type": "log_line", "target": target,
        "line": "[cancel] Cleanup complete.",
    }))
    await websocket.send(json.dumps({"type": "exec_done", "rc": -1, "target": target}))
    LOG.info("Cancelled and cleaned up: %s", target)

async def _run_wipe_disk(websocket, msg):
    disk = msg.get("disk", "")
    mode = msg.get("mode", "quick")
    if not re.match(r'^/dev/[a-z]{2,8}[0-9]{0,3}$', disk):
        await websocket.send(json.dumps({"type": "error", "msg": f"Invalid disk: {disk}"}))
        return

    # Common cleanup: UEFI boot entries only. MOK keys are NOT touched —
    # wiping MOK breaks Secure Boot on the next install since the new MOK
    # key can't be enrolled until the OS boots, creating a chicken-and-egg
    # problem. Stale MOK keys in NVRAM are harmless.
    cleanup_uefi_mok = """
echo "Cleaning UEFI boot entries..."
if command -v efibootmgr >/dev/null 2>&1; then
    for entry in $(efibootmgr 2>/dev/null | grep -iE "kldload|ZFSBootMenu|UEFI OS|RedHat|centos|rocky|fedora|debian|ubuntu|${DISK##*/}" | grep -oP 'Boot\\K[0-9A-Fa-f]+' || true); do
        efibootmgr -b "$entry" -B 2>/dev/null && echo "  Removed Boot$entry" || true
    done
fi
# Clear any pending MOK import/delete requests (but don't wipe enrolled keys)
if command -v mokutil >/dev/null 2>&1; then
    mokutil --revoke-import 2>/dev/null && echo "  Pending MOK imports cleared" || true
    mokutil --revoke-delete 2>/dev/null && echo "  Pending MOK deletes cleared" || true
    ENROLLED=$(mokutil --list-enrolled 2>/dev/null | grep -c 'SHA1' || echo 0)
    echo "  MOK keys enrolled: $ENROLLED (preserved for Secure Boot)"
fi
"""

    if mode == "full":
        # Full dd zero-fill with progress
        cmd = ["bash", "-c", f"""
DISK={shlex.quote(disk)}
SIZE_BYTES=$(blockdev --getsize64 "$DISK" 2>/dev/null || echo 0)
SIZE_MB=$((SIZE_BYTES / 1048576))
SIZE_GB=$((SIZE_BYTES / 1073741824))
echo "══════════════════════════════════════════════════"
echo "  FULL ZERO-FILL: $DISK (${{SIZE_GB}} GB)"
echo "══════════════════════════════════════════════════"
echo ""

echo "Step 1/4: Unmounting and exporting ZFS pools..."
umount -R /target/boot/efi 2>/dev/null || true
umount -R /target 2>/dev/null || true
for pool in $(zpool list -H -o name 2>/dev/null); do
    zpool status "$pool" 2>/dev/null | grep -q "${{DISK##*/}}" && \
        {{ zpool export -f "$pool" 2>/dev/null || zpool destroy -f "$pool" 2>/dev/null || true; echo "  Exported: $pool"; }}
done

echo "Step 2/4: Zero-filling entire disk..."
WRITTEN=0
while true; do
    dd if=/dev/zero of="$DISK" bs=1M count=1024 seek=$WRITTEN conv=notrunc 2>/dev/null || break
    WRITTEN=$((WRITTEN + 1024))
    if [ "$SIZE_MB" -gt 0 ]; then
        PCT=$((WRITTEN * 100 / SIZE_MB))
        [ "$PCT" -gt 100 ] && PCT=100
        echo "  ${{WRITTEN}} / ${{SIZE_MB}} MB  (${{PCT}}%)"
    fi
    [ "$SIZE_MB" -gt 0 ] && [ "$WRITTEN" -ge "$SIZE_MB" ] && break
done
echo "  Done"

echo "Step 3/4: Cleaning UEFI + MOK..."
{cleanup_uefi_mok}
echo "  Done"

echo "Step 4/4: Refreshing partition table..."
partprobe "$DISK" 2>/dev/null || true
sync
echo ""
echo "══════════════════════════════════════════════════"
echo "  FULL WIPE COMPLETE — $DISK zeroed (${{SIZE_GB}} GB)"
echo "══════════════════════════════════════════════════"
"""]
    else:
        # Quick wipe: labels + GPT + first/last 10MB + UEFI + MOK
        cmd = ["bash", "-c", f"""
DISK={shlex.quote(disk)}
SIZE_BYTES=$(blockdev --getsize64 "$DISK" 2>/dev/null || echo 0)
SIZE_GB=$((SIZE_BYTES / 1073741824))
echo "══════════════════════════════════════════════════"
echo "  QUICK WIPE: $DISK (${{SIZE_GB}} GB)"
echo "══════════════════════════════════════════════════"
echo ""

echo "Step 1/6: Unmounting and exporting ZFS pools..."
umount -R /target/boot/efi 2>/dev/null || true
umount -R /target 2>/dev/null || true
for pool in $(zpool list -H -o name 2>/dev/null); do
    zpool status "$pool" 2>/dev/null | grep -q "${{DISK##*/}}" && \
        {{ zpool export -f "$pool" 2>/dev/null || zpool destroy -f "$pool" 2>/dev/null || true; echo "  Exported: $pool"; }}
done
echo "  Done"

echo "Step 2/6: Clearing ZFS labels on all partitions..."
for part in "${{DISK}}"*; do
    [ -b "$part" ] || continue
    zpool labelclear -f "$part" 2>/dev/null || true
    wipefs -a -f "$part" 2>/dev/null || true
done
echo "  Done"

echo "Step 3/6: Wiping partition table (GPT + MBR)..."
sgdisk --zap-all "$DISK" 2>/dev/null || true
echo "  Done"

echo "Step 4/6: Zeroing first and last 10MB..."
dd if=/dev/zero of="$DISK" bs=1M count=10 2>/dev/null || true
dd if=/dev/zero of="$DISK" bs=1M seek=$((SIZE_GB * 1024 - 10)) count=10 2>/dev/null || true
echo "  Done"

echo "Step 5/6: Cleaning UEFI + MOK..."
{cleanup_uefi_mok}
echo "  Done"

echo "Step 6/6: Refreshing partition table..."
partprobe "$DISK" 2>/dev/null || true
sync
echo ""
echo "══════════════════════════════════════════════════"
echo "  QUICK WIPE COMPLETE — $DISK clean (${{SIZE_GB}} GB)"
echo "══════════════════════════════════════════════════"
"""]
    await _stream_proc(websocket, cmd, target="install")

INSTALL_STATE_PATH = Path("/run/kldload/install_state.json")

def _detect_distro():
    """Detect the running distro from os-release."""
    try:
        with open("/etc/os-release") as f:
            for line in f:
                if line.startswith("ID="):
                    val = line.strip().split("=", 1)[1].strip('"')
                    if val in ("centos", "rocky", "rhel", "almalinux"):
                        return "centos" if val == "almalinux" else val
                    if val in ("debian", "ubuntu"):
                        return val
    except Exception:
        pass
    return "centos"  # default for kldload

async def _test_rhel_cdn(websocket, msg):
    """Test RHEL CDN connectivity and subscription validity."""
    params = msg.get("params", {})
    key = params.get("rhel_key", "")
    org = params.get("rhel_org", "")
    try:
        # Test 1: Try with proper cert verification
        proc = await asyncio.create_subprocess_exec(
            "curl", "-s", "--connect-timeout", "10", "-o", "/dev/null", "-w", "%{http_code}",
            "https://subscription.rhsm.redhat.com/",
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await asyncio.wait_for(proc.communicate(), timeout=15)
        http_code = stdout.decode().strip()
        if http_code != "000":
            await websocket.send(json.dumps({
                "type": "rhel_cdn_result", "ok": True, "error": None
            }))
            return
        # Test 2: Try with -k (skip cert verify) — CDN may use Red Hat's own CA
        proc2 = await asyncio.create_subprocess_exec(
            "curl", "-sk", "--connect-timeout", "10", "-o", "/dev/null", "-w", "%{http_code}",
            "https://subscription.rhsm.redhat.com/",
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE
        )
        stdout2, _ = await asyncio.wait_for(proc2.communicate(), timeout=15)
        http_code2 = stdout2.decode().strip()
        if http_code2 != "000":
            await websocket.send(json.dumps({
                "type": "rhel_cdn_result", "ok": True,
                "error": None
            }))
            return
        await websocket.send(json.dumps({
            "type": "rhel_cdn_result", "ok": False,
            "error": "Cannot reach subscription.rhsm.redhat.com — check network/firewall"
        }))
    except asyncio.TimeoutError:
        await websocket.send(json.dumps({
            "type": "rhel_cdn_result", "ok": False,
            "error": "Connection timed out — CDN unreachable"
        }))
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "rhel_cdn_result", "ok": False,
            "error": str(e)
        }))


async def _wifi_connect(websocket, msg):
    """Join the LIVE installer to a WiFi network via NetworkManager so
    subsequent install steps (dnf --installroot, debootstrap, zfs-release
    retry) have internet. Separate from writing the nmconnection profile
    for the target — that only helps first-boot, not the installer itself.

    Expected msg: {"action": "wifi_connect", "ssid": "...", "psk": "..."}.
    Streams progress + emits final {"type":"wifi_connect_result","ok":..}."""
    ssid = (msg.get("ssid") or "").strip()
    psk  = msg.get("psk") or ""
    if not ssid:
        await websocket.send(json.dumps({
            "type": "wifi_connect_result", "ok": False,
            "error": "SSID is required",
        }))
        return
    # Preflight: make sure NetworkManager + a wifi device exist in the live env.
    try:
        _p = await asyncio.create_subprocess_exec(
            "nmcli", "-t", "-f", "TYPE,STATE", "device",
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE,
        )
        _out, _err = await asyncio.wait_for(_p.communicate(), timeout=10)
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "wifi_connect_result", "ok": False,
            "error": f"nmcli unavailable: {e}",
        }))
        return
    devices = (_out or b"").decode(errors="replace")
    if "wifi:" not in devices:
        await websocket.send(json.dumps({
            "type": "wifi_connect_result", "ok": False,
            "error": "no wifi device found on the live installer",
        }))
        return
    await websocket.send(json.dumps({
        "type": "log_line", "target": "install",
        "line": f"[wifi] connecting live installer to '{ssid}'...",
    }))
    # Force a rescan so new SSIDs are seen immediately.
    try:
        _rs = await asyncio.create_subprocess_exec(
            "nmcli", "device", "wifi", "rescan",
            stdout=asyncio.subprocess.DEVNULL, stderr=asyncio.subprocess.DEVNULL,
        )
        await asyncio.wait_for(_rs.wait(), timeout=8)
    except Exception:
        pass
    # Connect with a reasonable timeout. nmcli connect blocks until the
    # connection is up OR fails, so we bound it ourselves.
    cmd = ["nmcli", "device", "wifi", "connect", ssid]
    if psk:
        cmd += ["password", psk]
    try:
        _p = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE,
        )
        _out, _err = await asyncio.wait_for(_p.communicate(), timeout=45)
        rc = _p.returncode
        out_msg = (_out or b"").decode(errors="replace").strip()
        err_msg = (_err or b"").decode(errors="replace").strip()
    except asyncio.TimeoutError:
        try: _p.kill()
        except Exception: pass
        await websocket.send(json.dumps({
            "type": "wifi_connect_result", "ok": False,
            "error": "timed out after 45s — wrong password or no signal?",
        }))
        return
    if rc != 0:
        await websocket.send(json.dumps({
            "type": "wifi_connect_result", "ok": False,
            "error": (err_msg or out_msg or f"nmcli exited {rc}"),
        }))
        return
    # Verify we got an IPv4. Some APs accept the PSK but DHCP stalls;
    # don't call it "connected" if there's no IP yet.
    for _ in range(15):
        try:
            _q = await asyncio.create_subprocess_exec(
                "ip", "-4", "-o", "addr", "show",
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL,
            )
            _qout, _ = await _q.communicate()
            addrs = (_qout or b"").decode(errors="replace")
            non_loop = [l for l in addrs.splitlines() if l and " 127." not in l and "inet " in l]
            if non_loop:
                break
        except Exception:
            pass
        await asyncio.sleep(1)
    await websocket.send(json.dumps({
        "type": "wifi_connect_result", "ok": True,
        "msg": out_msg or f"connected to {ssid}",
    }))


async def _run_install(websocket, msg):
    params = msg.get("params", {})
    # Map frontend 'role' → KLDLOAD_PROFILE (installer key)
    if "role" in params and "profile" not in params:
        params["profile"] = params.pop("role")
    # Auto-detect distro if not specified
    if "distro" not in params:
        params["distro"] = _detect_distro()
    # RHEL credentials fallback — if the operator saved creds in the
    # Dashboard's RHEL Credentials panel but left the Install-to-Disk
    # RHEL fields blank, pull from the secrets store. Only fires for
    # the rhel distro; other distros never look at these fields. Form
    # values always win when present.
    #
    # CRITICAL: parameter names MUST match the install form's payload
    # exactly because the answers-file builder upper-cases them and
    # prefixes KLDLOAD_. The install form sends rhel_username /
    # rhel_password / rhel_key / rhel_org → KLDLOAD_RHEL_USERNAME etc.
    # An earlier rev used rhel_user / rhel_pass which produced
    # KLDLOAD_RHEL_USER / KLDLOAD_RHEL_PASS — installer rejected with
    # "ERROR: RHEL install requires KLDLOAD_RHEL_USERNAME...".
    if params.get("distro") == "rhel":
        if not (params.get("rhel_key") or "").strip():
            _saved_key = secret_get("rhel-activation-key") or ""
            if _saved_key:
                params["rhel_key"] = _saved_key
                await websocket.send(json.dumps({
                    "type": "log_line", "target": "install",
                    "line": "[rhel] using activation-key from saved Dashboard credentials",
                }))
        if not (params.get("rhel_org") or "").strip():
            _saved_org = secret_get("rhel-organization") or ""
            if _saved_org:
                params["rhel_org"] = _saved_org
        if not (params.get("rhel_username") or "").strip():
            _saved_user = secret_get("rhel-username") or ""
            if _saved_user:
                params["rhel_username"] = _saved_user
        if not (params.get("rhel_password") or "").strip():
            _saved_pass = secret_get("rhel-password") or ""
            if _saved_pass:
                params["rhel_password"] = _saved_pass
                await websocket.send(json.dumps({
                    "type": "log_line", "target": "install",
                    "line": "[rhel] using username/password from saved Dashboard credentials",
                }))
        # Hard preflight here so the operator gets a clear error in the
        # webui log instead of waiting for the installer to bail with a
        # generic message buried 200 lines deep.
        _have_userpass = (params.get("rhel_username") or "").strip() and (params.get("rhel_password") or "").strip()
        _have_keyorg   = (params.get("rhel_key")      or "").strip() and (params.get("rhel_org")      or "").strip()
        if not (_have_userpass or _have_keyorg):
            _missing = []
            if not (params.get("rhel_username") or "").strip(): _missing.append("Username")
            if not (params.get("rhel_password") or "").strip(): _missing.append("Password")
            if not (params.get("rhel_key")      or "").strip(): _missing.append("Activation key")
            if not (params.get("rhel_org")      or "").strip(): _missing.append("Org ID")
            await websocket.send(json.dumps({
                "type": "log_line", "target": "install",
                "line": f"[rhel] missing credentials — need Username+Password OR Activation-key+Org. Missing: {', '.join(_missing)}",
            }))
            await websocket.send(json.dumps({
                "type": "exec_done", "target": "install", "rc": 2,
            }))
            INSTALL_STATE_PATH.write_text(json.dumps({"running": False, "rc": 2}))
            return
    answers = []
    for k, v in params.items():
        key = k.upper()
        if not key.startswith("KLDLOAD_"):
            key = f"KLDLOAD_{key}"
        answers.append(f"{key}={shlex.quote(str(v))}")

    answers_path = "/tmp/kldload-webui-answers.env"
    with open(answers_path, "w") as f:
        f.write("\n".join(answers) + "\n")
    os.chmod(answers_path, 0o600)

    # Persist install state so reconnecting clients can restore UI
    INSTALL_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    INSTALL_STATE_PATH.write_text(json.dumps({"running": True, "rc": None}))

    target = msg.get("_target", "install")

    # Spawn install-target in its own systemd transient unit so a webui
    # restart (e.g. kldload-tls-cert regen bouncing us via
    # kldload-bounce-tls-services) CAN'T kill the install subprocess.
    # Same cgroup-isolation pattern _klab_test uses. ExecStart stream
    # goes to /var/log/kldload/install-direct.log — we tail that back
    # to the WS so the user still sees live output while the actual
    # work runs independently.
    log_path = "/var/log/kldload/install-direct.log"
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    try:
        with open(log_path, "ab") as _lfh:
            _lfh.write(f"\n\n# === install run {datetime.datetime.now().isoformat()} ===\n".encode())
    except Exception:
        pass

    unit_name = f"kldinstall-{int(datetime.datetime.now().timestamp())}.service"
    systemd_cmd = [
        "systemd-run",
        f"--unit={unit_name}",
        "--collect",
        "--no-block",
        "--property=Type=simple",
        f"--property=StandardOutput=append:{log_path}",
        "--property=StandardError=inherit",
        "--",
        "/usr/local/bin/kldload-install-target",
        "--config", answers_path,
    ]
    _p = await asyncio.create_subprocess_exec(
        *systemd_cmd,
        stdout=asyncio.subprocess.DEVNULL,
        stderr=asyncio.subprocess.PIPE,
    )
    _, _stderr = await _p.communicate()
    if _p.returncode != 0:
        await websocket.send(json.dumps({
            "type": "log_line", "target": target,
            "line": f"[install] systemd-run failed rc={_p.returncode}: {(_stderr or b'').decode(errors='replace')[:500]}",
        }))
        INSTALL_STATE_PATH.write_text(json.dumps({"running": False, "rc": -1}))
        return

    # Resolve MainPID for the log-tailer
    main_pid = 0
    for _ in range(20):
        _q = await asyncio.create_subprocess_exec(
            "systemctl", "show", unit_name, "--property=MainPID", "--value",
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL,
        )
        _out, _ = await _q.communicate()
        out = (_out or b"").decode().strip()
        if out and out.isdigit() and int(out) > 0:
            main_pid = int(out)
            break
        await asyncio.sleep(0.25)

    await websocket.send(json.dumps({
        "type": "exec_start", "cmd": str(systemd_cmd), "target": target,
    }))
    # Stream the install log to the WS in real time. Reuses the klab
    # test tailer — same behavior (reads last ~400 lines on attach,
    # then live-tails; exits when PID dies or WS drops).
    await _klab_test_tail(websocket, main_pid, log_path, target=target)
    # When the tailer returns, the install has exited (or WS died).
    # Read the unit's exit status for the client.
    try:
        _qr = await asyncio.create_subprocess_exec(
            "systemctl", "show", unit_name, "--property=ExecMainStatus", "--value",
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL,
        )
        _out, _ = await _qr.communicate()
        rc = int((_out or b"0").decode().strip() or "0")
    except Exception:
        rc = -1
    INSTALL_STATE_PATH.write_text(json.dumps({"running": False, "rc": rc}))
    await websocket.send(json.dumps({"type": "exec_done", "rc": rc, "target": target}))

async def _run_spawn(websocket, msg):
    params = msg.get("params", {})
    cmd = ["/usr/local/sbin/kldload-spawn"]
    for k, v in params.items():
        cmd += [f"--{k.replace('_','-')}", str(v)]
    target = msg.get("_target", "spawn")
    # Spawn boots a fresh VM from a golden template — 2-5 min minimum, often
    # longer for stamp + first-boot + cloud-init. Detached so a webui restart
    # mid-spawn doesn't leave a half-stamped clone with no driver.
    await _stream_proc_detached(websocket, cmd, target=target)

async def _run_golden(websocket, msg):
    template = msg.get("template", "kvm")
    if not re.match(r'^(master|kvm|storage|vdi)$', template):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid template"}))
        return
    target = msg.get("_target", "golden")
    cmd = ["/usr/local/sbin/kldload-golden", "--template", template]
    # Golden template build runs an install end-to-end — 20-40 min easy.
    await _stream_proc_detached(websocket, cmd, target=target)

async def _run_stamp(websocket, msg):
    template   = msg.get("template", "kvm")
    count      = int(msg.get("count", 1))
    base_index = int(msg.get("base_index", 1))
    color      = msg.get("color", "blue")
    if not re.match(r'^(master|kvm|storage|vdi|firewall|proxmox|monitoring|storage|worker|etcd|lb|landing)$', template):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid template"}))
        return
    if color not in ("blue", "green"):
        color = "blue"
    target     = msg.get("_target", "golden")
    golden_dir = Path("/var/lib/kldload/golden")
    image_path = golden_dir / f"golden-{template}.qcow2"
    if not image_path.exists():
        await websocket.send(json.dumps({"type": "error", "msg": f"Golden image not found: {image_path}"}))
        return
    for i in range(count):
        idx      = base_index + i
        hostname = f"{template}-{idx:02d}"
        clone    = golden_dir / f"{hostname}.qcow2"
        # Create CoW clone — quick (CoW is metadata-only) so stays in-process.
        rc = await _stream_proc(websocket,
            ["qemu-img", "create", "-f", "qcow2", "-b", str(image_path), "-F", "qcow2", str(clone)],
            target=target)
        if rc != 0:
            break
        # Stamp identity — boots the clone, edits hostname/network, snaps.
        # 1-3 min per clone; detached so a multi-clone loop survives.
        rc = await _stream_proc_detached(websocket,
            ["/usr/local/sbin/kldload-stamp-identity",
             "--image",    str(clone),
             "--hostname", hostname,
             "--template", template,
             "--index",    str(idx),
             "--color",    color],
            target=target)
        if rc != 0:
            break

async def _run_k8s_join(websocket, msg):
    role   = msg.get("role", "worker")
    target = msg.get("_target", "log")
    if role not in ("worker", "etcd"):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid role"}))
        return
    cmd = ["/usr/local/sbin/kldload-k8s-join", "--role", role]
    # kubeadm join is 3-10 min depending on image-pull bandwidth.
    await _stream_proc_detached(websocket, cmd, target=target)

async def _run_salt_highstate(websocket, msg):
    salt_target = msg.get("target", "*")
    ws_target   = msg.get("_target", "log")
    if not re.match(r'^[a-zA-Z0-9_\-\*]+$', salt_target):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid salt target"}))
        return
    cmd = ["salt", salt_target, "state.highstate"]
    # Salt highstate against a minion fleet — 5-15 min typical.
    await _stream_proc_detached(websocket, cmd, target=ws_target)

async def _salt_accept_all(websocket):
    try:
        subprocess.check_call(
            ["salt-key", "-A", "-y"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
        await websocket.send(json.dumps({"type": "log_line", "line": "All pending keys accepted.", "target": "log"}))
    except Exception as e:
        await websocket.send(json.dumps({"type": "error", "msg": str(e)}))

async def _tail_log(websocket, log_path):
    if not os.path.exists(log_path):
        await websocket.send(json.dumps({
            "type": "log_content",
            "lines": [f"Log not found: {log_path}"],
        }))
        return
    try:
        out = subprocess.check_output(["tail", "-n", "200", log_path], text=True)
        lines = out.splitlines()
    except Exception as e:
        lines = [f"Error reading log: {e}"]
    await websocket.send(json.dumps({"type": "log_content", "lines": lines}))

async def _vm_networks(websocket):
    """List libvirt networks for the KVM tab's Networks sub-view. Returns
    name + state + autostart + bridge name + forward mode + IP range so
    the user can spot 'is virbr0 up?' without leaving the UI."""
    nets = []
    try:
        out = subprocess.check_output(
            ["virsh", "net-list", "--all"], text=True, stderr=subprocess.DEVNULL, timeout=5)
        for line in out.strip().splitlines()[2:]:  # skip header lines
            parts = line.split()
            if len(parts) >= 3:
                name, state, autostart = parts[0], parts[1], parts[2]
                bridge, mode, ip_range = "—", "—", "—"
                try:
                    info = subprocess.check_output(
                        ["virsh", "net-dumpxml", name], text=True,
                        stderr=subprocess.DEVNULL, timeout=3)
                    import re as _re
                    m = _re.search(r"<bridge name='([^']+)'", info); bridge = m.group(1) if m else "—"
                    m = _re.search(r"<forward mode='([^']+)'", info); mode = m.group(1) if m else "—"
                    m = _re.search(r"address='([^']+)'\s+netmask='([^']+)'", info)
                    if m: ip_range = f"{m.group(1)} ({m.group(2)})"
                except Exception:
                    pass
                nets.append({"name": name, "state": state, "autostart": autostart,
                             "bridge": bridge, "mode": mode, "ip_range": ip_range})
    except Exception:
        pass
    await websocket.send(json.dumps({"type": "vm_networks", "networks": nets}))


async def _vm_pools(websocket):
    """List libvirt storage pools — name, state, autostart, type, capacity,
    allocated, available, target path."""
    pools = []
    try:
        out = subprocess.check_output(
            ["virsh", "pool-list", "--all", "--details"], text=True,
            stderr=subprocess.DEVNULL, timeout=5)
        # Header is 2 lines: column names + dashes; data follows.
        for line in out.strip().splitlines()[2:]:
            parts = line.split()
            if len(parts) >= 7:
                pools.append({"name": parts[0], "state": parts[1], "autostart": parts[2],
                              "persistent": parts[3], "capacity": parts[4],
                              "allocation": parts[5], "available": parts[6]})
    except Exception:
        pass
    await websocket.send(json.dumps({"type": "vm_pools", "pools": pools}))


async def _vm_snapshots(websocket):
    """Cross-VM snapshot listing — sourced from ZFS, NOT libvirt.

    Previous version called `virsh snapshot-list` which returns libvirt's
    saved-state snapshots — a completely different concept than the ZFS
    snapshots our Snap button creates (zfs snapshot rpool/vms/<vm>@...).
    Result: the Snapshots tab was always empty, even when the operator
    had clicked Snap dozens of times. Caught .133 2026-05-16.

    Source of truth is `zfs list -t snapshot -r rpool/vms`. We derive vm
    name from the dataset path's second segment; only snaps under
    rpool/vms/<vmname>/* (a real per-VM dataset) get surfaced. The parent
    rpool/vms@... recursive snaps are filtered out — they're created by
    the global Snapshot button and don't belong on a per-VM listing.
    """
    snaps = []
    try:
        out = subprocess.check_output(
            ["zfs", "list", "-H", "-t", "snapshot", "-o", "name,creation,used",
             "-S", "creation", "-r", "rpool/vms"],
            text=True, stderr=subprocess.DEVNULL, timeout=10
        )
        for line in out.strip().splitlines():
            parts = line.split('\t')
            if len(parts) < 3 or '@' not in parts[0]:
                continue
            ds, sname = parts[0].split('@', 1)
            # ds = "rpool/vms" → skip (top-level); ds = "rpool/vms/<vm>" → include.
            ds_parts = ds.split('/')
            if len(ds_parts) != 3:
                continue
            vm = ds_parts[2]
            snaps.append({
                "vm":      vm,
                "name":    sname,
                "created": parts[1],
                "state":   parts[2],   # repurpose state column to show 'used' (renderer
                                        # writes it into the State column verbatim)
            })
    except Exception:
        pass
    await websocket.send(json.dumps({"type": "vm_snapshots", "snapshots": snaps}))


async def _vm_bulk(websocket, msg):
    """Apply a single virsh op to a list of VM names. Same UX as k8s_bulk —
    UI sends selection, we loop serially so a failure on one doesn't kill
    the batch. Supported ops: start, shutdown, reboot, destroy, undefine."""
    op = msg.get("op", "")
    targets = msg.get("targets", [])
    valid = {"start", "shutdown", "reboot", "destroy", "undefine"}
    if op not in valid or not targets:
        await websocket.send(json.dumps({"type": "error", "msg": "valid op + targets required"}))
        return
    await websocket.send(json.dumps({"type": "vm_log",
        "line": f"[bulk {op}] starting on {len(targets)} VM(s)..."}))
    for name in targets:
        if not name:
            continue
        try:
            out = subprocess.check_output(["virsh", op, name],
                                          text=True, stderr=subprocess.STDOUT, timeout=60)
            await websocket.send(json.dumps({"type": "vm_log",
                "line": f"[{op} {name}] {out.strip()[:200]}"}))
        except subprocess.CalledProcessError as e:
            await websocket.send(json.dumps({"type": "vm_log",
                "line": f"[{op} {name}] FAILED: {(e.output or str(e))[:200]}"}))
        except Exception as e:
            await websocket.send(json.dumps({"type": "vm_log",
                "line": f"[{op} {name}] ERROR: {e}"}))
    await websocket.send(json.dumps({"type": "vm_log", "line": f"[bulk {op}] complete"}))
    await _list_vms(websocket)


async def _list_vms(websocket):
    vms = []
    try:
        out = subprocess.check_output(
            ["virsh", "list", "--all", "--name"], text=True,
            stderr=subprocess.DEVNULL
        )
        for name in out.strip().splitlines():
            name = name.strip()
            if not name:
                continue
            state, vcpus, ram, disk = "unknown", "—", "—", "—"
            try:
                s = subprocess.check_output(
                    ["virsh", "domstate", name], text=True,
                    stderr=subprocess.DEVNULL
                ).strip()
                state = s
            except Exception:
                pass
            try:
                info = subprocess.check_output(
                    ["virsh", "dominfo", name], text=True,
                    stderr=subprocess.DEVNULL
                )
                for line in info.splitlines():
                    if line.startswith("CPU(s):"):
                        vcpus = line.split(":")[-1].strip()
                    elif line.startswith("Max memory:"):
                        mem_kb = int(line.split(":")[-1].strip().split()[0])
                        ram = f"{mem_kb // 1024} MB"
            except Exception:
                pass
            try:
                blk = subprocess.check_output(
                    ["virsh", "domblklist", name, "--details"], text=True,
                    stderr=subprocess.DEVNULL
                )
                for line in blk.splitlines():
                    if "disk" in line and "/dev/zvol/" in line:
                        disk = "zvol"
                        break
                    elif "disk" in line and ".qcow2" in line:
                        disk = "qcow2"
                        break
            except Exception:
                pass
            # IP discovery (running VMs only) — agent → arp → lease cascade.
            # ARP is the universal fallback that covers VMs without QGA
            # (Debian/Ubuntu cloud images don't install it by default). Lease
            # comes last because dnsmasq's lease index doesn't always match
            # what `virsh domifaddr --source lease` returns. See
            # _vm_resolve_ip for the rationale.
            ip = "—"
            if state == "running":
                resolved = _vm_resolve_ip(name)
                if resolved:
                    ip = resolved
            # Readiness probe for running VMs: ping the qemu-guest-agent.
            # Cheap (~50ms when agent responds, 1s when not).
            #   starting: running but no IP yet
            #   booting:  has IP but QGA not yet responding (cloud-init still
            #             setting things up; SSH may already work but the GUI
            #             might not be at GDM yet)
            #   ready:    QGA replied → guest OS is up + responsive
            #   —:        not running
            ready = "—"
            if state == "running":
                ready = "starting"
                if ip != "—":
                    ready = "booting"
                    try:
                        out = subprocess.check_output(
                            ["virsh", "qemu-agent-command", name,
                             '{"execute":"guest-ping"}'],
                            text=True, stderr=subprocess.DEVNULL, timeout=2
                        )
                        if '"return"' in out:
                            ready = "ready"
                    except Exception:
                        pass
            # "building" flag — true only when a fresh _vm_create_cloud is
            # mid-provisioning (cloud-init still running). Cleared as soon
            # as QGA first responds (ready == "ready"). Without this gate
            # the UI used to label every cold-started existing VM "building"
            # while QGA spun up, which is wrong. Caught .113 2026-05-16.
            _build_mark = Path(f"/var/lib/kldload/vm-build-pending/{name}")
            building = _build_mark.exists()
            # Clear the "building" marker only when cloud-init has actually
            # FINISHED (runcmd done, desktop installed). QGA ping alone is
            # too eager — qemu-guest-agent comes up early in boot while
            # cloud-init's runcmd is still doing `dnf install @xfce-desktop`
            # in the background. Operator sees state="running" while desktop
            # install is mid-flight → looks like a CLI VM. Caught .113
            # 2026-05-16.
            #
            # cloud-init status --format=json returns:
            #   {"status": "done", ...}   when fully finished
            #   {"status": "running", ...} while runcmd is going
            # If guest-exec isn't available (older QGA, non-cloud-init VM)
            # we keep the QGA-ready fallback so the marker eventually clears.
            #
            # Failsafe: any marker older than 15 min gets cleared anyway —
            # never leave a VM permanently in "building".
            if building and ready == "ready":
                cloud_init_done = False
                try:
                    _ci = subprocess.check_output(
                        ["virsh", "qemu-agent-command", name,
                         '{"execute":"guest-exec","arguments":{"path":"/usr/bin/cloud-init","arg":["status","--format=json"],"capture-output":true}}'],
                        text=True, stderr=subprocess.DEVNULL, timeout=2
                    )
                    import json as _j
                    _pid = _j.loads(_ci).get("return", {}).get("pid")
                    if _pid:
                        # Give it a moment to finish
                        for _ in range(8):
                            _st = subprocess.check_output(
                                ["virsh", "qemu-agent-command", name,
                                 f'{{"execute":"guest-exec-status","arguments":{{"pid":{_pid}}}}}'],
                                text=True, stderr=subprocess.DEVNULL, timeout=2
                            )
                            _r = _j.loads(_st).get("return", {})
                            if _r.get("exited"):
                                import base64
                                _out = base64.b64decode(_r.get("out-data") or "").decode(errors="replace")
                                cloud_init_done = '"status": "done"' in _out or '"status":"done"' in _out
                                break
                except Exception:
                    pass
                # Failsafe: mark older than 15 min → clear regardless.
                try:
                    _age_min = (time.time() - _build_mark.stat().st_mtime) / 60.0
                    if _age_min > 15:
                        cloud_init_done = True
                except Exception:
                    pass
                if cloud_init_done:
                    try: _build_mark.unlink()
                    except Exception: pass
                    building = False
                # If there's a kexport queued for this VM, fire it now —
                # backgrounded so it doesn't block the list response.
                _exp_mark = Path(f"/var/lib/kldload/vm-export-pending/{name}")
                if _exp_mark.exists():
                    try:
                        _fmt, _dir = _exp_mark.read_text().strip().split("\n", 1)
                        _zvol = f"/dev/zvol/rpool/vms/{name}"
                        _exp_log = f"/var/log/kldload/kexport-{name}.log"
                        Path("/var/log/kldload").mkdir(parents=True, exist_ok=True)
                        Path(_dir).mkdir(parents=True, exist_ok=True)
                        # Background — operator can tail the log; result lands in _dir
                        subprocess.Popen(
                            ["bash", "-c",
                             f"KEXPORT_NAME={name} kexport {_zvol} {_fmt} {_dir} > {_exp_log} 2>&1"],
                            start_new_session=True)
                        _exp_mark.unlink()
                    except Exception:
                        pass
            vms.append({"name": name, "state": state, "vcpus": vcpus, "ram": ram, "disk": disk, "ip": ip, "ready": ready, "building": building})
    except Exception as e:
        LOG.warning("virsh list failed: %s", e)
    await websocket.send(json.dumps({"type": "vm_list", "vms": vms}))

async def _vm_op(websocket, msg):
    vm   = msg.get("vm", "") or msg.get("name", "")
    op   = msg.get("op", "") or msg.get("action", "")
    ops  = {
        "start": ["virsh", "start"],
        "stop": ["virsh", "shutdown"],
        "shutdown": ["virsh", "shutdown"],
        "reboot": ["virsh", "reboot"],
        "force-stop": ["virsh", "destroy"],
        "destroy": ["virsh", "destroy"],
        "delete": ["virsh", "undefine", "--nvram"],
        "undefine": ["virsh", "undefine", "--nvram"],
    }
    if op not in ops or not re.match(r'^[a-zA-Z0-9_\-]+$', vm):
        await websocket.send(json.dumps({"type": "error", "msg": f"invalid vm op: {op} on {vm}"}))
        return
    cmd = ops[op] + [vm]
    try:
        subprocess.check_call(cmd, stderr=subprocess.DEVNULL)
        await websocket.send(json.dumps({"type": "log_line", "line": f"VM {vm}: {op} OK", "target": "vm-log"}))
    except Exception as e:
        await websocket.send(json.dumps({"type": "error", "msg": f"VM {op} failed: {e}"}))
    # Refresh VM list after operation
    await _list_vms(websocket)

async def _zfs_list(websocket):
    pools, datasets = [], []
    try:
        out = subprocess.check_output(
            ["zpool", "list", "-H", "-o", "name,size,alloc,free,health"],
            text=True, stderr=subprocess.DEVNULL
        )
        for line in out.strip().splitlines():
            parts = line.split("\t")
            if len(parts) >= 5:
                pools.append({"name": parts[0], "size": parts[1],
                               "alloc": parts[2], "free": parts[3],
                               "health": parts[4]})
    except Exception:
        pass
    try:
        out = subprocess.check_output(
            ["zfs", "list", "-H", "-o", "name,used,avail,refer,mountpoint"],
            text=True, stderr=subprocess.DEVNULL
        )
        for line in out.strip().splitlines():
            parts = line.split("\t")
            if len(parts) >= 5:
                datasets.append({"name": parts[0], "used": parts[1],
                                  "avail": parts[2], "refer": parts[3],
                                  "mountpoint": parts[4]})
    except Exception:
        pass
    await websocket.send(json.dumps({"type": "zfs_data", "pools": pools, "datasets": datasets}))

async def _k8s_nodes(websocket):
    nodes = []
    try:
        cols = (
            "NAME:.metadata.name,"
            "STATUS:.status.conditions[-1].type,"
            "ROLE:.metadata.labels.node-role\\.kubernetes\\.io/control-plane,"
            "VERSION:.status.nodeInfo.kubeletVersion,"
            "WG2:.metadata.annotations.kldload\\.ca/wg2-ip"
        )
        out = subprocess.check_output(
            ["kubectl", "get", "nodes", "-o",
             f"custom-columns={cols}", "--no-headers"],
            text=True, stderr=subprocess.DEVNULL,
            env={**os.environ, "KUBECONFIG": "/root/.kube/config"},
        )
        for line in out.strip().splitlines():
            parts = line.split()
            if parts:
                nodes.append({
                    "name":       parts[0],
                    "status":     parts[1] if len(parts) > 1 else "?",
                    "role":       "control-plane" if len(parts) > 2 and parts[2] not in ("<none>", "") else "worker",
                    "version":    parts[3] if len(parts) > 3 else "?",
                    "wg2_ip":     parts[4] if len(parts) > 4 and parts[4] != "<none>" else "—",
                    "api_server": "https://10.79.0.1:6443",
                })
    except Exception:
        pass
    # Enrich each node with its labels + taints so the UI can display
    # them inline AND prefill the Edit Labels / Edit Taints modals with
    # current state. One extra kubectl call per refresh (returns ~5-10 KB
    # per node — cheap). Failures are non-fatal; labels/taints just stay
    # empty in the UI if this call fails.
    try:
        json_out = subprocess.check_output(
            ["kubectl", "get", "nodes", "-o", "json"],
            text=True, stderr=subprocess.DEVNULL,
            env={**os.environ, "KUBECONFIG": "/root/.kube/config"},
        )
        data = json.loads(json_out)
        by_name = {n["name"]: n for n in nodes}
        for item in data.get("items", []):
            nm = item.get("metadata", {}).get("name", "")
            if nm not in by_name:
                continue
            by_name[nm]["labels"] = item.get("metadata", {}).get("labels", {}) or {}
            by_name[nm]["taints"] = item.get("spec", {}).get("taints", []) or []
    except Exception:
        pass
    await websocket.send(json.dumps({"type": "k8s_nodes", "nodes": nodes}))

async def _node_list(websocket):
    """Full node fleet: mine query + live ping, returns addressing table."""
    nodes = []
    pending_keys = []
    try:
        # Live ping — 5s timeout, non-fatal if salt not running
        ping_data = {}
        try:
            out = subprocess.check_output(
                ["salt", "*", "test.ping", "--out=json", "-t", "5"],
                text=True, stderr=subprocess.DEVNULL,
            )
            ping_data = json.loads(out)
        except Exception:
            pass

        # Grains: role, color, index, all four WireGuard IPs
        grains_data = {}
        try:
            g_out = subprocess.check_output(
                ["salt", "*", "grains.item",
                 "role", "color", "node_index",
                 "wg0_ip", "wg1_ip", "wg2_ip", "wg3_ip",
                 "--out=json", "-t", "5"],
                text=True, stderr=subprocess.DEVNULL,
            )
            grains_data = json.loads(g_out)
        except Exception:
            pass

        # Merge: any host that appears in grains OR ping
        all_hosts = set(grains_data.keys()) | set(ping_data.keys())
        for host in sorted(all_hosts):
            g = grains_data.get(host, {})
            color = g.get("color", "")
            index = g.get("node_index", "")
            # Derive IPs from index+color if grains not yet set
            if index and not g.get("wg0_ip"):
                octet3 = 100 if color == "blue" else 200
                g["wg0_ip"] = f"10.77.{octet3}.{index}"
                g["wg1_ip"] = f"10.78.{octet3}.{index}"
                g["wg2_ip"] = f"10.79.{octet3}.{index}"
                g["wg3_ip"] = f"10.80.{octet3}.{index}"
            nodes.append({
                "host":   host,
                "online": ping_data.get(host) is True,
                "role":   g.get("role", ""),
                "color":  color,
                "index":  str(index),
                "wg0":    g.get("wg0_ip", ""),
                "wg1":    g.get("wg1_ip", ""),
                "wg2":    g.get("wg2_ip", ""),
                "wg3":    g.get("wg3_ip", ""),
            })
    except Exception as e:
        LOG.warning("node_list failed: %s", e)

    # Pending keys
    try:
        k_out = subprocess.check_output(
            ["salt-key", "-l", "pre", "--out=json"],
            text=True, stderr=subprocess.DEVNULL,
        )
        pending_keys = json.loads(k_out).get("minions_pre", [])
    except Exception:
        pass

    await websocket.send(json.dumps({
        "type":    "node_list",
        "nodes":   nodes,
        "pending": pending_keys,
    }))


async def _node_apply(websocket, msg):
    """Apply a Salt state to a target minion (or grain match)."""
    salt_target = msg.get("target", "")
    state       = msg.get("state", "")
    ws_target   = msg.get("_target", "log")
    if not re.match(r'^[a-zA-Z0-9_\-\.\*]+$', salt_target):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid target"}))
        return
    if not re.match(r'^[a-zA-Z0-9_\.\-]+$', state):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid state"}))
        return
    cmd = ["salt", salt_target, "state.apply", state]
    # state.apply on a fleet can run minutes — detached for the same reason
    # as state.highstate above.
    await _stream_proc_detached(websocket, cmd, target=ws_target)


async def _mine_refresh(websocket, msg):
    """Force all minions to update their mine data."""
    salt_target = msg.get("target", "*")
    if not re.match(r'^[a-zA-Z0-9_\-\.\*]+$', salt_target):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid target"}))
        return
    await _stream_proc(websocket, ["salt", salt_target, "mine.update"],
                       target=msg.get("_target", "log"))


async def _node_accept_key(websocket, msg):
    """Accept a specific pending Salt key by minion name."""
    name = msg.get("name", "")
    if not re.match(r'^[a-zA-Z0-9_\-\.]+$', name):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid key name"}))
        return
    try:
        subprocess.check_call(
            ["salt-key", "-a", name, "-y"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        await websocket.send(json.dumps({
            "type": "log_line", "line": f"Accepted key: {name}", "target": "log",
        }))
        # Immediately refresh node list
        await _node_list(websocket)
    except Exception as e:
        await websocket.send(json.dumps({"type": "error", "msg": str(e)}))


async def _salt_status(websocket):
    minions = []
    pending = 0
    try:
        out = subprocess.check_output(
            ["salt", "*", "test.ping", "--out=json", "-t", "5"],
            text=True, stderr=subprocess.DEVNULL
        )
        ping_data = json.loads(out)
        # Fetch grains for role/wg1_ip/node_index
        grains_data = {}
        try:
            g_out = subprocess.check_output(
                ["salt", "*", "grains.item", "role", "wg1_ip", "node_index",
                 "--out=json", "-t", "5"],
                text=True, stderr=subprocess.DEVNULL
            )
            grains_data = json.loads(g_out)
        except Exception:
            pass
        for host, ok in ping_data.items():
            g = grains_data.get(host, {})
            minions.append({
                "host":       host,
                "online":     ok is True,
                "role":       g.get("role", ""),
                "wg1_ip":     g.get("wg1_ip", ""),
                "node_index": g.get("node_index", ""),
            })
    except Exception:
        pass
    # Pending keys
    try:
        k_out = subprocess.check_output(
            ["salt-key", "-l", "pre", "--out=json"],
            text=True, stderr=subprocess.DEVNULL
        )
        k_data = json.loads(k_out)
        pending = len(k_data.get("minions_pre", []))
    except Exception:
        pass
    await websocket.send(json.dumps({
        "type": "salt_status",
        "minions": minions,
        "pending": pending,
    }))

async def _run_poof(websocket, msg):
    """Run kldload-poof in live mode only; stream output then send poof_done."""
    live = True
    try:
        with open("/etc/kldload/install-manifest.env") as f:
            if "KLDLOAD_INSTALLED=1" in f.read():
                live = False
    except Exception:
        pass
    if not live:
        await websocket.send(json.dumps({"type": "error", "msg": "poof only runs in live mode"}))
        return
    await _stream_proc(websocket, ["/usr/local/sbin/kldload-poof"],
                       target=msg.get("_target", "log"))
    await websocket.send(json.dumps({"type": "poof_done"}))


async def _run_cluster_deploy(websocket, msg):
    cmd_type = msg.get("cmd", "")
    if cmd_type not in ("scc", "k8s-ha"):
        await websocket.send(json.dumps({"type": "error", "msg": "cmd must be scc or k8s-ha"}))
        return

    # Load saved credentials to resolve named targets
    all_creds = _load_credentials()
    px_by_id  = {p["id"]: p for p in all_creds.get("proxmox", [])}

    # Per-node target overrides: {"master": "px-123", "fw1": "px-456", ...}
    node_targets = msg.get("node_targets", {})
    # Default target (falls back to inline form values)
    default_px = {
        "host":         msg.get("proxmox_host",  ""),
        "node":         msg.get("proxmox_node",  "pve"),
        "token_id":     msg.get("token_id",      ""),
        "token_secret": msg.get("token_secret",  ""),
        "iso_storage":  msg.get("iso_storage",   "local"),
    }

    def _env_for_node(hostname):
        cid = node_targets.get(hostname)
        px  = px_by_id.get(cid, default_px) if cid else default_px
        return {
            "PROXMOX_HOST":         px.get("host",         default_px["host"]),
            "PROXMOX_NODE":         px.get("node",         default_px["node"]),
            "PROXMOX_TOKEN_ID":     px.get("token_id",     default_px["token_id"]),
            "PROXMOX_TOKEN_SECRET": px.get("token_secret", default_px["token_secret"]),
            "PROXMOX_ISO_STORAGE":  px.get("iso_storage",  default_px["iso_storage"]),
        }

    # Find deploy script
    deploy_sh = None
    for p in ["/usr/local/sbin/kldload-deploy-sh",
              "/root/kldload/deploy.sh",
              "/opt/kldload/deploy.sh"]:
        if Path(p).exists():
            deploy_sh = p
            break
    if not deploy_sh:
        await websocket.send(json.dumps({"type": "error",
            "msg": "deploy script not found", "target": "cluster-deploy"}))
        return

    # Build combined env: default proxmox + per-node JSON map for multi-target
    env = {**os.environ}
    env.update(_env_for_node("__default__"))
    if node_targets:
        env["KLDLOAD_NODE_TARGETS"] = json.dumps(node_targets)
        # Serialize per-node credentials so deploy.sh can source them
        resolved = {}
        for node, cid in node_targets.items():
            resolved[node] = _env_for_node(node)
        env["KLDLOAD_NODE_CREDS"] = json.dumps(resolved)

    # Cluster-deploy walks every node in the fleet — Proxmox API calls,
    # SSH bootstraps, ZFS provisioning. Easily 10-30 min for a 6-node deploy.
    await _stream_proc_detached(websocket, [deploy_sh, cmd_type], env=env, target="cluster-deploy")

async def _wg_planes_list(websocket):
    """Return all WireGuard interfaces: fixed defaults + user-defined."""
    DEFAULTS = [
        {"iface": "wg0", "subnet": "10.77.0.0/16", "port": 51820, "role": "Enrollment",  "fixed": True},
        {"iface": "wg1", "subnet": "10.78.0.0/16", "port": 51821, "role": "Management",  "fixed": True},
        {"iface": "wg2", "subnet": "10.79.0.0/16", "port": 51822, "role": "Kubernetes",  "fixed": True},
        {"iface": "wg3", "subnet": "10.80.0.0/16", "port": 51823, "role": "Storage",     "fixed": True},
    ]
    planes = list(DEFAULTS)
    # Scan for user-defined planes wg4+
    wg_dir = Path("/etc/wireguard")
    idx = 4
    while True:
        iface = f"wg{idx}"
        conf = wg_dir / f"{iface}.conf"
        if not conf.exists():
            break
        label, subnet, port = iface, "", 0
        try:
            text = conf.read_text()
            for line in text.splitlines():
                if line.startswith("# label="):
                    label = line.split("=", 1)[1].strip()
                if "Address" in line:
                    subnet = line.split("=", 1)[1].strip()
                if "ListenPort" in line:
                    port = int(line.split("=", 1)[1].strip())
        except Exception:
            pass
        planes.append({"iface": iface, "subnet": subnet, "port": port,
                        "role": label, "fixed": False})
        idx += 1
    await websocket.send(json.dumps({"type": "wg_planes", "planes": planes}))

async def _wg_plane_create(websocket, msg):
    label  = msg.get("label", "custom").replace(" ", "-")[:32]
    subnet = msg.get("subnet", "")
    port   = int(msg.get("port", 0))
    if not subnet or not port:
        await websocket.send(json.dumps({"type": "error", "msg": "subnet and port required"}))
        return
    # Find next free interface index
    idx = 4
    while Path(f"/etc/wireguard/wg{idx}.conf").exists():
        idx += 1
    iface = f"wg{idx}"
    try:
        privkey = subprocess.check_output(["wg", "genkey"], text=True).strip()
        pubkey  = subprocess.check_output(["wg", "pubkey"], input=privkey, text=True).strip()
        conf = f"""# label={label}
[Interface]
Address = {subnet.split('/')[0].rsplit('.', 1)[0]}.1/{subnet.split('/')[1]}
ListenPort = {port}
PrivateKey = {privkey}
"""
        Path(f"/etc/wireguard/{iface}.conf").write_text(conf)
        Path(f"/etc/wireguard/{iface}.conf").chmod(0o600)
        subprocess.check_call(["systemctl", "enable", "--now", f"wg-quick@{iface}"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        await websocket.send(json.dumps({"type": "wg_plane_created",
            "iface": iface, "pubkey": pubkey, "label": label}))
        await _wg_planes_list(websocket)
    except Exception as e:
        await websocket.send(json.dumps({"type": "error", "msg": f"plane create failed: {e}"}))

async def _wg_plane_delete(websocket, msg):
    iface = msg.get("iface", "")
    if not re.match(r'^wg[4-9][0-9]*$', iface):
        await websocket.send(json.dumps({"type": "error", "msg": "can only delete user-defined planes (wg4+)"}))
        return
    try:
        subprocess.call(["systemctl", "disable", "--now", f"wg-quick@{iface}"],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        conf = Path(f"/etc/wireguard/{iface}.conf")
        if conf.exists():
            conf.unlink()
        await websocket.send(json.dumps({"type": "wg_plane_deleted", "iface": iface}))
        await _wg_planes_list(websocket)
    except Exception as e:
        await websocket.send(json.dumps({"type": "error", "msg": f"plane delete failed: {e}"}))

async def _run_audit(websocket):
    """Run kldload-audit --json, stream the log, then push the parsed results."""
    audit_bin = "/usr/local/sbin/kldload-audit"
    if not os.path.exists(audit_bin):
        await websocket.send(json.dumps({"type": "error", "msg": "kldload-audit not found"}))
        return
    await websocket.send(json.dumps({"type": "audit_started"}))
    # Run with --json so we can parse final results, but also capture the log
    try:
        proc = await asyncio.create_subprocess_exec(
            audit_bin, "--json",
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.STDOUT,
        )
        stdout, _ = await proc.communicate()
        output = stdout.decode(errors="replace").strip()
        # Try to parse JSON results
        try:
            results = json.loads(output)
        except json.JSONDecodeError:
            results = []
        pass_count = sum(1 for r in results if r.get("status") == "PASS")
        fail_count = sum(1 for r in results if r.get("status") == "FAIL")
        skip_count = sum(1 for r in results if r.get("status") == "SKIP")
        await websocket.send(json.dumps({
            "type": "audit_done",
            "results": results,
            "summary": {"pass": pass_count, "fail": fail_count, "skip": skip_count},
            "rc": proc.returncode,
        }))
    except Exception as exc:
        await websocket.send(json.dumps({"type": "error", "msg": str(exc)}))


async def _vm_clone(websocket, msg):
    """Clone a VM from its golden image and stamp a new identity."""
    # Accept both key shapes — JS sends src/dst (5 call sites), older
    # callers may still send vm/new_name. Without this, every Clone
    # button click in the VM list silently failed with "invalid vm name"
    # because msg keys didn't match. Caught .133 2026-05-16.
    src_vm   = msg.get("src") or msg.get("vm", "")
    new_name = msg.get("dst") or msg.get("new_name", "")
    if not re.match(r'^[a-zA-Z0-9_\-]+$', src_vm):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid vm name"}))
        return
    if not new_name:
        import time as _time
        new_name = f"{src_vm}-clone-{int(_time.time()) % 100000}"
    await websocket.send(json.dumps({"type": "log_line", "line": f"[clone] Cloning {src_vm} → {new_name}", "target": "vm-log"}))
    # Drop "building" marker — cleared by _list_vms when QGA first responds.
    try:
        Path("/var/lib/kldload/vm-build-pending").mkdir(parents=True, exist_ok=True)
        Path(f"/var/lib/kldload/vm-build-pending/{new_name}").touch()
    except Exception:
        pass
    golden_dir = Path("/var/lib/kldload/golden")
    image_path = golden_dir / f"{src_vm}.qcow2"
    if not image_path.exists():
        # Fall back: look for any golden matching the vm's role pattern
        await websocket.send(json.dumps({"type": "log_line", "line": f"[clone] No golden image for {src_vm} — using live disk clone via virsh", "target": "vm-log"}))
        cmd = ["virt-clone", "--original", src_vm, "--name", new_name, "--auto-clone"]
    else:
        clone_path = golden_dir / f"{new_name}.qcow2"
        try:
            subprocess.check_call(
                ["qemu-img", "create", "-f", "qcow2", "-b", str(image_path), "-F", "qcow2", str(clone_path)],
                stderr=subprocess.DEVNULL
            )
        except Exception as e:
            await websocket.send(json.dumps({"type": "error", "msg": f"qemu-img clone failed: {e}"}))
            return
        cmd = ["kldload-stamp-identity", "--hostname", new_name, "--image", str(clone_path), "--start"]
    # virt-clone copies a full disk; stamp-identity boots + edits + reseals.
    # 2-5 min minimum, often longer on slow disks.
    await _stream_proc_detached(websocket, cmd, target="vm-log")
    # Persist the cloned domain — same bug as vm_create_cloud: virt-install/
    # virt-clone may produce a transient domain that auto-undefines on
    # shutdown. dumpxml | define is idempotent.
    try:
        _xml = subprocess.check_output(
            ["virsh", "dumpxml", new_name], text=True, stderr=subprocess.DEVNULL, timeout=5)
        subprocess.run(["virsh", "define", "/dev/stdin"], input=_xml, text=True,
                       check=False, capture_output=True, timeout=5)
    except Exception:
        pass
    db_log_event("vm_clone", src_vm, f"Cloned {src_vm} → {new_name}")
    await websocket.send(json.dumps({"type": "exec_done", "rc": 0, "target": "vm-log"}))

async def _vm_snaps(websocket, msg):
    """List user-initiated (@manual-*) snapshots for a single VM — used by
    the Rollback dropdown. Filters out:
      - @autosnap_*           (sanoid hourly/daily/weekly/monthly)
      - @klab-k8s-bootstrap-* (klab automatic pre-cluster snaps)
      - @golden               (klab post-build marker)
      - @install-*            (install-time baseline)
    Operator only ever rolls back to snaps they explicitly created — auto
    snaps are visible in Storage > ZFS Snapshots for awareness but aren't
    candidates here (rolling back to one would silently revert to a sanoid
    cadence snap, almost never what the operator intended)."""
    vm = msg.get("vm", "")
    if not re.match(r'^[a-zA-Z0-9_\-]+$', vm):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid vm name"}))
        return
    snaps = []
    try:
        out = subprocess.check_output(
            ["zfs", "list", "-t", "snapshot", "-H", "-o", "name,creation,used",
             "-S", "creation", "-r", f"rpool/vms/{vm}"],
            text=True, stderr=subprocess.DEVNULL
        )
        for line in out.strip().splitlines():
            parts = line.split('\t')
            if len(parts) < 3 or '@' not in parts[0]:
                continue
            _sname = parts[0].split('@', 1)[1]
            # Only user-initiated snaps reach the rollback dropdown.
            if not _sname.startswith("manual-"):
                continue
            snaps.append({"name": parts[0], "creation": parts[1], "used": parts[2]})
    except Exception:
        # No snapshots, or dataset missing — return empty list, not error.
        pass
    await websocket.send(json.dumps({"type": "vm_snaps", "vm": vm, "snaps": snaps}))


async def _vm_rollback(websocket, msg):
    """Rollback a VM to a snapshot. Stops the VM if running, runs zfs
    rollback -r (destroys snapshots newer than the target), restarts."""
    vm   = msg.get("vm", "")
    snap = msg.get("snap", "")
    if not re.match(r'^[a-zA-Z0-9_\-]+$', vm):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid vm name"}))
        return
    # snap should look like rpool/vms/<vm>@<snapname>. New @manual-* names
    # use ISO-ish format (manual-2026-05-16_17:57:37) — `:` is a valid
    # ZFS snap char, so the regex below allows it explicitly.
    if not re.match(r'^rpool/vms/[a-zA-Z0-9_\-]+@[A-Za-z0-9_:.\-]+$', snap):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid snapshot path"}))
        return
    if not snap.startswith(f"rpool/vms/{vm}@"):
        await websocket.send(json.dumps({"type": "error", "msg": "snapshot does not belong to this VM"}))
        return
    await websocket.send(json.dumps({"type": "log_line", "line": f"[rollback] {vm} → {snap}", "target": "vm-log"}))
    # Defensive: stash the domain XML BEFORE destroy. If the domain happens
    # to be transient (cloud-created VMs sometimes come up transient — see
    # _vm_create_cloud notes), `virsh destroy` would auto-undefine it.
    # We re-define from the saved XML after rollback so the VM never
    # vanishes. Harmless for persistent domains (define is idempotent).
    # Bug story: caught .113 2026-05-16 — user clicked Rollback on a
    # cloud-created fedora-desktop, virsh destroy nuked the libvirt domain,
    # ZFS data survived but the VM was gone from the list.
    saved_xml = None
    try:
        saved_xml = subprocess.check_output(
            ["virsh", "dumpxml", vm], text=True, stderr=subprocess.DEVNULL, timeout=5)
    except Exception:
        pass
    # Stop the VM if running (rollback on a live dataset would corrupt).
    was_running = False
    try:
        state = subprocess.check_output(
            ["virsh", "domstate", vm], text=True, stderr=subprocess.DEVNULL
        ).strip()
        if state == "running":
            was_running = True
            subprocess.call(["virsh", "destroy", vm], stderr=subprocess.DEVNULL)
            await websocket.send(json.dumps({"type": "log_line", "line": f"[rollback] stopped {vm}", "target": "vm-log"}))
    except Exception:
        pass
    # If destroy undefined a transient domain, re-define from saved XML.
    if saved_xml:
        try:
            subprocess.run(["virsh", "define", "/dev/stdin"], input=saved_xml, text=True,
                           check=False, capture_output=True, timeout=5)
        except Exception:
            pass
    # zfs rollback -r — discards any snapshots/datasets newer than the target.
    # Required if the user wants to revert past an intermediate snap.
    try:
        subprocess.check_call(["zfs", "rollback", "-r", snap], stderr=subprocess.STDOUT)
        await websocket.send(json.dumps({"type": "log_line", "line": f"[rollback] zfs rollback OK", "target": "vm-log"}))
    except Exception as e:
        await websocket.send(json.dumps({"type": "error", "msg": f"zfs rollback failed: {e}"}))
        return
    if was_running:
        try:
            subprocess.check_call(["virsh", "start", vm], stderr=subprocess.STDOUT)
            await websocket.send(json.dumps({"type": "log_line", "line": f"[rollback] restarted {vm}", "target": "vm-log"}))
        except Exception as e:
            await websocket.send(json.dumps({"type": "log_line", "line": f"[rollback] WARNING restart failed: {e}", "target": "vm-log"}))
    db_log_event("vm_rollback", vm, f"Rolled back {vm} to {snap}")
    await websocket.send(json.dumps({"type": "exec_done", "rc": 0, "target": "vm-log"}))
    await _list_vms(websocket)


async def _vm_replace(websocket, msg):
    """Replace a VM: clone it, then destroy the original."""
    vm = msg.get("vm", "")
    if not re.match(r'^[a-zA-Z0-9_\-]+$', vm):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid vm name"}))
        return
    import time as _time
    new_name = f"{vm}-new-{int(_time.time()) % 100000}"
    await websocket.send(json.dumps({"type": "log_line", "line": f"[replace] Starting replace of {vm}", "target": "vm-log"}))
    # Step 1: clone
    await _vm_clone(websocket, {"vm": vm, "new_name": new_name})
    # Step 2: destroy original
    await websocket.send(json.dumps({"type": "log_line", "line": f"[replace] Destroying original {vm}", "target": "vm-log"}))
    try:
        subprocess.call(["virsh", "destroy", vm], stderr=subprocess.DEVNULL)
        subprocess.call(["virsh", "undefine", "--nvram", vm], stderr=subprocess.DEVNULL)
    except Exception as e:
        await websocket.send(json.dumps({"type": "log_line", "line": f"[replace] WARNING: destroy failed: {e}", "target": "vm-log"}))
    db_log_event("vm_replace", vm, f"Replaced {vm} with {new_name}")
    await websocket.send(json.dumps({"type": "log_line", "line": f"[replace] Done. New VM: {new_name}", "target": "vm-log"}))


# ─────────────────────────────────────────────────────────────────────
# Cloud-image VM create (server / desktop flavor)
#
# Clones a `rpool/vms/klab-golden-<distro>` zvol, builds a cloud-init
# seed ISO (NoCloud datasource), and `virt-install --import`s the
# resulting domain. Replaces the old qcow2-based _vm_clone path which
# assumed images at /var/lib/kldload/golden/*.qcow2 — kldload F44 stores
# goldens as zvols, so that branch was effectively dead.
#
# Two flavors:
#   server   — headless. Cloud-init enables root/kldload + ssh.
#   desktop  — server + dnf/apt installs xfce-desktop + lightdm,
#              autologins root into xfce. View button shows the desktop.
#
# Distro-aware install line: dnf for centos/rocky/fedora,
# apt-get for debian/ubuntu. Single runcmd with a `command -v dnf`
# probe keeps the userdata one template.
# ─────────────────────────────────────────────────────────────────────

_VM_CLOUD_DISTROS = ("centos", "rocky", "fedora", "debian", "ubuntu")
_VM_CLOUD_FLAVORS = ("server", "desktop")

# DKMS makes the cloud-image boot slow (rebuilds zfs against the live
# kernel before getty starts). Cloud users almost never need zfs in the
# guest — they're using ZFS on the host for the zvol-backed disk. Masking
# dkms in cloud-init shaves 2-5 min off first boot.
_VM_CLOUD_BASE_BOOTCMD = (
    "  - [ sh, -c, \"systemctl stop firewalld 2>/dev/null; systemctl mask firewalld 2>/dev/null; true\" ]\n"
    "  - [ sh, -c, \"systemctl stop ufw 2>/dev/null; systemctl mask ufw 2>/dev/null; ufw --force disable 2>/dev/null; true\" ]\n"
    "  - [ sh, -c, \"systemctl mask dkms.service 2>/dev/null; true\" ]\n"
    "  - [ sh, -c, \"passwd -uf root 2>/dev/null; true\" ]\n"
    "  - [ sh, -c, \"mkdir -p /etc/ssh/sshd_config.d && printf 'PermitRootLogin yes\\\\nPasswordAuthentication yes\\\\n' > /etc/ssh/sshd_config.d/99-kldload.conf\" ]\n"
)

# Desktop runcmd: install XFCE + lightdm with autologin. Cross-distro by
# probing dnf vs apt-get at runtime. xfce chosen over GNOME because
# it's lighter (~200MB vs ~1.5GB), boots in under 30s, and renders well
# over qxl/spice without 3D accel.
def _vm_cloud_desktop_runcmd(de: str) -> str:
    """Build the cloud-init runcmd block for desktop install.

    de = 'xfce' | 'cinnamon' | 'gnome'

    Why a function instead of a constant: previously hardcoded to XFCE +
    used `dnf groupinstall` which dnf5 (Fedora 44 default) removed —
    "groupinstall" → "Unknown argument" → desktop_pkgs=0. The `@group`
    install spec works on both dnf4 and dnf5, so all dnf paths now use
    that form. Per-DE branches honor the operator's choice from the
    Create form's Desktop env picker. Caught on .113 fedora-desktop-01
    2026-05-17 — cloud-init reported done but zero desktop packages.
    """
    # autologin session name varies by DE
    _session = {"xfce": "xfce", "cinnamon": "cinnamon", "gnome": "gnome"}.get(de, "xfce")
    # Per-distro × per-DE install commands. `@group` prefix is dnf4 + dnf5
    # compatible (`dnf install @group` works on both; `groupinstall` is
    # dnf4-only and dropped from dnf5).
    if de == "xfce":
        _install = (
            'case "$ID" in '
              'rocky|rhel|centos|almalinux) '
                'dnf -y install epel-release && '
                'dnf -y install @xfce lightdm xfce4-session ;; '
              'fedora) '
                'dnf -y install @xfce-desktop-environment lightdm ;; '
              'debian|ubuntu) '
                'DEBIAN_FRONTEND=noninteractive apt-get update && '
                'DEBIAN_FRONTEND=noninteractive apt-get install -y xfce4 xfce4-goodies lightdm ;; '
            'esac'
        )
    elif de == "cinnamon":
        # Cinnamon ("Mint-style"). Best on Ubuntu (where Mint lives) but
        # we support it across the board where packages exist.
        _install = (
            'case "$ID" in '
              'rocky|rhel|centos|almalinux) '
                'dnf -y install epel-release && '
                'dnf -y install cinnamon-session cinnamon lightdm ;; '
              'fedora) '
                'dnf -y install @cinnamon-desktop-environment lightdm ;; '
              'debian|ubuntu) '
                'DEBIAN_FRONTEND=noninteractive apt-get update && '
                'DEBIAN_FRONTEND=noninteractive apt-get install -y cinnamon-desktop-environment lightdm ;; '
            'esac'
        )
    elif de == "gnome":
        # GNOME is heaviest. Fedora's path is cleanest (native); for
        # Ubuntu use ubuntu-gnome-desktop minus snaps via --no-install-recommends.
        _install = (
            'case "$ID" in '
              'rocky|rhel|centos|almalinux) '
                'dnf -y install @gnome lightdm ;; '
              'fedora) '
                'dnf -y install @gnome-desktop-environment ;; '
              'debian|ubuntu) '
                'DEBIAN_FRONTEND=noninteractive apt-get update && '
                'DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ubuntu-desktop-minimal gdm3 ;; '
            'esac'
        )
    else:
        _install = 'true'   # unknown DE → no-op
    return (
        "runcmd:\n"
        f"  - [ sh, -c, \"set -x; {{ . /etc/os-release; {_install}; }} >> /var/log/kldload-desktop.log 2>&1\" ]\n"
        "  - [ sh, -c, \"systemctl set-default graphical.target >> /var/log/kldload-desktop.log 2>&1\" ]\n"
        f"  - [ sh, -c, \"mkdir -p /etc/lightdm/lightdm.conf.d && printf '[Seat:*]\\\\nautologin-user=root\\\\nautologin-session={_session}\\\\nautologin-user-timeout=0\\\\n' > /etc/lightdm/lightdm.conf.d/50-kldload-autologin.conf\" ]\n"
        "  - [ sh, -c, \"systemctl enable lightdm.service 2>/dev/null || systemctl enable gdm.service 2>/dev/null || systemctl enable gdm3.service 2>/dev/null || true\" ]\n"
        "  - [ sh, -c, \"systemctl isolate graphical.target || systemctl start lightdm || systemctl start gdm || true\" ]\n"
    )

# Legacy constant kept as no-op for any code that still imports it; real
# build now uses _vm_cloud_desktop_runcmd(de) per-request.
_VM_CLOUD_DESKTOP_RUNCMD = ""

_VM_NAME_RE = re.compile(r"^[a-zA-Z0-9][a-zA-Z0-9_\-]{0,62}$")

def _vm_cloud_userdata(name: str, flavor: str, de: str = "xfce") -> str:
    """Compose the cloud-init userdata for a server/desktop flavor."""
    body = (
        "#cloud-config\n"
        f"hostname: {name}\n"
        "manage_etc_hosts: true\n"
        "disable_root: false\n"
        "ssh_pwauth: true\n"
        "package_update: false\n"
        "chpasswd:\n"
        "  expire: false\n"
        "  list: |\n"
        "    root:kldload\n"
        "bootcmd:\n"
        f"{_VM_CLOUD_BASE_BOOTCMD}"
    )
    if flavor == "desktop":
        body += _vm_cloud_desktop_runcmd(de)
    return body

async def _vm_create_cloud(websocket, msg):
    """Deploy a cloud-init VM (server or desktop) from a klab golden zvol."""
    import tempfile, time as _time, os as _os
    distro = (msg.get("distro") or "").strip().lower()
    flavor = (msg.get("flavor") or "server").strip().lower()
    de     = (msg.get("desktop_env") or "xfce").strip().lower()
    name   = (msg.get("name")   or "").strip()
    ram    = int(msg.get("ram")  or 4096)
    cpus   = int(msg.get("cpus") or 2)

    async def _log(line):
        await websocket.send(json.dumps({"type": "log_line", "line": line, "target": "vm-log"}))
    async def _err(line):
        await websocket.send(json.dumps({"type": "error", "msg": line}))

    if distro not in _VM_CLOUD_DISTROS:
        await _err(f"unknown distro {distro!r} (supported: {', '.join(_VM_CLOUD_DISTROS)})")
        return
    if flavor not in _VM_CLOUD_FLAVORS:
        await _err(f"unknown flavor {flavor!r} (supported: {', '.join(_VM_CLOUD_FLAVORS)})")
        return
    if not name:
        name = f"{distro}-{flavor}-{int(_time.time()) % 10000:04d}"
    if not _VM_NAME_RE.match(name):
        await _err(f"invalid VM name {name!r} (letters/digits/dash/underscore, ≤63 chars, must start alnum)")
        return

    src_zvol = f"rpool/vms/klab-golden-{distro}"
    dst_zvol = f"rpool/vms/{name}"
    seed_iso = f"/var/lib/libvirt/images/{name}-seed.iso"

    await _log(f"[create-cloud] {distro}/{flavor} → {name} ({ram}MB / {cpus} vCPU)")

    # Drop "building" marker so the VM list shows building until QGA responds.
    # _list_vms removes it once ready. Marker dir is volatile (tmpfs ok).
    try:
        Path("/var/lib/kldload/vm-build-pending").mkdir(parents=True, exist_ok=True)
        Path(f"/var/lib/kldload/vm-build-pending/{name}").touch()
    except Exception:
        pass

    # Optional: queue a post-ready kexport. Write a marker file with the
    # requested format + output dir; a background watcher (started below)
    # polls until QGA reports ready, then runs `kexport <zvol> <fmt> <dir>`.
    # All export formats kexport supports are accepted: qcow2|raw|vhd|vmdk|
    # ova|oci|lxc|firecracker|all.
    _export_fmt = (msg.get("export_format") or "").strip().lower()
    _export_dir = (msg.get("export_dir") or "/var/lib/kldload/exports").strip()
    if _export_fmt and re.match(r'^(qcow2|raw|vhd|vmdk|ova|oci|lxc|firecracker|all)$', _export_fmt):
        try:
            Path("/var/lib/kldload/vm-export-pending").mkdir(parents=True, exist_ok=True)
            Path(f"/var/lib/kldload/vm-export-pending/{name}").write_text(
                f"{_export_fmt}\n{_export_dir}\n")
        except Exception as e:
            await _log(f"[create-cloud] WARNING: couldn't queue export ({e})")
        else:
            await _log(f"[create-cloud] queued kexport → {_export_fmt} (will fire after VM is ready)")

    # Preflight: golden zvol exists?
    if subprocess.call(["zfs", "list", src_zvol],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
        await _err(f"golden zvol {src_zvol} not found — build it first via klab golden {distro}")
        return
    # And no existing domain or zvol with the target name?
    if subprocess.call(["virsh", "dominfo", name],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0:
        await _err(f"VM {name} already exists — pick a different name or destroy the existing one")
        return
    if subprocess.call(["zfs", "list", dst_zvol],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0:
        await _err(f"zvol {dst_zvol} already exists — destroy it first")
        return

    # Snapshot + clone the golden zvol
    snap = f"{src_zvol}@create-{name}-{int(_time.time())}"
    try:
        subprocess.check_call(["zfs", "snapshot", snap])
        subprocess.check_call(["zfs", "clone", snap, dst_zvol])
    except subprocess.CalledProcessError as e:
        await _err(f"zfs clone failed: {e}")
        return
    await _log(f"[create-cloud] cloned {src_zvol} → {dst_zvol}")

    # Wait for the /dev/zvol/... node — udev fires async after zfs clone.
    # Without this wait, virt-install races and fails with "no such block
    # device". 5s budget at 100ms is enough on every box we've tested.
    dev_path = f"/dev/zvol/{dst_zvol}"
    for _ in range(50):
        if _os.path.exists(dev_path):
            break
        await asyncio.sleep(0.1)
    else:
        await _err(f"timeout waiting for {dev_path} to appear after zfs clone")
        return

    # Build the cloud-init NoCloud seed (mkisofs is in the base image —
    # genisoimage isn't on F44).
    with tempfile.TemporaryDirectory() as work:
        with open(_os.path.join(work, "meta-data"), "w") as f:
            f.write(f"instance-id: {name}\nlocal-hostname: {name}\n")
        with open(_os.path.join(work, "user-data"), "w") as f:
            f.write(_vm_cloud_userdata(name, flavor, de))
        try:
            subprocess.check_call(
                ["mkisofs", "-output", seed_iso, "-volid", "cidata",
                 "-joliet", "-rock",
                 _os.path.join(work, "user-data"),
                 _os.path.join(work, "meta-data")],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
        except subprocess.CalledProcessError as e:
            await _err(f"mkisofs failed: {e}")
            return
    await _log(f"[create-cloud] cloud-init seed → {seed_iso}")

    # virt-install --import with VNC + qxl so the noVNC View button
    # renders a usable framebuffer (qxl > vga for desktop; even server
    # benefits from the higher resolution at the boot console).
    # --noautoconsole because we're a daemon, not a TTY.
    cmd = [
        "virt-install",
        "--name", name,
        "--memory", str(ram),
        "--vcpus", str(cpus),
        "--disk", f"path={dev_path},bus=virtio,format=raw",
        "--disk", f"path={seed_iso},device=cdrom,bus=sata",
        "--import",
        "--os-variant", _vm_cloud_os_variant(distro),
        "--network", "network=default,model=virtio",
        "--graphics", "vnc,listen=0.0.0.0",
        # virtio-gpu is the modern paravirt GPU. qxl was the prior choice but
        # produces vertical-stripe + red-block framebuffer corruption on
        # Ubuntu 24.04 / Fedora-Wayland desktops — the qxl driver mishandles
        # GBM/Wayland buffer flips. Caught .113 ubuntu-desktop-o819 2026-05-16.
        # virtio works on all current distros (Linux kernel has virtio_gpu
        # since forever, no extra config in the guest).
        "--video", "virtio",
        "--noautoconsole",
    ]
    # virt-install + cloud-init first boot = 2-10 min. Detach so a Create-VM
    # operation doesn't get killed by a brownout reload.
    await _stream_proc_detached(websocket, cmd, target="vm-log")
    # CRITICAL — make the domain persistent. virt-install in some libvirt
    # builds creates the initial domain as transient even without
    # --transient — possibly an interaction with --import + --noautoconsole
    # in newer libvirt-python. Without this re-define, the domain
    # auto-undefines on the first `virsh shutdown` or `virsh destroy`,
    # leaving the ZFS dataset orphaned and the VM gone from the list.
    # Operator sees "I shut it down and it vanished" — caught .113 multiple
    # times 2026-05-16. dumpxml | define is idempotent (no-op if already
    # persistent) so it's safe to always run.
    try:
        _xml = subprocess.check_output(
            ["virsh", "dumpxml", name], text=True, stderr=subprocess.DEVNULL, timeout=5)
        subprocess.run(
            ["virsh", "define", "/dev/stdin"], input=_xml, text=True,
            check=False, capture_output=True, timeout=5)
    except Exception as e:
        await _log(f"[create-cloud] WARNING: persist-domain step failed: {e} — VM will vanish on shutdown")
    db_log_event("vm_create_cloud", name, f"{distro}/{flavor} VM created")
    await _log(f"[create-cloud] Done. Use View on '{name}' to watch boot. "
               f"Desktop install takes ~5-10 min after first boot.")
    await websocket.send(json.dumps({"type": "exec_done", "rc": 0, "target": "vm-log",
                                      "vm_created": name}))

async def _vm_delete_full(websocket, msg):
    """Full VM teardown: virsh destroy + undefine + zfs destroy zvol + rm seed.

    The legacy vm_op delete only ran `virsh undefine --nvram`, leaving the
    backing zvol and the cloud-init seed ISO behind. Operators thought the
    VM was gone but the zvol kept consuming space, and the next create with
    the same name failed with "zvol already exists". This action does the
    full teardown the UI's confirm dialog already promises ("destroys the
    VM and its ZFS zvol")."""
    import os as _os
    vm = (msg.get("vm") or "").strip()
    if not _VM_NAME_RE.match(vm):
        await websocket.send(json.dumps({"type": "error", "msg": f"invalid VM name: {vm!r}"}))
        return

    async def _log(line):
        await websocket.send(json.dumps({"type": "log_line", "line": line, "target": "vm-log"}))

    await _log(f"[delete] {vm} — force-stop + undefine + zvol destroy")

    # Force-stop (ok if already stopped) + undefine (with NVRAM so UEFI vars
    # don't linger). Both are best-effort — if the domain doesn't exist we
    # still want to clean up the zvol.
    subprocess.call(["virsh", "destroy", vm],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    rc_undef = subprocess.call(["virsh", "undefine", "--nvram", vm],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if rc_undef == 0:
        await _log(f"[delete] {vm}: libvirt domain undefined")
    else:
        await _log(f"[delete] {vm}: no libvirt domain (or undefine failed) — continuing")

    # Destroy the zvol. -r picks up any snapshots+clones we created during
    # vm_create_cloud (each spawn snaps the golden first). Without -r the
    # destroy fails when the zvol has a snapshot, which it usually does.
    zvol = f"rpool/vms/{vm}"
    rc_zfs = subprocess.call(["zfs", "destroy", "-r", zvol],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if rc_zfs == 0:
        await _log(f"[delete] {vm}: zvol {zvol} destroyed")
    else:
        await _log(f"[delete] {vm}: zvol {zvol} not present (or destroy failed)")

    # Cloud-init seed iso (best-effort cleanup of files vm_create_cloud
    # leaves behind).
    seed = f"/var/lib/libvirt/images/{vm}-seed.iso"
    if _os.path.exists(seed):
        try:
            _os.unlink(seed); await _log(f"[delete] {vm}: removed seed iso")
        except OSError as e:
            await _log(f"[delete] {vm}: failed to remove {seed}: {e}")

    db_log_event("vm_delete_full", vm, "VM + zvol + seed removed")
    await _log(f"[delete] {vm}: done")
    await websocket.send(json.dumps({"type": "exec_done", "rc": 0, "target": "vm-log"}))
    await _list_vms(websocket)


def _vm_cloud_os_variant(distro: str) -> str:
    """Best-effort os-variant for virt-install. Recent libosinfo on F44
    knows these; older boxes fall back via virt-install's auto-detect."""
    return {
        "centos": "centos-stream9",
        "rocky":  "rocky9",
        "fedora": "fedora43",
        "debian": "debian13",
        "ubuntu": "ubuntu24.04",
    }.get(distro, "linux2024")


async def _service_deploy(websocket, msg):
    """Deploy a service to target nodes via Salt highstate.
    Generates a Salt state from the service definition and pushes it."""
    svc_id = msg.get("id", "")
    svc    = db_load_service(svc_id) if svc_id else msg.get("service")
    if not svc:
        await websocket.send(json.dumps({"type": "error", "msg": "service not found"}))
        return

    name     = svc.get("name", "unknown")
    dataset  = svc.get("dataset") or f"rpool/services/{name}"
    image    = svc.get("image", "")
    runtime  = svc.get("runtime", "systemd")
    config   = svc.get("config", {})
    targets  = svc.get("node_targets", [])
    salt_tgt = " ".join(targets) if targets else "*"

    await websocket.send(json.dumps({
        "type": "log_line", "line": f"[deploy] Deploying service: {name}", "target": "svc-log"
    }))

    # Generate Salt state YAML
    salt_state = _generate_salt_state(name, dataset, image, runtime, config)

    # Write state to /srv/salt/kldload/services/<name>.sls
    state_dir  = Path(f"/srv/salt/kldload/services")
    state_file = state_dir / f"{name}.sls"
    try:
        state_dir.mkdir(parents=True, exist_ok=True)
        state_file.write_text(salt_state)
        await websocket.send(json.dumps({
            "type": "log_line", "line": f"[deploy] State written: {state_file}", "target": "svc-log"
        }))
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "log_line", "line": f"[deploy] WARNING: could not write state: {e}", "target": "svc-log"
        }))

    # Update DB: mark as deploying
    if svc_id:
        db_update_service_status(svc_id, "deploying")

    # Push via Salt — service deploys do package + config + restart, ~1-3 min.
    cmd = ["salt", salt_tgt, "state.apply", f"kldload.services.{name}",
           "--timeout=60", "--out=yaml"]
    await _stream_proc_detached(websocket, cmd, target="svc-log")

    if svc_id:
        db_update_service_status(svc_id, "running")
    db_log_event("service_deploy", svc_id or name, f"Service deployed: {name} → {salt_tgt}")
    await websocket.send(json.dumps({"type": "exec_done", "rc": 0, "target": "svc-log"}))

def _generate_salt_state(name, dataset, image, runtime, config):
    """Generate a Salt state YAML for a ZFS-backed service."""
    mountpoint = f"/srv/services/{name}"
    env_lines  = "\n".join(
        f"    - {k}={v}" for k, v in (config.get("env") or {}).items()
    )
    ports      = config.get("ports", [])
    port_lines = "\n".join(f"    - {p}" for p in ports) if ports else ""

    if runtime == "nspawn":
        svc_block = f"""
{name}-nspawn:
  nspawn.running:
    - name: {name}
    - root: {mountpoint}
    - require:
      - zfs: {dataset}
"""
    elif runtime == "podman":
        svc_block = f"""
{name}-container:
  cmd.run:
    - name: >-
        podman run -d --name {name}
        --restart=always
        -v {mountpoint}:/data
        {chr(10).join('        -e ' + l.strip('- ') for l in env_lines.splitlines()) if env_lines else ''}
        {chr(10).join('        -p ' + l.strip('- ') for l in port_lines.splitlines()) if port_lines else ''}
        {image or 'debian:trixie'}
    - unless: podman inspect {name}
    - require:
      - zfs: {dataset}
"""
    else:  # systemd / bare
        svc_block = f"""
{name}-service:
  service.running:
    - name: {name}
    - enable: True
    - require:
      - zfs: {dataset}
"""

    return f"""# Auto-generated by kldload-webui — do not edit manually
# Service: {name}  Runtime: {runtime}

# 1. Ensure ZFS dataset exists
{dataset}:
  zfs.filesystem_present:
    - properties:
        compression: lz4
        mountpoint: {mountpoint}
        com.sun:auto-snapshot: 'true'

# 2. Ensure mountpoint directory exists
{mountpoint}:
  file.directory:
    - makedirs: True
    - require:
      - zfs: {dataset}
{svc_block}
"""

# ── HTTP handler ───────────────────────────────────────────────────────────────

class WebUIHandler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(WEBUI_DIR), **kwargs)

    def log_message(self, fmt, *args):
        pass  # silence access log

    def do_GET(self):
        if self.path == "/" or self.path == "":
            self.path = "/index.html"
        # /wallpaper route + wallpaper.html removed 2026-05-19 — the
        # tactical-wallpaper / live-desktop idea was scoped out. The
        # GNOME extension that was going to mount it as the background
        # actor is dropped too (task #25). The design mockup
        # (kldload-design-mockups/index-demoscene.html) is preserved
        # outside the build as a reference for any future revival.
        # Download endpoint for klab test run bundles. Matches
        #   /download/klab/<run-id>.tar.gz
        # Builds the tarball on the fly from /root/klab/<run-id>/ so we
        # don't leave stale bundles on disk. Safe: run-id must match
        # the YYYYMMDD-HHMMSS shape — no path traversal.
        if self.path.startswith("/download/klab/"):
            import re, tarfile, io, os
            m = re.match(r"^/download/klab/(\d{8}-\d{6})\.tar\.gz$", self.path)
            if not m:
                self.send_error(400, "Invalid run id"); return
            run_id = m.group(1)
            run_dir = f"/root/klab/{run_id}"
            if not os.path.isdir(run_dir):
                self.send_error(404, f"No run {run_id}"); return
            try:
                buf = io.BytesIO()
                with tarfile.open(fileobj=buf, mode="w:gz") as tar:
                    tar.add(run_dir, arcname=f"klab-{run_id}")
                data = buf.getvalue()
            except Exception as e:
                self.send_error(500, f"tar failed: {e}"); return
            self.send_response(200)
            self.send_header("Content-Type", "application/gzip")
            self.send_header("Content-Disposition",
                             f'attachment; filename="klab-{run_id}.tar.gz"')
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
            return
        # Plain full.log download — the OpenZFS team can attach this
        # single file to a bug report without unpacking the tarball.
        if self.path.startswith("/download/klab-log/"):
            import re, os
            m = re.match(r"^/download/klab-log/(\d{8}-\d{6})\.log$", self.path)
            if not m:
                self.send_error(400, "Invalid run id"); return
            run_id = m.group(1)
            log_path = f"/root/klab/{run_id}/full.log"
            if not os.path.isfile(log_path):
                self.send_error(404, f"No log for {run_id}"); return
            try:
                with open(log_path, "rb") as f:
                    data = f.read()
            except Exception as e:
                self.send_error(500, f"read failed: {e}"); return
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Disposition",
                             f'attachment; filename="klab-{run_id}.log"')
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
            return
        super().do_GET()

# ── Main ───────────────────────────────────────────────────────────────────────

def _get_ssl_context():
    """Generate a per-host TLS cert and return an SSLContext.
    Returns None on any failure (falls back to plain HTTP).

    kldload-tls-cert writes webui.crt + webui.key to /var/lib/kldload/tls/
    and echoes the concatenated PEM blocks on stdout. The script's side
    effect is what we care about — we load straight from the on-disk
    files, which is simpler and avoids trying to split `-----BEGIN …`
    blocks out of the echo'd blob. (The previous logic tried to parse
    stdout as `key_path crt_path` which never matched — kldload-tls-cert
    prints PEM content, not paths — so every boot silently fell back to
    HTTP and the browser could not connect after caching the https URL.)
    """
    crt_dir = os.environ.get("KLDLOAD_TLS_CERT_DIR", "/var/lib/kldload/tls")
    crt_path = f"{crt_dir}/webui.crt"
    key_path = f"{crt_dir}/webui.key"
    try:
        # Invoke script to (re)generate if missing/expired. Output is
        # discarded — the script persists the cert/key to disk.
        subprocess.check_call(
            ["/usr/local/sbin/kldload-tls-cert"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(certfile=crt_path, keyfile=key_path)
        LOG.info("TLS cert loaded: %s", crt_path)
        return ctx
    except Exception as e:
        LOG.warning("TLS setup failed, falling back to plain HTTP: %s", e)
        return None

# ── Ansible handlers ──────────────────────────────────────────────────────────

ANSIBLE_LIB      = "/usr/local/share/kldload-ansible"
ANSIBLE_PB_DIR   = f"{ANSIBLE_LIB}/playbooks"
ANSIBLE_CFG_PATH = f"{ANSIBLE_LIB}/ansible.cfg"

def _ansible_env():
    """Environment that points ansible at the kldload library."""
    env = {}
    if os.path.exists(ANSIBLE_CFG_PATH):
        env["ANSIBLE_CONFIG"] = ANSIBLE_CFG_PATH
    return env

async def _ansible_status(websocket):
    ver = "(not installed)"
    try:
        out = subprocess.check_output(["ansible", "--version"], text=True,
                                      stderr=subprocess.DEVNULL, timeout=5)
        # First line looks like "ansible [core 2.16.3]"
        ver = out.splitlines()[0].strip() if out else ver
    except Exception:
        pass
    await websocket.send(json.dumps({"type": "ansible_status", "version": ver}))

USER_PB_DIR = "/var/lib/kldload/user-playbooks"

def _scan_playbooks(directory, origin):
    """Parse YAML playbooks in a directory and return a list of metadata dicts.
    `origin` tags each entry so the UI can show system vs user-uploaded."""
    import glob
    import yaml as _yaml
    out = []
    if not os.path.isdir(directory):
        return out
    for path in sorted(glob.glob(f"{directory}/*.yml") +
                       glob.glob(f"{directory}/*.yaml")):
        name = os.path.basename(path)
        hosts, tasks, desc = "—", 0, ""
        try:
            with open(path) as f:
                parsed = _yaml.safe_load(f) or []
            if isinstance(parsed, list) and parsed:
                first = parsed[0] or {}
                hosts = str(first.get("hosts", "—"))
                desc  = str(first.get("name", ""))
                tasks = sum(len((p or {}).get("tasks", []) or []) for p in parsed)
        except Exception:
            pass
        out.append({"name": name, "path": path, "origin": origin,
                    "hosts": hosts, "tasks": tasks, "description": desc})
    return out

async def _ansible_list(websocket):
    # System playbooks (shipped with the ISO) + user playbooks (uploaded via
    # the UI, stored on the encrypted playbooks dataset). Both are runnable
    # from the same selector — origin is exposed so the UI can badge them.
    playbooks = _scan_playbooks(ANSIBLE_PB_DIR, "system") \
              + _scan_playbooks(USER_PB_DIR,    "user")
    await websocket.send(json.dumps({"type": "ansible_list", "playbooks": playbooks}))

async def _ansible_run(websocket, msg):
    import json as _json
    pb       = msg.get("playbook", "")
    limit    = msg.get("limit", "localhost").strip() or "localhost"
    user     = msg.get("user", "root").strip() or "root"
    extra    = msg.get("extra_vars", {}) or {}
    check    = bool(msg.get("check", False))
    diff     = bool(msg.get("diff", False))
    verbose  = bool(msg.get("verbose", False))

    if not pb or not os.path.isfile(pb):
        await websocket.send(json.dumps({"type": "log_line", "target": "ansible_log",
                                         "line": f"ERROR: playbook not found: {pb}"}))
        await websocket.send(json.dumps({"type": "exec_done", "target": "ansible_log", "rc": 2}))
        return

    # Deployment ledger — only for kldload-shipped playbooks. User-uploaded
    # content logs an event but is not reconciled. This keeps the "infra
    # tracked, app layer open" split honest.
    is_kldload_pb = os.path.abspath(pb).startswith(ANSIBLE_LIB + "/")
    dep_id = None
    if is_kldload_pb:
        try:
            out = subprocess.check_output(
                ["kldload-db", "deploy-start",
                 "--playbook", os.path.basename(pb),
                 "--target",   limit,
                 "--extras",   _json.dumps(extra) if extra else "{}"],
                text=True, stderr=subprocess.DEVNULL, timeout=5,
            )
            dep_id = out.strip() or None
        except Exception:
            pass
    db_log_event("ansible", os.path.basename(pb),
                 f"run against {limit}",
                 {"check": check, "diff": diff, "user": user})

    # Pre-run snapshot — matches the pattern used for other state-changing ops
    await _auto_snapshot(websocket, "ansible")

    # Build the inventory argument. "localhost" → ad-hoc local inventory with
    # --connection=local so we don't need SSH into ourselves. Anything else is
    # treated as a comma-separated list (trailing comma forces list-not-file).
    cmd = ["ansible-playbook", pb, "-u", user]
    if limit == "localhost":
        cmd += ["-i", "localhost,", "--connection", "local"]
    else:
        inv = limit if limit.endswith(",") else f"{limit},"
        cmd += ["-i", inv]
        # SSH key path — kube-cluster uses /root/.ssh/id_ed25519; fall back
        # to ~/.ssh/id_rsa if present.
        for keypath in ("/root/.ssh/id_ed25519", "/root/.ssh/id_rsa"):
            if os.path.exists(keypath):
                cmd += ["--private-key", keypath]
                break
        cmd += ["-e", "ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=30'"]

    if extra:
        cmd += ["--extra-vars", _json.dumps(extra)]
    if check:   cmd += ["--check"]
    if diff:    cmd += ["--diff"]
    if verbose: cmd += ["-vv"]

    # ansible-playbook across an inventory of nodes — minutes to tens of
    # minutes. Detached so partial deploys don't get aborted by a UI reload.
    rc = await _stream_proc_detached(websocket, cmd, env=_ansible_env(), target="ansible_log")
    # Close the ledger row if we opened one
    if dep_id:
        try:
            subprocess.run(["kldload-db", "deploy-finish",
                            "--id", str(dep_id), "--rc", str(rc or 0)],
                           check=False, timeout=5)
        except Exception:
            pass


async def _playbook_upload(websocket, msg):
    """Accept a pasted/uploaded Ansible playbook. Stores to the encrypted
    playbooks dataset (if ZFS) or /var/lib/kldload/user-playbooks/ fallback.
    Validates the name + YAML before writing. Never modifies system playbooks."""
    import yaml as _yaml
    name    = (msg.get("name") or "").strip()
    content = msg.get("content") or ""

    # Sanitize: alphanum + - _ . only, must end in .yml/.yaml, no traversal.
    clean = "".join(c for c in name if c.isalnum() or c in "-_.")
    if not clean or clean.startswith(".") or "/" in name or ".." in name:
        await websocket.send(json.dumps({
            "type": "playbook_upload_result", "ok": False,
            "error": "invalid playbook name (alphanum + -._ only)"}))
        return
    if not clean.endswith((".yml", ".yaml")):
        clean += ".yml"
    if not content.strip():
        await websocket.send(json.dumps({
            "type": "playbook_upload_result", "ok": False,
            "error": "empty playbook"}))
        return
    # Parse — reject before writing if YAML is invalid or not a playbook list.
    try:
        parsed = _yaml.safe_load(content)
    except _yaml.YAMLError as e:
        await websocket.send(json.dumps({
            "type": "playbook_upload_result", "ok": False,
            "error": f"YAML parse error: {e}"}))
        return
    if not isinstance(parsed, list) or not parsed:
        await websocket.send(json.dumps({
            "type": "playbook_upload_result", "ok": False,
            "error": "playbook must be a non-empty YAML list of plays"}))
        return

    # Ensure the directory is the encrypted dataset when possible.
    _ensure_secrets_dir()  # also creates playbooks dataset via _ensure_kldload_datasets
    os.makedirs(USER_PB_DIR, exist_ok=True)
    os.chmod(USER_PB_DIR, 0o750)

    path = os.path.join(USER_PB_DIR, clean)
    tmp  = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(content)
    os.chmod(tmp, 0o640)
    os.replace(tmp, path)

    db_log_event("playbook_upload", clean, f"user playbook uploaded ({len(content)} bytes)")
    await websocket.send(json.dumps({
        "type": "playbook_upload_result", "ok": True, "name": clean, "path": path}))

async def _playbook_delete(websocket, msg):
    """Delete a USER playbook only. System playbooks under ANSIBLE_LIB are
    read-only on the ISO — attempting to delete them returns an error."""
    name = (msg.get("name") or "").strip()
    clean = "".join(c for c in name if c.isalnum() or c in "-_.")
    if not clean or clean != name or "/" in name:
        await websocket.send(json.dumps({
            "type": "playbook_delete_result", "ok": False,
            "error": "invalid name"}))
        return
    path = os.path.join(USER_PB_DIR, clean)
    if not os.path.isfile(path):
        await websocket.send(json.dumps({
            "type": "playbook_delete_result", "ok": False,
            "error": "not found (system playbooks cannot be deleted)"}))
        return
    try:
        os.unlink(path)
        db_log_event("playbook_delete", clean, "user playbook deleted")
        await websocket.send(json.dumps({
            "type": "playbook_delete_result", "ok": True, "name": clean}))
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "playbook_delete_result", "ok": False, "error": str(e)}))


async def _firstboot_status(websocket):
    """Aggregate readiness across every requested firstboot component.

    Prefers phase-ready marker files written by kldload-autodeploy
    (/var/lib/kldload/{k8s,ai,klab,all}-ready) — those are the truth. Falls
    back to probing live state when no markers exist yet (e.g. a manual run
    outside the orchestrator). Reads install-manifest.env to know what was
    REQUESTED at install time; unrequested phases count as satisfied.
    UI uses `ready` to show the green Lab Ready banner.
    """
    marker_dir = Path("/var/lib/kldload")
    current_phase = ""
    try:
        pf = marker_dir / "current-phase"
        if pf.exists():
            current_phase = pf.read_text().strip()
    except Exception:
        pass
    manifest = {}
    mf = Path("/etc/kldload/install-manifest.env")
    if mf.exists():
        try:
            for line in mf.read_text().splitlines():
                if "=" in line and not line.strip().startswith("#"):
                    k, _, v = line.partition("=")
                    manifest[k.strip()] = v.strip().strip('"').strip("'")
        except Exception:
            pass

    def _bool(name, default="0"):
        return manifest.get(name, default) in ("1", "yes", "true", "True")

    components = {}

    # Phase-ready markers (written by kldload-autodeploy) short-circuit the
    # live probe. If the marker is there, the phase is ready — don't re-check.
    def _marker(name):
        return (marker_dir / f"{name}-ready").exists()

    # ── klab goldens — expected when the template builds them ────────────
    # 1.1.0+: template-driven. kvm/klab/zfslab build goldens; k8s does not.
    # KLDLOAD_PROFILE collapses all four workload tiles to "kvm", so the
    # legacy check on PROFILE in (devops, klab) was wrong — we look at
    # KLDLOAD_TEMPLATE instead. Legacy fallback for 1.0.x manifests still
    # honors KLDLOAD_KLAB_ZFS_DEV.
    klab_expected = _bool("KLDLOAD_KLAB_ZFS_DEV") or \
                    manifest.get("KLDLOAD_TEMPLATE") in ("kvm", "klab", "zfslab", "devops", "ai")
    if klab_expected and _marker("klab"):
        components["klab_goldens"] = {"expected": True, "ready": True,
                                      "detail": "autodeploy marked klab ready"}
    elif klab_expected:
        try:
            out = subprocess.check_output(
                ["zfs", "list", "-H", "-t", "snapshot", "-o", "name"],
                text=True, stderr=subprocess.DEVNULL, timeout=5)
            goldens = [l for l in out.splitlines() if l.endswith("@golden")
                       and "klab-golden-" in l]
            # RHEL is optional (needs creds). Mandatory 5 is the baseline.
            done = sum(1 for g in ("centos","rocky","fedora","debian","ubuntu")
                       if any(f"klab-golden-{g}@golden" in x for x in goldens))
            components["klab_goldens"] = {
                "expected": True, "ready": done >= 5,
                "detail": f"{done}/5 mandatory goldens + {max(0, len(goldens)-done)} optional",
            }
        except Exception:
            components["klab_goldens"] = {"expected": True, "ready": False,
                                          "detail": "zfs list failed"}
    else:
        components["klab_goldens"] = {"expected": False, "ready": True, "detail": "not requested"}

    # ── klab ztest goldens — expected if ZFS Lab mode is on ──────────────
    # This is the PHASE that used to get missed: the installer UI flipped
    # to "finished" after the 5 blue-green @golden snapshots landed, even
    # though autodeploy was still running `klab golden-ztest all` in the
    # background for another ~60 min. Users kept asking "where are my ZFS
    # test goldens?" because the UI told them the install was done. Now
    # ztest is its own gate: all-ready waits until every requested ztest
    # golden has a @golden snapshot.
    ztest_expected = _bool("KLDLOAD_KLAB_ZFS_DEV") or _bool("KLDLOAD_ZFSLAB_MODE") \
                     or manifest.get("KLDLOAD_TEMPLATE") == "zfslab"
    if ztest_expected and _marker("klab-ztest"):
        components["klab_ztest"] = {"expected": True, "ready": True,
                                    "detail": "autodeploy marked klab-ztest ready"}
    elif ztest_expected:
        try:
            out = subprocess.check_output(
                ["zfs", "list", "-H", "-t", "snapshot", "-o", "name"],
                text=True, stderr=subprocess.DEVNULL, timeout=5)
            ztest_goldens = [l for l in out.splitlines() if l.endswith("@golden")
                             and "klab-ztest-" in l]
            done = sum(1 for g in ("centos","rocky","fedora","debian","ubuntu")
                       if any(f"klab-ztest-{g}@golden" in x for x in ztest_goldens))
            components["klab_ztest"] = {
                "expected": True, "ready": done >= 5,
                "detail": f"{done}/5 ZFS-test goldens ready (~12 min each while building)",
            }
        except Exception:
            components["klab_ztest"] = {"expected": True, "ready": False,
                                        "detail": "zfs list failed"}
    else:
        components["klab_ztest"] = {"expected": False, "ready": True, "detail": "not requested"}

    # ── Kubernetes cluster — expected if template runs a cluster ─────────
    # 1.1.0+: k8s/klab/zfslab templates all bootstrap a cluster. Legacy
    # K8S_BOOTSTRAP/ENABLE_K8S still honored for kickstart flows.
    k8s_expected = _bool("KLDLOAD_K8S_BOOTSTRAP") or _bool("KLDLOAD_ENABLE_K8S") \
                   or manifest.get("KLDLOAD_TEMPLATE") in ("k8s", "klab", "zfslab", "devops", "ai")
    if k8s_expected and _marker("k8s"):
        components["kubernetes"] = {"expected": True, "ready": True,
                                    "detail": "autodeploy marked k8s ready"}
    elif k8s_expected:
        try:
            out = subprocess.check_output(
                ["kubectl", "get", "nodes",
                 "-o=jsonpath={range .items[*]}{.status.conditions[?(@.type=='Ready')].status} "],
                text=True, stderr=subprocess.DEVNULL, timeout=10)
            nodes = out.split()
            ready = nodes.count("True")
            total = len(nodes)
            components["kubernetes"] = {
                "expected": True, "ready": total >= 1 and ready == total,
                "detail": f"{ready}/{total} nodes Ready" if total else "no cluster yet",
            }
        except Exception:
            components["kubernetes"] = {"expected": True, "ready": False,
                                        "detail": "kubectl not reachable"}
    else:
        components["kubernetes"] = {"expected": False, "ready": True, "detail": "not requested"}

    # ── AI / Ollama — expected if ENABLE_AI=1 ────────────────────────────
    # "Ready" means a model is LOADED into VRAM/RAM, not just pulled. /api/ps
    # lists running models; /api/tags only lists installed weights. A pulled
    # but unloaded model takes 30s on first chat — that's what made Bob look
    # "online but laggy". We now report ready only once /api/ps has a model.
    ai_expected = _bool("KLDLOAD_ENABLE_AI")
    if ai_expected and _marker("ai"):
        components["ai"] = {"expected": True, "ready": True,
                            "detail": "autodeploy marked ai ready"}
    elif ai_expected:
        try:
            import urllib.request
            r_ps = urllib.request.urlopen("http://127.0.0.1:11434/api/ps", timeout=3)
            loaded = json.loads(r_ps.read()).get("models", [])
            if loaded:
                components["ai"] = {"expected": True, "ready": True,
                                    "detail": f"{loaded[0]['name']} loaded (warm)"}
            else:
                # Fall back: pulled but not loaded
                r_t = urllib.request.urlopen("http://127.0.0.1:11434/api/tags", timeout=3)
                tags = json.loads(r_t.read()).get("models", [])
                components["ai"] = {
                    "expected": True, "ready": False,
                    "detail": (f"{len(tags)} model(s) pulled, none loaded — first chat will take ~30s"
                               if tags else "Ollama up, no models yet"),
                }
        except Exception:
            components["ai"] = {"expected": True, "ready": False,
                                "detail": "Ollama not reachable"}
    else:
        components["ai"] = {"expected": False, "ready": True, "detail": "not requested"}

    # Overall = every *expected* component is ready
    all_ready = all(c["ready"] for c in components.values() if c["expected"])
    any_expected = any(c["expected"] for c in components.values())

    await websocket.send(json.dumps({
        "type": "firstboot_status",
        "ready": bool(all_ready and any_expected) or _marker("all"),
        "current_phase": current_phase,
        "autodeploy_running": current_phase not in ("", "ready", "partial"),
        "components": components,
    }))


async def _kube_bootstrap_tail(websocket, follow=True):
    """Stream (or replay the tail of) /var/log/kldload/kube-bootstrap.log to
    the K8s log panel. Used after a page refresh so the user can see what's
    currently happening even though the in-memory WS log box cleared."""
    log_path = "/var/log/kldload/kube-bootstrap.log"
    import re as _re
    ansi = _re.compile(r"\x1b\[[0-9;]*[mGKHF]")
    target = "k8s"
    if not os.path.exists(log_path):
        await websocket.send(json.dumps({
            "type": "log_line", "target": target,
            "line": "[no kube-bootstrap.log yet — nothing running]",
        }))
        return
    # Send last 200 lines of existing content so the user sees history
    try:
        with open(log_path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            chunk = 64 * 1024
            f.seek(max(0, size - chunk))
            tail = f.read().decode(errors="replace")
            for line in tail.splitlines()[-200:]:
                await websocket.send(json.dumps({
                    "type": "log_line", "target": target,
                    "line": ansi.sub("", line),
                }))
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "log_line", "target": target, "line": f"[tail error: {e}]",
        }))
        return
    if not follow:
        return
    # Follow mode: poll for new lines until the process exits.
    # Only follow if kube-cluster bootstrap is actually running.
    async def _is_running():
        try:
            subprocess.check_call(["pgrep", "-f", "kube-cluster bootstrap"],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
        except Exception:
            return False
    if not await _is_running():
        await websocket.send(json.dumps({
            "type": "log_line", "target": target,
            "line": "[bootstrap process has exited — tail above is the final state]",
        }))
        return
    try:
        with open(log_path, "r", errors="replace") as f:
            f.seek(0, 2)  # end
            for _ in range(600):  # 10 min cap per follow request
                line = f.readline()
                if line:
                    await websocket.send(json.dumps({
                        "type": "log_line", "target": target,
                        "line": ansi.sub("", line.rstrip()),
                    }))
                else:
                    if not await _is_running():
                        break
                    await asyncio.sleep(1)
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "log_line", "target": target, "line": f"[follow error: {e}]",
        }))


async def _doctor_run(websocket):
    """Run kldload-doctor and stream the JSON back. Takes ~1-2s with checks
    timing out at 5-10s each worst-case, so we fire-and-wait."""
    try:
        loop = asyncio.get_event_loop()
        def _sync():
            p = subprocess.run(["kldload-doctor"], capture_output=True,
                               text=True, timeout=30)
            try:    return json.loads(p.stdout)
            except Exception: return {"error": p.stderr or "doctor failed",
                                      "results": []}
        data = await loop.run_in_executor(None, _sync)
        await websocket.send(json.dumps({"type": "doctor_report", **data}))
    except Exception as e:
        await websocket.send(json.dumps({"type": "doctor_report",
                                         "error": str(e), "results": []}))


async def _deploy_list(websocket, limit=50):
    """Return the deployment ledger — kldload-shipped playbook runs only."""
    rows = []
    try:
        con = _db_connect()
        cur = con.execute(
            "SELECT d.id, d.cluster_id, d.target, d.playbook, d.extras, d.status, "
            "d.rc, d.started_at, d.finished_at, c.name AS cluster_name "
            "FROM deployments d LEFT JOIN clusters c ON c.id = d.cluster_id "
            "ORDER BY d.id DESC LIMIT ?", (int(limit),)
        )
        for r in cur.fetchall():
            d = dict(r)
            try: d["extras"] = json.loads(d.get("extras") or "{}")
            except Exception: d["extras"] = {}
            rows.append(d)
        con.close()
    except Exception:
        pass
    await websocket.send(json.dumps({"type": "deploy_list", "deployments": rows}))


# ── Helm handlers ─────────────────────────────────────────────────────────────

def _helm_env():
    """Prefer the kube-cluster admin kubeconfig when present."""
    env = {}
    for kc in ("/root/.kube/config", "/etc/kubernetes/admin.conf"):
        if os.path.exists(kc):
            env["KUBECONFIG"] = kc
            break
    return env

async def _helm_status(websocket):
    ver = "(not installed)"
    try:
        out = subprocess.check_output(["helm", "version", "--short"], text=True,
                                      stderr=subprocess.DEVNULL, timeout=5)
        ver = out.strip()
    except Exception:
        pass
    await websocket.send(json.dumps({"type": "helm_status", "version": ver}))

async def _helm_repo_list(websocket):
    repos = []
    try:
        out = subprocess.check_output(["helm", "repo", "list", "-o", "json"],
                                      text=True, stderr=subprocess.DEVNULL, timeout=10,
                                      env={**os.environ, **_helm_env()})
        data = json.loads(out) if out.strip() else []
        for r in data:
            repos.append({"name": r.get("name", ""), "url": r.get("url", "")})
    except subprocess.CalledProcessError:
        pass  # "Error: no repositories to show" — treated as empty list
    except Exception:
        pass
    await websocket.send(json.dumps({"type": "helm_repo_list", "repos": repos}))

async def _helm_repo_add(websocket, msg):
    name = (msg.get("name") or "").strip()
    url  = (msg.get("url") or "").strip()
    if not name or not url:
        return
    await _stream_proc(websocket,
                       ["helm", "repo", "add", name, url, "--force-update"],
                       env=_helm_env(), target="helm_log")

async def _helm_repo_remove(websocket, msg):
    name = (msg.get("name") or "").strip()
    if not name: return
    await _stream_proc(websocket, ["helm", "repo", "remove", name],
                       env=_helm_env(), target="helm_log")

async def _helm_list(websocket):
    releases = []
    try:
        out = subprocess.check_output(["helm", "list", "-A", "-o", "json"],
                                      text=True, stderr=subprocess.DEVNULL, timeout=15,
                                      env={**os.environ, **_helm_env()})
        data = json.loads(out) if out.strip() else []
        for r in data:
            releases.append({
                "name":        r.get("name", ""),
                "namespace":   r.get("namespace", ""),
                "chart":       r.get("chart", ""),
                "app_version": r.get("app_version", ""),
                "status":      r.get("status", ""),
                "updated":     (r.get("updated", "") or "")[:19],
            })
    except Exception:
        pass
    await websocket.send(json.dumps({"type": "helm_list", "releases": releases}))

async def _helm_install(websocket, msg, upgrade=False):
    import tempfile
    name    = (msg.get("name") or "").strip()
    chart   = (msg.get("chart") or "").strip()
    version = (msg.get("version") or "").strip()
    ns      = (msg.get("namespace") or "default").strip()
    values  = msg.get("values") or ""
    create  = bool(msg.get("create_namespace", True))
    waitfor = bool(msg.get("wait", False))
    db_log_event("helm", name,
                 f"{'upgrade' if upgrade else 'install'} chart={chart} ns={ns}",
                 {"version": version, "chart": chart, "namespace": ns})

    if not name or not chart:
        await websocket.send(json.dumps({"type": "log_line", "target": "helm_log",
                                         "line": "ERROR: release name and chart are required"}))
        await websocket.send(json.dumps({"type": "exec_done", "target": "helm_log", "rc": 2}))
        return

    if upgrade:
        cmd = ["helm", "upgrade", "--install", name, chart]
    else:
        cmd = ["helm", "install", name, chart]
    cmd += ["--namespace", ns]
    if create:  cmd += ["--create-namespace"]
    if version: cmd += ["--version", version]
    if waitfor: cmd += ["--wait", "--timeout", "10m"]

    vf = None
    if values.strip():
        vf = tempfile.NamedTemporaryFile(mode="w", suffix=".yaml", delete=False)
        vf.write(values)
        vf.flush()
        vf.close()
        cmd += ["-f", vf.name]
    try:
        # Helm install with --wait can sit for 10 min waiting for pods to
        # become ready; even without --wait, image pulls + chart hooks add
        # up. Detached so a UI reload doesn't orphan a partial release.
        await _stream_proc_detached(websocket, cmd, env=_helm_env(), target="helm_log")
    finally:
        if vf and os.path.exists(vf.name):
            try: os.unlink(vf.name)
            except Exception: pass

async def _helm_uninstall(websocket, msg):
    name = (msg.get("name") or "").strip()
    ns   = (msg.get("namespace") or "default").strip()
    if not name: return
    db_log_event("helm", name, f"uninstall ns={ns}", {"namespace": ns})
    # Uninstall walks finalizers + termination grace periods — minutes.
    await _stream_proc_detached(websocket,
                                ["helm", "uninstall", name, "--namespace", ns],
                                env=_helm_env(), target="helm_log")

async def _helm_release_status(websocket, msg):
    name = (msg.get("name") or "").strip()
    ns   = (msg.get("namespace") or "default").strip()
    if not name: return
    await _stream_proc(websocket,
                       ["helm", "status", name, "--namespace", ns],
                       env=_helm_env(), target="helm_log")


# ── K8s extended handlers ─────────────────────────────────────────────────────

async def _k8s_status(websocket):
    """Return K8s cluster status: nodes, API server, version."""
    data = {"node_count": 0, "ready_count": 0, "api_server": "—", "version": "—", "nodes": []}
    try:
        # Check if kubectl is available
        out = subprocess.check_output(
            ["kubectl", "get", "nodes", "-o", "wide", "--no-headers"],
            text=True, stderr=subprocess.DEVNULL, timeout=10)
        nodes = []
        for line in out.strip().splitlines():
            parts = line.split()
            if len(parts) >= 6:
                nodes.append({
                    "name": parts[0],
                    "status": parts[1],
                    "role": parts[2] if parts[2] != "<none>" else "worker",
                    "age": parts[3],
                    "version": parts[4],
                    "ip": parts[5] if len(parts) > 5 else "",
                })
        data["nodes"] = nodes
        data["node_count"] = len(nodes)
        data["ready_count"] = sum(1 for n in nodes if "Ready" in n["status"])
    except Exception:
        pass

    # Enrich nodes with labels + taints from JSON. Keeps the existing
    # text-parsed structure intact (no risk of breaking field offsets)
    # and just merges {labels, taints} onto each node by name. One extra
    # ~10 KB/node kubectl call per status refresh — cheap.
    try:
        json_out = subprocess.check_output(
            ["kubectl", "get", "nodes", "-o", "json"],
            text=True, stderr=subprocess.DEVNULL, timeout=10,
            env={**os.environ, "KUBECONFIG": "/root/.kube/config"},
        )
        items = json.loads(json_out).get("items", [])
        by_name = {n["name"]: n for n in data["nodes"]}
        for item in items:
            nm = item.get("metadata", {}).get("name", "")
            if nm in by_name:
                by_name[nm]["labels"] = item.get("metadata", {}).get("labels", {}) or {}
                by_name[nm]["taints"] = item.get("spec", {}).get("taints", []) or []
    except Exception:
        pass

    try:
        ver = subprocess.check_output(
            ["kubectl", "version", "--short", "--client=false"],
            text=True, stderr=subprocess.DEVNULL, timeout=5)
        for line in ver.strip().splitlines():
            if "Server" in line:
                data["version"] = line.split(":")[-1].strip()
    except Exception:
        pass

    try:
        api = subprocess.check_output(
            ["kubectl", "cluster-info"],
            text=True, stderr=subprocess.DEVNULL, timeout=5)
        for line in api.splitlines():
            if "control plane" in line.lower() or "master" in line.lower():
                import re as _re
                m = _re.search(r'https?://[\d.:]+', line)
                if m:
                    data["api_server"] = m.group(0)
    except Exception:
        pass

    await websocket.send(json.dumps({"type": "k8s_status", **data}))


async def _k8s_pods(websocket):
    """Return pod list from kubectl."""
    pods = []
    try:
        out = subprocess.check_output(
            ["kubectl", "get", "pods", "-A", "--no-headers"],
            text=True, stderr=subprocess.DEVNULL, timeout=10)
        for line in out.strip().splitlines():
            parts = line.split()
            if len(parts) >= 5:
                pods.append({
                    "namespace": parts[0],
                    "name": parts[1],
                    "ready": parts[2],
                    "status": parts[3],
                    "restarts": parts[4],
                    "age": parts[5] if len(parts) > 5 else "",
                })
    except Exception:
        pass
    await websocket.send(json.dumps({"type": "k8s_pods", "pods": pods}))


async def _k8s_inspect(websocket, msg):
    """Return hover/click detail for a node or pod: describe + events + (for
    pods) recent logs and container summary, (for nodes) top pods by CPU.
    Feeds the inline detail drawer the UI expands under each row."""
    kind = msg.get("kind", "pod")  # node | pod
    name = msg.get("name", "")
    namespace = msg.get("namespace", "")
    if not name:
        await websocket.send(json.dumps({"type": "k8s_inspect", "error": "missing name"}))
        return

    env = {**os.environ, "KUBECONFIG": "/root/.kube/config", "HOME": "/root"}
    def _run(cmd, timeout=8):
        try:
            return subprocess.check_output(cmd, text=True, stderr=subprocess.STDOUT,
                                           timeout=timeout, env=env)
        except subprocess.CalledProcessError as e:
            return (e.output or "")[:4000]
        except Exception as e:
            return f"(error: {e})"

    result = {"type": "k8s_inspect", "kind": kind, "name": name, "namespace": namespace}

    if kind == "node":
        # Metrics from metrics-server — gracefully degrade if not installed.
        top = _run(["kubectl", "top", "node", name, "--no-headers"], timeout=5)
        result["top"] = top.strip()
        # Events for this node (last few).
        ev = _run(["kubectl", "get", "events", "--all-namespaces",
                   "--field-selector", f"involvedObject.name={name},involvedObject.kind=Node",
                   "--sort-by=.lastTimestamp", "--no-headers"], timeout=5)
        result["events"] = ev.strip().splitlines()[-15:]
        # Pods currently on this node — most useful hover info.
        pods = _run(["kubectl", "get", "pods", "-A", "--field-selector",
                     f"spec.nodeName={name}", "--no-headers", "-o",
                     "custom-columns=NS:.metadata.namespace,NAME:.metadata.name,STATUS:.status.phase"],
                    timeout=5)
        result["pods_on_node"] = pods.strip().splitlines()[:30]
        # Capacity summary from the node object.
        cap = _run(["kubectl", "get", "node", name, "-o",
                    "jsonpath={.status.capacity.cpu}|{.status.capacity.memory}|"
                    "{.status.allocatable.cpu}|{.status.allocatable.memory}"], timeout=4)
        result["capacity"] = cap.strip()
    else:
        ns_args = ["-n", namespace] if namespace else []
        # Container status + images in one quick jsonpath.
        c = _run(["kubectl", "get", "pod", name, *ns_args, "-o",
                  "jsonpath={range .status.containerStatuses[*]}{.name} "
                  "{.image} ready={.ready} restarts={.restartCount}\\n{end}"],
                 timeout=5)
        result["containers"] = c.strip().splitlines()
        # Pod-level IP, node, QoS.
        meta = _run(["kubectl", "get", "pod", name, *ns_args, "-o",
                     "jsonpath={.status.podIP}|{.spec.nodeName}|{.status.qosClass}"],
                    timeout=4)
        result["meta"] = meta.strip()
        # Events on this pod (namespace-scoped).
        ev = _run(["kubectl", "get", "events", *ns_args,
                   "--field-selector", f"involvedObject.name={name}",
                   "--sort-by=.lastTimestamp", "--no-headers"], timeout=5)
        result["events"] = ev.strip().splitlines()[-15:]
        # Log tail — best-effort, first container only. Keep small.
        logs = _run(["kubectl", "logs", name, *ns_args, "--tail=40",
                     "--all-containers=true", "--prefix=true"], timeout=6)
        result["logs"] = logs[-6000:] if logs else ""
        # Metrics for this specific pod.
        top = _run(["kubectl", "top", "pod", name, *ns_args, "--no-headers"], timeout=5)
        result["top"] = top.strip()

    await websocket.send(json.dumps(result))


async def _k8s_namespaces(websocket):
    """Return namespaces so the UI can populate a filter dropdown."""
    env = {**os.environ, "KUBECONFIG": "/root/.kube/config", "HOME": "/root"}
    try:
        out = subprocess.check_output(
            ["kubectl", "get", "namespaces", "-o", "jsonpath={.items[*].metadata.name}"],
            text=True, stderr=subprocess.DEVNULL, timeout=5, env=env)
        ns = sorted(out.split())
    except Exception:
        ns = []
    await websocket.send(json.dumps({"type": "k8s_namespaces", "namespaces": ns}))


async def _k8s_deployments(websocket, msg):
    """List deployments with ready / available / age / image for the
    Deployments panel. Namespace filter supported."""
    env = {**os.environ, "KUBECONFIG": "/root/.kube/config", "HOME": "/root"}
    ns = msg.get("namespace", "")
    cmd = ["kubectl", "get", "deployments"]
    if ns and ns != "all":
        cmd.extend(["-n", ns])
    else:
        cmd.append("-A")
    cmd.extend(["--no-headers", "-o",
                "custom-columns=NS:.metadata.namespace,NAME:.metadata.name,"
                "READY:.status.readyReplicas,DESIRED:.spec.replicas,"
                "AVAILABLE:.status.availableReplicas,AGE:.metadata.creationTimestamp,"
                "IMAGE:.spec.template.spec.containers[0].image"])
    deploys = []
    try:
        out = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL,
                                      timeout=8, env=env)
        for line in out.strip().splitlines():
            parts = line.split(None, 6)
            if len(parts) >= 7:
                deploys.append({"namespace": parts[0], "name": parts[1],
                                "ready": parts[2], "desired": parts[3],
                                "available": parts[4], "age": parts[5],
                                "image": parts[6]})
    except Exception:
        pass
    await websocket.send(json.dumps({"type": "k8s_deployments", "deployments": deploys}))


async def _k8s_services(websocket, msg):
    """List services with cluster-ip / external-ip / ports for the
    Services panel. Important for spotting LoadBalancer + NodePort state."""
    env = {**os.environ, "KUBECONFIG": "/root/.kube/config", "HOME": "/root"}
    ns = msg.get("namespace", "")
    cmd = ["kubectl", "get", "svc", "--no-headers"]
    if ns and ns != "all":
        cmd.extend(["-n", ns])
    else:
        cmd.append("-A")
    svcs = []
    try:
        out = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL,
                                      timeout=8, env=env)
        for line in out.strip().splitlines():
            parts = line.split()
            # -A layout: NS NAME TYPE CLUSTER-IP EXTERNAL-IP PORT(S) AGE
            if len(parts) >= 7:
                svcs.append({"namespace": parts[0], "name": parts[1], "type": parts[2],
                             "cluster_ip": parts[3], "external_ip": parts[4],
                             "ports": parts[5], "age": parts[6]})
            # -n <ns> layout (6 cols — no namespace column): NAME TYPE CLUSTER-IP EXTERNAL-IP PORT(S) AGE
            elif len(parts) >= 6 and ns and ns != "all":
                svcs.append({"namespace": ns, "name": parts[0], "type": parts[1],
                             "cluster_ip": parts[2], "external_ip": parts[3],
                             "ports": parts[4], "age": parts[5]})
    except Exception:
        pass
    await websocket.send(json.dumps({"type": "k8s_services", "services": svcs}))


async def _k8s_scale(websocket, msg):
    """Scale a deployment. Streams the scale output + a status refresh."""
    ns = msg.get("namespace", "")
    name = msg.get("name", "")
    replicas = int(msg.get("replicas", 1))
    if not ns or not name:
        await websocket.send(json.dumps({"type": "error", "msg": "namespace+name required"}))
        return
    await _stream_proc(websocket,
        ["kubectl", "-n", ns, "scale", f"deploy/{name}", f"--replicas={replicas}"],
        target="k8s")
    await _k8s_deployments(websocket, {"namespace": ns})


