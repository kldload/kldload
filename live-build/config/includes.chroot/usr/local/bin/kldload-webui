async def _k8s_delete_pod(websocket, msg):
    """Delete a single pod — useful for force-restarting a stuck pod. The
    Deployment/DS/RS will recreate it; we don't force --grace-period=0
    unless the user says so (force is in the bulk action)."""
    ns = msg.get("namespace", "")
    name = msg.get("name", "")
    force = bool(msg.get("force"))
    if not ns or not name:
        await websocket.send(json.dumps({"type": "error", "msg": "namespace+name required"}))
        return
    cmd = ["kubectl", "-n", ns, "delete", "pod", name]
    if force:
        cmd.extend(["--grace-period=0", "--force"])
    await _stream_proc(websocket, cmd, target="k8s")


async def _k8s_delete_deployment(websocket, msg):
    """Delete a deployment — destructive, logged, no silent success."""
    ns = msg.get("namespace", "")
    name = msg.get("name", "")
    if not ns or not name:
        await websocket.send(json.dumps({"type": "error", "msg": "namespace+name required"}))
        return
    await _stream_proc(websocket,
        ["kubectl", "-n", ns, "delete", "deploy", name],
        target="k8s")
    await _k8s_deployments(websocket, {"namespace": ns})


async def _k8s_apply_yaml(websocket, msg):
    """Apply a YAML blob. We write it to a temp file and kubectl apply -f,
    streaming the result. This is the most-requested "deploy something
    quickly" escape hatch.

    Quirks handled:
      1. **Auto-dedent**: pastes from markdown / docs nearly always arrive
         with a uniform leading-whitespace gutter that makes the entire
         document a single invalid scalar. We compute the minimum indent
         across non-blank lines and strip it from every line. This is
         the same trick textwrap.dedent uses; reimplementing rather than
         importing because some lines are `---` separators that need to
         hit column zero specifically.
      2. **Error surfacing**: previously `kubectl apply` failures were
         logged to the k8s stream but appeared identical to silence in
         the user's eye. We now echo the kubectl exit-code+stderr summary
         as an `error` message too so the user gets a clear toast.
    """
    yaml_text = msg.get("yaml", "")
    if not yaml_text.strip():
        await websocket.send(json.dumps({"type": "error", "msg": "empty YAML"}))
        return

    # Dedent: find the minimum leading-whitespace of non-blank lines and
    # strip it from every line. Idempotent on already-flush YAML.
    lines = yaml_text.splitlines()
    non_blank = [ln for ln in lines if ln.strip()]
    if non_blank:
        min_indent = min(len(ln) - len(ln.lstrip(" \t")) for ln in non_blank)
        if min_indent > 0:
            lines = [ln[min_indent:] if len(ln) >= min_indent else ln for ln in lines]
            yaml_text = "\n".join(lines) + ("\n" if not yaml_text.endswith("\n") else "")
            await websocket.send(json.dumps({"type": "k8s_log",
                "line": f"[apply-yaml] auto-stripped {min_indent} spaces of leading indent"}))

    import tempfile
    with tempfile.NamedTemporaryFile("w", suffix=".yaml", delete=False) as f:
        f.write(yaml_text)
        path = f.name
    try:
        # Run kubectl apply and capture full output, including stderr, so
        # we can surface failures to the UI in addition to streaming them.
        proc = await asyncio.create_subprocess_exec(
            "kubectl", "apply", "-f", path,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.STDOUT,
        )
        out_bytes, _ = await proc.communicate()
        out = (out_bytes or b"").decode("utf-8", errors="replace")
        # Stream the full output as k8s_log lines (mirrors the old _stream_proc behaviour)
        for line in out.splitlines():
            await websocket.send(json.dumps({"type": "k8s_log", "line": line}))
        rc = proc.returncode or 0
        if rc != 0:
            # Pull the most actionable error line for the toast — kubectl
            # typically prints "error: <thing>" or "Error from server (X): Y".
            err_line = next((ln for ln in out.splitlines()[::-1]
                             if ln.strip() and ("error" in ln.lower() or "invalid" in ln.lower())),
                            out.splitlines()[-1] if out.splitlines() else "kubectl apply failed")
            await websocket.send(json.dumps({"type": "error",
                "msg": f"apply failed (rc={rc}): {err_line[:240]}"}))
        else:
            await websocket.send(json.dumps({"type": "k8s_log",
                "line": "[apply-yaml] kubectl apply completed (rc=0)"}))
        await websocket.send(json.dumps({"type": "exec_done", "rc": rc, "target": "k8s"}))
    finally:
        try: os.unlink(path)
        except Exception: pass


async def _k8s_bulk(websocket, msg):
    """Apply a single action to a list of targets. The UI sends the
    selection from a multi-select table; we loop kubectl serially so
    errors on one item don't kill the batch. Supported ops:
      drain, uncordon, cordon      — node targets
      delete_pod, restart_pod      — pod targets (restart via delete,
                                      deployment/ds recreates it)"""
    op = msg.get("op", "")
    targets = msg.get("targets", [])   # list of {name, namespace?}
    if not op or not targets:
        await websocket.send(json.dumps({"type": "error", "msg": "op+targets required"}))
        return
    env = {**os.environ, "KUBECONFIG": "/root/.kube/config", "HOME": "/root"}
    await websocket.send(json.dumps({"type": "k8s_log", "line":
        f"[bulk {op}] starting on {len(targets)} target(s)..."}))
    for t in targets:
        name = t.get("name", "")
        ns   = t.get("namespace", "")
        if not name:
            continue
        if op == "drain":
            cmd = ["kubectl", "drain", name, "--ignore-daemonsets",
                   "--delete-emptydir-data", "--force", "--timeout=120s"]
        elif op == "uncordon":
            cmd = ["kubectl", "uncordon", name]
        elif op == "cordon":
            cmd = ["kubectl", "cordon", name]
        elif op == "delete_node":
            # Full teardown: kube-demo remove_nodes handles drain, delete
            # from cluster, virsh destroy+undefine, zfs destroy, cloud-init
            # ISO cleanup, state.db row removal, /etc/hosts cleanup.
            # KUBE_DEMO_PAUSE=0 suppresses the y/N confirm — the UI already
            # confirmed when the user clicked Delete.
            cmd = ["kube-demo", "remove_nodes", name]
            env = {**env, "KUBE_DEMO_PAUSE": "0"}
        elif op in ("delete_pod", "restart_pod"):
            if not ns:
                continue
            cmd = ["kubectl", "-n", ns, "delete", "pod", name]
        else:
            await websocket.send(json.dumps({"type": "k8s_log", "line":
                f"[bulk] unknown op '{op}'"}))
            return
        try:
            out = subprocess.check_output(cmd, text=True,
                                          stderr=subprocess.STDOUT, timeout=150, env=env)
            await websocket.send(json.dumps({"type": "k8s_log",
                "line": f"[{op} {name}] {out.strip()[:300]}"}))
        except subprocess.CalledProcessError as e:
            await websocket.send(json.dumps({"type": "k8s_log",
                "line": f"[{op} {name}] FAILED: {(e.output or str(e))[:300]}"}))
        except Exception as e:
            await websocket.send(json.dumps({"type": "k8s_log",
                "line": f"[{op} {name}] ERROR: {e}"}))
    await websocket.send(json.dumps({"type": "k8s_log", "line":
        f"[bulk {op}] complete"}))
    await _k8s_status(websocket)


async def _k8s_run_demo(websocket, msg):
    """Run a named demo from kube-demo / kvm-demo / kzfs-lab. The 'script'
    arg picks which demo script (kube-demo | kvm-demo | kzfs-lab), 'name'
    is the CLI arg we pass to it. Output streams to the k8s log target so
    users see it live in the log panel."""
    script = msg.get("script", "kube-demo")
    demo   = msg.get("name", "")
    if not demo:
        await websocket.send(json.dumps({"type": "error", "msg": "demo name required"}))
        return
    # kube-cluster takes a sub-command + optional integer arg ("scale 3");
    # split on whitespace so each token becomes its own argv entry.
    # Other scripts take a single demo-name arg.
    if script not in ("kube-demo", "kvm-demo", "kzfs-lab", "kube-cluster"):
        await websocket.send(json.dumps({"type": "error", "msg": "unknown script"}))
        return
    argv = [script] + demo.split()
    # Demos vary wildly — kube-demo workloads can be 30s, kube-cluster scale
    # is 5-20 min. Default to detached so the worst case is covered.
    await _stream_proc_detached(websocket, argv, target="k8s")


async def _k8s_top(websocket):
    """Whole-cluster metrics snapshot — nodes and namespaces. Used to
    decorate the node/pod tables with CPU% / Memory% without needing to
    click each row. metrics-server must be installed; returns empty if not."""
    env = {**os.environ, "KUBECONFIG": "/root/.kube/config", "HOME": "/root"}
    def _run(cmd):
        try:
            return subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL,
                                           timeout=5, env=env)
        except Exception:
            return ""

    nodes = {}
    for line in _run(["kubectl", "top", "node", "--no-headers"]).strip().splitlines():
        parts = line.split()
        if len(parts) >= 5:
            nodes[parts[0]] = {"cpu": parts[1], "cpu_pct": parts[2],
                               "mem": parts[3], "mem_pct": parts[4]}
    pods = {}
    for line in _run(["kubectl", "top", "pod", "-A", "--no-headers"]).strip().splitlines():
        parts = line.split()
        if len(parts) >= 4:
            pods[f"{parts[0]}/{parts[1]}"] = {"cpu": parts[2], "mem": parts[3]}
    await websocket.send(json.dumps({"type": "k8s_top", "nodes": nodes, "pods": pods}))


async def _k8s_bootstrap(websocket, msg):
    """Bootstrap K8s cluster via kube-cluster — or scale-up if already
    bootstrapped. Detection: if `kldload-cp` VM exists, the cluster is
    already there and bootstrap would no-op (or fail). Route to scale
    instead so the operator's intent ("I want N total workers") is honored
    either way.

    Without this dual behavior, clicking Bootstrap with workers=N on a
    box where the autodeploy already ran `kube-cluster bootstrap
    --workers 0` does nothing visible — the user sees no progress and
    assumes the button is broken. Caught on .127 2026-05-16."""
    workers = int(msg.get("workers", 3))
    # Probe: does kldload-cp libvirt domain already exist?
    rc = subprocess.call(["virsh", "dominfo", "kldload-cp"],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if rc == 0:
        await websocket.send(json.dumps({
            "type": "log_line", "target": "k8s",
            "line": f"[k8s] Existing cluster detected (kldload-cp present). Scaling to {workers} workers instead of re-bootstrapping.",
        }))
        await _auto_snapshot(websocket, f"k8s-scale-to-{workers}")
        # kube-cluster scale clones + DHCPs + joins — 5-15 min for 3 workers,
        # easily 30+ for larger. Detached for the same reasons as the
        # explicit scale handler (_k8s_cluster_scale below).
        await _stream_proc_detached(websocket,
            ["kube-cluster", "scale", str(workers)],
            target="k8s")
    else:
        await _auto_snapshot(websocket, "k8s-bootstrap")
        # Full bootstrap is the longest single op in the GUI — 15-30 min for
        # cp + workers + Cilium/Tetragon/MetalLB.
        await _stream_proc_detached(websocket,
            ["kube-cluster", "bootstrap", "--workers", str(workers)],
            target="k8s")
    await _k8s_status(websocket)


async def _k8s_cluster_scale(websocket, msg):
    """Explicit cluster scale — add workers to an existing K8s cluster.
    Pairs with a dedicated 'Add Workers' button. Differs from _k8s_bootstrap
    in that it requires the cluster to exist and never tries to bootstrap.
    """
    workers = int(msg.get("workers", 1))
    rc = subprocess.call(["virsh", "dominfo", "kldload-cp"],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if rc != 0:
        await websocket.send(json.dumps({
            "type": "error",
            "msg": "Can't scale — no kldload-cp control plane VM found. Bootstrap the cluster first.",
        }))
        return
    await _auto_snapshot(websocket, f"k8s-scale-{workers}")
    # kube-cluster's arg parser expects --workers N (flag), not positional.
    # Positional argument hit `die "Unknown option: <N>"` and the scale
    # request silently dropped. Caught .113 + .137 2026-05-17.
    #
    # Use the DETACHED variant — scale takes 4-6 minutes per worker and
    # any webui restart during that window used to kill the subprocess
    # (KillMode=control-group). Detached runs as a transient systemd unit
    # in its own cgroup, so a webui restart no longer breaks scales.
    await _stream_proc_detached(websocket,
        ["kube-cluster", "scale", "--workers", str(workers)],
        target="k8s")
    await _k8s_status(websocket)


async def _k8s_reset(websocket):
    """Destroy K8s cluster via kube-cluster."""
    await _auto_snapshot(websocket, "k8s-reset")
    # kube-cluster destroy prompts for confirmation — pipe 'destroy' to stdin
    await websocket.send(json.dumps({"type": "exec_start", "target": "k8s"}))
    proc = await asyncio.create_subprocess_exec(
        "bash", "-c", "echo destroy | kube-cluster destroy",
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.STDOUT,
    )
    RUNNING_PROCS["k8s"] = proc
    _ansi_strip = re.compile(r'\x1b\[[0-9;]*[mGKHF]')
    try:
        async for line in proc.stdout:
            await websocket.send(json.dumps({
                "type": "log_line",
                "line": _ansi_strip.sub('', line.decode(errors="replace").rstrip()),
                "target": "k8s",
            }))
        rc = await proc.wait()
    finally:
        RUNNING_PROCS.pop("k8s", None)
    await websocket.send(json.dumps({"type": "exec_done", "rc": rc, "target": "k8s"}))


# ── Auto-snapshot safety net ──────────────────────────────────────────────────

async def _auto_snapshot(websocket, label="pre-action"):
    """Take automatic ZFS snapshot before destructive operations. Safety net."""
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    snap_name = f"rpool@klab-{label}-{ts}"
    try:
        proc = await asyncio.create_subprocess_exec(
            "zfs", "snapshot", "-r", snap_name,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.STDOUT,
        )
        await proc.wait()
        if proc.returncode == 0:
            await websocket.send(json.dumps({
                "type": "log_line", "target": "klab",
                "line": f"[snapshot] Auto-snapshot: {snap_name}",
            }))
            db_log_event("auto_snapshot", snap_name, f"Pre-{label} safety snapshot")
            return snap_name
        else:
            LOG.warning("Auto-snapshot failed (rc=%d) — proceeding anyway", proc.returncode)
    except Exception as e:
        LOG.warning("Auto-snapshot failed: %s — proceeding anyway", e)
    return None

# ── klab handler implementations ──────────────────────────────────────────────

KLAB_DISTROS = ["centos", "rocky", "fedora", "debian", "ubuntu", "rhel"]

def _klab_get_golden_info():
    """Inspect ZFS snapshots and VM state for all klab golden/site VMs."""
    pool = "rpool"
    goldens = {}
    for distro in KLAB_DISTROS:
        name = f"klab-golden-{distro}"
        snap = f"{pool}/vms/{name}@golden"
        info = {"distro": distro, "ready": False, "size": "", "kernel": "", "zfs_ver": ""}
        try:
            out = subprocess.check_output(
                ["zfs", "list", "-Hp", "-o", "used,referenced", snap],
                text=True, stderr=subprocess.DEVNULL).strip()
            parts = out.split('\t')
            info["ready"] = True
            info["size"] = _human_size(int(parts[1])) if len(parts) > 1 else "?"
        except Exception:
            pass
        # Read cached golden log for kernel/ZFS version
        log_path = Path(f"/root/klab/goldens/{distro}-latest.log")
        if log_path.exists():
            try:
                content = log_path.read_text(errors="replace")
                for line in content.splitlines():
                    if "Kernel:" in line:
                        info["kernel"] = line.split("Kernel:")[-1].strip()[:30]
                    if "ZFS version:" in line:
                        info["zfs_ver"] = line.split("ZFS version:")[-1].strip()[:30]
            except Exception:
                pass
        goldens[distro] = info
    return goldens

def _klab_get_ztest_goldens():
    """Status of the ZFS-test-specific goldens (klab-ztest-<distro>).
    Parallel to _klab_get_golden_info but inspects the ztest lineage —
    these are the images that carry the full zfs-tests.sh dependency
    set (ksh, fio, pamtester, pax, cryptsetup, loopback vdevs, …).
    Returns per-distro readiness + size + built-at timestamp so the UI
    can show a 'what's ready' matrix."""
    pool = "rpool"
    goldens = {}
    for distro in KLAB_DISTROS:
        name = f"klab-ztest-{distro}"
        snap = f"{pool}/vms/{name}@golden"
        info = {"distro": distro, "name": name, "ready": False,
                "size": "", "built": "", "kernel": "", "zfs_ver": ""}
        try:
            out = subprocess.check_output(
                ["zfs", "list", "-Hp", "-o", "used,referenced,creation", snap],
                text=True, stderr=subprocess.DEVNULL).strip()
            parts = out.split("\t")
            info["ready"] = True
            if len(parts) > 1:
                info["size"] = _human_size(int(parts[1]))
            if len(parts) > 2:
                # creation is unix seconds — convert to ISO-ish
                try:
                    info["built"] = datetime.datetime.fromtimestamp(int(parts[2])).strftime("%Y-%m-%d %H:%M")
                except Exception:
                    pass
        except Exception:
            pass
        # Same sidecar log source as regular goldens.
        log_path = Path(f"/root/klab/goldens/ztest-{distro}-latest.log")
        if not log_path.exists():
            log_path = Path(f"/root/klab/goldens/{distro}-latest.log")
        if log_path.exists():
            try:
                for line in log_path.read_text(errors="replace").splitlines():
                    if "Kernel:" in line:
                        info["kernel"] = line.split("Kernel:")[-1].strip()[:40]
                    if "ZFS version:" in line or "ZFS:" in line:
                        info["zfs_ver"] = line.split(":", 1)[-1].strip()[:40]
            except Exception:
                pass
        goldens[distro] = info
    return goldens


def _vm_resolve_ip(name):
    """Best-effort IP discovery for a libvirt domain.

    Tries three sources in order:
      1. --source agent  — works if qemu-guest-agent is connected (Rocky,
         Fedora, RHEL cloud images have it; Debian/Ubuntu cloud images
         usually don't unless we explicitly install qemu-guest-agent in
         cloud-init).
      2. --source arp    — populated whenever the host's bridge has seen
         any packet from the guest, which is true the moment the guest
         has touched the network. Universal fallback.
      3. --source lease  — dnsmasq lease file. Empty for "blank" guests
         that never DHCPd a new lease (rare; covered by 1+2).

    Earlier code synthesized fake static IPs by distro index. They almost
    never matched the actual DHCP-assigned address, which is why the klab
    view rendered IPs that wouldn't route — and why debian-blue/ubuntu-blue
    (no QGA) showed blank after an earlier rewrite that returned empty on
    miss. Real discovery fixes both classes of bug.
    """
    for src in ("agent", "arp", "lease"):
        try:
            out = subprocess.check_output(
                ["virsh", "domifaddr", name, "--source", src],
                text=True, stderr=subprocess.DEVNULL, timeout=3)
            for line in out.splitlines():
                parts = line.split()
                if len(parts) >= 4 and parts[2] == "ipv4":
                    addr = parts[3].split("/")[0]
                    if addr and not addr.startswith(("127.", "169.254.", "0.")):
                        return addr
        except Exception:
            continue
    return ""

def _klab_get_site_vms(site):
    """Get running VMs for a klab site (blue or green) with real IPs."""
    vms = []
    try:
        out = subprocess.check_output(
            ["virsh", "list", "--all", "--name"],
            text=True, stderr=subprocess.DEVNULL)
        for line in out.strip().splitlines():
            name = line.strip()
            if not name or not name.startswith(f"klab-{site}-"):
                continue
            distro = name.replace(f"klab-{site}-", "")
            state = "unknown"
            try:
                state = subprocess.check_output(
                    ["virsh", "domstate", name],
                    text=True, stderr=subprocess.DEVNULL).strip()
            except Exception:
                pass
            ip = _vm_resolve_ip(name) if state == "running" else ""
            vms.append({"name": name, "distro": distro, "state": state, "ip": ip})
    except Exception:
        pass
    return vms

def _klab_get_test_results():
    """Read latest test results from /root/klab/.

    Prefers authoritative <distro>.summary files (written when klab finishes
    a distro) but falls back to parsing the live <distro>.log so the UI
    shows progress counts while a run is still in flight.
    """
    results = {}
    results_dir = Path("/root/klab")
    if not results_dir.exists():
        return results
    latest = results_dir / "latest"
    if latest.is_symlink() or latest.is_dir():
        try:
            latest = latest.resolve()
        except Exception:
            pass
    else:
        # Fallback: any YYYYMMDD-HHMMSS dir, newest wins
        runs = sorted(
            [d for d in results_dir.iterdir()
             if d.is_dir() and re.match(r"^\d{8}-\d{6}$", d.name)],
            key=lambda d: d.stat().st_mtime, reverse=True,
        )
        if not runs:
            return results
        latest = runs[0]
    results["run_id"] = latest.name
    results["distros"] = {}

    # Authoritative per-distro summaries first.
    summaries = {}
    for f in latest.glob("*.summary"):
        data = {}
        try:
            for line in f.read_text().splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    data[k.strip()] = v.strip()
        except Exception:
            pass
        summaries[f.stem] = data

    for log_file in sorted(latest.glob("*.log")):
        distro = log_file.stem
        if distro == "full":
            continue
        entry = {}
        status_file = latest / f"{distro}.status"
        if status_file.is_file():
            try:
                entry["status"] = status_file.read_text().strip()
            except Exception:
                pass
        if distro in summaries:
            entry.update(summaries[distro])
        else:
            try:
                text = log_file.read_text(errors="replace")
                entry["pass"] = str(text.count("[PASS]"))
                entry["fail"] = str(text.count("[FAIL]"))
                entry["skip"] = str(text.count("[SKIP]"))
                for line in reversed(text.splitlines()):
                    if "/functional/" in line and "run as root" in line:
                        frag = line.split("/functional/", 1)[1]
                        entry["current"] = frag.split(" (run as root)", 1)[0][:80]
                        break
                entry["live"] = "1"
            except Exception:
                pass
        results["distros"][distro] = entry

    # Include summaries that had no matching .log (defensive).
    for d, data in summaries.items():
        results["distros"].setdefault(d, data)
    return results


async def _klab_status(websocket):
    """Return comprehensive klab status: goldens, sites, tests, pool metrics."""
    try:
        goldens = _klab_get_golden_info()
    except Exception as e:
        LOG.warning("klab_status: golden info failed: %s", e)
        goldens = {}
    try:
        blue_vms = _klab_get_site_vms("blue")
    except Exception as e:
        LOG.warning("klab_status: blue VM list failed: %s", e)
        blue_vms = []
    try:
        green_vms = _klab_get_site_vms("green")
    except Exception as e:
        LOG.warning("klab_status: green VM list failed: %s", e)
        green_vms = []
    try:
        tests = _klab_get_test_results()
    except Exception as e:
        LOG.warning("klab_status: test results failed: %s", e)
        tests = {}

    # Pool metrics from klab-exporter if running
    metrics = {}
    try:
        import urllib.request
        r = urllib.request.urlopen("http://localhost:9101/metrics", timeout=2)
        if r.status == 200:
            text = r.read().decode(errors="replace")
            for line in text.splitlines():
                if line.startswith("#"):
                    continue
                if line.startswith("klab_"):
                    parts = line.split(" ", 1)
                    if len(parts) == 2:
                        metrics[parts[0]] = parts[1].strip()
    except Exception:
        pass

    await websocket.send(json.dumps({
        "type": "klab_status",
        "goldens": goldens,
        "blue_vms": blue_vms,
        "green_vms": green_vms,
        "tests": tests,
        "metrics": metrics,
    }))


async def _klab_golden(websocket, msg):
    """Build klab golden image(s). Streams logs.

    Detached because each blue-green golden takes 5-15 min (cloud image
    download + virt-install + setup_vm_golden snapshot). A 6-distro `all`
    run is 30-60 min; same survival-across-webui-restart logic as ztest.
    """
    distro = msg.get("distro", "all")
    if distro != "all" and distro not in KLAB_DISTROS:
        await websocket.send(json.dumps({"type": "error", "msg": f"invalid distro: {distro}"}))
        return
    env = {}
    if msg.get("zfs_dev"):
        env["KLAB_ZFS_DEV"] = "1"
    zfs_source = msg.get("zfs_source", "")
    if zfs_source:
        env["ZFS_SOURCE"] = zfs_source
    await _stream_proc_detached(websocket, ["klab", "golden", distro], env=env, target="klab")
    # Refresh status after build
    await _klab_status(websocket)


async def _klab_verify(websocket, msg):
    """Verify klab golden image(s)."""
    distro = msg.get("distro", "all")
    if distro != "all" and distro not in KLAB_DISTROS:
        await websocket.send(json.dumps({"type": "error", "msg": f"invalid distro: {distro}"}))
        return
    # klab verify boots each golden + runs a smoke test inside — minutes
    # per distro.
    await _stream_proc_detached(websocket, ["klab", "verify", distro], target="klab")


async def _klab_deploy(websocket, msg):
    """Deploy klab site (blue or green). Streams logs."""
    site = msg.get("site", "blue")
    if site not in ("blue", "green"):
        await websocket.send(json.dumps({"type": "error", "msg": "site must be 'blue' or 'green'"}))
        return
    await _auto_snapshot(websocket, f"deploy-{site}")
    # 5 distros × clone-from-snapshot + boot — 1-3 min typical, can run
    # longer if cloud-init does post-boot work. Detached for safety.
    await _stream_proc_detached(websocket, ["klab", "deploy", site], target="klab")
    await _klab_status(websocket)


async def _klab_promote(websocket, msg):
    """Promote green to blue."""
    site = msg.get("site", "green")
    await _auto_snapshot(websocket, "promote")
    # Promote = snap-blue + zfs-clone-from-green — usually <30s, but a slow
    # zpool can stretch it; detach to be safe since it's destructive.
    await _stream_proc_detached(websocket, ["klab", "promote", site], target="klab")
    await _klab_status(websocket)


async def _klab_rollback(websocket):
    """Rollback blue to previous snapshot."""
    # Destructive — protect against UI reload mid-op.
    await _stream_proc_detached(websocket, ["klab", "rollback"], target="klab")
    await _klab_status(websocket)


async def _klab_test(websocket, msg):
    """Run OpenZFS test suite. DETACHED via plain Popen + setsid so the
    run survives websocket disconnects / browser reloads / webui restarts.

    Before this the test was piped through asyncio _stream_proc with
    start_new_session=True, which DID detach the process group — but
    when the websocket died, Python's asyncio transport GC'd the pipe
    and the subprocess got SIGKILL'd silently (observed: centos cloned,
    then klab vanishes with no log). Plain subprocess.Popen with
    start_new_session and stdout→file has no such coupling: the child
    is adopted by PID 1 and runs to completion regardless of what the
    webui does.

    The UI keeps its live feel by tailing /var/log/kldload/klab.log
    (webui's own "log tail" facility already shows that file). The run
    state is written to /var/run/klab/current-run.env so a reconnecting
    client can see "test is already running, started at T+NN".
    """
    await _auto_snapshot(websocket, "test")
    cmd = ["klab", "test"]
    mode = msg.get("mode", "quick")
    if mode == "full":
        cmd.append("--full")
    else:
        cmd.append("--quick")
    distro = msg.get("distro", "")
    if distro and distro in KLAB_DISTROS:
        cmd += ["--distro", distro]
    execution = msg.get("execution", "parallel")
    if execution == "series":
        cmd.append("--serial")
    env = {**os.environ}
    if execution == "series":
        env["KLAB_SERIAL"] = "1"

    # Refuse overlap — only one klab test at a time. Prior run's PID
    # lives in /var/run/klab/current-run.env; if it's still alive,
    # report that instead of launching a duplicate.
    run_state = "/var/run/klab/current-run.env"
    os.makedirs("/var/run/klab", exist_ok=True)
    if os.path.exists(run_state):
        try:
            prior = {}
            for line in open(run_state):
                if "=" in line:
                    k, v = line.rstrip().split("=", 1)
                    prior[k] = v
            prior_pid = int(prior.get("pid", "0"))
            if prior_pid > 0:
                try:
                    os.kill(prior_pid, 0)  # signal 0 = check-alive
                    await websocket.send(json.dumps({
                        "type": "klab_test_already_running",
                        "pid": prior_pid,
                        "started": prior.get("started", "?"),
                        "cmd": prior.get("cmd", "?"),
                        "msg": "klab test already running in background — tailing existing run",
                    }))
                    return
                except ProcessLookupError:
                    pass  # stale pid file, fine to restart
        except Exception:
            pass  # corrupt/unreadable pid file — proceed with fresh launch

    log_path = "/var/log/kldload/klab-test-live.log"
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    # Append a run-separator to the live log so successive runs are
    # visually distinguishable when tailing the file.
    try:
        with open(log_path, "ab") as _lfh:
            _lfh.write(f"\n\n# === klab test run {datetime.datetime.now().isoformat()} ===\n".encode())
            _lfh.write(f"# cmd: {' '.join(cmd)}\n".encode())
    except Exception:
        pass

    # Spawn klab in its own systemd transient unit — critical for
    # surviving webui restarts. Previously we used subprocess.Popen +
    # start_new_session=True which creates a new *session* but keeps
    # the child in the webui's *cgroup* (/system.slice/kldload-webui.service).
    # systemd's default KillMode=control-group means every webui restart
    # SIGKILLs the entire cgroup — our "detached" klab died silently after
    # centos clone because the webui was pushing status updates that
    # occasionally triggered restarts. The only correct fix is to move
    # the child into its OWN cgroup via systemd-run.
    #
    # --collect     — auto-clean the transient unit when it exits
    # --no-block    — systemd-run returns immediately; don't wait for start
    # --unit=<name> — stable name so cancel/status can reference it
    # StandardOutput=append: — systemd 240+ direct-to-file output
    unit_name = f"klab-test-{int(datetime.datetime.now().timestamp())}.service"
    systemd_cmd = [
        "systemd-run",
        f"--unit={unit_name}",
        "--collect",
        "--no-block",
        "--property=Type=simple",
        f"--property=StandardOutput=append:{log_path}",
        "--property=StandardError=inherit",
        "--",
    ] + cmd
    # Include the env vars klab expects (KLAB_SERIAL, etc.) as
    # --setenv flags so they land inside the transient unit.
    for k, v in env.items():
        if k.startswith(("KLAB_", "KLDLOAD_", "RHEL_")):
            systemd_cmd.insert(-len(cmd) - 1, f"--setenv={k}={v}")
    # Use asyncio subprocess so we don't block the WS event loop while
    # systemd-run does its thing (was causing WS disconnects because the
    # ping-pong heartbeat couldn't fire while we blocked).
    _p = await asyncio.create_subprocess_exec(
        *systemd_cmd,
        stdout=asyncio.subprocess.DEVNULL,
        stderr=asyncio.subprocess.PIPE,
    )
    _, _stderr = await _p.communicate()
    if _p.returncode != 0:
        await websocket.send(json.dumps({
            "type": "log_line", "target": "klab",
            "line": f"[klab] systemd-run failed rc={_p.returncode}: {(_stderr or b'').decode(errors='replace')[:500]}",
        }))
        return
    # Resolve the unit's MainPID (async) so we don't block on systemctl.
    main_pid = 0
    for _ in range(20):
        _q = await asyncio.create_subprocess_exec(
            "systemctl", "show", unit_name, "--property=MainPID", "--value",
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL,
        )
        _out, _ = await _q.communicate()
        out = (_out or b"").decode().strip()
        if out and out.isdigit() and int(out) > 0:
            main_pid = int(out)
            break
        await asyncio.sleep(0.25)

    # Persist run state for UI reconnects + cancel/status endpoints.
    try:
        with open(run_state, "w") as f:
            f.write(f"pid={main_pid}\n")
            f.write(f"unit={unit_name}\n")
            f.write(f"started={datetime.datetime.now().isoformat()}\n")
            f.write(f"cmd={' '.join(cmd)}\n")
            f.write(f"log={log_path}\n")
            f.write(f"mode={mode}\n")
            if distro:
                f.write(f"distro={distro}\n")
    except Exception:
        pass

    await websocket.send(json.dumps({
        "type": "klab_test_started",
        "pid": main_pid,
        "unit": unit_name,
        "mode": mode,
        "log": log_path,
        "msg": f"klab test {mode} started as {unit_name} (pid {main_pid}); survives webui restart",
    }))
    # Status refresh so the UI flips to "running" immediately.
    await _klab_status(websocket)
    # Tail the detached log back to this WS so the user sees live
    # output while connected. The tail exits when the subprocess
    # dies OR the WS fails — neither kills the subprocess, which
    # continues writing to log_path until it exits naturally.
    await _klab_test_tail(websocket, proc.pid, log_path, target="klab")


def _detached_find_active(target):
    """Find the most-recent still-running detached job for a given target.

    _stream_proc_detached writes its log to /var/log/kldload/<target>-<ts>.log
    and writes a sentinel .<target>-<ts>.done when the unit exits. Scanning
    for log files without a matching .done gives us the in-flight jobs. We
    cross-check against systemctl so a crashed unit that never wrote the
    sentinel (kernel OOM, etc.) doesn't masquerade as active.

    Returns (unit_name, log_path, started_ts) or None.
    """
    log_dir = "/var/log/kldload"
    if not os.path.isdir(log_dir):
        return None
    prefix = f"{target}-"
    active = []
    try:
        for fn in os.listdir(log_dir):
            if not fn.startswith(prefix) or not fn.endswith(".log"):
                continue
            ts_part = fn[len(prefix):-len(".log")]
            if not ts_part.isdigit():
                continue
            done = os.path.join(log_dir, f".{target}-{ts_part}.done")
            if os.path.exists(done):
                continue
            unit = f"kldload-{target}-{ts_part}.service"
            try:
                rc = subprocess.call(
                    ["systemctl", "is-active", "--quiet", unit],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                rc = 1
            if rc != 0:
                continue
            active.append((int(ts_part), unit, os.path.join(log_dir, fn)))
    except Exception as e:
        LOG.warning("_detached_find_active(%s): %s", target, e)
        return None
    if not active:
        return None
    active.sort(reverse=True)   # newest first
    ts, unit, log_path = active[0]
    return (unit, log_path, ts)


async def _detached_reattach(websocket, msg):
    """Re-attach a reconnecting client to a detached _stream_proc job.

    Mirrors _klab_test_reattach but for the generic
    /var/log/kldload/<target>-<ts>.log + .done sentinel pattern that
    _stream_proc_detached uses. Frontend calls this on (re)connect for
    the active view so the user sees live progress of a build that was
    kicked off in a prior session.

    No active job → quiet noop. Don't error — it's expected most of the
    time.
    """
    target = msg.get("target") or ""
    if not target or "/" in target or "." in target:
        return
    found = _detached_find_active(target)
    if not found:
        await websocket.send(json.dumps({
            "type": "detached_reattach_noop", "target": target,
        }))
        return
    unit, log_path, started_ts = found
    await websocket.send(json.dumps({
        "type": "detached_reattach_start",
        "target": target, "unit": unit, "log": log_path, "started": started_ts,
    }))
    # Tail the file until the .done sentinel appears OR the WS closes.
    # We use a simple file poll + sentinel check; no PID needed because
    # the .done file IS the canonical "finished" signal that
    # _stream_proc_detached writes on exit.
    done_path = os.path.join(os.path.dirname(log_path),
                             "." + os.path.basename(log_path).replace(".log", ".done"))
    _ansi_re = re.compile(r'\x1b\[[0-9;]*[mGKHF]')
    try:
        f = open(log_path, "r", errors="replace")
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "log_line", "target": target,
            "line": f"[reattach] open failed: {e}",
        }))
        return
    # Catchup: honour `since_lines` from the client (same replay-storm
    # fix as _klab_test_tail). If the client already has N lines, skip
    # them; otherwise send last 400 for run-header context.
    try:
        since_lines = int(msg.get("since_lines") or 0)
    except Exception:
        since_lines = 0
    try:
        all_lines = f.readlines()
        if since_lines > 0 and since_lines < len(all_lines):
            catchup = all_lines[since_lines:]
        else:
            catchup = all_lines[-400:]
        for line in catchup:
            await websocket.send(json.dumps({
                "type": "log_line", "target": target,
                "line": _ansi_re.sub('', line.rstrip()),
            }))
    except Exception:
        return
    # Live tail.
    while True:
        line = f.readline()
        if line:
            try:
                await websocket.send(json.dumps({
                    "type": "log_line", "target": target,
                    "line": _ansi_re.sub('', line.rstrip()),
                }))
            except Exception:
                f.close()
                return
        else:
            if os.path.exists(done_path):
                trailing = f.read()
                if trailing:
                    for t in trailing.splitlines():
                        try:
                            await websocket.send(json.dumps({
                                "type": "log_line", "target": target,
                                "line": _ansi_re.sub('', t),
                            }))
                        except Exception:
                            f.close()
                            return
                # Read the rc from the sentinel and send exec_done so the
                # client UI flips from "building" to "done/failed".
                try:
                    with open(done_path) as df:
                        rc = int(df.read().strip())
                except Exception:
                    rc = -1
                await websocket.send(json.dumps({
                    "type": "exec_done", "target": target, "rc": rc,
                }))
                f.close()
                return
            await asyncio.sleep(0.4)


async def _klab_test_reattach(websocket):
    """Re-attach a reconnecting client to an already-running klab test.
    Reads /var/run/klab/current-run.env for pid+log, then hands off to
    _klab_test_tail. If no run is in flight, reports 'no active run'."""
    run_state = "/var/run/klab/current-run.env"
    if not os.path.exists(run_state):
        await websocket.send(json.dumps({
            "type": "klab_test_noop",
            "msg": "no klab test currently running",
        }))
        return
    info = {}
    try:
        for line in open(run_state):
            if "=" in line:
                k, v = line.rstrip().split("=", 1)
                info[k] = v
    except Exception:
        pass
    pid = int(info.get("pid", "0") or 0)
    log_path = info.get("log", "/var/log/kldload/klab-test-live.log")
    if pid <= 0:
        await websocket.send(json.dumps({
            "type": "klab_test_noop",
            "msg": "no klab test currently running",
        }))
        return
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        # stale state; clean it up so next klab_test doesn't trip over it
        try: os.remove(run_state)
        except Exception: pass
        await websocket.send(json.dumps({
            "type": "klab_test_noop",
            "msg": "prior run exited; state cleared",
        }))
        return
    await websocket.send(json.dumps({
        "type": "klab_test_reattached",
        "pid": pid,
        "unit": info.get("unit", ""),
        "started": info.get("started", ""),
        "log": log_path,
    }))
    await _klab_test_tail(websocket, pid, log_path, target="klab")


async def _klab_test_tail(websocket, pid, log_path, target="klab", since_lines=0):
    """Stream new lines from the detached klab-test log to the WS
    until the PID exits or the WS closes. Never kills the subprocess.

    Called automatically from _klab_test after spawn, and also
    on-demand (action 'klab_test_tail') so a reconnecting client
    can re-attach to an already-running test.

    `since_lines`: when >0, treats it as the line cursor the client
    already has in its DOM — send only lines[since_lines:] as catchup
    instead of the unconditional last 400. Prevents the replay storm
    where every reconnect re-dumps the same 400 lines (2026-05-18 fix).
    """
    _ansi_re = re.compile(r'\x1b\[[0-9;]*[mGKHF]')
    # Wait up to 10s for the log file to appear (the child writes
    # the header during initial start; first reads can race).
    for _ in range(20):
        if os.path.exists(log_path):
            break
        await asyncio.sleep(0.5)
    if not os.path.exists(log_path):
        await websocket.send(json.dumps({
            "type": "log_line", "target": target,
            "line": f"[tail] log file never appeared: {log_path}",
        }))
        return
    try:
        f = open(log_path, "r", errors="replace")
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "log_line", "target": target,
            "line": f"[tail] open failed: {e}",
        }))
        return
    # Catchup: if the client already has `since_lines` lines in its DOM
    # (reconnect case), send only the lines past that cursor. Otherwise
    # (first attach) send the last 400 as run-header + context.
    try:
        all_lines = f.readlines()
        if since_lines > 0 and since_lines < len(all_lines):
            catchup = all_lines[since_lines:]
        else:
            catchup = all_lines[-400:]
        for line in catchup:
            await websocket.send(json.dumps({
                "type": "log_line", "target": target,
                "line": _ansi_re.sub('', line.rstrip()),
            }))
    except Exception:
        return
    # Now live-tail
    while True:
        try:
            os.kill(pid, 0)
            alive = True
        except (ProcessLookupError, PermissionError):
            alive = False
        line = f.readline()
        if line:
            try:
                await websocket.send(json.dumps({
                    "type": "log_line", "target": target,
                    "line": _ansi_re.sub('', line.rstrip()),
                }))
            except Exception:
                f.close()
                return  # WS dead; leave subprocess alone
        elif not alive:
            # Drain anything left written between readline() returning ''
            # and the liveness check flipping to false.
            trailing = f.read()
            if trailing:
                for t in trailing.splitlines():
                    try:
                        await websocket.send(json.dumps({
                            "type": "log_line", "target": target,
                            "line": _ansi_re.sub('', t),
                        }))
                    except Exception:
                        break
            try:
                await websocket.send(json.dumps({
                    "type": "exec_done", "rc": 0, "target": target,
                }))
            except Exception:
                pass
            f.close()
            return
        else:
            await asyncio.sleep(0.4)


async def _klab_destroy(websocket, msg):
    """Destroy klab resources."""
    target = msg.get("target", "")
    # Special form: "ztest:<distro>" destroys a single ZFS test golden so
    # the user can rebuild it fresh without nuking the others.
    if target.startswith("ztest:"):
        distro = target.split(":", 1)[1]
        if distro not in KLAB_DISTROS:
            await websocket.send(json.dumps({"type": "error", "msg": f"unknown distro: {distro}"}))
            return
        vm = f"klab-ztest-{distro}"
        zpath = f"rpool/vms/{vm}"
        await websocket.send(json.dumps({"type": "klab_log", "line": f"Destroying {vm}..."}))
        for cmd in (
            ["virsh", "destroy", vm],
            ["virsh", "undefine", vm, "--nvram"],
            ["zfs", "destroy", "-Rf", zpath],
        ):
            try:
                subprocess.check_output(cmd, stderr=subprocess.STDOUT, timeout=30)
            except Exception:
                pass
        await websocket.send(json.dumps({"type": "klab_log", "line": f"{vm} gone."}))
        # Refresh ztest goldens matrix
        await websocket.send(json.dumps({
            "type": "klab_ztest_goldens",
            "goldens": _klab_get_ztest_goldens(),
        }))
        return
    if target not in ("blue", "green", "all", "goldens"):
        await websocket.send(json.dumps({"type": "error", "msg": "target must be blue|green|all|goldens|ztest:<distro>"}))
        return
    await _auto_snapshot(websocket, f"destroy-{target}")
    # klab destroy — virsh destroys + zfs recursive destroys. Destructive
    # and can run minutes for "all". Detached so a UI reload doesn't leave
    # the teardown half-finished.
    await _stream_proc_detached(websocket, ["klab", "destroy", target], target="klab")
    await _klab_status(websocket)


async def _klab_vm_op(websocket, msg):
    """Start/stop/force-stop an individual klab VM."""
    vm = msg.get("vm", "")
    op = msg.get("op", "")
    if not vm or not vm.startswith("klab-"):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid VM name"}))
        return
    if op not in ("start", "shutdown", "destroy", "reboot"):
        await websocket.send(json.dumps({"type": "error", "msg": "op must be start|shutdown|destroy|reboot"}))
        return
    try:
        subprocess.check_call(["virsh", op, vm], stderr=subprocess.DEVNULL)
        await websocket.send(json.dumps({"type": "klab_vm_op_done", "vm": vm, "op": op, "ok": True}))
    except Exception as e:
        await websocket.send(json.dumps({"type": "klab_vm_op_done", "vm": vm, "op": op, "ok": False, "error": str(e)}))
    await _klab_status(websocket)


async def _klab_isolate(websocket, msg):
    """Toggle network isolation for a klab VM using nftables."""
    vm = msg.get("vm", "")
    ip = msg.get("ip", "")
    isolate = msg.get("isolate", True)  # True = isolate, False = reconnect

    if not ip or not vm:
        await websocket.send(json.dumps({"type": "error", "msg": "vm and ip required"}))
        return

    try:
        if isolate:
            # Drop all forwarded traffic from this VM except SSH (port 22)
            subprocess.check_call([
                "nft", "add", "rule", "inet", "filter", "forward",
                "ip", "saddr", ip, "tcp", "dport", "!=", "22", "drop",
            ], stderr=subprocess.DEVNULL)
            subprocess.check_call([
                "nft", "add", "rule", "inet", "filter", "forward",
                "ip", "daddr", ip, "tcp", "sport", "!=", "22", "drop",
            ], stderr=subprocess.DEVNULL)
            await websocket.send(json.dumps({
                "type": "klab_isolate_done", "vm": vm, "ip": ip,
                "isolated": True, "msg": f"Isolated {vm} — SSH only",
            }))
        else:
            # Flush forward chain and re-apply base rules (simplistic — fine for lab)
            subprocess.check_call(
                ["nft", "flush", "chain", "inet", "filter", "forward"],
                stderr=subprocess.DEVNULL)
            await websocket.send(json.dumps({
                "type": "klab_isolate_done", "vm": vm, "ip": ip,
                "isolated": False, "msg": f"Reconnected {vm} — full network",
            }))
    except Exception as e:
        await websocket.send(json.dumps({"type": "error", "msg": f"isolate failed: {e}"}))


async def _klab_metrics(websocket):
    """Fetch Prometheus metrics from klab-exporter (:9101) and return as JSON."""
    metrics = {}
    try:
        import urllib.request
        r = urllib.request.urlopen("http://localhost:9101/metrics", timeout=3)
        if r.status == 200:
            for line in r.read().decode(errors="replace").splitlines():
                if line.startswith("#") or not line.strip():
                    continue
                parts = line.split(" ", 1)
                if len(parts) == 2:
                    metrics[parts[0]] = parts[1].strip()
    except Exception as e:
        metrics["_error"] = str(e)
    await websocket.send(json.dumps({"type": "klab_metrics", "metrics": metrics}))


async def _klab_flows(websocket):
    """Get network flow data — try Hubble, fall back to conntrack/ss."""
    flows = []

    # Try Hubble first (Cilium eBPF flow visibility)
    try:
        out = subprocess.check_output(
            ["hubble", "observe", "--last", "50", "-o", "json"],
            text=True, stderr=subprocess.DEVNULL, timeout=5)
        for line in out.strip().splitlines():
            try:
                f = json.loads(line)
                flows.append({
                    "src": f.get("source", {}).get("identity", ""),
                    "dst": f.get("destination", {}).get("identity", ""),
                    "proto": f.get("l4", {}).get("TCP", {}).get("destination_port", ""),
                    "verdict": f.get("verdict", ""),
                    "time": f.get("time", ""),
                    "source": "hubble",
                })
            except Exception:
                pass
        if flows:
            await websocket.send(json.dumps({"type": "klab_flows", "flows": flows, "source": "hubble"}))
            return
    except Exception:
        pass

    # Fall back to conntrack
    try:
        out = subprocess.check_output(
            ["conntrack", "-L", "-o", "extended", "--limit", "50"],
            text=True, stderr=subprocess.DEVNULL, timeout=5)
        for line in out.strip().splitlines():
            parts = line.split()
            flow = {"raw": line.strip(), "source": "conntrack"}
            for p in parts:
                if p.startswith("src=") and "src" not in flow:
                    flow["src"] = p.split("=")[1]
                elif p.startswith("dst=") and "dst" not in flow:
                    flow["dst"] = p.split("=")[1]
                elif p.startswith("sport="):
                    flow["sport"] = p.split("=")[1]
                elif p.startswith("dport=") and "dport" not in flow:
                    flow["dport"] = p.split("=")[1]
            if len(parts) > 0:
                flow["proto"] = parts[0] if parts[0] in ("tcp", "udp", "icmp") else ""
            flows.append(flow)
        await websocket.send(json.dumps({"type": "klab_flows", "flows": flows, "source": "conntrack"}))
        return
    except Exception:
        pass

    # Fall back to ss summary
    try:
        out = subprocess.check_output(["ss", "-s"], text=True, stderr=subprocess.DEVNULL)
        await websocket.send(json.dumps({
            "type": "klab_flows", "flows": [], "source": "ss",
            "summary": out.strip(),
        }))
    except Exception as e:
        await websocket.send(json.dumps({"type": "klab_flows", "flows": [], "source": "none", "error": str(e)}))


# ── ZFS Test Results (detailed) ────────────────────────────────────────────────

def _klab_get_all_test_runs():
    """Return all test runs with summaries. Two bugs were silently hiding
    every run's results in the UI:
      1) the dir-name filter required `run-` prefix but klab writes
         timestamped dirs (20260417-081234) and an optional `latest`
         symlink — neither matched. Now we accept any directory that
         looks like a YYYYMMDD-HHMMSS stamp.
      2) the summary file uses lowercase keys (pass=, fail=, skip=,
         total=) but the read here looked up uppercase. Fixed to match."""
    import re
    results_dir = Path("/root/klab")
    if not results_dir.exists():
        return []
    _stamp_re = re.compile(r"^\d{8}-\d{6}$")
    runs = sorted([d for d in results_dir.iterdir()
                   if d.is_dir() and _stamp_re.match(d.name)],
                  key=lambda d: d.stat().st_mtime, reverse=True)
    all_runs = []
    for run_dir in runs[:20]:  # last 20 runs
        run = {
            "run_id": run_dir.name,
            "timestamp": datetime.datetime.fromtimestamp(
                run_dir.stat().st_mtime).strftime("%Y-%m-%d %H:%M:%S"),
            "distros": {},
        }
        for f in run_dir.glob("*.summary"):
            distro = f.stem
            data = {}
            try:
                for line in f.read_text().splitlines():
                    if "=" in line:
                        k, v = line.split("=", 1)
                        data[k.strip()] = v.strip()
            except Exception:
                pass
            # Also include per-distro status (pass/fail/skip/running) if
            # the .status sidecar file exists.
            status_f = run_dir / f"{distro}.status"
            if status_f.exists():
                try: data["status"] = status_f.read_text().strip()
                except Exception: pass
            run["distros"][distro] = data
        # Total pass/fail/skip — summary keys are lowercase (pass=/fail=/skip=).
        total_pass = sum(int(d.get("pass", 0) or 0) for d in run["distros"].values())
        total_fail = sum(int(d.get("fail", 0) or 0) for d in run["distros"].values())
        total_skip = sum(int(d.get("skip", 0) or 0) for d in run["distros"].values())
        run["total"] = {"pass": total_pass, "fail": total_fail, "skip": total_skip}
        all_runs.append(run)
    return all_runs


async def _klab_test_results(websocket, msg):
    """Return detailed test results — all runs or a specific run."""
    run_id = msg.get("run_id", "")
    runs = _klab_get_all_test_runs()

    if run_id:
        # Return detail for a specific run including log content
        run = next((r for r in runs if r["run_id"] == run_id), None)
        if not run:
            await websocket.send(json.dumps({"type": "error", "msg": f"run not found: {run_id}"}))
            return
        # Read per-distro log files
        run_dir = Path(f"/root/klab/{run_id}")
        logs = {}
        for f in run_dir.glob("*.log"):
            try:
                logs[f.stem] = f.read_text(errors="replace")[-16384:]  # last 16KB
            except Exception:
                pass
        await websocket.send(json.dumps({
            "type": "klab_test_detail",
            "run": run,
            "logs": logs,
        }))
    else:
        await websocket.send(json.dumps({
            "type": "klab_test_runs",
            "runs": runs,
        }))


# ── Fault injection ───────────────────────────────────────────────────────────

async def _klab_fault(websocket, msg):
    """Inject network faults into klab VMs for chaos testing."""
    vm = msg.get("vm", "")
    ip = msg.get("ip", "")
    fault = msg.get("fault", "")

    if not vm or not ip:
        await websocket.send(json.dumps({"type": "error", "msg": "vm and ip required"}))
        return

    await _auto_snapshot(websocket, f"fault-{fault}")

    result = {"type": "klab_fault_done", "vm": vm, "fault": fault, "ok": False}

    try:
        if fault == "network_down":
            # Drop all traffic to/from this VM
            subprocess.check_call([
                "nft", "add", "rule", "inet", "filter", "forward",
                "ip", "saddr", ip, "drop",
            ], stderr=subprocess.DEVNULL)
            subprocess.check_call([
                "nft", "add", "rule", "inet", "filter", "forward",
                "ip", "daddr", ip, "drop",
            ], stderr=subprocess.DEVNULL)
            result["ok"] = True
            result["msg"] = f"Network down: {vm} — all traffic dropped"

        elif fault == "packet_loss":
            # tc netem: 30% packet loss on the bridge for this VM's traffic
            pct = msg.get("percent", "30")
            if not re.match(r'^\d{1,3}$', str(pct)):
                pct = "30"
            # Find the tap interface for this VM
            tap = ""
            try:
                ifaces = subprocess.check_output(
                    ["virsh", "domiflist", vm],
                    text=True, stderr=subprocess.DEVNULL).strip().splitlines()
                # Skip header lines, find first interface name
                for line in ifaces:
                    parts = line.split()
                    if parts and parts[0].startswith(("vnet", "tap", "macvtap")):
                        tap = parts[0]; break
            except Exception:
                pass
            if tap:
                subprocess.check_call([
                    "tc", "qdisc", "replace", "dev", tap, "root", "netem",
                    "loss", f"{pct}%", "delay", "50ms",
                ], stderr=subprocess.DEVNULL)
                result["ok"] = True
                result["msg"] = f"Packet loss {pct}% + 50ms delay on {vm} ({tap})"
            else:
                result["msg"] = f"Could not find tap interface for {vm}"

        elif fault == "kill_vm":
            subprocess.check_call(["virsh", "destroy", vm], stderr=subprocess.DEVNULL)
            result["ok"] = True
            result["msg"] = f"Killed {vm} — VM forcefully stopped"

        elif fault == "clear":
            # Remove all faults: flush nft forward chain, remove tc qdisc
            subprocess.call(
                ["nft", "flush", "chain", "inet", "filter", "forward"],
                stderr=subprocess.DEVNULL)
            try:
                ifaces = subprocess.check_output(
                    ["virsh", "domiflist", vm],
                    text=True, stderr=subprocess.DEVNULL).strip().splitlines()
                for line in ifaces:
                    parts = line.split()
                    if parts and parts[0].startswith(("vnet", "tap", "macvtap")):
                        subprocess.call(["tc", "qdisc", "del", "dev", parts[0], "root"],
                                        stderr=subprocess.DEVNULL)
                        break
            except Exception:
                pass
            result["ok"] = True
            result["msg"] = f"Faults cleared for {vm}"

        else:
            result["msg"] = f"Unknown fault type: {fault}"

    except Exception as e:
        result["msg"] = str(e)

    await websocket.send(json.dumps(result))


# ── "What Just Happened" — eBPF + Hubble last 60s summary ────────────────────

async def _klab_what_happened(websocket, msg):
    """Capture last 60s of system activity: syscalls, network, file writes."""
    vm = msg.get("vm", "")
    ip = msg.get("ip", "")
    seconds = msg.get("seconds", 60)
    target = "klab"

    await websocket.send(json.dumps({
        "type": "log_line", "target": target,
        "line": f"[what-happened] Gathering last {seconds}s of activity" + (f" for {vm}" if vm else "") + "...",
    }))

    sections = []

    # 1. Hubble flows (if available)
    try:
        since = f"{seconds}s"
        cmd = ["hubble", "observe", "--last", "100", "--since", f"{since}ago", "-o", "compact"]
        if ip:
            cmd += ["--ip-filter", ip]
        out = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL, timeout=10)
        if out.strip():
            sections.append(("Network Flows (Hubble)", out.strip()))
    except Exception:
        pass

    # 2. Recent connections (conntrack)
    try:
        out = subprocess.check_output(
            ["conntrack", "-L", "-o", "extended", "--limit", "30"],
            text=True, stderr=subprocess.DEVNULL, timeout=5)
        if ip:
            out = "\n".join(l for l in out.splitlines() if ip in l)
        if out.strip():
            sections.append(("Active Connections (conntrack)", out.strip()))
    except Exception:
        pass

    # 3. Recent file writes (from audit log or find)
    if vm and ip:
        try:
            mmin_val = max(1, seconds // 60 + 1)
            out = subprocess.check_output(
                ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
                 f"root@{ip}",
                 f"find / -maxdepth 4 -mmin -{mmin_val} "
                 f"-not -path '/proc/*' -not -path '/sys/*' -not -path '/run/*' "
                 f"-type f 2>/dev/null | head -30"],
                text=True, stderr=subprocess.DEVNULL, timeout=15)
            if out.strip():
                sections.append((f"Recent File Changes ({vm})", out.strip()))
        except Exception:
            pass

    # 4. Listening ports
    if vm and ip:
        try:
            out = subprocess.check_output(
                ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
                 f"root@{ip}", "ss -tlnp 2>/dev/null | head -20"],
                text=True, stderr=subprocess.DEVNULL, timeout=10)
            if out.strip():
                sections.append((f"Listening Ports ({vm})", out.strip()))
        except Exception:
            pass

    # 5. Recent systemd journal (last 60s)
    if vm and ip:
        try:
            out = subprocess.check_output(
                ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
                 f"root@{ip}", f"journalctl --no-pager --since='{seconds} seconds ago' 2>/dev/null | tail -30"],
                text=True, stderr=subprocess.DEVNULL, timeout=10)
            if out.strip():
                sections.append((f"Journal ({vm})", out.strip()))
        except Exception:
            pass

    # 6. Host-level: recent dmesg
    try:
        out = subprocess.check_output(
            ["dmesg", "--time-format=reltime", "-T"],
            text=True, stderr=subprocess.DEVNULL, timeout=5)
        lines = out.strip().splitlines()[-15:]
        if lines:
            sections.append(("Host dmesg (last 15)", "\n".join(lines)))
    except Exception:
        pass

    # Format and send
    if not sections:
        await websocket.send(json.dumps({
            "type": "klab_what_happened",
            "summary": "(No activity captured in the last {seconds}s. Is the VM running?)",
            "sections": [],
        }))
    else:
        formatted = []
        for title, body in sections:
            formatted.append({"title": title, "body": body})
        summary_lines = [f"=== {s['title']} ===" for s in formatted]
        await websocket.send(json.dumps({
            "type": "klab_what_happened",
            "summary": f"Captured {len(sections)} sections of activity in the last {seconds}s",
            "sections": formatted,
        }))


# ── Diff view: before/after comparison ────────────────────────────────────────

async def _klab_diff_capture(websocket, msg):
    """Capture system state for before/after diffing."""
    vm = msg.get("vm", "")
    ip = msg.get("ip", "")
    phase = msg.get("phase", "before")  # "before" or "after"

    if not ip:
        await websocket.send(json.dumps({"type": "error", "msg": "ip required for diff capture"}))
        return

    state = {}
    try:
        # Installed packages
        pkgs = subprocess.check_output(
            ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
             f"root@{ip}",
             "rpm -qa --qf '%{NAME}\\n' 2>/dev/null || dpkg -l 2>/dev/null | awk '/^ii/{print $2}' || pacman -Qq 2>/dev/null"],
            text=True, stderr=subprocess.DEVNULL, timeout=15).strip()
        state["packages"] = sorted(pkgs.splitlines())
    except Exception:
        state["packages"] = []

    try:
        # Listening ports
        ports = subprocess.check_output(
            ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
             f"root@{ip}", "ss -tlnp 2>/dev/null"],
            text=True, stderr=subprocess.DEVNULL, timeout=10).strip()
        state["ports"] = ports.splitlines()
    except Exception:
        state["ports"] = []

    try:
        # Running processes
        procs = subprocess.check_output(
            ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
             f"root@{ip}", "ps -eo comm= 2>/dev/null | sort -u"],
            text=True, stderr=subprocess.DEVNULL, timeout=10).strip()
        state["processes"] = sorted(procs.splitlines())
    except Exception:
        state["processes"] = []

    try:
        # Active network connections
        conns = subprocess.check_output(
            ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
             f"root@{ip}", "ss -tnp 2>/dev/null | tail -n +2"],
            text=True, stderr=subprocess.DEVNULL, timeout=10).strip()
        state["connections"] = conns.splitlines()
    except Exception:
        state["connections"] = []

    try:
        # Enabled systemd services
        svcs = subprocess.check_output(
            ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
             f"root@{ip}", "systemctl list-unit-files --state=enabled --no-pager --no-legend 2>/dev/null | awk '{print $1}'"],
            text=True, stderr=subprocess.DEVNULL, timeout=10).strip()
        state["services"] = sorted(svcs.splitlines())
    except Exception:
        state["services"] = []

    await websocket.send(json.dumps({
        "type": "klab_diff_capture",
        "phase": phase,
        "vm": vm,
        "ip": ip,
        "state": state,
    }))


async def _klab_diff_compare(websocket, msg):
    """Compare two captured states and return the diff."""
    before = msg.get("before", {})
    after = msg.get("after", {})

    diff = {}
    for key in ("packages", "processes", "services"):
        b = set(before.get(key, []))
        a = set(after.get(key, []))
        diff[key] = {
            "added": sorted(a - b),
            "removed": sorted(b - a),
        }

    # Ports: compare raw lines
    b_ports = set(before.get("ports", []))
    a_ports = set(after.get("ports", []))
    diff["ports"] = {
        "added": sorted(a_ports - b_ports),
        "removed": sorted(b_ports - a_ports),
    }

    # Connections: just show new ones
    b_conns = set(before.get("connections", []))
    a_conns = set(after.get("connections", []))
    diff["connections"] = {
        "added": sorted(a_conns - b_conns),
        "removed": sorted(b_conns - a_conns),
    }

    await websocket.send(json.dumps({
        "type": "klab_diff_result",
        "diff": diff,
    }))


# ── Hubble integration ───────────────────────────────────────────────────────

async def _klab_hubble_status(websocket):
    """Check if Hubble is running and return status."""
    status = {"running": False, "ui_url": "", "version": ""}
    try:
        out = subprocess.check_output(
            ["hubble", "status", "-o", "json"],
            text=True, stderr=subprocess.DEVNULL, timeout=5)
        data = json.loads(out)
        status["running"] = True
        status["version"] = data.get("version", "")
        # Hubble UI typically on port 12000
        status["ui_url"] = "http://localhost:12000"
    except Exception:
        pass

    # Check if hubble-ui pod/service is running
    try:
        out = subprocess.check_output(
            ["kubectl", "get", "svc", "-n", "kube-system", "hubble-ui",
             "-o", "jsonpath={.spec.ports[0].nodePort}"],
            text=True, stderr=subprocess.DEVNULL, timeout=5)
        if out.strip():
            status["ui_url"] = f"http://localhost:{out.strip()}"
            status["running"] = True
    except Exception:
        pass

    await websocket.send(json.dumps({"type": "klab_hubble_status", "status": status}))


async def _klab_hubble_policy(websocket, msg):
    """Get Cilium network policy verdicts for a specific IP or all."""
    ip = msg.get("ip", "")
    cmd = ["hubble", "observe", "--verdict", "DROPPED", "--last", "50", "-o", "compact"]
    if ip:
        cmd += ["--ip-filter", ip]

    try:
        out = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL, timeout=10)
        await websocket.send(json.dumps({
            "type": "klab_hubble_policy",
            "drops": out.strip().splitlines() if out.strip() else [],
            "ip": ip,
        }))
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "klab_hubble_policy",
            "drops": [],
            "error": str(e),
        }))


async def _klab_hubble_capture(websocket, msg):
    """Capture Hubble flows to JSON for replay."""
    duration = msg.get("duration", 30)
    ip = msg.get("ip", "")
    cmd = ["hubble", "observe", "--last", str(min(duration * 10, 500)), "-o", "json"]
    if ip:
        cmd += ["--ip-filter", ip]

    try:
        out = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL, timeout=duration + 5)
        flows = []
        for line in out.strip().splitlines():
            try:
                flows.append(json.loads(line))
            except Exception:
                pass
        await websocket.send(json.dumps({
            "type": "klab_hubble_capture",
            "flows": flows,
            "count": len(flows),
            "duration": duration,
        }))
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "klab_hubble_capture",
            "flows": [],
            "error": str(e),
        }))


# ── Bob / LLM "Explain this" ──────────────────────────────────────────────────

async def _bob_models(websocket):
    """Check Ollama status and return available models."""
    try:
        import urllib.request
        r = urllib.request.urlopen("http://localhost:11434/api/tags", timeout=3)
        data = json.loads(r.read())
        models = [m["name"] for m in data.get("models", [])]
        await websocket.send(json.dumps({"type": "bob_models", "models": models, "ok": True}))
    except Exception as e:
        await websocket.send(json.dumps({"type": "bob_models", "models": [], "ok": False, "error": str(e)}))


# ── Bob infra tools ────────────────────────────────────────────────────────
# Read-only tools that let Bob answer questions about the fleet without
# needing the user to paste output. Writes (running playbooks, destroying
# VMs) are intentionally NOT exposed — Bob can recommend a playbook, the
# user clicks the button. Keeps the blast radius of a hallucinated tool
# call to zero.
# Execute tools used to require per-call approval — now gated by BOB_AUTONOMOUS.
# When autonomous (default), these run without a modal. The set stays around
# so paranoid mode can still gate on them if the user ever flips autonomy off.
BOB_EXECUTE_TOOLS = {"run_playbook", "bpftrace_oneliner", "bpftrace_script",
                     "shell_run", "shell_run_async", "terminal_send",
                     "tmux_spawn", "tmux_send"}

# Pending confirmations: confirm_id → asyncio.Future. The WS handler's
# `bob_confirm_response` action resolves them. Only used when BOB_AUTONOMOUS=0.
PENDING_CONFIRMS: "dict[str, asyncio.Future]" = {}

# Autonomy: when True (default), Bob runs every tool call immediately with no
# modal. When False, the old per-call approval flow kicks in. Persisted so the
# choice survives a webui restart. Rollback via ZFS covers the "oops" case —
# the user has been clear they don't want safety theatre.
BOB_AUTONOMY_FILE = "/var/lib/kldload/bob-autonomy.json"

def _bob_autonomy_get():
    try:
        with open(BOB_AUTONOMY_FILE) as f:
            return bool(json.load(f).get("autonomous", True))
    except Exception:
        return True   # default on

def _bob_autonomy_set(on: bool):
    try:
        os.makedirs(os.path.dirname(BOB_AUTONOMY_FILE), exist_ok=True)
        with open(BOB_AUTONOMY_FILE, "w") as f:
            json.dump({"autonomous": bool(on)}, f)
    except Exception as e:
        LOG.warning("failed to persist bob autonomy: %s", e)

# Bob autonomous-shell plumbing ─────────────────────────────────────────────
