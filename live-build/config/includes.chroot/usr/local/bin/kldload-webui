                        out = subprocess.check_output(["virsh", "list", "--all", "--name"],
                                                       text=True, stderr=subprocess.DEVNULL)
                        vm_counts["localhost"] = len([l for l in out.strip().splitlines() if l.strip()])
                    except Exception:
                        pass
                    await websocket.send(json.dumps({
                        "type": "infra_status",
                        "clusters": clusters,
                        "nodes": nodes,
                        "vms": vms,
                        "events": events,
                        "vm_counts": vm_counts,
                    }))
                elif action == "cluster_save":
                    # Save a cluster definition to DB (called from Cluster Designer deploy flow)
                    id_ = db_upsert_cluster(
                        msg.get("name", "unnamed"),
                        msg.get("data", {}),
                        template_id=msg.get("template_id", ""),
                        status=msg.get("status", "designing"),
                    )
                    db_log_event("cluster_save", id_, f"Cluster saved: {msg.get('name')}")
                    await websocket.send(json.dumps({"type": "cluster_saved", "id": id_}))
                elif action == "vm_clone":
                    await _vm_clone(websocket, msg)
                elif action == "vm_replace":
                    await _vm_replace(websocket, msg)

                # ── Free-edition actions (ZFS / snapshots / logs) ──────────────
                elif action == "zfs_status":
                    try:
                        out = subprocess.check_output(
                            ["zpool", "status", "-v"], text=True, stderr=subprocess.STDOUT)
                    except Exception as e:
                        out = str(e)
                    await websocket.send(json.dumps({"type": "zfs_status", "output": out}))

                elif action == "snapshot_list":
                    try:
                        out = subprocess.check_output(
                            ["zfs", "list", "-t", "snapshot", "-o", "name,used", "-H"],
                            text=True, stderr=subprocess.STDOUT)
                        snaps = []
                        for line in out.strip().splitlines():
                            parts = line.split('\t')
                            if len(parts) >= 2:
                                snaps.append({"name": parts[0], "used": parts[1]})
                    except Exception:
                        snaps = []
                    await websocket.send(json.dumps({"type": "snapshot_list", "snapshots": snaps}))

                elif action == "snapshot_take":
                    import datetime as _dt
                    ts = _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
                    try:
                        subprocess.check_call(
                            ["zfs", "snapshot", "-r", f"rpool@manual-{ts}"],
                            stderr=subprocess.DEVNULL)
                        await websocket.send(json.dumps({"type": "snapshot_done", "ts": ts}))
                    except Exception as e:
                        await websocket.send(json.dumps({"type": "error", "msg": str(e)}))

                elif action == "snapshot_rollback":
                    snap = msg.get("name", "")
                    try:
                        subprocess.check_call(
                            ["zfs", "rollback", "-r", snap],
                            stderr=subprocess.DEVNULL)
                        await websocket.send(json.dumps({"type": "snapshot_done", "name": snap}))
                    except Exception as e:
                        await websocket.send(json.dumps({"type": "error", "msg": str(e)}))

                elif action == "be_list":
                    try:
                        out = subprocess.check_output(
                            ["/usr/lib/kldload-installer/backend/bin/kldload-be", "list"],
                            text=True, stderr=subprocess.STDOUT)
                    except Exception as e:
                        out = str(e)
                    await websocket.send(json.dumps({"type": "be_list", "output": out}))

                elif action == "be_create":
                    name = msg.get("name", "")
                    try:
                        subprocess.check_call(
                            ["/usr/lib/kldload-installer/backend/bin/kldload-be", "create", name],
                            stderr=subprocess.DEVNULL)
                        await websocket.send(json.dumps({"type": "be_list", "output": f"Created: {name}"}))
                    except Exception as e:
                        await websocket.send(json.dumps({"type": "error", "msg": str(e)}))

                elif action == "read_log":
                    key = msg.get("log", "firstboot")
                    log_path = LOG_FILES.get(key, f"/var/log/kldload/{key}.log")
                    try:
                        content = Path(log_path).read_text(errors="replace")[-32768:]
                    except Exception:
                        content = f"(log not found: {log_path})"
                    await websocket.send(json.dumps({"type": "log_content", "key": key, "content": content}))

                elif action == "install_state":
                    state = {"running": False, "rc": None}
                    try:
                        state = json.loads(INSTALL_STATE_PATH.read_text())
                    except Exception:
                        pass
                    await websocket.send(json.dumps({"type": "install_state", **state}))

                elif action == "network_info":
                    ifaces = []
                    try:
                        out = subprocess.check_output(["ip", "-j", "addr"], text=True)
                        import json as _json
                        for iface in _json.loads(out):
                            name = iface.get("ifname", "")
                            up   = iface.get("operstate", "") in ("UP", "UNKNOWN")
                            addrs = [a.get("local", "") for a in iface.get("addr_info", [])
                                     if a.get("family") in ("inet", "inet6")]
                            ifaces.append({"name": name, "up": up, "addr": ", ".join(addrs)})
                    except Exception:
                        pass
                    await websocket.send(json.dumps({"type": "network_info", "interfaces": ifaces}))

                elif action == "ansible_run":
                    pb     = msg.get("playbook", "")
                    limit  = msg.get("limit", "localhost")
                    extra  = msg.get("extra_vars", {})
                    import json as _json
                    await _auto_snapshot(websocket, "ansible")
                    cmd = ["ansible-playbook", pb, "-i", "localhost,",
                           "--connection", "local", "-l", limit]
                    if extra:
                        cmd += ["--extra-vars", _json.dumps(extra)]
                    await _stream_proc(websocket, cmd, target="ansible_log")

                # ── klab actions ──────────────────────────────────────
                elif action == "klab_cancel":
                    await _klab_cancel(websocket, msg)
                elif action == "klab_status":
                    await _klab_status(websocket)
                elif action == "klab_golden":
                    await _klab_golden(websocket, msg)
                elif action == "klab_verify":
                    await _klab_verify(websocket, msg)
                elif action == "klab_deploy":
                    await _klab_deploy(websocket, msg)
                elif action == "klab_promote":
                    await _klab_promote(websocket, msg)
                elif action == "klab_rollback":
                    await _klab_rollback(websocket)
                elif action == "klab_test":
                    await _klab_test(websocket, msg)
                elif action == "klab_destroy":
                    await _klab_destroy(websocket, msg)
                elif action == "klab_vm_op":
                    await _klab_vm_op(websocket, msg)
                elif action == "klab_isolate":
                    await _klab_isolate(websocket, msg)
                elif action == "klab_metrics":
                    await _klab_metrics(websocket)
                elif action == "klab_flows":
                    await _klab_flows(websocket)
                elif action == "klab_test_results":
                    await _klab_test_results(websocket, msg)
                elif action == "klab_fault":
                    await _klab_fault(websocket, msg)
                elif action == "klab_what_happened":
                    await _klab_what_happened(websocket, msg)
                elif action == "klab_diff_capture":
                    await _klab_diff_capture(websocket, msg)
                elif action == "klab_diff_compare":
                    await _klab_diff_compare(websocket, msg)
                elif action == "klab_hubble_status":
                    await _klab_hubble_status(websocket)
                elif action == "klab_hubble_policy":
                    await _klab_hubble_policy(websocket, msg)
                elif action == "klab_hubble_capture":
                    await _klab_hubble_capture(websocket, msg)
                elif action == "klab_run_playbook":
                    await _klab_run_playbook(websocket, msg)
                elif action == "klab_explain":
                    await _klab_explain(websocket, msg)
                elif action == "bob_list":
                    convos = db_bob_list()
                    await websocket.send(json.dumps({"type": "bob_list", "conversations": convos}))
                elif action == "bob_load":
                    conv = db_bob_load(msg.get("id", ""))
                    if conv:
                        await websocket.send(json.dumps({"type": "bob_loaded", "conversation": conv}))
                    else:
                        await websocket.send(json.dumps({"type": "error", "msg": "conversation not found"}))
                elif action == "bob_save":
                    db_bob_save(msg.get("id", str(uuid.uuid4())), msg.get("title", ""), msg.get("messages", []))
                    await websocket.send(json.dumps({"type": "bob_saved"}))
                elif action == "bob_delete":
                    db_bob_delete(msg.get("id", ""))
                    await websocket.send(json.dumps({"type": "bob_deleted"}))
                elif action == "bob_exec":
                    await _bob_execute(websocket, msg)
                elif action == "klab_ebpf_trace":
                    await _klab_ebpf_trace(websocket, msg)
                elif action == "klab_ebpf_stop":
                    await _klab_ebpf_stop(websocket)

                else:
                    await websocket.send(json.dumps({
                        "type": "error",
                        "msg": f"unknown action: {action}",
                    }))
            except Exception as _action_err:
                LOG.exception("Error handling action %s", action)
                try:
                    await websocket.send(json.dumps({
                        "type": "error",
                        "msg": f"action '{action}' failed: {_action_err}",
                    }))
                except Exception:
                    pass

    except websockets.exceptions.ConnectionClosed:
        LOG.info("WebSocket client disconnected")

async def _wg_gen_keypair(websocket):
    """Generate a fresh WireGuard keypair and return it to the client."""
    try:
        privkey = subprocess.check_output(["wg", "genkey"], text=True).strip()
        pubkey  = subprocess.check_output(["wg", "pubkey"], input=privkey, text=True).strip()
        await websocket.send(json.dumps({
            "type": "wg_keypair",
            "privkey": privkey,
            "pubkey":  pubkey,
        }))
    except Exception as exc:
        await websocket.send(json.dumps({"type": "error", "msg": f"wg genkey failed: {exc}"}))


async def _wg_add_peer(websocket, msg):
    """Add a peer to one or all WireGuard interfaces live via wg set.

    Expected msg fields:
      iface       - "wg0"|"wg1"|"wg2"|"wg3"|"all"
      pubkey      - peer's public key
      allowed_ips - CIDR(s) comma-separated, e.g. "10.77.100.5/32"
      endpoint    - optional "host:port"
    """
    iface       = msg.get("iface", "wg1")
    pubkey      = msg.get("pubkey", "").strip()
    allowed_ips = msg.get("allowed_ips", "").strip()
    endpoint    = msg.get("endpoint", "").strip()

    if not pubkey or not allowed_ips:
        await websocket.send(json.dumps({"type": "error", "msg": "wg_add_peer: pubkey and allowed_ips required"}))
        return

    targets = ["wg0", "wg1", "wg2", "wg3"] if iface == "all" else [iface]
    results = []
    for intf in targets:
        cmd = ["wg", "set", intf, "peer", pubkey, "allowed-ips", allowed_ips]
        if endpoint:
            cmd += ["endpoint", endpoint]
        try:
            subprocess.check_call(cmd, stderr=subprocess.DEVNULL)
            # Persist to wg-quick config if it exists
            conf = f"/etc/wireguard/{intf}.conf"
            if os.path.exists(conf):
                peer_block = f"\n[Peer]\nPublicKey = {pubkey}\nAllowedIPs = {allowed_ips}\n"
                if endpoint:
                    peer_block += f"Endpoint = {endpoint}\n"
                with open(conf, "a") as f:
                    f.write(peer_block)
            results.append({"iface": intf, "ok": True})
        except Exception as exc:
            results.append({"iface": intf, "ok": False, "error": str(exc)})

    await websocket.send(json.dumps({"type": "wg_add_peer_result", "results": results}))
    # Push updated status
    await websocket.send(json.dumps({"type": "wg_data", "data": get_wg_status()}))


async def _wg_remove_peer(websocket, msg):
    """Remove a peer from one or all WireGuard interfaces live via wg set.

    Expected msg fields:
      iface  - "wg0"|"wg1"|"wg2"|"wg3"|"all"
      pubkey - peer's public key to remove
    """
    iface  = msg.get("iface", "wg1")
    pubkey = msg.get("pubkey", "").strip()

    if not pubkey:
        await websocket.send(json.dumps({"type": "error", "msg": "wg_remove_peer: pubkey required"}))
        return

    targets = ["wg0", "wg1", "wg2", "wg3"] if iface == "all" else [iface]
    results = []
    for intf in targets:
        try:
            subprocess.check_call(
                ["wg", "set", intf, "peer", pubkey, "remove"],
                stderr=subprocess.DEVNULL
            )
            # Remove from wg-quick config if it exists
            conf = f"/etc/wireguard/{intf}.conf"
            if os.path.exists(conf):
                with open(conf, "r") as f:
                    content = f.read()
                # Strip the [Peer] block that contains this pubkey
                import re as _re
                content = _re.sub(
                    r"\[Peer\][^\[]*PublicKey\s*=\s*" + _re.escape(pubkey) + r"[^\[]*",
                    "", content, flags=_re.DOTALL
                )
                with open(conf, "w") as f:
                    f.write(content)
            results.append({"iface": intf, "ok": True})
        except Exception as exc:
            results.append({"iface": intf, "ok": False, "error": str(exc)})

    await websocket.send(json.dumps({"type": "wg_remove_peer_result", "results": results}))
    await websocket.send(json.dumps({"type": "wg_data", "data": get_wg_status()}))


async def _stream_proc(websocket, cmd, env=None, target="log"):
    """Run a command, stream stdout/stderr lines to websocket. Trackable + cancellable."""
    await websocket.send(json.dumps({"type": "exec_start", "cmd": str(cmd), "target": target}))
    proc = await asyncio.create_subprocess_exec(
        *cmd,
        stdin=asyncio.subprocess.DEVNULL,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.STDOUT,
        env={**os.environ, **(env or {})},
    )
    RUNNING_PROCS[target] = proc
    try:
        async for line in proc.stdout:
            await websocket.send(json.dumps({
                "type": "log_line",
                "line": line.decode(errors="replace").rstrip(),
                "target": target,
            }))
        rc = await proc.wait()
    except Exception:
        rc = -1
    finally:
        RUNNING_PROCS.pop(target, None)
    await websocket.send(json.dumps({"type": "exec_done", "rc": rc, "target": target}))
    return rc


async def _klab_cancel(websocket, msg):
    """Cancel a running klab operation — kill process, destroy VMs, clean ZFS."""
    target = msg.get("target", "klab")
    proc = RUNNING_PROCS.get(target)

    await websocket.send(json.dumps({
        "type": "log_line", "target": target,
        "line": "\n[cancel] Stopping operation...",
    }))

    # 1. Kill the tracked process
    if proc and proc.returncode is None:
        try:
            proc.kill()
            await proc.wait()
        except Exception:
            pass

    # 2. Kill any klab child processes
    for pattern in ["klab golden", "klab deploy", "klab test", "klab destroy",
                     "virt-install", "qemu-img convert"]:
        subprocess.call(["pkill", "-f", pattern], stderr=subprocess.DEVNULL)

    # 3. Destroy any in-progress golden VMs
    try:
        out = subprocess.check_output(["virsh", "list", "--all", "--name"],
                                       text=True, stderr=subprocess.DEVNULL)
        for line in out.strip().splitlines():
            name = line.strip()
            if name.startswith("klab-golden-"):
                subprocess.call(["virsh", "destroy", name], stderr=subprocess.DEVNULL)
                subprocess.call(["virsh", "undefine", name, "--nvram"],
                                stderr=subprocess.DEVNULL)
                await websocket.send(json.dumps({
                    "type": "log_line", "target": target,
                    "line": f"[cancel] Destroyed VM: {name}",
                }))
    except Exception:
        pass

    # 4. Clean up incomplete ZFS datasets (golden builds that didn't finish)
    try:
        out = subprocess.check_output(["zfs", "list", "-H", "-o", "name"],
                                       text=True, stderr=subprocess.DEVNULL)
        for line in out.strip().splitlines():
            ds = line.strip()
            if "/vms/klab-golden-" in ds:
                # Only destroy if no @golden snapshot (incomplete build)
                snap_check = subprocess.call(
                    ["zfs", "list", "-t", "snapshot", f"{ds}@golden"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if snap_check != 0:
                    subprocess.call(["zfs", "destroy", "-Rf", ds],
                                    stderr=subprocess.DEVNULL)
                    await websocket.send(json.dumps({
                        "type": "log_line", "target": target,
                        "line": f"[cancel] Cleaned up incomplete: {ds}",
                    }))
    except Exception:
        pass

    # 5. Clean up cloud-init ISOs
    try:
        import glob as _glob
        for iso in _glob.glob("/var/lib/libvirt/isos/klab-golden-*-cloud-init.iso"):
            os.remove(iso)
    except Exception:
        pass

    RUNNING_PROCS.pop(target, None)
    await websocket.send(json.dumps({
        "type": "log_line", "target": target,
        "line": "[cancel] Cleanup complete.",
    }))
    await websocket.send(json.dumps({"type": "exec_done", "rc": -1, "target": target}))
    LOG.info("Cancelled and cleaned up: %s", target)

async def _run_wipe_disk(websocket, msg):
    disk = msg.get("disk", "")
    mode = msg.get("mode", "quick")
    if not re.match(r'^/dev/[a-z]{2,8}[0-9]{0,3}$', disk):
        await websocket.send(json.dumps({"type": "error", "msg": f"Invalid disk: {disk}"}))
        return

    # Common cleanup: UEFI boot entries only. MOK keys are NOT touched —
    # wiping MOK breaks Secure Boot on the next install since the new MOK
    # key can't be enrolled until the OS boots, creating a chicken-and-egg
    # problem. Stale MOK keys in NVRAM are harmless.
    cleanup_uefi_mok = """
echo "Cleaning UEFI boot entries..."
if command -v efibootmgr >/dev/null 2>&1; then
    for entry in $(efibootmgr 2>/dev/null | grep -iE "kldload|ZFSBootMenu|UEFI OS|RedHat|centos|rocky|fedora|debian|ubuntu|${DISK##*/}" | grep -oP 'Boot\\K[0-9A-Fa-f]+' || true); do
        efibootmgr -b "$entry" -B 2>/dev/null && echo "  Removed Boot$entry" || true
    done
fi
# Clear any pending MOK import/delete requests (but don't wipe enrolled keys)
if command -v mokutil >/dev/null 2>&1; then
    mokutil --revoke-import 2>/dev/null && echo "  Pending MOK imports cleared" || true
    mokutil --revoke-delete 2>/dev/null && echo "  Pending MOK deletes cleared" || true
    ENROLLED=$(mokutil --list-enrolled 2>/dev/null | grep -c 'SHA1' || echo 0)
    echo "  MOK keys enrolled: $ENROLLED (preserved for Secure Boot)"
fi
"""

    if mode == "full":
        # Full dd zero-fill with progress
        cmd = ["bash", "-c", f"""
DISK={shlex.quote(disk)}
SIZE_BYTES=$(blockdev --getsize64 "$DISK" 2>/dev/null || echo 0)
SIZE_MB=$((SIZE_BYTES / 1048576))
SIZE_GB=$((SIZE_BYTES / 1073741824))
echo "══════════════════════════════════════════════════"
echo "  FULL ZERO-FILL: $DISK (${{SIZE_GB}} GB)"
echo "══════════════════════════════════════════════════"
echo ""

echo "Step 1/4: Unmounting and exporting ZFS pools..."
umount -R /target/boot/efi 2>/dev/null || true
umount -R /target 2>/dev/null || true
for pool in $(zpool list -H -o name 2>/dev/null); do
    zpool status "$pool" 2>/dev/null | grep -q "${{DISK##*/}}" && \
        {{ zpool export -f "$pool" 2>/dev/null || zpool destroy -f "$pool" 2>/dev/null || true; echo "  Exported: $pool"; }}
done

echo "Step 2/4: Zero-filling entire disk..."
WRITTEN=0
while true; do
    dd if=/dev/zero of="$DISK" bs=1M count=1024 seek=$WRITTEN conv=notrunc 2>/dev/null || break
    WRITTEN=$((WRITTEN + 1024))
    if [ "$SIZE_MB" -gt 0 ]; then
        PCT=$((WRITTEN * 100 / SIZE_MB))
        [ "$PCT" -gt 100 ] && PCT=100
        echo "  ${{WRITTEN}} / ${{SIZE_MB}} MB  (${{PCT}}%)"
    fi
    [ "$SIZE_MB" -gt 0 ] && [ "$WRITTEN" -ge "$SIZE_MB" ] && break
done
echo "  Done"

echo "Step 3/4: Cleaning UEFI + MOK..."
{cleanup_uefi_mok}
echo "  Done"

echo "Step 4/4: Refreshing partition table..."
partprobe "$DISK" 2>/dev/null || true
sync
echo ""
echo "══════════════════════════════════════════════════"
echo "  FULL WIPE COMPLETE — $DISK zeroed (${{SIZE_GB}} GB)"
echo "══════════════════════════════════════════════════"
"""]
    else:
        # Quick wipe: labels + GPT + first/last 10MB + UEFI + MOK
        cmd = ["bash", "-c", f"""
DISK={shlex.quote(disk)}
SIZE_BYTES=$(blockdev --getsize64 "$DISK" 2>/dev/null || echo 0)
SIZE_GB=$((SIZE_BYTES / 1073741824))
echo "══════════════════════════════════════════════════"
echo "  QUICK WIPE: $DISK (${{SIZE_GB}} GB)"
echo "══════════════════════════════════════════════════"
echo ""

echo "Step 1/6: Unmounting and exporting ZFS pools..."
umount -R /target/boot/efi 2>/dev/null || true
umount -R /target 2>/dev/null || true
for pool in $(zpool list -H -o name 2>/dev/null); do
    zpool status "$pool" 2>/dev/null | grep -q "${{DISK##*/}}" && \
        {{ zpool export -f "$pool" 2>/dev/null || zpool destroy -f "$pool" 2>/dev/null || true; echo "  Exported: $pool"; }}
done
echo "  Done"

echo "Step 2/6: Clearing ZFS labels on all partitions..."
for part in "${{DISK}}"*; do
    [ -b "$part" ] || continue
    zpool labelclear -f "$part" 2>/dev/null || true
    wipefs -a -f "$part" 2>/dev/null || true
done
echo "  Done"

echo "Step 3/6: Wiping partition table (GPT + MBR)..."
sgdisk --zap-all "$DISK" 2>/dev/null || true
echo "  Done"

echo "Step 4/6: Zeroing first and last 10MB..."
dd if=/dev/zero of="$DISK" bs=1M count=10 2>/dev/null || true
dd if=/dev/zero of="$DISK" bs=1M seek=$((SIZE_GB * 1024 - 10)) count=10 2>/dev/null || true
echo "  Done"

echo "Step 5/6: Cleaning UEFI + MOK..."
{cleanup_uefi_mok}
echo "  Done"

echo "Step 6/6: Refreshing partition table..."
partprobe "$DISK" 2>/dev/null || true
sync
echo ""
echo "══════════════════════════════════════════════════"
echo "  QUICK WIPE COMPLETE — $DISK clean (${{SIZE_GB}} GB)"
echo "══════════════════════════════════════════════════"
"""]
    await _stream_proc(websocket, cmd, target="install")

INSTALL_STATE_PATH = Path("/run/kldload/install_state.json")

def _detect_distro():
    """Detect the running distro from os-release."""
    try:
        with open("/etc/os-release") as f:
            for line in f:
                if line.startswith("ID="):
                    val = line.strip().split("=", 1)[1].strip('"')
                    if val in ("centos", "rocky", "rhel", "almalinux"):
                        return "centos" if val == "almalinux" else val
                    if val in ("debian", "ubuntu"):
                        return val
    except Exception:
        pass
    return "centos"  # default for kldload

async def _test_rhel_cdn(websocket, msg):
    """Test RHEL CDN connectivity and subscription validity."""
    params = msg.get("params", {})
    key = params.get("rhel_key", "")
    org = params.get("rhel_org", "")
    try:
        # Test 1: Try with proper cert verification
        proc = await asyncio.create_subprocess_exec(
            "curl", "-s", "--connect-timeout", "10", "-o", "/dev/null", "-w", "%{http_code}",
            "https://subscription.rhsm.redhat.com/",
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await asyncio.wait_for(proc.communicate(), timeout=15)
        http_code = stdout.decode().strip()
        if http_code != "000":
            await websocket.send(json.dumps({
                "type": "rhel_cdn_result", "ok": True, "error": None
            }))
            return
        # Test 2: Try with -k (skip cert verify) — CDN may use Red Hat's own CA
        proc2 = await asyncio.create_subprocess_exec(
            "curl", "-sk", "--connect-timeout", "10", "-o", "/dev/null", "-w", "%{http_code}",
            "https://subscription.rhsm.redhat.com/",
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE
        )
        stdout2, _ = await asyncio.wait_for(proc2.communicate(), timeout=15)
        http_code2 = stdout2.decode().strip()
        if http_code2 != "000":
            await websocket.send(json.dumps({
                "type": "rhel_cdn_result", "ok": True,
                "error": None
            }))
            return
        await websocket.send(json.dumps({
            "type": "rhel_cdn_result", "ok": False,
            "error": "Cannot reach subscription.rhsm.redhat.com — check network/firewall"
        }))
    except asyncio.TimeoutError:
        await websocket.send(json.dumps({
            "type": "rhel_cdn_result", "ok": False,
            "error": "Connection timed out — CDN unreachable"
        }))
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "rhel_cdn_result", "ok": False,
            "error": str(e)
        }))


async def _run_install(websocket, msg):
    params = msg.get("params", {})
    # Map frontend 'role' → KLDLOAD_PROFILE (installer key)
    if "role" in params and "profile" not in params:
        params["profile"] = params.pop("role")
    # Auto-detect distro if not specified
    if "distro" not in params:
        params["distro"] = _detect_distro()
    answers = []
    for k, v in params.items():
        key = k.upper()
        if not key.startswith("KLDLOAD_"):
            key = f"KLDLOAD_{key}"
        answers.append(f"{key}={shlex.quote(str(v))}")

    answers_path = "/tmp/kldload-webui-answers.env"
    with open(answers_path, "w") as f:
        f.write("\n".join(answers) + "\n")
    os.chmod(answers_path, 0o600)

    # Persist install state so reconnecting clients can restore UI
    INSTALL_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    INSTALL_STATE_PATH.write_text(json.dumps({"running": True, "rc": None}))

    target = msg.get("_target", "install")
    rc = await _stream_proc(websocket,
        ["/usr/local/bin/kldload-install-target", "--config", answers_path],
        target=target)
    INSTALL_STATE_PATH.write_text(json.dumps({"running": False, "rc": rc}))

async def _run_spawn(websocket, msg):
    params = msg.get("params", {})
    cmd = ["/usr/local/sbin/kldload-spawn"]
    for k, v in params.items():
        cmd += [f"--{k.replace('_','-')}", str(v)]
    target = msg.get("_target", "spawn")
    await _stream_proc(websocket, cmd, target=target)

async def _run_golden(websocket, msg):
    template = msg.get("template", "kvm")
    if not re.match(r'^(master|kvm|storage|vdi)$', template):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid template"}))
        return
    target = msg.get("_target", "golden")
    cmd = ["/usr/local/sbin/kldload-golden", "--template", template]
    await _stream_proc(websocket, cmd, target=target)

async def _run_stamp(websocket, msg):
    template   = msg.get("template", "kvm")
    count      = int(msg.get("count", 1))
    base_index = int(msg.get("base_index", 1))
    color      = msg.get("color", "blue")
    if not re.match(r'^(master|kvm|storage|vdi|firewall|proxmox|monitoring|storage|worker|etcd|lb|landing)$', template):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid template"}))
        return
    if color not in ("blue", "green"):
        color = "blue"
    target     = msg.get("_target", "golden")
    golden_dir = Path("/var/lib/kldload/golden")
    image_path = golden_dir / f"golden-{template}.qcow2"
    if not image_path.exists():
        await websocket.send(json.dumps({"type": "error", "msg": f"Golden image not found: {image_path}"}))
        return
    for i in range(count):
        idx      = base_index + i
        hostname = f"{template}-{idx:02d}"
        clone    = golden_dir / f"{hostname}.qcow2"
        # Create CoW clone
        rc = await _stream_proc(websocket,
            ["qemu-img", "create", "-f", "qcow2", "-b", str(image_path), "-F", "qcow2", str(clone)],
            target=target)
        if rc != 0:
            break
        # Stamp identity into clone
        rc = await _stream_proc(websocket,
            ["/usr/local/sbin/kldload-stamp-identity",
             "--image",    str(clone),
             "--hostname", hostname,
             "--template", template,
             "--index",    str(idx),
             "--color",    color],
            target=target)
        if rc != 0:
            break

async def _run_k8s_join(websocket, msg):
    role   = msg.get("role", "worker")
    target = msg.get("_target", "log")
    if role not in ("worker", "etcd"):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid role"}))
        return
    cmd = ["/usr/local/sbin/kldload-k8s-join", "--role", role]
    await _stream_proc(websocket, cmd, target=target)

async def _run_salt_highstate(websocket, msg):
    salt_target = msg.get("target", "*")
    ws_target   = msg.get("_target", "log")
    if not re.match(r'^[a-zA-Z0-9_\-\*]+$', salt_target):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid salt target"}))
