#!/usr/bin/env python3
"""
kldload-webui — lightweight web-based installer UI for KLDload.
Serves a browser frontend and exposes a WebSocket API so the browser
can drive installs, spawns, and VM management without a terminal.

Usage:
  kldload-webui [--port PORT] [--bind ADDR] [--no-browser]
"""
import argparse
import asyncio
import datetime
import json
import logging
import os
import re
import shlex
import sqlite3
import ssl
import subprocess
import sys
import threading
import time
import uuid
from http.server import HTTPServer, SimpleHTTPRequestHandler
from pathlib import Path

try:
    import yaml
except ImportError:
    yaml = None

try:
    import websockets
except ImportError:
    print("[kldload-webui] Installing websockets...")
    subprocess.check_call([sys.executable, "-m", "pip", "install", "--quiet", "websockets"])
    import websockets

LOG = logging.getLogger("kldload-webui")
logging.basicConfig(level=logging.INFO, format="[%(asctime)s] [webui] %(message)s",
                    datefmt="%Y-%m-%dT%H:%M:%S")

# Serve from edition-specific UI directory.
# build-iso.sh copies the right edition into 'active/' at build time.
# Fall back to base dir if active/ doesn't exist yet.
_WEBUI_BASE = Path("/usr/local/share/kldload-webui")
_WEBUI_ACTIVE = _WEBUI_BASE / "active"
WEBUI_DIR = _WEBUI_ACTIVE if _WEBUI_ACTIVE.is_dir() else _WEBUI_BASE

EDITION = Path("/etc/kldload/edition").read_text().strip() if Path("/etc/kldload/edition").exists() else "free"
MANIFEST         = Path("/etc/kldload/install-manifest.env")
CREDENTIALS_PATH = Path("/run/kldload/credentials.json")
DB_PATH          = Path("/var/lib/kldload/state.db")
LOG_FILES  = {
    "installer": "/var/log/installer/kldload-installer.log",
    "storage":   "/var/log/installer/storage.log",
    "network":   "/var/log/installer/network.log",
    "bootstrap": "/var/log/installer/bootstrap.log",
    "snapshots": "/var/log/kldload/snapshots.log",
    "firstboot": "/var/log/kldload/firstboot.log",
    "autoboot":  "/var/log/kldload/autobootstrap.log",
    "audit":     "/var/log/kldload/audit.log",
}

# ── State database ─────────────────────────────────────────────────────────────

def _db_now():
    return datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")

def _db_connect():
    con = sqlite3.connect(DB_PATH)
    con.row_factory = sqlite3.Row
    con.execute("PRAGMA journal_mode=WAL")
    return con

def db_init():
    """Create state.db and all tables if not present."""
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    con = _db_connect()
    con.executescript("""
    CREATE TABLE IF NOT EXISTS templates (
        id          TEXT PRIMARY KEY,
        type        TEXT NOT NULL,
        name        TEXT NOT NULL,
        description TEXT DEFAULT '',
        data        TEXT NOT NULL,
        created_at  TEXT NOT NULL,
        updated_at  TEXT NOT NULL
    );
    CREATE TABLE IF NOT EXISTS nodes (
        id          TEXT PRIMARY KEY,
        hostname    TEXT NOT NULL UNIQUE,
        role        TEXT DEFAULT 'unknown',
        ip_mgmt     TEXT DEFAULT '',
        ip_wg0      TEXT DEFAULT '',
        ip_wg1      TEXT DEFAULT '',
        ip_wg2      TEXT DEFAULT '',
        ip_wg3      TEXT DEFAULT '',
        wg_pubkey   TEXT DEFAULT '',
        cluster_id  TEXT DEFAULT '',
        status      TEXT DEFAULT 'unknown',
        last_seen   TEXT DEFAULT '',
        facts       TEXT DEFAULT '{}',
        created_at  TEXT NOT NULL
    );
    CREATE TABLE IF NOT EXISTS clusters (
        id          TEXT PRIMARY KEY,
        name        TEXT NOT NULL UNIQUE,
        template_id TEXT DEFAULT '',
        status      TEXT DEFAULT 'designing',
        data        TEXT NOT NULL,
        created_at  TEXT NOT NULL,
        updated_at  TEXT NOT NULL
    );
    CREATE TABLE IF NOT EXISTS vms (
        id          TEXT PRIMARY KEY,
        cluster_id  TEXT NOT NULL,
        node_id     TEXT DEFAULT '',
        name        TEXT NOT NULL,
        role        TEXT NOT NULL,
        cpu         INTEGER DEFAULT 2,
        ram_gb      INTEGER DEFAULT 4,
        disk_gb     INTEGER DEFAULT 64,
        status      TEXT DEFAULT 'defined',
        golden_src  TEXT DEFAULT '',
        ip_addr     TEXT DEFAULT '',
        wg_pubkey   TEXT DEFAULT '',
        last_seen   TEXT DEFAULT '',
        data        TEXT DEFAULT '{}',
        created_at  TEXT NOT NULL
    );
    CREATE TABLE IF NOT EXISTS events (
        id          INTEGER PRIMARY KEY AUTOINCREMENT,
        ts          TEXT NOT NULL,
        type        TEXT NOT NULL,
        subject     TEXT DEFAULT '',
        message     TEXT NOT NULL,
        data        TEXT DEFAULT '{}'
    );
    CREATE TABLE IF NOT EXISTS services (
        id           TEXT PRIMARY KEY,
        name         TEXT NOT NULL UNIQUE,
        description  TEXT DEFAULT '',
        cluster_id   TEXT DEFAULT '',
        node_targets TEXT DEFAULT '[]',
        dataset      TEXT DEFAULT '',
        image        TEXT DEFAULT '',
        runtime      TEXT DEFAULT 'systemd',
        status       TEXT DEFAULT 'defined',
        version      TEXT DEFAULT '',
        replicas     INTEGER DEFAULT 1,
        repl_targets TEXT DEFAULT '[]',
        config       TEXT DEFAULT '{}',
        salt_state   TEXT DEFAULT '',
        created_at   TEXT NOT NULL,
        updated_at   TEXT NOT NULL
    );
    CREATE TABLE IF NOT EXISTS bob_conversations (
        id          TEXT PRIMARY KEY,
        title       TEXT DEFAULT 'New conversation',
        messages    TEXT NOT NULL DEFAULT '[]',
        created_at  TEXT NOT NULL,
        updated_at  TEXT NOT NULL
    );
    -- Deployment ledger: every run of a kldload-shipped playbook against a
    -- cluster or node lands here. User-uploaded content is NOT tracked —
    -- the application layer is the user's responsibility.
    CREATE TABLE IF NOT EXISTS deployments (
        id          INTEGER PRIMARY KEY AUTOINCREMENT,
        cluster_id  TEXT DEFAULT '',
        target      TEXT DEFAULT '',
        playbook    TEXT NOT NULL,
        extras      TEXT DEFAULT '{}',
        status      TEXT DEFAULT 'running',
        rc          INTEGER DEFAULT -1,
        log_path    TEXT DEFAULT '',
        started_at  TEXT NOT NULL,
        finished_at TEXT DEFAULT ''
    );
    -- Secrets at rest. value_enc is Fernet-encrypted with the master key at
    -- /var/lib/kldload/master.key (mode 0600). Used for SSH keys, kubeconfig,
    -- Helm repo creds, etc. Never log or transmit the decrypted value.
    CREATE TABLE IF NOT EXISTS secrets (
        name        TEXT PRIMARY KEY,
        value_enc   TEXT NOT NULL,
        created_at  TEXT NOT NULL,
        updated_at  TEXT NOT NULL
    );
    """)
    # Additive migrations — ALTER TABLE IF NOT EXISTS isn't a thing in SQLite,
    # so we inspect pragma_table_info and add missing columns idempotently.
    def _ensure_col(table, col, decl):
        cols = {r["name"] for r in con.execute(f"PRAGMA table_info({table})").fetchall()}
        if col not in cols:
            con.execute(f"ALTER TABLE {table} ADD COLUMN {col} {decl}")
    _ensure_col("nodes", "deleted_at", "TEXT DEFAULT ''")
    _ensure_col("vms",   "deleted_at", "TEXT DEFAULT ''")
    con.commit()
    con.close()
    LOG.info("State DB ready: %s", DB_PATH)

# ── Bob conversation persistence ──────────────────────────────────────────────

# ── Secrets at rest (ZFS native encryption) ───────────────────────────────────
# Why ZFS and not per-row Fernet: we're already running on ZFS and it provides
# block-level encryption with key management for free. Secrets live as plain
# files inside an encrypted dataset at /var/lib/kldload/secrets/. The DB only
# tracks names + timestamps (never values). On boot, systemd loads the ZFS
# key and mounts the dataset; the webui just reads/writes normal files.
#
# Threat model this handles:
#   - Disk imaged or stolen → dataset is encrypted, bytes unreadable
#   - Backup of state.db leaked → DB has names only, no ciphertext even
#   - Cold boot before key is loaded → files unreadable
# Threat model this does NOT handle:
#   - Anyone with root on a running box (can read the loaded key + files)
#
# Fallback hierarchy:
#   1. ZFS encrypted dataset (preferred, proper at-rest)
#   2. Fernet per-file (if `cryptography` is installed but no ZFS)
#   3. Plain files mode 0600 (dev / non-ZFS — logs a warning)

# kldload ZFS namespace — parent + 4 purpose-specific datasets. Every dataset
# carries `com.kldload:*` user properties so `zfs get -r com.kldload:role rpool`
# shows exactly what belongs to us. Non-kldload datasets are untouched.
KLDLOAD_ZFS_PARENT   = "rpool/kldload"
KLDLOAD_ZFS_VERSION  = "1.1.0"
SECRETS_DIR          = Path("/var/lib/kldload/secrets")
SECRETS_DATASET      = f"{KLDLOAD_ZFS_PARENT}/secrets"
STATE_DIR            = Path("/var/lib/kldload")
STATE_DATASET        = f"{KLDLOAD_ZFS_PARENT}/state"
PLAYBOOKS_DIR        = Path("/var/lib/kldload/user-playbooks")
PLAYBOOKS_DATASET    = f"{KLDLOAD_ZFS_PARENT}/playbooks"
ZFS_KEY_PATH         = Path("/var/lib/kldload/zfs-secrets.key")

def _is_zfs_mount(path: Path) -> bool:
    try:
        out = subprocess.check_output(["findmnt", "-n", "-o", "FSTYPE", str(path)],
                                      text=True, stderr=subprocess.DEVNULL, timeout=3)
        return out.strip() == "zfs"
    except Exception:
        return False

def _dataset_exists(ds: str) -> bool:
    try:
        subprocess.check_output(["zfs", "list", "-H", ds],
                                stderr=subprocess.DEVNULL, timeout=3)
        return True
    except Exception:
        return False

def _have_rpool() -> bool:
    try:
        subprocess.check_output(["zpool", "list", "-H", "rpool"],
                                stderr=subprocess.DEVNULL, timeout=3)
        return True
    except Exception:
        return False

def _zfs_create(ds: str, props: dict, role: str, purpose: str):
    """Create ds with the given properties plus kldload labels. Idempotent."""
    if _dataset_exists(ds):
        return
    cmd = ["zfs", "create"]
    for k, v in props.items():
        cmd += ["-o", f"{k}={v}"]
    cmd += [
        "-o", f"com.kldload:role={role}",
        "-o", f"com.kldload:purpose={purpose}",
        "-o", f"com.kldload:version={KLDLOAD_ZFS_VERSION}",
    ]
    cmd.append(ds)
    subprocess.run(cmd, check=False, stderr=subprocess.DEVNULL, timeout=15)

def _ensure_kldload_datasets():
    """Create the full kldload ZFS namespace if we're on rpool. Properties are
    set at creation time — setuid/exec/devices off on secrets, zstd compression
    throughout, quotas to prevent disk-full attacks."""
    # Never adopt a target-disk rpool from the live ISO. If the user previously
    # installed (or partially installed) kldload, sda will have rpool/kldload/*
    # datasets; auto-importing them and remounting over /var/lib/kldload leaves
    # the live webui owning stale, possibly encrypted, root-owned state and
    # locks out non-root shells. Live ISO always runs plain-mode.
    if is_live_mode():
        if _have_rpool():
            LOG.warning("Live ISO boot detected a pre-existing rpool — "
                        "ignoring rpool/kldload state, using plain-mode secrets")
        return False
    if not _have_rpool():
        return False

    # Parent — canmount=off, so it's a pure namespace, not mounted anywhere.
    _zfs_create(KLDLOAD_ZFS_PARENT,
                {"canmount": "off", "mountpoint": "none"},
                role="root", purpose="kldload application datasets")

    # State — DB + webui bookkeeping. Not encrypted (names + timestamps only,
    # no values live here). zstd saves space; recordsize tuned for SQLite.
    _zfs_create(STATE_DATASET,
                {"compression": "zstd", "atime": "off", "xattr": "sa",
                 "recordsize": "16K", "mountpoint": str(STATE_DIR),
                 "com.sun:auto-snapshot": "true"},
                role="state", purpose="kldload state DB + webui data")

    # Playbooks — user uploads. zstd compresses YAML well. No encryption
    # (playbooks are operational content, not credentials).
    _zfs_create(PLAYBOOKS_DATASET,
                {"compression": "zstd", "atime": "off",
                 "mountpoint": str(PLAYBOOKS_DIR),
                 "setuid": "off", "exec": "off", "devices": "off",
                 "quota": "1G"},
                role="playbooks", purpose="user-uploaded Ansible playbooks")

    # Secrets — native ZFS encryption. No setuid / exec / device nodes. Hard
    # quota so a runaway upload can't fill rpool.
    if not _dataset_exists(SECRETS_DATASET):
        if not ZFS_KEY_PATH.exists():
            ZFS_KEY_PATH.parent.mkdir(parents=True, exist_ok=True)
            ZFS_KEY_PATH.write_bytes(os.urandom(32))
            os.chmod(ZFS_KEY_PATH, 0o600)
        _zfs_create(SECRETS_DATASET,
                    {"encryption": "aes-256-gcm",
                     "keyformat": "raw",
                     "keylocation": f"file://{ZFS_KEY_PATH}",
                     "compression": "zstd",
                     "atime": "off",
                     "setuid": "off", "exec": "off", "devices": "off",
                     "quota": "100M",
                     "mountpoint": str(SECRETS_DIR)},
                    role="secrets",
                    purpose="encrypted credential + key store")
    # Load key + mount (no-op if already done).
    subprocess.run(["zfs", "load-key", SECRETS_DATASET],
                   check=False, stderr=subprocess.DEVNULL, timeout=5)
    for ds in (STATE_DATASET, PLAYBOOKS_DATASET, SECRETS_DATASET):
        subprocess.run(["zfs", "mount", ds],
                       check=False, stderr=subprocess.DEVNULL, timeout=5)
    return True

def _ensure_secrets_dir():
    """Initialize the kldload ZFS namespace + fall back to a plain 0700 dir
    if ZFS isn't available. Idempotent, safe to call repeatedly."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if _is_zfs_mount(SECRETS_DIR):
        os.chmod(SECRETS_DIR, 0o700)
        return "zfs"
    if _ensure_kldload_datasets() and _is_zfs_mount(SECRETS_DIR):
        os.chmod(SECRETS_DIR, 0o700)
        return "zfs"
    # Non-ZFS fallback (dev, live ISO before install)
    SECRETS_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(SECRETS_DIR, 0o700)
    return "plain"

def _safe_secret_path(name: str) -> Path:
    """Sanitize name — no path traversal, ascii alphanum + dash/underscore/dot."""
    clean = "".join(c for c in name if c.isalnum() or c in "-_.")
    if not clean or clean.startswith("."):
        raise ValueError("invalid secret name")
    return SECRETS_DIR / clean

def secrets_backend():
    """Returns 'zfs', 'plain' — what's actually protecting the bytes."""
    if _is_zfs_mount(SECRETS_DIR):
        return "zfs"
    return "plain"

def secret_set(name, value):
    _ensure_secrets_dir()
    p = _safe_secret_path(name)
    # Write atomically + 0600. Never log the value.
    tmp = p.with_suffix(p.suffix + ".tmp")
    tmp.write_text(value)
    os.chmod(tmp, 0o600)
    os.replace(tmp, p)

    con = _db_connect()
    now = _db_now()
    row = con.execute("SELECT name FROM secrets WHERE name=?", (name,)).fetchone()
    # value_enc column holds the storage path now, not ciphertext. The actual
    # bytes live on the encrypted dataset.
    storage = f"file:{p}"
    if row:
        con.execute("UPDATE secrets SET value_enc=?, updated_at=? WHERE name=?",
                    (storage, now, name))
    else:
        con.execute("INSERT INTO secrets (name, value_enc, created_at, updated_at) "
                    "VALUES (?,?,?,?)", (name, storage, now, now))
    con.commit()
    con.close()

def secret_get(name):
    _ensure_secrets_dir()
    try:
        p = _safe_secret_path(name)
    except ValueError:
        return None
    if not p.exists():
        return None
    try:
        return p.read_text()
    except Exception:
        return None

def secret_list():
    """Metadata only — names + timestamps + backend indicator. No values."""
    con = _db_connect()
    rows = con.execute(
        "SELECT name, created_at, updated_at FROM secrets ORDER BY name"
    ).fetchall()
    con.close()
    return [dict(r) for r in rows]

def secret_delete(name):
    try:
        p = _safe_secret_path(name)
        if p.exists():
            p.unlink()
    except Exception:
        pass
    con = _db_connect()
    con.execute("DELETE FROM secrets WHERE name=?", (name,))
    con.commit()
    con.close()


def db_bob_list():
    """List all Bob conversations, newest first."""
    con = _db_connect()
    rows = con.execute(
        "SELECT id, title, created_at, updated_at FROM bob_conversations ORDER BY updated_at DESC"
    ).fetchall()
    con.close()
    return [dict(r) for r in rows]

def db_bob_load(conv_id):
    """Load a Bob conversation by ID."""
    con = _db_connect()
    row = con.execute(
        "SELECT id, title, messages, created_at, updated_at FROM bob_conversations WHERE id=?",
        (conv_id,)
    ).fetchone()
    con.close()
    if row:
        result = dict(row)
        result["messages"] = json.loads(result["messages"])
        return result
    return None

def db_bob_save(conv_id, title, messages):
    """Create or update a Bob conversation."""
    con = _db_connect()
    now = _db_now()
    row = con.execute("SELECT id FROM bob_conversations WHERE id=?", (conv_id,)).fetchone()
    if row:
        con.execute(
            "UPDATE bob_conversations SET title=?, messages=?, updated_at=? WHERE id=?",
            (title, json.dumps(messages), now, conv_id)
        )
    else:
        con.execute(
            "INSERT INTO bob_conversations (id, title, messages, created_at, updated_at) VALUES (?,?,?,?,?)",
            (conv_id, title, json.dumps(messages), now, now)
        )
    con.commit()
    con.close()
    return conv_id

def db_bob_delete(conv_id):
    """Delete a Bob conversation."""
    con = _db_connect()
    con.execute("DELETE FROM bob_conversations WHERE id=?", (conv_id,))
    con.commit()
    con.close()

# ── Template CRUD ─────────────────────────────────────────────────────────────

def db_save_template(type_, name, description, data):
    """Insert or update a template by type+name. Returns the id."""
    con = _db_connect()
    now = _db_now()
    row = con.execute(
        "SELECT id FROM templates WHERE type=? AND name=?", (type_, name)
    ).fetchone()
    if row:
        id_ = row["id"]
        con.execute(
            "UPDATE templates SET description=?,data=?,updated_at=? WHERE id=?",
            (description, json.dumps(data), now, id_)
        )
    else:
        id_ = str(uuid.uuid4())
        con.execute(
            "INSERT INTO templates (id,type,name,description,data,created_at,updated_at) "
            "VALUES (?,?,?,?,?,?,?)",
            (id_, type_, name, description, json.dumps(data), now, now)
        )
    con.commit()
    con.close()
    return id_

def db_list_templates(type_=None):
    """List templates, optionally filtered by type, newest first."""
    con = _db_connect()
    if type_:
        rows = con.execute(
            "SELECT id,type,name,description,created_at,updated_at "
            "FROM templates WHERE type=? ORDER BY updated_at DESC", (type_,)
        ).fetchall()
    else:
        rows = con.execute(
            "SELECT id,type,name,description,created_at,updated_at "
            "FROM templates ORDER BY type,updated_at DESC"
        ).fetchall()
    result = [dict(r) for r in rows]
    con.close()
    return result

def db_load_template(id_):
    """Load a full template by id. Returns dict with data parsed, or None."""
    con = _db_connect()
    row = con.execute("SELECT * FROM templates WHERE id=?", (id_,)).fetchone()
    con.close()
    if not row:
        return None
    d = dict(row)
    try:
        d["data"] = json.loads(d["data"])
    except Exception:
        pass
    return d

def db_delete_template(id_):
    con = _db_connect()
    con.execute("DELETE FROM templates WHERE id=?", (id_,))
    con.commit()
    con.close()

def db_register_node(hostname, role="unknown", ip_mgmt="", ip_wg0="", ip_wg1="",
                     ip_wg2="", ip_wg3="", wg_pubkey="", cluster_id="", facts=None):
    """Upsert a node into the inventory. Returns the node id."""
    con = _db_connect()
    now = _db_now()
    facts_str = json.dumps(facts or {})
    row = con.execute("SELECT id FROM nodes WHERE hostname=?", (hostname,)).fetchone()
    if row:
        id_ = row["id"]
        con.execute(
            "UPDATE nodes SET role=?,ip_mgmt=?,ip_wg0=?,ip_wg1=?,ip_wg2=?,ip_wg3=?,"
            "wg_pubkey=?,cluster_id=?,status='online',last_seen=?,facts=? WHERE hostname=?",
            (role, ip_mgmt, ip_wg0, ip_wg1, ip_wg2, ip_wg3,
             wg_pubkey, cluster_id, now, facts_str, hostname)
        )
    else:
        id_ = str(uuid.uuid4())
        con.execute(
            "INSERT INTO nodes (id,hostname,role,ip_mgmt,ip_wg0,ip_wg1,ip_wg2,ip_wg3,"
            "wg_pubkey,cluster_id,status,last_seen,facts,created_at) "
            "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
            (id_, hostname, role, ip_mgmt, ip_wg0, ip_wg1, ip_wg2, ip_wg3,
             wg_pubkey, cluster_id, "online", now, facts_str, now)
        )
    con.commit()
    con.close()
    return id_

def db_list_nodes():
    con = _db_connect()
    rows = con.execute(
        "SELECT * FROM nodes ORDER BY role,hostname"
    ).fetchall()
    result = []
    for r in rows:
        d = dict(r)
        try:    d["facts"] = json.loads(d["facts"])
        except Exception: d["facts"] = {}
        result.append(d)
    con.close()
    return result

def db_log_event(type_, subject, message, data=None):
    con = _db_connect()
    con.execute(
        "INSERT INTO events (ts,type,subject,message,data) VALUES (?,?,?,?,?)",
        (_db_now(), type_, subject, message, json.dumps(data or {}))
    )
    con.commit()
    con.close()

def db_list_events(limit=100):
    con = _db_connect()
    rows = con.execute(
        "SELECT * FROM events ORDER BY id DESC LIMIT ?", (limit,)
    ).fetchall()
    result = []
    for r in rows:
        d = dict(r)
        try:    d["data"] = json.loads(d["data"])
        except Exception: d["data"] = {}
        result.append(d)
    con.close()
    return result

def db_list_clusters():
    con = _db_connect()
    rows = con.execute("SELECT * FROM clusters ORDER BY updated_at DESC").fetchall()
    result = []
    for r in rows:
        d = dict(r)
        try: d["data"] = json.loads(d["data"])
        except Exception: d["data"] = {}
        result.append(d)
    con.close()
    return result

def db_list_vms(cluster_id=None):
    con = _db_connect()
    if cluster_id:
        rows = con.execute("SELECT * FROM vms WHERE cluster_id=? ORDER BY role,name", (cluster_id,)).fetchall()
    else:
        rows = con.execute("SELECT * FROM vms ORDER BY cluster_id,role,name").fetchall()
    result = []
    for r in rows:
        d = dict(r)
        try: d["data"] = json.loads(d["data"])
        except Exception: d["data"] = {}
        result.append(d)
    con.close()
    return result

def db_upsert_cluster(name, data, template_id="", status="designing"):
    con = _db_connect()
    now = _db_now()
    row = con.execute("SELECT id FROM clusters WHERE name=?", (name,)).fetchone()
    if row:
        id_ = row["id"]
        con.execute(
            "UPDATE clusters SET data=?,template_id=?,status=?,updated_at=? WHERE id=?",
            (json.dumps(data), template_id, status, now, id_)
        )
    else:
        id_ = str(uuid.uuid4())
        con.execute(
            "INSERT INTO clusters (id,name,template_id,status,data,created_at,updated_at) VALUES (?,?,?,?,?,?,?)",
            (id_, name, template_id, status, json.dumps(data), now, now)
        )
    con.commit()
    con.close()
    return id_

def db_save_service(name, description="", cluster_id="", node_targets=None,
                    dataset="", image="", runtime="systemd", replicas=1,
                    repl_targets=None, config=None, salt_state=""):
    """Insert or update a service definition. Returns the id."""
    con = _db_connect()
    now = _db_now()
    row = con.execute("SELECT id FROM services WHERE name=?", (name,)).fetchone()
    data_args = (
        description, cluster_id,
        json.dumps(node_targets or []),
        dataset or f"rpool/services/{name}",
        image, runtime, replicas,
        json.dumps(repl_targets or []),
        json.dumps(config or {}),
        salt_state, now,
    )
    if row:
        id_ = row["id"]
        con.execute(
            "UPDATE services SET description=?,cluster_id=?,node_targets=?,dataset=?,"
            "image=?,runtime=?,replicas=?,repl_targets=?,config=?,salt_state=?,updated_at=? WHERE id=?",
            data_args + (id_,)
        )
    else:
        id_ = str(uuid.uuid4())
        con.execute(
            "INSERT INTO services (id,name,description,cluster_id,node_targets,dataset,"
            "image,runtime,replicas,repl_targets,config,salt_state,status,created_at,updated_at) "
            "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
            (id_, name) + data_args + ("defined", now,)
        )
    con.commit()
    con.close()
    return id_

def db_list_services(cluster_id=None):
    con = _db_connect()
    if cluster_id:
        rows = con.execute(
            "SELECT * FROM services WHERE cluster_id=? ORDER BY name", (cluster_id,)
        ).fetchall()
    else:
        rows = con.execute("SELECT * FROM services ORDER BY name").fetchall()
    result = []
    for r in rows:
        d = dict(r)
        for f in ("node_targets", "repl_targets", "config"):
            try: d[f] = json.loads(d[f])
            except Exception: d[f] = [] if f != "config" else {}
        result.append(d)
    con.close()
    return result

def db_load_service(id_):
    con = _db_connect()
    row = con.execute("SELECT * FROM services WHERE id=?", (id_,)).fetchone()
    con.close()
    if not row:
        return None
    d = dict(row)
    for f in ("node_targets", "repl_targets", "config"):
        try: d[f] = json.loads(d[f])
        except Exception: d[f] = [] if f != "config" else {}
    return d

def db_delete_service(id_):
    con = _db_connect()
    con.execute("DELETE FROM services WHERE id=?", (id_,))
    con.commit()
    con.close()

def db_update_service_status(id_, status, version=""):
    con = _db_connect()
    con.execute(
        "UPDATE services SET status=?,version=?,updated_at=? WHERE id=?",
        (status, version, _db_now(), id_)
    )
    con.commit()
    con.close()

def db_export_all():
    """Export entire DB as a JSON dict (for seed disk / live→master handoff)."""
    con = _db_connect()
    export = {}
    for table in ("templates", "nodes", "clusters", "vms", "services", "events"):
        try:
            rows = con.execute(f"SELECT * FROM {table}").fetchall()
            export[table] = [dict(r) for r in rows]
        except Exception:
            export[table] = []
    con.close()
    return export

def db_import_all(data, merge=True):
    """Import a DB export dict. merge=True skips rows with existing PKs."""
    con = _db_connect()
    counts = {}
    for table, rows in data.items():
        if table == "events":
            continue  # events are append-only, skip import
        n = 0
        for row in rows:
            cols = list(row.keys())
            placeholders = ",".join(["?"] * len(cols))
            vals = [row[c] for c in cols]
            conflict = "OR IGNORE" if merge else "OR REPLACE"
            try:
                con.execute(
                    f"INSERT {conflict} INTO {table} ({','.join(cols)}) VALUES ({placeholders})",
                    vals
                )
                n += 1
            except Exception:
                pass
        counts[table] = n
    con.commit()
    con.close()
    return counts

def is_live_mode():
    """Return True if running on the live ISO (not installed system).

    Canonical signal is KLDLOAD_INSTALLED=1 in /etc/kldload/install-manifest.env
    (written by the installer on target finalize). The older check was for
    /etc/kldload/node.env which the installer has never actually written,
    so every installed kldload system wrongly reported "live mode" and the
    webui served the stripped-down install sidebar forever (no K8s / KVM /
    klab / Helm / Ansible / Bob / Metrics tabs ever appeared)."""
    try:
        cmdline = Path("/proc/cmdline").read_text()
        if "boot=live" in cmdline:
            return True
    except Exception:
        pass
    try:
        mf = Path("/etc/kldload/install-manifest.env").read_text()
        for line in mf.splitlines():
            if line.strip().startswith("KLDLOAD_INSTALLED="):
                # Strip quotes + whitespace; treat any non-"0" value as truthy
                val = line.split("=", 1)[1].strip().strip('"').strip("'")
                if val and val != "0":
                    return False
    except Exception:
        pass
    return True

def get_node_env():
    """Return dict of key=value pairs from /etc/kldload/node.env, or {} if absent."""
    env = {}
    try:
        for line in Path("/etc/kldload/node.env").read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, _, v = line.partition("=")
                env[k.strip()] = v.strip()
    except Exception:
        pass
    return env

# ── Disk detection ─────────────────────────────────────────────────────────────

def get_disks():
    """Return list of usable block devices, NVMe first, USB/removable last."""
    try:
        out = subprocess.check_output(
            ["lsblk", "-J", "-o", "NAME,SIZE,MODEL,TYPE,RM,MOUNTPOINT,ROTA,TRAN"],
            text=True
        )
        data = json.loads(out)
        disks = []
        # Detect the live boot device so we can flag it
        live_dev = ""
        try:
            with open("/proc/cmdline") as f:
                cmdline = f.read()
            # Find the device backing /run/initramfs/live
            live_mount = subprocess.check_output(
                ["findmnt", "-n", "-o", "SOURCE", "/run/initramfs/live"],
                text=True
            ).strip()  # e.g. /dev/sda or /dev/sda1
            import re
            m = re.match(r'(/dev/[a-z]+)', live_mount)
            if m:
                live_dev = m.group(1)
        except Exception:
            pass

        for d in data.get("blockdevices", []):
            if d.get("type") == "disk":
                dev_path = f'/dev/{d["name"]}'
                is_removable = bool(d.get("rm", False))
                is_usb = (d.get("tran") or "").lower() == "usb"
                is_live = dev_path == live_dev
                is_nvme = d["name"].startswith("nvme")
                is_virtio = d["name"].startswith("vd")
                # Priority: nvme=0, virtio=1, sata/sas=2, usb/removable=3, live_boot=4
                if is_live:
                    priority = 4
                elif is_usb or is_removable:
                    priority = 3
                elif is_nvme:
                    priority = 0
                elif is_virtio:
                    priority = 1
                else:
                    priority = 2
                warning = ""
                if is_live:
                    warning = "LIVE BOOT DEVICE — do not install here"
                elif is_usb or is_removable:
                    warning = "removable / USB"
                disks.append({
                    "name":       dev_path,
                    "size":       d.get("size", "?"),
                    "model":      (d.get("model") or "").strip(),
                    "removable":  is_removable,
                    "mountpoint": d.get("mountpoint"),
                    "rota":       d.get("rota", None),
                    "tran":       d.get("tran") or "",
                    "priority":   priority,
                    "warning":    warning,
                    "recommended": is_nvme or is_virtio,
                })
        # Sort: NVMe first, USB/live last
        disks.sort(key=lambda x: x["priority"])
        return disks
    except Exception as e:
        LOG.error("lsblk failed: %s", e)
        return []

def get_system_info():
    """Return basic system info dict."""
    info = {}
    try:
        info["hostname"] = open("/etc/hostname").read().strip()
    except Exception:
        info["hostname"] = "unknown"
    try:
        mem = subprocess.check_output(["free", "-h"], text=True).splitlines()[1].split()
        info["memory_total"] = mem[1]
        info["memory_free"]  = mem[3]
    except Exception:
        info["memory_total"] = "?"
        info["memory_free"]  = "?"
    try:
        info["cpus"] = subprocess.check_output(["nproc"], text=True).strip()
    except Exception:
        info["cpus"] = "?"
    try:
        uptime_s = subprocess.check_output(["uptime", "-p"], text=True).strip()
        info["uptime"] = uptime_s
    except Exception:
        pass
    try:
        with open("/etc/kldload/install-manifest.env") as f:
            for line in f:
                line = line.strip()
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    info[k.lower()] = v
    except Exception:
        pass
    # Detect NVIDIA GPU and VRAM
    try:
        lspci = subprocess.check_output(["lspci"], text=True, stderr=subprocess.DEVNULL)
        info["has_nvidia"] = "NVIDIA" in lspci.upper()
    except Exception:
        info["has_nvidia"] = False
    # Total RAM in GB (for AI model gating)
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    info["ram_gb"] = int(line.split()[1]) // (1024 * 1024)
                    break
    except Exception:
        info["ram_gb"] = 0
    # NVIDIA VRAM via nvidia-smi (if available)
    info["vram_gb"] = 0
    if info.get("has_nvidia"):
        try:
            nvsmi = subprocess.check_output(
                ["nvidia-smi", "--query-gpu=memory.total", "--format=csv,noheader,nounits"],
                text=True, stderr=subprocess.DEVNULL).strip()
            info["vram_gb"] = int(nvsmi.split("\n")[0]) // 1024
        except Exception:
            pass
    info["edition"] = EDITION
    # Firstboot progress status
    try:
        with open("/tmp/kldload-firstboot-status") as f:
            info["firstboot_status"] = f.read().strip()
    except Exception:
        info["firstboot_status"] = ""
    # AI status — Ollama API reachable PLUS at least one model loaded into
    # VRAM/RAM. /api/ps (running models) is the truth. /api/tags only says
    # "model weights exist on disk" which still leaves a 30s cold-start
    # when the user first clicks Bob. Sidebar Bob entry and the ready
    # banner both key off ai_ollama, so gating them on /api/ps means the
    # UI only reveals Bob once he's genuinely warm.
    info["ai_ollama"] = False
    info["ai_webui"] = False
    info["ai_model"] = ""
    info["ai_loaded"] = False
    try:
        import urllib.request
        r = urllib.request.urlopen("http://localhost:11434/api/tags", timeout=2)
        if r.status == 200:
            import json as _json
            data = _json.loads(r.read())
            names = [m["name"] for m in data.get("models", [])]
            info["ai_model"] = ", ".join(names) if names else "no models"
            # Only consider ollama "ready" when a model is resident
            try:
                r2 = urllib.request.urlopen("http://localhost:11434/api/ps", timeout=2)
                if r2.status == 200:
                    loaded = _json.loads(r2.read()).get("models", [])
                    if loaded:
                        info["ai_ollama"] = True
                        info["ai_loaded"] = True
            except Exception:
                pass
    except Exception:
        pass
    try:
        r2 = urllib.request.urlopen("http://localhost:8080", timeout=2)
        info["ai_webui"] = r2.status == 200
    except Exception:
        pass
    # Live mode: no KLDLOAD_INSTALLED=1 in manifest. Used elsewhere in the
    # UI to gate live-only / installed-only features.
    info["live_mode"] = True
    try:
        with open("/etc/kldload/install-manifest.env") as f:
            if "KLDLOAD_INSTALLED=1" in f.read():
                info["live_mode"] = False
    except Exception:
        pass
    # Install panel visibility — separated from `live_mode` 2026-05-17.
    # Why: hiding the Install tab forever after first install is a UX trap.
    # Re-install, golden-image refresh, recovery from a botched first install,
    # and demo iteration all want the tab back. Default is now ALWAYS visible.
    # Set KLDLOAD_HIDE_INSTALL=1 in /etc/kldload/webui.conf (or as an env var)
    # to restore the legacy "hide after install" behavior. Same flag governs
    # the export-as-image workflow, which lives inside the install view.
    info["show_install_panel"] = True
    _hide_install = os.environ.get("KLDLOAD_HIDE_INSTALL", "0") == "1"
    try:
        with open("/etc/kldload/webui.conf") as f:
            for _line in f:
                _line = _line.strip()
                if _line.startswith("KLDLOAD_HIDE_INSTALL="):
                    _hide_install = _line.split("=", 1)[1].strip().strip('"').strip("'") == "1"
                    break
    except Exception:
        pass
    if _hide_install and not info["live_mode"]:
        info["show_install_panel"] = False
    # Grains: node_index, wg1_ip
    try:
        grains_path = "/etc/salt/grains"
        if os.path.exists(grains_path) and yaml is not None:
            with open(grains_path) as f:
                grains = yaml.safe_load(f) or {}
            info["node_index"] = grains.get("node_index", "")
            info["wg1_ip"]     = grains.get("wg1_ip", "")
    except Exception:
        pass
    # Quick WG up/down status for dashboard mini-table
    info["wg"] = {}
    for n, net in [(0, "10.77"), (1, "10.78"), (2, "10.79"), (3, "10.80")]:
        iface = f"wg{n}"
        entry = {"up": False, "ip": ""}
        try:
            out = subprocess.check_output(
                ["ip", "-o", "addr", "show", iface],
                text=True, stderr=subprocess.DEVNULL
            )
            m = re.search(r"inet (\S+)", out)
            if m:
                entry["ip"] = m.group(1).split("/")[0]
                entry["up"] = True
        except Exception:
            pass
        info["wg"][iface] = entry
    # klab availability (installed klab profile or klab binary present)
    info["klab_available"] = os.path.isfile("/usr/local/bin/klab")
    return info


def get_wg_status():
    """Return detailed WireGuard status for all four planes."""
    data = {}
    for n in range(4):
        iface = f"wg{n}"
        entry = {"up": False, "ip": "", "peers": 0, "peer_list": []}
        try:
            out = subprocess.check_output(
                ["ip", "-o", "addr", "show", iface],
                text=True, stderr=subprocess.DEVNULL
            )
            m = re.search(r"inet (\S+)", out)
            if m:
                entry["ip"]  = m.group(1).split("/")[0]
                entry["up"]  = True
        except Exception:
            pass
        try:
            wg_out = subprocess.check_output(
                ["wg", "show", iface, "dump"],
                text=True, stderr=subprocess.DEVNULL
            )
            peers = []
            for line in wg_out.strip().splitlines()[1:]:  # skip own pubkey line
                parts = line.split("\t")
                if len(parts) >= 5:
                    pub   = parts[0]
                    ep    = parts[2] if parts[2] != "(none)" else "—"
                    aips  = parts[3]
                    hs    = parts[4]
                    rx_tx = f"{parts[5]} / {parts[6]}" if len(parts) > 6 else "—"
                    peers.append({
                        "pubkey":       pub,
                        "pubkey_short": pub[:12] + "…",
                        "endpoint":     ep,
                        "allowed_ips":  aips,
                        "last_handshake": _fmt_handshake(hs),
                        "transfer":     rx_tx,
                    })
            entry["peers"]     = len(peers)
            entry["peer_list"] = peers
        except Exception:
            pass
        data[iface] = entry
    return data


def get_network_interfaces():
    """Return list of network interfaces with addresses."""
    ifaces = []
    try:
        out = subprocess.check_output(
            ["ip", "-o", "addr", "show"],
            text=True, stderr=subprocess.DEVNULL
        )
        seen = {}
        for line in out.splitlines():
            parts = line.split()
            if len(parts) < 4:
                continue
            name  = parts[1]
            family = parts[2]
            addr  = parts[3]
            if family not in ("inet", "inet6"):
                continue
            if name not in seen:
                seen[name] = {"name": name, "addresses": [], "state": "DOWN", "mtu": ""}
            seen[name]["addresses"].append(addr)
        # Get state and MTU
        link_out = subprocess.check_output(
            ["ip", "-o", "link", "show"],
            text=True, stderr=subprocess.DEVNULL
        )
        for line in link_out.splitlines():
            m_name = re.match(r"\d+:\s+(\S+):", line)
            if not m_name:
                continue
            name = m_name.group(1).rstrip("@eth0").split("@")[0]
            if name not in seen:
                seen[name] = {"name": name, "addresses": [], "state": "DOWN", "mtu": ""}
            seen[name]["state"] = "UP" if "UP" in line else "DOWN"
            m_mtu = re.search(r"mtu (\d+)", line)
            if m_mtu:
                seen[name]["mtu"] = m_mtu.group(1)
        ifaces = [v for k, v in sorted(seen.items()) if k != "lo"]
    except Exception as e:
        LOG.warning("network info failed: %s", e)
    return ifaces


def get_golden_status():
    """Return exists/size for each golden image template."""
    golden_dir = Path("/var/lib/kldload/golden")
    status = {}
    for tmpl in ("master", "kvm", "storage", "vdi"):
        path = golden_dir / f"golden-{tmpl}.qcow2"
        if path.exists():
            size_bytes = path.stat().st_size
            size_hr = _human_size(size_bytes)
            status[tmpl] = {"exists": True, "size": size_hr, "path": str(path)}
        else:
            status[tmpl] = {"exists": False}
    return status


def _fmt_handshake(ts_str):
    """Convert epoch timestamp to human-readable."""
    try:
        ts = int(ts_str)
        if ts == 0:
            return "never"
        delta = int(time.time()) - ts
        if delta < 120:
            return f"{delta}s ago"
        elif delta < 7200:
            return f"{delta // 60}m ago"
        else:
            return f"{delta // 3600}h ago"
    except Exception:
        return ts_str


def _human_size(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024:
            return f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} PB"

def _load_credentials():
    try:
        return json.loads(CREDENTIALS_PATH.read_text())
    except Exception:
        return {"proxmox": [], "aws": {}, "azure": {}, "gcp": {}, "ssh": []}

def _save_credentials(creds):
    CREDENTIALS_PATH.parent.mkdir(parents=True, exist_ok=True)
    CREDENTIALS_PATH.write_text(json.dumps(creds, indent=2))
    os.chmod(CREDENTIALS_PATH, 0o600)

# ── WebSocket handler ──────────────────────────────────────────────────────────

RUNNING_PROCS = {}

PRO_ONLY_ACTIONS = {
    "spawn", "golden", "cluster_deploy", "wg_peer_add", "wg_peer_remove",
    "wg_info", "node_list", "node_register", "node_poof", "apply_role",
    "salt_highstate", "salt_apply", "ansible_run", "k8s_join",
    # NOTE: All VM lifecycle ops (list/start/stop/destroy/clone/create_cloud/
    # delete_full/op/bulk) are intentionally FREE — they're the core hypervisor
    # experience and Pro-gating them gutted the value proposition vs.
    # virt-manager/Proxmox. Pro-tier differentiators live elsewhere (fleet
    # ops, salt highstate, ansible runs, cluster_info, etc.).
    "service_action", "credential_list", "credential_add",
    "proxmox_list", "firewall_rule", "cluster_info",
}

async def _pro_required(websocket, action: str) -> bool:
    """Return True (and send error) if this is a free edition trying a pro action."""
    if EDITION == "free" and action in PRO_ONLY_ACTIONS:
        await websocket.send(json.dumps({
            "type": "error",
            "msg": f"'{action}' requires kldload Pro. Upgrade at kldload.ca/upgrade.",
            "pro_required": True,
        }))
        return True
    return False


async def _run_text(cmd, timeout=15, merge_stderr=True):
    """Run a command non-blockingly and return (rc, stdout_text).

    Replaces subprocess.check_output / subprocess.run in WS handlers —
    the sync calls would block the entire asyncio event loop for the
    duration of the child process, freezing every other client's
    pings/refreshes during slow commands like `zpool status` on a busy
    pool or `kubectl get` against a stressed apiserver. With this
    helper the event loop stays alive; other handlers keep responding
    while we're waiting on the subprocess.

    Returns (returncode, text). Never raises — caller decides what to
    do with non-zero rc. On timeout returns (-1, "[timeout]"). Output
    is decoded as utf-8 with replacement so binary noise doesn't crash
    JSON serialisation downstream.
    """
    try:
        p = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.STDOUT if merge_stderr else asyncio.subprocess.PIPE,
        )
        try:
            out, _ = await asyncio.wait_for(p.communicate(), timeout=timeout)
        except asyncio.TimeoutError:
            try: p.kill()
            except Exception: pass
            return -1, "[timeout]"
        return p.returncode or 0, (out or b"").decode("utf-8", errors="replace")
    except Exception as e:
        return -1, f"[exec error] {e}"

async def ws_handler(websocket):
    LOG.info("WebSocket client connected: %s", websocket.remote_address)
    try:
        async for raw in websocket:
            try:
                msg = json.loads(raw)
            except json.JSONDecodeError:
                await websocket.send(json.dumps({"type": "error", "msg": "invalid JSON"}))
                continue

            action = msg.get("action", "")
            LOG.info("WS action: %s", action)
            try:
                if await _pro_required(websocket, action):
                    continue
                if action == "ping":
                    await websocket.send(json.dumps({"type": "pong"}))
                elif action == "system_info":
                    await websocket.send(json.dumps({
                        "type": "system_info",
                        "data": get_system_info(),
                    }))
                elif action == "list_disks":
                    await websocket.send(json.dumps({
                        "type": "disk_list",
                        "disks": get_disks(),
                    }))
                elif action == "install":
                    await _run_install(websocket, msg)
                elif action == "wifi_connect":
                    await _wifi_connect(websocket, msg)
                elif action == "test_rhel_cdn":
                    await _test_rhel_cdn(websocket, msg)
                elif action == "wipe_disk":
                    await _run_wipe_disk(websocket, msg)
                elif action == "spawn":
                    await _run_spawn(websocket, msg)
                elif action == "golden":
                    await _run_golden(websocket, msg)
                elif action == "tail_log":
                    log_name = msg.get("log", "installer")
                    log_path = LOG_FILES.get(log_name, LOG_FILES["installer"])
                    await _tail_log(websocket, log_path)
                elif action == "list_vms":
                    await _list_vms(websocket)
                elif action == "vm_op":
                    await _vm_op(websocket, msg)
                elif action == "vm_networks":
                    await _vm_networks(websocket)
                elif action == "vm_pools":
                    await _vm_pools(websocket)
                elif action == "vm_snapshots":
                    await _vm_snapshots(websocket)
                elif action == "vm_bulk":
                    await _vm_bulk(websocket, msg)
                elif action == "zfs_list":
                    await _zfs_list(websocket)
                elif action == "k8s_nodes":
                    await _k8s_nodes(websocket)
                elif action == "salt_status":
                    await _salt_status(websocket)
                elif action == "wg_status":
                    await websocket.send(json.dumps({
                        "type": "wg_data",
                        "data": get_wg_status(),
                    }))
                elif action == "wg_gen_keypair":
                    await _wg_gen_keypair(websocket)
                elif action == "wg_add_peer":
                    await _wg_add_peer(websocket, msg)
                elif action == "wg_remove_peer":
                    await _wg_remove_peer(websocket, msg)
                elif action == "golden_status":
                    await websocket.send(json.dumps({
                        "type": "golden_status",
                        "status": get_golden_status(),
                    }))
                elif action == "stamp":
                    await _run_stamp(websocket, msg)
                elif action == "k8s_join":
                    await _run_k8s_join(websocket, msg)
                elif action == "salt_highstate":
                    await _run_salt_highstate(websocket, msg)
                elif action == "salt_accept_all":
                    await _salt_accept_all(websocket)
                elif action == "node_list":
                    await _node_list(websocket)
                elif action == "node_apply":
                    await _node_apply(websocket, msg)
                elif action == "mine_refresh":
                    await _mine_refresh(websocket, msg)
                elif action == "node_accept_key":
                    await _node_accept_key(websocket, msg)
                elif action == "poof":
                    await _run_poof(websocket, msg)
                elif action == "cluster_deploy":
                    await _run_cluster_deploy(websocket, msg)
                elif action == "run_audit":
                    await _run_audit(websocket)
                elif action == "credentials_load":
                    creds = _load_credentials()
                    # Mask secrets before sending to browser
                    masked = json.loads(json.dumps(creds))
                    for p in masked.get("proxmox", []):
                        if p.get("token_secret"):
                            p["token_secret"] = "••••••••"
                    if masked.get("aws", {}).get("secret"):
                        masked["aws"]["secret"] = "••••••••"
                    if masked.get("azure", {}).get("client_secret"):
                        masked["azure"]["client_secret"] = "••••••••"
                    await websocket.send(json.dumps({"type": "credentials_data", "creds": masked}))
                elif action == "credentials_save":
                    # Merge: if secret field is masked placeholder, keep existing value
                    existing = _load_credentials()
                    incoming = msg.get("creds", {})
                    # Proxmox: match by id, preserve secret if masked
                    for i, p in enumerate(incoming.get("proxmox", [])):
                        if p.get("token_secret") == "••••••••":
                            for ep in existing.get("proxmox", []):
                                if ep.get("id") == p.get("id"):
                                    p["token_secret"] = ep.get("token_secret", "")
                    # AWS
                    if incoming.get("aws", {}).get("secret") == "••••••••":
                        incoming["aws"]["secret"] = existing.get("aws", {}).get("secret", "")
                    # Azure
                    if incoming.get("azure", {}).get("client_secret") == "••••••••":
                        incoming["azure"]["client_secret"] = existing.get("azure", {}).get("client_secret", "")
                    _save_credentials(incoming)
                    await websocket.send(json.dumps({"type": "credentials_saved"}))
                elif action == "credentials_test":
                    provider = msg.get("provider", "")
                    creds = _load_credentials()
                    ok, err = False, "unknown provider"
                    if provider == "proxmox":
                        pid = msg.get("id", "")
                        for p in creds.get("proxmox", []):
                            if p.get("id") == pid:
                                try:
                                    import urllib.request, urllib.error
                                    url = f"https://{p['host']}:{p.get('port',8006)}/api2/json/version"
                                    req = urllib.request.Request(url,
                                        headers={"Authorization": f"PVEAPIToken={p['token_id']}={p['token_secret']}"},
                                    )
                                    import ssl as _ssl
                                    ctx = _ssl.create_default_context()
                                    ctx.check_hostname = False
                                    ctx.verify_mode = _ssl.CERT_NONE
                                    urllib.request.urlopen(req, context=ctx, timeout=5)
                                    ok, err = True, ""
                                except Exception as e:
                                    ok, err = False, str(e)
                    await websocket.send(json.dumps({"type": "credentials_test_result",
                                                      "provider": provider, "ok": ok, "err": err}))
                elif action == "wg_planes_list":
                    await _wg_planes_list(websocket)
                elif action == "wg_plane_create":
                    await _wg_plane_create(websocket, msg)
                elif action == "wg_plane_delete":
                    await _wg_plane_delete(websocket, msg)
                elif action == "db_list":
                    type_ = msg.get("db_type") or None
                    items = db_list_templates(type_)
                    await websocket.send(json.dumps({
                        "type": "db_list", "db_type": type_, "items": items,
                    }))
                elif action == "db_save":
                    id_ = db_save_template(
                        msg.get("db_type", "generic"),
