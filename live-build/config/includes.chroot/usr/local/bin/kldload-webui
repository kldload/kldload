    cmd = ["salt", salt_target, "state.highstate"]
    await _stream_proc(websocket, cmd, target=ws_target)

async def _salt_accept_all(websocket):
    try:
        subprocess.check_call(
            ["salt-key", "-A", "-y"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
        await websocket.send(json.dumps({"type": "log_line", "line": "All pending keys accepted.", "target": "log"}))
    except Exception as e:
        await websocket.send(json.dumps({"type": "error", "msg": str(e)}))

async def _tail_log(websocket, log_path):
    if not os.path.exists(log_path):
        await websocket.send(json.dumps({
            "type": "log_content",
            "lines": [f"Log not found: {log_path}"],
        }))
        return
    try:
        out = subprocess.check_output(["tail", "-n", "200", log_path], text=True)
        lines = out.splitlines()
    except Exception as e:
        lines = [f"Error reading log: {e}"]
    await websocket.send(json.dumps({"type": "log_content", "lines": lines}))

async def _list_vms(websocket):
    vms = []
    try:
        out = subprocess.check_output(
            ["virsh", "list", "--all", "--name"], text=True,
            stderr=subprocess.DEVNULL
        )
        for name in out.strip().splitlines():
            name = name.strip()
            if not name:
                continue
            state = "unknown"
            try:
                s = subprocess.check_output(
                    ["virsh", "domstate", name], text=True,
                    stderr=subprocess.DEVNULL
                ).strip()
                state = s
            except Exception:
                pass
            vms.append({"name": name, "state": state})
    except Exception as e:
        LOG.warning("virsh list failed: %s", e)
    await websocket.send(json.dumps({"type": "vm_list", "vms": vms}))

async def _vm_op(websocket, msg):
    vm   = msg.get("vm", "")
    op   = msg.get("op", "")
    ops  = {"start": "virsh start", "stop": "virsh shutdown",
            "force-stop": "virsh destroy", "delete": "virsh undefine --nvram"}
    if op not in ops or not re.match(r'^[a-zA-Z0-9_\-]+$', vm):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid vm op"}))
        return
    cmd = shlex.split(f"{ops[op]} {vm}")
    await _stream_proc(websocket, cmd)

async def _zfs_list(websocket):
    pools, datasets = [], []
    try:
        out = subprocess.check_output(
            ["zpool", "list", "-H", "-o", "name,size,alloc,free,health"],
            text=True, stderr=subprocess.DEVNULL
        )
        for line in out.strip().splitlines():
            parts = line.split("\t")
            if len(parts) >= 5:
                pools.append({"name": parts[0], "size": parts[1],
                               "alloc": parts[2], "free": parts[3],
                               "health": parts[4]})
    except Exception:
        pass
    try:
        out = subprocess.check_output(
            ["zfs", "list", "-H", "-o", "name,used,avail,refer,mountpoint"],
            text=True, stderr=subprocess.DEVNULL
        )
        for line in out.strip().splitlines():
            parts = line.split("\t")
            if len(parts) >= 5:
                datasets.append({"name": parts[0], "used": parts[1],
                                  "avail": parts[2], "refer": parts[3],
                                  "mountpoint": parts[4]})
    except Exception:
        pass
    await websocket.send(json.dumps({"type": "zfs_data", "pools": pools, "datasets": datasets}))

async def _k8s_nodes(websocket):
    nodes = []
    try:
        cols = (
            "NAME:.metadata.name,"
            "STATUS:.status.conditions[-1].type,"
            "ROLE:.metadata.labels.node-role\\.kubernetes\\.io/control-plane,"
            "VERSION:.status.nodeInfo.kubeletVersion,"
            "WG2:.metadata.annotations.kldload\\.ca/wg2-ip"
        )
        out = subprocess.check_output(
            ["kubectl", "get", "nodes", "-o",
             f"custom-columns={cols}", "--no-headers"],
            text=True, stderr=subprocess.DEVNULL,
            env={**os.environ, "KUBECONFIG": "/root/.kube/config"},
        )
        for line in out.strip().splitlines():
            parts = line.split()
            if parts:
                nodes.append({
                    "name":       parts[0],
                    "status":     parts[1] if len(parts) > 1 else "?",
                    "role":       "control-plane" if len(parts) > 2 and parts[2] not in ("<none>", "") else "worker",
                    "version":    parts[3] if len(parts) > 3 else "?",
                    "wg2_ip":     parts[4] if len(parts) > 4 and parts[4] != "<none>" else "—",
                    "api_server": "https://10.79.0.1:6443",
                })
    except Exception:
        pass
    await websocket.send(json.dumps({"type": "k8s_nodes", "nodes": nodes}))

async def _node_list(websocket):
    """Full node fleet: mine query + live ping, returns addressing table."""
    nodes = []
    pending_keys = []
    try:
        # Live ping — 5s timeout, non-fatal if salt not running
        ping_data = {}
        try:
            out = subprocess.check_output(
                ["salt", "*", "test.ping", "--out=json", "-t", "5"],
                text=True, stderr=subprocess.DEVNULL,
            )
            ping_data = json.loads(out)
        except Exception:
            pass

        # Grains: role, color, index, all four WireGuard IPs
        grains_data = {}
        try:
            g_out = subprocess.check_output(
                ["salt", "*", "grains.item",
                 "role", "color", "node_index",
                 "wg0_ip", "wg1_ip", "wg2_ip", "wg3_ip",
                 "--out=json", "-t", "5"],
                text=True, stderr=subprocess.DEVNULL,
            )
            grains_data = json.loads(g_out)
        except Exception:
            pass

        # Merge: any host that appears in grains OR ping
        all_hosts = set(grains_data.keys()) | set(ping_data.keys())
        for host in sorted(all_hosts):
            g = grains_data.get(host, {})
            color = g.get("color", "")
            index = g.get("node_index", "")
            # Derive IPs from index+color if grains not yet set
            if index and not g.get("wg0_ip"):
                octet3 = 100 if color == "blue" else 200
                g["wg0_ip"] = f"10.77.{octet3}.{index}"
                g["wg1_ip"] = f"10.78.{octet3}.{index}"
                g["wg2_ip"] = f"10.79.{octet3}.{index}"
                g["wg3_ip"] = f"10.80.{octet3}.{index}"
            nodes.append({
                "host":   host,
                "online": ping_data.get(host) is True,
                "role":   g.get("role", ""),
                "color":  color,
                "index":  str(index),
                "wg0":    g.get("wg0_ip", ""),
                "wg1":    g.get("wg1_ip", ""),
                "wg2":    g.get("wg2_ip", ""),
                "wg3":    g.get("wg3_ip", ""),
            })
    except Exception as e:
        LOG.warning("node_list failed: %s", e)

    # Pending keys
    try:
        k_out = subprocess.check_output(
            ["salt-key", "-l", "pre", "--out=json"],
            text=True, stderr=subprocess.DEVNULL,
        )
        pending_keys = json.loads(k_out).get("minions_pre", [])
    except Exception:
        pass

    await websocket.send(json.dumps({
        "type":    "node_list",
        "nodes":   nodes,
        "pending": pending_keys,
    }))


async def _node_apply(websocket, msg):
    """Apply a Salt state to a target minion (or grain match)."""
    salt_target = msg.get("target", "")
    state       = msg.get("state", "")
    ws_target   = msg.get("_target", "log")
    if not re.match(r'^[a-zA-Z0-9_\-\.\*]+$', salt_target):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid target"}))
        return
    if not re.match(r'^[a-zA-Z0-9_\.\-]+$', state):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid state"}))
        return
    cmd = ["salt", salt_target, "state.apply", state]
    await _stream_proc(websocket, cmd, target=ws_target)


async def _mine_refresh(websocket, msg):
    """Force all minions to update their mine data."""
    salt_target = msg.get("target", "*")
    if not re.match(r'^[a-zA-Z0-9_\-\.\*]+$', salt_target):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid target"}))
        return
    await _stream_proc(websocket, ["salt", salt_target, "mine.update"],
                       target=msg.get("_target", "log"))


async def _node_accept_key(websocket, msg):
    """Accept a specific pending Salt key by minion name."""
    name = msg.get("name", "")
    if not re.match(r'^[a-zA-Z0-9_\-\.]+$', name):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid key name"}))
        return
    try:
        subprocess.check_call(
            ["salt-key", "-a", name, "-y"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        await websocket.send(json.dumps({
            "type": "log_line", "line": f"Accepted key: {name}", "target": "log",
        }))
        # Immediately refresh node list
        await _node_list(websocket)
    except Exception as e:
        await websocket.send(json.dumps({"type": "error", "msg": str(e)}))


async def _salt_status(websocket):
    minions = []
    pending = 0
    try:
        out = subprocess.check_output(
            ["salt", "*", "test.ping", "--out=json", "-t", "5"],
            text=True, stderr=subprocess.DEVNULL
        )
        ping_data = json.loads(out)
        # Fetch grains for role/wg1_ip/node_index
        grains_data = {}
        try:
            g_out = subprocess.check_output(
                ["salt", "*", "grains.item", "role", "wg1_ip", "node_index",
                 "--out=json", "-t", "5"],
                text=True, stderr=subprocess.DEVNULL
            )
            grains_data = json.loads(g_out)
        except Exception:
            pass
        for host, ok in ping_data.items():
            g = grains_data.get(host, {})
            minions.append({
                "host":       host,
                "online":     ok is True,
                "role":       g.get("role", ""),
                "wg1_ip":     g.get("wg1_ip", ""),
                "node_index": g.get("node_index", ""),
            })
    except Exception:
        pass
    # Pending keys
    try:
        k_out = subprocess.check_output(
            ["salt-key", "-l", "pre", "--out=json"],
            text=True, stderr=subprocess.DEVNULL
        )
        k_data = json.loads(k_out)
        pending = len(k_data.get("minions_pre", []))
    except Exception:
        pass
    await websocket.send(json.dumps({
        "type": "salt_status",
        "minions": minions,
        "pending": pending,
    }))

async def _run_poof(websocket, msg):
    """Run kldload-poof in live mode only; stream output then send poof_done."""
    live = True
    try:
        with open("/etc/kldload/install-manifest.env") as f:
            if "KLDLOAD_INSTALLED=1" in f.read():
                live = False
    except Exception:
        pass
    if not live:
        await websocket.send(json.dumps({"type": "error", "msg": "poof only runs in live mode"}))
        return
    await _stream_proc(websocket, ["/usr/local/sbin/kldload-poof"],
                       target=msg.get("_target", "log"))
    await websocket.send(json.dumps({"type": "poof_done"}))


async def _run_cluster_deploy(websocket, msg):
    cmd_type = msg.get("cmd", "")
    if cmd_type not in ("scc", "k8s-ha"):
        await websocket.send(json.dumps({"type": "error", "msg": "cmd must be scc or k8s-ha"}))
        return

    # Load saved credentials to resolve named targets
    all_creds = _load_credentials()
    px_by_id  = {p["id"]: p for p in all_creds.get("proxmox", [])}

    # Per-node target overrides: {"master": "px-123", "fw1": "px-456", ...}
    node_targets = msg.get("node_targets", {})
    # Default target (falls back to inline form values)
    default_px = {
        "host":         msg.get("proxmox_host",  ""),
        "node":         msg.get("proxmox_node",  "pve"),
        "token_id":     msg.get("token_id",      ""),
        "token_secret": msg.get("token_secret",  ""),
        "iso_storage":  msg.get("iso_storage",   "local"),
    }

    def _env_for_node(hostname):
        cid = node_targets.get(hostname)
        px  = px_by_id.get(cid, default_px) if cid else default_px
        return {
            "PROXMOX_HOST":         px.get("host",         default_px["host"]),
            "PROXMOX_NODE":         px.get("node",         default_px["node"]),
            "PROXMOX_TOKEN_ID":     px.get("token_id",     default_px["token_id"]),
            "PROXMOX_TOKEN_SECRET": px.get("token_secret", default_px["token_secret"]),
            "PROXMOX_ISO_STORAGE":  px.get("iso_storage",  default_px["iso_storage"]),
        }

    # Find deploy script
    deploy_sh = None
    for p in ["/usr/local/sbin/kldload-deploy-sh",
              "/root/kldload/deploy.sh",
              "/opt/kldload/deploy.sh"]:
        if Path(p).exists():
            deploy_sh = p
            break
    if not deploy_sh:
        await websocket.send(json.dumps({"type": "error",
            "msg": "deploy script not found", "target": "cluster-deploy"}))
        return

    # Build combined env: default proxmox + per-node JSON map for multi-target
    env = {**os.environ}
    env.update(_env_for_node("__default__"))
    if node_targets:
        env["KLDLOAD_NODE_TARGETS"] = json.dumps(node_targets)
        # Serialize per-node credentials so deploy.sh can source them
        resolved = {}
        for node, cid in node_targets.items():
            resolved[node] = _env_for_node(node)
        env["KLDLOAD_NODE_CREDS"] = json.dumps(resolved)

    await _stream_proc(websocket, [deploy_sh, cmd_type], env=env, target="cluster-deploy")

async def _wg_planes_list(websocket):
    """Return all WireGuard interfaces: fixed defaults + user-defined."""
    DEFAULTS = [
        {"iface": "wg0", "subnet": "10.77.0.0/16", "port": 51820, "role": "Enrollment",  "fixed": True},
        {"iface": "wg1", "subnet": "10.78.0.0/16", "port": 51821, "role": "Management",  "fixed": True},
        {"iface": "wg2", "subnet": "10.79.0.0/16", "port": 51822, "role": "Kubernetes",  "fixed": True},
        {"iface": "wg3", "subnet": "10.80.0.0/16", "port": 51823, "role": "Storage",     "fixed": True},
    ]
    planes = list(DEFAULTS)
    # Scan for user-defined planes wg4+
    wg_dir = Path("/etc/wireguard")
    idx = 4
    while True:
        iface = f"wg{idx}"
        conf = wg_dir / f"{iface}.conf"
        if not conf.exists():
            break
        label, subnet, port = iface, "", 0
        try:
            text = conf.read_text()
            for line in text.splitlines():
                if line.startswith("# label="):
                    label = line.split("=", 1)[1].strip()
                if "Address" in line:
                    subnet = line.split("=", 1)[1].strip()
                if "ListenPort" in line:
                    port = int(line.split("=", 1)[1].strip())
        except Exception:
            pass
        planes.append({"iface": iface, "subnet": subnet, "port": port,
                        "role": label, "fixed": False})
        idx += 1
    await websocket.send(json.dumps({"type": "wg_planes", "planes": planes}))

async def _wg_plane_create(websocket, msg):
    label  = msg.get("label", "custom").replace(" ", "-")[:32]
    subnet = msg.get("subnet", "")
    port   = int(msg.get("port", 0))
    if not subnet or not port:
        await websocket.send(json.dumps({"type": "error", "msg": "subnet and port required"}))
        return
    # Find next free interface index
    idx = 4
    while Path(f"/etc/wireguard/wg{idx}.conf").exists():
        idx += 1
    iface = f"wg{idx}"
    try:
        privkey = subprocess.check_output(["wg", "genkey"], text=True).strip()
        pubkey  = subprocess.check_output(["wg", "pubkey"], input=privkey, text=True).strip()
        conf = f"""# label={label}
[Interface]
Address = {subnet.split('/')[0].rsplit('.', 1)[0]}.1/{subnet.split('/')[1]}
ListenPort = {port}
PrivateKey = {privkey}
"""
        Path(f"/etc/wireguard/{iface}.conf").write_text(conf)
        Path(f"/etc/wireguard/{iface}.conf").chmod(0o600)
        subprocess.check_call(["systemctl", "enable", "--now", f"wg-quick@{iface}"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        await websocket.send(json.dumps({"type": "wg_plane_created",
            "iface": iface, "pubkey": pubkey, "label": label}))
        await _wg_planes_list(websocket)
    except Exception as e:
        await websocket.send(json.dumps({"type": "error", "msg": f"plane create failed: {e}"}))

async def _wg_plane_delete(websocket, msg):
    iface = msg.get("iface", "")
    if not re.match(r'^wg[4-9][0-9]*$', iface):
        await websocket.send(json.dumps({"type": "error", "msg": "can only delete user-defined planes (wg4+)"}))
        return
    try:
        subprocess.call(["systemctl", "disable", "--now", f"wg-quick@{iface}"],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        conf = Path(f"/etc/wireguard/{iface}.conf")
        if conf.exists():
            conf.unlink()
        await websocket.send(json.dumps({"type": "wg_plane_deleted", "iface": iface}))
        await _wg_planes_list(websocket)
    except Exception as e:
        await websocket.send(json.dumps({"type": "error", "msg": f"plane delete failed: {e}"}))

async def _run_audit(websocket):
    """Run kldload-audit --json, stream the log, then push the parsed results."""
    audit_bin = "/usr/local/sbin/kldload-audit"
    if not os.path.exists(audit_bin):
        await websocket.send(json.dumps({"type": "error", "msg": "kldload-audit not found"}))
        return
    await websocket.send(json.dumps({"type": "audit_started"}))
    # Run with --json so we can parse final results, but also capture the log
    try:
        proc = await asyncio.create_subprocess_exec(
            audit_bin, "--json",
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.STDOUT,
        )
        stdout, _ = await proc.communicate()
        output = stdout.decode(errors="replace").strip()
        # Try to parse JSON results
        try:
            results = json.loads(output)
        except json.JSONDecodeError:
            results = []
        pass_count = sum(1 for r in results if r.get("status") == "PASS")
        fail_count = sum(1 for r in results if r.get("status") == "FAIL")
        skip_count = sum(1 for r in results if r.get("status") == "SKIP")
        await websocket.send(json.dumps({
            "type": "audit_done",
            "results": results,
            "summary": {"pass": pass_count, "fail": fail_count, "skip": skip_count},
            "rc": proc.returncode,
        }))
    except Exception as exc:
        await websocket.send(json.dumps({"type": "error", "msg": str(exc)}))


async def _vm_clone(websocket, msg):
    """Clone a VM from its golden image and stamp a new identity."""
    src_vm   = msg.get("vm", "")
    new_name = msg.get("new_name", "")
    if not re.match(r'^[a-zA-Z0-9_\-]+$', src_vm):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid vm name"}))
        return
    if not new_name:
        import time as _time
        new_name = f"{src_vm}-clone-{int(_time.time()) % 100000}"
    await websocket.send(json.dumps({"type": "log_line", "line": f"[clone] Cloning {src_vm} → {new_name}", "target": "vm-log"}))
    golden_dir = Path("/var/lib/kldload/golden")
    image_path = golden_dir / f"{src_vm}.qcow2"
    if not image_path.exists():
        # Fall back: look for any golden matching the vm's role pattern
        await websocket.send(json.dumps({"type": "log_line", "line": f"[clone] No golden image for {src_vm} — using live disk clone via virsh", "target": "vm-log"}))
        cmd = ["virt-clone", "--original", src_vm, "--name", new_name, "--auto-clone"]
    else:
        clone_path = golden_dir / f"{new_name}.qcow2"
        try:
            subprocess.check_call(
                ["qemu-img", "create", "-f", "qcow2", "-b", str(image_path), "-F", "qcow2", str(clone_path)],
                stderr=subprocess.DEVNULL
            )
        except Exception as e:
            await websocket.send(json.dumps({"type": "error", "msg": f"qemu-img clone failed: {e}"}))
            return
        cmd = ["kldload-stamp-identity", "--hostname", new_name, "--image", str(clone_path), "--start"]
    await _stream_proc(websocket, cmd, target="vm-log")
    db_log_event("vm_clone", src_vm, f"Cloned {src_vm} → {new_name}")
    await websocket.send(json.dumps({"type": "exec_done", "rc": 0, "target": "vm-log"}))

async def _vm_replace(websocket, msg):
    """Replace a VM: clone it, then destroy the original."""
    vm = msg.get("vm", "")
    if not re.match(r'^[a-zA-Z0-9_\-]+$', vm):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid vm name"}))
        return
    import time as _time
    new_name = f"{vm}-new-{int(_time.time()) % 100000}"
    await websocket.send(json.dumps({"type": "log_line", "line": f"[replace] Starting replace of {vm}", "target": "vm-log"}))
    # Step 1: clone
    await _vm_clone(websocket, {"vm": vm, "new_name": new_name})
    # Step 2: destroy original
    await websocket.send(json.dumps({"type": "log_line", "line": f"[replace] Destroying original {vm}", "target": "vm-log"}))
    try:
        subprocess.call(["virsh", "destroy", vm], stderr=subprocess.DEVNULL)
        subprocess.call(["virsh", "undefine", "--nvram", vm], stderr=subprocess.DEVNULL)
    except Exception as e:
        await websocket.send(json.dumps({"type": "log_line", "line": f"[replace] WARNING: destroy failed: {e}", "target": "vm-log"}))
    db_log_event("vm_replace", vm, f"Replaced {vm} with {new_name}")
    await websocket.send(json.dumps({"type": "log_line", "line": f"[replace] Done. New VM: {new_name}", "target": "vm-log"}))

async def _service_deploy(websocket, msg):
    """Deploy a service to target nodes via Salt highstate.
    Generates a Salt state from the service definition and pushes it."""
    svc_id = msg.get("id", "")
    svc    = db_load_service(svc_id) if svc_id else msg.get("service")
    if not svc:
        await websocket.send(json.dumps({"type": "error", "msg": "service not found"}))
        return

    name     = svc.get("name", "unknown")
    dataset  = svc.get("dataset") or f"rpool/services/{name}"
    image    = svc.get("image", "")
    runtime  = svc.get("runtime", "systemd")
    config   = svc.get("config", {})
    targets  = svc.get("node_targets", [])
    salt_tgt = " ".join(targets) if targets else "*"

    await websocket.send(json.dumps({
        "type": "log_line", "line": f"[deploy] Deploying service: {name}", "target": "svc-log"
    }))

    # Generate Salt state YAML
    salt_state = _generate_salt_state(name, dataset, image, runtime, config)

    # Write state to /srv/salt/kldload/services/<name>.sls
    state_dir  = Path(f"/srv/salt/kldload/services")
    state_file = state_dir / f"{name}.sls"
    try:
        state_dir.mkdir(parents=True, exist_ok=True)
        state_file.write_text(salt_state)
        await websocket.send(json.dumps({
            "type": "log_line", "line": f"[deploy] State written: {state_file}", "target": "svc-log"
        }))
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "log_line", "line": f"[deploy] WARNING: could not write state: {e}", "target": "svc-log"
        }))

    # Update DB: mark as deploying
    if svc_id:
        db_update_service_status(svc_id, "deploying")

    # Push via Salt
    cmd = ["salt", salt_tgt, "state.apply", f"kldload.services.{name}",
           "--timeout=60", "--out=yaml"]
    await _stream_proc(websocket, cmd, target="svc-log")

    if svc_id:
        db_update_service_status(svc_id, "running")
    db_log_event("service_deploy", svc_id or name, f"Service deployed: {name} → {salt_tgt}")
    await websocket.send(json.dumps({"type": "exec_done", "rc": 0, "target": "svc-log"}))

def _generate_salt_state(name, dataset, image, runtime, config):
    """Generate a Salt state YAML for a ZFS-backed service."""
    mountpoint = f"/srv/services/{name}"
    env_lines  = "\n".join(
        f"    - {k}={v}" for k, v in (config.get("env") or {}).items()
    )
    ports      = config.get("ports", [])
    port_lines = "\n".join(f"    - {p}" for p in ports) if ports else ""

    if runtime == "nspawn":
        svc_block = f"""
{name}-nspawn:
  nspawn.running:
    - name: {name}
    - root: {mountpoint}
    - require:
      - zfs: {dataset}
"""
    elif runtime == "podman":
        svc_block = f"""
{name}-container:
  cmd.run:
    - name: >-
        podman run -d --name {name}
        --restart=always
        -v {mountpoint}:/data
        {chr(10).join('        -e ' + l.strip('- ') for l in env_lines.splitlines()) if env_lines else ''}
        {chr(10).join('        -p ' + l.strip('- ') for l in port_lines.splitlines()) if port_lines else ''}
        {image or 'debian:trixie'}
    - unless: podman inspect {name}
    - require:
      - zfs: {dataset}
"""
    else:  # systemd / bare
        svc_block = f"""
{name}-service:
  service.running:
    - name: {name}
    - enable: True
    - require:
      - zfs: {dataset}
"""

    return f"""# Auto-generated by kldload-webui — do not edit manually
# Service: {name}  Runtime: {runtime}

# 1. Ensure ZFS dataset exists
{dataset}:
  zfs.filesystem_present:
    - properties:
        compression: lz4
        mountpoint: {mountpoint}
        com.sun:auto-snapshot: 'true'

# 2. Ensure mountpoint directory exists
{mountpoint}:
  file.directory:
    - makedirs: True
    - require:
      - zfs: {dataset}
{svc_block}
"""

# ── HTTP handler ───────────────────────────────────────────────────────────────

class WebUIHandler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(WEBUI_DIR), **kwargs)

    def log_message(self, fmt, *args):
        pass  # silence access log

    def do_GET(self):
        if self.path == "/" or self.path == "":
            self.path = "/index.html"
        super().do_GET()

# ── Main ───────────────────────────────────────────────────────────────────────

def _get_ssl_context():
    """Try to generate a per-boot TLS cert and return an SSLContext.
    Returns None if the CA is not present (falls back to plain HTTP)."""
    try:
        result = subprocess.check_output(
            ["/usr/local/sbin/kldload-tls-cert"], text=True
        ).strip()
        key_path, crt_path = result.split()
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(certfile=crt_path, keyfile=key_path)
        LOG.info("TLS cert loaded: %s", crt_path)
        return ctx
    except Exception as e:
        LOG.warning("TLS setup failed, falling back to plain HTTP: %s", e)
        return None

# ── Auto-snapshot safety net ──────────────────────────────────────────────────

async def _auto_snapshot(websocket, label="pre-action"):
    """Take automatic ZFS snapshot before destructive operations. Safety net."""
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    snap_name = f"rpool@klab-{label}-{ts}"
    try:
        proc = await asyncio.create_subprocess_exec(
            "zfs", "snapshot", "-r", snap_name,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.STDOUT,
        )
        await proc.wait()
        if proc.returncode == 0:
            await websocket.send(json.dumps({
                "type": "log_line", "target": "klab",
                "line": f"[snapshot] Auto-snapshot: {snap_name}",
            }))
            db_log_event("auto_snapshot", snap_name, f"Pre-{label} safety snapshot")
            return snap_name
        else:
            LOG.warning("Auto-snapshot failed (rc=%d) — proceeding anyway", proc.returncode)
    except Exception as e:
        LOG.warning("Auto-snapshot failed: %s — proceeding anyway", e)
    return None

# ── klab handler implementations ──────────────────────────────────────────────

KLAB_DISTROS = ["centos", "rocky", "fedora", "debian", "ubuntu", "rhel"]

def _klab_get_golden_info():
    """Inspect ZFS snapshots and VM state for all klab golden/site VMs."""
    pool = "rpool"
    goldens = {}
    for distro in KLAB_DISTROS:
        name = f"klab-golden-{distro}"
        snap = f"{pool}/vms/{name}@golden"
        info = {"distro": distro, "ready": False, "size": "", "kernel": "", "zfs_ver": ""}
        try:
            out = subprocess.check_output(
                ["zfs", "list", "-Hp", "-o", "used,referenced", snap],
                text=True, stderr=subprocess.DEVNULL).strip()
            parts = out.split('\t')
            info["ready"] = True
            info["size"] = _human_size(int(parts[1])) if len(parts) > 1 else "?"
        except Exception:
            pass
        # Read cached golden log for kernel/ZFS version
        log_path = Path(f"/root/klab/goldens/{distro}-latest.log")
        if log_path.exists():
            try:
                content = log_path.read_text(errors="replace")
                for line in content.splitlines():
                    if "Kernel:" in line:
                        info["kernel"] = line.split("Kernel:")[-1].strip()[:30]
                    if "ZFS version:" in line:
                        info["zfs_ver"] = line.split("ZFS version:")[-1].strip()[:30]
            except Exception:
                pass
        goldens[distro] = info
    return goldens

def _klab_get_site_vms(site):
    """Get running VMs for a klab site (blue or green)."""
    vms = []
    try:
        out = subprocess.check_output(
            ["virsh", "list", "--all", "--name"],
            text=True, stderr=subprocess.DEVNULL)
        for line in out.strip().splitlines():
            name = line.strip()
            if not name or not name.startswith(f"klab-{site}-"):
                continue
            distro = name.replace(f"klab-{site}-", "")
            state = "unknown"
            ip = ""
            try:
                st = subprocess.check_output(
                    ["virsh", "domstate", name],
                    text=True, stderr=subprocess.DEVNULL).strip()
                state = st
            except Exception:
                pass
            # Get IP from static assignment: blue=192.168.122.10x, green=192.168.122.20x
            try:
                idx = KLAB_DISTROS.index(distro) + 1
            except ValueError:
                idx = 0
            if idx:
                base = 100 if site == "blue" else 200
                ip = f"192.168.122.{base + idx}"
            vms.append({"name": name, "distro": distro, "state": state, "ip": ip})
    except Exception:
        pass
    return vms

def _klab_get_test_results():
    """Read latest test results from /root/klab/."""
    results = {}
    results_dir = Path("/root/klab")
    if not results_dir.exists():
        return results
    # Find latest run directory
    runs = sorted([d for d in results_dir.iterdir()
                   if d.is_dir() and d.name.startswith("run-")],
                  key=lambda d: d.stat().st_mtime, reverse=True)
    if not runs:
        return results
    latest = runs[0]
    results["run_id"] = latest.name
    results["distros"] = {}
    for f in latest.glob("*.summary"):
        distro = f.stem
        data = {}
        try:
            for line in f.read_text().splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    data[k.strip()] = v.strip()
        except Exception:
            pass
        results["distros"][distro] = data
    return results


async def _klab_status(websocket):
    """Return comprehensive klab status: goldens, sites, tests, pool metrics."""
    try:
        goldens = _klab_get_golden_info()
    except Exception as e:
        LOG.warning("klab_status: golden info failed: %s", e)
        goldens = {}
    try:
        blue_vms = _klab_get_site_vms("blue")
    except Exception as e:
        LOG.warning("klab_status: blue VM list failed: %s", e)
        blue_vms = []
    try:
        green_vms = _klab_get_site_vms("green")
    except Exception as e:
        LOG.warning("klab_status: green VM list failed: %s", e)
        green_vms = []
    try:
        tests = _klab_get_test_results()
    except Exception as e:
        LOG.warning("klab_status: test results failed: %s", e)
        tests = {}

    # Pool metrics from klab-exporter if running
    metrics = {}
    try:
        import urllib.request
        r = urllib.request.urlopen("http://localhost:9101/metrics", timeout=2)
        if r.status == 200:
            text = r.read().decode(errors="replace")
            for line in text.splitlines():
                if line.startswith("#"):
                    continue
                if line.startswith("klab_"):
                    parts = line.split(" ", 1)
                    if len(parts) == 2:
                        metrics[parts[0]] = parts[1].strip()
    except Exception:
        pass

    await websocket.send(json.dumps({
        "type": "klab_status",
        "goldens": goldens,
        "blue_vms": blue_vms,
        "green_vms": green_vms,
        "tests": tests,
        "metrics": metrics,
    }))


async def _klab_golden(websocket, msg):
    """Build klab golden image(s). Streams logs."""
    distro = msg.get("distro", "all")
    if distro != "all" and distro not in KLAB_DISTROS:
        await websocket.send(json.dumps({"type": "error", "msg": f"invalid distro: {distro}"}))
        return
    env = {}
    if msg.get("zfs_dev"):
        env["KLAB_ZFS_DEV"] = "1"
    zfs_source = msg.get("zfs_source", "")
    if zfs_source:
        env["ZFS_SOURCE"] = zfs_source
    await _stream_proc(websocket, ["klab", "golden", distro], env=env, target="klab")
    # Refresh status after build
    await _klab_status(websocket)


async def _klab_verify(websocket, msg):
    """Verify klab golden image(s)."""
    distro = msg.get("distro", "all")
    if distro != "all" and distro not in KLAB_DISTROS:
        await websocket.send(json.dumps({"type": "error", "msg": f"invalid distro: {distro}"}))
        return
    await _stream_proc(websocket, ["klab", "verify", distro], target="klab")


async def _klab_deploy(websocket, msg):
    """Deploy klab site (blue or green). Streams logs."""
    site = msg.get("site", "blue")
    if site not in ("blue", "green"):
        await websocket.send(json.dumps({"type": "error", "msg": "site must be 'blue' or 'green'"}))
        return
    await _auto_snapshot(websocket, f"deploy-{site}")
    await _stream_proc(websocket, ["klab", "deploy", site], target="klab")
    await _klab_status(websocket)


async def _klab_promote(websocket, msg):
    """Promote green to blue."""
    site = msg.get("site", "green")
    await _auto_snapshot(websocket, "promote")
    await _stream_proc(websocket, ["klab", "promote", site], target="klab")
    await _klab_status(websocket)


async def _klab_rollback(websocket):
    """Rollback blue to previous snapshot."""
    await _stream_proc(websocket, ["klab", "rollback"], target="klab")
    await _klab_status(websocket)


async def _klab_test(websocket, msg):
    """Run OpenZFS test suite. Streams logs."""
    await _auto_snapshot(websocket, "test")
    cmd = ["klab", "test"]
    mode = msg.get("mode", "quick")
    if mode == "full":
        cmd.append("--full")
    else:
        cmd.append("--quick")
    distro = msg.get("distro", "")
    if distro and distro in KLAB_DISTROS:
        cmd += ["--distro", distro]
    execution = msg.get("execution", "parallel")
    if execution == "series":
        cmd.append("--serial")
    env = {"KLAB_SERIAL": "1"} if execution == "series" else {}
    await _stream_proc(websocket, cmd, env=env, target="klab")
    # Send updated test results after run completes
    await _klab_test_results(websocket, {})
    await _klab_status(websocket)


async def _klab_destroy(websocket, msg):
    """Destroy klab resources."""
    target = msg.get("target", "")
    if target not in ("blue", "green", "all", "goldens"):
        await websocket.send(json.dumps({"type": "error", "msg": "target must be blue|green|all|goldens"}))
        return
    await _auto_snapshot(websocket, f"destroy-{target}")
    await _stream_proc(websocket, ["klab", "destroy", target], target="klab")
    await _klab_status(websocket)


async def _klab_vm_op(websocket, msg):
    """Start/stop/force-stop an individual klab VM."""
    vm = msg.get("vm", "")
    op = msg.get("op", "")
    if not vm or not vm.startswith("klab-"):
        await websocket.send(json.dumps({"type": "error", "msg": "invalid VM name"}))
        return
    if op not in ("start", "shutdown", "destroy", "reboot"):
        await websocket.send(json.dumps({"type": "error", "msg": "op must be start|shutdown|destroy|reboot"}))
        return
    try:
        subprocess.check_call(["virsh", op, vm], stderr=subprocess.DEVNULL)
        await websocket.send(json.dumps({"type": "klab_vm_op_done", "vm": vm, "op": op, "ok": True}))
    except Exception as e:
        await websocket.send(json.dumps({"type": "klab_vm_op_done", "vm": vm, "op": op, "ok": False, "error": str(e)}))
    await _klab_status(websocket)


async def _klab_isolate(websocket, msg):
    """Toggle network isolation for a klab VM using nftables."""
    vm = msg.get("vm", "")
    ip = msg.get("ip", "")
    isolate = msg.get("isolate", True)  # True = isolate, False = reconnect

    if not ip or not vm:
        await websocket.send(json.dumps({"type": "error", "msg": "vm and ip required"}))
        return

    try:
        if isolate:
            # Drop all forwarded traffic from this VM except SSH (port 22)
            subprocess.check_call([
                "nft", "add", "rule", "inet", "filter", "forward",
                "ip", "saddr", ip, "tcp", "dport", "!=", "22", "drop",
            ], stderr=subprocess.DEVNULL)
            subprocess.check_call([
                "nft", "add", "rule", "inet", "filter", "forward",
                "ip", "daddr", ip, "tcp", "sport", "!=", "22", "drop",
            ], stderr=subprocess.DEVNULL)
            await websocket.send(json.dumps({
                "type": "klab_isolate_done", "vm": vm, "ip": ip,
                "isolated": True, "msg": f"Isolated {vm} — SSH only",
            }))
        else:
            # Flush forward chain and re-apply base rules (simplistic — fine for lab)
            subprocess.check_call(
                ["nft", "flush", "chain", "inet", "filter", "forward"],
                stderr=subprocess.DEVNULL)
            await websocket.send(json.dumps({
                "type": "klab_isolate_done", "vm": vm, "ip": ip,
                "isolated": False, "msg": f"Reconnected {vm} — full network",
            }))
    except Exception as e:
        await websocket.send(json.dumps({"type": "error", "msg": f"isolate failed: {e}"}))


async def _klab_metrics(websocket):
    """Fetch Prometheus metrics from klab-exporter (:9101) and return as JSON."""
    metrics = {}
    try:
        import urllib.request
        r = urllib.request.urlopen("http://localhost:9101/metrics", timeout=3)
        if r.status == 200:
            for line in r.read().decode(errors="replace").splitlines():
                if line.startswith("#") or not line.strip():
                    continue
                parts = line.split(" ", 1)
                if len(parts) == 2:
                    metrics[parts[0]] = parts[1].strip()
    except Exception as e:
        metrics["_error"] = str(e)
    await websocket.send(json.dumps({"type": "klab_metrics", "metrics": metrics}))


async def _klab_flows(websocket):
    """Get network flow data — try Hubble, fall back to conntrack/ss."""
    flows = []

    # Try Hubble first (Cilium eBPF flow visibility)
    try:
        out = subprocess.check_output(
            ["hubble", "observe", "--last", "50", "-o", "json"],
            text=True, stderr=subprocess.DEVNULL, timeout=5)
        for line in out.strip().splitlines():
            try:
                f = json.loads(line)
                flows.append({
                    "src": f.get("source", {}).get("identity", ""),
                    "dst": f.get("destination", {}).get("identity", ""),
                    "proto": f.get("l4", {}).get("TCP", {}).get("destination_port", ""),
                    "verdict": f.get("verdict", ""),
                    "time": f.get("time", ""),
                    "source": "hubble",
                })
            except Exception:
                pass
        if flows:
            await websocket.send(json.dumps({"type": "klab_flows", "flows": flows, "source": "hubble"}))
            return
    except Exception:
        pass

    # Fall back to conntrack
    try:
        out = subprocess.check_output(
            ["conntrack", "-L", "-o", "extended", "--limit", "50"],
            text=True, stderr=subprocess.DEVNULL, timeout=5)
        for line in out.strip().splitlines():
            parts = line.split()
            flow = {"raw": line.strip(), "source": "conntrack"}
            for p in parts:
                if p.startswith("src=") and "src" not in flow:
                    flow["src"] = p.split("=")[1]
                elif p.startswith("dst=") and "dst" not in flow:
                    flow["dst"] = p.split("=")[1]
                elif p.startswith("sport="):
                    flow["sport"] = p.split("=")[1]
                elif p.startswith("dport=") and "dport" not in flow:
                    flow["dport"] = p.split("=")[1]
            if len(parts) > 0:
                flow["proto"] = parts[0] if parts[0] in ("tcp", "udp", "icmp") else ""
            flows.append(flow)
        await websocket.send(json.dumps({"type": "klab_flows", "flows": flows, "source": "conntrack"}))
        return
    except Exception:
        pass

    # Fall back to ss summary
    try:
        out = subprocess.check_output(["ss", "-s"], text=True, stderr=subprocess.DEVNULL)
        await websocket.send(json.dumps({
            "type": "klab_flows", "flows": [], "source": "ss",
            "summary": out.strip(),
        }))
    except Exception as e:
        await websocket.send(json.dumps({"type": "klab_flows", "flows": [], "source": "none", "error": str(e)}))


# ── ZFS Test Results (detailed) ────────────────────────────────────────────────

def _klab_get_all_test_runs():
    """Return all test runs with summaries, not just latest."""
    results_dir = Path("/root/klab")
    if not results_dir.exists():
        return []
    runs = sorted([d for d in results_dir.iterdir()
                   if d.is_dir() and d.name.startswith("run-")],
                  key=lambda d: d.stat().st_mtime, reverse=True)
    all_runs = []
    for run_dir in runs[:20]:  # last 20 runs
        run = {
            "run_id": run_dir.name,
            "timestamp": datetime.datetime.fromtimestamp(
                run_dir.stat().st_mtime).strftime("%Y-%m-%d %H:%M:%S"),
            "distros": {},
        }
        for f in run_dir.glob("*.summary"):
            distro = f.stem
            data = {}
            try:
                for line in f.read_text().splitlines():
                    if "=" in line:
                        k, v = line.split("=", 1)
                        data[k.strip()] = v.strip()
            except Exception:
                pass
            run["distros"][distro] = data
        # Total pass/fail/skip
        total_pass = sum(int(d.get("PASS", 0)) for d in run["distros"].values())
        total_fail = sum(int(d.get("FAIL", 0)) for d in run["distros"].values())
        total_skip = sum(int(d.get("SKIP", 0)) for d in run["distros"].values())
        run["total"] = {"pass": total_pass, "fail": total_fail, "skip": total_skip}
        all_runs.append(run)
    return all_runs


async def _klab_test_results(websocket, msg):
    """Return detailed test results — all runs or a specific run."""
    run_id = msg.get("run_id", "")
    runs = _klab_get_all_test_runs()

    if run_id:
        # Return detail for a specific run including log content
        run = next((r for r in runs if r["run_id"] == run_id), None)
        if not run:
            await websocket.send(json.dumps({"type": "error", "msg": f"run not found: {run_id}"}))
            return
        # Read per-distro log files
        run_dir = Path(f"/root/klab/{run_id}")
        logs = {}
        for f in run_dir.glob("*.log"):
            try:
                logs[f.stem] = f.read_text(errors="replace")[-16384:]  # last 16KB
            except Exception:
                pass
        await websocket.send(json.dumps({
            "type": "klab_test_detail",
            "run": run,
            "logs": logs,
        }))
    else:
        await websocket.send(json.dumps({
            "type": "klab_test_runs",
            "runs": runs,
        }))


# ── Fault injection ───────────────────────────────────────────────────────────

async def _klab_fault(websocket, msg):
    """Inject network faults into klab VMs for chaos testing."""
    vm = msg.get("vm", "")
    ip = msg.get("ip", "")
    fault = msg.get("fault", "")

    if not vm or not ip:
        await websocket.send(json.dumps({"type": "error", "msg": "vm and ip required"}))
        return

    await _auto_snapshot(websocket, f"fault-{fault}")

    result = {"type": "klab_fault_done", "vm": vm, "fault": fault, "ok": False}

    try:
        if fault == "network_down":
            # Drop all traffic to/from this VM
            subprocess.check_call([
                "nft", "add", "rule", "inet", "filter", "forward",
                "ip", "saddr", ip, "drop",
            ], stderr=subprocess.DEVNULL)
            subprocess.check_call([
                "nft", "add", "rule", "inet", "filter", "forward",
                "ip", "daddr", ip, "drop",
            ], stderr=subprocess.DEVNULL)
            result["ok"] = True
            result["msg"] = f"Network down: {vm} — all traffic dropped"

        elif fault == "packet_loss":
            # tc netem: 30% packet loss on the bridge for this VM's traffic
            pct = msg.get("percent", "30")
            if not re.match(r'^\d{1,3}$', str(pct)):
                pct = "30"
            # Find the tap interface for this VM
            tap = ""
            try:
                ifaces = subprocess.check_output(
                    ["virsh", "domiflist", vm],
                    text=True, stderr=subprocess.DEVNULL).strip().splitlines()
                # Skip header lines, find first interface name
                for line in ifaces:
                    parts = line.split()
                    if parts and parts[0].startswith(("vnet", "tap", "macvtap")):
                        tap = parts[0]; break
            except Exception:
                pass
            if tap:
                subprocess.check_call([
                    "tc", "qdisc", "replace", "dev", tap, "root", "netem",
                    "loss", f"{pct}%", "delay", "50ms",
                ], stderr=subprocess.DEVNULL)
                result["ok"] = True
                result["msg"] = f"Packet loss {pct}% + 50ms delay on {vm} ({tap})"
            else:
                result["msg"] = f"Could not find tap interface for {vm}"

        elif fault == "kill_vm":
            subprocess.check_call(["virsh", "destroy", vm], stderr=subprocess.DEVNULL)
            result["ok"] = True
            result["msg"] = f"Killed {vm} — VM forcefully stopped"

        elif fault == "clear":
            # Remove all faults: flush nft forward chain, remove tc qdisc
            subprocess.call(
                ["nft", "flush", "chain", "inet", "filter", "forward"],
                stderr=subprocess.DEVNULL)
            try:
                ifaces = subprocess.check_output(
                    ["virsh", "domiflist", vm],
                    text=True, stderr=subprocess.DEVNULL).strip().splitlines()
                for line in ifaces:
                    parts = line.split()
                    if parts and parts[0].startswith(("vnet", "tap", "macvtap")):
                        subprocess.call(["tc", "qdisc", "del", "dev", parts[0], "root"],
                                        stderr=subprocess.DEVNULL)
                        break
            except Exception:
                pass
            result["ok"] = True
            result["msg"] = f"Faults cleared for {vm}"

        else:
            result["msg"] = f"Unknown fault type: {fault}"

    except Exception as e:
        result["msg"] = str(e)

    await websocket.send(json.dumps(result))


# ── "What Just Happened" — eBPF + Hubble last 60s summary ────────────────────

async def _klab_what_happened(websocket, msg):
    """Capture last 60s of system activity: syscalls, network, file writes."""
    vm = msg.get("vm", "")
    ip = msg.get("ip", "")
    seconds = msg.get("seconds", 60)
    target = "klab"

    await websocket.send(json.dumps({
        "type": "log_line", "target": target,
        "line": f"[what-happened] Gathering last {seconds}s of activity" + (f" for {vm}" if vm else "") + "...",
    }))

    sections = []

    # 1. Hubble flows (if available)
    try:
        since = f"{seconds}s"
        cmd = ["hubble", "observe", "--last", "100", "--since", f"{since}ago", "-o", "compact"]
        if ip:
            cmd += ["--ip-filter", ip]
        out = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL, timeout=10)
        if out.strip():
            sections.append(("Network Flows (Hubble)", out.strip()))
    except Exception:
        pass

    # 2. Recent connections (conntrack)
    try:
        out = subprocess.check_output(
            ["conntrack", "-L", "-o", "extended", "--limit", "30"],
            text=True, stderr=subprocess.DEVNULL, timeout=5)
        if ip:
            out = "\n".join(l for l in out.splitlines() if ip in l)
        if out.strip():
            sections.append(("Active Connections (conntrack)", out.strip()))
    except Exception:
        pass

    # 3. Recent file writes (from audit log or find)
    if vm and ip:
        try:
            mmin_val = max(1, seconds // 60 + 1)
            out = subprocess.check_output(
                ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
                 f"root@{ip}",
                 f"find / -maxdepth 4 -mmin -{mmin_val} "
                 f"-not -path '/proc/*' -not -path '/sys/*' -not -path '/run/*' "
                 f"-type f 2>/dev/null | head -30"],
                text=True, stderr=subprocess.DEVNULL, timeout=15)
            if out.strip():
                sections.append((f"Recent File Changes ({vm})", out.strip()))
        except Exception:
            pass

    # 4. Listening ports
    if vm and ip:
        try:
            out = subprocess.check_output(
                ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
                 f"root@{ip}", "ss -tlnp 2>/dev/null | head -20"],
                text=True, stderr=subprocess.DEVNULL, timeout=10)
            if out.strip():
                sections.append((f"Listening Ports ({vm})", out.strip()))
        except Exception:
            pass

    # 5. Recent systemd journal (last 60s)
    if vm and ip:
        try:
            out = subprocess.check_output(
                ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
                 f"root@{ip}", f"journalctl --no-pager --since='{seconds} seconds ago' 2>/dev/null | tail -30"],
                text=True, stderr=subprocess.DEVNULL, timeout=10)
            if out.strip():
                sections.append((f"Journal ({vm})", out.strip()))
        except Exception:
            pass

    # 6. Host-level: recent dmesg
    try:
        out = subprocess.check_output(
            ["dmesg", "--time-format=reltime", "-T"],
            text=True, stderr=subprocess.DEVNULL, timeout=5)
        lines = out.strip().splitlines()[-15:]
        if lines:
            sections.append(("Host dmesg (last 15)", "\n".join(lines)))
    except Exception:
        pass

    # Format and send
    if not sections:
        await websocket.send(json.dumps({
            "type": "klab_what_happened",
            "summary": "(No activity captured in the last {seconds}s. Is the VM running?)",
            "sections": [],
        }))
    else:
        formatted = []
        for title, body in sections:
            formatted.append({"title": title, "body": body})
        summary_lines = [f"=== {s['title']} ===" for s in formatted]
        await websocket.send(json.dumps({
            "type": "klab_what_happened",
            "summary": f"Captured {len(sections)} sections of activity in the last {seconds}s",
            "sections": formatted,
        }))


# ── Diff view: before/after comparison ────────────────────────────────────────

async def _klab_diff_capture(websocket, msg):
    """Capture system state for before/after diffing."""
    vm = msg.get("vm", "")
    ip = msg.get("ip", "")
    phase = msg.get("phase", "before")  # "before" or "after"

    if not ip:
        await websocket.send(json.dumps({"type": "error", "msg": "ip required for diff capture"}))
        return

    state = {}
    try:
        # Installed packages
        pkgs = subprocess.check_output(
            ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
             f"root@{ip}",
             "rpm -qa --qf '%{NAME}\\n' 2>/dev/null || dpkg -l 2>/dev/null | awk '/^ii/{print $2}' || pacman -Qq 2>/dev/null"],
            text=True, stderr=subprocess.DEVNULL, timeout=15).strip()
        state["packages"] = sorted(pkgs.splitlines())
    except Exception:
        state["packages"] = []

    try:
        # Listening ports
        ports = subprocess.check_output(
            ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
             f"root@{ip}", "ss -tlnp 2>/dev/null"],
            text=True, stderr=subprocess.DEVNULL, timeout=10).strip()
        state["ports"] = ports.splitlines()
    except Exception:
        state["ports"] = []

    try:
        # Running processes
        procs = subprocess.check_output(
            ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
             f"root@{ip}", "ps -eo comm= 2>/dev/null | sort -u"],
            text=True, stderr=subprocess.DEVNULL, timeout=10).strip()
        state["processes"] = sorted(procs.splitlines())
    except Exception:
        state["processes"] = []

    try:
        # Active network connections
        conns = subprocess.check_output(
            ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
             f"root@{ip}", "ss -tnp 2>/dev/null | tail -n +2"],
            text=True, stderr=subprocess.DEVNULL, timeout=10).strip()
        state["connections"] = conns.splitlines()
    except Exception:
        state["connections"] = []

    try:
        # Enabled systemd services
        svcs = subprocess.check_output(
            ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
             f"root@{ip}", "systemctl list-unit-files --state=enabled --no-pager --no-legend 2>/dev/null | awk '{print $1}'"],
            text=True, stderr=subprocess.DEVNULL, timeout=10).strip()
        state["services"] = sorted(svcs.splitlines())
    except Exception:
        state["services"] = []

    await websocket.send(json.dumps({
        "type": "klab_diff_capture",
        "phase": phase,
        "vm": vm,
        "ip": ip,
        "state": state,
    }))


async def _klab_diff_compare(websocket, msg):
    """Compare two captured states and return the diff."""
    before = msg.get("before", {})
    after = msg.get("after", {})

    diff = {}
    for key in ("packages", "processes", "services"):
        b = set(before.get(key, []))
        a = set(after.get(key, []))
        diff[key] = {
            "added": sorted(a - b),
            "removed": sorted(b - a),
        }

    # Ports: compare raw lines
    b_ports = set(before.get("ports", []))
    a_ports = set(after.get("ports", []))
    diff["ports"] = {
        "added": sorted(a_ports - b_ports),
        "removed": sorted(b_ports - a_ports),
    }

    # Connections: just show new ones
    b_conns = set(before.get("connections", []))
    a_conns = set(after.get("connections", []))
    diff["connections"] = {
        "added": sorted(a_conns - b_conns),
        "removed": sorted(b_conns - a_conns),
    }

    await websocket.send(json.dumps({
        "type": "klab_diff_result",
        "diff": diff,
    }))


# ── Hubble integration ───────────────────────────────────────────────────────

async def _klab_hubble_status(websocket):
    """Check if Hubble is running and return status."""
    status = {"running": False, "ui_url": "", "version": ""}
    try:
        out = subprocess.check_output(
            ["hubble", "status", "-o", "json"],
            text=True, stderr=subprocess.DEVNULL, timeout=5)
        data = json.loads(out)
        status["running"] = True
        status["version"] = data.get("version", "")
        # Hubble UI typically on port 12000
        status["ui_url"] = "http://localhost:12000"
    except Exception:
        pass

    # Check if hubble-ui pod/service is running
    try:
        out = subprocess.check_output(
            ["kubectl", "get", "svc", "-n", "kube-system", "hubble-ui",
             "-o", "jsonpath={.spec.ports[0].nodePort}"],
            text=True, stderr=subprocess.DEVNULL, timeout=5)
        if out.strip():
            status["ui_url"] = f"http://localhost:{out.strip()}"
            status["running"] = True
    except Exception:
        pass

    await websocket.send(json.dumps({"type": "klab_hubble_status", "status": status}))


async def _klab_hubble_policy(websocket, msg):
    """Get Cilium network policy verdicts for a specific IP or all."""
    ip = msg.get("ip", "")
    cmd = ["hubble", "observe", "--verdict", "DROPPED", "--last", "50", "-o", "compact"]
    if ip:
        cmd += ["--ip-filter", ip]

    try:
        out = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL, timeout=10)
        await websocket.send(json.dumps({
            "type": "klab_hubble_policy",
            "drops": out.strip().splitlines() if out.strip() else [],
            "ip": ip,
        }))
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "klab_hubble_policy",
            "drops": [],
            "error": str(e),
        }))


async def _klab_hubble_capture(websocket, msg):
    """Capture Hubble flows to JSON for replay."""
    duration = msg.get("duration", 30)
    ip = msg.get("ip", "")
    cmd = ["hubble", "observe", "--last", str(min(duration * 10, 500)), "-o", "json"]
    if ip:
        cmd += ["--ip-filter", ip]

    try:
        out = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL, timeout=duration + 5)
        flows = []
        for line in out.strip().splitlines():
            try:
                flows.append(json.loads(line))
            except Exception:
                pass
        await websocket.send(json.dumps({
            "type": "klab_hubble_capture",
            "flows": flows,
            "count": len(flows),
            "duration": duration,
        }))
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "klab_hubble_capture",
            "flows": [],
            "error": str(e),
        }))


# ── Bob / LLM "Explain this" ──────────────────────────────────────────────────

async def _bob_execute(websocket, msg):
    """Bob executes a command on the host or a VM. Returns output."""
    cmd_str = msg.get("command", "").strip()
    target = msg.get("target", "host")  # "host" or "vm_ip"

    if not cmd_str:
        await websocket.send(json.dumps({"type": "bob_exec", "output": "(no command)", "rc": 1}))
        return

    # Safety: block obviously dangerous commands
    blocked = ["rm -rf /", "mkfs", "dd if=", ":(){ :|:&", "fork bomb", "> /dev/sd"]
    if any(b in cmd_str.lower() for b in blocked):
        await websocket.send(json.dumps({"type": "bob_exec", "output": "Bob won't run that.", "rc": 1}))
        return

    try:
        if target == "host":
            proc = await asyncio.create_subprocess_shell(
                cmd_str,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.STDOUT,
            )
            stdout, _ = await asyncio.wait_for(proc.communicate(), timeout=30)
            output = stdout.decode(errors="replace")
            await websocket.send(json.dumps({
                "type": "bob_exec",
                "output": output[-4096:],  # last 4KB
                "rc": proc.returncode,
                "target": "host",
            }))
        else:
            # Remote VM via SSH
            ip = target
            if not re.match(r'^[\d.]+$', ip):
                await websocket.send(json.dumps({"type": "bob_exec", "output": f"invalid IP: {ip}", "rc": 1}))
                return
            proc = await asyncio.create_subprocess_exec(
                "ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
                f"root@{ip}", cmd_str,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.STDOUT,
            )
            stdout, _ = await asyncio.wait_for(proc.communicate(), timeout=30)
            output = stdout.decode(errors="replace")
            await websocket.send(json.dumps({
                "type": "bob_exec",
                "output": output[-4096:],
                "rc": proc.returncode,
                "target": ip,
            }))
    except asyncio.TimeoutError:
        await websocket.send(json.dumps({"type": "bob_exec", "output": "(command timed out after 30s)", "rc": 124}))
    except Exception as e:
        await websocket.send(json.dumps({"type": "bob_exec", "output": str(e), "rc": 1}))

    db_log_event("bob_exec", cmd_str[:100], f"Bob ran: {cmd_str[:200]} on {target}")


async def _klab_explain(websocket, msg):
    """Send eBPF/flow data to local Ollama LLM and return plain English explanation."""
    data = msg.get("data", "")
    context = msg.get("context", "network traffic")

    if not data:
        await websocket.send(json.dumps({"type": "error", "msg": "no data to explain"}))
        return

    # Check if Ollama is running
    try:
        import urllib.request
        r = urllib.request.urlopen("http://localhost:11434/api/tags", timeout=2)
        if r.status != 200:
            raise Exception("Ollama not responding")
        tags = json.loads(r.read())
        models = [m["name"] for m in tags.get("models", [])]
        if not models:
            await websocket.send(json.dumps({
                "type": "klab_explain",
                "explanation": "(No models loaded in Ollama. Run: ollama pull llama3.1:8b)",
                "model": "",
            }))
            return
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "klab_explain",
            "explanation": f"(Ollama not available: {e}. Install the AI profile or run: systemctl start ollama)",
            "model": "",
        }))
        return

    # Pick model: prefer bob, then llama3.1:8b, then whatever's loaded
    model = "bob"
    if model not in models:
        model = next((m for m in models if "llama" in m.lower()), models[0])

    prompt = f"""You are a network security analyst on a kldload multi-distro test platform.
Analyze this {context} and explain in plain English:
- What is happening
- Whether it looks normal or suspicious
- What service or process is likely generating it
- Any security concerns

Be concise. 3-5 sentences max.

Data:
{data[:3000]}"""

    await websocket.send(json.dumps({
        "type": "log_line", "target": "klab",
        "line": f"[bob] Asking {model} to explain {context}...",
    }))

    try:
        req_data = json.dumps({
            "model": model,
            "prompt": prompt,
            "stream": False,
        }).encode()
        req = urllib.request.Request(
            "http://localhost:11434/api/generate",
            data=req_data,
            headers={"Content-Type": "application/json"},
        )
        r = urllib.request.urlopen(req, timeout=60)
        resp = json.loads(r.read())
        explanation = resp.get("response", "(no response)")

        await websocket.send(json.dumps({
            "type": "klab_explain",
            "explanation": explanation,
            "model": model,
        }))
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "klab_explain",
            "explanation": f"(LLM request failed: {e})",
            "model": model,
        }))


# ── eBPF Tracing ─────────────────────────────────────────────────────────────

_EBPF_PROC = None

BCC_TOOLS = {
    "execsnoop", "opensnoop", "funccount", "syscount", "trace",
    "tcplife", "tcpconnect", "tcpaccept", "tcpretrans", "tcpdrop",
    "biolatency", "biosnoop", "ext4slower", "filetop",
    "cachestat", "runqlat", "cpudist", "pidstat",
}

def _find_bcc_tool(name):
    """Find a bcc tool binary path."""
    for path in [f"/usr/share/bcc/tools/{name}",
                 f"/usr/sbin/{name}-bpfcc",
                 f"/usr/bin/{name}-bpfcc",
                 f"/usr/sbin/{name}",
                 f"/usr/bin/{name}"]:
        if os.path.isfile(path):
            return path
    return None


async def _klab_ebpf_trace(websocket, msg):
    """Run a bcc/bpftrace tool on host or remote VM, stream output."""
    global _EBPF_PROC
    tool = msg.get("tool", "execsnoop")
    target = msg.get("target", "host")
    duration = int(msg.get("duration", 10))
    arg = msg.get("arg", "")

    # Validate tool
    if tool != "bpftrace" and tool not in BCC_TOOLS:
        await websocket.send(json.dumps({"type": "error", "msg": f"unknown tool: {tool}"}))
        return

    # Build command
    if target == "host":
        if tool == "bpftrace":
            cmd = ["bpftrace", "-e", arg] if arg else ["bpftrace", "-l"]
        else:
            bin_path = _find_bcc_tool(tool)
            if not bin_path:
                await websocket.send(json.dumps({"type": "error", "msg": f"{tool} not found — install bcc-tools"}))
                return
            cmd = [bin_path]
            if arg and tool in ("funccount", "trace"):
                cmd.append(arg)
            if duration > 0 and tool in ("funccount", "biolatency", "runqlat", "cpudist", "cachestat", "syscount"):
                cmd += [str(duration), "1"]
    else:
        # Remote VM via SSH — use argv form to avoid shell injection
        parts = target.split("|")
        ip = parts[1] if len(parts) > 1 else parts[0]
        if not re.match(r'^[\d.]+$', ip):
            await websocket.send(json.dumps({"type": "error", "msg": f"invalid IP: {ip}"}))
            return
        # Build remote command as argv list passed to SSH (no shell interpretation)
        remote_argv = []
        if tool == "bpftrace":
            remote_argv = ["bpftrace", "-e", arg] if arg else ["bpftrace", "-l"]
        else:
            remote_argv = [tool]
            if arg and tool in ("funccount", "trace"):
                remote_argv.append(shlex.quote(arg))
            if duration > 0 and tool in ("funccount", "biolatency", "runqlat", "cpudist", "cachestat", "syscount"):
                remote_argv += [str(duration), "1"]
        cmd = ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
               f"root@{ip}"] + remote_argv

    # Kill any existing trace
    if _EBPF_PROC and _EBPF_PROC.returncode is None:
        try:
            _EBPF_PROC.kill()
        except Exception:
            pass

    try:
        timeout_s = duration + 5 if duration > 0 else 300
        _EBPF_PROC = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.STDOUT,
        )
        deadline = asyncio.get_event_loop().time() + timeout_s
        try:
            if _EBPF_PROC and _EBPF_PROC.stdout:
                async for raw_line in _EBPF_PROC.stdout:
                    if asyncio.get_event_loop().time() > deadline:
                        break
                    await websocket.send(json.dumps({
                        "type": "klab_ebpf_output",
                        "line": raw_line.decode(errors="replace").rstrip(),
                    }))
        except Exception as e:
            LOG.warning("ebpf stream error: %s", e)
        finally:
            # Always clean up the process
            if _EBPF_PROC and _EBPF_PROC.returncode is None:
                try:
                    _EBPF_PROC.kill()
                    await _EBPF_PROC.wait()
                except Exception:
                    pass

        await websocket.send(json.dumps({"type": "klab_ebpf_done", "tool": tool}))
    except Exception as e:
        await websocket.send(json.dumps({"type": "error", "msg": f"trace failed: {e}"}))


async def _klab_ebpf_stop(websocket):
    """Stop running eBPF trace."""
    global _EBPF_PROC
    if _EBPF_PROC and _EBPF_PROC.returncode is None:
        try:
            _EBPF_PROC.kill()
            await _EBPF_PROC.wait()
        except Exception:
            pass
    await websocket.send(json.dumps({"type": "klab_ebpf_done", "tool": "stopped"}))


# ── Distro matrix runner ─────────────────────────────────────────────────────

async def _klab_run_playbook(websocket, msg):
    """Run a playbook/script against selected klab VMs. Auto-snapshot first."""
    distros = msg.get("distros", [])  # list of distro names
    site = msg.get("site", "blue")
    playbook = msg.get("playbook", "")
    script = msg.get("script", "")

    if not distros:
        distros = KLAB_DISTROS
    if not playbook and not script:
        await websocket.send(json.dumps({"type": "error", "msg": "playbook or script required"}))
        return

    await _auto_snapshot(websocket, "playbook")

    # Get VM IPs for selected distros
    vms = _klab_get_site_vms(site)
    targets = [v for v in vms if v["distro"] in distros and v["state"] == "running"]

    if not targets:
        await websocket.send(json.dumps({
            "type": "error",
            "msg": f"No running {site} VMs for distros: {', '.join(distros)}",
        }))
        return

    # Run against each target
    for vm in targets:
        await websocket.send(json.dumps({
            "type": "log_line", "target": "klab",
            "line": f"\n{'='*60}\n  Running on {vm['name']} ({vm['distro']}) @ {vm['ip']}\n{'='*60}",
        }))

        if script:
            # Inline script — pipe to SSH
            cmd = ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=10",
                   f"root@{vm['ip']}", "bash", "-s"]
            proc = await asyncio.create_subprocess_exec(
                *cmd,
                stdin=asyncio.subprocess.PIPE,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.STDOUT,
            )
            stdout, _ = await proc.communicate(input=script.encode())
            for line in stdout.decode(errors="replace").splitlines():
                await websocket.send(json.dumps({
                    "type": "log_line", "target": "klab", "line": line,
                }))
        elif playbook:
            # Ansible playbook against this host
            cmd = ["ansible-playbook", playbook, "-i", f"{vm['ip']},",
                   "--user", "root", "--ssh-extra-args", "-o StrictHostKeyChecking=no"]
            await _stream_proc(websocket, cmd, target="klab")

    await websocket.send(json.dumps({
        "type": "klab_playbook_done",
        "distros": [v["distro"] for v in targets],
        "count": len(targets),
    }))
    await _klab_status(websocket)


async def main_async(args):
    import http
    import mimetypes
    from websockets.http11 import Response as WsResponse
    from websockets.datastructures import Headers as WsHeaders

    db_init()
    ssl_ctx = _get_ssl_context()
    scheme    = "https" if ssl_ctx else "http"

    async def process_request(connection, request):
        """Serve static HTTP requests inline; return None to allow WS upgrade."""
        if request.headers.get("Upgrade", "").lower() == "websocket":
            return None  # hand off to ws_handler
        url_path = request.path.split("?")[0] or "/"
        if url_path == "/":
            url_path = "/index.html"
        file_path = WEBUI_DIR / url_path.lstrip("/")
        # Prevent path traversal
        try:
            file_path.resolve().relative_to(WEBUI_DIR.resolve())
        except ValueError:
            return WsResponse(403, "Forbidden", WsHeaders([]), b"Forbidden\n")
        if not file_path.exists() or not file_path.is_file():
            return WsResponse(404, "Not Found", WsHeaders([]), b"Not Found\n")
        ctype, _ = mimetypes.guess_type(str(file_path))
        body = file_path.read_bytes()
        headers = WsHeaders([
            ("Content-Type", ctype or "application/octet-stream"),
            ("Content-Length", str(len(body))),
            ("Cache-Control", "no-cache"),
        ])
        return WsResponse(200, "OK", headers, body)

    # Single port for both HTTP (static files) and WebSocket
    ws_server = await websockets.serve(
        ws_handler, args.bind, args.port,
        ping_interval=20, ping_timeout=10,
        ssl=ssl_ctx,
        process_request=process_request,
    )
    LOG.info("kldload Web UI on %s://%s:%d (HTTP + WebSocket)", scheme, args.bind, args.port)

    url = f"{scheme}://localhost:{args.port}"
    LOG.info("kldload Web UI ready: %s", url)

    if not args.no_browser:
        for cmd in ["xdg-open", "firefox-esr", "chromium"]:
            try:
                subprocess.Popen([cmd, url],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                break
            except FileNotFoundError:
                continue

    await ws_server.wait_closed()

def main():
    parser = argparse.ArgumentParser(description="kldload Web UI")
    parser.add_argument("--port",       type=int, default=8080,  help="HTTP + WebSocket port (default 8080)")
    parser.add_argument("--bind",       default="0.0.0.0",       help="Bind address (default 0.0.0.0)")
    parser.add_argument("--no-browser", action="store_true",     help="Don't open browser")
    args = parser.parse_args()

    try:
        asyncio.run(main_async(args))
    except KeyboardInterrupt:
        LOG.info("Shutting down")

if __name__ == "__main__":
    main()
