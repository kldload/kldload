#              "started": float, "command": str, "cwd": str, "ttl": int}
BOB_SHELL_JOBS: "dict[str, dict]" = {}

# Command prefixes considered safe to run without a human-in-the-loop popup
# when Bob is in "safe" mode. Intentionally conservative — read-only or
# clearly-bounded. Fall through to approval for anything else.
BOB_SHELL_SAFE_PREFIXES = (
    "ls ", "cat ", "head ", "tail ", "wc ", "grep ", "awk ", "sed ", "cut ",
    "sort ", "uniq ", "tr ", "find ", "stat ", "file ", "du ", "df ", "free",
    "uptime", "uname", "whoami", "id", "groups", "hostname", "hostnamectl",
    "date", "echo ", "printf ", "env", "which ", "command -v",
    "ps ", "top -b -n 1", "htop -C -b", "pstree",
    "ip ", "ss ", "ping -c ", "dig ", "host ",
    "systemctl status", "systemctl is-active", "systemctl is-enabled",
    "systemctl list-units", "journalctl -n", "journalctl -u",
    "zfs list", "zfs get", "zpool list", "zpool status", "zpool iostat",
    "virsh list", "virsh dominfo", "virsh domstate", "virsh net-list",
    "virsh pool-list", "virsh domiflist", "virsh vol-list",
    "kubectl get", "kubectl describe", "kubectl logs",
    "kubectl top", "kubectl explain", "kubectl api-resources",
    "helm list", "helm status", "helm history",
    "cilium status", "cilium version", "hubble observe --last",
    "klab status", "klab list", "kspawn list", "kspawn status",
    "kldload-doctor", "kldload-help",
)

# Absolute-no regex: these always require the UNLEASHED mode toggle,
# even with approval. Every one wipes data or takes the host down.
import re as _re
BOB_SHELL_DANGEROUS = _re.compile(
    r"\b("
    r"rm\s+-[rRfF]|"
    r"mkfs(\.[a-z0-9]+)?|"
    r"dd\s+[^|]*of=/dev/|"
    r"shred\s+|"
    r"reboot\b|shutdown\b|halt\b|poweroff\b|"
    r"zpool\s+(destroy|remove|offline|detach|export)|"
    r"zfs\s+(destroy|rollback|send\s.*-F|receive\s.*-F)|"
    r"virsh\s+(destroy|undefine|pool-destroy|net-destroy|vol-delete)|"
    r"kubectl\s+delete\b|"
    r"systemctl\s+(stop|disable|mask)\b|"
    r"iptables\s+-F|nft\s+flush|"
    r">\s*/dev/sd[a-z]"
    r")\b"
)

