            "window": {"type": "string", "description": "tmux window name (default: current)"},
            "no_enter": {"type": "boolean", "description": "If true, does not append Enter — useful for pre-loading an editable command"},
        }, "required": ["keys"]},
    }},
    # ── tmux driving — Bob drives the browser-visible terminal ──────────
    # The ttyd terminal in the Kubernetes tab runs a persistent tmux session
    # on socket `ttyd-k9s`. These three tools let Bob spawn a named window,
    # type commands into it, and read back the scrollback — so the user
    # literally watches Bob work instead of seeing opaque tool output.
    {"type": "function", "function": {
        "name": "tmux_spawn",
        "description": "Open a new named tmux window in the user's terminal and optionally run a command in it. The user sees the window appear in their browser terminal immediately. Use this when you want the user to observe something over time (a log tail, a trace, a watch loop). Pair with tmux_capture to read the output back into your reasoning.",
        "parameters": {"type": "object", "properties": {
            "name": {"type": "string", "description": "Window name (becomes the tab label, e.g. 'trace-opens')"},
            "cmd":  {"type": "string", "description": "Command to run in the new window. Defaults to 'bash'."},
        }, "required": ["name"]},
    }},
    {"type": "function", "function": {
        "name": "tmux_send",
        "description": "Type text into an existing tmux window. Distinct from terminal_send in that the window name is required (no ambiguity about which pane receives the keys).",
        "parameters": {"type": "object", "properties": {
            "name":     {"type": "string", "description": "Window name (the one passed to tmux_spawn, or an existing window)"},
            "keys":     {"type": "string", "description": "Text to type"},
            "no_enter": {"type": "boolean", "description": "If true, do not append Enter"},
        }, "required": ["name", "keys"]},
    }},
    {"type": "function", "function": {
        "name": "tmux_capture",
        "description": "Read the last N lines of scrollback from an existing tmux window. Use this after tmux_send to inspect what ran. Returns up to 4 KB of text — ask for fewer lines if the output is dense.",
        "parameters": {"type": "object", "properties": {
            "name":  {"type": "string", "description": "Window name"},
            "lines": {"type": "integer", "description": "Last N lines to capture, default 60, max 400"},
        }, "required": ["name"]},
    }},
    # ── Multi-line bpftrace authoring ───────────────────────────────────
    # bpftrace_oneliner handles single-liner probes; bpftrace_script lets
    # Bob author a full multi-statement .bt program (BEGIN/END blocks,
    # multiple probes, maps, interval timers). Runs async so Bob can poll
    # results without blocking the chat, and has a hard time budget so a
    # runaway probe cannot burn CPU forever.
    {"type": "function", "function": {
        "name": "bpftrace_probes",
        "description": "List available bpftrace probes matching a pattern. Use this BEFORE writing a script so you target a probe that actually exists on this kernel. Common patterns: 'kprobe:tcp_v4_*', 'tracepoint:syscalls:sys_enter_openat', 'kprobe:do_sys_open', 'tracepoint:sched:*'. Returns up to 300 probes.",
        "parameters": {"type": "object", "properties": {
            "pattern": {"type": "string", "description": "Probe pattern. Supports glob-style wildcards (* and ?)."},
            "limit":   {"type": "integer", "description": "Max probes to return (default 80)"},
        }, "required": ["pattern"]},
    }},
    {"type": "function", "function": {
        "name": "bpftrace_script",
        "description": "Author and run a multi-line bpftrace program. Use for anything beyond a one-liner: multiple probes, map aggregation, BEGIN/END blocks, interval timers. ALWAYS include either `interval:s:N { exit(); }` or a duration_s parameter so the probe stops on its own — never leave it running indefinitely. Returns the captured output (maps + printf lines) after the probe exits. Prefer aggregation (@count[comm] = count()) over raw printf for events with high rates.",
        "parameters": {"type": "object", "properties": {
            "script":     {"type": "string", "description": "Full bpftrace program text. Include BEGIN/END and any interval timers."},
            "duration_s": {"type": "integer", "description": "Force-exit after N seconds if the script hasn't already (default 15, max 120)"},
            "why":        {"type": "string", "description": "One-sentence explanation of what this script measures (logged to bob-rca.log for the user)"},
        }, "required": ["script"]},
    }},
]

async def _bob_request_confirm(websocket, tool, args, timeout=120):
    """Ask the UI to approve an execute tool. Returns dict with ok + (optional)
    edits (user may tweak args before approving). Timeout yields {"ok": False,
    "reason": "timeout"}.

    Pairs with the `bob_confirm_response` WS action, which looks up the
    confirm_id and resolves the Future with the user's choice."""
    confirm_id = uuid.uuid4().hex
    loop = asyncio.get_event_loop()
    fut = loop.create_future()
    PENDING_CONFIRMS[confirm_id] = fut
    await websocket.send(json.dumps({
        "type": "bob_confirm_request",
        "confirm_id": confirm_id,
        "tool": tool,
        "args": args,
        "timeout_s": timeout,
    }))
    try:
        return await asyncio.wait_for(fut, timeout=timeout)
    except asyncio.TimeoutError:
        return {"ok": False, "reason": "timeout"}
    finally:
        PENDING_CONFIRMS.pop(confirm_id, None)


async def _bob_run_playbook(websocket, args):
    """Execute `run_playbook` after the user has approved it. Streams output
    to the ansible log panel so the user sees the same thing the manual UI
    would. Returns a short summary string for Bob's context."""
    # Resolve playbook name to a full path — search system then user dirs.
    pb_name = (args.get("playbook") or "").strip()
    if not pb_name:
        return "error: no playbook specified"
    pb_name_yml = pb_name if pb_name.endswith((".yml", ".yaml")) else f"{pb_name}.yml"
    candidates = [
        os.path.join(ANSIBLE_PB_DIR, pb_name_yml),
        os.path.join(USER_PB_DIR,    pb_name_yml),
    ]
    pb_path = next((p for p in candidates if os.path.isfile(p)), None)
    if not pb_path:
        return f"error: playbook not found: {pb_name}"

    # Build the same msg shape _ansible_run expects so we reuse all its logic
    # (ledger rows, snapshot, stream).
    await _ansible_run(websocket, {
        "playbook":   pb_path,
        "limit":      args.get("limit") or "localhost",
        "extra_vars": args.get("extras") or {},
        "check":      bool(args.get("check")),
        "user":       "root",
    })
    return f"playbook {pb_name} dispatched (see ansible log for streaming output)"


def _bob_tool_exec(name, args):
    """Execute a Bob tool call. Returns a string (tool message content)."""
    args = args or {}
    try:
        if name == "list_nodes":
            nodes = db_list_nodes()
            if args.get("cluster"):
                nodes = [n for n in nodes if args["cluster"] in
                         (n.get("cluster_id") or "") or
                         args["cluster"] == (n.get("cluster_id") or "")]
            if args.get("role"):
                nodes = [n for n in nodes if n.get("role") == args["role"]]
            # Trim to essentials so Bob's context doesn't blow up on huge facts.
            slim = [{k: n.get(k) for k in ("hostname","role","cluster_id","ip_mgmt","status")} for n in nodes]
            return json.dumps(slim)
        if name == "list_clusters":
            return json.dumps(db_list_clusters())
        if name == "list_vms":
            return json.dumps(db_list_vms())
        if name == "list_deployments":
            limit = int(args.get("limit") or 20)
            con = _db_connect()
            rows = con.execute(
                "SELECT id, playbook, target, cluster_id, status, rc, started_at, finished_at "
                "FROM deployments ORDER BY id DESC LIMIT ?", (limit,)
            ).fetchall()
            con.close()
            return json.dumps([dict(r) for r in rows])
        if name == "list_events":
            limit = int(args.get("limit") or 50)
            events = db_list_events(limit)
            if args.get("type"):
                events = [e for e in events if e.get("type") == args["type"]]
            return json.dumps(events[:limit])
        if name == "list_playbooks":
            import glob as _glob
            pbs = []
            for p in sorted(_glob.glob(f"{ANSIBLE_PB_DIR}/*.yml")):
                pbs.append({"name": os.path.basename(p), "path": p})
            return json.dumps(pbs)

        # ── Live observability tools ─────────────────────────────────
        # All of the below wrap read-only shell commands with hard
        # timeouts and trimmed output so Bob's context doesn't explode
        # on a verbose kubectl or a noisy event stream. JSON-stringified
        # so llama3.1 can reason over structured data.
        k8s_env = {**os.environ, "KUBECONFIG": "/root/.kube/config", "HOME": "/root"}
        def _sh(cmd, timeout=8, env=None):
            try:
                return subprocess.check_output(cmd, text=True, stderr=subprocess.STDOUT,
                                               timeout=timeout, env=env or os.environ)
            except subprocess.CalledProcessError as e:
                return (e.output or "")[:3000]
            except subprocess.TimeoutExpired:
                return "(timed out)"
            except Exception as e:
                return f"(error: {e})"

        if name == "k8s_get_pods":
            cmd = ["kubectl", "get", "pods", "-o", "wide", "--no-headers"]
            if args.get("namespace"):
                cmd.extend(["-n", args["namespace"]])
            else:
                cmd.append("-A")
            out = _sh(cmd, env=k8s_env)
            rows = []
            for line in out.strip().splitlines()[:80]:
                parts = line.split()
                # -A adds namespace as first col; -n <ns> doesn't.
                has_ns = bool(args.get("namespace")) is False
                try:
                    if has_ns and len(parts) >= 8:
                        rows.append({"ns": parts[0], "name": parts[1], "ready": parts[2],
                                     "status": parts[3], "restarts": parts[4],
                                     "age": parts[5], "node": parts[7] if len(parts) > 7 else "?"})
                    elif not has_ns and len(parts) >= 7:
                        rows.append({"ns": args["namespace"], "name": parts[0], "ready": parts[1],
                                     "status": parts[2], "restarts": parts[3],
                                     "age": parts[4], "node": parts[6] if len(parts) > 6 else "?"})
                except Exception:
                    continue
            if args.get("status"):
                s = args["status"].lower()
                rows = [r for r in rows if s in r.get("status", "").lower()]
            return json.dumps({"count": len(rows), "pods": rows[:60]})

        if name == "k8s_get_nodes":
            out = _sh(["kubectl", "get", "nodes", "-o", "wide", "--no-headers"], env=k8s_env)
            top = _sh(["kubectl", "top", "nodes", "--no-headers"], env=k8s_env)
            top_map = {}
            for ln in top.strip().splitlines():
                parts = ln.split()
                if len(parts) >= 5:
                    top_map[parts[0]] = {"cpu": parts[1], "cpu_pct": parts[2],
                                         "mem": parts[3], "mem_pct": parts[4]}
            nodes = []
            for line in out.strip().splitlines():
                parts = line.split()
                if len(parts) >= 6:
                    nodes.append({"name": parts[0], "status": parts[1], "role": parts[2],
                                  "age": parts[3], "version": parts[4], "ip": parts[5],
                                  "metrics": top_map.get(parts[0], {})})
            return json.dumps({"nodes": nodes})

        if name == "k8s_describe":
            kind = args.get("kind", "").lower()
            rn   = args.get("name", "")
            ns   = args.get("namespace", "")
            if not kind or not rn:
                return json.dumps({"error": "kind and name required"})
            cmd = ["kubectl", "describe", kind, rn]
            if ns:
                cmd.extend(["-n", ns])
            out = _sh(cmd, timeout=10, env=k8s_env)
            # Trim to the interesting chunk — Events section is almost
            # always what matters, plus Conditions/Containers. Keep the
            # first 4KB so Bob's context stays lean.
            return out[:4000]

        if name == "k8s_logs":
            rn   = args.get("name", "")
            ns   = args.get("namespace", "")
            tail = min(int(args.get("tail") or 80), 500)
            if not rn or not ns:
                return json.dumps({"error": "name and namespace required"})
            cmd = ["kubectl", "logs", rn, "-n", ns, f"--tail={tail}", "--prefix=true"]
            if args.get("container"):
                cmd.extend(["-c", args["container"]])
            else:
                cmd.append("--all-containers=true")
            out = _sh(cmd, timeout=10, env=k8s_env)
            return out[-6000:]

        if name == "k8s_events":
            cmd = ["kubectl", "get", "events", "--sort-by=.lastTimestamp", "--no-headers"]
            if args.get("namespace"):
                cmd.extend(["-n", args["namespace"]])
            else:
                cmd.append("-A")
            if args.get("warnings_only"):
                cmd.extend(["--field-selector", "type=Warning"])
            out = _sh(cmd, env=k8s_env)
            lines = out.strip().splitlines()[-40:]
            return json.dumps({"count": len(lines), "events": lines})

        if name == "prom_query":
            import urllib.parse, urllib.request
            q = args.get("query", "")
            if not q:
                return json.dumps({"error": "query required"})
            try:
                url = f"http://localhost:9090/api/v1/query?query={urllib.parse.quote(q)}"
                with urllib.request.urlopen(url, timeout=5) as r:
                    data = json.loads(r.read().decode())
                # Compact result — label set + value only.
                result = []
                for s in data.get("data", {}).get("result", [])[:30]:
                    result.append({"labels": s.get("metric", {}), "value": s.get("value", [None, None])[1]})
                return json.dumps({"series": len(result), "result": result})
            except Exception as e:
                return json.dumps({"error": f"prometheus query failed: {e}"})

        if name == "zfs_status":
            pool = args.get("pool", "")
            cmd = ["zpool", "status"]
            if pool:
                cmd.append(pool)
            out = _sh(cmd, timeout=6)
            list_out = _sh(["zpool", "list", "-o", "name,size,allocated,free,health,frag,capacity"], timeout=4)
            return f"{list_out}\n\n{out[:3000]}"

        if name == "host_vitals":
            load = _sh(["cat", "/proc/loadavg"], timeout=2).strip()
            mem = _sh(["free", "-h"], timeout=2)
            disk = _sh(["df", "-h", "/", "/var", "/home"], timeout=3)
            up = _sh(["uptime", "-p"], timeout=2).strip()
            ker = _sh(["uname", "-sr"], timeout=2).strip()
            vms = _sh(["virsh", "list", "--name"], timeout=4).strip().splitlines()
            vms = [v for v in vms if v]
            return json.dumps({
                "loadavg": load, "memory": mem.strip(), "disk": disk.strip(),
                "uptime": up, "kernel": ker, "running_vms": len(vms), "vm_names": vms,
            })

        if name == "doctor_check":
            out = _sh(["kldload-doctor", "--json"], timeout=30)
            try:
                return out  # already JSON if --json supported
            except Exception:
                return _sh(["kldload-doctor"], timeout=30)[:4000]

        if name == "docs_search":
            # Grep-based docs retrieval over the scraped kldload corpus.
            # No vector DB, no embedding model — just ranked substring
            # matches with surrounding context. Fast, reliable, no setup.
            # The corpus lives at /usr/local/share/kldload-ai/ and ships
            # with every ISO (kldload-docs.txt = scraped site HTML to
            # text, kldload-manual.txt = OCR'd PDF manual).
            query = (args.get("query") or "").strip()
            max_hits = max(1, min(20, int(args.get("max_hits") or 5)))
            if not query:
                return json.dumps({"error": "query required"})
            corpus_paths = [
                "/usr/local/share/kldload-ai/kldload-docs.txt",
                "/usr/local/share/kldload-ai/kldload-manual.txt",
            ]
            # Split query into keyword terms; rank by how many terms hit.
            terms = [t for t in query.lower().split() if len(t) >= 2]
            if not terms:
                terms = [query.lower()]
            hits = []
            for path in corpus_paths:
                try:
                    with open(path, "r", errors="replace") as f:
                        text = f.read()
                except OSError:
                    continue
                # Chunk by blank-line-separated paragraphs; section
                # headers in the scrape look like "=== path/to/page ===".
                para = []
                para_start = 0
                cur_section = "(root)"
                source = path.split("/")[-1]
                for i, line in enumerate(text.splitlines()):
                    if line.startswith("=== ") and line.rstrip().endswith(" ==="):
                        cur_section = line.strip("= ").strip()
                        continue
                    if line.strip():
                        if not para:
                            para_start = i
                        para.append(line)
                        continue
                    if para:
                        blob = " ".join(para)
                        low = blob.lower()
                        score = sum(1 for t in terms if t in low)
                        if score:
                            hits.append((score, len(blob), source,
                                         cur_section, blob[:600]))
                        para = []
                if para:
                    blob = " ".join(para)
                    low = blob.lower()
                    score = sum(1 for t in terms if t in low)
                    if score:
                        hits.append((score, len(blob), source,
                                     cur_section, blob[:600]))
            # Rank: more matching terms first, shorter blobs tiebreak
            # (denser relevance).
            hits.sort(key=lambda h: (-h[0], h[1]))
            top = []
            for score, _size, source, section, blob in hits[:max_hits]:
                top.append({
                    "source": source,
                    "section": section,
                    "matched_terms": score,
                    "excerpt": blob,
                })
            return json.dumps({
                "query": query,
                "terms": terms,
                "total_matches": len(hits),
                "returned": len(top),
                "results": top,
            })

        # ── Bob's autonomous-shell handlers ──────────────────────────
        # shell_run, shell_run_async, shell_poll, terminal_send.
        # Approval (via _bob_request_confirm) is handled by the caller
        # for BOB_EXECUTE_TOOLS — by the time we reach this handler,
        # either the user clicked approve or UNLEASHED mode is on.
        def _bob_mirror_to_tmux(text):
            """Echo text into the ttyd-k9s:bob window if it exists so the
            user can watch Bob work in the Kubernetes tab's terminal."""
            try:
                # Ensure the 'bob' window exists (no-op if already there)
                subprocess.call(
                    ["tmux", "-L", "ttyd-k9s", "new-window",
                     "-d", "-t", "ttyd-k9s:", "-n", "bob"],
                    stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
                # Append a display-only echo (literal, no re-exec)
                subprocess.call(
                    ["tmux", "-L", "ttyd-k9s", "send-keys",
                     "-t", "ttyd-k9s:bob",
                     f"printf '%s\\n' {shlex.quote(text)}", "Enter"],
                    stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
            except Exception:
                pass

        def _bob_log_activity(kind, payload):
            try:
                from datetime import datetime
                with open("/root/bob-activity.log", "a") as f:
                    f.write(f"{datetime.now().isoformat()} {kind} "
                            f"{json.dumps(payload)[:2000]}\n")
            except Exception:
                pass

        if name == "shell_run":
            import shlex
            cmd = (args.get("command") or "").strip()
            cwd = args.get("cwd") or "/root"
            timeout = max(1, min(120, int(args.get("timeout") or 30)))
            if not cmd:
                return json.dumps({"error": "command required"})
            if BOB_SHELL_DANGEROUS.search(cmd):
                # Even UNLEASHED mode requires an extra nudge on these
                return json.dumps({
                    "error": "command matches dangerous pattern — refused",
                    "command": cmd,
                    "hint": "If you really need this, ask the user to run it manually.",
                })
            _bob_log_activity("shell_run_start", {"cmd": cmd, "cwd": cwd, "timeout": timeout})
            _bob_mirror_to_tmux(f"[bob] $ {cmd}")
            try:
                proc = subprocess.run(
                    cmd, shell=True, cwd=cwd, capture_output=True,
                    text=True, timeout=timeout,
                )
                out = (proc.stdout or "")[:8000]
                err = (proc.stderr or "")[:4000]
                rc = proc.returncode
            except subprocess.TimeoutExpired as e:
                out = (e.stdout or "")[:8000] if hasattr(e, "stdout") and e.stdout else ""
                err = f"TIMEOUT after {timeout}s"
                rc = -1
            except Exception as e:
                out, err, rc = "", f"exec error: {e}", -1
            # Mirror summary (first 10 lines of stdout) into the terminal
            _lines = out.splitlines()[:10]
            if _lines:
                _bob_mirror_to_tmux("\n".join(_lines))
            if rc != 0 and err.strip():
                _bob_mirror_to_tmux(f"[bob] stderr: {err.splitlines()[0] if err.splitlines() else err}")
            _bob_log_activity("shell_run_end", {"rc": rc, "stdout_bytes": len(out), "stderr_bytes": len(err)})
            return json.dumps({"exit": rc, "stdout": out, "stderr": err, "command": cmd})

        if name == "shell_run_async":
            import shlex, uuid
            cmd = (args.get("command") or "").strip()
            cwd = args.get("cwd") or "/root"
            ttl = max(1, min(1800, int(args.get("ttl") or 300)))
            if not cmd:
                return json.dumps({"error": "command required"})
            if BOB_SHELL_DANGEROUS.search(cmd):
                return json.dumps({"error": "command matches dangerous pattern — refused", "command": cmd})
            job_id = uuid.uuid4().hex[:12]
            _bob_log_activity("shell_run_async_start", {"job": job_id, "cmd": cmd, "ttl": ttl})
            _bob_mirror_to_tmux(f"[bob]async({job_id}) $ {cmd}")
            try:
                popen = subprocess.Popen(
                    cmd, shell=True, cwd=cwd,
                    stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                    text=True, bufsize=1,
                )
            except Exception as e:
                return json.dumps({"error": f"spawn failed: {e}"})
            import threading, time as _time
            stdout_buf: list = []
            stderr_buf: list = []
            def _drain(stream, buf):
                try:
                    for line in stream:
                        buf.append(line)
                        if len(buf) > 2000:
                            del buf[:1000]  # ring-trim to keep memory bounded
                except Exception:
                    pass
            threading.Thread(target=_drain, args=(popen.stdout, stdout_buf), daemon=True).start()
            threading.Thread(target=_drain, args=(popen.stderr, stderr_buf), daemon=True).start()
            def _ttl_killer(p, delay, jid):
                _time.sleep(delay)
                if p.poll() is None:
                    p.kill()
                    _bob_log_activity("shell_run_async_ttl_kill", {"job": jid})
            threading.Thread(target=_ttl_killer, args=(popen, ttl, job_id), daemon=True).start()
            BOB_SHELL_JOBS[job_id] = {
                "popen": popen, "stdout": stdout_buf, "stderr": stderr_buf,
                "started": _time.time(), "command": cmd, "cwd": cwd, "ttl": ttl,
            }
            return json.dumps({
                "job_id": job_id, "pid": popen.pid, "started": True,
                "poll_with": "shell_poll",
            })

        if name == "shell_poll":
            job_id = args.get("job_id") or ""
            tail = max(1, min(500, int(args.get("tail") or 40)))
            job = BOB_SHELL_JOBS.get(job_id)
            if not job:
                return json.dumps({"error": f"no such job: {job_id}"})
            popen = job["popen"]
            rc = popen.poll()
            import time as _time
            return json.dumps({
                "job_id": job_id,
                "command": job["command"],
                "running": rc is None,
                "exit": rc,
                "elapsed_sec": round(_time.time() - job["started"], 1),
                "stdout_tail": "".join(job["stdout"][-tail:])[:8000],
                "stderr_tail": "".join(job["stderr"][-tail:])[:4000],
            })

        if name == "terminal_send":
            import shlex
            keys = args.get("keys") or ""
            window = args.get("window") or ""
            no_enter = bool(args.get("no_enter"))
            target = "ttyd-k9s:" + window if window else "ttyd-k9s:"
            tmux_args = ["tmux", "-L", "ttyd-k9s", "send-keys", "-t", target, keys]
            if not no_enter:
                tmux_args.append("Enter")
            rc = subprocess.call(tmux_args, stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
            _bob_log_activity("terminal_send", {"target": target, "keys": keys[:200], "rc": rc})
            return json.dumps({"ok": rc == 0, "target": target, "sent": keys[:200]})

        # ── tmux driving (Bob-in-the-terminal) ───────────────────────
        # All three target the same ttyd-k9s socket/session that the
        # browser terminal is attached to, so the user sees everything
        # happen live in their tab.
        if name == "tmux_spawn":
            win = (args.get("name") or "").strip() or "bob"
            cmd = args.get("cmd") or "bash"
            # Kill any stale window by the same name so spawn is idempotent.
            subprocess.call(["tmux", "-L", "ttyd-k9s", "kill-window",
                             "-t", f"ttyd-k9s:{win}"],
                            stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
            rc = subprocess.call(["tmux", "-L", "ttyd-k9s", "new-window",
                                  "-t", "ttyd-k9s", "-n", win, cmd],
                                 stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
            _bob_log_activity("tmux_spawn", {"window": win, "cmd": cmd[:200], "rc": rc})
            return json.dumps({"ok": rc == 0, "window": win, "cmd": cmd[:200]})

        if name == "tmux_send":
            win = (args.get("name") or "").strip()
            if not win:
                return json.dumps({"ok": False, "error": "name required"})
            keys = args.get("keys") or ""
            no_enter = bool(args.get("no_enter"))
            tmux_args = ["tmux", "-L", "ttyd-k9s", "send-keys",
                         "-t", f"ttyd-k9s:{win}", keys]
            if not no_enter:
                tmux_args.append("Enter")
            rc = subprocess.call(tmux_args, stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
            _bob_log_activity("tmux_send", {"window": win, "keys": keys[:200], "rc": rc})
            return json.dumps({"ok": rc == 0, "window": win, "sent": keys[:200]})

        if name == "tmux_capture":
            win = (args.get("name") or "").strip()
            if not win:
                return json.dumps({"ok": False, "error": "name required"})
            lines = min(max(int(args.get("lines") or 60), 1), 400)
            try:
                out = subprocess.check_output(
                    ["tmux", "-L", "ttyd-k9s", "capture-pane",
                     "-t", f"ttyd-k9s:{win}", "-p", "-S", f"-{lines}"],
                    stderr=subprocess.STDOUT, timeout=5, text=True,
                )
                # Cap at ~4KB so a verbose log doesn't blow context.
                out = out[-4096:]
                return json.dumps({"ok": True, "window": win, "output": out})
            except subprocess.CalledProcessError as e:
                return json.dumps({"ok": False, "window": win, "error": (e.output or "")[:500]})
            except subprocess.TimeoutExpired:
                return json.dumps({"ok": False, "window": win, "error": "capture timeout"})

        # ── Multi-line bpftrace ──────────────────────────────────────
        # bpftrace_probes: discovery wrapper so Bob picks probes that
        # actually exist on this kernel instead of guessing and failing.
        if name == "bpftrace_probes":
            pat = args.get("pattern") or ""
            lim = min(max(int(args.get("limit") or 80), 1), 300)
            if not pat:
                return json.dumps({"ok": False, "error": "pattern required"})
            try:
                out = subprocess.check_output(
                    ["bpftrace", "-l", pat],
                    stderr=subprocess.STDOUT, timeout=10, text=True,
                )
                probes = [p for p in out.strip().split("\n") if p.strip()]
                truncated = len(probes) > lim
                return json.dumps({
                    "ok": True, "pattern": pat,
                    "count": len(probes),
                    "truncated": truncated,
                    "probes": probes[:lim],
                })
            except subprocess.CalledProcessError as e:
                return json.dumps({"ok": False, "error": (e.output or "bpftrace error")[:500]})
            except subprocess.TimeoutExpired:
                return json.dumps({"ok": False, "error": "bpftrace -l timed out"})
            except FileNotFoundError:
                return json.dumps({"ok": False, "error": "bpftrace binary not found"})

        # bpftrace_script: write a .bt file and run it with a hard
        # duration ceiling. Runs synchronously with timeout — the user
        # has already indicated they want results right in the chat,
        # not an async job id. duration_s is the model's "I'll need
        # this long"; timeout is duration_s + 5s grace.
        if name == "bpftrace_script":
            script = args.get("script") or ""
            dur = min(max(int(args.get("duration_s") or 15), 1), 120)
            why = (args.get("why") or "").strip()
            if not script.strip():
                return json.dumps({"ok": False, "error": "script required"})
            import tempfile as _tf
            fd, path = _tf.mkstemp(prefix="bob-", suffix=".bt", dir="/tmp")
            try:
                with os.fdopen(fd, "w") as f:
                    f.write(script)
                # Log for user audit before we run — so they can find the
                # script even if bpftrace crashes the kernel.
                _rca_log = globals().get("_rca_log")
                try:
                    with open("/root/bob-rca.log", "a") as lf:
                        lf.write(f"# bpftrace_script duration={dur}s why={why}\n")
                        lf.write(f"# path={path}\n---\n{script}\n---\n")
                except Exception:
                    pass
                out = subprocess.check_output(
                    ["bpftrace", path],
                    stderr=subprocess.STDOUT, timeout=dur + 5, text=True,
                )
                return json.dumps({"ok": True, "duration_s": dur,
                                   "script_path": path,
                                   "output": out[-8000:]})
            except subprocess.TimeoutExpired:
                return json.dumps({"ok": False, "error": "bpftrace exceeded duration budget",
                                   "script_path": path})
            except subprocess.CalledProcessError as e:
                return json.dumps({"ok": False, "error": (e.output or "bpftrace error")[:1200],
                                   "script_path": path})
            except FileNotFoundError:
                return json.dumps({"ok": False, "error": "bpftrace binary not found"})

        # ── RCA / deep observability implementations ─────────────────
        # Each caps output with a time window + line limit so a verbose
        # filter can't burn Bob's context. All log their invocation to
        # /root/bob-rca.log so the user can see what Bob traced.
        def _rca_log(tool, argv, summary):
            try:
                from datetime import datetime
                with open("/root/bob-rca.log", "a") as f:
                    f.write(f"# {datetime.now().isoformat()} {tool} {json.dumps(argv)}\n"
                            f"  → {summary[:200]}\n")
            except Exception:
                pass

        if name == "hubble_observe":
            secs = min(int(args.get("seconds") or 5), 30)
            lim  = min(int(args.get("limit") or 50), 200)
            cmd = ["kubectl", "-n", "kube-system", "exec", "ds/cilium", "-c", "cilium-agent",
                   "--", "hubble", "observe", "--output", "compact",
                   "--follow", "--since", f"{secs}s"]
            if args.get("verdict"):   cmd.extend(["--verdict", args["verdict"]])
            if args.get("namespace"): cmd.extend(["--namespace", args["namespace"]])
            if args.get("pod"):       cmd.extend(["--pod", args["pod"]])
            try:
                p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                     text=True, env=k8s_env)
                import time as _t
                deadline = _t.time() + secs + 2
                lines = []
                while _t.time() < deadline and len(lines) < lim:
                    line = p.stdout.readline()
                    if not line: break
                    lines.append(line.rstrip())
                p.terminate()
                out = "\n".join(lines[-lim:])
            except Exception as e:
                out = f"(error: {e})"
            _rca_log("hubble_observe", args, f"{len(out.splitlines())} flows captured")
            return out or "(no flows matched — try widening the filter or increasing seconds)"

        if name == "cilium_monitor":
            secs = min(int(args.get("seconds") or 5), 20)
            mtype = args.get("type") or "drop"
            cmd = ["kubectl", "-n", "kube-system", "exec", "ds/cilium", "-c", "cilium-agent",
                   "--", "timeout", str(secs), "cilium-dbg", "monitor", "--type", mtype]
            out = _sh(cmd, timeout=secs + 10, env=k8s_env)
            _rca_log("cilium_monitor", args, f"type={mtype} captured")
            return out[-6000:] or "(no events — zero drops in window is actually good)"

        if name == "tetragon_watch":
            secs = min(int(args.get("seconds") or 5), 20)
            cmd = ["kubectl", "-n", "kube-system", "exec", "ds/tetragon", "-c", "tetragon",
                   "--", "timeout", str(secs), "tetra", "getevents", "-o", "compact"]
            if args.get("namespace"): cmd.extend(["--namespace", args["namespace"]])
            if args.get("pod"):       cmd.extend(["--pod", args["pod"]])
            out = _sh(cmd, timeout=secs + 10, env=k8s_env)
            _rca_log("tetragon_watch", args, "captured")
            return out[-6000:] or "(no events captured — window may be too short)"

        if name == "cilium_status":
            out = _sh(["kubectl", "-n", "kube-system", "exec", "ds/cilium",
                       "-c", "cilium-agent", "--", "cilium-dbg", "status", "--verbose"],
                      timeout=15, env=k8s_env)
            return out[:5000]

        if name == "cilium_endpoint_list":
            out = _sh(["kubectl", "-n", "kube-system", "exec", "ds/cilium",
                       "-c", "cilium-agent", "--", "cilium-dbg", "endpoint", "list"],
                      timeout=10, env=k8s_env)
            return out[:5000]

        if name == "kernel_dmesg":
            tail = min(int(args.get("tail") or 100), 500)
            out = _sh(["dmesg", "--human", "--ctime"], timeout=4)
            lines = out.splitlines()
            if args.get("grep"):
                import re as _re
                try:
                    rx = _re.compile(args["grep"])
                    lines = [ln for ln in lines if rx.search(ln)]
                except Exception:
                    pass
            return "\n".join(lines[-tail:])[-6000:]

        if name == "top_procs":
            by = args.get("by", "cpu").lower()
            n = min(int(args.get("count") or 15), 50)
            sort = "-%cpu" if by != "mem" else "-%mem"
            out = _sh(["ps", "-eo", "pid,user,%cpu,%mem,rss,comm,cmd", "--sort", sort],
                      timeout=3)
            lines = out.splitlines()
            return "\n".join([lines[0]] + lines[1:1 + n]) if lines else out

        if name == "ss_sockets":
            state = args.get("state", "listening")
            flag  = {"listening": "-tln", "established": "-tn", "all": "-tan"}.get(state, "-tln")
            out = _sh(["ss", flag, "-p"], timeout=3)
            if args.get("port"):
                port = str(args["port"])
                all_lines = out.splitlines()
                header = all_lines[0] if all_lines else ""
                matches = [ln for ln in all_lines[1:] if f":{port}" in ln]
                out = "\n".join([header] + matches) if header else "\n".join(matches)
            return out[:5000]

        if name == "zfs_arc_stats":
            # Pull the most human-useful fields from arcstats. Raw file is
            # huge; we cherry-pick hit rate, size, max, and memory pressure.
            out = _sh(["cat", "/proc/spl/kstat/zfs/arcstats"], timeout=3)
            if not out or "error" in out.lower():
                return "(arcstats unavailable — is ZFS loaded?)"
            keys = {"size": 0, "c": 0, "c_max": 0, "hits": 0, "misses": 0,
                    "mfu_hits": 0, "mru_hits": 0, "prefetch_data_hits": 0,
                    "memory_throttle_count": 0}
            for ln in out.splitlines():
                parts = ln.split()
                if len(parts) >= 3 and parts[0] in keys:
                    try: keys[parts[0]] = int(parts[2])
                    except Exception: pass
            total = keys["hits"] + keys["misses"]
            hit_pct = round((keys["hits"] / total) * 100, 2) if total else 0.0
            def _fmt(n):
                for unit in ("", "K", "M", "G", "T"):
                    if abs(n) < 1024: return f"{n:.1f}{unit}"
                    n /= 1024
                return f"{n:.1f}P"
            return json.dumps({
                "size":      _fmt(keys["size"]),
                "target":    _fmt(keys["c"]),
                "max":       _fmt(keys["c_max"]),
                "hit_ratio": f"{hit_pct}%",
                "hits":      keys["hits"],
                "misses":    keys["misses"],
                "mfu_hits":  keys["mfu_hits"],
                "mru_hits":  keys["mru_hits"],
                "throttle":  keys["memory_throttle_count"],
            })

        if name == "bpftrace_oneliner":
            # NOTE: gated through BOB_EXECUTE_TOOLS. This branch only
            # runs after the user approves in the confirm card. Script is
            # passed via stdin so we don't have to worry about shell
            # escaping a BPF program body.
            script = args.get("script", "")
            secs = min(int(args.get("seconds") or 5), 30)
            if not script:
                return json.dumps({"error": "script required"})
            try:
                p = subprocess.Popen(["timeout", str(secs), "bpftrace", "-e", script],
                                     stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                out, _ = p.communicate(timeout=secs + 5)
            except Exception as e:
                out = f"(error: {e})"
            _rca_log("bpftrace_oneliner", args, f"{len(out.splitlines())} lines captured")
            return out[-6000:]
    except Exception as e:
        return json.dumps({"error": str(e)})
    return json.dumps({"error": f"unknown tool: {name}"})


async def _bob_chat(websocket, msg):
    """Chat with Bob, with optional infra tool calling.

    Protocol: if Ollama returns tool_calls in its response, we execute each
    tool locally, append the result as a tool message, and re-query Ollama.
    Loop caps at 5 rounds to keep a runaway tool binge from burning the
    conversation. User text (the actual answer) streams back at the end.
    """
    model    = msg.get("model", "")
    messages = list(msg.get("messages", []))
    use_tools = bool(msg.get("tools", True))   # UI can disable if desired

    if not model or not messages:
        await websocket.send(json.dumps({"type": "error", "msg": "model and messages required"}))
        return

    import concurrent.futures, urllib.request, queue, threading

    def _ollama_chat_stream(msgs, msg_queue):
        """Stream chunks from Ollama to a queue. Non-blocking from asyncio's
        POV — runs in a thread. Each queued item is either:
          ('chunk', content_str)   — token(s) from the assistant
          ('done',  {tool_calls: [...], content: full_content})
          ('error', exception_str)
        """
        payload = {"model": model, "messages": msgs, "stream": True}
        if use_tools:
            payload["tools"] = BOB_TOOLS
        try:
            req = urllib.request.Request(
                "http://localhost:11434/api/chat",
                data=json.dumps(payload).encode(),
                headers={"Content-Type": "application/json"},
            )
            r = urllib.request.urlopen(req, timeout=300)
            buffer = b""
            accumulated_content = ""
            accumulated_tools = []
            while True:
                chunk = r.read(512)
                if not chunk:
                    break
                buffer += chunk
                while b"\n" in buffer:
                    line, buffer = buffer.split(b"\n", 1)
                    if not line.strip():
                        continue
                    try:
                        j = json.loads(line)
                    except Exception:
                        continue
                    m = j.get("message", {}) or {}
                    c = m.get("content", "") or ""
                    tc = m.get("tool_calls") or []
                    if c:
                        accumulated_content += c
                        msg_queue.put(("chunk", c))
                    if tc:
                        accumulated_tools.extend(tc)
                    if j.get("done"):
                        msg_queue.put(("done", {
                            "content": accumulated_content,
                            "tool_calls": accumulated_tools,
                        }))
                        return
            # EOF without explicit done — treat as done
            msg_queue.put(("done", {
                "content": accumulated_content,
                "tool_calls": accumulated_tools,
            }))
        except Exception as e:
            msg_queue.put(("error", str(e)))

    async def _run_one_round(msgs):
        """Start streaming chat, forward chunks to the client in real time,
        return (content, tool_calls) when the stream completes."""
        q: "queue.Queue" = queue.Queue()
        t = threading.Thread(target=_ollama_chat_stream, args=(msgs, q), daemon=True)
        t.start()
        loop = asyncio.get_event_loop()
        while True:
            kind, payload = await loop.run_in_executor(None, q.get)
            if kind == "chunk":
                await websocket.send(json.dumps({
                    "type": "bob_chat_chunk", "content": payload, "done": False,
                }))
            elif kind == "done":
                return payload.get("content", ""), payload.get("tool_calls", [])
            elif kind == "error":
                raise RuntimeError(payload)

    # qwen2.5:14b (and other smaller-model wobble cases) frequently emits
    # tool calls as TEXT instead of as proper tool_use blocks — typically
    # `[tool: shell_run({"command": "..."})]` inline in content. The Ollama
    # tool-call protocol never fires in that case, so the round counts as
    # "no tool" and the loop breaks early or hits the cap with garbage.
    # This regex pulls those text emissions back into structured tool_calls
    # so the existing executor path runs them. Catches the dominant failure
    # mode without requiring a model swap or prompt-eng heroics.
    import re as _re
    _TOOL_TEXT_RE = _re.compile(
        r'\[tool:\s*([A-Za-z_][A-Za-z0-9_]*)\(\s*(\{.*?\})\s*\)\s*\]',
        _re.DOTALL,
    )

    def _extract_text_tool_calls(text):
        out = []
        if not text:
            return out
        for nm, args_json in _TOOL_TEXT_RE.findall(text):
            try:
                argv = json.loads(args_json)
            except Exception:
                continue
            out.append({"function": {"name": nm, "arguments": argv}})
        return out

    try:
        # Always stream, even with tools. Tool_calls arrive in the final
        # "done" chunk — Ollama sends content tokens first, then the tool
        # request at the end if the model wants to call one. User sees
        # live typing for plain chats; tool rounds still gate correctly.
        if use_tools:
            # Cap at 12 rounds (was 5). qwen2.5:14b is wobbly enough that
            # 5 was hitting the cap on legitimate multi-step workflows. 12
            # is still bounded enough to prevent runaway loops eating the
            # context, but gives enough room for a 4-tool diagnosis recipe
            # plus retries. Stronger models (qwen3:30b-a3b) finish in 2-3
            # rounds and never approach the cap regardless.
            for _round in range(12):
                content, tcalls = await _run_one_round(messages)
                # Text-tool-call interceptor: convert `[tool: name({...})]`
                # text emissions into structured calls so the executor runs
                # them. Only kicks in when the model didn't emit a real
                # tool_call in this round.
                if not tcalls:
                    text_tcalls = _extract_text_tool_calls(content)
                    if text_tcalls:
                        await websocket.send(json.dumps({
                            "type": "bob_chat_chunk",
                            "content": f"\n[harness: rescued {len(text_tcalls)} text-emitted tool call(s)]\n",
                            "done": False,
                        }))
                        tcalls = text_tcalls
                if not tcalls:
                    break
                messages.append({"role": "assistant",
                                 "content": content or "",
                                 "tool_calls": tcalls})
                for tc in tcalls:
                        fn   = (tc.get("function") or {})
                        nm   = fn.get("name", "")
                        argv = fn.get("arguments") or {}
                        if isinstance(argv, str):
                            try: argv = json.loads(argv)
                            except Exception: argv = {}
                        db_log_event("bob_tool", nm, f"Bob called {nm}", {"args": argv})
                        await websocket.send(json.dumps({
                            "type": "bob_chat_chunk",
                            "content": f"\n[tool: {nm}({json.dumps(argv)})]\n",
                            "done": False,
                        }))
                        # Gate: when BOB_AUTONOMOUS (default), every tool runs
                        # immediately — no modal, no confirm future round-trip.
                        # Audit is still full: every call is logged to state.db
                        # above and ZFS snapshots make any action rollback-able.
                        # Paranoid mode (autonomy off) restores the old approval
                        # flow for tools in BOB_EXECUTE_TOOLS.
                        autonomous = _bob_autonomy_get()
                        if (not autonomous) and nm in BOB_EXECUTE_TOOLS:
                            decision = await _bob_request_confirm(websocket, nm, argv)
                            if not decision.get("ok"):
                                reason = decision.get("reason") or "user rejected"
                                await websocket.send(json.dumps({
                                    "type": "bob_chat_chunk",
                                    "content": f"  → {reason}\n",
                                    "done": False,
                                }))
                                result = json.dumps({"rejected": True, "reason": reason})
                            else:
                                final_args = decision.get("args") or argv
                                await websocket.send(json.dumps({
                                    "type": "bob_chat_chunk",
                                    "content": "  → approved, executing…\n",
                                    "done": False,
                                }))
                                if nm == "run_playbook":
                                    summary = await _bob_run_playbook(websocket, final_args)
                                    result = json.dumps({"ok": True, "summary": summary})
                                else:
                                    result = _bob_tool_exec(nm, final_args)
                        else:
                            # Autonomous path OR non-execute tool: just fire.
                            if nm == "run_playbook":
                                summary = await _bob_run_playbook(websocket, argv)
                                result = json.dumps({"ok": True, "summary": summary})
                            else:
                                result = _bob_tool_exec(nm, argv)
                        messages.append({"role": "tool", "name": nm, "content": result})
                else:
                    await websocket.send(json.dumps({
                        "type": "bob_chat_chunk",
                        "content": "\n[tool loop capped at 12 rounds]\n",
                        "done": False,
                    }))
            else:
                # Classic streaming path — no tools
                chunks = await loop.run_in_executor(pool, _stream_call, messages)
                for c in chunks:
                    await websocket.send(json.dumps({
                        "type": "bob_chat_chunk", "content": c, "done": False,
                    }))

        await websocket.send(json.dumps({"type": "bob_chat_done"}))
    except Exception as e:
        await websocket.send(json.dumps({"type": "bob_chat_error", "error": str(e)}))


async def _bob_execute(websocket, msg):
    """Bob executes a command on the host or a VM. Returns output."""
    cmd_str = msg.get("command", "").strip()
    target = msg.get("target", "host")  # "host" or "vm_ip"

    if not cmd_str:
        await websocket.send(json.dumps({"type": "bob_exec", "output": "(no command)", "rc": 1}))
        return

    # Safety: block obviously dangerous commands
    blocked = ["rm -rf /", "mkfs", "dd if=", ":(){ :|:&", "fork bomb", "> /dev/sd"]
    if any(b in cmd_str.lower() for b in blocked):
        await websocket.send(json.dumps({"type": "bob_exec", "output": "Bob won't run that.", "rc": 1}))
        return

    try:
        if target == "host":
            proc = await asyncio.create_subprocess_shell(
                cmd_str,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.STDOUT,
            )
            stdout, _ = await asyncio.wait_for(proc.communicate(), timeout=30)
            output = stdout.decode(errors="replace")
            await websocket.send(json.dumps({
                "type": "bob_exec",
                "output": output[-4096:],  # last 4KB
                "rc": proc.returncode,
                "target": "host",
            }))
        else:
            # Remote VM via SSH
            ip = target
            if not re.match(r'^[\d.]+$', ip):
                await websocket.send(json.dumps({"type": "bob_exec", "output": f"invalid IP: {ip}", "rc": 1}))
                return
            proc = await asyncio.create_subprocess_exec(
                "ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
                f"root@{ip}", cmd_str,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.STDOUT,
            )
            stdout, _ = await asyncio.wait_for(proc.communicate(), timeout=30)
            output = stdout.decode(errors="replace")
            await websocket.send(json.dumps({
                "type": "bob_exec",
                "output": output[-4096:],
                "rc": proc.returncode,
                "target": ip,
            }))
    except asyncio.TimeoutError:
        await websocket.send(json.dumps({"type": "bob_exec", "output": "(command timed out after 30s)", "rc": 124}))
    except Exception as e:
        await websocket.send(json.dumps({"type": "bob_exec", "output": str(e), "rc": 1}))

    db_log_event("bob_exec", cmd_str[:100], f"Bob ran: {cmd_str[:200]} on {target}")


async def _klab_explain(websocket, msg):
    """Send eBPF/flow data to local Ollama LLM and return plain English explanation."""
    data = msg.get("data", "")
    context = msg.get("context", "network traffic")

    if not data:
        await websocket.send(json.dumps({"type": "error", "msg": "no data to explain"}))
        return

    # Check if Ollama is running
    try:
        import urllib.request
        r = urllib.request.urlopen("http://localhost:11434/api/tags", timeout=2)
        if r.status != 200:
            raise Exception("Ollama not responding")
        tags = json.loads(r.read())
        models = [m["name"] for m in tags.get("models", [])]
        if not models:
            await websocket.send(json.dumps({
                "type": "klab_explain",
                "explanation": "(No models loaded in Ollama. Run: ollama pull llama3.1:8b)",
                "model": "",
            }))
            return
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "klab_explain",
            "explanation": f"(Ollama not available: {e}. Install the AI profile or run: systemctl start ollama)",
            "model": "",
        }))
        return

    # Pick model: prefer bob, then llama3.1:8b, then whatever's loaded
    model = "bob"
    if model not in models:
        model = next((m for m in models if "llama" in m.lower()), models[0])

    prompt = f"""You are a network security analyst on a kldload multi-distro test platform.
Analyze this {context} and explain in plain English:
- What is happening
- Whether it looks normal or suspicious
- What service or process is likely generating it
- Any security concerns

Be concise. 3-5 sentences max.

Data:
{data[:3000]}"""

    await websocket.send(json.dumps({
        "type": "log_line", "target": "klab",
        "line": f"[bob] Asking {model} to explain {context}...",
    }))

    try:
        req_data = json.dumps({
            "model": model,
            "prompt": prompt,
            "stream": False,
        }).encode()
        req = urllib.request.Request(
            "http://localhost:11434/api/generate",
            data=req_data,
            headers={"Content-Type": "application/json"},
        )
        r = urllib.request.urlopen(req, timeout=60)
        resp = json.loads(r.read())
        explanation = resp.get("response", "(no response)")

        await websocket.send(json.dumps({
            "type": "klab_explain",
            "explanation": explanation,
            "model": model,
        }))
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "klab_explain",
            "explanation": f"(LLM request failed: {e})",
            "model": model,
        }))


# ── eBPF Tracing ─────────────────────────────────────────────────────────────

_EBPF_PROC = None

BCC_TOOLS = {
    "execsnoop", "opensnoop", "funccount", "syscount", "trace",
    "tcplife", "tcpconnect", "tcpaccept", "tcpretrans", "tcpdrop",
    "biolatency", "biosnoop", "ext4slower", "filetop",
    "cachestat", "runqlat", "cpudist", "pidstat",
}

def _find_bcc_tool(name):
    """Find a bcc tool binary path."""
    for path in [f"/usr/share/bcc/tools/{name}",
                 f"/usr/sbin/{name}-bpfcc",
                 f"/usr/bin/{name}-bpfcc",
                 f"/usr/sbin/{name}",
                 f"/usr/bin/{name}"]:
        if os.path.isfile(path):
            return path
    return None


async def _klab_ebpf_trace(websocket, msg):
    """Run a bcc/bpftrace tool on host or remote VM, stream output."""
    global _EBPF_PROC
    tool = msg.get("tool", "execsnoop")
    target = msg.get("target", "host")
    duration = int(msg.get("duration", 10))
    arg = msg.get("arg", "")

    # Validate tool
    if tool != "bpftrace" and tool not in BCC_TOOLS:
        await websocket.send(json.dumps({"type": "error", "msg": f"unknown tool: {tool}"}))
        return

    # Build command
    if target == "host":
        if tool == "bpftrace":
            cmd = ["bpftrace", "-e", arg] if arg else ["bpftrace", "-l"]
        else:
            bin_path = _find_bcc_tool(tool)
            if not bin_path:
                await websocket.send(json.dumps({"type": "error", "msg": f"{tool} not found — install bcc-tools"}))
                return
            cmd = [bin_path]
            if arg and tool in ("funccount", "trace"):
                cmd.append(arg)
            if duration > 0 and tool in ("funccount", "biolatency", "runqlat", "cpudist", "cachestat", "syscount"):
                cmd += [str(duration), "1"]
    else:
        # Remote VM via SSH — use argv form to avoid shell injection
        parts = target.split("|")
        ip = parts[1] if len(parts) > 1 else parts[0]
        if not re.match(r'^[\d.]+$', ip):
            await websocket.send(json.dumps({"type": "error", "msg": f"invalid IP: {ip}"}))
            return
        # Build remote command as argv list passed to SSH (no shell interpretation)
        remote_argv = []
        if tool == "bpftrace":
            remote_argv = ["bpftrace", "-e", arg] if arg else ["bpftrace", "-l"]
        else:
            remote_argv = [tool]
            if arg and tool in ("funccount", "trace"):
                remote_argv.append(shlex.quote(arg))
            if duration > 0 and tool in ("funccount", "biolatency", "runqlat", "cpudist", "cachestat", "syscount"):
                remote_argv += [str(duration), "1"]
        cmd = ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5",
               f"root@{ip}"] + remote_argv

    # Kill any existing trace
    if _EBPF_PROC and _EBPF_PROC.returncode is None:
        try:
            _EBPF_PROC.kill()
        except Exception:
            pass

    try:
        timeout_s = duration + 5 if duration > 0 else 300
        _EBPF_PROC = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.STDOUT,
        )
        deadline = asyncio.get_event_loop().time() + timeout_s
        try:
            if _EBPF_PROC and _EBPF_PROC.stdout:
                async for raw_line in _EBPF_PROC.stdout:
                    if asyncio.get_event_loop().time() > deadline:
                        break
                    await websocket.send(json.dumps({
                        "type": "klab_ebpf_output",
                        "line": raw_line.decode(errors="replace").rstrip(),
                    }))
        except Exception as e:
            LOG.warning("ebpf stream error: %s", e)
        finally:
            # Always clean up the process
            if _EBPF_PROC and _EBPF_PROC.returncode is None:
                try:
                    _EBPF_PROC.kill()
                    await _EBPF_PROC.wait()
                except Exception:
                    pass

        await websocket.send(json.dumps({"type": "klab_ebpf_done", "tool": tool}))
    except Exception as e:
        await websocket.send(json.dumps({"type": "error", "msg": f"trace failed: {e}"}))


async def _klab_ebpf_stop(websocket):
    """Stop running eBPF trace."""
    global _EBPF_PROC
    if _EBPF_PROC and _EBPF_PROC.returncode is None:
        try:
            _EBPF_PROC.kill()
            await _EBPF_PROC.wait()
        except Exception:
            pass
    await websocket.send(json.dumps({"type": "klab_ebpf_done", "tool": "stopped"}))


# ── Per-VM console in the UI ─────────────────────────────────────────────────
# Each VM gets its own tmux window inside the ttyd-k9s session running
# `virsh console <vm>`. The browser iframes ttyd with #<window-name> so
# switching VMs in the UI just switches tmux windows — no extra ports,
# no websockify, no auth complexity. Works for any VM that has a serial
# device (klab/kspawn both configure one via virt-install).
def _vm_console_window_name(vm):
    # tmux window names can't have dots or colons — sanitise
    import re as _re_vm
    return "vm-" + _re_vm.sub(r"[^A-Za-z0-9_-]", "-", vm)[:60]


def _vm_lookup_ip(vm):
    """Return first usable IPv4 for a libvirt domain, or None.

    Thin wrapper around _vm_resolve_ip (defined alongside _klab_get_site_vms)
    which does agent → arp → lease in that order. Previously this function
    only tried lease + agent and missed every Debian/Ubuntu cloud-image VM
    (no qemu-guest-agent installed by default) whose dnsmasq lease was
    present but `virsh domifaddr --source lease` didn't surface it — the
    user got "Couldn't find an IPv4" from Switch-to-SSH even when arp had
    the address. Unified IP-discovery path means klab UI, VMs list, and
    SSH-open all behave consistently.
    """
    return _vm_resolve_ip(vm) or None


async def _vm_ssh_open(websocket, msg):
    """Open an SSH session into a running VM via the kldload tmux session
    (same pattern as the K8s node/pod shell). One ttyd-k9s at /k9s/ multiplexes
    every shell session via tmux windows — the iframe just shows /k9s/ and the
    user lands inside the SSH session.

    Tries cert auth first (admin@IP with /root/.ssh/id_ed25519, which klab/
    zfslab goldens accept), then password fallback (root@IP password=kldload,
    which kube-cluster-spawned cluster nodes accept). The hold-on-exit
    wrapper keeps the tmux pane visible if SSH fails so the user can read
    the error instead of seeing a vanished window."""
    vm = (msg.get("vm") or "").strip()
    if not vm:
        await websocket.send(json.dumps({"type": "error", "msg": "vm name required"}))
        return
    ip = _vm_lookup_ip(vm)
    if not ip:
        await websocket.send(json.dumps({
            "type": "vm_console_error", "vm": vm,
            "error": "Couldn't find an IPv4 for this VM yet — still booting / no DHCP lease / no guest agent.",
        }))
        return
    # Try admin@ with key first, fall back to root@ with password. The `||`
    # is a real shell-level fallback — if the first ssh exits nonzero
    # within 3 seconds (auth failure), the second runs.
    ssh_admin = (
        f"ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "
        f"-o ConnectTimeout=5 -o PasswordAuthentication=no "
        f"-i /root/.ssh/id_ed25519 admin@{ip}"
    )
    ssh_root = (
        f"sshpass -p kldload ssh -o StrictHostKeyChecking=no "
        f"-o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 "
        f"-o PreferredAuthentications=password root@{ip}"
    )
    tmux_cmd = (
        f"echo '── ssh → {vm} ({ip}) ──'; "
        f"echo 'trying admin@ with key …'; "
        f"{ssh_admin} || (echo; echo 'admin@ failed, trying root@ with password kldload …'; {ssh_root}); "
        "rc=$?; "
        "echo; echo \"[ssh exited rc=$rc] press Enter to close\"; "
        "read"
    )
    window_name = f"vm-{vm}"[:40]
    auto_ok = False
    err_msg = ""
    try:
        # Bootstrap kldload tmux session if missing (ttyd-k9s creates it lazily)
        hs = await asyncio.create_subprocess_exec(
            "tmux", "has-session", "-t", "kldload",
            stderr=asyncio.subprocess.DEVNULL)
        if (await hs.wait()) != 0:
            await (await asyncio.create_subprocess_exec(
                "tmux", "new-session", "-d", "-s", "kldload", "-n", "home",
                stderr=asyncio.subprocess.DEVNULL)).wait()
        check = await asyncio.create_subprocess_exec(
            "tmux", "list-windows", "-t", "kldload", "-F", "#{window_name}",
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE)
        wout, _ = await check.communicate()
        windows = (wout.decode() if wout else "").split()
        if window_name in windows:
            p = await asyncio.create_subprocess_exec(
                "tmux", "select-window", "-t", f"kldload:{window_name}",
                stderr=asyncio.subprocess.PIPE)
            _, err = await p.communicate()
            if p.returncode != 0:
                err_msg = f"select-window: {err.decode()[:200]}"
            else:
                auto_ok = True
        else:
            p = await asyncio.create_subprocess_exec(
                "tmux", "new-window", "-t", "kldload",
                "-n", window_name, tmux_cmd,
                stderr=asyncio.subprocess.PIPE)
            _, err = await p.communicate()
            if p.returncode != 0:
                err_msg = f"new-window: {err.decode()[:200]}"
            else:
                p2 = await asyncio.create_subprocess_exec(
                    "tmux", "select-window", "-t", f"kldload:{window_name}",
                    stderr=asyncio.subprocess.DEVNULL)
                await p2.wait()
                auto_ok = True
    except Exception as ex:
        err_msg = f"exception: {ex}"
    await websocket.send(json.dumps({
        "type": "vm_ssh_shell",
        "vm": vm, "ip": ip,
        "auto": auto_ok,
        "window": window_name,
        "cmd_display": f"ssh -i /root/.ssh/id_ed25519 admin@{ip}  (or root@{ip} pw=kldload)",
        "error": err_msg,
    }))


async def _vm_display_open(websocket, msg):
    """Spawn a websockify+noVNC bridge to a running VM's graphical VNC port.

    Doesn't go through kldload-session (which is ttyd-only); instead writes
    its own systemd-run unit for websockify and a matching nginx drop-in
    at /s/<id>/. websockify serves noVNC's HTML bundle as static content
    from --web=/usr/share/novnc, AND upgrades the same path's WebSocket to
    the VM's VNC TCP port. The UI iframe loads .../vnc.html which calls
    back into .../websockify for the WS — both same-origin, no CORS."""
    import os as _os, secrets as _secrets, socket as _sock, re as _re_disp
    vm = (msg.get("vm") or "").strip()
    if not vm:
        await websocket.send(json.dumps({"type": "error", "msg": "vm name required"}))
        return
    # Resolve VNC display → port
    try:
        disp = subprocess.check_output(
            ["virsh", "vncdisplay", vm],
            text=True, stderr=subprocess.DEVNULL, timeout=5).strip()
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "vm_console_error", "vm": vm,
            "error": f"virsh vncdisplay {vm} failed: {e} — does the VM have a VNC graphics device?",
        }))
        return
    m_disp = _re_disp.match(r":(\d+)", disp)
    if not m_disp:
        await websocket.send(json.dumps({
            "type": "vm_console_error", "vm": vm,
            "error": f"VM has no VNC graphics device (vncdisplay output: {disp!r}). Add <graphics type='vnc'/> to its XML.",
        }))
        return
    vnc_port = 5900 + int(m_disp.group(1))
    # noVNC HTML bundle has to be present — installed as `novnc` rpm/deb
    novnc_web = "/usr/share/novnc"
    if not _os.path.isdir(novnc_web):
        await websocket.send(json.dumps({
            "type": "vm_console_error", "vm": vm,
            "error": "noVNC not installed on this host (package `novnc` missing). Will be in the next ISO build.",
        }))
        return
    # Pick a free localhost port for websockify
    _s = _sock.socket(); _s.bind(("127.0.0.1", 0))
    listen_port = _s.getsockname()[1]; _s.close()
    # Short hex session id — same shape as kldload-session uses so they
    # cohabit in /etc/nginx/conf.d/kldload-dyn/ without naming clashes.
    sid = _secrets.token_hex(6)
    unit = f"kldload-vnc-{sid}.service"
    try:
        subprocess.check_call([
            "systemd-run", "--unit", unit, "--collect", "--",
            "/usr/bin/websockify",
            f"--web={novnc_web}",
            f"127.0.0.1:{listen_port}",
            f"localhost:{vnc_port}",
        ], stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL, timeout=10)
    except Exception as e:
        await websocket.send(json.dumps({
            "type": "vm_console_error", "vm": vm,
            "error": f"websockify systemd-run failed: {e}",
        }))
        return
    # nginx drop-in. websockify serves both static and WS on the same port,
    # so one location block covers both. WS upgrade headers are mandatory.
    ngx_dyn = "/etc/nginx/conf.d/kldload-dyn"
    _os.makedirs(ngx_dyn, exist_ok=True)
    drop_in = _os.path.join(ngx_dyn, f"vnc-{sid}.conf")
    with open(drop_in, "w") as f:
        f.write(
            f"# kldload VNC session {sid} for {vm} (websockify→{vnc_port})\n"
            f"location /s/{sid}/ {{\n"
            f"    proxy_pass http://127.0.0.1:{listen_port}/;\n"
            f"    proxy_http_version 1.1;\n"
            f"    proxy_set_header Upgrade $http_upgrade;\n"
            f"    proxy_set_header Connection \"upgrade\";\n"
            f"    proxy_set_header Host $host;\n"
            f"    proxy_buffering off;\n"
            f"    proxy_read_timeout 24h;\n"
            f"    proxy_send_timeout 24h;\n"
            f"}}\n"
        )
    subprocess.call(["nginx", "-s", "reload"],
                     stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
    # nginx -s reload is async (SIGHUP) — workers swap configs ~50-200ms
    # later. Returning the URL immediately races the browser iframe load
    # against the worker swap, and the iframe lands on the catch-all
    # webui location → 404. Poll the new location until non-404 (or 3s
    # timeout) so the URL we return is guaranteed live.
    import urllib.request as _urlreq, ssl as _ssl_, time as _time_
    _ctx = _ssl_.create_default_context(); _ctx.check_hostname=False; _ctx.verify_mode=_ssl_.CERT_NONE
    for _ in range(30):
        try:
            req = _urlreq.Request(f"https://127.0.0.1:8443/s/{sid}/vnc.html", method="HEAD")
            with _urlreq.urlopen(req, timeout=1, context=_ctx) as resp:
                if resp.status != 404:
                    break
        except Exception:
            pass
        _time_.sleep(0.1)
    # noVNC client entry — autoconnect via websockify same-origin path.
    # show_dot=1: VMs often don't send a cursor image (blank GNOME cursor
    # over black framebuffer until the desktop fully paints), and noVNC
    # hides the local cursor inside the canvas — so the mouse visually
    # vanishes the moment it enters the iframe. show_dot paints a small
    # dot at the pointer position when the remote cursor is null. Without
    # this the operator thinks the console is broken.
    # reconnect=1: auto-rejoin on transient WS drops (VM reboots, network
    # hiccups). Cheaper than re-clicking View.
    url = f"/s/{sid}/vnc.html?autoconnect=1&resize=scale&show_dot=1&reconnect=1&path=s/{sid}/websockify"
    await websocket.send(json.dumps({
        "type": "vm_display_opened",
        "vm": vm,
        "url": url,
        "session_id": sid,
        "kind": "vnc",
        "vnc_port": vnc_port,
        "ok": True,
    }))


async def _vm_display_close(websocket, msg):
    """Stop the websockify unit + remove its nginx drop-in (paired with
    _vm_display_open)."""
    import os as _os
    vm  = (msg.get("vm") or "").strip()
    sid = (msg.get("session_id") or "").strip()
    if not sid:
        await websocket.send(json.dumps({"type": "error", "msg": "session_id required"}))
        return
    subprocess.call(["systemctl", "stop", f"kldload-vnc-{sid}.service"],
                     stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
    try:
        _os.remove(f"/etc/nginx/conf.d/kldload-dyn/vnc-{sid}.conf")
    except OSError:
        pass
    subprocess.call(["nginx", "-s", "reload"],
                     stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
    await websocket.send(json.dumps({
        "type": "vm_display_closed",
        "vm": vm, "session_id": sid, "ok": True,
    }))

async def _vm_console_open(websocket, msg):
    """Open a dedicated ttyd → virsh console session for a VM, behind nginx.

    Rewritten 2026-05-16 to use kldload-session. The previous implementation
    tried to short-circuit through the shared ttyd-k9s tmux session (with
    target session named "ttyd-k9s") but two issues compounded: (a) the
    actual tmux session created by kldload-console is named "kldload",
    not "ttyd-k9s", so every tmux new-window failed with rc=1; (b) even
    if the window existed, ttyd doesn't pass URL ?target-window=X into
    its spawned command, so the iframe landed on the default home window
    showing k9s, not the VM serial — the symptom on .127 2026-05-16 was
    "modal opens with a black screen." Switching to kldload-session means
    each VM console gets its OWN ttyd process bound to its OWN port,
    nginx routes /s/<id>/ to it, and the iframe loads that URL directly —
    no shared tmux to bridge, the URL IS the console.
    """
    vm = (msg.get("vm") or "").strip()
    if not vm:
        await websocket.send(json.dumps({"type": "error", "msg": "vm name required"}))
        return
    # Validate VM exists (cheap libvirt round-trip; clearer error than waiting
    # for kldload-session's ttyd to fail with virsh "domain not found")
    try:
        out = subprocess.check_output(["virsh", "list", "--all", "--name"],
                                       text=True, stderr=subprocess.DEVNULL)
        if vm not in out.strip().splitlines():
            await websocket.send(json.dumps({"type": "vm_console_error",
                                              "vm": vm,
                                              "error": f"VM not found: {vm}"}))
            return
    except Exception as e:
        await websocket.send(json.dumps({"type": "vm_console_error", "vm": vm,
                                          "error": f"virsh failed: {e}"}))
        return
    # Spawn a dedicated ttyd-on-virsh-console session via kldload-session.
    # Kind "vm-serial" is defined at kldload-session:87 — it runs
    # /usr/bin/virsh console --force <target>. kldload-session prints
    # the URL on stdout, writes /etc/nginx/conf.d/kldload-dyn/<id>.conf,
    # and reloads nginx — all the boilerplate we'd otherwise inline.
    try:
        url_out = subprocess.check_output(
            ["/usr/local/sbin/kldload-session", "open", "vm-serial", vm,
             "--title", f"VM Console: {vm}"],
            text=True, stderr=subprocess.STDOUT, timeout=15
        )
    except subprocess.CalledProcessError as e:
        await websocket.send(json.dumps({
            "type": "vm_console_error",
            "vm": vm,
            "error": f"kldload-session open failed (rc={e.returncode}): {e.output.strip() if e.output else ''}",
        }))
        return
    except subprocess.TimeoutExpired:
        await websocket.send(json.dumps({
            "type": "vm_console_error",
            "vm": vm,
            "error": "kldload-session open timed out after 15s",
        }))
        return
    # kldload-session prints "https://host:8443/s/<id>/" on stdout — extract
    # the path part for the iframe (same-origin), and the session id for
    # the future close.
    import re as _re_vc
    url_line = ""
    for line in url_out.strip().splitlines():
        if "/s/" in line:
            url_line = line.strip()
            break
    m_path = _re_vc.search(r'(/s/[A-Za-z0-9_-]+/)', url_line)
    m_sid  = _re_vc.search(r'/s/([A-Za-z0-9_-]+)/', url_line)
    if not m_path or not m_sid:
        await websocket.send(json.dumps({
            "type": "vm_console_error",
            "vm": vm,
            "error": f"could not parse kldload-session output: {url_out.strip()[:200]}",
        }))
        return
    await websocket.send(json.dumps({
        "type": "vm_console_opened",
        "vm": vm,
        "url": m_path.group(1),
        "session_id": m_sid.group(1),
        "ok": True,
        "hint": "Ctrl-] inside the terminal detaches from virsh console without killing the VM.",
    }))

async def _vm_console_close(websocket, msg):
    """Close a VM console session — stops the ttyd unit and removes the
    nginx drop-in via kldload-session close. Prefers the explicit
    session_id the UI tracked from _open; falls back to enumerating
    active sessions and matching by vm name if the UI lost track
    (e.g., browser refresh)."""
    vm = (msg.get("vm") or "").strip()
    sid = (msg.get("session_id") or "").strip()
    if not vm and not sid:
        await websocket.send(json.dumps({"type": "error", "msg": "vm name or session_id required"}))
        return
    if not sid and vm:
        # Find sid by enumerating sessions and matching kind=vm-serial + target=vm
        try:
            j = subprocess.check_output(
                ["/usr/local/sbin/kldload-session", "list"],
                text=True, stderr=subprocess.DEVNULL, timeout=5)
            import re as _re_vcl
            for line in j.splitlines():
                if "vm-serial" in line and vm in line:
                    m = _re_vcl.search(r'\b([0-9a-f]{8,})\b', line)
                    if m:
                        sid = m.group(1)
                        break
        except Exception:
            pass
    ok = False
    if sid:
        rc = subprocess.call(
            ["/usr/local/sbin/kldload-session", "close", sid],
            stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
        ok = (rc == 0)
    await websocket.send(json.dumps({
        "type": "vm_console_closed",
        "vm": vm,
        "session_id": sid,
        "ok": ok,
    }))

async def _vm_console_list(websocket):
    """List currently-open VM console windows."""
    try:
        out = subprocess.check_output(
            ["tmux", "list-windows", "-t", "ttyd-k9s", "-F", "#{window_name}"],
            text=True, stderr=subprocess.DEVNULL)
        windows = [w for w in out.strip().splitlines() if w.startswith("vm-")]
    except Exception:
        windows = []
    await websocket.send(json.dumps({"type": "vm_console_list", "windows": windows}))


# ── Distro matrix runner ─────────────────────────────────────────────────────

async def _klab_run_playbook(websocket, msg):
    """Run a playbook/script against selected klab VMs. Auto-snapshot first."""
    distros = msg.get("distros", [])  # list of distro names
    site = msg.get("site", "blue")
    playbook = msg.get("playbook", "")
    script = msg.get("script", "")

    if not distros:
        distros = KLAB_DISTROS
    if not playbook and not script:
        await websocket.send(json.dumps({"type": "error", "msg": "playbook or script required"}))
        return

    await _auto_snapshot(websocket, "playbook")

    # Get VM IPs for selected distros
    vms = _klab_get_site_vms(site)
    targets = [v for v in vms if v["distro"] in distros and v["state"] == "running"]

    if not targets:
        await websocket.send(json.dumps({
            "type": "error",
            "msg": f"No running {site} VMs for distros: {', '.join(distros)}",
        }))
        return

    # Run against each target
    for vm in targets:
        await websocket.send(json.dumps({
            "type": "log_line", "target": "klab",
            "line": f"\n{'='*60}\n  Running on {vm['name']} ({vm['distro']}) @ {vm['ip']}\n{'='*60}",
        }))

        if script:
            # Inline script — pipe to SSH
            cmd = ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=10",
                   f"root@{vm['ip']}", "bash", "-s"]
            proc = await asyncio.create_subprocess_exec(
                *cmd,
                stdin=asyncio.subprocess.PIPE,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.STDOUT,
            )
            stdout, _ = await proc.communicate(input=script.encode())
            for line in stdout.decode(errors="replace").splitlines():
                await websocket.send(json.dumps({
                    "type": "log_line", "target": "klab", "line": line,
                }))
        elif playbook:
            # Ansible playbook against this host — minutes per VM.
            cmd = ["ansible-playbook", playbook, "-i", f"{vm['ip']},",
                   "--user", "root", "--ssh-extra-args", "-o StrictHostKeyChecking=no"]
            await _stream_proc_detached(websocket, cmd, target="klab")

    await websocket.send(json.dumps({
        "type": "klab_playbook_done",
        "distros": [v["distro"] for v in targets],
        "count": len(targets),
    }))
    await _klab_status(websocket)


async def main_async(args):
    import http
    import mimetypes
    from websockets.http11 import Response as WsResponse
    from websockets.datastructures import Headers as WsHeaders

    # Order matters: _ensure_secrets_dir() creates rpool/kldload/state and
    # mounts it on /var/lib/kldload. If db_init() runs first, its state.db
    # lands on the underlying rootfs and the ZFS mount hides it — every
    # subsequent reader sees a fresh empty mount and "no such table" errors.
    try:
        backend = _ensure_secrets_dir()
        LOG.info("Secrets backend: %s", backend)
    except Exception as e:
        LOG.warning("Secrets backend init failed: %s", e)
    db_init()
    # --no-tls is set by kldload-webui.service when kldload-proxy is fronting
    # us on :8443; we bind 127.0.0.1:8444 plain HTTP so one cert prompt on
    # the proxy covers the entire origin (webui + grafana + k9s iframes).
    ssl_ctx = None if args.no_tls else _get_ssl_context()
    scheme    = "https" if ssl_ctx else "http"

    async def process_request(connection, request):
        """Serve static HTTP requests inline; return None to allow WS upgrade."""
        if request.headers.get("Upgrade", "").lower() == "websocket":
            return None  # hand off to ws_handler
        url_path = request.path.split("?")[0] or "/"
        if url_path == "/":
            url_path = "/index.html"
        file_path = WEBUI_DIR / url_path.lstrip("/")
        # Prevent path traversal
        try:
            file_path.resolve().relative_to(WEBUI_DIR.resolve())
        except ValueError:
            return WsResponse(403, "Forbidden", WsHeaders([]), b"Forbidden\n")
        if not file_path.exists() or not file_path.is_file():
            return WsResponse(404, "Not Found", WsHeaders([]), b"Not Found\n")
        ctype, _ = mimetypes.guess_type(str(file_path))
        body = file_path.read_bytes()
        headers = WsHeaders([
            ("Content-Type", ctype or "application/octet-stream"),
            ("Content-Length", str(len(body))),
            ("Cache-Control", "no-cache"),
        ])
        return WsResponse(200, "OK", headers, body)

    # Single port for both HTTP (static files) and WebSocket
    ws_server = await websockets.serve(
        ws_handler, args.bind, args.port,
        ping_interval=20, ping_timeout=10,
        ssl=ssl_ctx,
        process_request=process_request,
    )
    LOG.info("kldload Web UI on %s://%s:%d (HTTP + WebSocket)", scheme, args.bind, args.port)

    url = f"{scheme}://localhost:{args.port}"
    LOG.info("kldload Web UI ready: %s", url)

    if not args.no_browser:
        for cmd in ["xdg-open", "firefox-esr", "chromium"]:
            try:
                subprocess.Popen([cmd, url],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                break
            except FileNotFoundError:
                continue

    await ws_server.wait_closed()

def main():
    parser = argparse.ArgumentParser(description="kldload Web UI")
    parser.add_argument("--port",       type=int, default=8080,  help="HTTP + WebSocket port (default 8080)")
    parser.add_argument("--bind",       default="0.0.0.0",       help="Bind address (default 0.0.0.0)")
    parser.add_argument("--no-browser", action="store_true",     help="Don't open browser")
    parser.add_argument("--no-tls",     action="store_true",     help="Serve plain HTTP — used when fronted by kldload-proxy")
    args = parser.parse_args()

    # webui needs root: it chmod()s /var/lib/kldload/secrets to 0700, creates
    # ZFS datasets, generates TLS certs, and drives installer subprocesses.
    # Running as the 'live' user silently EPERM-cascades through init and
    # lands on "readonly database" — point the operator at the right fix
    # up-front.
    if os.geteuid() != 0:
        sys.stderr.write(
            "kldload-webui must run as root.\n"
            "  Systemd-managed:  systemctl status kldload-webui\n"
            "  Manual:           sudo kldload-webui [args]\n"
        )
        sys.exit(2)

    try:
        asyncio.run(main_async(args))
    except KeyboardInterrupt:
        LOG.info("Shutting down")

if __name__ == "__main__":
    main()
