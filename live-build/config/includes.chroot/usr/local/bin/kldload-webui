#!/usr/bin/env python3
"""
kldload-webui — lightweight web-based installer UI for KLDload.
Serves a browser frontend and exposes a WebSocket API so the browser
can drive installs, spawns, and VM management without a terminal.

Usage:
  kldload-webui [--port PORT] [--bind ADDR] [--no-browser]
"""
import argparse
import asyncio
import datetime
import json
import logging
import os
import re
import shlex
import sqlite3
import ssl
import subprocess
import sys
import threading
import time
import uuid
from http.server import HTTPServer, SimpleHTTPRequestHandler
from pathlib import Path

try:
    import yaml
except ImportError:
    yaml = None

try:
    import websockets
except ImportError:
    print("[kldload-webui] Installing websockets...")
    subprocess.check_call([sys.executable, "-m", "pip", "install", "--quiet", "websockets"])
    import websockets

LOG = logging.getLogger("kldload-webui")
logging.basicConfig(level=logging.INFO, format="[%(asctime)s] [webui] %(message)s",
                    datefmt="%Y-%m-%dT%H:%M:%S")

# Serve from edition-specific UI directory.
# build-iso.sh copies the right edition into 'active/' at build time.
# Fall back to base dir if active/ doesn't exist yet.
_WEBUI_BASE = Path("/usr/local/share/kldload-webui")
_WEBUI_ACTIVE = _WEBUI_BASE / "active"
WEBUI_DIR = _WEBUI_ACTIVE if _WEBUI_ACTIVE.is_dir() else _WEBUI_BASE

EDITION = Path("/etc/kldload/edition").read_text().strip() if Path("/etc/kldload/edition").exists() else "free"
MANIFEST         = Path("/etc/kldload/install-manifest.env")
CREDENTIALS_PATH = Path("/run/kldload/credentials.json")
DB_PATH          = Path("/var/lib/kldload/state.db")
LOG_FILES  = {
    "installer": "/var/log/installer/kldload-installer.log",
    "storage":   "/var/log/installer/storage.log",
    "network":   "/var/log/installer/network.log",
    "bootstrap": "/var/log/installer/bootstrap.log",
    "snapshots": "/var/log/kldload/snapshots.log",
    "firstboot": "/var/log/kldload/firstboot.log",
    "autoboot":  "/var/log/kldload/autobootstrap.log",
    "audit":     "/var/log/kldload/audit.log",
}

# ── State database ─────────────────────────────────────────────────────────────

def _db_now():
    return datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")

def _db_connect():
    con = sqlite3.connect(DB_PATH)
    con.row_factory = sqlite3.Row
    con.execute("PRAGMA journal_mode=WAL")
    return con

def db_init():
    """Create state.db and all tables if not present."""
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    con = _db_connect()
    con.executescript("""
    CREATE TABLE IF NOT EXISTS templates (
        id          TEXT PRIMARY KEY,
        type        TEXT NOT NULL,
        name        TEXT NOT NULL,
        description TEXT DEFAULT '',
        data        TEXT NOT NULL,
        created_at  TEXT NOT NULL,
        updated_at  TEXT NOT NULL
    );
    CREATE TABLE IF NOT EXISTS nodes (
        id          TEXT PRIMARY KEY,
        hostname    TEXT NOT NULL UNIQUE,
        role        TEXT DEFAULT 'unknown',
        ip_mgmt     TEXT DEFAULT '',
        ip_wg0      TEXT DEFAULT '',
        ip_wg1      TEXT DEFAULT '',
        ip_wg2      TEXT DEFAULT '',
        ip_wg3      TEXT DEFAULT '',
        wg_pubkey   TEXT DEFAULT '',
        cluster_id  TEXT DEFAULT '',
        status      TEXT DEFAULT 'unknown',
        last_seen   TEXT DEFAULT '',
        facts       TEXT DEFAULT '{}',
        created_at  TEXT NOT NULL
    );
    CREATE TABLE IF NOT EXISTS clusters (
        id          TEXT PRIMARY KEY,
        name        TEXT NOT NULL UNIQUE,
        template_id TEXT DEFAULT '',
        status      TEXT DEFAULT 'designing',
        data        TEXT NOT NULL,
        created_at  TEXT NOT NULL,
        updated_at  TEXT NOT NULL
    );
    CREATE TABLE IF NOT EXISTS vms (
        id          TEXT PRIMARY KEY,
        cluster_id  TEXT NOT NULL,
        node_id     TEXT DEFAULT '',
        name        TEXT NOT NULL,
        role        TEXT NOT NULL,
        cpu         INTEGER DEFAULT 2,
        ram_gb      INTEGER DEFAULT 4,
        disk_gb     INTEGER DEFAULT 64,
        status      TEXT DEFAULT 'defined',
        golden_src  TEXT DEFAULT '',
        ip_addr     TEXT DEFAULT '',
        wg_pubkey   TEXT DEFAULT '',
        last_seen   TEXT DEFAULT '',
        data        TEXT DEFAULT '{}',
        created_at  TEXT NOT NULL
    );
    CREATE TABLE IF NOT EXISTS events (
        id          INTEGER PRIMARY KEY AUTOINCREMENT,
        ts          TEXT NOT NULL,
        type        TEXT NOT NULL,
        subject     TEXT DEFAULT '',
        message     TEXT NOT NULL,
        data        TEXT DEFAULT '{}'
    );
    CREATE TABLE IF NOT EXISTS services (
        id           TEXT PRIMARY KEY,
        name         TEXT NOT NULL UNIQUE,
        description  TEXT DEFAULT '',
        cluster_id   TEXT DEFAULT '',
        node_targets TEXT DEFAULT '[]',
        dataset      TEXT DEFAULT '',
        image        TEXT DEFAULT '',
        runtime      TEXT DEFAULT 'systemd',
        status       TEXT DEFAULT 'defined',
        version      TEXT DEFAULT '',
        replicas     INTEGER DEFAULT 1,
        repl_targets TEXT DEFAULT '[]',
        config       TEXT DEFAULT '{}',
        salt_state   TEXT DEFAULT '',
        created_at   TEXT NOT NULL,
        updated_at   TEXT NOT NULL
    );
    CREATE TABLE IF NOT EXISTS bob_conversations (
        id          TEXT PRIMARY KEY,
        title       TEXT DEFAULT 'New conversation',
        messages    TEXT NOT NULL DEFAULT '[]',
        created_at  TEXT NOT NULL,
        updated_at  TEXT NOT NULL
    );
    """)
    con.commit()
    con.close()
    LOG.info("State DB ready: %s", DB_PATH)

# ── Bob conversation persistence ──────────────────────────────────────────────

def db_bob_list():
    """List all Bob conversations, newest first."""
    con = _db_connect()
    rows = con.execute(
        "SELECT id, title, created_at, updated_at FROM bob_conversations ORDER BY updated_at DESC"
    ).fetchall()
    con.close()
    return [dict(r) for r in rows]

def db_bob_load(conv_id):
    """Load a Bob conversation by ID."""
    con = _db_connect()
    row = con.execute(
        "SELECT id, title, messages, created_at, updated_at FROM bob_conversations WHERE id=?",
        (conv_id,)
    ).fetchone()
    con.close()
    if row:
        result = dict(row)
        result["messages"] = json.loads(result["messages"])
        return result
    return None

def db_bob_save(conv_id, title, messages):
    """Create or update a Bob conversation."""
    con = _db_connect()
    now = _db_now()
    row = con.execute("SELECT id FROM bob_conversations WHERE id=?", (conv_id,)).fetchone()
    if row:
        con.execute(
            "UPDATE bob_conversations SET title=?, messages=?, updated_at=? WHERE id=?",
            (title, json.dumps(messages), now, conv_id)
        )
    else:
        con.execute(
            "INSERT INTO bob_conversations (id, title, messages, created_at, updated_at) VALUES (?,?,?,?,?)",
            (conv_id, title, json.dumps(messages), now, now)
        )
    con.commit()
    con.close()
    return conv_id

def db_bob_delete(conv_id):
    """Delete a Bob conversation."""
    con = _db_connect()
    con.execute("DELETE FROM bob_conversations WHERE id=?", (conv_id,))
    con.commit()
    con.close()

# ── Template CRUD ─────────────────────────────────────────────────────────────

def db_save_template(type_, name, description, data):
    """Insert or update a template by type+name. Returns the id."""
    con = _db_connect()
    now = _db_now()
    row = con.execute(
        "SELECT id FROM templates WHERE type=? AND name=?", (type_, name)
    ).fetchone()
    if row:
        id_ = row["id"]
        con.execute(
            "UPDATE templates SET description=?,data=?,updated_at=? WHERE id=?",
            (description, json.dumps(data), now, id_)
        )
    else:
        id_ = str(uuid.uuid4())
        con.execute(
            "INSERT INTO templates (id,type,name,description,data,created_at,updated_at) "
            "VALUES (?,?,?,?,?,?,?)",
            (id_, type_, name, description, json.dumps(data), now, now)
        )
    con.commit()
    con.close()
    return id_

def db_list_templates(type_=None):
    """List templates, optionally filtered by type, newest first."""
    con = _db_connect()
    if type_:
        rows = con.execute(
            "SELECT id,type,name,description,created_at,updated_at "
            "FROM templates WHERE type=? ORDER BY updated_at DESC", (type_,)
        ).fetchall()
    else:
        rows = con.execute(
            "SELECT id,type,name,description,created_at,updated_at "
            "FROM templates ORDER BY type,updated_at DESC"
        ).fetchall()
    result = [dict(r) for r in rows]
    con.close()
    return result

def db_load_template(id_):
    """Load a full template by id. Returns dict with data parsed, or None."""
    con = _db_connect()
    row = con.execute("SELECT * FROM templates WHERE id=?", (id_,)).fetchone()
    con.close()
    if not row:
        return None
    d = dict(row)
    try:
        d["data"] = json.loads(d["data"])
    except Exception:
        pass
    return d

def db_delete_template(id_):
    con = _db_connect()
    con.execute("DELETE FROM templates WHERE id=?", (id_,))
    con.commit()
    con.close()

def db_register_node(hostname, role="unknown", ip_mgmt="", ip_wg0="", ip_wg1="",
                     ip_wg2="", ip_wg3="", wg_pubkey="", cluster_id="", facts=None):
    """Upsert a node into the inventory. Returns the node id."""
    con = _db_connect()
    now = _db_now()
    facts_str = json.dumps(facts or {})
    row = con.execute("SELECT id FROM nodes WHERE hostname=?", (hostname,)).fetchone()
    if row:
        id_ = row["id"]
        con.execute(
            "UPDATE nodes SET role=?,ip_mgmt=?,ip_wg0=?,ip_wg1=?,ip_wg2=?,ip_wg3=?,"
            "wg_pubkey=?,cluster_id=?,status='online',last_seen=?,facts=? WHERE hostname=?",
            (role, ip_mgmt, ip_wg0, ip_wg1, ip_wg2, ip_wg3,
             wg_pubkey, cluster_id, now, facts_str, hostname)
        )
    else:
        id_ = str(uuid.uuid4())
        con.execute(
            "INSERT INTO nodes (id,hostname,role,ip_mgmt,ip_wg0,ip_wg1,ip_wg2,ip_wg3,"
            "wg_pubkey,cluster_id,status,last_seen,facts,created_at) "
            "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
            (id_, hostname, role, ip_mgmt, ip_wg0, ip_wg1, ip_wg2, ip_wg3,
             wg_pubkey, cluster_id, "online", now, facts_str, now)
        )
    con.commit()
    con.close()
    return id_

def db_list_nodes():
    con = _db_connect()
    rows = con.execute(
        "SELECT * FROM nodes ORDER BY role,hostname"
    ).fetchall()
    result = []
    for r in rows:
        d = dict(r)
        try:    d["facts"] = json.loads(d["facts"])
        except Exception: d["facts"] = {}
        result.append(d)
    con.close()
    return result

def db_log_event(type_, subject, message, data=None):
    con = _db_connect()
    con.execute(
        "INSERT INTO events (ts,type,subject,message,data) VALUES (?,?,?,?,?)",
        (_db_now(), type_, subject, message, json.dumps(data or {}))
    )
    con.commit()
    con.close()

def db_list_events(limit=100):
    con = _db_connect()
    rows = con.execute(
        "SELECT * FROM events ORDER BY id DESC LIMIT ?", (limit,)
    ).fetchall()
    result = []
    for r in rows:
        d = dict(r)
        try:    d["data"] = json.loads(d["data"])
        except Exception: d["data"] = {}
        result.append(d)
    con.close()
    return result

def db_list_clusters():
    con = _db_connect()
    rows = con.execute("SELECT * FROM clusters ORDER BY updated_at DESC").fetchall()
    result = []
    for r in rows:
        d = dict(r)
        try: d["data"] = json.loads(d["data"])
        except Exception: d["data"] = {}
        result.append(d)
    con.close()
    return result

def db_list_vms(cluster_id=None):
    con = _db_connect()
    if cluster_id:
        rows = con.execute("SELECT * FROM vms WHERE cluster_id=? ORDER BY role,name", (cluster_id,)).fetchall()
    else:
        rows = con.execute("SELECT * FROM vms ORDER BY cluster_id,role,name").fetchall()
    result = []
    for r in rows:
        d = dict(r)
        try: d["data"] = json.loads(d["data"])
        except Exception: d["data"] = {}
        result.append(d)
    con.close()
    return result

def db_upsert_cluster(name, data, template_id="", status="designing"):
    con = _db_connect()
    now = _db_now()
    row = con.execute("SELECT id FROM clusters WHERE name=?", (name,)).fetchone()
    if row:
        id_ = row["id"]
        con.execute(
            "UPDATE clusters SET data=?,template_id=?,status=?,updated_at=? WHERE id=?",
            (json.dumps(data), template_id, status, now, id_)
        )
    else:
        id_ = str(uuid.uuid4())
        con.execute(
            "INSERT INTO clusters (id,name,template_id,status,data,created_at,updated_at) VALUES (?,?,?,?,?,?,?)",
            (id_, name, template_id, status, json.dumps(data), now, now)
        )
    con.commit()
    con.close()
    return id_

def db_save_service(name, description="", cluster_id="", node_targets=None,
                    dataset="", image="", runtime="systemd", replicas=1,
                    repl_targets=None, config=None, salt_state=""):
    """Insert or update a service definition. Returns the id."""
    con = _db_connect()
    now = _db_now()
    row = con.execute("SELECT id FROM services WHERE name=?", (name,)).fetchone()
    data_args = (
        description, cluster_id,
        json.dumps(node_targets or []),
        dataset or f"rpool/services/{name}",
        image, runtime, replicas,
        json.dumps(repl_targets or []),
        json.dumps(config or {}),
        salt_state, now,
    )
    if row:
        id_ = row["id"]
        con.execute(
            "UPDATE services SET description=?,cluster_id=?,node_targets=?,dataset=?,"
            "image=?,runtime=?,replicas=?,repl_targets=?,config=?,salt_state=?,updated_at=? WHERE id=?",
            data_args + (id_,)
        )
    else:
        id_ = str(uuid.uuid4())
        con.execute(
            "INSERT INTO services (id,name,description,cluster_id,node_targets,dataset,"
            "image,runtime,replicas,repl_targets,config,salt_state,status,created_at,updated_at) "
            "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
            (id_, name) + data_args + ("defined", now,)
        )
    con.commit()
    con.close()
    return id_

def db_list_services(cluster_id=None):
    con = _db_connect()
    if cluster_id:
        rows = con.execute(
            "SELECT * FROM services WHERE cluster_id=? ORDER BY name", (cluster_id,)
        ).fetchall()
    else:
        rows = con.execute("SELECT * FROM services ORDER BY name").fetchall()
    result = []
    for r in rows:
        d = dict(r)
        for f in ("node_targets", "repl_targets", "config"):
            try: d[f] = json.loads(d[f])
            except Exception: d[f] = [] if f != "config" else {}
        result.append(d)
    con.close()
    return result

def db_load_service(id_):
    con = _db_connect()
    row = con.execute("SELECT * FROM services WHERE id=?", (id_,)).fetchone()
    con.close()
    if not row:
        return None
    d = dict(row)
    for f in ("node_targets", "repl_targets", "config"):
        try: d[f] = json.loads(d[f])
        except Exception: d[f] = [] if f != "config" else {}
    return d

def db_delete_service(id_):
    con = _db_connect()
    con.execute("DELETE FROM services WHERE id=?", (id_,))
    con.commit()
    con.close()

def db_update_service_status(id_, status, version=""):
    con = _db_connect()
    con.execute(
        "UPDATE services SET status=?,version=?,updated_at=? WHERE id=?",
        (status, version, _db_now(), id_)
    )
    con.commit()
    con.close()

def db_export_all():
    """Export entire DB as a JSON dict (for seed disk / live→master handoff)."""
    con = _db_connect()
    export = {}
    for table in ("templates", "nodes", "clusters", "vms", "services", "events"):
        try:
            rows = con.execute(f"SELECT * FROM {table}").fetchall()
            export[table] = [dict(r) for r in rows]
        except Exception:
            export[table] = []
    con.close()
    return export

def db_import_all(data, merge=True):
    """Import a DB export dict. merge=True skips rows with existing PKs."""
    con = _db_connect()
    counts = {}
    for table, rows in data.items():
        if table == "events":
            continue  # events are append-only, skip import
        n = 0
        for row in rows:
            cols = list(row.keys())
            placeholders = ",".join(["?"] * len(cols))
            vals = [row[c] for c in cols]
            conflict = "OR IGNORE" if merge else "OR REPLACE"
            try:
                con.execute(
                    f"INSERT {conflict} INTO {table} ({','.join(cols)}) VALUES ({placeholders})",
                    vals
                )
                n += 1
            except Exception:
                pass
        counts[table] = n
    con.commit()
    con.close()
    return counts

def is_live_mode():
    """Return True if running on the live ISO (not installed system)."""
    try:
        cmdline = Path("/proc/cmdline").read_text()
        if "boot=live" in cmdline:
            return True
    except Exception:
        pass
    node_env = Path("/etc/kldload/node.env")
    return not node_env.exists()

def get_node_env():
    """Return dict of key=value pairs from /etc/kldload/node.env, or {} if absent."""
    env = {}
    try:
        for line in Path("/etc/kldload/node.env").read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, _, v = line.partition("=")
                env[k.strip()] = v.strip()
    except Exception:
        pass
    return env

# ── Disk detection ─────────────────────────────────────────────────────────────

def get_disks():
    """Return list of usable block devices, NVMe first, USB/removable last."""
    try:
        out = subprocess.check_output(
            ["lsblk", "-J", "-o", "NAME,SIZE,MODEL,TYPE,RM,MOUNTPOINT,ROTA,TRAN"],
            text=True
        )
        data = json.loads(out)
        disks = []
        # Detect the live boot device so we can flag it
        live_dev = ""
        try:
            with open("/proc/cmdline") as f:
                cmdline = f.read()
            # Find the device backing /run/initramfs/live
            live_mount = subprocess.check_output(
                ["findmnt", "-n", "-o", "SOURCE", "/run/initramfs/live"],
                text=True
            ).strip()  # e.g. /dev/sda or /dev/sda1
            import re
            m = re.match(r'(/dev/[a-z]+)', live_mount)
            if m:
                live_dev = m.group(1)
        except Exception:
            pass

        for d in data.get("blockdevices", []):
            if d.get("type") == "disk":
                dev_path = f'/dev/{d["name"]}'
                is_removable = bool(d.get("rm", False))
                is_usb = (d.get("tran") or "").lower() == "usb"
                is_live = dev_path == live_dev
                is_nvme = d["name"].startswith("nvme")
                is_virtio = d["name"].startswith("vd")
                # Priority: nvme=0, virtio=1, sata/sas=2, usb/removable=3, live_boot=4
                if is_live:
                    priority = 4
                elif is_usb or is_removable:
                    priority = 3
                elif is_nvme:
                    priority = 0
                elif is_virtio:
                    priority = 1
                else:
                    priority = 2
                warning = ""
                if is_live:
                    warning = "LIVE BOOT DEVICE — do not install here"
                elif is_usb or is_removable:
                    warning = "removable / USB"
                disks.append({
                    "name":       dev_path,
                    "size":       d.get("size", "?"),
                    "model":      (d.get("model") or "").strip(),
                    "removable":  is_removable,
                    "mountpoint": d.get("mountpoint"),
                    "rota":       d.get("rota", None),
                    "tran":       d.get("tran") or "",
                    "priority":   priority,
                    "warning":    warning,
                    "recommended": is_nvme or is_virtio,
                })
        # Sort: NVMe first, USB/live last
        disks.sort(key=lambda x: x["priority"])
        return disks
    except Exception as e:
        LOG.error("lsblk failed: %s", e)
        return []

def get_system_info():
    """Return basic system info dict."""
    info = {}
    try:
        info["hostname"] = open("/etc/hostname").read().strip()
    except Exception:
        info["hostname"] = "unknown"
    try:
        mem = subprocess.check_output(["free", "-h"], text=True).splitlines()[1].split()
        info["memory_total"] = mem[1]
        info["memory_free"]  = mem[3]
    except Exception:
        info["memory_total"] = "?"
        info["memory_free"]  = "?"
    try:
        info["cpus"] = subprocess.check_output(["nproc"], text=True).strip()
    except Exception:
        info["cpus"] = "?"
    try:
        uptime_s = subprocess.check_output(["uptime", "-p"], text=True).strip()
        info["uptime"] = uptime_s
    except Exception:
        pass
    try:
        with open("/etc/kldload/install-manifest.env") as f:
            for line in f:
                line = line.strip()
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    info[k.lower()] = v
    except Exception:
        pass
    # Detect NVIDIA GPU and VRAM
    try:
        lspci = subprocess.check_output(["lspci"], text=True, stderr=subprocess.DEVNULL)
        info["has_nvidia"] = "NVIDIA" in lspci.upper()
    except Exception:
        info["has_nvidia"] = False
    # Total RAM in GB (for AI model gating)
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    info["ram_gb"] = int(line.split()[1]) // (1024 * 1024)
                    break
    except Exception:
        info["ram_gb"] = 0
    # NVIDIA VRAM via nvidia-smi (if available)
    info["vram_gb"] = 0
    if info.get("has_nvidia"):
        try:
            nvsmi = subprocess.check_output(
                ["nvidia-smi", "--query-gpu=memory.total", "--format=csv,noheader,nounits"],
                text=True, stderr=subprocess.DEVNULL).strip()
            info["vram_gb"] = int(nvsmi.split("\n")[0]) // 1024
        except Exception:
            pass
    info["edition"] = EDITION
    # Firstboot progress status
    try:
        with open("/tmp/kldload-firstboot-status") as f:
            info["firstboot_status"] = f.read().strip()
    except Exception:
        info["firstboot_status"] = ""
    # AI status — check Ollama and Open WebUI
    info["ai_ollama"] = False
    info["ai_webui"] = False
    info["ai_model"] = ""
    try:
        import urllib.request
        r = urllib.request.urlopen("http://localhost:11434/api/tags", timeout=2)
        if r.status == 200:
            info["ai_ollama"] = True
            import json as _json
            data = _json.loads(r.read())
            names = [m["name"] for m in data.get("models", [])]
            info["ai_model"] = ", ".join(names) if names else "no models"
    except Exception:
        pass
    try:
        r2 = urllib.request.urlopen("http://localhost:8080", timeout=2)
        info["ai_webui"] = r2.status == 200
    except Exception:
        pass
    # Live mode: no KLDLOAD_INSTALLED=1 in manifest
    info["live_mode"] = True
    try:
        with open("/etc/kldload/install-manifest.env") as f:
            if "KLDLOAD_INSTALLED=1" in f.read():
                info["live_mode"] = False
    except Exception:
        pass
    # Grains: node_index, wg1_ip
    try:
        grains_path = "/etc/salt/grains"
        if os.path.exists(grains_path) and yaml is not None:
            with open(grains_path) as f:
                grains = yaml.safe_load(f) or {}
            info["node_index"] = grains.get("node_index", "")
            info["wg1_ip"]     = grains.get("wg1_ip", "")
    except Exception:
        pass
    # Quick WG up/down status for dashboard mini-table
    info["wg"] = {}
    for n, net in [(0, "10.77"), (1, "10.78"), (2, "10.79"), (3, "10.80")]:
        iface = f"wg{n}"
        entry = {"up": False, "ip": ""}
        try:
            out = subprocess.check_output(
                ["ip", "-o", "addr", "show", iface],
                text=True, stderr=subprocess.DEVNULL
            )
            m = re.search(r"inet (\S+)", out)
            if m:
                entry["ip"] = m.group(1).split("/")[0]
                entry["up"] = True
        except Exception:
            pass
        info["wg"][iface] = entry
    # klab availability (installed klab profile or klab binary present)
    info["klab_available"] = os.path.isfile("/usr/local/bin/klab")
    return info


def get_wg_status():
    """Return detailed WireGuard status for all four planes."""
    data = {}
    for n in range(4):
        iface = f"wg{n}"
        entry = {"up": False, "ip": "", "peers": 0, "peer_list": []}
        try:
            out = subprocess.check_output(
                ["ip", "-o", "addr", "show", iface],
                text=True, stderr=subprocess.DEVNULL
            )
            m = re.search(r"inet (\S+)", out)
            if m:
                entry["ip"]  = m.group(1).split("/")[0]
                entry["up"]  = True
        except Exception:
            pass
        try:
            wg_out = subprocess.check_output(
                ["wg", "show", iface, "dump"],
                text=True, stderr=subprocess.DEVNULL
            )
            peers = []
            for line in wg_out.strip().splitlines()[1:]:  # skip own pubkey line
                parts = line.split("\t")
                if len(parts) >= 5:
                    pub   = parts[0]
                    ep    = parts[2] if parts[2] != "(none)" else "—"
                    aips  = parts[3]
                    hs    = parts[4]
                    rx_tx = f"{parts[5]} / {parts[6]}" if len(parts) > 6 else "—"
                    peers.append({
                        "pubkey":       pub,
                        "pubkey_short": pub[:12] + "…",
                        "endpoint":     ep,
                        "allowed_ips":  aips,
                        "last_handshake": _fmt_handshake(hs),
                        "transfer":     rx_tx,
                    })
            entry["peers"]     = len(peers)
            entry["peer_list"] = peers
        except Exception:
            pass
        data[iface] = entry
    return data


def get_network_interfaces():
    """Return list of network interfaces with addresses."""
    ifaces = []
    try:
        out = subprocess.check_output(
            ["ip", "-o", "addr", "show"],
            text=True, stderr=subprocess.DEVNULL
        )
        seen = {}
        for line in out.splitlines():
            parts = line.split()
            if len(parts) < 4:
                continue
            name  = parts[1]
            family = parts[2]
            addr  = parts[3]
            if family not in ("inet", "inet6"):
                continue
            if name not in seen:
                seen[name] = {"name": name, "addresses": [], "state": "DOWN", "mtu": ""}
            seen[name]["addresses"].append(addr)
        # Get state and MTU
        link_out = subprocess.check_output(
            ["ip", "-o", "link", "show"],
            text=True, stderr=subprocess.DEVNULL
        )
        for line in link_out.splitlines():
            m_name = re.match(r"\d+:\s+(\S+):", line)
            if not m_name:
                continue
            name = m_name.group(1).rstrip("@eth0").split("@")[0]
            if name not in seen:
                seen[name] = {"name": name, "addresses": [], "state": "DOWN", "mtu": ""}
            seen[name]["state"] = "UP" if "UP" in line else "DOWN"
            m_mtu = re.search(r"mtu (\d+)", line)
            if m_mtu:
                seen[name]["mtu"] = m_mtu.group(1)
        ifaces = [v for k, v in sorted(seen.items()) if k != "lo"]
    except Exception as e:
        LOG.warning("network info failed: %s", e)
    return ifaces


def get_golden_status():
    """Return exists/size for each golden image template."""
    golden_dir = Path("/var/lib/kldload/golden")
    status = {}
    for tmpl in ("master", "kvm", "storage", "vdi"):
        path = golden_dir / f"golden-{tmpl}.qcow2"
        if path.exists():
            size_bytes = path.stat().st_size
            size_hr = _human_size(size_bytes)
            status[tmpl] = {"exists": True, "size": size_hr, "path": str(path)}
        else:
            status[tmpl] = {"exists": False}
    return status


def _fmt_handshake(ts_str):
    """Convert epoch timestamp to human-readable."""
    try:
        ts = int(ts_str)
        if ts == 0:
            return "never"
        delta = int(time.time()) - ts
        if delta < 120:
            return f"{delta}s ago"
        elif delta < 7200:
            return f"{delta // 60}m ago"
        else:
            return f"{delta // 3600}h ago"
    except Exception:
        return ts_str


def _human_size(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024:
            return f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} PB"

def _load_credentials():
    try:
        return json.loads(CREDENTIALS_PATH.read_text())
    except Exception:
        return {"proxmox": [], "aws": {}, "azure": {}, "gcp": {}, "ssh": []}

def _save_credentials(creds):
    CREDENTIALS_PATH.parent.mkdir(parents=True, exist_ok=True)
    CREDENTIALS_PATH.write_text(json.dumps(creds, indent=2))
    os.chmod(CREDENTIALS_PATH, 0o600)

# ── WebSocket handler ──────────────────────────────────────────────────────────

RUNNING_PROCS = {}

PRO_ONLY_ACTIONS = {
    "spawn", "golden", "cluster_deploy", "wg_peer_add", "wg_peer_remove",
    "wg_info", "node_list", "node_register", "node_poof", "apply_role",
    "salt_highstate", "salt_apply", "ansible_run", "k8s_join",
    "vm_list", "vm_start", "vm_stop", "vm_destroy", "vm_clone",
    "service_action", "credential_list", "credential_add",
    "proxmox_list", "firewall_rule", "cluster_info",
}

async def _pro_required(websocket, action: str) -> bool:
    """Return True (and send error) if this is a free edition trying a pro action."""
    if EDITION == "free" and action in PRO_ONLY_ACTIONS:
        await websocket.send(json.dumps({
            "type": "error",
            "msg": f"'{action}' requires kldload Pro. Upgrade at kldload.ca/upgrade.",
            "pro_required": True,
        }))
        return True
    return False

async def ws_handler(websocket):
    LOG.info("WebSocket client connected: %s", websocket.remote_address)
    try:
        async for raw in websocket:
            try:
                msg = json.loads(raw)
            except json.JSONDecodeError:
                await websocket.send(json.dumps({"type": "error", "msg": "invalid JSON"}))
                continue

            action = msg.get("action", "")
            LOG.info("WS action: %s", action)
            try:
                if await _pro_required(websocket, action):
                    continue
                if action == "ping":
                    await websocket.send(json.dumps({"type": "pong"}))
                elif action == "system_info":
                    await websocket.send(json.dumps({
                        "type": "system_info",
                        "data": get_system_info(),
                    }))
                elif action == "list_disks":
                    await websocket.send(json.dumps({
                        "type": "disk_list",
                        "disks": get_disks(),
                    }))
                elif action == "install":
                    await _run_install(websocket, msg)
                elif action == "test_rhel_cdn":
                    await _test_rhel_cdn(websocket, msg)
                elif action == "wipe_disk":
                    await _run_wipe_disk(websocket, msg)
                elif action == "spawn":
                    await _run_spawn(websocket, msg)
                elif action == "golden":
                    await _run_golden(websocket, msg)
                elif action == "tail_log":
                    log_name = msg.get("log", "installer")
                    log_path = LOG_FILES.get(log_name, LOG_FILES["installer"])
                    await _tail_log(websocket, log_path)
                elif action == "list_vms":
                    await _list_vms(websocket)
                elif action == "vm_op":
                    await _vm_op(websocket, msg)
                elif action == "zfs_list":
                    await _zfs_list(websocket)
                elif action == "k8s_nodes":
                    await _k8s_nodes(websocket)
                elif action == "salt_status":
                    await _salt_status(websocket)
                elif action == "wg_status":
                    await websocket.send(json.dumps({
                        "type": "wg_data",
                        "data": get_wg_status(),
                    }))
                elif action == "wg_gen_keypair":
                    await _wg_gen_keypair(websocket)
                elif action == "wg_add_peer":
                    await _wg_add_peer(websocket, msg)
                elif action == "wg_remove_peer":
                    await _wg_remove_peer(websocket, msg)
                elif action == "golden_status":
                    await websocket.send(json.dumps({
                        "type": "golden_status",
                        "status": get_golden_status(),
                    }))
                elif action == "stamp":
                    await _run_stamp(websocket, msg)
                elif action == "k8s_join":
                    await _run_k8s_join(websocket, msg)
                elif action == "salt_highstate":
                    await _run_salt_highstate(websocket, msg)
                elif action == "salt_accept_all":
                    await _salt_accept_all(websocket)
                elif action == "node_list":
                    await _node_list(websocket)
                elif action == "node_apply":
                    await _node_apply(websocket, msg)
                elif action == "mine_refresh":
                    await _mine_refresh(websocket, msg)
                elif action == "node_accept_key":
                    await _node_accept_key(websocket, msg)
                elif action == "poof":
                    await _run_poof(websocket, msg)
                elif action == "cluster_deploy":
                    await _run_cluster_deploy(websocket, msg)
                elif action == "run_audit":
                    await _run_audit(websocket)
                elif action == "credentials_load":
                    creds = _load_credentials()
                    # Mask secrets before sending to browser
                    masked = json.loads(json.dumps(creds))
                    for p in masked.get("proxmox", []):
                        if p.get("token_secret"):
                            p["token_secret"] = "••••••••"
                    if masked.get("aws", {}).get("secret"):
                        masked["aws"]["secret"] = "••••••••"
                    if masked.get("azure", {}).get("client_secret"):
                        masked["azure"]["client_secret"] = "••••••••"
                    await websocket.send(json.dumps({"type": "credentials_data", "creds": masked}))
                elif action == "credentials_save":
                    # Merge: if secret field is masked placeholder, keep existing value
                    existing = _load_credentials()
                    incoming = msg.get("creds", {})
                    # Proxmox: match by id, preserve secret if masked
                    for i, p in enumerate(incoming.get("proxmox", [])):
                        if p.get("token_secret") == "••••••••":
                            for ep in existing.get("proxmox", []):
                                if ep.get("id") == p.get("id"):
                                    p["token_secret"] = ep.get("token_secret", "")
                    # AWS
                    if incoming.get("aws", {}).get("secret") == "••••••••":
                        incoming["aws"]["secret"] = existing.get("aws", {}).get("secret", "")
                    # Azure
                    if incoming.get("azure", {}).get("client_secret") == "••••••••":
                        incoming["azure"]["client_secret"] = existing.get("azure", {}).get("client_secret", "")
                    _save_credentials(incoming)
                    await websocket.send(json.dumps({"type": "credentials_saved"}))
                elif action == "credentials_test":
                    provider = msg.get("provider", "")
                    creds = _load_credentials()
                    ok, err = False, "unknown provider"
                    if provider == "proxmox":
                        pid = msg.get("id", "")
                        for p in creds.get("proxmox", []):
                            if p.get("id") == pid:
                                try:
                                    import urllib.request, urllib.error
                                    url = f"https://{p['host']}:{p.get('port',8006)}/api2/json/version"
                                    req = urllib.request.Request(url,
                                        headers={"Authorization": f"PVEAPIToken={p['token_id']}={p['token_secret']}"},
                                    )
                                    import ssl as _ssl
                                    ctx = _ssl.create_default_context()
                                    ctx.check_hostname = False
                                    ctx.verify_mode = _ssl.CERT_NONE
                                    urllib.request.urlopen(req, context=ctx, timeout=5)
                                    ok, err = True, ""
                                except Exception as e:
                                    ok, err = False, str(e)
                    await websocket.send(json.dumps({"type": "credentials_test_result",
                                                      "provider": provider, "ok": ok, "err": err}))
                elif action == "wg_planes_list":
                    await _wg_planes_list(websocket)
                elif action == "wg_plane_create":
                    await _wg_plane_create(websocket, msg)
                elif action == "wg_plane_delete":
                    await _wg_plane_delete(websocket, msg)
                elif action == "db_list":
                    type_ = msg.get("db_type") or None
                    items = db_list_templates(type_)
                    await websocket.send(json.dumps({
                        "type": "db_list", "db_type": type_, "items": items,
                    }))
                elif action == "db_save":
                    id_ = db_save_template(
                        msg.get("db_type", "generic"),
                        msg.get("name", "Untitled"),
                        msg.get("description", ""),
                        msg.get("data", {}),
                    )
                    db_log_event("save", id_,
                        f"Saved {msg.get('db_type','?')} template: {msg.get('name','?')}")
                    await websocket.send(json.dumps({
                        "type": "db_saved", "id": id_,
                        "name": msg.get("name"), "db_type": msg.get("db_type"),
                    }))
                elif action == "db_load":
                    tpl = db_load_template(msg.get("id", ""))
                    if tpl:
                        await websocket.send(json.dumps({"type": "db_loaded", "template": tpl}))
                    else:
                        await websocket.send(json.dumps({"type": "error", "msg": "template not found"}))
                elif action == "db_delete":
                    db_delete_template(msg.get("id", ""))
                    db_log_event("delete", msg.get("id", ""), "Template deleted")
                    await websocket.send(json.dumps({"type": "db_deleted", "id": msg.get("id")}))
                elif action == "db_node_register":
                    id_ = db_register_node(
                        msg.get("hostname", "unknown"),
                        role=msg.get("role", "unknown"),
                        ip_mgmt=msg.get("ip_mgmt", ""),
                        ip_wg0=msg.get("ip_wg0", ""),
                        ip_wg1=msg.get("ip_wg1", ""),
                        ip_wg2=msg.get("ip_wg2", ""),
                        ip_wg3=msg.get("ip_wg3", ""),
                        wg_pubkey=msg.get("wg_pubkey", ""),
                        cluster_id=msg.get("cluster_id", ""),
                        facts=msg.get("facts", {}),
                    )
                    db_log_event("node_join", id_, f"Node registered: {msg.get('hostname')}")
                    await websocket.send(json.dumps({"type": "db_node_registered", "id": id_}))
                elif action == "db_nodes":
                    nodes = db_list_nodes()
                    await websocket.send(json.dumps({"type": "db_nodes", "nodes": nodes}))
                elif action == "db_events":
                    events = db_list_events(msg.get("limit", 100))
                    await websocket.send(json.dumps({"type": "db_events", "events": events}))
                elif action == "service_list":
                    svcs = db_list_services(msg.get("cluster_id") or None)
                    await websocket.send(json.dumps({"type": "service_list", "services": svcs}))
                elif action == "service_save":
                    id_ = db_save_service(
                        msg.get("name", "unnamed"),
                        description  = msg.get("description", ""),
                        cluster_id   = msg.get("cluster_id", ""),
                        node_targets = msg.get("node_targets", []),
                        dataset      = msg.get("dataset", ""),
                        image        = msg.get("image", ""),
                        runtime      = msg.get("runtime", "systemd"),
                        replicas     = msg.get("replicas", 1),
                        repl_targets = msg.get("repl_targets", []),
                        config       = msg.get("config", {}),
                        salt_state   = msg.get("salt_state", ""),
                    )
                    db_log_event("service_save", id_, f"Service saved: {msg.get('name')}")
                    await websocket.send(json.dumps({"type": "service_saved", "id": id_}))
                elif action == "service_load":
                    svc = db_load_service(msg.get("id", ""))
                    if svc:
                        await websocket.send(json.dumps({"type": "service_data", "service": svc}))
                    else:
                        await websocket.send(json.dumps({"type": "error", "msg": "service not found"}))
                elif action == "service_delete":
                    db_delete_service(msg.get("id", ""))
                    db_log_event("service_delete", msg.get("id",""), "Service deleted")
                    await websocket.send(json.dumps({"type": "service_deleted", "id": msg.get("id")}))
                elif action == "service_deploy":
                    await _service_deploy(websocket, msg)
                elif action == "db_export":
                    export = db_export_all()
                    await websocket.send(json.dumps({"type": "db_export", "data": export}))
                elif action == "db_import":
                    counts = db_import_all(msg.get("data", {}), merge=msg.get("merge", True))
                    db_log_event("db_import", "system", f"DB import: {counts}")
                    await websocket.send(json.dumps({"type": "db_imported", "counts": counts}))
                elif action == "ui_mode":
                    live = is_live_mode()
                    nenv = get_node_env()
                    role = nenv.get("KLDLOAD_NODE_ROLE", "live" if live else "node")
                    ui_title = nenv.get("KLDLOAD_UI_TITLE", "kldload")
                    hostname = nenv.get("KLDLOAD_NODE_HOSTNAME", "")
                    await websocket.send(json.dumps({
                        "type": "ui_mode",
                        "live": live,
                        "role": role,
                        "ui_title": ui_title,
                        "hostname": hostname,
                        "db_path": str(DB_PATH),
                        "db_exists": DB_PATH.exists(),
                        "db_size_kb": round(DB_PATH.stat().st_size / 1024, 1) if DB_PATH.exists() else 0,
                    }))
                elif action == "infra_status":
                    clusters = db_list_clusters()
                    nodes    = db_list_nodes()
                    vms      = db_list_vms()
                    events   = db_list_events(50)
                    # Augment nodes with live virsh VM count per host
                    vm_counts = {}
