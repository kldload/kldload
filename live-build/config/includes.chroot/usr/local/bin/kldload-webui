                elif action == "secret_list":
                    await websocket.send(json.dumps({
                        "type": "secret_list",
                        "backend": secrets_backend(),  # "zfs" or "plain"
                        "secrets": secret_list(),
                    }))
                elif action == "secret_set":
                    name  = (msg.get("name") or "").strip()
