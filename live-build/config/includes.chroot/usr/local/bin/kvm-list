#!/usr/bin/env bash
# kvm-list — show all VMs with ZFS zvol status
set -euo pipefail

# Auto-elevate to root (ZFS + libvirt require it)
# --help answers before the root re-exec below: asking a tool what it does
# must never need a password, and on a machine where the operator has no
# sudo rights it could not answer at all (swept 2026-09-16).
case "${1:-}" in
-h | --help)
    cat <<'USAGE'
Usage: kvm-list

List every libvirt VM on this host with the state, memory and vCPU count
libvirt reports, and the space its ZFS zvol actually uses.

Takes no options. Needs root, because it reads both libvirt and ZFS.

The ZVOL USED column looks up rpool/vms/<vm-name>. A VM whose disk is not a
zvol under that path shows n/a -- it exists, it is just not backed the way
kvm-create makes them.

See also: kvm-create, kvm-clone, kvm-snap, kvm-delete.
USAGE
    exit 0
    ;;
esac

if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

printf "%-20s %-12s %-10s %-10s %-10s\n" "NAME" "STATE" "RAM" "VCPUS" "ZVOL USED"
printf "%-20s %-12s %-10s %-10s %-10s\n" "----" "-----" "---" "-----" "---------"

for vm in $(virsh list --all --name 2>/dev/null | grep -v '^$'); do
    state=$(virsh domstate "$vm" 2>/dev/null || echo "unknown")
    ram=$(virsh dominfo "$vm" 2>/dev/null | awk '/Max memory/{printf "%.0fMB", $3/1024}')
    vcpus=$(virsh dominfo "$vm" 2>/dev/null | awk '/CPU\(s\)/{print $2}')
    zvol="rpool/vms/${vm}"
    used=$(zfs list -H -o used "$zvol" 2>/dev/null || echo "n/a")
    printf "%-20s %-12s %-10s %-10s %-10s\n" "$vm" "$state" "$ram" "$vcpus" "$used"
done

echo ""
echo "ZFS pool space:"
zfs list -o name,used,avail -r rpool/vms 2>/dev/null | head -1
zfs list -o name,used,avail rpool/vms 2>/dev/null | tail -1
