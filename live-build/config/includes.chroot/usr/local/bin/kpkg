#!/usr/bin/env bash
set -Eeuo pipefail
trap 'echo "kpkg: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

# kpkg — universal package manager wrapper
# Auto-detects apt/dnf/pacman and runs the right command.
# Takes a ZFS snapshot before install/upgrade/remove operations.

cmd="${1:-help}"
shift 2>/dev/null || true

_snap() {
    # When the package manager on PATH is kldload-pkg-wrapper it takes the
    # pre-transaction snapshot itself (@dnf-pre-/@apt-pre-); a second one here
    # was pure noise — fiend 2026-09-15 carried a @kpkg-/@dnf-pre- pair, 96K
    # apart, for every transaction.
    if [[ "$(readlink -f "$(command -v "$PKG" 2>/dev/null)" 2>/dev/null)" == *kldload-pkg-wrapper ]]; then
        return 0
    fi
    if command -v zfs &>/dev/null && zpool list &>/dev/null 2>&1; then
        local ds
        ds=$(mount | awk '$3=="/" && /zfs/{print $1}')
        # sudo, and said when it fails: it ran as the caller and threw the
        # error away, so a user's every "snapshot first" was no snapshot at
        # all, before a transaction that then ran with sudo (2026-09-30)
        if [[ -n "$ds" ]] && ! sudo zfs snapshot "${ds}@kpkg-$(date +%Y%m%d-%H%M%S)"; then
            echo "kpkg: WARNING: no snapshot of ${ds} was taken; the transaction goes ahead without one" >&2
        fi
        # the last ten; every one ever taken was kept (source audit 2026-09-26)
        if [[ -n "$ds" && -x /usr/local/sbin/snapshot-prune.sh ]]; then
            /usr/local/sbin/snapshot-prune.sh "$ds" kpkg- 10 >/dev/null 2>&1 ||
                echo "kpkg: could not prune ${ds}@kpkg- snapshots" >&2
        fi
    fi
}

if command -v pacman &>/dev/null; then
    PKG=pacman
elif command -v dnf &>/dev/null; then
    PKG=dnf
elif command -v apt-get &>/dev/null; then
    PKG=apt-get
else
    echo "No package manager found" >&2
    exit 1
fi

case "$cmd" in
install)
    _snap
    case "$PKG" in
    pacman) sudo pacman -S --noconfirm "$@" ;;
    dnf) sudo dnf install -y "$@" ;;
    apt-get) sudo apt-get install -y "$@" ;;
    esac
    ;;
remove)
    _snap
    case "$PKG" in
    pacman) sudo pacman -R --noconfirm "$@" ;;
    dnf) sudo dnf remove -y "$@" ;;
    apt-get) sudo apt-get remove -y "$@" ;;
    esac
    ;;
update)
    case "$PKG" in
    pacman) sudo pacman -Sy ;;
    dnf) sudo dnf check-update "$@" || true ;;
    apt-get) sudo apt-get update "$@" ;;
    esac
    ;;
upgrade)
    _snap
    case "$PKG" in
    pacman) sudo pacman -Syu --noconfirm "$@" ;;
    dnf) sudo dnf upgrade -y "$@" ;;
    apt-get) sudo apt-get dist-upgrade -y "$@" ;;
    esac
    ;;
search)
    case "$PKG" in
    pacman) pacman -Ss "$@" ;;
    dnf) dnf search "$@" ;;
    apt-get) apt-cache search "$@" ;;
    esac
    ;;
list)
    case "$PKG" in
    pacman) pacman -Q "$@" ;;
    dnf) rpm -qa "$@" | sort ;;
    apt-get) dpkg -l "$@" ;;
    esac
    ;;
info)
    case "$PKG" in
    pacman) pacman -Qi "$@" 2>/dev/null || pacman -Si "$@" ;;
    dnf) dnf info "$@" ;;
    apt-get) apt-cache show "$@" ;;
    esac
    ;;
help | -h | --help | *)
    # help asked for is stdout and 0; an unknown verb is stderr and 2 (it
    # printed the help and exited 0, so a typo read as success)
    _rc=0
    case "$cmd" in help | -h | --help) ;; *)
        _rc=2
        exec >&2
        echo "kpkg: unknown command: $cmd"
        ;;
    esac
    echo "kpkg — universal package manager (auto-detects apt/dnf/pacman)"
    echo ""
    echo "  kpkg install <pkg>    Install a package (ZFS snapshot first)"
    echo "  kpkg remove <pkg>     Remove a package (ZFS snapshot first)"
    echo "  kpkg update           Refresh package index"
    echo "  kpkg upgrade          Upgrade all packages (ZFS snapshot first)"
    echo "  kpkg search <term>    Search for packages"
    echo "  kpkg list             List installed packages"
    echo "  kpkg info <pkg>       Show package details"
    echo ""
    echo "  Using: $PKG"
    echo ""
    echo "  Exit: the package manager's own status; 2 for an unknown command. See kpkg(8)."
    exit "$_rc"
    ;;
esac
