#!/usr/bin/env bash
# kldload-dashboard — open the kldload web console (KVM / K8s / ZFS / Metrics
# / Bob tabs) as a chromeless desktop app window.
set -eo pipefail
URL="https://localhost:8443/"
for b in google-chrome google-chrome-stable chromium chromium-browser brave-browser; do
    command -v "$b" >/dev/null 2>&1 && exec "$b" --app="$URL" --class=kldload-dashboard \
        --user-data-dir="${HOME}/.config/kldload-dashboard" --ignore-certificate-errors \
        --window-size=1280,860 >/dev/null 2>&1
done
command -v firefox >/dev/null 2>&1 && exec firefox --new-window "$URL"
exec xdg-open "$URL"
