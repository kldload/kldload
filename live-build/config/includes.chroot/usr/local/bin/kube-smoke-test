#!/usr/bin/env bash
# kube-smoke-test — comprehensive audit and smoke test for kldload Kubernetes
# Tests every layer: packages, containerd, kernel, ZFS, WireGuard, kubeadm, Cilium
# Run on a node after kube-setup to verify readiness, or after kube-init to verify cluster
set -euo pipefail

if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

C="\033[1;36m"; G="\033[1;32m"; Y="\033[1;33m"; R="\033[1;31m"
W="\033[1;37m"; D="\033[0;37m"; N="\033[0m"

PASS=0; FAIL=0; WARN=0

pass() { echo -e "  ${G}PASS${N}  $*"; ((++PASS)); }
fail() { echo -e "  ${R}FAIL${N}  $*"; ((++FAIL)); }
warn() { echo -e "  ${Y}WARN${N}  $*"; ((++WARN)); }
skip() { echo -e "  ${D}SKIP${N}  $*"; }

section() { echo ""; echo -e "${C}=== $* ===${N}"; }

echo -e "${C}══════════════════════════════════════════════════════════════${N}"
echo -e "${W}  kldload Kubernetes Smoke Test                              ${N}"
echo -e "${C}══════════════════════════════════════════════════════════════${N}"

# ── 1. Package Manager ────────────────────────────────────────────────────
section "Package Manager"
if command -v dnf >/dev/null 2>&1; then
  pass "dnf available"
elif command -v apt-get >/dev/null 2>&1; then
  pass "apt available"
else
  fail "No package manager (dnf or apt)"
fi

# ── 2. Kernel Modules ────────────────────────────────────────────────────
section "Kernel Modules"
for mod in overlay br_netfilter ip_vs ip_vs_rr ip_vs_wrr ip_vs_sh nf_conntrack; do
  if lsmod | grep -qw "$mod" 2>/dev/null || [[ -d "/sys/module/$mod" ]]; then
    pass "$mod loaded"
  else
    modprobe "$mod" 2>/dev/null && pass "$mod loaded (on demand)" || fail "$mod not loadable"
  fi
done

# ── 3. Sysctl ──────────────────────────────────────────────────────────────
section "Sysctl"
[[ "$(sysctl -n net.ipv4.ip_forward 2>/dev/null)" == "1" ]] && pass "ip_forward = 1" || fail "ip_forward not enabled"
[[ "$(sysctl -n net.bridge.bridge-nf-call-iptables 2>/dev/null)" == "1" ]] && pass "bridge-nf-call-iptables = 1" || warn "bridge-nf-call-iptables not set (ok if using Cilium eBPF)"

# ── 4. Swap ────────────────────────────────────────────────────────────────
section "Swap"
if [[ "$(cat /proc/swaps 2>/dev/null | tail -n +2 | wc -l)" == "0" ]]; then
  pass "Swap disabled"
else
  fail "Swap is active (kubeadm requires swap off)"
fi

# ── 5. Containerd ──────────────────────────────────────────────────────────
section "Containerd"
if command -v containerd >/dev/null 2>&1; then
  pass "containerd binary: $(containerd --version 2>/dev/null | awk '{print $3}')"
else
  fail "containerd not installed"
fi

if systemctl is-active containerd >/dev/null 2>&1; then
  pass "containerd running"
else
  fail "containerd not running"
fi

if [[ -S /run/containerd/containerd.sock ]]; then
  pass "containerd socket exists"
else
  fail "containerd socket missing"
fi

if grep -q 'SystemdCgroup = true' /etc/containerd/config.toml 2>/dev/null; then
  pass "containerd SystemdCgroup = true"
else
  fail "containerd SystemdCgroup not enabled"
fi

if [[ -f /etc/crictl.yaml ]]; then
  pass "crictl.yaml configured"
else
  warn "crictl.yaml missing"
fi

# ── 6. Kubernetes Binaries ────────────────────────────────────────────────
section "Kubernetes Binaries"
for bin in kubeadm kubelet kubectl; do
  if command -v "$bin" >/dev/null 2>&1; then
    ver="$($bin version --client -o yaml 2>/dev/null | grep gitVersion | awk '{print $2}' || $bin version -o short 2>/dev/null || echo "unknown")"
    pass "$bin installed ($ver)"
  else
    fail "$bin not found"
  fi
done

if command -v helm >/dev/null 2>&1; then
  pass "helm installed ($(helm version --short 2>/dev/null))"
else
  warn "helm not installed"
fi

if command -v cilium >/dev/null 2>&1; then
  pass "cilium CLI installed"
else
  warn "cilium CLI not installed"
fi

# ── 7. CNI ─────────────────────────────────────────────────────────────────
section "CNI"
if [[ -d /opt/cni/bin ]] && [[ -n "$(ls -A /opt/cni/bin 2>/dev/null)" ]]; then
  pass "CNI plugins in /opt/cni/bin ($(ls /opt/cni/bin | wc -l) plugins)"
else
  warn "CNI plugins not in /opt/cni/bin"
fi

# ── 8. ZFS ─────────────────────────────────────────────────────────────────
section "ZFS"
if command -v zfs >/dev/null 2>&1; then
  pass "ZFS available ($(zfs version 2>/dev/null | head -1))"

  for ds in etcd containerd kubelet; do
    if zfs list -o name 2>/dev/null | grep -q "var/lib/${ds}"; then
      rs="$(zfs get -H -o value recordsize "$(zfs list -H -o name 2>/dev/null | grep "var/lib/${ds}" | head -1)" 2>/dev/null)"
      pass "ZFS dataset for $ds (recordsize=$rs)"
    else
      warn "No dedicated ZFS dataset for /var/lib/$ds"
    fi
  done
else
  skip "ZFS not available"
fi

# ── 9. WireGuard ───────────────────────────────────────────────────────────
section "WireGuard"
if command -v wg >/dev/null 2>&1; then
  pass "WireGuard tools installed"
else
  warn "WireGuard tools not installed"
fi

if ip link show wg-k8s >/dev/null 2>&1; then
  k8s_ip="$(ip -4 addr show wg-k8s 2>/dev/null | awk '/inet / {print $2}')"
  pass "wg-k8s interface up ($k8s_ip)"
elif ip link show wg0 >/dev/null 2>&1; then
  pass "wg0 interface up (legacy single-plane)"
else
  warn "No WireGuard interfaces (K8s will use LAN — unencrypted)"
fi

if ip link show wg-mgmt >/dev/null 2>&1; then
  mgmt_ip="$(ip -4 addr show wg-mgmt 2>/dev/null | awk '/inet / {print $2}')"
  pass "wg-mgmt interface up ($mgmt_ip)"
else
  skip "wg-mgmt not configured"
fi

# ── 10. Kubelet node-ip ───────────────────────────────────────────────────
section "Kubelet Node IP"
if [[ -f /etc/default/kubelet ]]; then
  node_ip="$(grep 'node-ip' /etc/default/kubelet 2>/dev/null | sed 's/.*node-ip=//')"
  if [[ -n "$node_ip" ]]; then
    pass "kubelet pinned to $node_ip"
    # Check if it's a WG address
    if [[ "$node_ip" == 10.251.* || "$node_ip" == 10.250.* ]]; then
      pass "kubelet on WireGuard plane"
    else
      warn "kubelet on LAN IP (not encrypted backplane)"
    fi
  else
    warn "kubelet node-ip not set"
  fi
else
  warn "/etc/default/kubelet not found"
fi

# ── 11. Firewall ───────────────────────────────────────────────────────────
section "Firewall"
_nft_rules="$(nft list ruleset 2>/dev/null || true)"
if echo "$_nft_rules" | grep -q 'chain input'; then
  pass "nftables rules loaded"
  if echo "$_nft_rules" | grep -q 'wg-k8s\|wg-mgmt'; then
    pass "nftables has WireGuard rules"
  else
    warn "nftables missing WireGuard-specific rules"
  fi
  if echo "$_nft_rules" | grep -q '6443'; then
    pass "K8s API port 6443 allowed"
  else
    warn "K8s API port 6443 not in firewall"
  fi
else
  warn "No nftables rules loaded"
fi

# ── 12. Pre-pulled Images ────────────────────────────────────────────────
section "Offline Images"
if [[ -d /root/darksite/k8s-images ]] && [[ -n "$(ls -A /root/darksite/k8s-images/*.tar 2>/dev/null)" ]]; then
  count="$(ls /root/darksite/k8s-images/*.tar 2>/dev/null | wc -l)"
  size="$(du -sh /root/darksite/k8s-images 2>/dev/null | cut -f1)"
  pass "Pre-pulled images: $count tarballs ($size)"
else
  warn "No pre-pulled images (will need internet for kube-init)"
fi

# ── 13. Cluster Status (if running) ──────────────────────────────────────
section "Cluster (if running)"
if [[ -f /etc/kubernetes/admin.conf ]]; then
  pass "admin.conf exists"

  if kubectl cluster-info >/dev/null 2>&1; then
    pass "API server reachable"

    nodes="$(kubectl get nodes --no-headers 2>/dev/null | wc -l)"
    ready="$(kubectl get nodes --no-headers 2>/dev/null | grep -c ' Ready')"
    pass "Nodes: $ready/$nodes ready"

    # Cilium
    if kubectl get ds -n kube-system cilium >/dev/null 2>&1; then
      cilium_ready="$(kubectl get pods -n kube-system -l k8s-app=cilium --no-headers 2>/dev/null | grep -c Running)"
      pass "Cilium: $cilium_ready pods running"
    else
      fail "Cilium not deployed"
    fi

    # CoreDNS
    coredns_ready="$(kubectl get pods -n kube-system -l k8s-app=kube-dns --no-headers 2>/dev/null | grep -c Running)"
    [[ "$coredns_ready" -gt 0 ]] && pass "CoreDNS: $coredns_ready pods running" || fail "CoreDNS not running"

    # Hubble
    if kubectl get svc -n kube-system hubble-relay >/dev/null 2>&1; then
      pass "Hubble relay deployed"
    else
      warn "Hubble relay not found"
    fi

    # Pod test — create and delete a test pod
    echo ""
    echo -e "  ${D}Running pod test...${N}"
    if kubectl run smoke-test --image=busybox --restart=Never --command -- sleep 5 >/dev/null 2>&1; then
      sleep 3
      pod_status="$(kubectl get pod smoke-test --no-headers 2>/dev/null | awk '{print $3}')"
      if [[ "$pod_status" == "Running" || "$pod_status" == "Completed" ]]; then
        pass "Pod scheduling works (test pod: $pod_status)"
      else
        fail "Test pod status: $pod_status"
      fi
      kubectl delete pod smoke-test --grace-period=0 --force >/dev/null 2>&1 || true
    else
      fail "Could not create test pod"
    fi

    # DNS test
    echo -e "  ${D}Running DNS test...${N}"
    dns_result="$(kubectl run dns-test --image=busybox --restart=Never --rm -i --command -- nslookup kubernetes.default.svc.cluster.local 2>/dev/null | grep -c 'Address' || echo 0)"
    if [[ "$dns_result" -gt 0 ]]; then
      pass "Cluster DNS resolves kubernetes.default"
    else
      warn "DNS test inconclusive (may need more time)"
    fi
    kubectl delete pod dns-test --grace-period=0 --force >/dev/null 2>&1 || true

  else
    fail "API server not reachable"
  fi
else
  skip "No cluster running (admin.conf not found)"
fi

# ── Summary ────────────────────────────────────────────────────────────────
echo ""
echo -e "${C}══════════════════════════════════════════════════════════════${N}"
echo -e "${W}  Smoke Test Results                                         ${N}"
echo -e "${C}──────────────────────────────────────────────────────────────${N}"
echo -e "  ${G}PASS: $PASS${N}"
echo -e "  ${R}FAIL: $FAIL${N}"
echo -e "  ${Y}WARN: $WARN${N}"
echo ""

if [[ $FAIL -eq 0 ]]; then
  echo -e "  ${G}All critical checks passed.${N}"
  if [[ $WARN -gt 0 ]]; then
    echo -e "  ${Y}$WARN warnings — review above for optional improvements.${N}"
  fi
else
  echo -e "  ${R}$FAIL critical failures — fix before proceeding.${N}"
fi
echo -e "${C}══════════════════════════════════════════════════════════════${N}"

exit $FAIL
