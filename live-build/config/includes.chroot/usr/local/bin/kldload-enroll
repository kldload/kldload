#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# kldload-enroll — put ANY VM on the WireGuard mesh and in the inventory.
#
# What it does, in order:
#   1. Resolves the VM's address (libvirt lease, or --ip).
#   2. Allocates a mesh node id that cannot collide with the k8s bands.
#   3. Runs `kube-network init <id>` inside the guest.
#   4. Peers host <-> guest on BOTH planes, in both directions.
#   5. Registers the VM in the state DB with a role and cluster.
#   6. Kicks kldload-networks so the Ansible inventory sees it immediately.
#
# WHY THIS EXISTS: enrollment used to be a privilege of kube-cluster. It
# carried eighteen `kube-network add-peer` calls and was the only path that
# put a guest on the mesh. Every other way of making a VM — kspawn for cloud
# nodes, kvm-create for a custom post-install, kvm-clone for a golden copy —
# registered a row in the state DB and stopped there. Measured on .107
# 2026-08-22: kube-cluster 18 wg calls, kspawn 0, kvm-create 0, kvm-clone 0.
#
# The result was a two-tier estate. A k8s node was reachable over 10.250.0.0/24,
# scraped by Prometheus, and addressable by Ansible. A cloud VM sitting beside
# it on the same hypervisor was reachable only over libvirt NAT, invisible to
# the host's mesh, and had no encrypted path at all. Nothing about that
# difference was intentional — it is just where the code happened to be.
#
# So the mechanism moves here, once, and every creation path calls it. Adding
# a fifth kind of VM later means one call, not another eighteen.
#
# Inputs:  $1 — libvirt domain name, or --all to sweep every running VM
#          --ip A.B.C.D    skip lease lookup (the VM is not in libvirt's DHCP)
#          --role NAME     inventory role; default "vm"
#          --cluster NAME  inventory cluster; default "" (unclustered)
#          --id N          force a mesh node id instead of allocating one
#          --no-wg         register in the DB only, skip the mesh
# Outputs: log lines on stdout. The guest gains 10.250.0.<id>/10.251.0.<id>,
#          the host gains a peer, the state DB gains a row.
# Exit:    0 enrolled (or already enrolled), 1 could not resolve the VM,
#          2 mesh enrollment failed but the DB row was still written.
#
# Notes:
#   - IDEMPOTENT. A guest that already has /etc/wireguard/.node-id keeps its
#     id and is only re-peered where a peer is missing. Re-running is how you
#     repair, not how you break things.
#   - NON-FATAL BY DESIGN for the caller. Creating a VM must not fail because
#     the mesh was busy; callers invoke this with `|| true` and the operator
#     gets a warning plus a working VM rather than a rollback.
#   - The id band matters. kube-cluster uses 1 for the first control plane,
#     2..N for bootstrap workers, 100+index for scale-out workers, and 100 for
#     the hypervisor itself. General VMs therefore start at 150, which leaves
#     the k8s bands alone and keeps `wg show` readable: anything >=150 was not
#     built by kube-cluster.
# ---------------------------------------------------------------------------
set -Eeuo pipefail
trap 'echo "FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

VM_ID_BASE=150 # first id handed to a non-k8s VM; see Notes
MGMT_SUBNET="${MGMT_SUBNET:-10.250.0}"
HOST_ID=100

log() { printf '[%(%F %T)T] [enroll] %s\n' -1 "$*"; }
warn() { log "WARNING: $*" >&2; }
die() {
    log "FATAL: $*" >&2
    exit 1
}

usage() {
    sed -n '2,/^# ---/p' "$0" | sed 's/^# \{0,1\}//'
    # asked-for help is 0; a usage error stays 1
    exit "${1:-1}"
}

# ── Sweep mode ──────────────────────────────────────────────────────────────
# `kldload-enroll --all` enrols every running VM that has an address and is not
# already a peer.
#
# WHY A SWEEP AND NOT JUST A CALL PER TOOL: a VM cannot be enrolled at creation
# time, because at that moment it has no address — kvm-create registers its VM
# with status "defined", before the thing has ever booted. Wiring enrollment
# into each creation path therefore only ever covers the paths that happen to
# create a RUNNING guest, and misses create-then-start-later entirely, which is
# the normal way people use kvm-create.
#
# A sweep is indifferent to which tool made the VM, so it covers kvm-create,
# kvm-clone, kspawn and anything added later without touching them. Run it from
# cron, from a timer, or by hand after starting a batch.
# _is_template <vm> — 0 when the VM is a golden, sealed or still being built.
#
# A golden must never be enrolled. Enrolling gives the guest a WireGuard key and
# a mesh id, and a golden that has them passes BOTH to every clone made from it.
# fiend, build 61, 2026-09-23: the sweep timer fired while k8s-golden was being
# built, enrolled it as node 150, the seal kept /etc/wireguard, and all six
# cluster nodes cloned from it came up with the same key and the same id. On
# the host each peer overwrote the last, one survived, and the Kubernetes API
# became unreachable. It hid until 5923203c, because until then enrolling the
# first VM on a peerless host crashed, so the golden never got that far.
#
# A golden has no marker while it is being built -- klab registers it only
# after the seal -- so this goes by what is certain: the names the builders
# use (klab's golden_name(), kube-cluster's k8s-golden, anything "golden"),
# or an existing @golden snapshot on its zvol.
_is_template() {
    local vm="$1"
    case "$vm" in
    *golden* | klab-ztest-* | klab-desktop-* | klab-xfce-* | klab-kde-* | klab-db-*) return 0 ;;
    esac
    zfs list -H -o name "${KLDLOAD_VM_POOL:-rpool/vms}/${vm}@golden" >/dev/null 2>&1
}

if [[ "${1:-}" == "--all" ]]; then
    shift
    _sweep_role="vm"
    _sweep_cluster=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --role)
            _sweep_role="$2"
            shift 2
            ;;
        --cluster)
            _sweep_cluster="$2"
            shift 2
            ;;
        *)
            echo "unknown option for --all: $1" >&2
            exit 1
            ;;
        esac
    done
    [[ $EUID -eq 0 ]] || exec sudo "$0" --all --role "$_sweep_role" ${_sweep_cluster:+--cluster "$_sweep_cluster"}
    # DELEGATE. The single-VM path below already resolves an address two ways
    # (guest agent, then MAC-to-DHCP-lease) and is already idempotent, so the
    # sweep just invokes it per VM and counts exit codes.
    #
    # The first version re-implemented resolution here using only
    # `virsh domifaddr`, which needs a qemu-guest-agent the goldens do not
    # install — so it reported "10 without an address" for ten VMs that all had
    # perfectly good DHCP leases (.107, 2026-08-22). Two copies of one lookup
    # is how the copies drift.
    _done=0
    _noip=0
    _partial=0
    _tmpl=0
    while read -r _vm; do
        [[ -n "$_vm" ]] || continue
        if _is_template "$_vm"; then
            _tmpl=$((_tmpl + 1))
            continue
        fi
        _rc=0
        # </dev/null is load-bearing. Without it the child inherits this loop's
        # stdin — the process substitution feeding `read` — and consumes the
        # remaining VM names, so the loop runs exactly once. Observed: a sweep
        # over 10 running VMs reported "1 on the mesh" and silently skipped the
        # other nine (.107, 2026-08-22).
        # The per-VM output is KEPT on failure. It used to go to /dev/null, so a
        # VM that would not enrol produced one number in the summary line and
        # nothing else — not its name, not the reason. Chasing a single clone
        # that never reached the mesh took six separate experiments on
        # 2026-09-21 for exactly that reason: every layer reported a count and
        # discarded the cause. A sweep over N machines must say which one and
        # why, or the count is the only thing anyone can act on and it says
        # nothing.
        _out=""
        _out="$("$0" "$_vm" --role "$_sweep_role" ${_sweep_cluster:+--cluster "$_sweep_cluster"} \
            </dev/null 2>&1)" || _rc=$?
        case "$_rc" in
        0) _done=$((_done + 1)) ;;
        1) _noip=$((_noip + 1)) ;;
        *) _partial=$((_partial + 1)) ;;
        esac
        if ((_rc != 0)); then
            # The last line is the one that says why; the rest is progress.
            printf '[enroll] sweep: %s did not enrol (exit %d): %s\n' \
                "$_vm" "$_rc" "$(printf '%s' "$_out" | tail -n1)"
        fi
    done < <(virsh list --state-running --name 2>/dev/null)
    printf '[enroll] sweep: %d on the mesh, %d without an address, %d incomplete, %d golden(s) left alone\n' \
        "$_done" "$_noip" "$_partial" "$_tmpl"
    exit 0
fi

# ── Argument parsing ────────────────────────────────────────────────────────
[[ $# -ge 1 ]] || usage
case "$1" in -h | --help | help) usage 0 ;; esac

# Keep the original argv so the root re-exec below can replay it verbatim.
# Rebuilding it from parsed variables is how a flag gets silently dropped or,
# worse, turned into a positional the parser then rejects.
declare -a _ORIG_ARGV=("$@")

VM="$1"
if _is_template "$VM"; then
    echo "[enroll] ${VM} is a golden (by name or its @golden snapshot) -- not enrolling it: a golden's mesh identity would be copied into every clone" >&2
    exit 2
fi
shift
IP=""
ROLE="vm"
CLUSTER=""
FORCE_ID=""
DO_WG=1
while [[ $# -gt 0 ]]; do
    case "$1" in
    --ip)
        IP="$2"
        shift 2
        ;;
    --role)
        ROLE="$2"
        shift 2
        ;;
    --cluster)
        CLUSTER="$2"
        shift 2
        ;;
    --id)
        FORCE_ID="$2"
        shift 2
        ;;
    --no-wg)
        DO_WG=0
        shift
        ;;
    *) die "unknown option: $1 (try --help)" ;;
    esac
done

# Everything below needs root: virsh, /etc/wireguard, and the guest key.
[[ $EUID -eq 0 ]] || exec sudo "$0" "${_ORIG_ARGV[@]}"

# ── Resolve the guest address ───────────────────────────────────────────────
# Two sources because neither is reliable alone: domifaddr needs a guest agent,
# and the DHCP lease needs the guest to have asked. A VM that has one but not
# the other is normal, not broken.
_resolve_ip() {
    local ip mac
    ip="$(virsh domifaddr "$VM" 2>/dev/null | awk '/ipv4/{split($4,a,"/");print a[1];exit}')"
    [[ -n "$ip" ]] && {
        printf '%s' "$ip"
        return 0
    }
    mac="$(virsh domiflist "$VM" 2>/dev/null | awk 'NR>2 && NF {print $5; exit}')"
    [[ -n "$mac" ]] || return 1
    virsh net-dhcp-leases default 2>/dev/null |
        awk -v m="$mac" 'tolower($0) ~ tolower(m) {split($5,a,"/"); print a[1]; exit}'
}

if [[ -z "$IP" ]]; then
    IP="$(_resolve_ip || true)"
fi
[[ -n "$IP" ]] || {
    warn "${VM}: no address yet — nothing to enroll. Start it, wait for DHCP, re-run."
    exit 1
}
log "${VM}: at ${IP}"

_ssh() {
    # -n: without it ssh reads the CALLER's stdin. kldload-enroll is routinely
    # driven from a script fed on stdin, and each ssh call silently swallowed
    # the rest of it — the enrollment ran, printed nothing, and every command
    # after it never executed. Measured on .120 (2026-08-23): a driver script
    # vanished after the first ssh and looked exactly like a hang.
    ssh -n -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -o ConnectTimeout=10 -o BatchMode=yes \
        -i /root/.ssh/id_ed25519 "root@${IP}" "$@" 2>/dev/null
}

# _ssh_stdin — _ssh WITHOUT -n, for the one call that feeds the guest a file on
# stdin. Kept separate so the -n rule above stays true for everything else.
_ssh_stdin() {
    ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -o ConnectTimeout=10 -o BatchMode=yes \
        -i /root/.ssh/id_ed25519 "root@${IP}" "$@" 2>/dev/null
}

# ── State DB registration ───────────────────────────────────────────────────
# Done FIRST and independently of the mesh. A VM the inventory knows about but
# which is not yet meshed is useful — Ansible can still reach it over the
# libvirt network. A meshed VM the inventory does not know about is not.
if command -v kldload-db >/dev/null 2>&1; then
    if kldload-db vm-register --name "$VM" --role "$ROLE" \
        --cluster "$CLUSTER" --status "running" 2>/dev/null; then
        log "${VM}: registered (role=${ROLE}${CLUSTER:+ cluster=${CLUSTER}})"
    else
        warn "${VM}: kldload-db vm-register failed — Ansible will not see this VM"
    fi
    # swallow: the event row is a timeline nicety. A DB that rejects it
    # must not fail an enrollment that has already registered the VM.
    kldload-db event --type vm --subject "$VM" --message "enrolled: role=${ROLE} ip=${IP}" 2>/dev/null || true
else
    warn "kldload-db not installed — skipping inventory registration"
fi

if ((!DO_WG)); then
    # swallow: the sync is an optimisation — it makes the new VM visible to
    # Ansible now rather than at the next timer tick, so failing it costs 60s,
    # not correctness.
    command -v kldload-networks >/dev/null 2>&1 && kldload-networks sync >/dev/null 2>&1 || true
    log "${VM}: --no-wg, done"
    exit 0
fi

# ── Mesh enrollment ─────────────────────────────────────────────────────────
if ! _ssh true; then
    warn "${VM}: no SSH as root — cannot enrol on the mesh (DB row was written)"
    exit 2
fi
# kube-network is the guest half of the mesh. The k8s golden ships it; the klab
# goldens (klab-golden-*, klab-desktop-*) ship wireguard-tools but not the
# script, so every clone of them was refused here as "not a kldload image" --
# ten goldens per KVM edition, none enrolable (fiend, sweep of build 57,
# 2026-09-23). The script is self-contained (wg, wg-quick, systemd, nft), so
# the host carries ITS OWN copy across rather than anything re-implementing it.
if ! _ssh 'command -v kube-network >/dev/null 2>&1'; then
    if ! _ssh 'command -v wg >/dev/null 2>&1 && command -v wg-quick >/dev/null 2>&1'; then
        warn "${VM}: neither kube-network nor wireguard-tools in the guest — cannot enrol on the mesh (DB row was written)"
        exit 2
    fi
    _kn_src="$(command -v kube-network || true)"
    if [[ -z "$_kn_src" ]]; then
        warn "${VM}: kube-network is not installed on this host either — nothing to carry across (DB row was written)"
        exit 2
    fi
    if _ssh_stdin 'install -d -m 0755 /usr/local/bin && install -m 0755 /dev/stdin /usr/local/bin/kube-network' <"$_kn_src" &&
        _ssh 'command -v kube-network >/dev/null 2>&1'; then
        log "${VM}: kube-network carried into the guest from ${_kn_src}"
    else
        warn "${VM}: could not install kube-network in the guest — cannot enrol on the mesh (DB row was written)"
        exit 2
    fi
fi

# ── Identity: give the guest its own name ───────────────────────────────────
# A golden is sealed with an EMPTY /etc/hostname so it carries no identity into
# its clones, which means every clone boots as localhost.localdomain until
# something tells it otherwise. Measured on .120 (2026-08-22): eight running
# desktop clones, all eight named localhost.localdomain — indistinguishable in
# their own logs, in journald, in a DHCP lease, and in an Ansible play's output.
#
# The guest cannot work this out for itself: nothing inside a libvirt domain
# reports the domain's name. The hypervisor is the only party that knows it,
# and this tool is already talking to both, so it is the right place to say so.
#
# Skipped when the guest already has a real name: an operator who renamed a VM
# on purpose should not have it reverted by a re-run.
_cur_hn="$(_ssh 'hostname' 2>/dev/null | tr -d '[:space:]')"
case "$_cur_hn" in
"" | localhost | localhost.localdomain)
    if _ssh "hostnamectl set-hostname '${VM}' 2>/dev/null || (echo '${VM}' >/etc/hostname && hostname '${VM}')"; then
        # Verify the OUTCOME: hostnamectl exits 0 on images where systemd-hostnamed
        # is not running, having changed nothing.
        _new_hn="$(_ssh 'hostname' 2>/dev/null | tr -d '[:space:]')"
        if [[ "$_new_hn" == "$VM" ]]; then
            log "${VM}: hostname set (was ${_cur_hn:-empty})"
        else
            warn "${VM}: hostname still '${_new_hn:-empty}' after being set — check systemd-hostnamed"
        fi
    else
        warn "${VM}: could not set hostname"
    fi
    ;;
*)
    log "${VM}: keeping existing hostname '${_cur_hn}'"
    ;;
esac

# Allocate an id. Reuse the guest's own if it has one — re-running must not
# renumber a VM out from under its existing peers.
# CAPTURE, THEN CHECK. `_ssh` failing here killed the script ON THE
# ASSIGNMENT (set -e plus pipefail), so a guest that refuses root SSH exited 1
# with no message at all -- and the estate sweep maps exit 1 to "without an
# address", which points whoever reads it at DHCP for what is an
# authentication problem. The address had been resolved and logged two lines
# earlier. Fourth site of this exact shape in this codebase (kube-init,
# deploy.sh, kube-cluster were the others).
#
# HISTORY: fiend, 2026-09-21. Clones of the Debian k8s-golden refuse root ssh
# ("Please login as the user \"debian\" rather than the user \"root\""), so every
# clone died here and the sweep reported it as having no address.
#
# The `|| true` runs IN THE GUEST, and it is the whole point: a fresh clone has
# no .node-id (goldens are sealed without one; one is allocated below), so the
# remote cat exits 1 -- and without the swallow that 1 came back through _ssh
# and was reported as "no SSH as root". Root SSH is already proven by the
# `_ssh true` above; what reaches this branch now is ssh's own failure (255).
# HISTORY: fiend deb-4-k8s + 4-k8s, 2026-09-22 -- every clone of every golden
# failed mesh enrolment here, after the kvm-clone root fix had made SSH work.
# Reproduced on onyx: `_ssh true` rc=0, this read rc=1, /etc/wireguard empty.
if ! node_id="$(_ssh 'cat /etc/wireguard/.node-id 2>/dev/null || true')"; then
    warn "${VM}: no SSH as root while reading its node id — cannot enrol on the mesh (DB row was written)"
    exit 2
fi
node_id="$(printf '%s' "$node_id" | tr -cd '0-9')"
if [[ -n "$FORCE_ID" ]]; then
    node_id="$FORCE_ID"
elif [[ -z "$node_id" ]]; then
    # Highest id the host already peers with, floored at the VM band. Reading
    # the host's own config is enough: every enrolled guest is a peer here by
    # construction, so the host's view is the authoritative allocation map.
    # `|| true`: no "# Node" line is the ANSWER on a host that peers with
    # nobody yet -- the first VM it ever enrols -- and the floor below handles
    # it. Without it grep's exit 1 failed the pipeline under pipefail and the
    # script died on this assignment: every klab golden on deb-3-kvm (build 58,
    # fiend 2026-09-23) failed enrolment, while onyx and the k8s editions,
    # whose hosts already had peers, passed.
    highest="$(grep -hoE '^# Node [0-9]+' /etc/wireguard/wg-mgmt.conf 2>/dev/null |
        awk '{print $3}' | sort -n | tail -1 || true)"
    highest="${highest:-0}"
    ((highest < VM_ID_BASE)) && highest=$((VM_ID_BASE - 1))
    node_id=$((highest + 1))
fi
log "${VM}: mesh id ${node_id} (${MGMT_SUBNET}.${node_id})"

# INIT ONLY ONCE. `kube-network init` is not idempotent: it does
# `cat >/etc/wireguard/wg-k8s.conf` and the same for wg-mgmt, so it TRUNCATES
# both configs and every peer in them, then bounces the interfaces. Calling it
# on a guest that is already meshed does not "re-assert" anything — it wipes
# the mesh that guest was part of.
#
# This ran unconditionally, and once the enroll sweep started firing every ten
# minutes it took the whole Kubernetes mesh down on every pass. Measured on
# .124 (2026-08-24): a repaired 6-node cluster with 6 peers per node was back
# to 1 peer per node within one sweep, three times in a row, and cross-node
# traffic — kubectl exec, cluster DNS, every multi-node workload — died with it.
# The cluster still reported six Ready nodes throughout, because kubelet only
# needs the one peer it kept.
#
# The guest's own .node-id is the marker: it exists only after a successful
# init, and it is already read above to reuse the id. If it is there, the guest
# is meshed and init must not run.
if _ssh 'test -s /etc/wireguard/.node-id'; then
    log "${VM}: already initialised (id ${node_id}) — not re-running init"
else
    _ssh "kube-network init ${node_id}" >/dev/null 2>&1 ||
        log "${VM}: kube-network init reported a problem"
fi

guest_pub="$(_ssh 'cat /etc/wireguard/wg-mgmt.pub' | tr -d '[:space:]')"
[[ -n "$guest_pub" ]] || {
    warn "${VM}: guest produced no public key — mesh enrollment incomplete"
    exit 2
}
host_pub="$(cat /etc/wireguard/wg-mgmt.pub 2>/dev/null || true)"
[[ -n "$host_pub" ]] || {
    warn "hypervisor is not on the mesh (run 'kube-network init ${HOST_ID}') — enrollment incomplete"
    exit 2
}

# Peer both directions. add-peer is append-and-reload, so only call it where
# the peer is genuinely missing — bouncing wg-mgmt under a live guest for a
# peer that already exists is pure disruption.
host_ip="$(ip route get 1.1.1.1 2>/dev/null | awk '/src/{print $7; exit}')"
# Compare the KEY, not just the id. A peer whose id matches and whose key does
# not is STALE, and re-running enrolment is precisely when an operator expects
# that repaired — "idempotent by default" means the second run fixes what the
# first one left, not that it declines to look.
#
# HISTORY: fiend, 2026-09-21. `kube-bluegreen cluster destroy green` wiped the
# hypervisor's wireguard identity; `kube-network init` minted a NEW key and
# `kldload-enroll --all` then reported "6 on the mesh, 0 incomplete" while
# every guest still held the OLD one. Six peers, zero handshakes, and the
# tool said it was done.
_peer_key_awk='$0 ~ "^# Node " id "([[:space:]]|$)" {f=1; next} f && /^PublicKey/ {print $3; exit}'
# `|| true`: no peer block for this id is the ANSWER (it means "add it"), not an
# error, and awk over a missing conf must not kill the script on the assignment.
_hv_have="$(awk -v id="$node_id" "$_peer_key_awk" /etc/wireguard/wg-mgmt.conf 2>/dev/null || true)"
if [[ "$_hv_have" == "$guest_pub" ]]; then
    log "${VM}: hypervisor already peers ${node_id}"
else
    if [[ -n "$_hv_have" ]]; then
        log "${VM}: hypervisor holds a STALE key for ${node_id} — replacing"
        kube-network remove-peer "$node_id" >/dev/null 2>&1 ||
            warn "${VM}: could not remove the stale peer ${node_id}"
    fi
    kube-network add-peer "$IP" "$guest_pub" "$node_id" >/dev/null 2>&1 &&
        log "${VM}: hypervisor now peers ${node_id}" ||
        warn "${VM}: hypervisor did not accept the peer"
fi
# Match the marker without anchoring the end of the line: kube-network writes
# "# Node <id>" and a trailing space or CR (a config that has been through an
# editor) makes an anchored $ miss, which reports "now peers" for a peer that
# was already there. Harmless — add-peer is append-and-reload and the count
# stayed at 1 — but a log line that misdescribes what happened is how the next
# person mis-diagnoses a real duplicate.
# Same comparison on the guest: the id alone said "already peers" while the
# key underneath it was the hypervisor's previous one.
_g_have="$(_ssh "awk '\$0 ~ \"^# Node ${HOST_ID}([[:space:]]|\$)\" {f=1; next} f && /^PublicKey/ {print \$3; exit}' /etc/wireguard/wg-mgmt.conf" 2>/dev/null || true)"
_g_have="$(printf '%s' "$_g_have" | tr -d '[:space:]')"
if [[ "$_g_have" == "$host_pub" ]]; then
    log "${VM}: guest already peers the hypervisor"
else
    if [[ -n "$_g_have" ]]; then
        log "${VM}: guest holds a STALE hypervisor key — replacing"
        _ssh "kube-network remove-peer ${HOST_ID}" >/dev/null 2>&1 ||
            warn "${VM}: could not remove the stale hypervisor peer"
    fi
    _ssh "kube-network add-peer ${host_ip:-$IP} ${host_pub} ${HOST_ID}" >/dev/null 2>&1 &&
        log "${VM}: guest now peers the hypervisor" ||
        warn "${VM}: guest did not accept the hypervisor peer"
fi

# ── Verify the OUTCOME, not the exit codes ──────────────────────────────────
# Every command above can return 0 having achieved nothing. The only proof
# that matters is a handshake-capable peer carrying the expected address.
if wg show wg-mgmt allowed-ips 2>/dev/null | grep -q "${MGMT_SUBNET}.${node_id}/32"; then
    log "${VM}: on the mesh at ${MGMT_SUBNET}.${node_id}"
else
    warn "${VM}: peer did not appear in the running wg-mgmt — check 'wg show'"
    exit 2
fi

# ── Record the enrolment, so a delete can undo it ───────────────────────────
# kvm-delete reads this (mesh/enrolled/<vm>) to take the VM back OFF the mesh.
# Nothing else knows which mesh id belongs to which domain once the domain is
# gone: the DB row
# never carried it, and a peer block in wg-mgmt.conf is keyed by id alone.
# HISTORY: onyx, 2026-09-22 -- an enrolled clone deleted with kvm-delete left
# peer 150 in wg-mgmt and wg-k8s; nothing on the delete path removed peers at
# all, and the lifecycle's unjoin check asked the estate by NAME, so it passed.
# One file per VM, public key only (nothing secret), replaced atomically.
_mesh_dir=/var/lib/kldload/mesh/enrolled
if install -d -m 0755 "$_mesh_dir" &&
    printf 'node_id=%s\nguest_pub=%s\n' "$node_id" "$guest_pub" >"${_mesh_dir}/.${VM}.tmp" &&
    mv -f "${_mesh_dir}/.${VM}.tmp" "${_mesh_dir}/${VM}"; then
    :
else
    warn "${VM}: could not record the enrolment in ${_mesh_dir} — kvm-delete will not remove peer ${node_id}"
fi

# swallow: same as above — the inventory timer picks this up within 60s
# regardless, so a failed immediate sync is a delay and not a defect.
command -v kldload-networks >/dev/null 2>&1 && kldload-networks sync >/dev/null 2>&1 || true
log "${VM}: enrolled"
