#!/usr/bin/env bash
# =============================================================================
# kldload-build-monitor — say, unmissably, that the machine is still building.
#
# WHAT IT DOES, IN ORDER:
#   1. decides whether the post-install build has STOPPED — see finished(),
#      which counts partial success as stopped, not just all-ready;
#   2. if it has not, paints a BUILDING banner with the current phase, a
#      checklist of every planned phase, elapsed time, and a live tail of the
#      log that is actually moving;
#   3. refreshes every 2s until finished();
#   4. paints a closing banner — READY, or "finished, but some phases did not
#      complete" — so the window closing IS the signal it is safe to reboot.
#
# WHY IT EXISTS:
#   A kldload install reaches a usable desktop LONG before it is finished.
#   kldload-firstboot pulls multi-GB models and builds kernel modules;
#   kldload-autodeploy then builds golden VMs and bootstraps a cluster, and its
#   unit allows SIX HOURS (TimeoutStartSec=21600). Until this existed, the only
#   evidence of any of that was journal lines nobody was watching and a
#   notify-send toast that vanishes in seconds.
#
#   HISTORY: 2026-08-13, user report. Someone saw a working desktop, assumed
#   the install was done, and rebooted mid-build. firstboot's ExecStartPost
#   never ran, so it restarted from the beginning on the next boot — and
#   kldload-rag.service, already enabled but with no model pulled yet, began
#   respawning every five seconds. The machine looked broken. Nothing had
#   failed; it had been interrupted, and nothing on screen had said not to.
#
#   The fix for "the user rebooted too early" is not a smaller window or a
#   louder log. It is telling them, in letters they cannot miss, that work is
#   still happening and roughly how much.
#
# INPUTS / OUTPUTS:
#   Reads  /var/lib/kldload/firstboot-done   (written by kldload-firstboot)
#          /var/lib/kldload/all-ready        (written by kldload-autodeploy)
#          /var/lib/kldload/ai-*             (phase markers from autodeploy)
#          /tmp/kldload-firstboot-status     (current step, when written)
#          /var/log/kldload/{firstboot,autodeploy}.log
#   Writes nothing. Read-only by design: a progress display must never be
#   able to damage the thing it is watching.
#
#   --once   paint one frame and exit (for a login banner or a test)
#
# NOTES:
#   - Runs as the DESKTOP USER, not root. It only reads world-readable state,
#     so it needs no privilege, and a monitor that needs sudo is a monitor
#     nobody runs.
#   - No dependency beyond coreutils and a terminal. tput is used when present
#     and every use degrades to plain output when it is not — this has to work
#     on a half-built system, which is the entire point.
# =============================================================================
set -Eeuo pipefail

readonly STATE_DIR=/var/lib/kldload
readonly LOG_DIR=/var/log/kldload
readonly FIRSTBOOT_DONE="${STATE_DIR}/firstboot-done"
readonly ALL_READY="${STATE_DIR}/all-ready"
readonly PHASE_FILE_AD="${STATE_DIR}/current-phase"
readonly STATUS_FILE=/tmp/kldload-firstboot-status
readonly REFRESH=2

# Colour, only when the terminal admits to having any.
if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
    C_AMBER="$(tput setaf 3)"
    C_GREEN="$(tput setaf 2)"
    C_DIM="$(tput setaf 8 2>/dev/null || tput setaf 7)"
    C_BOLD="$(tput bold)"
    C_OFF="$(tput sgr0)"
else
    C_AMBER="" C_GREEN="" C_DIM="" C_BOLD="" C_OFF=""
fi

# cols — terminal width, with a sane floor so the banner never wraps into mush.
cols() {
    local c
    c="$(tput cols 2>/dev/null || echo 80)"
    ((c >= 40)) || c=80
    printf '%s' "$c"
}

# rule — a full-width horizontal rule.
#
# Built by repetition rather than `printf %*s | tr ' ' '─'`: tr substitutes
# BYTES, and U+2500 is three bytes in UTF-8, so that idiom emits one third of
# a box-drawing character per column and the line renders as mojibake.
rule() {
    local w
    w="$(cols)"
    printf '─%.0s' $(seq 1 "$w")
    printf '\n'
}

# centre — print $1 centred in the terminal.
centre() {
    local text="$1" w pad
    w="$(cols)"
    pad=$(((w - ${#text}) / 2))
    ((pad > 0)) || pad=0
    # \033[K erases to end of line. Required because frames are painted OVER
    # the previous one rather than after a clear: a shorter line would
    # otherwise leave the tail of the longer line that was there before.
    printf '%*s%s\033[K\n' "$pad" '' "$text"
}

# banner_building / banner_ready — the part visible from across a room.
#
# Block capitals rather than figlet: figlet is not installed on a kldload
# target, and a banner that depends on a package the build may not have
# finished installing is a banner that is blank exactly when it matters.
banner_building() {
    printf '%s' "${C_AMBER}${C_BOLD}"
    centre "██████  ██   ██ ██ ██     ██████  ██ ██   ██  ██████ "
    centre "██   ██ ██   ██ ██ ██     ██   ██ ██ ███  ██ ██      "
    centre "██████  ██   ██ ██ ██     ██   ██ ██ ██ █ ██ ██   ███"
    centre "██   ██ ██   ██ ██ ██     ██   ██ ██ ██  ███ ██    ██"
    centre "██████   █████  ██ ██████ ██████  ██ ██   ██  ██████ "
    printf '%s' "${C_OFF}"
}

banner_ready() {
    printf '%s' "${C_GREEN}${C_BOLD}"
    centre "██████  ███████  █████  ██████  ██    ██"
    centre "██   ██ ██      ██   ██ ██   ██  ██  ██ "
    centre "██████  █████   ███████ ██   ██   ████  "
    centre "██   ██ ██      ██   ██ ██   ██    ██   "
    centre "██   ██ ███████ ██   ██ ██████     ██   "
    printf '%s' "${C_OFF}"
}

# phase — which stage is running, as a human sentence.
#
# Returns: the phase on stdout. Derived from the same markers the systemd
# units gate on, so this cannot disagree with what is actually happening.
phase() {
    if [[ ! -f "$FIRSTBOOT_DONE" ]]; then
        printf 'Stage 1 of 2 — first boot: packages, drivers, AI models'
    elif [[ ! -f "$ALL_READY" ]]; then
        printf 'Stage 2 of 2 — deployment: golden VMs, cluster, services'
    else
        printf 'Complete'
    fi
}

# current_step — the finest-grained thing we know, or "" when nothing said.
current_step() {
    [[ -r "$STATUS_FILE" ]] || return 0
    tail -n1 "$STATUS_FILE" 2>/dev/null || true
}

# live_log — the log that is actually moving right now.
live_log() {
    if [[ ! -f "$FIRSTBOOT_DONE" ]]; then
        printf '%s/firstboot.log' "$LOG_DIR"
    else
        printf '%s/autodeploy.log' "$LOG_DIR"
    fi
}

# elapsed — how long this machine has been up, as Xh Ym.
#
# Uptime rather than a stored start time: the build spans reboots, and a start
# time written to disk would lie after the first one.
elapsed() {
    local s h m
    s="$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)"
    h=$((s / 3600))
    m=$(((s % 3600) / 60))
    printf '%dh %02dm' "$h" "$m"
}

# finished — has the build STOPPED, whatever the outcome?
#
# all-ready alone is not that question. autodeploy writes it ONLY when every
# requested phase succeeded; on partial success it writes phase "partial" and
# exits. Gating solely on all-ready therefore leaves this window painting
# BUILDING forever on a machine where nothing is running — telling the operator
# to keep waiting for work that already stopped, which is the exact opposite of
# what this program exists to do.
#
# HISTORY: 2026-08-14, fiend. klab, ztest and AI all succeeded, k8s failed, and
# the window was still up ~10 minutes later. Operator asked "the building
# terminal never stopped, is it done?" — it was.
#
# Returns: 0 when the build has reached a terminal state.
finished() {
    [[ -f "$ALL_READY" ]] && return 0
    [[ -e "${STATE_DIR}/autodeploy-skipped" ]] && return 0
    case "$(cat "$PHASE_FILE_AD" 2>/dev/null)" in
    partial | ready | nothing-requested) return 0 ;;
    esac
    return 1
}

# outcome — "ready" or "partial", for the closing banner.
outcome() {
    if [[ -f "$ALL_READY" ]]; then printf 'ready'; else printf 'partial'; fi
}

# markers — the AI phase outcome, when autodeploy has decided one.
markers() {
    local m out=""
    for m in ai-ready ai-failed ai-skipped k8s-ready klab-ready; do
        [[ -e "${STATE_DIR}/${m}" ]] && out+="${m} "
    done
    printf '%s' "$out"
}

# hms — seconds as a compact duration (2h 05m / 8m 12s / 44s).
hms() {
    local s="$1"
    ((s < 0)) && s=0
    if ((s >= 3600)); then
        printf '%dh %02dm' $((s / 3600)) $(((s % 3600) / 60))
    elif ((s >= 60)); then
        printf '%dm %02ds' $((s / 60)) $((s % 60))
    else
        printf '%ds' "$s"
    fi
}

# checklist — the plan, one line per phase, with state and elapsed.
#
# Reads the plan autodeploy declares in $STATE_DIR/phases (NN-<name> files
# holding "<state> <epoch>"). Without a plan there is nothing honest to draw —
# a percentage invented from an unknown total is worse than no percentage — so
# this prints nothing at all and the caller falls back to the phase line.
#
# Returns: the rendered block on stdout, empty when no plan exists.
checklist() {
    local d="${STATE_DIR}/phases" f name state epoch now done_n total icon col dur
    [[ -d "$d" ]] || return 0
    compgen -G "${d}/[0-9][0-9]-*" >/dev/null 2>&1 || return 0
    now="$(date +%s)"
    done_n=0
    total=0
    for f in "$d"/[0-9][0-9]-*; do
        [[ -e "$f" ]] || continue
        total=$((total + 1))
        [[ "$(cut -d' ' -f1 "$f" 2>/dev/null)" == "done" ]] && done_n=$((done_n + 1))
    done
    ((total > 0)) || return 0

    printf '  %sProgress%s %d of %d phases complete\n\n' \
        "${C_BOLD}" "${C_OFF}" "$done_n" "$total"

    for f in "$d"/[0-9][0-9]-*; do
        [[ -e "$f" ]] || continue
        name="${f##*/}"
        name="${name#[0-9][0-9]-}"
        state="$(cut -d' ' -f1 "$f" 2>/dev/null)"
        epoch="$(cut -d' ' -f2 "$f" 2>/dev/null)"
        dur=""
        case "$state" in
        done)
            icon="✓"
            col="${C_GREEN}"
            ;;
        running)
            icon="▶"
            col="${C_AMBER}"
            [[ "${epoch:-0}" -gt 0 ]] && dur="$(hms $((now - epoch)))"
            ;;
        failed)
            icon="✗"
            col="${C_AMBER}"
            ;;
        *)
            icon="·"
            col="${C_DIM}"
            ;;
        esac
        printf '    %s%s %-22s %s%s%s\n' \
            "$col" "$icon" "$name" "${C_DIM}" "${dur:-$state}" "${C_OFF}"
    done
    printf '\n'
}

# frame — paint one screen.
frame() {
    local step log w
    w="$(cols)"
    log="$(live_log)"
    # Home the cursor and overwrite, rather than `clear`.
    #
    # WHY: `clear` erases the whole screen and THEN repaints it, so on every
    # refresh the operator sees a blank frame — the display visibly flashes
    # (reported 2026-08-15). Painting over the previous frame in place removes
    # the blank interval entirely. Each line erases to end-of-line as it is
    # written (see `eol`), and erase-to-end-of-screen at the end of the frame
    # removes any leftovers when a frame gets shorter.
    printf '\033[H'
    printf '\n\n'

    if finished; then
        banner_ready
        printf '\n'
        if [[ "$(outcome)" == "ready" ]]; then
            centre "This machine is finished building. It is safe to reboot."
        else
            # Finished, but not everything succeeded. Say so plainly and point
            # at the checklist below rather than implying a clean run — and
            # still say it is safe to reboot, because it IS.
            printf '%s' "${C_AMBER}"
            centre "Finished — but some phases did not complete."
            printf '%s' "${C_OFF}"
            centre "It is safe to reboot. See the phases below and /var/log/kldload/."
        fi
        printf '\n'
        rule
        local cl_done
        cl_done="$(checklist)"
        [[ -n "$cl_done" ]] && printf '%s\n' "$cl_done"
        printf '%s' "${C_DIM}"
        centre "kldload · $(hostname) · up $(elapsed)"
        printf '%s\n' "${C_OFF}"
        return 0
    fi

    banner_building
    printf '\n'
    printf '%s' "${C_BOLD}"
    centre "DO NOT REBOOT OR POWER OFF"
    printf '%s' "${C_OFF}${C_DIM}"
    centre "The desktop is ready early on purpose. The system is still working."
    printf '%s\n\n' "${C_OFF}"
    rule

    printf '  %sPhase%s    %s\n' "${C_BOLD}" "${C_OFF}" "$(phase)"
    step="$(current_step)"
    [[ -n "$step" ]] && printf '  %sStep%s     %s\n' "${C_BOLD}" "${C_OFF}" "$step"
    printf '  %sElapsed%s  %s\n' "${C_BOLD}" "${C_OFF}" "$(elapsed)"
    local mk
    mk="$(markers)"
    [[ -n "$mk" ]] && printf '  %sDone%s     %s\n' "${C_BOLD}" "${C_OFF}" "$mk"
    printf '\n'

    # The plan, when autodeploy has declared one. Prints nothing on an older
    # target (or during firstboot, before autodeploy runs), so the phase line
    # above remains the fallback rather than leaving a hole in the layout.
    local cl
    cl="$(checklist)"
    if [[ -n "$cl" ]]; then
        rule
        printf '%s\n' "$cl"
    fi
    rule
    printf '  %s%s%s\n' "${C_DIM}" "$log" "${C_OFF}"
    printf '\n'

    # The tail is the "something to look at": proof of motion. Lines are cut to
    # the terminal width because a wrapped 200-column log line destroys the
    # layout and hides the banner above it.
    if [[ -r "$log" ]]; then
        tail -n 10 "$log" 2>/dev/null | cut -c1-$((w - 4)) |
            sed $'s/^/  /; s/$/\033[K/'
    else
        printf '  %s(waiting for the log to appear)%s\n' "${C_DIM}" "${C_OFF}"
    fi
    # Erase anything the PREVIOUS frame left below this one. Required now that
    # we overwrite in place instead of clearing: a frame that shrinks (fewer
    # log lines, a phase list that got shorter) would otherwise leave the old
    # tail on screen forever.
    printf '\033[J'
}

main() {
    if [[ "${1:-}" == "--once" ]]; then
        frame
        return 0
    fi
    # Hide the cursor while looping; always put it back, including on Ctrl-C.
    command -v tput >/dev/null 2>&1 && tput civis 2>/dev/null || true
    trap 'command -v tput >/dev/null 2>&1 && tput cnorm 2>/dev/null || true; printf "\n"' EXIT INT TERM

    while true; do
        frame
        finished && break
        sleep "$REFRESH"
    done
    # Hold the READY screen briefly so a passing glance still catches it.
    sleep 20
}

main "$@"
