#!/usr/bin/env bash
# kube-setup — install Kubernetes packages on any kldload node (apt or dnf)
# Installs: containerd, kubeadm, kubelet, kubectl, cri-tools, Helm, Cilium CLI
# Works on: CentOS, RHEL, Rocky, Fedora (dnf) and Debian, Ubuntu (apt)
set -euo pipefail

# Auto-elevate to root
# --help answers before the root re-exec: asking what a tool does must never
# need a password. This one takes no positional arguments -- its interface is
# the environment, which is exactly the part nobody could discover without
# reading the source.
case "${1:-}" in
-h | --help)
    cat <<'USAGE'
Usage: kube-setup

Install the Kubernetes package set on this node: containerd, kubeadm, kubelet,
kubectl, cri-tools, Helm and the Cilium CLI. Run it on every node, control
plane and worker alike, before kube-init or kube-join.

Takes no arguments. Needs root. Handles dnf (CentOS, RHEL, Rocky, Fedora) and
apt (Debian, Ubuntu) from /etc/os-release.

Environment:
  K8S_VERSION          package repo stream, e.g. v1.37. No default: taken
                       from the caller, then /root/darksite/k8s-stack.lock,
                       then dl.k8s.io's current release. Unresolvable is a
                       fatal error, never a guess.
  HELM_VERSION         Helm release tag, e.g. v4.3.0. From the caller, else
                       HELM_CLI_VERSION in the lock. No literal default.
  CILIUM_CLI_VERSION   cilium-cli release, e.g. v0.20.0. Caller, else the lock.
  HUBBLE_CLI_VERSION   hubble release, e.g. v1.19.4. Caller, else the lock.
                       Hubble has its OWN release train; building its URL from
                       the cilium-cli version 404'd on every install.
  A lock that lacks any of the three is a fatal error: the resolver writes
  all of them, so a lock without one is not the resolver's lock. With no lock
  at all (a hand-run on a networked box) each is taken from GitHub's latest
  release, the same question the resolver asks at build time.

Set K8S_VERSION to the MINOR stream (v1.37), not a patch release -- it selects
the pkgs.k8s.io repo, not a package pin.

  KLDLOAD_DARKSITE_URL  the host's darksite as kube-cluster tunnels it into a
                       golden (http://127.0.0.1:18080). When set, the lock,
                       charts, manifests, CLI tarballs and container images
                       are copied from it into /root/darksite first, and
                       every package installs from its mirror ONLY -- no
                       Docker, pkgs.k8s.io or zfsonlinux repo is added. Unset,
                       everything comes from the internet as before.

See also: kube-init, kube-join, kube-load-images, kube-status.
USAGE
    exit 0
    ;;
esac

if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

# ── The host's darksite, when kube-cluster tunnels it in ────────────────────
# A golden used to install everything from the internet: containerd from
# Docker's repo, kubeadm from pkgs.k8s.io, ZFS from zfsonlinux.org, helm and
# the CLIs from GitHub, and every image by crictl pull. The pre-pull below
# said "darksite" and pulled from quay.io (found 2026-09-27). Every node is a
# clone of the golden, so this is the one place the bundle has to land.
#
# The copy runs FIRST, before anything below reads the lock: the versions are
# taken from the lock this brings in.
# Everything from here also lands in a log on the node: provision-golden runs
# this as an async task, and Ansible shows nothing of an async task's output,
# so the golden's own report ("N of M images from the darksite") reached no
# one on fiend's first offline build (2026-09-27). kube-cluster reads it back.
mkdir -p /var/log/kldload
exec > >(tee -a /var/log/kldload/kube-setup.log) 2>&1

DARKSITE_URL="${KLDLOAD_DARKSITE_URL:-}"
DNF_REPO_ARGS=()
APT_REPO_ARGS=()
DARKSITE_REPO=0
_darksite_fetch() {
    [[ -n "$DARKSITE_URL" ]] || return 0
    local idx f n=0 want=0 failed=()
    if ! idx="$(curl -fsS --max-time 30 "${DARKSITE_URL}/index.txt")"; then
        echo "[kube-setup] WARNING: ${DARKSITE_URL} did not answer — installing from the internet" >&2
        DARKSITE_URL=""
        return 0
    fi
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        # SAFETY: the index is the host's, but each path lands under
        # /root/darksite as root. Nothing absolute, nothing with a ..
        case "$f" in /* | *..*)
            failed+=("${f} (refused path)")
            continue
            ;;
        esac
        want=$((want + 1))
        if curl -fsS --retry 2 --max-time 900 --create-dirs -o "/root/darksite/${f}" "${DARKSITE_URL}/${f}"; then
            n=$((n + 1))
        else
            failed+=("$f")
        fi
    done <<<"$idx"
    echo "[kube-setup] darksite: ${n} of ${want} files copied from the host" >&2
    ((${#failed[@]} == 0)) || echo "[kube-setup] WARNING: darksite files NOT copied: ${failed[*]}" >&2
    return 0
}
_darksite_fetch

# The Kubernetes MINOR stream whose pkgs.k8s.io repo this installs from.
#
# Order: the caller (kube-cluster hands it over from the host's stack lock,
# because this script runs in a GUEST and the lock is on the hypervisor), then
# a lock if one is readable here, then upstream's current release. No literal
# at any rung.
#
# A literal here is how an ISO whose lock said v1.37.0 installed v1.32.13
# kubelets. The same constant existed in FOUR places — this file,
# build-darksite.sh, build-darksite-fedora.sh and the -e passed into the
# darksite container by deploy.sh — and two of them agreed with each other
# loudly enough that the derived answer looked like the odd one out
# (fiend 2026-09-20).
_k8s_lock=/root/darksite/k8s-stack.lock
if [[ -z "${K8S_VERSION:-}" && -r "$_k8s_lock" ]]; then
    K8S_VERSION="$(sed -n 's/^K8S_VERSION=//p' "$_k8s_lock" |
        sed -n 's/^\(v[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -1)" || K8S_VERSION=""
fi
# No literal. Third rung: ask upstream what is current, the same question
# resolve-k8s-stack.sh asks at build time — so a kube-setup run by hand on a
# networked machine with no lock still gets the CURRENT release rather than
# whatever someone typed into this file once.
#
# There is no fourth rung. A hardcoded default is how this project shipped an
# ISO whose lock said v1.37.0 onto nodes running v1.32.13: the literal was in
# four places, two of them agreed with each other, and the derived answer was
# the odd one out. A version nobody can resolve is a reason to stop, not a
# reason to guess.
if [[ -z "${K8S_VERSION:-}" ]]; then
    K8S_VERSION="$(curl -fsSL --max-time 15 https://dl.k8s.io/release/stable.txt 2>/dev/null |
        sed -n 's/^\(v[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -1)" || K8S_VERSION=""
    [[ -n "$K8S_VERSION" ]] && log "Kubernetes ${K8S_VERSION} (current upstream release; no lock on this machine)"
fi
[[ -n "${K8S_VERSION:-}" ]] || die "cannot determine a Kubernetes version: no caller value, no ${_k8s_lock}, and dl.k8s.io is unreachable. Set K8S_VERSION=vX.Y."
log() { echo -e "\033[1;32m[kube-setup]\033[0m $*"; }
warn() { echo -e "\033[1;33m[kube-setup]\033[0m $*" >&2; }
die() {
    echo -e "\033[1;31m[kube-setup]\033[0m $*" >&2
    exit 1
}

# ── CLI versions: caller, then the lock, then upstream — never a literal ────
# The three tools below were pinned here as literals (cilium-cli 0.19.2, helm
# v3.17.0, and hubble fetched at the cilium-cli version, which is not a hubble
# release at all) directly under the comment saying no literal may exist. The
# lock on the same machine said v0.20.0 / v4.3.0 / v1.19.4, so an offline
# install got older tools than its lock recorded and hubble 404'd into a
# "latest" fallback that needs a network (2026-09-23). Same ladder as
# K8S_VERSION above: caller, lock, upstream, or stop.
#
# _lock_version <KEY> — the value of KEY= in the lock, or empty.
_lock_version() {
    sed -n "s/^$1=//p" "$_k8s_lock" 2>/dev/null | head -1
}
# _gh_latest <owner/repo> — the tag of the latest GitHub release, or empty.
_gh_latest() {
    curl -fsSL --max-time 15 "https://api.github.com/repos/$1/releases/latest" 2>/dev/null |
        sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1
}
# _cli_version <VAR> <LOCK_KEY> <owner/repo> <what> — resolve one tool's tag
# into VAR: the caller's value wins; else the lock's; else (NO lock file at
# all) upstream's latest; else die. A lock that exists but lacks the key is
# fatal on its own: the resolver writes every key, so a lock missing one was
# not written by the resolver and must not be guessed around.
_cli_version() {
    local var="$1" key="$2" repo="$3" what="$4" v="${!1:-}"
    if [[ -z "$v" && -r "$_k8s_lock" ]]; then
        v="$(_lock_version "$key")"
        [[ -n "$v" ]] || die "${_k8s_lock} has no ${key}= line — not a resolver-written lock; re-run build/darksite/resolve-k8s-stack.sh"
        log "${what} ${v} (from ${_k8s_lock})"
    elif [[ -z "$v" ]]; then
        v="$(_gh_latest "$repo")"
        [[ -n "$v" ]] || die "cannot determine a ${what} version: no caller value, no ${_k8s_lock}, and GitHub is unreachable. Set ${var}=vX.Y.Z."
        log "${what} ${v} (current upstream release; no lock on this machine)"
    fi
    # Tags are vX.Y.Z everywhere below; accept a bare X.Y.Z from a caller.
    printf -v "$var" '%s' "v${v#v}"
}
_cli_version HELM_VERSION HELM_CLI_VERSION helm/helm "Helm"
_cli_version CILIUM_CLI_VERSION CILIUM_CLI_VERSION cilium/cilium-cli "Cilium CLI"
_cli_version HUBBLE_CLI_VERSION HUBBLE_CLI_VERSION cilium/hubble "Hubble CLI"

# ── Detect package manager ─────────────────────────────────────────────────
detect_pm() {
    if command -v dnf >/dev/null 2>&1; then
        echo "dnf"
    elif command -v apt-get >/dev/null 2>&1; then
        echo "apt"
    else
        die "No supported package manager found (need dnf or apt)"
    fi
}

PM="$(detect_pm)"
log "Package manager: $PM"
log "Kubernetes version: $K8S_VERSION"

# ── RPM family detection ───────────────────────────────────────────────────
# Fedora vs EL (CentOS/RHEL/Rocky) diverge on three things kube-setup hits:
#   1. Docker CE repo path:   /linux/fedora/  vs  /linux/centos/
#   2. ZFS release URL path:  /fedora/        vs  /epel/
#   3. EPEL: doesn't exist on Fedora — skip it
# Detect once here so each install_* function can branch cleanly. dnf5 (F41+)
# also needs different `config-manager` invocation; that's handled by
# _dnf_addrepo below.
RPM_ID=""
RPM_VER=""
if [[ "$PM" == "dnf" && -f /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    RPM_ID="${ID:-}"
    RPM_VER="${VERSION_ID:-}"
    log "RPM family: ${RPM_ID} ${RPM_VER}"
fi

# Fedora rev (44 → 44) used for zfs-release fc-N fallback. Empty on EL.
RPM_FEDORA_VER=""
[[ "$RPM_ID" == "fedora" ]] && RPM_FEDORA_VER="$RPM_VER"

# dnf4 vs dnf5: F41+ ships dnf5 by default, which moved `config-manager
# --add-repo URL` to `config-manager addrepo --from-repofile=URL`. Old form
# still works as a compat shim on most builds but throws warnings. Try the
# new form first, fall back to the old. Returns 0 either way (callers gate
# on the resulting repo file existing, not on this exit code).
_dnf_addrepo() {
    local url="$1"
    dnf -y config-manager addrepo --from-repofile="$url" 2>/dev/null ||
        dnf -y config-manager --add-repo "$url" 2>/dev/null ||
        true
}

# _darksite_repo — make the host's mirror this golden's ONLY package source.
# Only, not preferred: dnf takes the newest version across enabled repos, so a
# mirror that is merely added still loses to fedora-updates (the installer
# learned this on the XPS, 2026-05-18), and offline an unreachable repo fails
# the transaction. gpgcheck=0 as the installer's own darksite repo: the
# packages were fetched from signed repos when the ISO was built.
# Sets DNF_REPO_ARGS / APT_REPO_ARGS and DARKSITE_REPO=1, or leaves the
# online path alone and says why.
_darksite_repo() {
    [[ -n "$DARKSITE_URL" ]] || return 0
    if [[ "$PM" == "dnf" ]]; then
        cat >/etc/yum.repos.d/kldload-darksite.repo <<EOF
[kldload-darksite]
name=kldload darksite (this cluster's host)
baseurl=${DARKSITE_URL}/repo/
enabled=1
gpgcheck=0
EOF
        DNF_REPO_ARGS=(--disablerepo='*' --enablerepo=kldload-darksite)
        if dnf "${DNF_REPO_ARGS[@]}" makecache >/dev/null; then
            DARKSITE_REPO=1
        else
            rm -f /etc/yum.repos.d/kldload-darksite.repo
            DNF_REPO_ARGS=()
        fi
    else
        local codename
        codename="$(. /etc/os-release && echo "${VERSION_CODENAME:-}")"
        echo "deb [trusted=yes] ${DARKSITE_URL}/repo ${codename} main" >/etc/apt/kldload-darksite.list
        # SourceParts pointed at nothing: the cloud image's own deb822 sources
        # would otherwise stay in the resolution, and fail offline.
        APT_REPO_ARGS=(-o Dir::Etc::SourceList=/etc/apt/kldload-darksite.list
            -o Dir::Etc::SourceParts=/nonexistent)
        if apt-get "${APT_REPO_ARGS[@]}" update >/dev/null; then
            DARKSITE_REPO=1
        else
            rm -f /etc/apt/kldload-darksite.list
            APT_REPO_ARGS=()
        fi
    fi
    if ((DARKSITE_REPO)); then
        log "Packages: this host's darksite mirror ONLY (${DARKSITE_URL}/repo)"
    else
        warn "the host's mirror did not answer as a ${PM} repo — packages come from the internet"
    fi
}

# _darksite_retire — the tunnel dies with provision-golden, so a repo pointing
# at it would fail every later dnf/apt on every clone. The image tarballs are
# in containerd now; the charts, manifests, lock and CLI tarballs stay, since
# kube-init reads them on the control plane.
_darksite_retire() {
    rm -f /etc/yum.repos.d/kldload-darksite.repo /etc/apt/kldload-darksite.list
    rm -rf /root/darksite/k8s-images
}

_dnf() { dnf "${DNF_REPO_ARGS[@]}" "$@"; }
_apt() { DEBIAN_FRONTEND=noninteractive apt-get "${APT_REPO_ARGS[@]}" "$@"; }

# ── Kernel modules & sysctl ────────────────────────────────────────────────
setup_kernel() {
    log "Loading kernel modules for Kubernetes..."

    cat >/etc/modules-load.d/k8s.conf <<'EOF'
overlay
br_netfilter
ip_vs
ip_vs_rr
ip_vs_wrr
ip_vs_sh
nf_conntrack
EOF

    for m in overlay br_netfilter ip_vs ip_vs_rr ip_vs_wrr ip_vs_sh nf_conntrack; do
        modprobe "$m" 2>/dev/null || true
    done

    cat >/etc/sysctl.d/99-kubernetes.conf <<'EOF'
net.ipv4.ip_forward = 1
net.bridge.bridge-nf-call-iptables = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.conf.all.rp_filter = 0
net.ipv4.conf.default.rp_filter = 0
EOF
    sysctl --system >/dev/null 2>&1

    # Disable swap (kubeadm requires it). Fedora 44 cloud images ship
    # zram-generator-defaults which creates /dev/zram0 swap on every boot
    # via systemd-zram-setup@zram0.service. swapoff handles the live
    # instance, but without removing the generator, the next boot brings
    # it right back — kubelet refuses to start with swap on, leading to
    # the cascade: kubelet fails → kubeadm init retries → second init
    # fails on already-existing manifests → cluster never converges.
    # Bug seen 2026-05-05 on F44 K8s golden VMs. Fix: also mask the
    # generator unit AND nuke /etc/systemd/zram-generator.conf so the
    # next boot stays swap-free.
    swapoff -a || true
    sed -ri '/\sswap\s/s/^/#/' /etc/fstab 2>/dev/null || true
    systemctl disable --now 'systemd-zram-setup@*.service' 2>/dev/null || true
    systemctl mask 'systemd-zram-setup@zram0.service' 2>/dev/null || true
    rm -f /etc/systemd/zram-generator.conf /usr/lib/systemd/zram-generator.conf 2>/dev/null || true
    # Defensive: the package itself if it exists (Fedora-only).
    if command -v dnf >/dev/null 2>&1; then
        dnf remove -y zram-generator zram-generator-defaults 2>/dev/null || true
    fi

    log "Kernel modules and sysctl configured (swap + zram disabled)"
}

# ── Containerd ─────────────────────────────────────────────────────────────
install_containerd() {
    log "Installing containerd..."

    if [[ "$PM" == "dnf" ]]; then
        # Docker CE repo provides containerd.io (not in default EL/Fedora repos).
        # download.docker.com publishes per-distro repo files at /linux/<id>/.
        # Pre-RHEL-10 we mapped rhel→centos because RHEL 9 was binary-compatible
        # with CentOS Stream 9. That breaks for RHEL 10 (different kernel + libc
        # transition), so RHEL gets its own /linux/rhel/ path. Rocky stays on the
        # centos path until Rocky 10 ships.
        if ((DARKSITE_REPO == 0)) && ! dnf list containerd.io 2>/dev/null | grep -q containerd; then
            local _docker_path
            case "$RPM_ID" in
            fedora) _docker_path="fedora" ;;
            rhel) _docker_path="rhel" ;;
            centos | rocky | *) _docker_path="centos" ;;
            esac
            _dnf_addrepo "https://download.docker.com/linux/${_docker_path}/docker-ce.repo"
        fi
        _dnf install -y containerd.io || _dnf install -y containerd
    else
        ((DARKSITE_REPO)) || apt-get update -y >/dev/null 2>&1
        _apt install -y --no-install-recommends containerd
    fi

    mkdir -p /etc/containerd
    # No `|| true` on the config: a containerd whose `config default` failed
    # left an EMPTY config.toml, the sed then had nothing to change, and the
    # log line at the bottom still announced SystemdCgroup=true. kubeadm on a
    # cgroupfs containerd under a systemd kubelet is the "pods crash-loop after
    # the first reboot" failure. Write it, edit it, then READ THE VALUE BACK.
    containerd config default >/etc/containerd/config.toml ||
        die "containerd config default failed — no config.toml written"
    sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
    # Fix CNI plugin path — Debian defaults to /usr/lib/cni but Cilium installs to /opt/cni/bin
    sed -i 's|bin_dir = "/usr/lib/cni"|bin_dir = "/opt/cni/bin"|' /etc/containerd/config.toml
    grep -qE '^[[:space:]]*SystemdCgroup = true' /etc/containerd/config.toml ||
        die "SystemdCgroup = true is not in /etc/containerd/config.toml after editing it — containerd $(containerd --version 2>/dev/null | head -1) emits a default this sed does not match"

    # The pod sandbox (pause) image is the one the lock pinned and the darksite
    # carries -- not whatever this containerd defaults to. Debian's containerd
    # 1.7 defaults to pause:3.8 while the lock and the golden carry 3.10.2, so
    # an offline kubeadm init could create no pod at all and the control plane
    # never came up (deb-4-k8s, build 155, fiend 2026-09-28: 68 SYNs to
    # registry.k8s.io). Fedora's containerd 2.x happened to default to the same
    # tag, which is luck, not a guarantee. 1.7 writes `sandbox_image = "..."`,
    # 2.x writes `sandbox = '...'`; `sandbox_mode`/`sandboxer` do not match.
    local _pause=""
    [[ -r "$_k8s_lock" ]] &&
        _pause="$(sed -n 's#^IMAGE=\(registry\.k8s\.io/pause:.*\)$#\1#p' "$_k8s_lock" | sed -n 1p)"
    if [[ -n "$_pause" ]]; then
        sed -E -i "s#^([[:space:]]*(sandbox_image|sandbox)[[:space:]]*=[[:space:]]*)[\"'][^\"']*[\"']#\1\"${_pause}\"#" \
            /etc/containerd/config.toml
        grep -qE "^[[:space:]]*(sandbox_image|sandbox)[[:space:]]*=[[:space:]]*\"${_pause}\"" /etc/containerd/config.toml ||
            die "containerd's sandbox image is not ${_pause} after editing config.toml — containerd $(containerd --version 2>/dev/null | head -1) writes it in a form this sed does not match"
        log "containerd sandbox image: ${_pause} (the lock's)"
    elif [[ -r "$_k8s_lock" ]]; then
        die "${_k8s_lock} pins no registry.k8s.io/pause image — not a resolver-written lock"
    fi

    # Use systemd cgroup driver — required for kubeadm
    systemctl enable --now containerd
    systemctl restart containerd

    # crictl config
    cat >/etc/crictl.yaml <<'EOF'
runtime-endpoint: unix:///run/containerd/containerd.sock
image-endpoint: unix:///run/containerd/containerd.sock
timeout: 10
debug: false
EOF

    log "containerd installed and configured (SystemdCgroup=true)"
}

# _zfs_from_darksite — ZFS for the kernel the CLONES will boot.
# The online path installs kernel-devel for the RUNNING cloud kernel, which the
# mirror does not carry: it holds the kernel the host installs. So the golden
# takes that kernel and its headers from the mirror, DKMS builds ZFS for it,
# and every clone boots it -- the same kernel as the host, which is what the
# Fedora-golden choice in kube-cluster was for. A build that fails warns: ZFS
# in a node serves the ZFS CSI only, and the node works without it.
_zfs_from_darksite() {
    local kver
    # The RUNNING kernel first, when the mirror has its headers (the Fedora
    # build adds the release kernel's, which is the cloud image's): nodes keep
    # the kernel they were tested on, and Tetragon 1.7.1 cannot parse the BTF
    # of the 7.2 kernel the fallback below installs (fiend, 2026-09-27).
    # kernel-devel-matched for the SAME kernel: dkms requires the package, and
    # the only other copy is the pinned kernel's, which pulls that kernel in.
    if [[ "$PM" == "dnf" ]] && _dnf install -y "kernel-devel-$(uname -r)" "kernel-devel-matched-$(uname -r)" \
        dkms gcc make zfs zfs-dkms; then
        kver="$(uname -r)"
    elif [[ "$PM" == "dnf" ]]; then
        log "no headers for the running kernel $(uname -r) in the darksite — installing the mirror's kernel for ZFS"
        _dnf install -y kernel kernel-devel dkms gcc make zfs zfs-dkms || {
            warn "ZFS packages did not install from the darksite -- nodes will have no zfs"
            return 0
        }
        kver="$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' kernel-devel | sort -V | tail -1)"
    else
        local _a
        _a="$(dpkg --print-architecture)"
        _apt install -y --no-install-recommends "linux-image-${_a}" "linux-headers-${_a}" \
            zfsutils-linux zfs-dkms || {
            warn "ZFS packages did not install from the darksite -- nodes will have no zfs"
            return 0
        }
        kver="$(find /usr/src -maxdepth 1 -name "linux-headers-*-${_a}" -printf '%f\n' |
            sed 's/^linux-headers-//' | sort -V | tail -1)"
    fi
    dkms autoinstall -k "$kver" >/dev/null 2>&1 ||
        true # swallow: the status check below is the outcome, whatever autoinstall returned
    if dkms status -k "$kver" zfs 2>/dev/null | grep -q 'installed'; then
        log "ZFS built for ${kver}"
    else
        warn "ZFS did not build for ${kver} -- nodes will have no zfs module"
    fi
    # The kernel the clones will BOOT must be the one ZFS was built for. A
    # transaction that pulls in a second kernel makes it the default, and the
    # log above still said "built for" the other one (round 3 on fiend: ZFS for
    # 6.19, clones on 7.2.7, no zfs module and Tetragon crash-looping).
    if command -v grubby >/dev/null 2>&1; then
        local _boot
        _boot="$(grubby --default-kernel 2>/dev/null | sed 's#.*/vmlinuz-##')" || _boot=""
        if [[ -n "$_boot" && "$_boot" != "$kver" ]]; then
            warn "the default boot kernel is ${_boot}, not ${kver} -- setting it back"
            grubby --set-default "/boot/vmlinuz-${kver}" ||
                warn "grubby could not set ${kver} as default; clones boot ${_boot} without ZFS"
        fi
        _boot="$(grubby --default-kernel 2>/dev/null | sed 's#.*/vmlinuz-##')" || _boot=""
        log "clones boot ${_boot:-an unknown kernel}$([[ "$_boot" == "$kver" ]] && echo ', which has ZFS')"
    fi
}

# ── Kubernetes repo + packages ─────────────────────────────────────────────
install_k8s_packages() {
    log "Setting up Kubernetes $K8S_VERSION repo..."

    if [[ "$PM" == "dnf" ]]; then
        ((DARKSITE_REPO)) || cat >/etc/yum.repos.d/kubernetes.repo <<EOF
[kubernetes]
name=Kubernetes
baseurl=https://pkgs.k8s.io/core:/stable:/${K8S_VERSION}/rpm/
enabled=1
gpgcheck=1
gpgkey=https://pkgs.k8s.io/core:/stable:/${K8S_VERSION}/rpm/repodata/repomd.xml.key
EOF
        # WARN: --skip-broken is only safe behind a gate that names what it
        # skipped. Bare `--skip-broken || true` is the b652 pattern: it
        # dropped webkitgtk6.0 and shipped a ghost install that looked green.
        # The retry is kept because a mirror flake mid-transaction is real,
        # but what survives it is now checked package by package.
        _k8s_pkgs=(kubelet kubeadm kubectl cri-tools conntrack-tools socat
            ipvsadm nftables wireguard-tools)
        _dnf install -y "${_k8s_pkgs[@]}" || {
            warn "Some packages failed — retrying once with --skip-broken"
            _dnf install -y --skip-broken "${_k8s_pkgs[@]}" || true # swallow: the per-package check right below names anything it skipped
        }
        # Verify by PACKAGE, not by binary. The previous check covered only
        # kubeadm/kubelet/kubectl, so a dropped socat or conntrack-tools went
        # unnoticed until kubeadm's preflight failed later with an error
        # nobody could trace back to this install, and a dropped
        # wireguard-tools broke the WireGuard path with no message at all.
        # Package names are checked because most of these do not provide a
        # binary of the same name (nftables→nft, cri-tools→crictl).
        _missing=()
        for _pkg in "${_k8s_pkgs[@]}"; do
            rpm -q "$_pkg" >/dev/null 2>&1 || _missing+=("$_pkg")
        done
        ((${#_missing[@]} == 0)) ||
            die "kubernetes packages missing after install: ${_missing[*]}"
        for _pkg in kubeadm kubelet kubectl; do
            command -v "$_pkg" >/dev/null 2>&1 || die "$_pkg not installed after dnf"
        done
        # Install ZFS if not already present (needed for ZFS CSI inside VMs).
        # zfsonlinux.org publishes per-distro release RPMs at two URL trees:
        #   /epel/zfs-release-2-3.elN.noarch.rpm   for EL (CentOS/RHEL/Rocky)
        #   /fedora/zfs-release-2-3.fcN.noarch.rpm for Fedora
        # Fedora releases ship fast — fcN may not yet exist when the OS does.
        # Same fc-N fallback klab uses for goldens: try fcN, then fc(N-1), then
        # fc(N-2). DKMS will still build against the running kernel even with
        # an "older" repo, since the userland tooling just needs zfs-dkms +
        # the kmod build deps.
        if ! command -v zfs >/dev/null 2>&1 && ((DARKSITE_REPO)); then
            _zfs_from_darksite
        elif ! command -v zfs >/dev/null 2>&1; then
            # EPEL is EL-only; Fedora pretends it doesn't exist (and dnf install
            # epel-release on Fedora throws "no match for argument: epel-release"
            # noise). Skip on Fedora.
            if [[ "$RPM_ID" != "fedora" ]]; then
                dnf install -y epel-release 2>/dev/null || true
            fi
            dnf install -y "kernel-devel-$(uname -r)" "kernel-headers-$(uname -r)" dkms gcc make 2>/dev/null || true

            local _zfs_url=""
            if [[ -n "$RPM_FEDORA_VER" ]]; then
                local _try
                for _try in "$RPM_FEDORA_VER" "$((RPM_FEDORA_VER - 1))" "$((RPM_FEDORA_VER - 2))"; do
                    local _candidate="https://zfsonlinux.org/fedora/zfs-release-2-3.fc${_try}.noarch.rpm"
                    if curl -sfLI --max-time 10 "$_candidate" >/dev/null 2>&1; then
                        _zfs_url="$_candidate"
                        log "  zfs-release: using fc${_try} (host is fc${RPM_FEDORA_VER})"
                        break
                    fi
                done
            else
                # EL family — try the host's %{dist} first, then fall back to el9.
                # `rpm --eval '%{dist}'` returns ".el10" on RHEL 10, ".el9" on Stream/Rocky 9.
                # zfsonlinux.org publishes both, but el10 lagged el10's GA by a few
                # weeks — the fallback keeps install_k8s_packages green during that gap.
                local _dist _suffix
                _dist="$(rpm --eval '%{dist}' 2>/dev/null)"
                for _suffix in "$_dist" ".el9"; do
                    [[ -z "$_suffix" ]] && continue
                    local _candidate="https://zfsonlinux.org/epel/zfs-release-2-3${_suffix}.noarch.rpm"
                    if curl -sfLI --max-time 10 "$_candidate" >/dev/null 2>&1; then
                        _zfs_url="$_candidate"
                        log "  zfs-release: using ${_suffix#.} (host is ${_dist#.})"
                        break
                    fi
                done
            fi
            [[ -n "$_zfs_url" ]] && dnf install -y "$_zfs_url" 2>/dev/null || true

            dnf install -y zfs zfs-dkms 2>/dev/null || dnf install -y zfs 2>/dev/null || true
            modprobe zfs 2>/dev/null || true
        fi
        systemctl enable kubelet
    else
        if ((DARKSITE_REPO == 0)); then
            apt-get install -y --no-install-recommends apt-transport-https ca-certificates curl gpg
            install -d -m0755 /etc/apt/keyrings
            curl -fsSL "https://pkgs.k8s.io/core:/stable:/${K8S_VERSION}/deb/Release.key" |
                gpg --batch --yes --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg 2>/dev/null
            echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/${K8S_VERSION}/deb/ /" \
                >/etc/apt/sources.list.d/kubernetes.list
            apt-get update -y >/dev/null 2>&1
        fi
        _apt install -y --no-install-recommends kubelet kubeadm kubectl cri-tools \
            conntrack socat nftables ipset ipvsadm wireguard-tools
        for _pkg in kubelet kubeadm kubectl cri-tools; do
            dpkg -s "$_pkg" >/dev/null 2>&1 || die "$_pkg not installed after apt"
        done
        apt-mark hold kubelet kubeadm kubectl 2>/dev/null || true
        # Install ZFS if not already present (needed for ZFS CSI inside VMs)
        if ! command -v zfs >/dev/null 2>&1 && ((DARKSITE_REPO)); then
            _zfs_from_darksite
        elif ! command -v zfs >/dev/null 2>&1; then
            apt-get install -y --no-install-recommends zfsutils-linux zfs-dkms 2>/dev/null ||
                apt-get install -y --no-install-recommends zfsutils-linux 2>/dev/null || true
        fi
        systemctl enable kubelet
    fi

    # CNI plugin directory
    install -d -m0755 /opt/cni/bin /etc/cni/net.d
    if [[ -d /usr/lib/cni ]]; then
        ln -sf /usr/lib/cni/* /opt/cni/bin/ 2>/dev/null || true
    fi

    # Pin kubelet to node IP if detectable
    local node_ip
    node_ip="$(ip route get 1.1.1.1 2>/dev/null | awk '/src/ {print $7; exit}')" || true
    if [[ -n "$node_ip" ]]; then
        mkdir -p /etc/default
        echo "KUBELET_EXTRA_ARGS=--node-ip=${node_ip}" >/etc/default/kubelet
        log "kubelet pinned to node IP: $node_ip"
    fi

    log "kubeadm $(kubeadm version -o short 2>/dev/null) installed"
}

# ── Helm ───────────────────────────────────────────────────────────────────
install_helm() {
    if command -v helm >/dev/null 2>&1; then
        log "Helm already installed: $(helm version --short 2>/dev/null)"
        return 0
    fi

    log "Installing Helm $HELM_VERSION..."
    local arch
    arch="$(uname -m)"
    [[ "$arch" == "x86_64" ]] && arch="amd64"
    [[ "$arch" == "aarch64" ]] && arch="arm64"

    # Prefer the baked copy. build-iso.sh downloads helm into
    # /root/darksite/bin at BUILD time precisely so an air-gapped install has
    # it; going to get.helm.sh first meant an offline machine got no helm and
    # every chart install failed afterwards, with the only clue a curl error
    # in a log. Same "prefer local, fall back to the network" shape the apt
    # and NVIDIA paths use.
    local _hd="/root/darksite/bin/helm-linux-${arch}.tar.gz"
    if [[ -s "$_hd" ]]; then
        log "Installing Helm from the darksite (no network needed)"
        tar -xzf "$_hd" -C /tmp
    else
        curl -fsSL "https://get.helm.sh/helm-${HELM_VERSION}-linux-${arch}.tar.gz" |
            tar -xz -C /tmp
    fi
    install -m 755 "/tmp/linux-${arch}/helm" /usr/local/bin/helm
    rm -rf "/tmp/linux-${arch}"

    log "Helm installed: $(helm version --short 2>/dev/null)"
}

# ── Cilium CLI ─────────────────────────────────────────────────────────────
install_cilium_cli() {
    if command -v cilium >/dev/null 2>&1; then
        log "Cilium CLI already installed (no \`cilium version\`: it asks GitHub for the stable tag)"
        return 0
    fi

    log "Installing Cilium CLI ${CILIUM_CLI_VERSION}..."
    local arch
    arch="$(uname -m)"
    [[ "$arch" == "x86_64" ]] && arch="amd64"
    [[ "$arch" == "aarch64" ]] && arch="arm64"

    # The tags carry their v (v0.20.0); the resolver above guarantees it.
    # The darksite copy first: the ISO bakes each CLI at the lock's version.
    if [[ -s "/root/darksite/bin/cilium-linux-${arch}.tar.gz" ]]; then
        tar -xzf "/root/darksite/bin/cilium-linux-${arch}.tar.gz" -C /usr/local/bin cilium
    else
        curl -fsSL "https://github.com/cilium/cilium-cli/releases/download/${CILIUM_CLI_VERSION}/cilium-linux-${arch}.tar.gz" |
            tar -xz -C /usr/local/bin
    fi
    chmod +x /usr/local/bin/cilium

    log "Cilium CLI installed"

    # Install Hubble CLI — at ITS version, not cilium-cli's. There is no
    # "latest" fallback any more: it fetched an unrecorded version over the
    # network, which is the opposite of what the lock is for. Hubble is
    # optional, so a miss is a warning, but a truthful one.
    if ! command -v hubble >/dev/null 2>&1; then
        log "Installing Hubble CLI ${HUBBLE_CLI_VERSION}..."
        if [[ -s "/root/darksite/bin/hubble-linux-${arch}.tar.gz" ]]; then
            tar -xzf "/root/darksite/bin/hubble-linux-${arch}.tar.gz" -C /usr/local/bin hubble ||
                true # optional tool; the outcome check below is what reports it
        else
            curl -fsSL "https://github.com/cilium/hubble/releases/download/${HUBBLE_CLI_VERSION}/hubble-linux-${arch}.tar.gz" |
                tar -xz -C /usr/local/bin 2>/dev/null || true # optional tool; the outcome check below is what reports it
        fi
        [[ -x /usr/local/bin/hubble ]] && log "Hubble CLI installed" || log "WARNING: Hubble CLI ${HUBBLE_CLI_VERSION} install failed (optional)"
    fi

    # Install k9s (terminal UI for Kubernetes)
    if ! command -v k9s >/dev/null 2>&1; then
        log "Installing k9s..."
        if [[ -s "/root/darksite/bin/k9s_Linux_${arch}.tar.gz" ]]; then
            tar -xzf "/root/darksite/bin/k9s_Linux_${arch}.tar.gz" -C /usr/local/bin k9s ||
                true # optional tool; the outcome check below reports it
        else
            curl -fsSL "https://github.com/derailed/k9s/releases/latest/download/k9s_Linux_${arch}.tar.gz" |
                tar -xz -C /usr/local/bin k9s 2>/dev/null || true # optional tool; the outcome check below reports it
        fi
        [[ -x /usr/local/bin/k9s ]] && log "k9s installed" || log "WARNING: k9s install failed (optional)"
    fi
}

# ── ZFS dataset for containerd ─────────────────────────────────────────────
setup_zfs_for_k8s() {
    if ! command -v zfs >/dev/null 2>&1; then return 0; fi

    # Create dedicated ZFS datasets for container/K8s storage
    local pool
    pool="$(zfs list -H -o name / 2>/dev/null | cut -d/ -f1)" || true
    [[ -n "$pool" ]] || return 0

    log "Setting up ZFS datasets for Kubernetes on pool: $pool"

    # the estate's one storage rule (docs/STORAGE.md): 16K for etcd, which
    # writes small records and waits on each fsync, as for every database;
    # 128K for the container and kubelet stores. Same values the installer
    # gives a host that runs Kubernetes itself (profiles.sh).
    # WHY: a dataset that already exists (a re-run, or a golden built while
    # etcd was 8K) gets the size set, not skipped; recordsize applies to new
    # writes, so it is safe on a live store. A failure warns and the node
    # carries on sharing the root dataset, which works, only untuned.
    local spec ds mnt rs made=0
    for spec in etcd:16K containerd:128K kubelet:128K; do
        ds="${pool}/var/lib/${spec%%:*}"
        mnt="/var/lib/${spec%%:*}"
        rs="${spec##*:}"
        if zfs list -H -o name "$ds" >/dev/null 2>&1; then
            zfs set recordsize="$rs" compression=lz4 atime=off "$ds" ||
                {
                    warn "could not set ${rs} on ${ds}"
                    continue
                }
        else
            zfs create -p -o mountpoint="$mnt" -o recordsize="$rs" \
                -o compression=lz4 -o atime=off "$ds" ||
                {
                    warn "could not create ${ds}; ${mnt} stays on the root dataset"
                    continue
                }
        fi
        ((++made))
    done
    log "ZFS datasets for Kubernetes: ${made} of 3 at the estate sizes (etcd 16K, containerd and kubelet 128K)"
}

# ── Main ───────────────────────────────────────────────────────────────────
# install_node_exporter — host metrics on :9100, so a clone of this golden is
# scraped like every klab guest. The hypervisor's klab-prom-targets lists
# every enrolled VM (klab-vms.json); a k8s-golden clone was in that list and
# refused the connection, because nothing here ever installed an exporter
# (onyx, 2026-09-22).
#
# Package names, checked against the repos on 2026-09-22: Fedora 44 and EL10
# (EPEL) ship `node-exporter`; Debian ships `prometheus-node-exporter`. All
# three install prometheus-node-exporter.service, so that is the unit enabled.
# Returns 0 either way -- a missing exporter costs metrics, not the golden --
# but says so loudly, and the estate lifecycle checks the scrape itself.
install_node_exporter() {
    log "Installing node_exporter..."
    local _ok=0
    if [[ "$PM" == "dnf" ]]; then
        _dnf install -y node-exporter && _ok=1
    else
        _apt install -y --no-install-recommends prometheus-node-exporter && _ok=1
    fi
    if ((_ok == 0)); then
        warn "node_exporter did not install -- clones of this golden will not answer on :9100"
        return 0
    fi
    # Outcome: the unit exists and is enabled in the image that gets sealed.
    systemctl enable --now prometheus-node-exporter.service ||
        warn "prometheus-node-exporter.service did not enable"
    if systemctl is-enabled prometheus-node-exporter.service >/dev/null 2>&1; then
        log "  node_exporter enabled (prometheus-node-exporter.service)"
    else
        warn "node_exporter installed but NOT enabled -- clones will not answer on :9100"
    fi
}

# ── qemu-guest-agent ───────────────────────────────────────────────────────
# Every cluster VM is a clone of this golden, and without the agent libvirt
# sees nothing inside it: no address from virsh domifaddr, no fs freeze for a
# consistent snapshot, and no clean shutdown (a host shutdown once sat for the
# whole libvirt-guests timeout, 2026-08-21). It was installed from
# kube-cluster's cloud-init bootcmd, which offline blocked sshd for twelve
# minutes; here it comes from the darksite like every other package.
install_guest_agent() {
    if [[ "$PM" == "dnf" ]]; then
        _dnf install -y qemu-guest-agent || warn "qemu-guest-agent did not install"
    else
        _apt install -y --no-install-recommends qemu-guest-agent || warn "qemu-guest-agent did not install"
    fi
    if command -v qemu-ga >/dev/null 2>&1; then
        systemctl enable qemu-guest-agent.service ||
            warn "qemu-guest-agent installed but did not enable"
        systemctl is-enabled qemu-guest-agent.service >/dev/null 2>&1 &&
            log "qemu-guest-agent installed and enabled"
    else
        warn "no qemu-ga binary -- libvirt will not see inside the clones"
    fi
}

# _node_time_source — use the hypervisor for time (NTP_SERVER, passed by
# kube-cluster) instead of the distro's public pool, which an offline node can
# never reach. The golden is sealed with it, so every clone inherits it.
_node_time_source() {
    [[ -n "${NTP_SERVER:-}" ]] || return 0
    local conf=/etc/chrony.conf
    [[ -f "$conf" ]] || conf=/etc/chrony/chrony.conf # Debian and Ubuntu
    if [[ ! -f "$conf" ]]; then
        # Debian's and Ubuntu's cloud images keep time with systemd-timesyncd,
        # not chrony, and this function used to warn and leave them on the
        # public pool: every Debian node sent NTP out of an offline host
        # (deb-4-k8s, build 155, 2026-09-28). FallbackNTP= empty so a host
        # that does not answer is not replaced by the distro's pool.
        # The unit FILE, not `systemctl cat`: that needs a running manager
        # and answers "no" in a chroot or container.
        if [[ -f /usr/lib/systemd/system/systemd-timesyncd.service || -f /lib/systemd/system/systemd-timesyncd.service ]]; then
            install -d -m 0755 /etc/systemd/timesyncd.conf.d
            printf '[Time]\nNTP=%s\nFallbackNTP=\n' "$NTP_SERVER" >/etc/systemd/timesyncd.conf.d/kldload.conf
            grep -qx "NTP=${NTP_SERVER}" /etc/systemd/timesyncd.conf.d/kldload.conf ||
                die "timesyncd drop-in did not land"
            systemctl restart systemd-timesyncd ||
                warn "systemd-timesyncd did not restart; the new time source applies from the next boot"
            log "time source: ${NTP_SERVER} (the host, via systemd-timesyncd)"
            return 0
        fi
        warn "neither chrony nor systemd-timesyncd -- time source left as it is"
        return 0
    fi
    # Comment out every other source, keep the host's own line: running this
    # twice must not stack comments or duplicate the server.
    awk -v keep="server ${NTP_SERVER} iburst" '
        $0 == keep { print; next }
        /^(pool|server) / { print "# kldload: host is the time source -- " $0; next }
        { print }' "$conf" >"${conf}.kldload" && mv -f "${conf}.kldload" "$conf"
    grep -qxF "server ${NTP_SERVER} iburst" "$conf" || echo "server ${NTP_SERVER} iburst" >>"$conf"
    systemctl restart chronyd 2>/dev/null || systemctl restart chrony 2>/dev/null ||
        warn "chrony did not restart; the new time source applies from the next boot"
    log "time source: ${NTP_SERVER} (the host)"
}

# _node_cluster_routes — pod addresses never leave through the default route.
#
# A node that has not started Cilium yet has nothing that knows a pod address,
# so a packet to one follows the default route out of the host: during a
# control-plane join one packet went to metrics-server's pod that way (6-full
# and 4-k8s offline rebuilds, build 155, 2026-09-28). An unreachable route for
# the pod range fails it locally instead; Cilium's per-node pod routes are more
# specific than this /16, so the cluster is unaffected once Cilium runs.
#
# NOT the Service range: 10.96.0.0/12 covers 10.96-10.111, where operators put
# LANs (the bench LAN is 10.100.10.0/24), and a route over it cut every node off
# from them. The ClusterIP leak it was meant to stop (350-413 packets per
# rebuild, the aggregator dialling metrics-server) wants aggregator routing
# instead -- open work.
#
# The range is kube-init's default POD_CIDR; a cluster built with another
# passes the same variable here. Installed into the golden as a unit ordered
# before kubelet, so every clone has the route from boot.
_node_cluster_routes() {
    # The POD range only. The Service range was here too, and 10.96.0.0/12 is
    # 10.96-10.111: it swallowed the operator's own LAN (10.100.10.0/24), so
    # every node lost every LAN host that no more specific route covered
    # (review, 2026-09-28, before it shipped). Service traffic before Cilium
    # is up is the API server's aggregator dialling a ClusterIP; the fix for
    # that is aggregator routing (to endpoints, i.e. pod addresses, which the
    # route below does cover), not a route over a range people use for LANs.
    local pod="${POD_CIDR:-10.244.0.0/16}"
    install -d -m 0755 /etc/systemd/system
    cat >/etc/systemd/system/kldload-cluster-routes.service <<UNIT
# kldload kube-setup: pod addresses never leave via the default route before
# Cilium is running on this node. Read by systemd at boot; missing, a joining
# node leaks pod traffic to its gateway.
[Unit]
Description=kldload: the pod range is unreachable until Cilium routes it
After=network.target
Before=kubelet.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/ip route replace unreachable ${pod}

[Install]
WantedBy=multi-user.target
UNIT
    systemctl daemon-reload
    systemctl enable kldload-cluster-routes.service ||
        die "kldload-cluster-routes.service did not enable -- joining nodes would leak cluster traffic"
    systemctl is-enabled kldload-cluster-routes.service >/dev/null 2>&1 ||
        die "kldload-cluster-routes.service is not enabled after enabling it"
    log "pod range ${pod} unreachable until Cilium routes it (kldload-cluster-routes.service)"
}

main() {
    log "Setting up Kubernetes node on $(hostname)"
    echo ""

    _darksite_repo
    _node_time_source
    _node_cluster_routes
    install_guest_agent

    setup_kernel
    setup_zfs_for_k8s
    install_containerd
    install_k8s_packages
    install_helm
    install_cilium_cli
    install_node_exporter

    # Every image the cluster will run goes INTO the golden, so no clone
    # fetches one: the lock's list (charts, manifests, kube-vip) and kubeadm's
    # own for the kubeadm installed here. The bundle's tarballs load first;
    # anything still absent is pulled and counted.
    #
    # This used to be `kubeadm config images pull` plus crictl pull of the
    # Cilium lines and two hardcoded MetalLB 0.14.9 images -- all from the
    # public registries, under a log line that said "darksite" (2026-09-27).
    if compgen -G '/root/darksite/k8s-images/*.tar' >/dev/null; then
        log "Loading container images from the darksite..."
        kube-load-images /root/darksite/k8s-images ||
            warn "kube-load-images reported failures -- the count below says which images are missing"
    fi
    local _have _img _n=0 _got=0 _pulled=0 _missing=() _imgs=()
    _have="$(ctr -n k8s.io images ls -q 2>/dev/null)" || _have=""
    mapfile -t _imgs < <({
        sed -n 's/^IMAGE=//p' "$_k8s_lock" 2>/dev/null || true # swallow: no lock on a hand-run; kubeadm's list still applies
        kubeadm config images list --kubernetes-version "$(kubeadm version -o short)" 2>/dev/null ||
            true # swallow: an unreadable kubeadm list shows up as a short count below
    } | sort -u)
    for _img in "${_imgs[@]}"; do
        [[ -n "$_img" ]] || continue
        _n=$((_n + 1))
        if grep -qxF "$_img" <<<"$_have"; then
            _got=$((_got + 1))
        elif crictl pull "$_img" >/dev/null 2>&1; then
            _pulled=$((_pulled + 1))
        else
            _missing+=("$_img")
        fi
    done
    log "container images: ${_got} of ${_n} from the darksite, ${_pulled} pulled from the internet, ${#_missing[@]} missing"
    ((${#_missing[@]} == 0)) || warn "NOT in the golden, clones will pull these: ${_missing[*]}"

    # Write DHCP networking config for clones. This runs INSIDE the golden VM
    # so the config is baked into the filesystem before the seal. Previous
    # approach of writing via SSH during the seal failed silently.
    log "Configuring clone networking (DHCP with MAC-based client-id)..."

    # systemd-networkd — ClientIdentifier=mac prevents DHCP collision on clones
    mkdir -p /etc/systemd/network
    cat >/etc/systemd/network/10-dhcp.network <<'NETD'
[Match]
Name=en* eth*

[Network]
DHCP=yes

[DHCP]
UseDomains=yes
ClientIdentifier=mac
NETD
    # ONE DHCP client per NIC. Where NetworkManager already owns the
    # interface (the whole RPM family), enabling networkd as well ran two
    # clients on enp1s0: every clone held two addresses, and WireGuard
    # roamed its endpoint to the one nothing had recorded, so the estate
    # said "not on the mesh" for a peer that was handshaking.
    # HISTORY: onyx, 2026-09-22, a k8s-golden clone with 192.168.122.197
    # (networkd) and .200 (NetworkManager, replaying the golden's lease
    # file). NM alone, with the MAC client-id below: one address, the right
    # endpoint. The non-NM branch is unchanged and unverified here -- the
    # estate lifecycle now checks for exactly one address on every clone.
    if systemctl is-enabled NetworkManager >/dev/null 2>&1; then
        # swallow: the sockets are absent on images that never shipped networkd
        systemctl disable systemd-networkd.service systemd-networkd.socket >/dev/null 2>&1 || true
        rm -f /etc/systemd/network/10-dhcp.network
        log "  NetworkManager owns the NIC -- systemd-networkd left disabled"
    else
        # swallow: networkd absent means the ifupdown/dhclient paths below carry it
        systemctl enable systemd-networkd 2>/dev/null || true
    fi

    # ifupdown fallback (Debian/Ubuntu only — RPM family uses NetworkManager)
    if [[ -d /etc/network ]]; then
        cat >/etc/network/interfaces <<'IFUP'
auto lo
iface lo inet loopback

allow-hotplug enp1s0
iface enp1s0 inet dhcp

allow-hotplug ens3
iface ens3 inet dhcp

allow-hotplug eth0
iface eth0 inet dhcp
IFUP
        systemctl enable networking 2>/dev/null || true
    fi

    # NetworkManager DHCP config (CentOS/RHEL/Rocky/Fedora)
    if command -v nmcli >/dev/null 2>&1; then
        # Use MAC-based DHCP client ID to prevent clone collisions
        mkdir -p /etc/NetworkManager/conf.d
        cat >/etc/NetworkManager/conf.d/99-kldload-dhcp.conf <<'NMDHCP'
[connection]
ipv4.dhcp-client-id=mac
NMDHCP
    fi

    # dhclient config — use MAC not DUID
    mkdir -p /etc/dhcp
    echo 'send dhcp-client-identifier = hardware;' >/etc/dhcp/dhclient.conf

    # dhclient fallback timer — last resort
    cat >/etc/systemd/system/dhcp-fallback.service <<'DHCPFB'
[Unit]
Description=DHCP fallback — request IP if no address after boot
After=network.target
ConditionPathExists=!/run/dhcp-fallback-done

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 10
ExecStart=/bin/bash -c 'for iface in /sys/class/net/en* /sys/class/net/eth*; do [ -d "$iface" ] || continue; dev=$(basename "$iface"); ip addr show "$dev" | grep -q "inet " && continue; dhclient -1 -v "$dev" 2>/dev/null || true; done; touch /run/dhcp-fallback-done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
DHCPFB
    systemctl enable dhcp-fallback 2>/dev/null || true

    # Aggressive DHCP: rc.local script that runs before cloud-init even starts.
    # This is the nuclear option — bring up every ethernet interface with dhclient
    # at the earliest possible boot stage, regardless of what cloud-init or
    # systemd-networkd decide to do later. Belt, suspenders, AND duct tape.
    cat >/etc/rc.local <<'RCLOCAL'
#!/bin/bash
# kldload clone networking — run dhclient on all ethernet interfaces
for iface in /sys/class/net/en* /sys/class/net/eth*; do
    [ -d "$iface" ] || continue
    dev=$(basename "$iface")
    ip link set "$dev" up 2>/dev/null
    ip addr show "$dev" | grep -q "inet " && continue
    dhclient -1 -v "$dev" 2>/dev/null &
done
exit 0
RCLOCAL
    chmod +x /etc/rc.local

    # Enable rc-local service
    systemctl enable rc-local 2>/dev/null || true

    log "Clone networking configured (baked into golden image)"

    echo ""
    _darksite_retire
    log "Kubernetes node setup complete"
    log "  kubeadm: $(kubeadm version -o short 2>/dev/null)"
    log "  kubelet: $(kubelet --version 2>/dev/null | awk '{print $2}')"
    log "  kubectl: $(kubectl version --client -o yaml 2>/dev/null | grep gitVersion | awk '{print $2}')"
    log "  helm:    $(helm version --short 2>/dev/null)"
    # The lock's pin, not `cilium version`: that asks GitHub for the stable
    # release, and an offline golden sent it out of the host (deb-4-k8s, 2026-09-28).
    log "  cilium:  ${CILIUM_CLI_VERSION} (cli, from the lock)$(command -v cilium >/dev/null 2>&1 || echo ' -- NOT INSTALLED')"
    log "  containerd: $(containerd --version 2>/dev/null | awk '{print $3}')"
    echo ""
    log "Next steps:"
    log "  Control plane: kube-init"
    log "  Worker node:   kube-join <control-plane-ip>"
}

main "$@"
