#!/usr/bin/env bash
#
# kldload-seal — strip per-VM identity from a disk image so it can be
# safely cloned, registered as a cloud golden, or shipped to a customer.
#
# Without sealing, every kexport output carries the source machine's
# /etc/machine-id, /etc/ssh/ssh_host_*, /etc/hostid, cloud-init seed
# state, journald history, etc. Each of those collides if the image
# is deployed more than once:
#   - machine-id collisions confuse systemd journal, dbus, and anything
#     keyed on the machine identity
#   - sshd presents the original's host keys, which trips
#     StrictHostKeyChecking on every client that's ever talked to the
#     source host
#   - /etc/hostid mismatch causes ZFS to refuse to import the rpool on
#     the new host (the same boot-bricking failure we hardened
#     kldload's install path against — see project_f44_cutover_findings
#     in the operator-notes archive)
#
# Sealing performs the standard sysprep sequence:
#   - truncate /etc/machine-id (regenerated by systemd-machine-id-setup
#     on next boot)
#   - remove /var/lib/dbus/machine-id
#   - remove /etc/ssh/ssh_host_* (sshd-keygen.service regenerates on
#     first boot)
#   - remove /etc/hostid (zfs-share/zfs-import services regenerate)
#   - cloud-init clean — wipe instance data + seed so first boot
#     re-attaches to whatever cloud-init datasource it finds
#   - drop a portable cloud.cfg.d snippet listing every datasource so
#     the image works on NoCloud, ConfigDrive, OpenStack, EC2, Azure,
#     OVF, etc. without manual reconfig
#   - clear journald + wtmp/btmp/lastlog so audit history doesn't ship
#     with the image
#   - leave /etc/kldload/seal.info as a forensic marker
#
# Usage:
#   kldload-seal <disk>
#   kldload-seal /dev/zvol/rpool/vms/klab-golden-debian
#
# The disk must be:
#   - a block device (zvol, partition, whole disk) OR a file
#   - NOT currently in use (not mounted, not part of an imported pool
#     on this host, not attached to a running libvirt domain)
#
# Two image shapes are handled:
#   1. Partition table + ext4/xfs/btrfs root (cloud-image / klab golden shape):
#      losetup -fP, find largest non-EFI partition, mount, sysprep,
#      unmount, detach loop.
#   2. ZFS-on-root inside a zvol (kldload-installed VM shape):
#      zpool import -fR <altroot> -N <pool>, find bootfs property,
#      mount root dataset, sysprep, export pool.
#
# Refuses to run against the live host's own root (any pool already
# imported on the host, or any disk that shadows the running rootfs).

set -euo pipefail

DISK="${1:-}"

C=$'\033[1;36m'
G=$'\033[1;32m'
Y=$'\033[33m'
R=$'\033[1;31m'
D=$'\033[2;37m'
N=$'\033[0m'

log() { printf "${C}[seal]${N} %s\n" "$*" >&2; }
warn() { printf "${Y}[seal][warn]${N} %s\n" "$*" >&2; }
die() {
    printf "${R}[seal][error]${N} %s\n" "$*" >&2
    exit 1
}

usage() {
    cat <<EOF
kldload-seal — sysprep a disk image for portable / golden deployment

Usage:  kldload-seal <disk>

  <disk>   block device (zvol/partition/whole disk) or file image to seal

The disk must be a self-contained system root. It must NOT be currently
in use by the host (not mounted, not part of an imported zpool on this
host, not attached to a running VM). The seal runs through:

  - clear /etc/machine-id
  - remove /var/lib/dbus/machine-id
  - remove /etc/ssh/ssh_host_*
  - remove /etc/hostid
  - cloud-init clean + multi-datasource config
  - clear journald history + login records
  - stamp /etc/kldload/seal.info with timestamp

Typically invoked by kexport with --seal (the default). Run directly
when you want to seal an image without converting its format.
EOF
}

[[ -n "$DISK" && "$DISK" != "-h" && "$DISK" != "--help" ]] || {
    usage
    exit 1
}
[[ -b "$DISK" || -f "$DISK" ]] || die "$DISK is not a block device or file"
[[ $EUID -eq 0 ]] || die "must run as root"

# ── Safety checks ─────────────────────────────────────────────────────
# Refuse if the disk is currently mounted anywhere on the host.
if grep -q "^${DISK}\b\|^${DISK}p[0-9]" /proc/mounts 2>/dev/null; then
    die "$DISK (or a partition of it) is currently mounted on the host — refusing"
fi

# Refuse if any zpool imported on the host has any vdev that overlaps
# this disk's partitions. (Cheap heuristic — checks names.)
if [[ "$DISK" == /dev/zvol/* ]]; then
    HOST_POOLS=$(zpool list -H -o name 2>/dev/null || true)
    for p in $HOST_POOLS; do
        if zpool status "$p" 2>/dev/null | grep -q "$(basename "$DISK")"; then
            die "$DISK is part of host-imported pool '$p' — refusing (would brick live root)"
        fi
    done
fi

# Refuse if a running libvirt domain has this disk attached.
if command -v virsh >/dev/null 2>&1; then
    if virsh list --name 2>/dev/null | while read -r vm; do
        [[ -n "$vm" ]] || continue
        virsh domblklist "$vm" 2>/dev/null | awk 'NR>2 {print $2}' | grep -qFx "$DISK" &&
            {
                echo "RUNNING: $vm"
                break
            }
    done | grep -q RUNNING; then
        die "$DISK is currently attached to a running libvirt domain — shut it down first"
    fi
fi

# ── Stage the mount ───────────────────────────────────────────────────
MNT=$(mktemp -d -p /var/tmp kldload-seal.XXXXXX)
LOOP=""
SEAL_POOL=""

cleanup() {
    set +e
    sync
    if mountpoint -q "$MNT"; then
        umount -R "$MNT" 2>/dev/null || umount -lR "$MNT" 2>/dev/null
    fi
    if [[ -n "$SEAL_POOL" ]]; then
        zpool export "$SEAL_POOL" 2>/dev/null
    fi
    if [[ -n "$LOOP" ]]; then
        losetup -d "$LOOP" 2>/dev/null
    fi
    rmdir "$MNT" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# Detect: does the disk contain a ZFS pool, or a partitioned filesystem?
# Probe via `zdb -l` on the disk itself (and partitions if any). If
# zdb finds a label, it's ZFS-on-root; otherwise treat as a partitioned
# image.
detect_shape() {
    local d="$1"
    # Probe whole disk first
    if zdb -l "$d" 2>/dev/null | grep -q "^    name:"; then
        echo "zfs:$d"
        return
    fi
    # Probe each partition
    for part in "${d}"p* "${d}"[0-9]*; do
        [[ -b "$part" ]] || continue
        if zdb -l "$part" 2>/dev/null | grep -q "^    name:"; then
            echo "zfs:$part"
            return
        fi
    done
    # No ZFS label found — assume partitioned image with FS root
    echo "fs:$d"
}

if [[ -f "$DISK" ]]; then
    # File image — loop-mount with partition scan
    LOOP=$(losetup -fP --show "$DISK")
    log "loop-attached $DISK as $LOOP"
    SHAPE=$(detect_shape "$LOOP")
    SHAPE="${SHAPE/$LOOP/$DISK}" # report nicely
    PROBE_DEV="$LOOP"
else
    SHAPE=$(detect_shape "$DISK")
    PROBE_DEV="$DISK"
fi

log "detected shape: ${SHAPE%%:*} on ${SHAPE#*:}"

# ── Mount according to shape ──────────────────────────────────────────
case "${SHAPE%%:*}" in
zfs)
    SOURCE_VDEV="${SHAPE#*:}"
    # Get the pool name from the label without importing
    POOL_NAME=$(zdb -l "$SOURCE_VDEV" 2>/dev/null | awk '/^    name:/ {gsub(/'\''/, "", $2); print $2; exit}')
    [[ -n "$POOL_NAME" ]] || die "could not read pool name from $SOURCE_VDEV"

    # If a pool of that name is already imported on the host, alias the
    # import to a different name to avoid collision
    if zpool list -H -o name 2>/dev/null | grep -qx "$POOL_NAME"; then
        SEAL_POOL="seal-${POOL_NAME}-$$"
        log "host already has pool '$POOL_NAME' imported — importing source as '$SEAL_POOL'"
        zpool import -f -R "$MNT" -N -d "$(dirname "$SOURCE_VDEV")" "$POOL_NAME" "$SEAL_POOL"
    else
        SEAL_POOL="$POOL_NAME"
        log "importing pool '$POOL_NAME' at altroot $MNT"
        zpool import -f -R "$MNT" -N -d "$(dirname "$SOURCE_VDEV")" "$POOL_NAME"
    fi

    BOOTFS=$(zpool get -H -o value bootfs "$SEAL_POOL")
    [[ -n "$BOOTFS" && "$BOOTFS" != "-" ]] || die "pool '$SEAL_POOL' has no bootfs property — cannot find root dataset"
    log "mounting bootfs $BOOTFS"
    zfs mount "$BOOTFS"
    # bootfs may have canmount=noauto; force
    if ! mountpoint -q "$MNT"; then
        zfs set canmount=on "$BOOTFS"
        zfs mount "$BOOTFS"
    fi
    [[ -d "$MNT/etc" ]] || die "$BOOTFS mounted but no /etc found at $MNT — wrong dataset?"
    ;;

fs)
    PT_DEV="${SHAPE#*:}"
    # Resolve symlinks — /dev/zvol/POOL/DS is a symlink to /dev/zdN, and
    # the kernel exposes partitions at /dev/zdNpM, not at the symlink
    # path with -p suffix. Same applies to LVM and other udev-aliased
    # block devices.
    PT_DEV_REAL=$(readlink -f "$PT_DEV")
    log "resolved $PT_DEV → $PT_DEV_REAL"

    # Find the largest non-EFI / non-BIOS-boot partition. Cloud images
    # put root on the largest partition; EFI is small (100-200 MB),
    # BIOS-boot is tiny (<5 MB). Use lsblk for reliable partition
    # enumeration — handles sdN/nvmeNnNpN/zdNpN/loopNpN consistently.
    ROOT_PART=""
    BEST_SIZE=0
    while IFS= read -r part; do
        [[ -n "$part" ]] || continue
        [[ "$part" == "$PT_DEV_REAL" ]] && continue # skip the whole-disk row
        [[ -b "$part" ]] || continue
        sz=$(blockdev --getsize64 "$part" 2>/dev/null || echo 0)
        if ((sz > BEST_SIZE)); then
            BEST_SIZE=$sz
            ROOT_PART="$part"
        fi
    done < <(lsblk -nrp -o NAME "$PT_DEV_REAL" 2>/dev/null)

    [[ -n "$ROOT_PART" ]] || die "no partitions found on $PT_DEV_REAL (lsblk -nrp showed: $(lsblk -nrp -o NAME "$PT_DEV_REAL" 2>&1 | head -5 | tr '\n' ' '))"
    log "mounting root partition $ROOT_PART ($((BEST_SIZE / 1024 / 1024)) MB) at $MNT"
    mount "$ROOT_PART" "$MNT" || die "mount $ROOT_PART failed"

    # btrfs images keep the system in subvolumes, not at the top level.
    # Fedora Cloud (F41+) mounts subvol=root as /, and var, home, boot as
    # their own subvolumes — so the top level holds four directories and
    # no /etc, and this check died "no /etc found". MakeGolden then fell
    # through to "could not seal", and web-golden shipped with its
    # machine-id and ssh host keys intact (onyx, 2026-09-03 20:56). The
    # only clue was rc=1 in the audit log.
    #
    # Find the subvolume that carries /etc, remount with it as the root,
    # and mount every other top-level subvolume at the path of the same
    # name beneath it — the guest's fstab does exactly that, and the seal
    # touches /var (dbus machine-id, cloud-init state, the journal) and
    # /home (shell history), which would otherwise be empty mountpoints
    # and silently skipped. Subvolume roots are inode 256 on btrfs; that
    # is how they are told apart from ordinary directories without
    # btrfs-progs, which a hypervisor host need not have.
    if [[ ! -d "$MNT/etc" && "$(blkid -o value -s TYPE "$ROOT_PART" 2>/dev/null)" == btrfs ]]; then
        ROOT_SUBVOL=""
        SUBVOLS=()
        for d in "$MNT"/*/; do
            d="${d%/}"
            [[ -d "$d" && "$(stat -c %i "$d")" == 256 ]] || continue
            n="$(basename "$d")"
            SUBVOLS+=("$n")
            [[ -d "$d/etc" ]] && ROOT_SUBVOL="$n"
        done
        [[ -n "$ROOT_SUBVOL" ]] ||
            die "$ROOT_PART is btrfs with no subvolume carrying /etc (top level: ${SUBVOLS[*]:-none})"
        umount "$MNT" || die "could not unmount $MNT to remount subvol=$ROOT_SUBVOL"
        mount -o "subvol=$ROOT_SUBVOL" "$ROOT_PART" "$MNT" ||
            die "mount subvol=$ROOT_SUBVOL of $ROOT_PART failed"
        for n in "${SUBVOLS[@]}"; do
            [[ "$n" == "$ROOT_SUBVOL" ]] && continue
            [[ -d "$MNT/$n" ]] || continue
            mount -o "subvol=$n" "$ROOT_PART" "$MNT/$n" ||
                die "mount subvol=$n at $MNT/$n failed"
        done
        log "btrfs: root is subvol=$ROOT_SUBVOL; mounted ${SUBVOLS[*]} beneath it"
    fi
    [[ -d "$MNT/etc" ]] || die "$ROOT_PART mounted but no /etc found — wrong partition?"
    ;;

*)
    die "unknown shape: $SHAPE"
    ;;
esac

# ── The actual sealing ────────────────────────────────────────────────
log "sealing $MNT"

# 1. machine-id — truncated, not deleted (systemd respects empty + regenerates)
: >"$MNT/etc/machine-id"
rm -f "$MNT/var/lib/dbus/machine-id"
log "  cleared /etc/machine-id"

# 2. SSH host keys — sshd-keygen.service / openssh-server first-boot regenerates
rm -f "$MNT/etc/ssh/ssh_host_"*key*
log "  removed /etc/ssh/ssh_host_* keys"

# 3. hostid — ZFS regenerates on first import operation
rm -f "$MNT/etc/hostid"
log "  removed /etc/hostid"

# 4. cloud-init — wipe seed/instance state, write portable datasource list
rm -rf "$MNT/var/lib/cloud/data" \
    "$MNT/var/lib/cloud/instance" \
    "$MNT/var/lib/cloud/instances" \
    "$MNT/var/lib/cloud/sem" 2>/dev/null
if [[ -d "$MNT/etc/cloud" ]]; then
    mkdir -p "$MNT/etc/cloud/cloud.cfg.d"
    cat >"$MNT/etc/cloud/cloud.cfg.d/99-kldload-seal.cfg" <<'CICFG'
# Written by kldload-seal — portable datasource list so this image
# auto-attaches to whichever cloud-init metadata source it finds first.
datasource_list: [ NoCloud, ConfigDrive, OpenStack, Ec2, AltCloud, OVF, None ]
CICFG
    log "  cloud-init: cleared seed + wrote portable datasource_list"
fi

# 5. journald + login records — don't ship audit history with the image
rm -rf "$MNT/var/log/journal/"* 2>/dev/null
: >"$MNT/var/log/btmp" 2>/dev/null
: >"$MNT/var/log/wtmp" 2>/dev/null
: >"$MNT/var/log/lastlog" 2>/dev/null
log "  cleared journald + wtmp/btmp/lastlog"

# 6. bash history for root + admin (defensive — should be empty on a golden
#    but if someone did a manual install we don't want to leak it)
rm -f "$MNT/root/.bash_history" "$MNT/home"/*/.bash_history 2>/dev/null

# 7. Forensic marker
mkdir -p "$MNT/etc/kldload"
cat >"$MNT/etc/kldload/seal.info" <<EOF
sealed: $(date -Iseconds)
sealed-by: kldload-seal $(date +%Y%m%d)
sealed-on: $(hostname)
source: $DISK
EOF
log "  stamped /etc/kldload/seal.info"

log "${G}seal complete${N}"

# cleanup runs from EXIT trap — unmount, export pool, detach loop
