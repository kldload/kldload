#!/usr/bin/env bash
# kube-status — comprehensive Kubernetes cluster health check
set -Eeuo pipefail
trap 'echo "kube-status: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

# Auto-elevate to root
# --help answers before the root re-exec below: asking a tool what it does
# must never need a password, and on a machine where the operator has no
# sudo rights it could not answer at all (swept 2026-09-16).
case "${1:-}" in
-h | --help)
    cat <<'USAGE'
Usage: kube-status

Print a health summary of the Kubernetes cluster this node belongs to: nodes
and their readiness, control-plane pods, and what is not running.

Takes no options. Needs root, because it reads the cluster admin kubeconfig.

Exits 1 with "No cluster available" when kubectl is missing or cannot reach an
apiserver -- which is the answer on a worker or a machine with no cluster, not
a fault.

See also: kube-init, kube-join, kube-cluster, kube-reset.
USAGE
    exit 0
    ;;
esac

if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

C="\033[1;36m"
G="\033[1;32m"
Y="\033[1;33m"
R="\033[1;31m"
W="\033[1;37m"
D="\033[0;37m"
N="\033[0m"

if ! command -v kubectl >/dev/null 2>&1 || ! kubectl cluster-info >/dev/null 2>&1; then
    echo -e "${R}[kube-status]${N} No cluster available. Is this a control plane node?" >&2
    exit 1
fi

echo -e "${C}══════════════════════════════════════════════════════════════${N}"
echo -e "${W}  Kubernetes Cluster Status                                  ${N}"
echo -e "${C}══════════════════════════════════════════════════════════════${N}"
echo ""

# Cluster info
echo -e "${Y}Cluster Info${N}"
# awk, not head: an early-exiting reader is SIGPIPE 141 under pipefail
kubectl cluster-info 2>/dev/null | awk 'NR <= 3' || echo "  kubectl cluster-info failed"
echo ""

# Nodes
echo -e "${Y}Nodes${N}"
# WHY every kubectl here has an ||: under set -e one failed call ended the
# report part-way, with nothing to say which section it stopped at.
kubectl get nodes -o wide 2>/dev/null || echo "  kubectl get nodes failed"
echo ""

# Component status
echo -e "${Y}Cilium Status${N}"
if command -v cilium >/dev/null 2>&1; then
    cilium status 2>/dev/null || echo "  Cilium CLI not responding"
else
    echo "  Cilium CLI not installed"
fi
echo ""

# System pods
echo -e "${Y}System Pods (kube-system)${N}"
kubectl get pods -n kube-system -o wide 2>/dev/null || echo "  kubectl get pods failed"
echo ""

# All namespaces summary
echo -e "${Y}All Namespaces${N}"
kubectl get ns 2>/dev/null || echo "  kubectl get ns failed"
echo ""

# Resource usage
echo -e "${Y}Node Resources${N}"
kubectl top nodes 2>/dev/null || echo "  metrics-server not installed"
echo ""

# ZFS status if available
if command -v zfs >/dev/null 2>&1; then
    echo -e "${Y}ZFS Storage${N}"
    zfs list -o name,used,avail,mountpoint 2>/dev/null | grep -E 'etcd|containerd|kubelet|NAME' || true
    echo ""
    echo -e "${Y}ZFS Snapshots (K8s related)${N}"
    # Captured first and cut with awk. `zfs list -t snapshot | grep | head -10
    # || echo None` took SIGPIPE from head on any host with more than ten, and
    # the || then printed "None" under ten snapshots (onyx, 2026-09-30).
    _snaps="$(zfs list -H -t snapshot -o name 2>/dev/null | grep -E 'kube|etcd' || true)" # grep 1: none match
    if [[ -n "$_snaps" ]]; then
        printf '%s\n' "$_snaps" | awk 'NR <= 10 { print "  " $0 } END { if (NR > 10) printf "  ... %d in all\n", NR }'
    else
        echo "  None"
    fi
    echo ""
fi

# Hubble
echo -e "${Y}Hubble${N}"
if kubectl get svc -n kube-system hubble-relay >/dev/null 2>&1; then
    echo -e "  Relay:  ${G}running${N}"
    echo -e "  UI:     kubectl port-forward -n kube-system svc/hubble-ui 12000:80"
else
    echo -e "  ${D}Not installed${N}"
fi

echo ""
echo -e "${C}══════════════════════════════════════════════════════════════${N}"
