#!/usr/bin/env bash
# kube-status — comprehensive Kubernetes cluster health check
set -euo pipefail

# Auto-elevate to root
if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

C="\033[1;36m"; G="\033[1;32m"; Y="\033[1;33m"; R="\033[1;31m"
W="\033[1;37m"; D="\033[0;37m"; N="\033[0m"

if ! command -v kubectl >/dev/null 2>&1 || ! kubectl cluster-info >/dev/null 2>&1; then
  echo -e "${R}[kube-status]${N} No cluster available. Is this a control plane node?"
  exit 1
fi

echo -e "${C}══════════════════════════════════════════════════════════════${N}"
echo -e "${W}  Kubernetes Cluster Status                                  ${N}"
echo -e "${C}══════════════════════════════════════════════════════════════${N}"
echo ""

# Cluster info
echo -e "${Y}Cluster Info${N}"
kubectl cluster-info 2>/dev/null | head -3
echo ""

# Nodes
echo -e "${Y}Nodes${N}"
kubectl get nodes -o wide 2>/dev/null
echo ""

# Component status
echo -e "${Y}Cilium Status${N}"
if command -v cilium >/dev/null 2>&1; then
  cilium status 2>/dev/null || echo "  Cilium CLI not responding"
else
  echo "  Cilium CLI not installed"
fi
echo ""

# System pods
echo -e "${Y}System Pods (kube-system)${N}"
kubectl get pods -n kube-system -o wide 2>/dev/null
echo ""

# All namespaces summary
echo -e "${Y}All Namespaces${N}"
kubectl get ns 2>/dev/null
echo ""

# Resource usage
echo -e "${Y}Node Resources${N}"
kubectl top nodes 2>/dev/null || echo "  metrics-server not installed"
echo ""

# ZFS status if available
if command -v zfs >/dev/null 2>&1; then
  echo -e "${Y}ZFS Storage${N}"
  zfs list -o name,used,avail,mountpoint 2>/dev/null | grep -E 'etcd|containerd|kubelet|NAME' || true
  echo ""
  echo -e "${Y}ZFS Snapshots (K8s related)${N}"
  zfs list -t snapshot 2>/dev/null | grep -E 'kube|etcd|NAME' | head -10 || echo "  None"
  echo ""
fi

# Hubble
echo -e "${Y}Hubble${N}"
if kubectl get svc -n kube-system hubble-relay >/dev/null 2>&1; then
  echo -e "  Relay:  ${G}running${N}"
  echo -e "  UI:     kubectl port-forward -n kube-system svc/hubble-ui 12000:80"
else
  echo -e "  ${D}Not installed${N}"
fi

echo ""
echo -e "${C}══════════════════════════════════════════════════════════════${N}"
