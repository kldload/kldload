}

# ── 15: Pod + DNS Test ────────────────────────────────────────
demo_pod_dns() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Pod Scheduling + DNS — cluster fundamentals${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}The most basic proof: can the scheduler place a pod, and can that${N}"
  echo -e "  ${D}pod resolve DNS? If these work, the control plane, kubelet, Cilium${N}"
  echo -e "  ${D}CNI, and CoreDNS are all functioning correctly.${N}"

  # ── Step 1: Schedule a pod ───────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Schedule a test pod${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Creating a busybox pod. The scheduler picks a node, kubelet pulls${N}"
  echo -e "  ${D}the image, and Cilium's CNI plugin configures the pod's network${N}"
  echo -e "  ${D}namespace with eBPF programs attached to the veth pair.${N}"
  echo ""
  _kctl run test-pod --image=busybox --restart=Never --command -- sleep 30 2>/dev/null || true
  sleep 5
  _kctl get pod test-pod -o wide

  # ── Step 2: DNS resolution ──────────────────────────────────
