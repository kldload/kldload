  echo -e "  DNS resolution: ${G}kubernetes.default resolves${N}"
  echo -e "  CoreDNS:        ${G}running${N}"
  echo ""
  echo -e "  ${D}What this proves: the full chain works — API server, scheduler,${N}"
  echo -e "  ${D}kubelet, Cilium CNI, CoreDNS. A pod can be created, placed,${N}"
  echo -e "  ${D}networked, and resolve service names. Everything else builds on this.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
