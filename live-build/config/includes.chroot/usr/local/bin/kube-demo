#!/usr/bin/env bash
# kldload 1.0.4 — Kubernetes Demo
# Shows the full K8s stack running on ZFS instant clones
# Usage: kube-demo [--no-pause]
set -uo pipefail

if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

KUBE_DEMO_PAUSE=1
for _arg in "$@"; do
  case "$_arg" in
    --no-pause|--nopause|-n) KUBE_DEMO_PAUSE=0 ;;
  esac
done

R="\033[1;31m"; G="\033[1;32m"; Y="\033[1;33m"; C="\033[1;36m"; W="\033[1;37m"; D="\033[0;37m"; N="\033[0m"

# ── Detect cluster ─────────────────────────────────────────
CP_IP=""
_find_cp() {
  # Check if we have a local kubeconfig (host is the management plane)
  if [[ -f /root/.kube/config ]]; then
    export KUBECONFIG=/root/.kube/config
    # Determine CP IP for SSH commands — prefer WireGuard
    if ip link show wg-mgmt >/dev/null 2>&1; then
      CP_IP="10.250.0.1"
    else
      # Fall back to /etc/hosts or DHCP lease lookup
      CP_IP="$(getent hosts kldload-cp 2>/dev/null | awk '{print $1}')" || true
      if [[ -z "$CP_IP" ]]; then
        for vm in $(virsh list --name 2>/dev/null | grep -v '^$'); do
          local mac ip
          mac="$(virsh domiflist "$vm" 2>/dev/null | awk '/bridge/ {print $5}')"
          ip="$(virsh net-dhcp-leases default 2>/dev/null | grep "$mac" | awk '{print $5}' | cut -d/ -f1)"
          [[ -n "$ip" ]] && CP_IP="$ip" && break
        done
      fi
    fi
    [[ -n "$CP_IP" ]] && return 0
  fi
  # Check if we ARE the control plane
  if [[ -f /etc/kubernetes/admin.conf ]]; then
    CP_IP="localhost"
    export KUBECONFIG=/etc/kubernetes/admin.conf
    return 0
  fi
  return 1
}

# Run kubectl — always local (kubeconfig points to CP API)
_kctl() {
  if command -v kubectl >/dev/null 2>&1 && [[ -f "${KUBECONFIG:-/root/.kube/config}" ]]; then
    kubectl "$@" 2>/dev/null
  elif [[ "$CP_IP" == "localhost" ]]; then
    kubectl "$@" 2>/dev/null
  else
    sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 \
      "root@${CP_IP}" "kubectl $*" 2>/dev/null
  fi
}

_ssh_cp() {
  if [[ "$CP_IP" == "localhost" ]]; then
    bash -c "$*" 2>/dev/null
  else
    sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 \
      "root@${CP_IP}" "$*" 2>/dev/null
  fi
}

pause() {
  if [[ "$KUBE_DEMO_PAUSE" -eq 1 ]]; then
    echo ""; echo -e "${D}Press Enter...${N}"; read -r
  else
    echo ""
  fi
}

# ── Smart helpers — auto-detect where to run commands ─────────
# These try: host CLI → kubectl exec → SSH to CP, in that order.
# Works on both the KVM host and directly on the control plane.

# Run a command inside the cilium agent pod
_cilium() {
  _kctl exec -n kube-system ds/cilium -c cilium-agent -- "$@" 2>/dev/null
}

# cilium-dbg inside the pod (BPF maps, endpoint list, status, monitor)
_cilium_dbg() {
  _cilium cilium-dbg "$@"
}

# cilium CLI — try host first (connectivity test, hubble enable), then CP
_cilium_cli() {
  if command -v cilium >/dev/null 2>&1; then
    cilium "$@" 2>/dev/null && return 0
  fi
  _ssh_cp "cilium $*" 2>/dev/null
}

# hubble CLI — needs port-forward to hubble-relay
_hubble_pf_pid=""
_hubble_start() {
  _kctl port-forward -n kube-system svc/hubble-relay 4245:80 >/dev/null 2>&1 &
  _hubble_pf_pid=$!
  sleep 2
}
_hubble_stop() {
  [[ -n "$_hubble_pf_pid" ]] && kill "$_hubble_pf_pid" 2>/dev/null || true
  _hubble_pf_pid=""
}
_hubble() {
  if command -v hubble >/dev/null 2>&1; then
    hubble --server localhost:4245 "$@" 2>/dev/null && return 0
  fi
  # Fallback: raw eBPF events via cilium-dbg monitor
  _cilium_dbg monitor "$@" 2>/dev/null
}

header() {
  clear
  local nodes
  nodes="$(_kctl get nodes --no-headers 2>/dev/null | wc -l)"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}   kldload 1.0.4 — Kubernetes on ZFS                        ${N}"
  echo -e "${D}   ${nodes} nodes • Cilium eBPF • Hubble • MetalLB • ZFS CSI       ${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
}

menu() {
  header
  echo -e "  ${C}── Platform ────────────────────────────────────────────${N}"
  echo -e "  ${G} p${N}  Host platform (OS, kernel, Secure Boot, ZFS, hardware)"
  echo -e "  ${G} z${N}  ZFS live demo (snapshot, corrupt, rollback, clone)"
  echo -e "  ${G} v${N}  VM lifecycle (golden image, clone, boot, destroy, rebuild)"
  echo ""
  echo -e "  ${C}── Cluster ─────────────────────────────────────────────${N}"
  echo -e "  ${G} 1${N}  Cluster overview (nodes, versions, IPs)"
  echo -e "  ${G} 2${N}  ZFS clone proof (clone times + disk cost)"
  echo -e "  ${G} 3${N}  Add 2 more worker nodes (live scale-out)"
  echo ""
  echo -e "  ${C}── Networking (Cilium + CoreDNS) ──────────────────────${N}"
  echo -e "  ${G} 4${N}  Cilium status + eBPF maps"
  echo -e "  ${G} 5${N}  Cilium connectivity test (pod-to-pod, pod-to-svc)"
  echo -e "  ${G} 6${N}  Hubble — live network flows + DNS queries"
  echo -e "  ${G} 7${N}  CoreDNS — verify cluster DNS + cross-namespace"
  echo -e "  ${G} 8${N}  Network policy — block + allow traffic demo"
  echo ""
  echo -e "  ${C}── Services ────────────────────────────────────────────${N}"
  echo -e "  ${G} 9${N}  MetalLB — deploy LoadBalancer service"
  echo -e "  ${G}10${N}  Gateway API — deploy HTTP ingress"
  echo ""
  echo -e "  ${C}── Storage (ZFS CSI) ──────────────────────────────────${N}"
  echo -e "  ${G}11${N}  Create PVC — watch ZFS dataset appear"
  echo -e "  ${G}12${N}  Snapshot PV + restore from snapshot"
  echo -e "  ${G}13${N}  Database PVC (8K recordsize) + write test"
  echo ""
  echo -e "  ${C}── Workloads ───────────────────────────────────────────${N}"
  echo -e "  ${G}14${N}  Deploy nginx fleet (3 replicas + LoadBalancer)"
  echo -e "  ${G}15${N}  Pod scheduling + DNS resolution"
  echo -e "  ${G}16${N}  Scale test — 20 pods across all workers"
  echo -e "  ${G}17${N}  Rolling update (nginx → httpd, zero downtime)"
  echo ""
  echo -e "  ${C}── Resilience ──────────────────────────────────────────${N}"
  echo -e "  ${G}18${N}  Kill a pod — watch self-healing"
  echo -e "  ${G}19${N}  Drain a worker node — watch pod migration"
  echo -e "  ${G}20${N}  Node snapshot + rollback (ZFS time travel)"
  echo -e "  ${G}21${N}  Replace 2 workers — destroy + re-clone (nodes are cattle)"
  echo ""
  echo -e "  ${C}── eBPF Internals (no userland, no sidecars) ──────────${N}"
  echo -e "  ${G}22${N}  eBPF deep dive — loaded programs, maps, tc filters"
  echo -e "  ${G}23${N}  Zero sidecar proof — no proxies, no iptables, no kube-proxy"
  echo -e "  ${G}24${N}  Kernel datapath trace — live packet through eBPF"
  echo ""
  echo -e "  ${C}── Full Audit ──────────────────────────────────────────${N}"
  echo -e "  ${G}99${N}  Smoke test (all checks)"
  echo ""
  echo -e "  ${R} 0${N}  Clean up demo resources (keep cluster)"
  echo -e "  ${R}00${N}  Destroy EVERYTHING (VMs, zvols, cluster)"
  echo -e "  ${R} q${N}  Quit"
  echo ""
  echo -ne "${W}  Select: ${N}"
}

# ── 1: Cluster Overview ───────────────────────────────────────
demo_overview() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Cluster Overview — what's running and how it got here${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}This is a production Kubernetes cluster running on bare metal.${N}"
  echo -e "  ${D}Every node is a ZFS clone of a single golden image. The entire${N}"
  echo -e "  ${D}network stack — routing, NAT, load balancing, policy — runs in${N}"
  echo -e "  ${D}eBPF inside the kernel. No kube-proxy. No iptables.${N}"

  # ── Step 1: Nodes ─────────────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Cluster nodes${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Each node below was cloned from a golden ZFS image in <100ms.${N}"
  echo -e "  ${D}No ISO installs, no Packer builds, no Terraform provisioning.${N}"
  echo ""
  _kctl get nodes -o wide

  # ── Step 2: System pods ───────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Infrastructure pods${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}All cluster infrastructure runs as pods — Cilium agents on every${N}"
  echo -e "  ${D}node, CoreDNS for service discovery, Hubble for observability,${N}"
  echo -e "  ${D}MetalLB for real LoadBalancer IPs on bare metal.${N}"
  echo ""
  _kctl get pods -A -o wide | head -25

  # ── Step 3: Namespaces ────────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: Namespaces${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Standard Kubernetes namespace layout. kube-system houses the${N}"
  echo -e "  ${D}CNI (Cilium), DNS (CoreDNS), and observability (Hubble).${N}"
  echo ""
  _kctl get ns

  # ── Step 4: Versions ──────────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 4: Component versions${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}The full stack — Kubernetes API, Cilium eBPF, Hubble relay,${N}"
  echo -e "  ${D}MetalLB speaker. All deployed from the golden image.${N}"
  echo ""
  local kver cver
  kver="$(_kctl version -o yaml 2>/dev/null | grep gitVersion | head -1 | awk '{print $2}')"
  cver="$(_ssh_cp 'cilium version --client 2>/dev/null | head -1')"
  echo -e "  Kubernetes:  ${G}${kver}${N}"
  echo -e "  Cilium CLI:  ${G}${cver}${N}"
  echo -e "  Hubble:      ${G}$(_kctl get deploy -n kube-system hubble-relay -o jsonpath='{.status.readyReplicas}' 2>/dev/null)/1 ready${N}"
  echo -e "  MetalLB:     ${G}$(_kctl get deploy -n metallb-system metallb-controller -o jsonpath='{.status.readyReplicas}' 2>/dev/null)/1 ready${N}"

  local node_count ready_count
  node_count="$(_kctl get nodes --no-headers | wc -l)"
  ready_count="$(_kctl get nodes --no-headers | grep -c ' Ready')"

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Production Kubernetes on bare metal — powered by ZFS + eBPF${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Nodes:          ${G}${ready_count}/${node_count} Ready${N}"
  echo -e "  CNI:            ${G}Cilium (eBPF, replaces kube-proxy entirely)${N}"
  echo -e "  Ingress:        ${G}Cilium Gateway API (no nginx, no HAProxy)${N}"
  echo -e "  Load Balancer:  ${G}MetalLB (L2 mode, real external IPs)${N}"
  echo -e "  Observability:  ${G}Hubble (eBPF-native flow visibility)${N}"
  echo -e "  Backing store:  ${G}ZFS zvols (instant clone, ~75ms per node)${N}"
  echo ""
  echo -e "  ${D}What this proves: a full production K8s cluster can be deployed${N}"
  echo -e "  ${D}from a single golden image in minutes, not hours. Every node is${N}"
  echo -e "  ${D}disposable. Every component is kernel-native or pod-native.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── p: Platform ────────────────────────────────────────────────
demo_platform() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Host Platform — the bare metal under everything${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Before Kubernetes, before Cilium, before any of it — there's${N}"
  echo -e "  ${D}a physical machine running ZFS on root with Secure Boot.${N}"
  echo -e "  ${D}This is what that looks like.${N}"
  pause

  # ── Step 1: Operating system ─────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Operating system${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}The host OS was installed by kldload from a single USB stick.${N}"
  echo -e "  ${D}ZFS on root, LUKS optional, all offline — no internet required.${N}"
  echo ""
  echo -e "  ${W}Distro:${N}       $(cat /etc/redhat-release 2>/dev/null || cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d= -f2 | tr -d '"' || echo "unknown")"
  echo -e "  ${W}Kernel:${N}       $(uname -r)"
  echo -e "  ${W}Architecture:${N}  $(uname -m)"

  # ── Step 2: Secure Boot ──────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Secure Boot + MOK${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Secure Boot verifies the boot chain. MOK (Machine Owner Key)${N}"
  echo -e "  ${D}lets us sign the ZFS kernel module so it loads with Secure Boot.${N}"
  echo ""
  local sb_state
  sb_state="$(mokutil --sb-state 2>/dev/null || echo "unknown")"
  if echo "$sb_state" | grep -qi "enabled"; then
    echo -e "  ${W}Secure Boot:${N}  ${G}ENABLED${N}"
  else
    echo -e "  ${W}Secure Boot:${N}  ${Y}${sb_state}${N}"
  fi
  local mok_count
  mok_count="$(mokutil --list-enrolled 2>/dev/null | grep -c 'CN=kldload' || echo 0)"
  echo -e "  ${W}MOK keys:${N}     ${G}${mok_count} kldload keys enrolled${N}"

  # ── Step 3: Hardware ─────────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: Hardware${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}The physical machine running all of this. ZFS loves RAM for${N}"
  echo -e "  ${D}its ARC cache, and NVMe for low-latency zvol I/O.${N}"
  echo ""
  echo -e "  ${W}CPU:${N}          $(nproc) cores — $(grep 'model name' /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | xargs || echo "unknown")"
  echo -e "  ${W}RAM:${N}          $(free -h | awk '/Mem:/ {print $2}')"
  echo -e "  ${W}Disk:${N}         $(lsblk -dno NAME,SIZE,MODEL /dev/nvme0n1 2>/dev/null || lsblk -dno NAME,SIZE,MODEL /dev/sda 2>/dev/null || echo "unknown")"

  # ── Step 4: ZFS ──────────────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 4: ZFS — the foundation${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}ZFS provides copy-on-write, checksums, compression, snapshots,${N}"
  echo -e "  ${D}and instant clones. Every VM disk in this cluster is a ZFS zvol.${N}"
  echo -e "  ${D}Every snapshot and clone is a metadata operation — milliseconds.${N}"
  echo ""
  echo -e "  ${W}ZFS version:${N}  $(zfs version 2>/dev/null | head -1 || echo "not installed")"
  echo -e "  ${W}Pool:${N}"
  zpool status -x 2>/dev/null || echo "  no pools"
  echo ""
  echo -e "  ${W}Datasets (top-level):${N}"
  zfs list -d1 -o name,used,avail,mountpoint rpool 2>/dev/null | head -10
  echo ""
  echo -e "  ${W}VM zvols:${N}"
  zfs list -o name,used,refer,volsize -r rpool/vms -t volume 2>/dev/null | head -10 || echo "  none"
  echo ""
  echo -e "  ${W}Snapshots:${N}    $(zfs list -t snapshot -H 2>/dev/null | wc -l) total"
  echo -e "  ${W}Compression:${N}  $(zfs get -H -o value compressratio rpool 2>/dev/null || echo "n/a")"

  # ── Step 5: WireGuard ────────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 5: WireGuard mesh${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}WireGuard provides encrypted tunnels between K8s nodes.${N}"
  echo -e "  ${D}API traffic, kubelet heartbeats, and pod traffic all flow${N}"
  echo -e "  ${D}over encrypted WireGuard links inside the cluster.${N}"
  echo -e "  ${D}The KVM host sits outside the mesh — it manages VMs over virbr0.${N}"
  echo ""
  echo -e "  ${W}Host (KVM hypervisor):${N}"
  if command -v wg >/dev/null 2>&1; then
    local wg_ifaces
    wg_ifaces="$(wg show interfaces 2>/dev/null || true)"
    if [[ -n "$wg_ifaces" ]]; then
      echo -e "  ${G}Active interfaces: ${wg_ifaces}${N}"
      wg show 2>/dev/null | head -15
    else
      echo -e "  ${D}  No tunnels (host manages VMs over bridge, not WireGuard)${N}"
    fi
  else
    echo -e "  ${D}  WireGuard not active on host (expected — host is hypervisor)${N}"
  fi
  echo ""
  echo -e "  ${W}Inside the cluster (control plane):${N}"
  _ssh_cp 'wg show 2>/dev/null | head -20 || echo "  WireGuard not configured on CP"'

  # ── Step 6: kube-proxy status ────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 6: kube-proxy replacement${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}In a traditional cluster, kube-proxy writes hundreds of iptables${N}"
  echo -e "  ${D}rules to implement Services. Cilium replaces all of that with${N}"
  echo -e "  ${D}eBPF maps in the kernel — faster, observable, and debuggable.${N}"
  echo ""
  local kp_pods
  kp_pods="$(_kctl get pods -n kube-system -l k8s-app=kube-proxy --no-headers 2>/dev/null | wc -l)"
  if [[ "$kp_pods" -eq 0 ]]; then
    echo -e "  ${G}kube-proxy: NOT RUNNING (replaced by Cilium eBPF)${N}"
  else
    echo -e "  ${R}kube-proxy: ${kp_pods} pods running${N}"
  fi
  local ipt_rules
  ipt_rules="$(iptables -L 2>/dev/null | wc -l || echo 0)"
  echo -e "  ${W}iptables rules:${N} ${ipt_rules} (near-zero = eBPF datapath)"

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Platform: bare metal to production Kubernetes${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Boot chain:     ${G}UEFI → Secure Boot → ZFS on root${N}"
  echo -e "  Filesystem:     ${G}ZFS (checksums, compression, instant clones)${N}"
  echo -e "  Encryption:     ${G}WireGuard mesh between all nodes${N}"
  echo -e "  Networking:     ${G}Cilium eBPF (no kube-proxy, no iptables)${N}"
  echo ""
  echo -e "  ${D}One USB stick installs the host. One command deploys the cluster.${N}"
  echo -e "  ${D}Everything from firmware to pods — auditable, reproducible, offline.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── v: VM Lifecycle Demo ────────────────────────────────────────
demo_vm_lifecycle() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  VM Lifecycle — how ZFS clones replace traditional imaging${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Traditional VM deployment: download image, copy 40GB, boot.${N}"
  echo -e "  ${D}ZFS clone deployment: point at golden snapshot, done.${N}"
  echo -e "  ${D}Same result. Milliseconds instead of minutes.${N}"
  pause

  # ── Step 1: The golden image ──────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: The golden image${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}One sealed VM image. CentOS Stream 9 + containerd + kubeadm.${N}"
  echo -e "  ${D}Built once. Every K8s node is a clone of this.${N}"
  echo ""
  zfs list -o name,used,refer,volsize rpool/vms/k8s-golden 2>/dev/null
  echo ""
  echo -e "  ${W}Golden snapshots (each clone comes from one of these):${N}"
  zfs list -t snapshot -o name,used,refer rpool/vms/k8s-golden 2>/dev/null | grep -E "NAME|golden|clone" | head -6

  # ── Step 2: Current cluster — all clones ──────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Every VM is a clone — look at the disk cost${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}The golden image is 3.2GB. Each clone stores ONLY the blocks${N}"
  echo -e "  ${D}that changed since cloning. Most of the disk is shared.${N}"
  echo ""
  echo -e "  ${W}  VM               UNIQUE DATA   TOTAL VISIBLE   PROVISIONED${N}"
  echo -e "  ────────────────   ───────────   ─────────────   ───────────"
  for vm in k8s-golden kldload-cp kldload-w-1 kldload-w-2 kldload-w-3; do
    local used refer volsize
    used="$(zfs get -Hp -o value used rpool/vms/${vm} 2>/dev/null)"
    refer="$(zfs get -Hp -o value refer rpool/vms/${vm} 2>/dev/null)"
    volsize="$(zfs get -Hp -o value volsize rpool/vms/${vm} 2>/dev/null)"
    printf "  %-18s ${G}%-13s${N} %-15s %-11s\n" \
      "$vm" \
      "$(numfmt --to=iec $used 2>/dev/null || echo $used)" \
      "$(numfmt --to=iec $refer 2>/dev/null || echo $refer)" \
      "$(numfmt --to=iec $volsize 2>/dev/null || echo $volsize)"
  done
  echo ""
  local total_used total_provisioned
  total_used="$(zfs get -Hp -o value used rpool/vms 2>/dev/null)"
  total_provisioned=$((40 * 1024 * 1024 * 1024 * 5))  # 5 VMs * 40G each
  echo -e "  ${W}Total actual disk:${N}     ${G}$(numfmt --to=iec $total_used 2>/dev/null)${N}"
  echo -e "  ${W}Total provisioned:${N}     ${Y}$(numfmt --to=iec $total_provisioned 2>/dev/null)${N} (if these were full copies)"
  echo -e "  ${W}Space saved:${N}           ${G}~$(( (total_provisioned - total_used) * 100 / total_provisioned ))%${N}"

  # ── Step 3: Clone a new VM — watch the timer ──────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: Clone a new VM from golden — watch the time${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}This is a 40GB virtual disk. Traditional copy = minutes.${N}"
  echo -e "  ${D}ZFS clone = pointer change.${N}"
  echo ""

  # Find a golden snapshot to clone from
  local golden_snap
  golden_snap="$(zfs list -t snapshot -H -o name rpool/vms/k8s-golden 2>/dev/null | grep golden | head -1)"
  if [[ -z "$golden_snap" ]]; then
    golden_snap="$(zfs list -t snapshot -H -o name rpool/vms/k8s-golden 2>/dev/null | head -1)"
  fi

  if [[ -n "$golden_snap" ]]; then
    echo -ne "  ${Y}Cloning 40GB VM disk...${N} "
    local vm_start vm_end
    vm_start=$(date +%s%N)
    zfs clone -o volsize=40G "${golden_snap}" rpool/vms/demo-vm 2>/dev/null
    vm_end=$(date +%s%N)
    local ms=$(( (vm_end - vm_start) / 1000000 ))
    echo -e "${G}done in ${ms}ms${N}"
    echo ""
    echo -e "  ${D}A 40GB disk cloned in ${ms} milliseconds.${N}"
    echo -e "  ${D}Try that with qemu-img copy or dd.${N}"
    echo ""
    zfs list -o name,used,refer,volsize rpool/vms/demo-vm 2>/dev/null
    echo ""
    echo -e "  ${D}USED = ~0. The clone hasn't diverged from golden yet.${N}"
    echo -e "  ${D}Disk space is only consumed as the VM writes new data.${N}"
    pause

    # ── Step 3b: Boot it and prove it's real ──────────────────────
    echo -e "${C}──────────────────────────────────────────────────────────────${N}"
    echo -e "${W}  Step 3b: Boot the clone — prove it's a real VM${N}"
    echo -e "${C}──────────────────────────────────────────────────────────────${N}"
    echo ""
    echo -e "  ${D}The clone is a 40GB disk that was created in milliseconds.${N}"
    echo -e "  ${D}Let's boot it and SSH in to prove it's a full CentOS system.${N}"
    echo ""

    # Create a minimal VM definition
    local zvol_dev="/dev/zvol/rpool/vms/demo-vm"
    if [[ -b "$zvol_dev" ]]; then
      echo -ne "  ${Y}Booting demo-vm...${N} "
      virt-install --name demo-vm --ram 2048 --vcpus 2 \
        --disk path="${zvol_dev}",bus=virtio \
        --network bridge=virbr0,model=virtio \
        --os-variant centos-stream9 --graphics none \
        --import --noautoconsole >/dev/null 2>&1 && \
        echo -e "${G}started${N}" || echo -e "${Y}already defined${N}"

      echo -e "  ${D}Waiting for VM to boot and get an IP...${N}"
      local demo_ip="" attempts=0
      while [[ -z "$demo_ip" && $attempts -lt 30 ]]; do
        sleep 2
        demo_ip="$(virsh domifaddr demo-vm 2>/dev/null | awk '/ipv4/ {print $4}' | cut -d/ -f1 | head -1)"
        attempts=$((attempts + 1))
      done

      if [[ -n "$demo_ip" ]]; then
        echo -e "  ${G}VM is up at ${W}${demo_ip}${N}"
        echo ""
        echo -e "  ${W}SSH into the clone to prove it's real:${N}"
        echo ""
        sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 \
          "root@${demo_ip}" '
          echo "  Hostname:  $(hostname)"
          echo "  OS:        $(cat /etc/redhat-release 2>/dev/null || echo unknown)"
          echo "  Kernel:    $(uname -r)"
          echo "  Uptime:    $(uptime -p)"
          echo "  containerd: $(containerd --version 2>/dev/null | awk "{print \$3}" || echo "not running yet")"
        ' 2>/dev/null || echo -e "  ${Y}VM still booting — SSH not ready yet (cloud-init takes ~30s)${N}"
      else
        echo -e "  ${Y}VM booting (no IP yet — cloud-init in progress)${N}"
      fi
      echo ""
      echo -e "  ${D}That's a full CentOS VM, cloned in milliseconds, booted from a ZFS zvol.${N}"
      echo -e "  ${D}Ready for kubeadm join, Cilium agent, containerd — all pre-installed.${N}"

      # Cleanup the demo VM
      echo ""
      echo -ne "  ${Y}Cleaning up demo-vm...${N} "
      virsh destroy demo-vm >/dev/null 2>&1 || true
      virsh undefine demo-vm >/dev/null 2>&1 || true
      zfs destroy rpool/vms/demo-vm 2>/dev/null || true
      echo -e "${G}done${N}"
    fi
  else
    echo -e "  ${R}No golden snapshot found — skipping clone demo${N}"
  fi
  pause

  # ── Step 4: Snapshot a running VM ─────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 4: Snapshot a running VM — pre-upgrade checkpoint${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}About to upgrade a node? Snapshot it first.${N}"
  echo -e "  ${D}If the upgrade breaks something, rollback in milliseconds.${N}"
  echo -e "  ${D}The VM doesn't even know it was snapshotted.${N}"
  echo ""
  echo -ne "  ${Y}Snapshotting kldload-w-1 (running, serving pods)...${N} "
  local s_start s_end
  s_start=$(date +%s%N)
  zfs snapshot rpool/vms/kldload-w-1@demo-checkpoint 2>/dev/null || true
  s_end=$(date +%s%N)
  echo -e "${G}done in $(( (s_end - s_start) / 1000000 ))ms${N}"
  echo ""
  echo -e "  ${D}The VM is still running. No pause, no freeze, no downtime.${N}"
  echo -e "  ${D}That snapshot is a point-in-time copy of the entire 40GB disk.${N}"
  echo ""
  zfs list -t snapshot -o name,used,refer rpool/vms/kldload-w-1@demo-checkpoint 2>/dev/null
  echo ""
  echo -e "  ${D}USED = 0B. It costs nothing until the VM writes new blocks.${N}"

  # ── Step 5: Destroy + rebuild ─────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 5: Nodes are cattle, not pets${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}In traditional infrastructure, losing a node is a crisis.${N}"
  echo -e "  ${D}With ZFS clones, losing a node is a 75ms rebuild.${N}"
  echo ""
  echo -e "  ${W}Current cluster:${N}"
  _kctl get nodes --no-headers 2>/dev/null | awk '{printf "    %-16s %s\n", $1, $2}'
  echo ""
  echo -e "  ${D}If we needed to replace kldload-w-3:${N}"
  echo -e "    ${C}virsh destroy kldload-w-3${N}           # kill the VM"
  echo -e "    ${C}zfs destroy rpool/vms/kldload-w-3${N}   # delete the disk (instant)"
  echo -e "    ${C}zfs clone golden@snap rpool/vms/kldload-w-3${N}  # new disk (75ms)"
  echo -e "    ${C}virsh start kldload-w-3${N}             # boot the new clone"
  echo ""
  echo -e "  ${D}Total time: seconds. Total disk copied: zero bytes.${N}"

  # ── Summary ───────────────────────────────────────────────────
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  VM lifecycle powered by ZFS${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Golden image:   ${G}built once, sealed, immutable${N}"
  echo -e "  Clone VM:       ${G}~75ms for a 40GB disk${N}"
  echo -e "  Snapshot VM:    ${G}instant, while running, no downtime${N}"
  echo -e "  Rollback VM:    ${G}instant, entire disk reverts${N}"
  echo -e "  Rebuild VM:     ${G}destroy + re-clone, seconds${N}"
  echo -e "  Disk cost:      ${G}only divergent blocks, not full copies${N}"
  echo ""
  echo -e "  ${W}4 nodes x 40GB = 160GB provisioned${N}"
  echo -e "  ${W}Actual disk used: ~7GB (shared golden image + diffs)${N}"
  echo ""
  echo -e "  ${D}This is why we can deploy, test, destroy, and rebuild${N}"
  echo -e "  ${D}an entire Kubernetes cluster in minutes, not hours.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"

  # Cleanup
  zfs destroy rpool/vms/demo-vm 2>/dev/null || true
  zfs destroy rpool/vms/kldload-w-1@demo-checkpoint 2>/dev/null || true
  pause
}

# ── z: ZFS Live Demo ───────────────────────────────────────────
demo_zfs_live() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  ZFS — the filesystem that powers everything you're about${N}"
  echo -e "${W}  to see. Every VM in this cluster is a ZFS clone. Every${N}"
  echo -e "${W}  snapshot is instant. Every rollback is instant. Zero copy.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "${D}  If you've never seen ZFS before, watch the timestamps.${N}"
  pause

  # ── Step 1: Create a dataset ──────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Create a ZFS dataset${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}A dataset is like a directory, but with its own properties —${N}"
  echo -e "  ${D}compression, quotas, snapshots, replication. All independent.${N}"
  echo ""
  zfs create -o mountpoint=/tmp/zfs-demo -o compression=lz4 rpool/demo 2>/dev/null || true
  echo -e "  ${G}Created ${W}rpool/demo${N} → mounted at ${W}/tmp/zfs-demo${N}"
  echo ""
  zfs list -o name,used,avail,compress,mountpoint rpool/demo

  # ── Step 2: Write a config file ───────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Write a config file${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  cat > /tmp/zfs-demo/cilium.conf <<'CONF'
# Cilium Configuration — Production
# Last verified: working perfectly
cluster-name: kldload-prod
kube-proxy-replacement: true
enable-hubble: true
tunnel-protocol: disabled
ipam-mode: kubernetes
CONF
  echo -e "  ${W}Contents of /tmp/zfs-demo/cilium.conf:${N}"
  echo ""
  cat /tmp/zfs-demo/cilium.conf
  echo ""
  echo -e "  ${G}Config file written — this represents a known-good state."

  # ── Step 3: Snapshot ──────────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: Take a snapshot${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}A ZFS snapshot captures the entire dataset at this exact moment.${N}"
  echo -e "  ${D}It's not a copy — it's a pointer. Zero disk cost. Instant.${N}"
  echo ""
  echo -ne "  ${Y}Snapshotting...${N} "
  local snap_start snap_end
  snap_start=$(date +%s%N)
  zfs snapshot rpool/demo@known-good
  snap_end=$(date +%s%N)
  echo -e "${G}done in $(( (snap_end - snap_start) / 1000000 ))ms${N}"
  echo ""
  zfs list -t snapshot -o name,used,refer rpool/demo
  echo ""
  echo -e "  ${D}Notice: USED = 0B. The snapshot costs nothing until data changes.${N}"

  # ── Step 4: Disaster ──────────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 4: Someone breaks the config${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Bad deploy. Intern pushed to prod. Config is gone.${N}"
  echo ""
  cat > /tmp/zfs-demo/cilium.conf <<'CONF'
# OOPS — someone overwrote the config
cluster-name: ???
kube-proxy-replacement: false
enable-hubble: false
tunnel-protocol: vxlan
ipam-mode: who-knows
# TODO: fix this before anyone notices
CONF
  echo -e "  ${R}Contents of /tmp/zfs-demo/cilium.conf (CORRUPTED):${N}"
  echo ""
  cat /tmp/zfs-demo/cilium.conf
  echo ""
  echo -e "  ${R}Config destroyed. In a traditional filesystem, you'd restore from backup."
  echo -e "  ${R}  That means: find the backup, copy it over, hope it's recent enough.${N}"
  echo -e "  ${R}  Minutes to hours. Maybe you don't even have a backup.${N}"
  pause

  # ── Step 5: Rollback ──────────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 5: ZFS rollback${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}One command. The entire dataset reverts to the snapshot.${N}"
  echo -e "  ${D}Not a file copy — a pointer change. Watch the time.${N}"
  echo ""
  echo -ne "  ${Y}Rolling back...${N} "
  local rb_start rb_end
  rb_start=$(date +%s%N)
  zfs rollback rpool/demo@known-good
  rb_end=$(date +%s%N)
  echo -e "${G}done in $(( (rb_end - rb_start) / 1000000 ))ms${N}"
  echo ""
  echo -e "  ${G}Contents of /tmp/zfs-demo/cilium.conf (RESTORED):${N}"
  echo ""
  cat /tmp/zfs-demo/cilium.conf
  echo ""
  echo -e "  ${G}The original config is back. Milliseconds, not minutes."
  pause

  # ── Step 6: Clone ─────────────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 6: Clone — zero-cost copy of the entire dataset${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}A clone is a writable copy of a snapshot. It shares all data${N}"
  echo -e "  ${D}with the original via copy-on-write. 0 bytes until you change something.${N}"
  echo -e "  ${D}This is how we deploy 6 Kubernetes VMs from one golden image.${N}"
  echo ""
  echo -ne "  ${Y}Cloning...${N} "
  local cl_start cl_end
  cl_start=$(date +%s%N)
  zfs clone -o mountpoint=/tmp/zfs-demo-clone rpool/demo@known-good rpool/demo-clone 2>/dev/null || true
  cl_end=$(date +%s%N)
  echo -e "${G}done in $(( (cl_end - cl_start) / 1000000 ))ms${N}"
  echo ""
  echo -e "  ${W}Original (/tmp/zfs-demo/cilium.conf):${N}"
  head -3 /tmp/zfs-demo/cilium.conf
  echo -e "  ${W}Clone (/tmp/zfs-demo-clone/cilium.conf):${N}"
  head -3 /tmp/zfs-demo-clone/cilium.conf
  echo ""
  echo -e "  ${D}Two independent datasets. Same data. Zero disk cost:${N}"
  echo ""
  zfs list -o name,used,refer rpool/demo rpool/demo-clone rpool/demo@known-good 2>/dev/null
  echo ""
  echo -e "  ${D}The clone uses 0 bytes. Only divergent blocks cost disk space.${N}"

  # ── Summary ───────────────────────────────────────────────────
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  ZFS: the filesystem under everything${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Snapshot:     ${G}instant — metadata pointer, 0 bytes${N}"
  echo -e "  Rollback:     ${G}instant — pointer revert, milliseconds${N}"
  echo -e "  Clone:        ${G}instant — writable fork, 0 bytes${N}"
  echo -e "  Compression:  ${G}always on, transparent (lz4)${N}"
  echo -e "  Checksums:    ${G}every block verified on read${N}"
  echo ""
  echo -e "  ${W}This is why kube-cluster deploys 6 VMs in seconds:${N}"
  echo -e "  ${D}  One golden image → 6 ZFS clones → 6 running VMs.${N}"
  echo -e "  ${D}  Each clone: ~75ms, 0 bytes, independent writable copy.${N}"
  echo -e "  ${D}  Destroy all 6 → rebuild all 6: minutes, not hours.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"

  # Cleanup
  zfs destroy rpool/demo-clone 2>/dev/null || true
  zfs destroy rpool/demo@known-good 2>/dev/null || true
  zfs destroy rpool/demo 2>/dev/null || true
  pause
}

# ── 2: ZFS Clone Proof ────────────────────────────────────────
demo_zfs_clones() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  ZFS Clone Proof — how every K8s node got its disk${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Every node in this cluster boots from a ZFS zvol that was${N}"
  echo -e "  ${D}cloned from a single golden image. Copy-on-write means each${N}"
  echo -e "  ${D}clone only stores blocks that diverged from golden. The rest${N}"
  echo -e "  ${D}is shared — zero duplication.${N}"

  # ── Step 1: All zvols ────────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: ZFS zvols backing every Kubernetes node${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Each line is a 40GB virtual disk. The golden image is the${N}"
  echo -e "  ${D}source. The clones are the actual node disks. Look at 'USED'${N}"
  echo -e "  ${D}vs 'VOLSIZE' — that's copy-on-write in action.${N}"
  echo ""
  zfs list -o name,used,refer,volsize -r rpool/vms -t all 2>/dev/null || echo "  No rpool/vms"

  # ── Step 2: Per-node disk cost ───────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Per-node disk cost — clones vs full copies${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}USED = actual unique bytes on disk. PROVISIONED = what the VM${N}"
  echo -e "  ${D}thinks it has. The difference is pure savings from cloning.${N}"
  echo ""
  echo -e "  ${W}NODE              USED      PROVISIONED${N}"
  echo -e "  ────────────────  ────────  ───────────"
  for ds in $(zfs list -H -o name -t volume -r rpool/vms 2>/dev/null | grep -v golden); do
    local name used volsize
    name="$(basename "$ds")"
    used="$(zfs list -H -o used "$ds" 2>/dev/null)"
    volsize="$(zfs list -H -o volsize "$ds" 2>/dev/null)"
    echo -e "  ${G}${name}${N}$(printf '%*s' $((16 - ${#name})) '')${used}     ${volsize}"
  done
  local golden_used
  golden_used="$(zfs list -H -o used rpool/vms/k8s-golden 2>/dev/null)"
  echo ""
  echo -e "  Golden image:   ${C}${golden_used}${N} (source for all clones)"

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  ZFS instant cloning for Kubernetes infrastructure${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Clone time:     ${G}<100ms per node${N}"
  echo -e "  Disk per clone: ${G}~0 bytes (copy-on-write)${N}"
  echo -e "  Golden image:   ${G}${golden_used} (shared by all nodes)${N}"
  echo -e "  Rebuild cluster:${G}destroy + re-clone in seconds${N}"
  echo -e "  Proxmox clone:  ${R}~2 min + full disk copy per node${N}"
  echo ""
  echo -e "  ${D}What this means for you: spin up a 6-node test cluster,${N}"
  echo -e "  ${D}run your Cilium changes, destroy it, rebuild from scratch.${N}"
  echo -e "  ${D}Total disk cost for the entire cluster: one golden image.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 3: Add Worker Nodes ──────────────────────────────────────
demo_add_nodes() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Live Scale-Out — add 2 workers while the cluster runs${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Traditional scale-out: provision hardware, install OS, configure${N}"
  echo -e "  ${D}packages, join cluster. Hours of work.${N}"
  echo -e "  ${D}ZFS scale-out: clone golden image, boot, kubeadm join. Minutes.${N}"

  # ── Step 1: Current cluster state ────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Current cluster state${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}This is what we're starting with. We'll add 2 more workers.${N}"
  echo ""
  _kctl get nodes -o wide

  local existing
  existing="$(virsh list --all --name 2>/dev/null | grep 'kldload-w-' | wc -l)"
  local next1=$((existing + 1))
  local next2=$((existing + 2))
  local SSH_KEY="/root/.ssh/id_ed25519"
  local pubkey=""
  [[ -f "${SSH_KEY}.pub" ]] && pubkey="$(cat "${SSH_KEY}.pub")"

  # ── Step 2: Clone new worker disks ───────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Clone 2 new worker disks from golden — watch the time${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Each clone is a 40GB virtual disk created by pointing at the${N}"
  echo -e "  ${D}golden snapshot. No bytes copied. Milliseconds.${N}"
  echo ""
  for n in $next1 $next2; do
    local name="kldload-w-${n}"
    echo -ne "  k8s-golden → ${name} ... "
    local S E
    S=$(date +%s%N)
    kvm-clone k8s-golden "$name" >/dev/null 2>&1
    E=$(date +%s%N)
    echo -e "${G}done${N} (${C}$(( (E-S)/1000000 ))ms${N})"
  done

  # Machine-id is generated by cloud-init runcmd (systemd-machine-id-setup)
  # DHCP uses ClientIdentifier=mac (baked into golden) — unique per clone

  # ── Step 3: Boot new workers ─────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: Boot the new workers${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Each VM gets a cloud-init ISO with its hostname, SSH keys, and${N}"
  echo -e "  ${D}network config. The golden image has containerd + kubeadm pre-installed.${N}"
  echo ""
  for n in $next1 $next2; do
    local name="kldload-w-${n}"
    # Create cloud-init ISO with SSH key + hostname
    local ci_dir ci_iso
    ci_dir="$(mktemp -d)"
    ci_iso="/var/lib/libvirt/isos/${name}-ci.iso"
    cat > "${ci_dir}/meta-data" <<META
instance-id: ${name}
local-hostname: ${name}
META
    cat > "${ci_dir}/user-data" <<USERDATA
#cloud-config
hostname: ${name}
manage_etc_hosts: true
disable_root: false
ssh_pwauth: true
${pubkey:+ssh_authorized_keys:}
${pubkey:+  - ${pubkey}}
users:
  - default
  - name: root
    lock_passwd: false
${pubkey:+    ssh_authorized_keys:}
${pubkey:+      - ${pubkey}}
chpasswd:
  expire: false
  users:
    - name: root
      password: kldload
      type: text
runcmd:
  - rm -f /etc/machine-id
  - systemd-machine-id-setup
  - rm -f /etc/ssh/ssh_host_*
  - ssh-keygen -A
  - sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
  - sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
  - sed -i 's/^#*MaxStartups.*/MaxStartups 20:30:60/' /etc/ssh/sshd_config
  - systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true
USERDATA
    cat > "${ci_dir}/network-config" <<NETCFG
version: 2
ethernets:
  id0:
    match:
      name: "en*"
    dhcp4: true
  id1:
    match:
      name: "eth*"
    dhcp4: true
NETCFG
    genisoimage -output "$ci_iso" -volid cidata -joliet -rock \
      "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null \
      || mkisofs -output "$ci_iso" -volid cidata -joliet -rock \
        "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null \
      || xorriso -as mkisofs -o "$ci_iso" -volid cidata -joliet -rock \
        "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null
    rm -rf "$ci_dir"
    virsh attach-disk "$name" "$ci_iso" sdb --type cdrom --config 2>/dev/null || true
    virsh start "$name" 2>/dev/null && echo -e "  ${G}${name}${N} started" || true
    sleep 3
  done

  # Wait for IPs
  echo ""
  echo -e "  ${D}Waiting for DHCP (45s)...${N}"
  sleep 45

  # ── Step 4: Join cluster + WireGuard ─────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 4: Join workers to the cluster${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Each new worker runs kubeadm join, gets a WireGuard tunnel${N}"
  echo -e "  ${D}to the control plane, and starts accepting pods. The Cilium${N}"
  echo -e "  ${D}agent DaemonSet deploys automatically.${N}"
  echo ""

  # Get join command from CP
  local join_cmd
  join_cmd="$(_ssh_cp 'kubeadm token create --print-join-command 2>/dev/null')"

  for n in $next1 $next2; do
    local name="kldload-w-${n}"
    local mac ip
    mac="$(virsh domiflist "$name" 2>/dev/null | awk '/bridge/ {print $5}' | head -1)"
    ip="$(virsh net-dhcp-leases default 2>/dev/null | grep "$mac" | awk '{print $5}' | cut -d/ -f1 | head -1)"
    if [[ -z "$ip" ]]; then
      echo -e "  ${Y}${name}: no IP — skipping${N}"
      continue
    fi

    echo -e "  ${name}: ${G}${ip}${N}"

    # Wait for SSH
    for _ in $(seq 1 15); do
      sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=3 "root@${ip}" true 2>/dev/null && break
      sleep 2
    done

    # Set hostname
    sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" \
      "hostnamectl set-hostname ${name}" 2>/dev/null || true

    # Join cluster
    if [[ -n "$join_cmd" ]]; then
      echo -ne "  Joining ${name}... "
      sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=30 "root@${ip}" \
        "${join_cmd}" 2>/dev/null \
        && echo -e "${G}done${N}" \
        || echo -e "${Y}failed${N}"
    fi

    # WireGuard
    local max_id=0
    for vm in $(virsh list --name 2>/dev/null | grep -v '^$'); do
      local vid
      vid="$(virsh domiflist "$vm" 2>/dev/null | awk '/bridge/ {print $5}' | head -1)"
      vid="$(virsh net-dhcp-leases default 2>/dev/null | grep "$vid" | awk '{print $5}' | cut -d/ -f1 | head -1)"
      [[ -z "$vid" ]] && continue
      vid="$(sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=3 "root@${vid}" \
        'grep -o "10\.251\.[0-9]*\.[0-9]*" /etc/wireguard/wg-k8s.conf 2>/dev/null | head -1' 2>/dev/null)" || continue
      vid="${vid##*.}"
      [[ -n "$vid" && "$vid" -gt "$max_id" ]] && max_id="$vid"
    done
    local new_id=$((max_id + 1))

    sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" \
      "kube-network init ${new_id}" 2>/dev/null || true

    local new_pub cp_pub
    new_pub="$(sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" 'cat /etc/wireguard/wg-mgmt.pub' 2>/dev/null)"
    cp_pub="$(_ssh_cp 'cat /etc/wireguard/wg-mgmt.pub 2>/dev/null')"

    if [[ -n "$new_pub" && -n "$cp_pub" ]]; then
      _ssh_cp "kube-network add-peer ${ip} ${new_pub} ${new_id}" 2>/dev/null || true
      sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" \
        "kube-network add-peer ${CP_IP} ${cp_pub} 1" 2>/dev/null || true
      sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" \
        "kube-network pin-kubelet && systemctl restart kubelet" 2>/dev/null || true
      echo -e "  ${G}WireGuard: ${name} → 10.251.0.${new_id}${N}"
    fi

    _kctl label node "$name" node-role.kubernetes.io/worker= --overwrite 2>/dev/null || true
  done

  echo ""
  echo -e "  ${D}Waiting for nodes to become Ready (20s)...${N}"
  sleep 20

  # ── Step 5: Verify expanded cluster ──────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 5: Verify expanded cluster${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}The new workers should appear as Ready nodes. Cilium agents${N}"
  echo -e "  ${D}deployed automatically via the DaemonSet.${N}"
  echo ""
  _kctl get nodes -o wide

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Live cluster scale-out — ZFS clone to running K8s node${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Nodes added:    ${G}2 (kldload-w-${next1}, kldload-w-${next2})${N}"
  echo -e "  Clone time:     ${G}<100ms each${N}"
  echo -e "  Join time:      ${G}~30 seconds${N}"
  echo -e "  Downtime:       ${G}zero${N}"
  echo ""
  echo -e "  ${D}What this proves: scaling a bare-metal K8s cluster is as fast${N}"
  echo -e "  ${D}as scaling in the cloud. Faster, actually — no image download.${N}"
  echo -e "  ${D}Clone, boot, join. The golden image has everything pre-installed.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 4: Cilium Status ──────────────────────────────────────────
demo_cilium() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Cilium eBPF — the kernel IS the network${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Cilium replaces kube-proxy, iptables, and userland proxies with${N}"
  echo -e "  ${D}eBPF programs loaded directly into the Linux kernel. Service${N}"
  echo -e "  ${D}routing, load balancing, NAT, policy enforcement — all happen${N}"
  echo -e "  ${D}in kernel space. Zero context switches. Zero copies.${N}"

  # ── Step 1: Cilium agent status ──────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Cilium agent status${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}The Cilium agent runs on every node as a DaemonSet. It loads${N}"
  echo -e "  ${D}eBPF programs into the kernel, populates BPF maps, and then${N}"
  echo -e "  ${D}the kernel handles all traffic without going back to userland.${N}"
  echo ""
  _cilium_dbg status || echo "  cilium not available"

  # ── Step 2: Cilium pods ──────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Cilium pods — one agent per node${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}One agent per node. Once eBPF programs are loaded, the agent is${N}"
  echo -e "  ${D}only needed for control plane updates — new pods, new policies.${N}"
  echo -e "  ${D}The datapath itself runs in the kernel, independent of the agent.${N}"
  echo ""
  _kctl get pods -n kube-system -l k8s-app=cilium -o wide

  # ── Step 3: eBPF endpoint map ────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: eBPF endpoint map — every pod tracked in the kernel${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Every pod gets an entry in a BPF hash map. This is what Cilium${N}"
  echo -e "  ${D}looks up on every packet — O(1) lookup in kernel memory. Compare${N}"
  echo -e "  ${D}this to iptables, which is O(n) chain traversal per packet.${N}"
  echo ""
  _cilium_dbg bpf endpoint list 2>/dev/null | head -15 || echo "  N/A"

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Cilium: eBPF-native networking for Kubernetes${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  kube-proxy:     ${G}replaced by eBPF${N} (no iptables rules)"
  echo -e "  Network policy: ${G}enforced in kernel${N} (not userland)"
  echo -e "  Observability:  ${G}Hubble sees every flow${N}"
  echo -e "  Gateway API:    ${G}native ingress (no nginx)${N}"
  echo ""
  echo -e "  ${D}What this proves: Cilium is not a sidecar proxy bolted onto K8s.${N}"
  echo -e "  ${D}It IS the K8s network. eBPF programs in the kernel handle every${N}"
  echo -e "  ${D}packet — routing, NAT, LB, policy — without leaving kernel space.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 5: Connectivity Test ──────────────────────────────────────
demo_connectivity() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Cilium Connectivity Test — prove the eBPF datapath works${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Cilium ships a connectivity test suite that deploys test pods${N}"
  echo -e "  ${D}and validates every path through the eBPF datapath: pod-to-pod,${N}"
  echo -e "  ${D}pod-to-service, pod-to-external, and cross-node. This is the${N}"
  echo -e "  ${D}same test suite the Cilium CI runs on every commit.${N}"

  # ── Step 1: Run connectivity tests ───────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Run pod-to-pod and pod-to-service tests${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}This deploys test pods on different nodes, sends traffic through${N}"
  echo -e "  ${D}the eBPF datapath, and validates that packets arrive correctly.${N}"
  echo -e "  ${D}Takes about 2 minutes.${N}"
  echo ""
  local tmpout="/tmp/cilium-connectivity-$$.log"
  # connectivity test is a cilium CLI feature (host), not cilium-dbg (pod)
  _cilium_cli connectivity test --test pod-to-pod --test pod-to-service 2>&1 \
    | tee "$tmpout" || true

  # ── Step 2: Results ──────────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Test results${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Each test validates a specific path through the eBPF datapath.${N}"
  echo -e "  ${D}Failures here would indicate BPF map corruption, misconfigured${N}"
  echo -e "  ${D}endpoints, or broken tc filter attachment.${N}"
  echo ""

  # Parse results — cilium uses [=] for skip, no emoji
  grep -E "^\[.\].*Test " "$tmpout" 2>/dev/null | tail -20
  local total skip ran fail
  total="$(grep -cE '^\[.\].*Test ' "$tmpout" 2>/dev/null)" || total=0
  skip="$(grep -cE '^\[=\].*Test ' "$tmpout" 2>/dev/null)" || skip=0
  fail="$(grep -cE '^\[!\]|FAIL' "$tmpout" 2>/dev/null)" || fail=0
  [[ "$total" =~ ^[0-9]+$ ]] || total=0
  [[ "$skip" =~ ^[0-9]+$ ]] || skip=0
  [[ "$fail" =~ ^[0-9]+$ ]] || fail=0
  ran=$((total - skip))

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Cilium eBPF datapath: validated${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Tests run:      ${G}${ran}${N} (${skip} skipped)"
  echo -e "  Tests failed:   ${R}${fail}${N}"
  echo -e "  Pod-to-pod:     ${G}eBPF datapath (no iptables)${N}"
  echo -e "  Pod-to-service: ${G}eBPF service map (no kube-proxy)${N}"
  echo ""
  echo -e "  ${D}What this proves: the eBPF datapath is correctly forwarding${N}"
  echo -e "  ${D}packets between pods, across nodes, and through service VIPs —${N}"
  echo -e "  ${D}entirely in kernel space, without kube-proxy or iptables.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  rm -f "$tmpout"
  pause
}

# ── 6: Hubble ─────────────────────────────────────────────────
demo_hubble() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Hubble — eBPF-native network observability${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Hubble reads eBPF event maps from the kernel — no agents, no${N}"
  echo -e "  ${D}sidecars, no log scrapers, no tcpdump. Every DNS query, every${N}"
  echo -e "  ${D}HTTP request, every TCP connection, every policy drop — visible${N}"
  echo -e "  ${D}in real time, with zero overhead on the datapath.${N}"

  # ── Step 1: Hubble deployment status ─────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Hubble deployment status${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Hubble relay aggregates eBPF events from all Cilium agents.${N}"
  echo -e "  ${D}Hubble UI provides a service dependency graph and flow timeline.${N}"
  echo ""
  _kctl get deploy -n kube-system hubble-relay hubble-ui

  # ── Step 2: Live flow observation ────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Watch live eBPF flows while deploying pods${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}We'll deploy 5 nginx pods and generate HTTP traffic. Hubble sees${N}"
  echo -e "  ${D}every flow in real time — pod scheduling, DNS resolution, HTTP${N}"
  echo -e "  ${D}requests — all captured from eBPF hooks in the kernel.${N}"
  echo -e "  ${D}(Streaming for 30 seconds)${N}"
  echo ""

  # Deploy pods in background — Hubble will see them being scheduled
  (
    sleep 3
    _kctl create deployment hubble-watch --image=nginx:alpine --replicas=5 2>/dev/null || true
    sleep 5
    # Generate traffic so Hubble sees HTTP + DNS flows
    _kctl run hubble-curl --image=busybox --restart=Never --command -- \
      sh -c 'for i in 1 2 3 4 5; do wget -qO- http://hubble-watch 2>/dev/null; sleep 1; done' 2>/dev/null || true
  ) &
  local deploy_pid=$!

  # Start hubble port-forward, stream flows, clean up
  _hubble_start

  timeout 25 hubble --server localhost:4245 observe --follow --output compact 2>/dev/null | head -40 || \
    _cilium_dbg monitor --type trace --type l7 2>/dev/null | head -40 || \
    echo "  Hubble stream ended"

  _hubble_stop

  wait "$deploy_pid" 2>/dev/null || true

  # Clean up
  _kctl delete deployment hubble-watch --grace-period=0 2>/dev/null || true
  _kctl delete pod hubble-curl --grace-period=0 --force 2>/dev/null || true

  # ── Step 3: Hubble UI access ─────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: Hubble UI — visual service map${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Hubble UI renders a service dependency graph from eBPF flow data.${N}"
  echo -e "  ${D}No instrumentation, no service mesh, no code changes — just eBPF.${N}"
  echo ""
  echo -e "  ${C}kubectl port-forward -n kube-system svc/hubble-ui 12000:80 --address 0.0.0.0${N}"
  echo -e "  Then open: ${G}http://<host-ip>:12000${N}"

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Hubble: network observability powered by eBPF${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Every DNS query:    ${G}visible${N}"
  echo -e "  Every HTTP request: ${G}visible${N}"
  echo -e "  Every TCP flow:     ${G}visible${N}"
  echo -e "  Every policy drop:  ${G}visible${N}"
  echo -e "  Agents required:    ${G}none${N} (kernel-native via eBPF)"
  echo ""
  echo -e "  ${D}What this proves: you get Istio-level observability without Istio.${N}"
  echo -e "  ${D}No sidecars, no envoy, no overhead. The kernel already knows${N}"
  echo -e "  ${D}about every packet — Hubble just reads the eBPF maps.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 7: CoreDNS ───────────────────────────────────────────────
demo_coredns() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  CoreDNS — cluster service discovery${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}CoreDNS provides DNS-based service discovery inside the cluster.${N}"
  echo -e "  ${D}Every Service gets a DNS name: my-svc.my-ns.svc.cluster.local.${N}"
  echo -e "  ${D}Pods resolve these names through CoreDNS, which Cilium routes${N}"
  echo -e "  ${D}to via eBPF — no iptables DNAT for the DNS VIP.${N}"

  # ── Step 1: CoreDNS pods ─────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: CoreDNS deployment${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}CoreDNS runs as 2 replicas for redundancy. Cilium's eBPF service${N}"
  echo -e "  ${D}map load-balances DNS queries to both replicas in the kernel.${N}"
  echo ""
  _kctl get pods -n kube-system -l k8s-app=kube-dns -o wide

  # ── Step 2: CoreDNS config ───────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: CoreDNS Corefile${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}The Corefile defines how DNS zones are served. The cluster.local${N}"
  echo -e "  ${D}zone handles all internal service names. External queries are${N}"
  echo -e "  ${D}forwarded to upstream resolvers (host DNS or /etc/resolv.conf).${N}"
  echo ""
  _kctl get configmap -n kube-system coredns -o jsonpath='{.data.Corefile}' 2>/dev/null
  echo ""

  # ── Step 3: DNS resolution tests ─────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: DNS resolution — internal and external${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Deploying a test pod to verify DNS resolution from inside the cluster.${N}"
  echo -e "  ${D}Each lookup proves a different DNS path: API server, kube-dns VIP,${N}"
  echo -e "  ${D}external names, and cross-namespace service discovery.${N}"
  echo ""

  _kctl run dns-test --image=busybox --restart=Never --command -- sleep 30 2>/dev/null || true
  sleep 5

  echo -e "  ${W}1. kubernetes.default.svc.cluster.local:${N}"
  _kctl exec dns-test -- nslookup kubernetes.default.svc.cluster.local 2>/dev/null | grep -A1 "Address" | tail -2 || echo "    failed"
  echo ""
  echo -e "  ${W}2. kube-dns.kube-system.svc.cluster.local:${N}"
  _kctl exec dns-test -- nslookup kube-dns.kube-system.svc.cluster.local 2>/dev/null | grep -A1 "Address" | tail -2 || echo "    failed"
  echo ""
  echo -e "  ${W}3. External DNS (google.com):${N}"
  _kctl exec dns-test -- nslookup google.com 2>/dev/null | grep -A1 "Address" | tail -2 || echo "    failed"
  echo ""
  echo -e "  ${W}4. Cross-namespace service (nginx-sample.default):${N}"
  _kctl exec dns-test -- nslookup nginx-sample.default.svc.cluster.local 2>/dev/null | grep -A1 "Address" | tail -2 || echo "    failed"

  _kctl delete pod dns-test --grace-period=0 --force 2>/dev/null &

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  CoreDNS: cluster DNS validated${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Internal services: ${G}resolved via .svc.cluster.local${N}"
  echo -e "  External names:    ${G}forwarded to upstream DNS${N}"
  echo -e "  CoreDNS pods:      ${G}redundant (2 replicas)${N}"
  echo ""
  echo -e "  ${D}What this proves: service discovery works end-to-end. Cilium's${N}"
  echo -e "  ${D}eBPF service map routes DNS queries to CoreDNS without iptables.${N}"
  echo -e "  ${D}CoreDNS resolves internal names from the K8s API watch cache.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 8: Network Policy ────────────────────────────────────────
demo_netpol() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Network Policy — eBPF packet filtering in the kernel${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Cilium enforces NetworkPolicy in eBPF — packets are dropped in${N}"
  echo -e "  ${D}the kernel before they ever reach the destination pod. Traditional${N}"
  echo -e "  ${D}CNIs use iptables, which means O(n) chain traversal per packet.${N}"
  echo -e "  ${D}Cilium's BPF policy map is O(1) — constant time, any scale.${N}"

  # ── Step 1: Set up test environment ──────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Deploy web server and client in isolated namespace${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Creating a namespace with a web server and a client pod.${N}"
  echo -e "  ${D}Initially, no policy — everything can talk to everything.${N}"
  echo ""

  # Create isolated namespace
  _kctl create namespace netpol-demo 2>/dev/null || true
  _kctl run web --image=nginx --namespace=netpol-demo 2>/dev/null || true
  _kctl expose pod web --port=80 --namespace=netpol-demo 2>/dev/null || true
  _kctl run client --image=busybox --namespace=netpol-demo --restart=Never --command -- sleep 120 2>/dev/null || true
  sleep 8

  local result
  result="$(_kctl exec client -n netpol-demo -- wget -qO- --timeout=3 http://web.netpol-demo.svc.cluster.local 2>/dev/null | head -1)"
  [[ -n "$result" ]] && echo -e "  ${G}No policy: client can reach web${N}" || echo -e "  ${Y}Waiting for pods...${N}"

  # ── Step 2: Apply deny-all ───────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Apply deny-all ingress policy${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}A default-deny policy tells Cilium to drop all ingress traffic${N}"
  echo -e "  ${D}that isn't explicitly allowed. This is a BPF map update — the${N}"
  echo -e "  ${D}kernel starts dropping packets immediately, no iptables flush needed.${N}"
  echo ""
  _kctl apply -f - <<'DENY' 2>/dev/null
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: deny-all
  namespace: netpol-demo
spec:
  podSelector: {}
  policyTypes: [Ingress]
DENY
  sleep 3
  result="$(_kctl exec client -n netpol-demo -- wget -qO- --timeout=3 http://web.netpol-demo.svc.cluster.local 2>&1 | head -1)"
  echo -e "  ${R}Blocked: ${result:-connection timed out}${N}"
  pause

  # ── Step 3: Allow specific pod ───────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: Allow only from client pod — per-pod granularity${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Now we add a policy that allows traffic from the client pod only.${N}"
  echo -e "  ${D}Cilium evaluates this in the BPF policy map — matching on pod${N}"
  echo -e "  ${D}identity, not IP address. Pods can move, IPs can change, policy${N}"
  echo -e "  ${D}follows the identity.${N}"
  echo ""
  _kctl apply -f - <<'ALLOW' 2>/dev/null
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-client
  namespace: netpol-demo
spec:
  podSelector:
    matchLabels:
      run: web
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchLabels:
              run: client
ALLOW
  sleep 3
  result="$(_kctl exec client -n netpol-demo -- wget -qO- --timeout=3 http://web.netpol-demo.svc.cluster.local 2>/dev/null | head -1)"
  [[ -n "$result" ]] && echo -e "  ${G}Allowed: ${result}${N}" || echo -e "  ${Y}Still blocked (policy propagating)${N}"

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Cilium NetworkPolicy: eBPF-enforced, identity-based${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Enforcement:    ${G}kernel-level eBPF (not iptables)${N}"
  echo -e "  Deny-all:       ${G}blocks all ingress immediately${N}"
  echo -e "  Allow-specific: ${G}per-pod granularity via identity${N}"
  echo -e "  Latency:        ${G}none — in-kernel packet filtering${N}"
  echo ""
  echo -e "  ${D}What this proves: policy enforcement is a BPF map lookup, not${N}"
  echo -e "  ${D}an iptables chain traversal. Identity-based, not IP-based —${N}"
  echo -e "  ${D}pods can reschedule to any node without updating firewall rules.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 9: MetalLB ────────────────────────────────────────────────
demo_metallb() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  MetalLB — real LoadBalancer IPs on bare metal${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}In the cloud, type:LoadBalancer gets an external IP from the${N}"
  echo -e "  ${D}cloud provider. On bare metal, it stays <pending> forever.${N}"
  echo -e "  ${D}MetalLB fixes this — it assigns IPs from a pool and advertises${N}"
  echo -e "  ${D}them via ARP on your LAN. Real external IPs, no cloud needed.${N}"

  # ── Step 1: MetalLB status ───────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: MetalLB deployment${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}MetalLB runs a controller and a speaker DaemonSet. The speaker${N}"
  echo -e "  ${D}responds to ARP requests for assigned VIPs on the local network.${N}"
  echo ""
  _kctl get pods -n metallb-system

  # ── Step 2: IP address pool ──────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: IP address pool${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}MetalLB assigns IPs from this pool. L2 mode means it responds${N}"
  echo -e "  ${D}to ARP on your LAN — any machine on the network can reach these IPs.${N}"
  echo ""
  _kctl get ipaddresspool -n metallb-system -o yaml 2>/dev/null | grep -A5 "addresses:" || echo "  No pool configured"

  # ── Step 3: Deploy LoadBalancer service ──────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: Deploy a service with type:LoadBalancer${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Creating an nginx deployment and exposing it as LoadBalancer.${N}"
  echo -e "  ${D}On vanilla K8s, EXTERNAL-IP would say <pending>. With MetalLB,${N}"
  echo -e "  ${D}it gets a real IP from the pool within seconds.${N}"
  echo ""
  _kctl create deployment demo-web --image=nginx --replicas=2 2>/dev/null || true
  _kctl expose deployment demo-web --type=LoadBalancer --port=80 2>/dev/null || true
  sleep 5

  _kctl get svc demo-web
  local ext_ip
  ext_ip="$(_kctl get svc demo-web -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null)"
  if [[ -n "$ext_ip" ]]; then
    echo ""
    echo -e "  External IP: ${G}${ext_ip}${N}"
    echo -ne "  ${Y}Curling http://${ext_ip}...${N} "
    curl -s --connect-timeout 3 "http://${ext_ip}" 2>/dev/null | head -5 || echo "(not reachable from host)"
  fi

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  MetalLB: LoadBalancer on bare metal${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Service type:   ${G}LoadBalancer (not just NodePort)${N}"
  echo -e "  External IP:    ${G}${ext_ip:-pending}${N}"
  echo -e "  Cloud required: ${G}no${N} — L2 advertisement on your LAN"
  echo -e "  On vanilla K8s: ${R}LoadBalancer stays <pending> forever${N}"
  echo ""
  echo -e "  ${D}What this proves: bare metal K8s can have real external IPs.${N}"
  echo -e "  ${D}Combined with Cilium's eBPF service routing, traffic flows from${N}"
  echo -e "  ${D}the external IP directly to the backend pod — no iptables chain.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 10: Gateway API ────────────────────────────────────────────
demo_gateway() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Gateway API — eBPF-native HTTP ingress${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Gateway API is the successor to Ingress. Cilium implements it${N}"
  echo -e "  ${D}natively — no nginx-ingress-controller, no HAProxy, no envoy${N}"
  echo -e "  ${D}sidecar. HTTP routing decisions happen in eBPF via Cilium's${N}"
  echo -e "  ${D}L7 proxy, which is part of the Cilium agent — not a sidecar.${N}"

  # ── Step 1: Gateway API CRDs ─────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Gateway API CRDs — Cilium as the GatewayClass${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}GatewayClass defines which controller handles Gateway resources.${N}"
  echo -e "  ${D}Cilium registers itself as the controller — no separate ingress${N}"
  echo -e "  ${D}deployment needed.${N}"
  echo ""
  _kctl get gatewayclasses

  # ── Step 2: Deploy HTTP Gateway ──────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Deploy a Gateway + HTTPRoute${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Creating a Gateway listening on port 8088, with an HTTPRoute${N}"
  echo -e "  ${D}that sends all traffic to the demo-web backend. Cilium programs${N}"
  echo -e "  ${D}the eBPF datapath to handle this routing.${N}"
  echo ""
  _kctl apply -f - <<'GW' 2>/dev/null
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: demo-gateway
spec:
  gatewayClassName: cilium
  listeners:
    - name: http
      protocol: HTTP
      port: 8088
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: demo-route
spec:
  parentRefs:
    - name: demo-gateway
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: demo-web
          port: 80
GW
  sleep 3
  echo ""
  _kctl get gateway demo-gateway
  echo ""
  _kctl get httproute demo-route

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Cilium Gateway API: native HTTP ingress${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Ingress controller: ${G}Cilium (eBPF, no nginx)${N}"
  echo -e "  API version:        ${G}gateway.networking.k8s.io/v1${N}"
  echo -e "  HTTP routing:       ${G}kernel-native via eBPF datapath${N}"
  echo -e "  Traditional:        ${R}nginx-ingress + ConfigMap hell${N}"
  echo ""
  echo -e "  ${D}What this proves: ingress doesn't need a separate controller pod.${N}"
  echo -e "  ${D}Cilium handles L7 routing as part of its eBPF datapath. One fewer${N}"
  echo -e "  ${D}component to deploy, secure, and maintain.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 11: ZFS CSI PVC ────────────────────────────────────────────
demo_zfs_pvc() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  ZFS CSI — persistent volumes backed by real ZFS datasets${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Most Kubernetes storage is opaque — you get a block device or a${N}"
  echo -e "  ${D}directory, with no filesystem-level features. ZFS CSI gives every${N}"
  echo -e "  ${D}PV its own ZFS dataset — compression, checksums, instant snapshots,${N}"
  echo -e "  ${D}clones. All the ZFS primitives, exposed through the CSI API.${N}"

  # ── Step 1: Storage classes ──────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Available storage classes${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Two storage classes: 'zfs' (128K recordsize, general purpose) and${N}"
  echo -e "  ${D}'zfs-db' (8K recordsize, matches PostgreSQL/MySQL page size).${N}"
  echo -e "  ${D}Both get lz4 compression, SHA-256 checksums, and instant snapshots.${N}"
  echo ""
  _kctl get sc

  # ── Step 2: Create PVC ───────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Create a 50Gi PVC and write data${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Creating a PVC and a pod that writes to it. The ZFS CSI driver${N}"
  echo -e "  ${D}creates a real ZFS dataset on the node — visible with zfs list.${N}"
  echo ""
  _kctl apply -f - <<'PVC' 2>/dev/null
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: demo-data
spec:
  storageClassName: zfs
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 50Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: demo-writer
spec:
  containers:
    - name: writer
      image: busybox
      command: ["sh", "-c", "echo 'ZFS-backed persistent data' > /data/test.txt && sleep 3600"]
      volumeMounts:
        - name: data
          mountPath: /data
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: demo-data
PVC
  echo ""
  echo -e "  ${D}Waiting for PVC to bind...${N}"
  sleep 10

  # ── Step 3: Verify PVC ───────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: Verify PVC is bound to a real ZFS dataset${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}The PVC should show Bound status. The PV behind it is a ZFS${N}"
  echo -e "  ${D}dataset with its own properties — not a loopback file, not a${N}"
  echo -e "  ${D}directory, a real first-class ZFS dataset.${N}"
  echo ""
  echo -e "  ${W}PVC:${N}"
  _kctl get pvc demo-data
  echo ""
  echo -e "  ${W}PV (ZFS dataset):${N}"
  _kctl get pv 2>/dev/null | grep demo-data || echo "  PV not yet created"

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  ZFS CSI: every PV is a real ZFS dataset${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  StorageClass:   ${G}zfs (default, 128K recordsize, lz4)${N}"
  echo -e "  Also available: ${G}zfs-db (8K recordsize, for databases)${N}"
  echo -e "  Every PV gets:  ${G}compression, checksums, snapshots${N}"
  echo -e "  VolumeSnapshot: ${G}real ZFS snapshot, not slow copy${N}"
  echo -e "  Traditional:    ${R}hostPath or cloud block (no snapshots)${N}"
  echo ""
  echo -e "  ${D}What this proves: Kubernetes storage can have real filesystem${N}"
  echo -e "  ${D}features. Snapshot before a migration, clone for testing, compress${N}"
  echo -e "  ${D}transparently — all through the standard CSI interface.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 12: Snapshot + Restore PV ────────────────────────────────
demo_snapshot_restore() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Snapshot + Restore — ZFS time travel for Kubernetes PVs${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Traditional PV backup: stop the pod, copy the data, hope nothing${N}"
  echo -e "  ${D}changed. ZFS snapshot: instant, consistent, zero downtime. Then${N}"
  echo -e "  ${D}clone the snapshot into a new PV to restore — also instant.${N}"

  # Ensure demo-data PVC exists
  if ! _kctl get pvc demo-data --no-headers 2>/dev/null | grep -q Bound; then
    echo -e "${D}Creating demo-data PVC first...${N}"
    demo_zfs_pvc
  fi

  # ── Step 1: Write known data ─────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Write known data to the PVC${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Writing a timestamped value so we can prove the restore works.${N}"
  echo ""
  _kctl exec demo-writer -- sh -c 'echo "original data — $(date)" > /data/proof.txt && cat /data/proof.txt' 2>/dev/null

  # ── Step 2: Snapshot the PVC ─────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Snapshot the PVC — instant, zero cost${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}VolumeSnapshot triggers a real ZFS snapshot under the hood.${N}"
  echo -e "  ${D}Not a slow copy. A metadata pointer. Milliseconds, zero bytes.${N}"
  echo ""
  _kctl apply -f - <<'SNAP' 2>/dev/null
apiVersion: snapshot.storage.k8s.io/v1
kind: VolumeSnapshot
metadata:
  name: demo-data-snap
spec:
  volumeSnapshotClassName: zfs-snapshot
  source:
    persistentVolumeClaimName: demo-data
SNAP
  sleep 5
  _kctl get volumesnapshot demo-data-snap 2>/dev/null

  # ── Step 3: Corrupt the data ─────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: Corrupt the data — simulate a bad deploy${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Overwriting the data to simulate data corruption or a bad migration.${N}"
  echo ""
  _kctl exec demo-writer -- sh -c 'echo "CORRUPTED" > /data/proof.txt && cat /data/proof.txt' 2>/dev/null
  echo ""
  echo -e "  ${R}Data is now corrupted.${N}"
  pause

  # ── Step 4: Restore from snapshot ────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 4: Restore from snapshot — new PVC from the snapshot${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Creating a new PVC from the VolumeSnapshot. Under the hood, ZFS${N}"
  echo -e "  ${D}clones the snapshot — instant, zero bytes copied. The new PVC${N}"
  echo -e "  ${D}has the original, uncorrupted data.${N}"
  echo ""
  _kctl apply -f - <<'RESTORE' 2>/dev/null
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: demo-data-restored
spec:
  storageClassName: zfs
  dataSource:
    name: demo-data-snap
    kind: VolumeSnapshot
    apiGroup: snapshot.storage.k8s.io
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 50Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: demo-reader
spec:
  containers:
    - name: reader
      image: busybox
      command: ["sh", "-c", "cat /data/proof.txt && sleep 3600"]
      volumeMounts:
        - name: data
          mountPath: /data
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: demo-data-restored
RESTORE
  echo -e "  ${D}Waiting for restore...${N}"
  sleep 15
  echo ""
  echo -e "  ${W}Restored data:${N}"
  _kctl logs demo-reader 2>/dev/null || echo "  Still restoring..."

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  ZFS snapshot + restore for Kubernetes PVs${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Original data:  ${G}written to PVC${N}"
  echo -e "  Snapshot:       ${G}instant ZFS snapshot${N}"
  echo -e "  Corruption:     ${R}data overwritten${N}"
  echo -e "  Restore:        ${G}new PVC from snapshot — original data back${N}"
  echo -e "  Time to restore:${G}<1 second (ZFS clone)${N}"
  echo ""
  echo -e "  ${D}What this proves: PV data is never lost. Snapshot before every${N}"
  echo -e "  ${D}migration, every upgrade, every risky deploy. Restore is instant.${N}"
  echo -e "  ${D}The whole pipeline uses standard K8s VolumeSnapshot API.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 13: Database PVC ─────────────────────────────────────────
demo_db_pvc() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Database PVC — ZFS tuned for database workloads${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Databases write in fixed-size pages — PostgreSQL uses 8KB, MySQL${N}"
  echo -e "  ${D}uses 16KB. ZFS default recordsize is 128KB, which causes write${N}"
  echo -e "  ${D}amplification for database I/O. The zfs-db storage class uses 8K${N}"
  echo -e "  ${D}recordsize to match the database page size — no amplification.${N}"

  # ── Step 1: Create database PVC ──────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Create a PVC with zfs-db storage class (8K recordsize)${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}The zfs-db StorageClass creates datasets with recordsize=8K,${N}"
  echo -e "  ${D}matching PostgreSQL's page size. This eliminates write amplification${N}"
  echo -e "  ${D}and dramatically improves database write performance on ZFS.${N}"
  echo ""
  _kctl apply -f - <<'DBPVC' 2>/dev/null
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: demo-db
spec:
  storageClassName: zfs-db
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 10Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: demo-db-writer
spec:
  containers:
    - name: writer
      image: busybox
      command: ["sh", "-c", "dd if=/dev/urandom of=/data/test.db bs=4096 count=1000 2>/dev/null && echo 'Wrote 4MB of random data' && ls -lh /data/test.db && sleep 3600"]
      volumeMounts:
        - name: data
          mountPath: /data
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: demo-db
DBPVC
  echo -e "  ${D}Waiting for PVC to bind...${N}"
  sleep 15

  # ── Step 2: Verify PVC and write test ────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Verify PVC and write test output${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}The writer pod does 4KB random writes — simulating database I/O.${N}"
  echo -e "  ${D}With 8K recordsize, each 4KB write fits in a single ZFS record.${N}"
  echo -e "  ${D}With 128K recordsize, each 4KB write would waste 124KB.${N}"
  echo ""
  echo -e "  ${W}PVC Status:${N}"
  _kctl get pvc demo-db
  echo ""
  echo -e "  ${W}Write Test Output:${N}"
  _kctl logs demo-db-writer 2>/dev/null || echo "  Pod still starting..."

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  ZFS database storage class: tuned for real workloads${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  StorageClass:   ${G}zfs-db (8K recordsize)${N}"
  echo -e "  Why 8K:         ${G}matches PostgreSQL/MySQL page size${N}"
  echo -e "  Default (zfs):  ${G}128K recordsize (general purpose)${N}"
  echo -e "  Both get:       ${G}compression, checksums, snapshots${N}"
  echo ""
  echo -e "  ${D}What this proves: ZFS isn't just a generic filesystem bolted${N}"
  echo -e "  ${D}onto Kubernetes. The storage classes are tuned for specific${N}"
  echo -e "  ${D}workloads — database I/O, general files, large sequential writes.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

