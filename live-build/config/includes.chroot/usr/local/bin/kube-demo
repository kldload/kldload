}

# ── 16: Scale Test ────────────────────────────────────────────
demo_scale() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Scale Test — 20 pods across all workers${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Scheduling 20 pods across all worker nodes. Cilium's eBPF service${N}"
  echo -e "  ${D}map load-balances traffic to all 20 pods in the kernel — O(1) lookup${N}"
  echo -e "  ${D}per packet, regardless of pod count. Traditional kube-proxy would${N}"
  echo -e "  ${D}need 20+ iptables rules for this, evaluated sequentially.${N}"

  # ── Step 1: Scale deployment ─────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Deploy 20 replicas${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}The scheduler distributes pods across nodes based on resource${N}"
  echo -e "  ${D}availability. Each node was cloned in <100ms — adding more nodes${N}"
  echo -e "  ${D}to handle more pods is trivial.${N}"
  echo ""
  _kctl create deployment scale-test --image=nginx --replicas=20 2>/dev/null || \
    _kctl scale deployment scale-test --replicas=20 2>/dev/null
  echo -e "  ${Y}Waiting for pods to schedule (15s)...${N}"
  sleep 15

  # ── Step 2: Pod distribution ─────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Pod distribution across nodes${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}How many pods landed on each node? The scheduler balances based${N}"
  echo -e "  ${D}on resource requests. Uneven distribution usually means one node${N}"
  echo -e "  ${D}has more available resources.${N}"
  echo ""
  echo -e "  ${W}Pods per node:${N}"
  _kctl get pods -l app=scale-test -o wide --no-headers | awk '{print $7}' | sort | uniq -c | sort -rn
  echo ""
  _kctl get pods -l app=scale-test -o wide | head -25

  local total ready
  total="$(_kctl get pods -l app=scale-test --no-headers 2>/dev/null | wc -l)" || total=0
  ready="$(_kctl get pods -l app=scale-test --no-headers 2>/dev/null | grep -c Running)" || ready=0
  [[ "$total" =~ ^[0-9]+$ ]] || total=0
  [[ "$ready" =~ ^[0-9]+$ ]] || ready=0

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Cluster scale: 20 pods distributed across workers${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Pods requested: ${G}20${N}"
  echo -e "  Pods running:   ${G}${ready}/${total}${N}"
  echo -e "  Spread across:  ${G}all available nodes${N}"
  echo -e "  Node clone time:${G}<100ms (add more nodes instantly)${N}"
  echo ""
  echo -e "  ${D}What this proves: the cluster scales horizontally. Need more${N}"
  echo -e "  ${D}capacity? Clone another node in 75ms. Cilium's eBPF service map${N}"
  echo -e "  ${D}handles load balancing to any number of backends — same O(1) cost.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 17: Rolling Update ───────────────────────────────────────
demo_rolling_update() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Rolling Update — zero-downtime image swap${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Kubernetes replaces pods one at a time during a rolling update.${N}"
  echo -e "  ${D}Old pods are terminated only after new pods pass readiness checks.${N}"
  echo -e "  ${D}Cilium's eBPF service map updates atomically — the LB backend list${N}"
  echo -e "  ${D}switches in one BPF map write, not a chain of iptables rule edits.${N}"

  # ── Step 1: Deploy initial version ──────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Deploy nginx (4 replicas)${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Starting with 4 nginx pods. We'll swap to httpd while the service${N}"
  echo -e "  ${D}stays available throughout the entire update.${N}"
  echo ""
  _kctl create deployment rolling-demo --image=nginx --replicas=4 2>/dev/null || true
  _kctl expose deployment rolling-demo --type=ClusterIP --port=80 2>/dev/null || true
  sleep 10
  _kctl get pods -l app=rolling-demo -o custom-columns='NAME:.metadata.name,IMAGE:.spec.containers[0].image,STATUS:.status.phase,NODE:.spec.nodeName' --no-headers

  # ── Step 2: Trigger rolling update ───────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Update image nginx -> httpd — watch the rollout${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Kubernetes creates new httpd pods, waits for them to be ready,${N}"
  echo -e "  ${D}then terminates the old nginx pods. The service endpoint list${N}"
  echo -e "  ${D}updates in Cilium's BPF map — no iptables rule churn.${N}"
  echo ""
  _kctl set image deployment/rolling-demo nginx=httpd 2>/dev/null
  echo -e "  ${Y}Watching rollout (30s)...${N}"
  sleep 5

  for _ in $(seq 1 5); do
    local ready total
    ready="$(_kctl get deployment rolling-demo -o jsonpath='{.status.readyReplicas}' 2>/dev/null)"
    total="$(_kctl get deployment rolling-demo -o jsonpath='{.spec.replicas}' 2>/dev/null)"
    echo -e "    ${C}${ready:-0}/${total} ready${N}"
    [[ "${ready}" == "${total}" ]] && break
    sleep 5
  done

  # ── Step 3: Verify ───────────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: Verify all pods are now httpd${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Every pod should now show httpd as the container image.${N}"
  echo -e "  ${D}The service was available throughout — zero downtime.${N}"
  echo ""
  _kctl get pods -l app=rolling-demo -o custom-columns='NAME:.metadata.name,IMAGE:.spec.containers[0].image,STATUS:.status.phase,NODE:.spec.nodeName' --no-headers

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Zero-downtime rolling update${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Strategy:       ${G}RollingUpdate (default)${N}"
  echo -e "  Old pods:       ${G}terminated only after new pods ready${N}"
  echo -e "  Service:        ${G}available throughout${N}"
  echo -e "  Rollback:       ${G}kubectl rollout undo deployment/rolling-demo${N}"
  echo ""
  echo -e "  ${D}What this proves: application updates don't require downtime.${N}"
  echo -e "  ${D}Combined with ZFS node snapshots, you can checkpoint the node${N}"
  echo -e "  ${D}before an OS-level update, and rollback the entire disk if needed.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 18: Self-healing ─────────────────────────────────────────
demo_self_heal() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Self-Healing — the controller loop never sleeps${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Kubernetes continuously reconciles actual state with desired state.${N}"
  echo -e "  ${D}If a pod dies, the ReplicaSet controller creates a replacement.${N}"
  echo -e "  ${D}Cilium updates the eBPF service map — the replacement pod is${N}"
  echo -e "  ${D}instantly reachable, no iptables rule propagation delay.${N}"

  # ── Step 1: Deploy pods ──────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Deploy 3 replicas${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}3 nginx pods. The desired state is 3 running replicas.${N}"
  echo -e "  ${D}We'll kill one and watch the controller replace it.${N}"
  echo ""
  _kctl create deployment heal-demo --image=nginx --replicas=3 2>/dev/null || true
  sleep 8
  _kctl get pods -l app=heal-demo -o wide --no-headers

  # ── Step 2: Kill a pod ───────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Kill a pod — watch the replacement appear${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  local victim
  victim="$(_kctl get pods -l app=heal-demo --no-headers -o name | head -1)"
  if [[ -n "$victim" ]]; then
    echo -e "  ${D}Killing ${victim}. The ReplicaSet controller will detect the missing${N}"
    echo -e "  ${D}pod and create a replacement. Cilium adds the new pod to the eBPF${N}"
    echo -e "  ${D}service map as soon as it passes readiness.${N}"
    echo ""
    echo -e "  ${R}Killing: ${victim}${N}"
    _kctl delete "$victim" --grace-period=0 --force 2>/dev/null
    echo -e "  ${Y}Waiting for replacement (10s)...${N}"
    sleep 10
    echo ""
    echo -e "  ${W}After:${N}"
    _kctl get pods -l app=heal-demo -o wide --no-headers
  fi

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Kubernetes self-healing: desired state always wins${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Pod killed:     ${G}replaced automatically${N}"
  echo -e "  Desired state:  ${G}3 replicas maintained${N}"
  echo -e "  Intervention:   ${G}none required${N}"
  echo ""
  echo -e "  ${D}What this proves: the controller loop ensures your workloads stay${N}"
  echo -e "  ${D}running. Kill pods, lose nodes, crash containers — Kubernetes${N}"
  echo -e "  ${D}rebuilds. Cilium updates the eBPF maps. Service stays available.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 19: Drain Node ───────────────────────────────────────────
demo_drain() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Node Drain — graceful pod migration${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Before maintenance, OS upgrades, or hardware swaps, you drain a${N}"
  echo -e "  ${D}node. Kubernetes evicts all pods to other nodes first — no traffic${N}"
  echo -e "  ${D}is lost. Cilium's eBPF service map updates as pods migrate,${N}"
  echo -e "  ${D}redirecting traffic to the new locations in the kernel.${N}"

  # ── Step 1: Show pods on target node ─────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Identify the drain target${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""

  # Pick a worker with pods
  local worker
  worker="$(_kctl get nodes --no-headers | grep -v control-plane | head -1 | awk '{print $1}')"
  [[ -z "$worker" ]] && { echo -e "${R}No worker nodes found${N}"; pause; return; }

  echo -e "  ${D}Draining ${worker}. All non-system pods will be evicted to other${N}"
  echo -e "  ${D}nodes before the drain completes.${N}"
  echo ""
  echo -e "  ${W}Pods on ${worker} before drain:${N}"
  _kctl get pods -A --field-selector "spec.nodeName=${worker}" --no-headers 2>/dev/null | grep -v kube-system | head -10

  # ── Step 2: Drain the node ───────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Drain the worker node${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}kubectl drain cordons the node (no new pods) and evicts existing${N}"
  echo -e "  ${D}pods. DaemonSets (like Cilium agent) stay — they run on every node.${N}"
  echo ""
  echo -e "  ${Y}Draining ${worker}...${N}"
  _kctl drain "$worker" --ignore-daemonsets --delete-emptydir-data --force --timeout=60s 2>/dev/null || true
  sleep 5

  # ── Step 3: Verify migration ─────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: Verify pods migrated${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}The drained node should have no workload pods. All migrated to${N}"
  echo -e "  ${D}surviving nodes. Cilium's eBPF service map was updated in the kernel${N}"
  echo -e "  ${D}— traffic follows the pods to their new locations.${N}"
  echo ""
  echo -e "  ${W}Pods on ${worker} after drain:${N}"
  _kctl get pods -A --field-selector "spec.nodeName=${worker}" --no-headers 2>/dev/null | grep -v kube-system | head -10 || echo "    (none — all migrated)"
  echo ""
  echo -e "  ${W}Pods migrated to other nodes:${N}"
  _kctl get pods -A -o wide --no-headers 2>/dev/null | grep -v kube-system | head -10

  # Uncordon
  echo ""
  echo -e "  ${G}Uncordoning ${worker}...${N}"
  _kctl uncordon "$worker" 2>/dev/null

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Node drain: zero-impact maintenance${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Worker drained: ${G}${worker}${N}"
  echo -e "  Pods migrated:  ${G}to remaining workers automatically${N}"
  echo -e "  Service impact: ${G}none — rolling migration${N}"
  echo -e "  Use case:       ${G}maintenance, kernel upgrade, hardware swap${N}"
  echo ""
  echo -e "  ${D}What this proves: node maintenance doesn't mean downtime. Drain${N}"
  echo -e "  ${D}the node, do your work, uncordon. Combined with ZFS snapshots,${N}"
  echo -e "  ${D}you can snapshot the node before an upgrade and rollback if needed.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 20: Node Snapshot + Rollback ─────────────────────────────
demo_node_rollback() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  ZFS Node Snapshots — time travel for infrastructure${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}ZFS snapshots apply to VM disks, not just filesystems. You can${N}"
  echo -e "  ${D}snapshot a running Kubernetes node — its entire disk, OS, packages,${N}"
  echo -e "  ${D}configs, kubelet state — in milliseconds. If an upgrade breaks${N}"
  echo -e "  ${D}something, rollback the entire node to the pre-upgrade state.${N}"

  # ── Step 1: Snapshot all node zvols ──────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Snapshot every node — pre-upgrade checkpoint${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Snapshotting every node's 40GB disk in one pass. Each snapshot is${N}"
  echo -e "  ${D}a metadata operation — milliseconds, zero bytes, while the VMs run.${N}"
  echo ""
  for ds in $(zfs list -H -o name -t volume -r rpool/vms 2>/dev/null | grep -v golden); do
    local snap="${ds}@demo-rollback"
    echo -ne "  ${Y}Snapshotting ${ds}...${N} "
    local s_start s_end
    s_start=$(date +%s%N)
    zfs snapshot "$snap" 2>/dev/null && {
      s_end=$(date +%s%N)
      echo -e "${G}done in $(( (s_end - s_start) / 1000000 ))ms${N}"
    } || echo -e "${Y}exists${N}"
  done

  # ── Step 2: Show snapshots ───────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Current ZFS snapshots — your undo history${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Every snapshot is a point-in-time copy of the entire node disk.${N}"
  echo -e "  ${D}USED = 0B until the VM writes new blocks. Rollback is instant.${N}"
  echo ""
  zfs list -t snapshot -r rpool/vms -o name,used,creation 2>/dev/null | head -20

  # ── Step 3: Rollback procedure ───────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: How to rollback a node${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Three commands to revert an entire Kubernetes node to its${N}"
  echo -e "  ${D}pre-upgrade state — OS, packages, configs, everything:${N}"
  echo ""
  echo -e "    ${C}virsh destroy kldload-w-1${N}"
  echo -e "    ${C}zfs rollback rpool/vms/kldload-w-1@demo-rollback${N}"
  echo -e "    ${C}virsh start kldload-w-1${N}"
  echo ""
  echo -e "  ${D}The entire node disk reverts instantly — a pointer change, not a copy.${N}"
  echo -e "  ${D}The VM boots into exactly the state it was in at snapshot time.${N}"

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  ZFS time travel for Kubernetes nodes${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Snapshot time:  ${G}instant (metadata only)${N}"
  echo -e "  Disk cost:      ${G}0 bytes (copy-on-write)${N}"
  echo -e "  Rollback time:  ${G}instant (pointer change)${N}"
  echo -e "  Use case:       ${G}pre-upgrade checkpoint, testing, disaster recovery${N}"
  echo -e "  Traditional:    ${R}VM backup (minutes/hours, full disk copy)${N}"
  echo ""
  echo -e "  ${D}What this proves: infrastructure changes are reversible. Snapshot${N}"
  echo -e "  ${D}before every upgrade, every kernel update, every config change.${N}"
  echo -e "  ${D}If anything breaks, rollback in milliseconds. No backups to restore.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 21: Replace Workers (nodes are cattle) ───────────────────
demo_replace_nodes() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Replace Nodes — destroy and rebuild from golden image${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Nodes are cattle, not pets. If a node is compromised, drifted,${N}"
  echo -e "  ${D}or just old — don't fix it, replace it. Drain pods, destroy the${N}"
  echo -e "  ${D}VM, clone a fresh copy from golden, boot, join. The node is brand${N}"
  echo -e "  ${D}new, identical to every other node, in under 2 minutes.${N}"

  # Pick 2 highest-numbered workers
  local workers=()
  while IFS= read -r w; do
    workers+=("$w")
  done < <(_kctl get nodes --no-headers 2>/dev/null | grep -v control-plane | awk '{print $1}' | sort -t- -k3 -n | tail -2)

  if [[ ${#workers[@]} -lt 2 ]]; then
    echo -e "${R}Need at least 2 workers to replace${N}"
    pause; return
  fi

  local w1="${workers[0]}" w2="${workers[1]}"

  # ── Step 1: Drain pods ───────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Drain pods off both workers${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Targets: ${R}${w1}${N} and ${R}${w2}${N}"
  echo -e "  ${D}Draining evicts all pods to surviving nodes first — no traffic lost.${N}"
  echo ""

  local START_TIME
  START_TIME=$(date +%s)

  _kctl drain "$w1" --ignore-daemonsets --delete-emptydir-data --force --timeout=60s 2>/dev/null || true
  _kctl drain "$w2" --ignore-daemonsets --delete-emptydir-data --force --timeout=60s 2>/dev/null || true
  echo -e "  ${G}Pods migrated to remaining nodes${N}"

  # ── Step 2: Remove from cluster ──────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Remove nodes from the cluster${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Deleting the node objects from the API server. The VMs still exist${N}"
  echo -e "  ${D}but are no longer part of the cluster.${N}"
  echo ""
  _kctl delete node "$w1" --force 2>/dev/null || true
  _kctl delete node "$w2" --force 2>/dev/null || true
  echo -e "  ${G}Nodes removed from cluster${N}"

  # ── Step 3: Destroy VMs + ZFS ────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: Destroy VMs and ZFS zvols${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Shutting down the VMs and destroying their ZFS zvols. The disk${N}"
  echo -e "  ${D}is gone instantly — ZFS destroy is a metadata operation.${N}"
  echo ""
  virsh destroy "$w1" 2>/dev/null || true
  virsh undefine "$w1" 2>/dev/null || true
  zfs destroy -Rf "rpool/vms/${w1}" 2>/dev/null || true
  virsh destroy "$w2" 2>/dev/null || true
  virsh undefine "$w2" 2>/dev/null || true
  zfs destroy -Rf "rpool/vms/${w2}" 2>/dev/null || true
  echo -e "  ${G}VMs and zvols destroyed${N}"

  # ── Step 4: Clone fresh replacements ─────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 4: Clone fresh replacements from golden — watch the time${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Brand new 40GB disks, cloned from the sealed golden image.${N}"
  echo -e "  ${D}These are pristine — no drift, no leftover state, no compromise.${N}"
  echo ""
  local S E
  S=$(date +%s%N)
  kvm-clone k8s-golden "$w1" >/dev/null 2>&1
  E=$(date +%s%N)
  echo -e "  k8s-golden -> ${G}${w1}${N} (${C}$(( (E-S)/1000000 ))ms${N})"

  S=$(date +%s%N)
  kvm-clone k8s-golden "$w2" >/dev/null 2>&1
  E=$(date +%s%N)
  echo -e "  k8s-golden -> ${G}${w2}${N} (${C}$(( (E-S)/1000000 ))ms${N})"

  # ── Step 5: Boot and join ────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 5: Boot replacements and rejoin the cluster${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Booting the fresh clones, setting hostnames, joining the cluster${N}"
  echo -e "  ${D}via kubeadm, and establishing WireGuard tunnels.${N}"
  echo ""
  virsh start "$w1" 2>/dev/null && echo -e "  ${G}${w1} started${N}" || true
  virsh start "$w2" 2>/dev/null && echo -e "  ${G}${w2} started${N}" || true
  echo -e "  ${D}Waiting for boot (30s)...${N}"
  sleep 30

  # Step 6: Set hostname + join + WireGuard
  local join_cmd
  join_cmd="$(_ssh_cp 'kubeadm token create --print-join-command 2>/dev/null')"

  for name in "$w1" "$w2"; do
    local ip
    local mac
    mac="$(virsh domiflist "$name" 2>/dev/null | awk '/bridge/ {print $5}' | head -1)"
    ip="$(virsh net-dhcp-leases default 2>/dev/null | grep "$mac" | awk '{print $5}' | cut -d/ -f1 | head -1)"
    if [[ -z "$ip" ]]; then
      echo -e "  ${Y}${name}: could not get IP${N}"
      continue
    fi

    echo -e "  ${W}Configuring ${name} (${ip})${N}"
    sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 "root@${ip}" \
      "hostnamectl set-hostname ${name}; rm -f /etc/machine-id; systemd-machine-id-setup; systemctl restart systemd-networkd 2>/dev/null || true" 2>/dev/null || true

    if [[ -n "$join_cmd" ]]; then
      sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 "root@${ip}" \
        "kubeadm reset -f 2>/dev/null; ${join_cmd}" 2>/dev/null \
        && echo -e "    ${G}${name} joined cluster${N}" \
        || echo -e "    ${Y}${name} join failed${N}"
    fi

    # WireGuard — scan VMs for highest ID to avoid collisions
    if sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "root@${ip}" \
        "command -v wg >/dev/null 2>&1" 2>/dev/null; then
      local max_id=0
      for vm in $(virsh list --name 2>/dev/null | grep -v '^$'); do
        local vmac vip vid
        vmac="$(virsh domiflist "$vm" 2>/dev/null | awk '/bridge/ {print $5}' | head -1)"
        vip="$(virsh net-dhcp-leases default 2>/dev/null | awk -v m="$vmac" '$3 == m {print $5}' | cut -d/ -f1 | head -1)"
        [[ -z "$vip" ]] && continue
        vid="$(sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=3 "root@${vip}" \
          'grep -o "10\.251\.[0-9]*\.[0-9]*" /etc/wireguard/wg-k8s.conf 2>/dev/null | head -1' 2>/dev/null)" || continue
        vid="${vid##*.}"
        [[ -n "$vid" && "$vid" -gt "$max_id" ]] && max_id="$vid"
      done
      local new_id=$((max_id + 1))

      sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" "kube-network init ${new_id}" 2>/dev/null || true
      local new_pub cp_pub cp_lan
      new_pub="$(sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" 'cat /etc/wireguard/wg-mgmt.pub' 2>/dev/null)"
      cp_pub="$(_ssh_cp 'cat /etc/wireguard/wg-mgmt.pub 2>/dev/null')"
      cp_lan="$(_ssh_cp 'ip -4 route get 1.1.1.1 2>/dev/null | awk "{print \$7}" | head -1')"

      if [[ -n "$new_pub" && -n "$cp_pub" ]]; then
        _ssh_cp "kube-network add-peer ${ip} ${new_pub} ${new_id}" 2>/dev/null || true
        sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" \
          "kube-network add-peer ${cp_lan} ${cp_pub} 1" 2>/dev/null || true
        sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" "kube-network pin-kubelet && systemctl restart kubelet" 2>/dev/null || true
        echo -e "    ${G}WireGuard: ${name} → 10.251.0.${new_id}${N}"
      fi
    fi

    _kctl label node "$name" node-role.kubernetes.io/worker= --overwrite 2>/dev/null || true
  done

  echo ""
  echo -e "  ${D}Waiting for nodes to register (20s)...${N}"
  sleep 20

  local END_TIME
  END_TIME=$(date +%s)
  local ELAPSED=$(( END_TIME - START_TIME ))

  # ── Step 6: Verify rebuilt cluster ───────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 6: Verify rebuilt cluster${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Both workers should be back as Ready nodes with fresh disks.${N}"
  echo ""
  _kctl get nodes -o wide

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Nodes are cattle — destroy and rebuild in seconds${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Replaced:       ${G}${w1}, ${w2}${N}"
  echo -e "  Total time:     ${G}${ELAPSED} seconds${N}"
  echo -e "  Pods lost:      ${G}zero (migrated before destroy)${N}"
  echo -e "  Data lost:      ${G}zero (PVs on surviving nodes)${N}"
  echo -e "  Clone cost:     ${G}<100ms each, 0 bytes disk${N}"
  echo -e "  Manual steps:   ${G}none${N}"
  echo ""
  echo -e "  ${W}Traditional:${N}  ${R}rebuild VM (20min), reinstall packages,${N}"
  echo -e "                ${R}reconfigure, rejoin cluster, pray${N}"
  echo ""
  echo -e "  ${W}kldload:${N}      ${G}destroy -> clone -> boot -> join -> done${N}"
  echo ""
  echo -e "  ${D}What this proves: infrastructure is disposable when nodes are${N}"
  echo -e "  ${D}cloned from a golden image. No configuration drift. No debugging${N}"
  echo -e "  ${D}a broken node. Just replace it with a clean clone.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 22: eBPF Deep Dive ───────────────────────────────────────
demo_ebpf_deep_dive() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  eBPF Deep Dive — inside the kernel datapath${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}This is where it gets real. We're going to look at the actual BPF${N}"
  echo -e "  ${D}maps that Cilium maintains in the kernel. Every endpoint, every${N}"
  echo -e "  ${D}connection, every NAT entry, every service backend, every policy${N}"
  echo -e "  ${D}rule — stored in kernel hash maps, evaluated per-packet in O(1).${N}"

  # ── Step 1: Endpoint map ─────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: BPF endpoint map — every pod tracked in kernel memory${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Each pod gets a numeric identity and an entry in this BPF hash map.${N}"
  echo -e "  ${D}Cilium's eBPF programs look up endpoints here on every packet —${N}"
  echo -e "  ${D}O(1), constant time, regardless of cluster size.${N}"
  echo ""
  _cilium_dbg bpf endpoint list || echo "  N/A"

  # ── Step 2: Connection tracking ──────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: BPF conntrack — connection state in the kernel${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Every active connection is tracked in a BPF map — not iptables${N}"
  echo -e "  ${D}conntrack, which runs in the netfilter subsystem. BPF conntrack${N}"
  echo -e "  ${D}is faster because it skips the entire netfilter hook chain.${N}"
  echo ""
  _cilium_dbg bpf ct list global 2>/dev/null | head -20 || echo "  N/A"

  # ── Step 3: NAT table ───────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: BPF NAT table — no iptables NAT chain${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}NAT entries for masquerading and DNAT (service VIP to pod IP).${N}"
  echo -e "  ${D}In traditional K8s, this is hundreds of iptables DNAT rules that${N}"
  echo -e "  ${D}get evaluated linearly. In Cilium, it's a BPF hash map — O(1).${N}"
  echo ""
  _cilium_dbg bpf nat list 2>/dev/null | head -20 || echo "  N/A"

  # ── Step 4: Service load balancing ───────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 4: BPF service map — load balancing in the kernel${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Every Kubernetes Service is a key in this BPF map. The value is${N}"
  echo -e "  ${D}the list of backend pod IPs. When a packet hits a service VIP,${N}"
  echo -e "  ${D}the eBPF program looks up backends here and picks one — entirely${N}"
  echo -e "  ${D}in kernel space, no kube-proxy involved.${N}"
  echo ""
  _cilium_dbg bpf lb list 2>/dev/null | head -20 || echo "  N/A"

  # ── Step 5: Policy map ───────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 5: BPF policy map — packet filtering in the kernel${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Network policies are compiled into BPF map entries. Each packet${N}"
  echo -e "  ${D}is checked against this map — identity-based, not IP-based. A pod${N}"
  echo -e "  ${D}can move to any node and keep its identity — the policy follows.${N}"
  echo ""
  _cilium_dbg bpf policy get --all 2>/dev/null | head -20 || echo "  N/A"

  # ── Step 6: Datapath mode ────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 6: Datapath configuration${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Cilium's status shows the datapath mode — confirming kube-proxy${N}"
  echo -e "  ${D}replacement, host routing mode, and masquerading engine.${N}"
  echo ""
  _cilium_dbg status 2>/dev/null | grep -E 'KubeProxy|Datapath|Masq|Host Routing' || echo "  N/A"

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  100% kernel eBPF datapath — no userland, no iptables${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  eBPF programs:  ${G}loaded in kernel, attached via tc${N}"
  echo -e "  Conntrack:      ${G}BPF map (not iptables conntrack)${N}"
  echo -e "  NAT:            ${G}BPF map (not iptables NAT)${N}"
  echo -e "  Load balancing: ${G}BPF map (not kube-proxy)${N}"
  echo -e "  Policy:         ${G}BPF map (evaluated per-packet in kernel)${N}"
  echo -e "  Sidecars:       ${R}zero${N}"
  echo -e "  Userland proxy: ${R}none${N}"
  echo -e "  iptables rules: ${R}none${N}"
  echo ""
  echo -e "  ${D}What this proves: every networking primitive — routing, NAT, LB,${N}"
  echo -e "  ${D}policy, conntrack — lives in BPF maps evaluated in the kernel.${N}"
  echo -e "  ${D}No userland daemon in the packet path. No iptables chain traversal.${N}"
  echo -e "  ${D}This is what O(1) per-packet networking looks like.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 23: Zero Sidecar Proof ───────────────────────────────────
demo_zero_sidecar() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Zero Sidecar Proof — the network has no moving parts${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Service meshes inject sidecar proxies into every pod — envoy, linkerd-proxy.${N}"
  echo -e "  ${D}Each sidecar adds CPU overhead, memory overhead, and latency (two extra${N}"
  echo -e "  ${D}network hops per request). Cilium achieves the same functionality —${N}"
  echo -e "  ${D}mTLS, L7 policy, observability — with eBPF. Zero sidecars. Zero overhead.${N}"

  # ── Step 1: Container count per pod ──────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Container count per pod — should be exactly 1 everywhere${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}In an Istio cluster, every pod has 2+ containers (app + envoy sidecar).${N}"
  echo -e "  ${D}Here, every pod has exactly 1 container — the application itself.${N}"
  echo -e "  ${D}No injected proxies, no init containers rewriting iptables rules.${N}"
  echo ""
  _ssh_cp "kubectl get pods -A -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{\"  containers: \"}{range .spec.containers[*]}{.name}{\" \"}{end}{\"\n\"}{end}' 2>/dev/null | head -30" || echo "  N/A"

  # ── Step 2: kube-proxy check ─────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: kube-proxy — does it exist?${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}In a traditional cluster, kube-proxy runs on every node and writes${N}"
  echo -e "  ${D}hundreds of iptables rules. With Cilium in kube-proxy replacement${N}"
  echo -e "  ${D}mode, kube-proxy is not installed at all.${N}"
  echo ""
  local kp_count
  kp_count="$(_kctl get pods -A -l k8s-app=kube-proxy --no-headers 2>/dev/null | wc -l)"
  if [[ "$kp_count" -eq 0 ]]; then
    echo -e "  kube-proxy pods: ${G}0 — REPLACED by eBPF${N}"
  else
    echo -e "  kube-proxy pods: ${R}${kp_count} (should be 0)${N}"
  fi

  # ── Step 3: iptables rules ──────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: iptables rule count — near-zero proves eBPF datapath${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Traditional K8s clusters have 500+ iptables rules for service routing.${N}"
  echo -e "  ${D}Every rule is evaluated linearly per packet. Cilium replaces all of${N}"
  echo -e "  ${D}this with BPF maps — O(1) hash lookup instead of O(n) chain traversal.${N}"
  echo ""
  local nat_rules filter_rules
  nat_rules="$(_ssh_cp "iptables -t nat -L 2>/dev/null | wc -l")"
  filter_rules="$(_ssh_cp "iptables -t filter -L 2>/dev/null | wc -l")"
  echo -e "  iptables NAT rule lines:    ${G}${nat_rules:-0}${N} (traditional: 500+)"
  echo -e "  iptables filter rule lines:  ${G}${filter_rules:-0}${N}"
  echo ""
  echo -e "  ${W}NAT table:${N}"
  _ssh_cp "iptables -t nat -L 2>/dev/null | head -15" || echo "  (clean)"
  echo ""
  echo -e "  ${W}Filter table:${N}"
  _ssh_cp "iptables -t filter -L 2>/dev/null | head -15" || echo "  (clean)"

  # ── Step 4: Userland processes ───────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 4: No userland networking processes${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Looking for istio, linkerd, envoy sidecars, nginx-ingress,${N}"
  echo -e "  ${D}kube-proxy, flannel, calico — anything that handles packets in${N}"
  echo -e "  ${D}userland. There should be nothing.${N}"
  echo ""
  _ssh_cp "ps aux 2>/dev/null | grep -E 'istio|linkerd|nginx-ingress|kube-proxy|flannel|calico' | grep -v grep" \
    && echo -e "  ${R}FOUND userland networking — something is wrong${N}" \
    || echo -e "  ${G}NONE. Zero userland networking processes.${N}"
  echo ""
  echo -e "  ${D}Note: cilium-envoy is Cilium's L7 proxy DaemonSet — it's part of Cilium,${N}"
  echo -e "  ${D}not a sidecar. It handles Gateway API/L7 policy via eBPF hooks.${N}"

  # ── Step 5: What IS running ──────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 5: The only networking process — cilium-agent${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}The Cilium agent is the only networking process. It loads eBPF${N}"
  echo -e "  ${D}programs and populates BPF maps. Once loaded, the kernel handles${N}"
  echo -e "  ${D}all traffic independently — the agent is only needed for updates.${N}"
  echo ""
  _ssh_cp "ps aux 2>/dev/null | grep 'cilium-agent' | grep -v grep" || echo "  N/A"
  echo ""
  echo -e "  ${W}Datapath mode:${N}"
  _cilium_dbg status 2>/dev/null | grep -E 'KubeProxy|Datapath|Masquerading|Host|Encryption' || echo "  N/A"

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Zero sidecars, zero userland networking${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Sidecar containers:    ${G}0${N} (every pod has exactly 1 container)"
  echo -e "  kube-proxy:            ${G}not installed${N} — replaced by eBPF"
  echo -e "  iptables NAT rules:    ${G}${nat_rules:-0} lines${N} (traditional: 500+)"
  echo -e "  envoy/istio/linkerd:   ${G}not running${N}"
  echo -e "  flannel/calico:        ${G}not running${N}"
  echo -e "  Userland proxies:      ${G}none${N}"
  echo ""
  echo -e "  ${W}The kernel IS the network.${N}"
  echo -e "  ${D}Cilium agent loads BPF programs, then the kernel does the rest.${N}"
  echo -e "  ${D}Every packet — routed, NATed, load-balanced, policy-checked${N}"
  echo -e "  ${D}— without EVER leaving kernel space.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 24: Kernel Datapath Trace ────────────────────────────────
demo_datapath_trace() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Kernel Datapath Trace — watch a packet through eBPF${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}This is the ultimate proof: watching a packet traverse the eBPF${N}"
  echo -e "  ${D}program chain in real time. From veth ingress, through the BPF${N}"
  echo -e "  ${D}program, conntrack lookup, NAT, policy check, service LB, and${N}"
  echo -e "  ${D}out to the destination — all in kernel space, all observable.${N}"

  # ── Step 1: Deploy target service ────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: Deploy a target service for tracing${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}We need a service to send traffic through. The trace will show${N}"
  echo -e "  ${D}every eBPF program invocation as packets flow from client to server.${N}"
  echo ""
  _kctl create deployment trace-web --image=nginx:alpine --replicas=1 2>/dev/null || true
  _kctl expose deployment trace-web --port=80 2>/dev/null || true
  echo -e "  ${Y}Waiting for trace-web pod to be ready...${N}"
  _kctl wait --for=condition=ready pod -l app=trace-web --timeout=30s 2>/dev/null || true

  # ── Step 2: Endpoint list ────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 2: Cilium endpoints — each has its own BPF program chain${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Every pod endpoint has BPF programs attached to its veth pair.${N}"
  echo -e "  ${D}The programs handle ingress/egress policy, NAT, conntrack, and${N}"
  echo -e "  ${D}forwarding — all per-endpoint, all in kernel space.${N}"
  echo ""
  _cilium_dbg endpoint list || echo "  N/A"

  # ── Step 3: Live trace ───────────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 3: Live eBPF trace — watch packets through the kernel${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}Starting cilium monitor (trace + drop events) while generating${N}"
  echo -e "  ${D}HTTP traffic in the background. Each line shows a packet hitting${N}"
  echo -e "  ${D}an eBPF program — you can see the decision (forward, drop, NAT)${N}"
  echo -e "  ${D}being made in the kernel.${N}"
  echo ""

  # Generate traffic in background
  (
    sleep 2
    _kctl run trace-curl --image=busybox --restart=Never --command -- \
      sh -c 'for i in 1 2 3 4 5; do wget -qO- http://trace-web 2>/dev/null; sleep 1; done' 2>/dev/null || true
  ) &
  local traffic_pid=$!

  # Capture eBPF datapath events via kubectl exec into cilium pod
  _kctl exec -n kube-system ds/cilium -c cilium-agent -- \
    timeout 10 cilium-dbg monitor --type trace --type drop 2>&1 | head -60 || \
    echo "  cilium monitor not available"

  wait "$traffic_pid" 2>/dev/null || true

  # ── Step 4: Conntrack proof ──────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 4: BPF conntrack — proof these connections exist${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  echo -e "  ${D}The HTTP connections we just made are tracked in the BPF conntrack${N}"
  echo -e "  ${D}map. Not iptables conntrack — BPF conntrack. Kernel memory, O(1).${N}"
  echo ""
  _cilium_dbg bpf ct list global 2>/dev/null | grep ':80' | head -10 || echo "  N/A"

  # Cleanup
  _kctl delete deployment trace-web --grace-period=0 2>/dev/null || true
  _kctl delete svc trace-web 2>/dev/null || true
  _kctl delete pod trace-curl --grace-period=0 --force 2>/dev/null || true

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Packet path: entirely in the kernel${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Trace shows:    ${G}packet enters veth -> BPF program chain${N}"
  echo -e "  Conntrack:      ${G}BPF map (kernel memory)${N}"
  echo -e "  NAT:            ${G}BPF map (kernel memory)${N}"
  echo -e "  Service lookup: ${G}BPF map (kernel memory)${N}"
  echo -e "  Policy check:   ${G}BPF map (kernel memory)${N}"
  echo -e "  Forwarding:     ${G}BPF redirect (kernel, no netfilter)${N}"
  echo ""
  echo -e "  ${W}What traditional CNIs do:${N}"
  echo -e "  ${R}packet -> userland proxy -> iptables -> conntrack -> NAT -> forward${N}"
  echo -e "  ${R}= context switches, copies, overhead on every single packet${N}"
  echo ""
  echo -e "  ${W}What Cilium eBPF does:${N}"
  echo -e "  ${G}packet -> BPF program -> done${N}"
  echo -e "  ${G}= one kernel function call, zero copies, zero context switches${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 99: Smoke Test ────────────────────────────────────────────
demo_smoke() {
  header
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Smoke Test — full cluster validation${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${D}Running the comprehensive smoke test on the control plane.${N}"
  echo -e "  ${D}This checks every component: API server, scheduler, kubelet,${N}"
  echo -e "  ${D}Cilium, CoreDNS, Hubble, MetalLB, ZFS CSI — everything.${N}"

  # ── Step 1: Run smoke test ───────────────────────────────────
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "${W}  Step 1: kube-smoke-test output${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo ""
  _ssh_cp "kube-smoke-test" || echo "kube-smoke-test not available on CP"

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Smoke test complete${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  ${D}If all checks passed, the entire stack is healthy:${N}"
  echo -e "  ${D}  Kubernetes API, scheduler, kubelet on every node${N}"
  echo -e "  ${D}  Cilium eBPF datapath on every node${N}"
  echo -e "  ${D}  CoreDNS resolving internal + external names${N}"
  echo -e "  ${D}  Hubble observing all flows${N}"
  echo -e "  ${D}  MetalLB assigning external IPs${N}"
  echo -e "  ${D}  ZFS CSI provisioning real ZFS datasets as PVs${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 0: Cleanup ────────────────────────────────────────────────
demo_cleanup() {
  echo -ne "${Y}Cleaning up ALL demo resources...${N} "
  _kctl delete deployment demo-web nginx-fleet scale-test rolling-demo heal-demo 2>/dev/null || true
  _kctl delete svc demo-web nginx-fleet rolling-demo 2>/dev/null || true
  _kctl delete gateway demo-gateway 2>/dev/null || true
  _kctl delete httproute demo-route 2>/dev/null || true
  _kctl delete pod demo-writer demo-reader demo-db-writer test-pod 2>/dev/null || true
  _kctl delete pvc demo-data demo-data-restored demo-db 2>/dev/null || true
  _kctl delete volumesnapshot demo-data-snap 2>/dev/null || true
  _kctl delete networkpolicy deny-all allow-client -n netpol-demo 2>/dev/null || true
  _kctl delete pod web client -n netpol-demo 2>/dev/null || true
  _kctl delete svc web -n netpol-demo 2>/dev/null || true
  _kctl delete namespace netpol-demo 2>/dev/null || true
  _kctl delete deployment trace-web 2>/dev/null || true
  _kctl delete svc trace-web 2>/dev/null || true
  _kctl delete pod trace-curl 2>/dev/null || true
  # Clean up rollback snapshots
  for snap in $(zfs list -H -o name -t snapshot -r rpool/vms 2>/dev/null | grep demo-rollback); do
    zfs destroy "$snap" 2>/dev/null
  done
  echo -e "${G}done${N}"
  pause
}

# ── 00: Destroy Everything ─────────────────────────────────────
demo_destroy_all() {
  echo ""
  echo -e "${R}══════════════════════════════════════════════════════════════${N}"
  echo -e "${R}  DESTROY ALL — VMs, zvols, golden image, kubeconfig${N}"
  echo -e "${R}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "${Y}This will:${N}"
  echo "  • Shut down and delete all K8s VMs"
  echo "  • Destroy all ZFS zvols under rpool/vms"
  echo "  • Remove the golden image"
  echo "  • Remove kubeconfig and SSH keys"
  echo ""
  echo -e "${Y}After this, rebuild with:${N}  kube-cluster bootstrap --workers 3"
  echo ""
  read -r -p "Type 'destroy' to confirm: " confirm
  if [[ "$confirm" != "destroy" ]]; then
    echo -e "${Y}Cancelled${N}"
    return
  fi
  echo ""
  kube-cluster destroy --all
  echo ""
  echo -e "${G}Cluster destroyed. Rebuild with:${N}"
  echo -e "  ${W}kube-cluster bootstrap --workers 3${N}"
  pause
}

# ── Main Loop ─────────────────────────────────────────────────
_find_cp || { echo -e "${R}No Kubernetes control plane found.${N}"; echo "Run: kube-cluster bootstrap --workers 3"; exit 1; }

while true; do
  menu
  read -r c
  case $c in
    p)  demo_platform ;;
    z)  demo_zfs_live ;;
    v)  demo_vm_lifecycle ;;
    1)  demo_overview ;;
    2)  demo_zfs_clones ;;
    3)  demo_add_nodes ;;
    4)  demo_cilium ;;
    5)  demo_connectivity ;;
    6)  demo_hubble ;;
    7)  demo_coredns ;;
    8)  demo_netpol ;;
    9)  demo_metallb ;;
    10) demo_gateway ;;
    11) demo_zfs_pvc ;;
    12) demo_snapshot_restore ;;
    13) demo_db_pvc ;;
    14) demo_nginx ;;
    15) demo_pod_dns ;;
    16) demo_scale ;;
    17) demo_rolling_update ;;
    18) demo_self_heal ;;
    19) demo_drain ;;
    20) demo_node_rollback ;;
    21) demo_replace_nodes ;;
    22) demo_ebpf_deep_dive ;;
    23) demo_zero_sidecar ;;
    24) demo_datapath_trace ;;
    99) demo_smoke ;;
    0)  demo_cleanup ;;
    00) demo_destroy_all ;;
    q)  echo ""; exit 0 ;;
    *)  echo -e "${R}Invalid option${N}"; sleep 1 ;;
  esac
done
