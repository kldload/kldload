  _kctl get svc nginx-fleet

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Workload Distribution${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Replicas:       ${G}3 nginx pods${N}"
  echo -e "  Spread across:  ${G}all worker nodes${N}"
  echo -e "  Service:        ${G}LoadBalancer (MetalLB)${N}"
  echo -e "  Nodes cloned:   ${G}<100ms each from golden image${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 11: Pod + DNS Test ────────────────────────────────────────
demo_pod_dns() {
  header
  echo -e "${Y}=== Pod Scheduling Test ===${N}"
  _kctl run test-pod --image=busybox --restart=Never --command -- sleep 30 2>/dev/null || true
  sleep 5
  _kctl get pod test-pod -o wide
  echo ""

  echo -e "${Y}=== DNS Resolution Test ===${N}"
  _kctl exec test-pod -- nslookup kubernetes.default.svc.cluster.local 2>/dev/null || echo "  DNS test running..."
  echo ""

  _kctl delete pod test-pod --grace-period=0 --force 2>/dev/null &

  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Cluster Fundamentals${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Pod scheduling: ${G}works${N}"
  echo -e "  DNS resolution: ${G}kubernetes.default resolves${N}"
  echo -e "  CoreDNS:        ${G}running${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 12: Scale Test ────────────────────────────────────────────
demo_scale() {
  header
  echo -e "${Y}=== Scale Test — 20 Pods ===${N}"
  _kctl create deployment scale-test --image=nginx --replicas=20 2>/dev/null || \
    _kctl scale deployment scale-test --replicas=20 2>/dev/null
  echo -e "${D}Waiting for pods to schedule...${N}"
  sleep 15
  echo ""
  echo -e "${Y}=== Pod Distribution ===${N}"
  _kctl get pods -l app=scale-test -o wide --no-headers | awk '{print $7}' | sort | uniq -c | sort -rn
  echo ""
  echo -e "${Y}=== All Pods ===${N}"
  _kctl get pods -l app=scale-test -o wide | head -25

  local total ready
  total="$(_kctl get pods -l app=scale-test --no-headers | wc -l)"
  ready="$(_kctl get pods -l app=scale-test --no-headers | grep -c Running)"
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Cluster Scale${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Pods requested: ${G}20${N}"
  echo -e "  Pods running:   ${G}${ready}/${total}${N}"
  echo -e "  Spread across:  ${G}all available nodes${N}"
  echo -e "  Node clone time:${G}<100ms (add more nodes instantly)${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 3: Add Worker Nodes ──────────────────────────────────────
demo_add_nodes() {
  header
  echo -e "${Y}=== Current Nodes ===${N}"
  _kctl get nodes -o wide
  echo ""

  local existing
  existing="$(virsh list --all --name 2>/dev/null | grep 'kldload-w-' | wc -l)"
  local next1=$((existing + 1))
  local next2=$((existing + 2))
  local SSH_KEY="/root/.ssh/id_ed25519"
  local pubkey=""
  [[ -f "${SSH_KEY}.pub" ]] && pubkey="$(cat "${SSH_KEY}.pub")"

  echo -e "${Y}=== Cloning 2 new workers from golden image ===${N}"
  for n in $next1 $next2; do
    local name="kldload-w-${n}"
    echo -ne "  k8s-golden → ${name} ... "
    local S E
    S=$(date +%s%N)
    kvm-clone k8s-golden "$name" >/dev/null 2>&1
    E=$(date +%s%N)
    echo -e "${G}done${N} (${C}$(( (E-S)/1000000 ))ms${N})"
  done

  # Machine-id is generated by cloud-init runcmd (systemd-machine-id-setup)
  # DHCP uses ClientIdentifier=mac (baked into golden) — unique per clone

  echo ""
  echo -e "${Y}=== Booting new workers ===${N}"
  for n in $next1 $next2; do
    local name="kldload-w-${n}"
    # Create cloud-init ISO with SSH key + hostname
    local ci_dir ci_iso
    ci_dir="$(mktemp -d)"
    ci_iso="/var/lib/libvirt/isos/${name}-ci.iso"
    cat > "${ci_dir}/meta-data" <<META
instance-id: ${name}
local-hostname: ${name}
META
    cat > "${ci_dir}/user-data" <<USERDATA
#cloud-config
hostname: ${name}
manage_etc_hosts: true
disable_root: false
ssh_pwauth: true
${pubkey:+ssh_authorized_keys:}
${pubkey:+  - ${pubkey}}
users:
  - default
  - name: root
    lock_passwd: false
${pubkey:+    ssh_authorized_keys:}
${pubkey:+      - ${pubkey}}
chpasswd:
  expire: false
  users:
    - name: root
      password: kldload
      type: text
runcmd:
  - rm -f /etc/machine-id
  - systemd-machine-id-setup
  - rm -f /etc/ssh/ssh_host_*
  - ssh-keygen -A
  - sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
  - sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
  - sed -i 's/^#*MaxStartups.*/MaxStartups 20:30:60/' /etc/ssh/sshd_config
  - systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true
USERDATA
    cat > "${ci_dir}/network-config" <<NETCFG
version: 2
ethernets:
  id0:
    match:
      name: "en*"
    dhcp4: true
  id1:
    match:
      name: "eth*"
    dhcp4: true
NETCFG
    genisoimage -output "$ci_iso" -volid cidata -joliet -rock \
      "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null \
      || mkisofs -output "$ci_iso" -volid cidata -joliet -rock \
        "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null \
      || xorriso -as mkisofs -o "$ci_iso" -volid cidata -joliet -rock \
        "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null
    rm -rf "$ci_dir"
    virsh attach-disk "$name" "$ci_iso" sdb --type cdrom --config 2>/dev/null || true
    virsh start "$name" 2>/dev/null && echo -e "  ${G}${name}${N} started" || true
    sleep 3
  done

  # Wait for IPs
  echo -e "${D}Waiting for DHCP (45s)...${N}"
  sleep 45

  # Get join command from CP
  local join_cmd
  join_cmd="$(_ssh_cp 'kubeadm token create --print-join-command 2>/dev/null')"

  for n in $next1 $next2; do
    local name="kldload-w-${n}"
    local mac ip
    mac="$(virsh domiflist "$name" 2>/dev/null | awk '/bridge/ {print $5}' | head -1)"
    ip="$(virsh net-dhcp-leases default 2>/dev/null | grep "$mac" | awk '{print $5}' | cut -d/ -f1 | head -1)"
    if [[ -z "$ip" ]]; then
      echo -e "  ${Y}${name}: no IP — skipping${N}"
      continue
    fi

    echo -e "  ${name}: ${G}${ip}${N}"

    # Wait for SSH
    for _ in $(seq 1 15); do
      sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=3 "root@${ip}" true 2>/dev/null && break
      sleep 2
    done

    # Set hostname
    sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" \
      "hostnamectl set-hostname ${name}" 2>/dev/null || true

    # Join cluster
    if [[ -n "$join_cmd" ]]; then
      echo -ne "  Joining ${name}... "
      sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=30 "root@${ip}" \
        "${join_cmd}" 2>/dev/null \
        && echo -e "${G}done${N}" \
        || echo -e "${Y}failed${N}"
    fi

    # WireGuard
    local max_id=0
    for vm in $(virsh list --name 2>/dev/null | grep -v '^$'); do
      local vid
      vid="$(virsh domiflist "$vm" 2>/dev/null | awk '/bridge/ {print $5}' | head -1)"
      vid="$(virsh net-dhcp-leases default 2>/dev/null | grep "$vid" | awk '{print $5}' | cut -d/ -f1 | head -1)"
      [[ -z "$vid" ]] && continue
      vid="$(sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=3 "root@${vid}" \
        'grep -o "10\.251\.[0-9]*\.[0-9]*" /etc/wireguard/wg-k8s.conf 2>/dev/null | head -1' 2>/dev/null)" || continue
      vid="${vid##*.}"
      [[ -n "$vid" && "$vid" -gt "$max_id" ]] && max_id="$vid"
    done
    local new_id=$((max_id + 1))

    sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" \
      "kube-network init ${new_id}" 2>/dev/null || true

    local new_pub cp_pub
    new_pub="$(sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" 'cat /etc/wireguard/wg-mgmt.pub' 2>/dev/null)"
    cp_pub="$(_ssh_cp 'cat /etc/wireguard/wg-mgmt.pub 2>/dev/null')"

    if [[ -n "$new_pub" && -n "$cp_pub" ]]; then
      _ssh_cp "kube-network add-peer ${ip} ${new_pub} ${new_id}" 2>/dev/null || true
      sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" \
        "kube-network add-peer ${CP_IP} ${cp_pub} 1" 2>/dev/null || true
      sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" \
        "kube-network pin-kubelet && systemctl restart kubelet" 2>/dev/null || true
      echo -e "  ${G}WireGuard: ${name} → 10.251.0.${new_id}${N}"
    fi

    _kctl label node "$name" node-role.kubernetes.io/worker= --overwrite 2>/dev/null || true
  done

  echo ""
  echo -e "${D}Waiting for nodes to become Ready (20s)...${N}"
  sleep 20
  echo ""
  echo -e "${Y}=== Updated Cluster ===${N}"
  _kctl get nodes -o wide

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Live Cluster Scale-Out${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Nodes added:    ${G}2 (kldload-w-${next1}, kldload-w-${next2})${N}"
  echo -e "  Clone time:     ${G}<100ms each${N}"
  echo -e "  Join time:      ${G}~30 seconds${N}"
  echo -e "  Downtime:       ${G}zero${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 7: CoreDNS ───────────────────────────────────────────────
demo_coredns() {
  header
  echo -e "${Y}=== CoreDNS Pods ===${N}"
  _kctl get pods -n kube-system -l k8s-app=kube-dns -o wide
  echo ""
  echo -e "${Y}=== CoreDNS Config ===${N}"
  _kctl get configmap -n kube-system coredns -o jsonpath='{.data.Corefile}' 2>/dev/null
  echo ""

  echo -e "${Y}=== DNS Resolution Tests ===${N}"
  _kctl run dns-test --image=busybox --restart=Never --command -- sleep 30 2>/dev/null || true
  sleep 5

  echo -e "  ${W}1. kubernetes.default.svc.cluster.local:${N}"
  _kctl exec dns-test -- nslookup kubernetes.default.svc.cluster.local 2>/dev/null | grep -A1 "Address" | tail -2 || echo "    failed"
  echo ""
  echo -e "  ${W}2. kube-dns.kube-system.svc.cluster.local:${N}"
  _kctl exec dns-test -- nslookup kube-dns.kube-system.svc.cluster.local 2>/dev/null | grep -A1 "Address" | tail -2 || echo "    failed"
  echo ""
  echo -e "  ${W}3. External DNS (google.com):${N}"
  _kctl exec dns-test -- nslookup google.com 2>/dev/null | grep -A1 "Address" | tail -2 || echo "    failed"
  echo ""
  echo -e "  ${W}4. nginx-sample service DNS:${N}"
  _kctl exec dns-test -- nslookup nginx-sample.default.svc.cluster.local 2>/dev/null | grep -A1 "Address" | tail -2 || echo "    failed"

  _kctl delete pod dns-test --grace-period=0 --force 2>/dev/null &

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Cluster DNS Working${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Internal services: ${G}resolved via .svc.cluster.local${N}"
  echo -e "  External names:    ${G}forwarded to upstream DNS${N}"
  echo -e "  CoreDNS pods:      ${G}redundant (2 replicas)${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 8: Network Policy ────────────────────────────────────────
demo_netpol() {
  header
  echo -e "${Y}=== Network Policy Demo — Block then Allow ===${N}"
  echo ""

  # Create isolated namespace
  _kctl create namespace netpol-demo 2>/dev/null || true
  _kctl run web --image=nginx --namespace=netpol-demo 2>/dev/null || true
  _kctl expose pod web --port=80 --namespace=netpol-demo 2>/dev/null || true
  _kctl run client --image=busybox --namespace=netpol-demo --restart=Never --command -- sleep 120 2>/dev/null || true
  sleep 8

  echo -e "  ${W}Step 1: No policy — client can reach web${N}"
  local result
  result="$(_kctl exec client -n netpol-demo -- wget -qO- --timeout=3 http://web.netpol-demo.svc.cluster.local 2>/dev/null | head -1)"
  [[ -n "$result" ]] && echo -e "    ${G}Connected: ${result}${N}" || echo -e "    ${Y}Waiting for pods...${N}"

  echo ""
  echo -e "  ${W}Step 2: Apply deny-all policy${N}"
  _kctl apply -f - <<'DENY' 2>/dev/null
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: deny-all
  namespace: netpol-demo
spec:
  podSelector: {}
  policyTypes: [Ingress]
DENY
  sleep 3
  result="$(_kctl exec client -n netpol-demo -- wget -qO- --timeout=3 http://web.netpol-demo.svc.cluster.local 2>&1 | head -1)"
  echo -e "    ${R}Blocked: ${result:-connection timed out}${N}"

  echo ""
  echo -e "  ${W}Step 3: Allow only from client pod${N}"
  _kctl apply -f - <<'ALLOW' 2>/dev/null
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-client
  namespace: netpol-demo
spec:
  podSelector:
    matchLabels:
      run: web
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchLabels:
              run: client
ALLOW
  sleep 3
  result="$(_kctl exec client -n netpol-demo -- wget -qO- --timeout=3 http://web.netpol-demo.svc.cluster.local 2>/dev/null | head -1)"
  [[ -n "$result" ]] && echo -e "    ${G}Allowed: ${result}${N}" || echo -e "    ${Y}Still blocked (policy propagating)${N}"

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Cilium Network Policy (eBPF enforced)${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Enforcement:    ${G}kernel-level eBPF (not iptables)${N}"
  echo -e "  Deny-all:       ${G}blocks all ingress immediately${N}"
  echo -e "  Allow-specific: ${G}per-pod granularity${N}"
  echo -e "  Latency:        ${G}none — in-kernel packet filtering${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 13: Database PVC ─────────────────────────────────────────
demo_db_pvc() {
  header
  echo -e "${Y}=== Database PVC (8K recordsize — optimized for DB) ===${N}"
  _kctl apply -f - <<'DBPVC' 2>/dev/null
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: demo-db
spec:
  storageClassName: zfs-db
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 10Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: demo-db-writer
spec:
  containers:
    - name: writer
      image: busybox
      command: ["sh", "-c", "dd if=/dev/urandom of=/data/test.db bs=4096 count=1000 2>/dev/null && echo 'Wrote 4MB of random data' && ls -lh /data/test.db && sleep 3600"]
      volumeMounts:
        - name: data
          mountPath: /data
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: demo-db
DBPVC
  echo -e "${D}Waiting for PVC to bind...${N}"
  sleep 15

  echo ""
  echo -e "${Y}=== PVC Status ===${N}"
  _kctl get pvc demo-db
  echo ""
  echo -e "${Y}=== Write Test Output ===${N}"
  _kctl logs demo-db-writer 2>/dev/null || echo "  Pod still starting..."

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: ZFS Database Storage Class${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  StorageClass:   ${G}zfs-db (8K recordsize)${N}"
  echo -e "  Why 8K:         ${G}matches PostgreSQL/MySQL page size${N}"
  echo -e "  Default (zfs):  ${G}128K recordsize (general purpose)${N}"
  echo -e "  Both get:       ${G}compression, checksums, snapshots${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 17: Rolling Update ───────────────────────────────────────
demo_rolling_update() {
  header
  echo -e "${Y}=== Rolling Update — nginx → httpd (zero downtime) ===${N}"
  echo ""

  _kctl create deployment rolling-demo --image=nginx --replicas=4 2>/dev/null || true
  _kctl expose deployment rolling-demo --type=ClusterIP --port=80 2>/dev/null || true
  sleep 10
  echo -e "  ${W}Before:${N}"
  _kctl get pods -l app=rolling-demo -o custom-columns='NAME:.metadata.name,IMAGE:.spec.containers[0].image,STATUS:.status.phase,NODE:.spec.nodeName' --no-headers
  echo ""

  echo -e "  ${W}Updating image: nginx → httpd...${N}"
  _kctl set image deployment/rolling-demo nginx=httpd 2>/dev/null
  echo -e "${D}  Watching rollout (30s)...${N}"
  sleep 5

  for _ in $(seq 1 5); do
    local ready total
    ready="$(_kctl get deployment rolling-demo -o jsonpath='{.status.readyReplicas}' 2>/dev/null)"
    total="$(_kctl get deployment rolling-demo -o jsonpath='{.spec.replicas}' 2>/dev/null)"
    echo -e "    ${C}${ready:-0}/${total} ready${N}"
    [[ "${ready}" == "${total}" ]] && break
    sleep 5
  done

  echo ""
  echo -e "  ${W}After:${N}"
  _kctl get pods -l app=rolling-demo -o custom-columns='NAME:.metadata.name,IMAGE:.spec.containers[0].image,STATUS:.status.phase,NODE:.spec.nodeName' --no-headers

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Zero-Downtime Rolling Update${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Strategy:       ${G}RollingUpdate (default)${N}"
  echo -e "  Old pods:       ${G}terminated only after new pods ready${N}"
  echo -e "  Service:        ${G}available throughout${N}"
  echo -e "  Rollback:       ${G}kubectl rollout undo deployment/rolling-demo${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 18: Self-healing ─────────────────────────────────────────
demo_self_heal() {
  header
  echo -e "${Y}=== Self-Healing — Kill a Pod ===${N}"
  echo ""

  _kctl create deployment heal-demo --image=nginx --replicas=3 2>/dev/null || true
  sleep 8
  echo -e "  ${W}Before:${N}"
  _kctl get pods -l app=heal-demo -o wide --no-headers
  echo ""

  local victim
  victim="$(_kctl get pods -l app=heal-demo --no-headers -o name | head -1)"
  if [[ -n "$victim" ]]; then
    echo -e "  ${R}Killing: ${victim}${N}"
    _kctl delete "$victim" --grace-period=0 --force 2>/dev/null
    echo -e "${D}  Waiting for replacement (10s)...${N}"
    sleep 10
    echo ""
    echo -e "  ${W}After:${N}"
    _kctl get pods -l app=heal-demo -o wide --no-headers
  fi

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Kubernetes Self-Healing${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Pod killed:     ${G}replaced automatically${N}"
  echo -e "  Desired state:  ${G}3 replicas maintained${N}"
  echo -e "  Intervention:   ${G}none required${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 19: Drain Node ───────────────────────────────────────────
demo_drain() {
  header
  echo -e "${Y}=== Drain Worker — Watch Pod Migration ===${N}"
  echo ""

  # Pick a worker with pods
  local worker
  worker="$(_kctl get nodes --no-headers | grep -v control-plane | head -1 | awk '{print $1}')"
  [[ -z "$worker" ]] && { echo -e "${R}No worker nodes found${N}"; pause; return; }

  echo -e "  ${W}Pods on ${worker} before drain:${N}"
  _kctl get pods -A --field-selector "spec.nodeName=${worker}" --no-headers 2>/dev/null | grep -v kube-system | head -10
  echo ""

  echo -e "  ${Y}Draining ${worker}...${N}"
  _kctl drain "$worker" --ignore-daemonsets --delete-emptydir-data --force --timeout=60s 2>/dev/null || true
  sleep 5

  echo ""
  echo -e "  ${W}Pods on ${worker} after drain:${N}"
  _kctl get pods -A --field-selector "spec.nodeName=${worker}" --no-headers 2>/dev/null | grep -v kube-system | head -10 || echo "    (none — all migrated)"

  echo ""
  echo -e "  ${W}Pods migrated to other nodes:${N}"
  _kctl get pods -A -o wide --no-headers 2>/dev/null | grep -v kube-system | head -10

  # Uncordon
  echo ""
  echo -e "  ${G}Uncordoning ${worker}...${N}"
  _kctl uncordon "$worker" 2>/dev/null

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Node Drain + Pod Migration${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Worker drained: ${G}${worker}${N}"
  echo -e "  Pods migrated:  ${G}to remaining workers automatically${N}"
  echo -e "  Service impact: ${G}none — rolling migration${N}"
  echo -e "  Use case:       ${G}maintenance, kernel upgrade, hardware swap${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 20: Node Snapshot + Rollback ─────────────────────────────
demo_node_rollback() {
  header
  echo -e "${Y}=== ZFS Node Snapshot + Rollback ===${N}"
  echo ""

  # Snapshot all worker zvols
  echo -e "  ${W}Snapshotting all node zvols:${N}"
  for ds in $(zfs list -H -o name -t volume -r rpool/vms 2>/dev/null | grep -v golden); do
    local snap="${ds}@demo-rollback"
    zfs snapshot "$snap" 2>/dev/null && echo -e "    ${G}${snap}${N}" || echo -e "    ${Y}${snap} (exists)${N}"
  done

  echo ""
  echo -e "  ${W}Current ZFS snapshots:${N}"
  zfs list -t snapshot -r rpool/vms -o name,used,creation 2>/dev/null | head -20

  echo ""
  echo -e "  ${D}To rollback a node to this exact state:${N}"
  echo -e "    ${C}virsh destroy kldload-w-1${N}"
  echo -e "    ${C}zfs rollback rpool/vms/kldload-w-1@demo-rollback${N}"
  echo -e "    ${C}virsh start kldload-w-1${N}"
  echo -e "  ${D}The entire node disk reverts instantly — OS, packages, configs, everything.${N}"

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: ZFS Time Travel for Kubernetes Nodes${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Snapshot time:  ${G}instant (metadata only)${N}"
  echo -e "  Disk cost:      ${G}0 bytes (copy-on-write)${N}"
  echo -e "  Rollback time:  ${G}instant (pointer change)${N}"
  echo -e "  Use case:       ${G}pre-upgrade checkpoint, testing, disaster recovery${N}"
  echo -e "  Traditional:    ${R}VM backup (minutes/hours, full disk copy)${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 12: Snapshot + Restore PV ────────────────────────────────
demo_snapshot_restore() {
  header
  echo -e "${Y}=== Snapshot PVC + Restore ===${N}"

  # Ensure demo-data PVC exists
  if ! _kctl get pvc demo-data --no-headers 2>/dev/null | grep -q Bound; then
    echo -e "${D}Creating demo-data PVC first...${N}"
    demo_zfs_pvc
  fi

  echo -e "  ${W}Step 1: Write data to PVC${N}"
  _kctl exec demo-writer -- sh -c 'echo "original data — $(date)" > /data/proof.txt && cat /data/proof.txt' 2>/dev/null
  echo ""

  echo -e "  ${W}Step 2: Snapshot the PVC${N}"
  _kctl apply -f - <<'SNAP' 2>/dev/null
apiVersion: snapshot.storage.k8s.io/v1
kind: VolumeSnapshot
metadata:
  name: demo-data-snap
spec:
  volumeSnapshotClassName: zfs-snapshot
  source:
    persistentVolumeClaimName: demo-data
SNAP
  sleep 5
  _kctl get volumesnapshot demo-data-snap 2>/dev/null

  echo ""
  echo -e "  ${W}Step 3: Corrupt the data${N}"
  _kctl exec demo-writer -- sh -c 'echo "CORRUPTED" > /data/proof.txt && cat /data/proof.txt' 2>/dev/null

  echo ""
  echo -e "  ${W}Step 4: Restore from snapshot (new PVC)${N}"
  _kctl apply -f - <<'RESTORE' 2>/dev/null
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: demo-data-restored
spec:
  storageClassName: zfs
  dataSource:
    name: demo-data-snap
    kind: VolumeSnapshot
    apiGroup: snapshot.storage.k8s.io
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 50Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: demo-reader
spec:
  containers:
    - name: reader
      image: busybox
      command: ["sh", "-c", "cat /data/proof.txt && sleep 3600"]
      volumeMounts:
        - name: data
          mountPath: /data
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: demo-data-restored
RESTORE
  echo -e "${D}Waiting for restore...${N}"
  sleep 15
  echo ""
  echo -e "  ${W}Restored data:${N}"
  _kctl logs demo-reader 2>/dev/null || echo "  Still restoring..."

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: ZFS Snapshot → Restore Pipeline${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Original data:  ${G}written to PVC${N}"
  echo -e "  Snapshot:       ${G}instant ZFS snapshot${N}"
  echo -e "  Corruption:     ${R}data overwritten${N}"
  echo -e "  Restore:        ${G}new PVC from snapshot — original data back${N}"
  echo -e "  Time to restore:${G}<1 second (ZFS clone)${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 21: Replace Workers (nodes are cattle) ───────────────────
demo_replace_nodes() {
  header
  echo -e "${Y}=== Replace 2 Workers — Nodes Are Cattle ===${N}"
  echo ""

  # Pick 2 highest-numbered workers
  local workers=()
  while IFS= read -r w; do
    workers+=("$w")
  done < <(_kctl get nodes --no-headers 2>/dev/null | grep -v control-plane | awk '{print $1}' | sort -t- -k3 -n | tail -2)

  if [[ ${#workers[@]} -lt 2 ]]; then
    echo -e "${R}Need at least 2 workers to replace${N}"
    pause; return
  fi

  local w1="${workers[0]}" w2="${workers[1]}"
  echo -e "  Targets: ${R}${w1}${N} and ${R}${w2}${N}"
  echo ""

  local START_TIME
  START_TIME=$(date +%s)

  # Step 1: Drain
  echo -e "  ${W}Step 1: Drain pods off both workers${N}"
  _kctl drain "$w1" --ignore-daemonsets --delete-emptydir-data --force --timeout=60s 2>/dev/null || true
  _kctl drain "$w2" --ignore-daemonsets --delete-emptydir-data --force --timeout=60s 2>/dev/null || true
  echo -e "    ${G}Pods migrated to remaining nodes${N}"
  echo ""

  # Step 2: Remove from cluster
  echo -e "  ${W}Step 2: Remove from cluster${N}"
  _kctl delete node "$w1" --force 2>/dev/null || true
  _kctl delete node "$w2" --force 2>/dev/null || true
  echo -e "    ${G}Nodes removed${N}"
  echo ""

  # Step 3: Destroy VMs + ZFS
  echo -e "  ${W}Step 3: Destroy VMs + ZFS zvols${N}"
  virsh destroy "$w1" 2>/dev/null || true
  virsh undefine "$w1" 2>/dev/null || true
  zfs destroy -Rf "rpool/vms/${w1}" 2>/dev/null || true
  virsh destroy "$w2" 2>/dev/null || true
  virsh undefine "$w2" 2>/dev/null || true
  zfs destroy -Rf "rpool/vms/${w2}" 2>/dev/null || true
  echo -e "    ${G}VMs and zvols destroyed${N}"
  echo ""

  # Step 4: Clone fresh replacements
  echo -e "  ${W}Step 4: Clone fresh replacements from golden${N}"
  local S E
  S=$(date +%s%N)
  kvm-clone k8s-golden "$w1" >/dev/null 2>&1
  E=$(date +%s%N)
  echo -e "    k8s-golden → ${G}${w1}${N} (${C}$(( (E-S)/1000000 ))ms${N})"

  S=$(date +%s%N)
  kvm-clone k8s-golden "$w2" >/dev/null 2>&1
  E=$(date +%s%N)
  echo -e "    k8s-golden → ${G}${w2}${N} (${C}$(( (E-S)/1000000 ))ms${N})"
  echo ""

  # Step 5: Boot
  echo -e "  ${W}Step 5: Boot replacements${N}"
  virsh start "$w1" 2>/dev/null && echo -e "    ${G}${w1} started${N}" || true
  virsh start "$w2" 2>/dev/null && echo -e "    ${G}${w2} started${N}" || true
  echo -e "  ${D}Waiting for boot (30s)...${N}"
  sleep 30

  # Step 6: Set hostname + join + WireGuard
  local join_cmd
  join_cmd="$(_ssh_cp 'kubeadm token create --print-join-command 2>/dev/null')"

  for name in "$w1" "$w2"; do
    local ip
    local mac
    mac="$(virsh domiflist "$name" 2>/dev/null | awk '/bridge/ {print $5}' | head -1)"
    ip="$(virsh net-dhcp-leases default 2>/dev/null | grep "$mac" | awk '{print $5}' | cut -d/ -f1 | head -1)"
    if [[ -z "$ip" ]]; then
      echo -e "  ${Y}${name}: could not get IP${N}"
      continue
    fi

    echo -e "  ${W}Step 6: Configure ${name} (${ip})${N}"
    sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 "root@${ip}" \
      "hostnamectl set-hostname ${name}; rm -f /etc/machine-id; systemd-machine-id-setup; systemctl restart systemd-networkd 2>/dev/null || true" 2>/dev/null || true

    if [[ -n "$join_cmd" ]]; then
      sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 "root@${ip}" \
        "kubeadm reset -f 2>/dev/null; ${join_cmd}" 2>/dev/null \
        && echo -e "    ${G}${name} joined cluster${N}" \
        || echo -e "    ${Y}${name} join failed${N}"
    fi

    # WireGuard — scan VMs for highest ID to avoid collisions
    if sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "root@${ip}" \
        "command -v wg >/dev/null 2>&1" 2>/dev/null; then
      local max_id=0
      for vm in $(virsh list --name 2>/dev/null | grep -v '^$'); do
        local vmac vip vid
        vmac="$(virsh domiflist "$vm" 2>/dev/null | awk '/bridge/ {print $5}' | head -1)"
        vip="$(virsh net-dhcp-leases default 2>/dev/null | awk -v m="$vmac" '$3 == m {print $5}' | cut -d/ -f1 | head -1)"
        [[ -z "$vip" ]] && continue
        vid="$(sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=3 "root@${vip}" \
          'grep -o "10\.251\.[0-9]*\.[0-9]*" /etc/wireguard/wg-k8s.conf 2>/dev/null | head -1' 2>/dev/null)" || continue
        vid="${vid##*.}"
        [[ -n "$vid" && "$vid" -gt "$max_id" ]] && max_id="$vid"
      done
      local new_id=$((max_id + 1))

      sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" "kube-network init ${new_id}" 2>/dev/null || true
      local new_pub cp_pub cp_lan
      new_pub="$(sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" 'cat /etc/wireguard/wg-mgmt.pub' 2>/dev/null)"
      cp_pub="$(_ssh_cp 'cat /etc/wireguard/wg-mgmt.pub 2>/dev/null')"
      cp_lan="$(_ssh_cp 'ip -4 route get 1.1.1.1 2>/dev/null | awk "{print \$7}" | head -1')"

      if [[ -n "$new_pub" && -n "$cp_pub" ]]; then
        _ssh_cp "kube-network add-peer ${ip} ${new_pub} ${new_id}" 2>/dev/null || true
        sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" \
          "kube-network add-peer ${cp_lan} ${cp_pub} 1" 2>/dev/null || true
        sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ip}" "kube-network pin-kubelet && systemctl restart kubelet" 2>/dev/null || true
        echo -e "    ${G}WireGuard: ${name} → 10.251.0.${new_id}${N}"
      fi
    fi

    _kctl label node "$name" node-role.kubernetes.io/worker= --overwrite 2>/dev/null || true
  done

  echo -e "${D}Waiting for nodes to register (20s)...${N}"
  sleep 20

  local END_TIME
  END_TIME=$(date +%s)
  local ELAPSED=$(( END_TIME - START_TIME ))

  echo ""
  echo -e "${Y}=== Cluster After Replacement ===${N}"
  _kctl get nodes -o wide

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Nodes Are Cattle${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Replaced:       ${G}${w1}, ${w2}${N}"
  echo -e "  Total time:     ${G}${ELAPSED} seconds${N}"
  echo -e "  Pods lost:      ${G}zero (migrated before destroy)${N}"
  echo -e "  Data lost:      ${G}zero (PVs on surviving nodes)${N}"
  echo -e "  Clone cost:     ${G}<100ms each, 0 bytes disk${N}"
  echo -e "  Manual steps:   ${G}none${N}"
  echo -e ""
  echo -e "  ${W}Traditional:${N}  ${R}rebuild VM (20min), reinstall packages,${N}"
  echo -e "                ${R}reconfigure, rejoin cluster, pray${N}"
  echo -e ""
  echo -e "  ${W}kldload:${N}      ${G}destroy → clone → boot → join → done${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 22: eBPF Deep Dive ───────────────────────────────────────
demo_ebpf_deep_dive() {
  header
  echo -e "${Y}=== Cilium BPF Endpoint Map ===${N}"
  echo -e "${D}Every pod endpoint — tracked in a BPF map, not a userland database.${N}"
  echo ""
  _cilium_dbg bpf endpoint list || echo "  N/A"

  echo ""
  echo -e "${Y}=== Cilium BPF Conntrack Table ===${N}"
  echo -e "${D}Connection tracking — in the kernel, not conntrack-tools, not iptables.${N}"
  echo ""
  _cilium_dbg bpf ct list global 2>/dev/null | head -20 || echo "  N/A"

  echo ""
  echo -e "${Y}=== Cilium BPF NAT Table ===${N}"
  echo -e "${D}NAT — in the kernel. No iptables NAT chain. No kube-proxy.${N}"
  echo ""
  _cilium_dbg bpf nat list 2>/dev/null | head -20 || echo "  N/A"

  echo ""
  echo -e "${Y}=== Cilium BPF LB Service Map ===${N}"
  echo -e "${D}Service load balancing — kernel map, not userland proxy.${N}"
  echo ""
  _cilium_dbg bpf lb list 2>/dev/null | head -20 || echo "  N/A"

  echo ""
  echo -e "${Y}=== Cilium BPF Policy Map ===${N}"
  echo -e "${D}Network policy enforcement — BPF map, evaluated per-packet in kernel.${N}"
  echo ""
  _cilium_dbg bpf policy get --all 2>/dev/null | head -20 || echo "  N/A"

  echo ""
  echo -e "${Y}=== Cilium Status — Datapath ===${N}"
  _cilium_dbg status 2>/dev/null | grep -E 'KubeProxy|Datapath|Masq|Host Routing' || echo "  N/A"

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: 100% Kernel eBPF Datapath${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  eBPF programs:  ${G}loaded in kernel, attached via tc${N}"
  echo -e "  Conntrack:      ${G}BPF map (not iptables conntrack)${N}"
  echo -e "  NAT:            ${G}BPF map (not iptables NAT)${N}"
  echo -e "  Load balancing: ${G}BPF map (not kube-proxy)${N}"
  echo -e "  Policy:         ${G}BPF map (evaluated per-packet in kernel)${N}"
  echo -e "  Sidecars:       ${R}zero${N}"
  echo -e "  Userland proxy: ${R}none${N}"
  echo -e "  iptables rules: ${R}none${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 23: Zero Sidecar Proof ───────────────────────────────────
demo_zero_sidecar() {
  header
  echo -e "${Y}=== Container Count Per Pod (should be 1 everywhere) ===${N}"
  echo -e "${D}Sidecars = extra containers. We have ZERO.${N}"
  echo ""
  _ssh_cp "kubectl get pods -A -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{\"  containers: \"}{range .spec.containers[*]}{.name}{\" \"}{end}{\"\n\"}{end}' 2>/dev/null | head -30" || echo "  N/A"

  echo ""
  echo -e "${Y}=== kube-proxy: Does it exist? ===${N}"
  echo -e "${D}In a traditional cluster, kube-proxy runs on every node. Here:${N}"
  echo ""
  local kp_count
  kp_count="$(_kctl get pods -A -l k8s-app=kube-proxy --no-headers 2>/dev/null | wc -l)"
  if [[ "$kp_count" -eq 0 ]]; then
    echo -e "  kube-proxy pods: ${G}0 — REPLACED by eBPF${N}"
  else
    echo -e "  kube-proxy pods: ${R}${kp_count} (should be 0)${N}"
  fi

  echo ""
  echo -e "${Y}=== iptables NAT Rules (should be near-zero) ===${N}"
  echo -e "${D}Traditional K8s: hundreds of iptables rules. Cilium eBPF:${N}"
  echo ""
  local nat_rules
  nat_rules="$(_ssh_cp "iptables -t nat -L 2>/dev/null | wc -l")"
  echo -e "  iptables NAT rule lines: ${G}${nat_rules:-0}${N}"
  _ssh_cp "iptables -t nat -L 2>/dev/null | head -15" || echo "  (clean)"

  echo ""
  echo -e "${Y}=== iptables Filter Rules ===${N}"
  local filter_rules
  filter_rules="$(_ssh_cp "iptables -t filter -L 2>/dev/null | wc -l")"
  echo -e "  iptables filter rule lines: ${G}${filter_rules:-0}${N}"
  _ssh_cp "iptables -t filter -L 2>/dev/null | head -15" || echo "  (clean)"

  echo ""
  echo -e "${Y}=== Userland Network Processes ===${N}"
  echo -e "${D}What's running? No envoy, no istio, no linkerd, no nginx ingress controller:${N}"
  echo ""
  _ssh_cp "ps aux 2>/dev/null | grep -E 'istio|linkerd|nginx-ingress|kube-proxy|flannel|calico' | grep -v grep" \
    && echo -e "  ${R}^^^ FOUND userland networking — something is wrong${N}" \
    || echo -e "  ${G}NONE. Zero userland networking processes.${N}"
  echo ""
  echo -e "${D}  Note: cilium-envoy is Cilium's L7 proxy DaemonSet — it's part of Cilium,${N}"
  echo -e "${D}  not a sidecar. It handles Gateway API/L7 policy in kernel via eBPF hooks.${N}"

  echo ""
  echo -e "${Y}=== What IS Running (Cilium Agent) ===${N}"
  echo -e "${D}The only networking process — it configures eBPF maps then gets out of the way:${N}"
  echo ""
  _ssh_cp "ps aux 2>/dev/null | grep 'cilium-agent' | grep -v grep" || echo "  N/A"

  echo ""
  echo -e "${Y}=== Cilium Status — Datapath Mode ===${N}"
  _cilium_dbg status 2>/dev/null | grep -E 'KubeProxy|Datapath|Masquerading|Host|Encryption' || echo "  N/A"

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Zero Sidecars, Zero Userland Networking${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Sidecar containers:    ${G}0${N} (every pod has exactly 1 container)"
  echo -e "  kube-proxy:            ${G}not installed${N} — replaced by eBPF"
  echo -e "  iptables NAT rules:    ${G}${nat_rules:-0} lines${N} (traditional: 500+)"
  echo -e "  envoy/istio/linkerd:   ${G}not running${N}"
  echo -e "  flannel/calico:        ${G}not running${N}"
  echo -e "  Userland proxies:      ${G}none${N}"
  echo -e ""
  echo -e "  ${W}The kernel IS the network.${N}"
  echo -e "  ${D}Cilium agent loads BPF programs, then the kernel does the rest.${N}"
  echo -e "  ${D}Every packet — routed, NATed, load-balanced, policy-checked${N}"
  echo -e "  ${D}— without EVER leaving kernel space.${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 24: Kernel Datapath Trace ────────────────────────────────
demo_datapath_trace() {
  header
  echo -e "${Y}=== Kernel Datapath Trace ===${N}"
  echo -e "${D}Watch a packet traverse the eBPF datapath — entirely in kernel.${N}"
  echo -e "${D}Deploying a test pod and curling a service while tracing...${N}"
  echo ""

  # Make sure we have a target service
  _kctl create deployment trace-web --image=nginx:alpine --replicas=1 2>/dev/null || true
  _kctl expose deployment trace-web --port=80 2>/dev/null || true
  echo -e "${D}Waiting for trace-web pod to be ready...${N}"
  _kctl wait --for=condition=ready pod -l app=trace-web --timeout=30s 2>/dev/null || true
  echo ""

  echo -e "${Y}=== Cilium Endpoint List ===${N}"
  echo -e "${D}Each endpoint has its own BPF program chain:${N}"
  echo ""
  _cilium_dbg endpoint list || echo "  N/A"
  echo ""

  echo -e "${Y}=== Tracing Live Traffic Through eBPF ===${N}"
  echo -e "${D}Starting cilium monitor (10 seconds) — generating traffic in background...${N}"
  echo ""

  # Generate traffic in background
  (
    sleep 2
    _kctl run trace-curl --image=busybox --restart=Never --command -- \
      sh -c 'for i in 1 2 3 4 5; do wget -qO- http://trace-web 2>/dev/null; sleep 1; done' 2>/dev/null || true
  ) &
  local traffic_pid=$!

  # Capture eBPF datapath events via kubectl exec into cilium pod
  _kctl exec -n kube-system ds/cilium -c cilium-agent -- \
    timeout 10 cilium-dbg monitor --type trace --type drop 2>&1 | head -60 || \
    echo "  cilium monitor not available"

  wait "$traffic_pid" 2>/dev/null || true

  echo ""
  echo -e "${Y}=== Cilium BPF Conntrack — Proof These Flows Exist ===${N}"
  echo -e "${D}The connections we just made — tracked in a BPF map, not iptables:${N}"
  echo ""
  _cilium_dbg bpf ct list global 2>/dev/null | grep ':80' | head -10 || echo "  N/A"

  # Cleanup
  _kctl delete deployment trace-web --grace-period=0 2>/dev/null || true
  _kctl delete svc trace-web 2>/dev/null || true
  _kctl delete pod trace-curl --grace-period=0 --force 2>/dev/null || true

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Packet Never Leaves the Kernel${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Trace shows:    ${G}packet enters veth → BPF program chain${N}"
  echo -e "  Conntrack:      ${G}BPF map (kernel memory)${N}"
  echo -e "  NAT:            ${G}BPF map (kernel memory)${N}"
  echo -e "  Service lookup: ${G}BPF map (kernel memory)${N}"
  echo -e "  Policy check:   ${G}BPF map (kernel memory)${N}"
  echo -e "  Forwarding:     ${G}BPF redirect (kernel, no netfilter)${N}"
  echo -e ""
  echo -e "  ${W}What traditional CNIs do:${N}"
  echo -e "  ${R}packet → userland proxy → iptables → conntrack → NAT → forward${N}"
  echo -e "  ${R}= context switches, copies, overhead on every single packet${N}"
  echo -e ""
  echo -e "  ${W}What Cilium eBPF does:${N}"
  echo -e "  ${G}packet → BPF program → done${N}"
  echo -e "  ${G}= one kernel function call, zero copies, zero context switches${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 99: Smoke Test ────────────────────────────────────────────
demo_smoke() {
  header
  echo -e "${Y}=== Running Full Smoke Test on Control Plane ===${N}"
  echo ""
  _ssh_cp "kube-smoke-test" || echo "kube-smoke-test not available on CP"
  pause
}

# ── 0: Cleanup ────────────────────────────────────────────────
demo_cleanup() {
  echo -ne "${Y}Cleaning up ALL demo resources...${N} "
  _kctl delete deployment demo-web nginx-fleet scale-test rolling-demo heal-demo 2>/dev/null || true
  _kctl delete svc demo-web nginx-fleet rolling-demo 2>/dev/null || true
  _kctl delete gateway demo-gateway 2>/dev/null || true
  _kctl delete httproute demo-route 2>/dev/null || true
  _kctl delete pod demo-writer demo-reader demo-db-writer test-pod 2>/dev/null || true
  _kctl delete pvc demo-data demo-data-restored demo-db 2>/dev/null || true
  _kctl delete volumesnapshot demo-data-snap 2>/dev/null || true
  _kctl delete networkpolicy deny-all allow-client -n netpol-demo 2>/dev/null || true
  _kctl delete pod web client -n netpol-demo 2>/dev/null || true
  _kctl delete svc web -n netpol-demo 2>/dev/null || true
  _kctl delete namespace netpol-demo 2>/dev/null || true
  _kctl delete deployment trace-web 2>/dev/null || true
  _kctl delete svc trace-web 2>/dev/null || true
  _kctl delete pod trace-curl 2>/dev/null || true
  # Clean up rollback snapshots
  for snap in $(zfs list -H -o name -t snapshot -r rpool/vms 2>/dev/null | grep demo-rollback); do
    zfs destroy "$snap" 2>/dev/null
  done
  echo -e "${G}done${N}"
  pause
}

# ── Main Loop ─────────────────────────────────────────────────
_find_cp || { echo -e "${R}No Kubernetes control plane found.${N}"; echo "Run: kube-cluster bootstrap --workers 3"; exit 1; }

while true; do
  menu
  read -r c
  case $c in
    1)  demo_overview ;;
    2)  demo_zfs_clones ;;
    3)  demo_add_nodes ;;
    4)  demo_cilium ;;
    5)  demo_connectivity ;;
    6)  demo_hubble ;;
    7)  demo_coredns ;;
    8)  demo_netpol ;;
    9)  demo_metallb ;;
    10) demo_gateway ;;
    11) demo_zfs_pvc ;;
    12) demo_snapshot_restore ;;
    13) demo_db_pvc ;;
    14) demo_nginx ;;
    15) demo_pod_dns ;;
    16) demo_scale ;;
    17) demo_rolling_update ;;
    18) demo_self_heal ;;
    19) demo_drain ;;
    20) demo_node_rollback ;;
    21) demo_replace_nodes ;;
    22) demo_ebpf_deep_dive ;;
