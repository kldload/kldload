#!/usr/bin/env bash
# kldload 1.0.4 — Kubernetes Demo
# Shows the full K8s stack running on ZFS instant clones
set -uo pipefail

if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

B="\033[1;34m"; G="\033[1;32m"; C="\033[1;36m"; Y="\033[1;33m"
R="\033[1;31m"; W="\033[1;37m"; D="\033[0;37m"; N="\033[0m"

# ── Detect cluster ─────────────────────────────────────────
CP_IP=""
_find_cp() {
  # Check if we ARE the control plane
  if [[ -f /etc/kubernetes/admin.conf ]]; then
    CP_IP="localhost"
    export KUBECONFIG=/etc/kubernetes/admin.conf
    return 0
  fi
  # Check VMs for control plane
  for vm in $(virsh list --name 2>/dev/null | grep -v '^$'); do
    local mac ip
    mac="$(virsh domiflist "$vm" 2>/dev/null | awk '/bridge/ {print $5}')"
    ip="$(virsh net-dhcp-leases default 2>/dev/null | grep "$mac" | awk '{print $5}' | cut -d/ -f1)"
    if [[ -n "$ip" ]] && sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=3 \
      "root@${ip}" "test -f /etc/kubernetes/admin.conf" 2>/dev/null; then
      CP_IP="$ip"
      return 0
    fi
  done
  return 1
}

# Run kubectl on CP (local or remote)
_kctl() {
  if [[ "$CP_IP" == "localhost" ]]; then
    kubectl "$@" 2>/dev/null
  else
    sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 \
      "root@${CP_IP}" "kubectl $*" 2>/dev/null
  fi
}

_ssh_cp() {
  if [[ "$CP_IP" == "localhost" ]]; then
    bash -c "$*" 2>/dev/null
  else
    sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 \
      "root@${CP_IP}" "$*" 2>/dev/null
  fi
}

pause() { echo ""; echo -e "${D}Press Enter...${N}"; read -r; }

header() {
  clear
  local nodes
  nodes="$(_kctl get nodes --no-headers 2>/dev/null | wc -l)"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}   kldload 1.0.4 — Kubernetes on ZFS                        ${N}"
  echo -e "${D}   ${nodes} nodes • Cilium eBPF • Hubble • MetalLB • ZFS CSI       ${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
}

menu() {
  header
  echo -e "  ${C}── Cluster ─────────────────────────────────────────────${N}"
  echo -e "  ${G} 1${N}  Cluster overview (nodes, versions, IPs)"
  echo -e "  ${G} 2${N}  ZFS clone proof (clone times + disk cost)"
  echo ""
  echo -e "  ${C}── Networking (Cilium) ─────────────────────────────────${N}"
  echo -e "  ${G} 3${N}  Cilium status + eBPF maps"
  echo -e "  ${G} 4${N}  Cilium connectivity test"
  echo -e "  ${G} 5${N}  Hubble — live network flows"
  echo ""
  echo -e "  ${C}── Services ────────────────────────────────────────────${N}"
  echo -e "  ${G} 6${N}  MetalLB — deploy LoadBalancer service"
  echo -e "  ${G} 7${N}  Gateway API — deploy HTTP ingress"
  echo ""
  echo -e "  ${C}── Storage (ZFS CSI) ──────────────────────────────────${N}"
  echo -e "  ${G} 8${N}  Create PVC — watch ZFS dataset appear"
  echo -e "  ${G} 9${N}  Snapshot a PV (VolumeSnapshot)"
  echo ""
  echo -e "  ${C}── Workloads ───────────────────────────────────────────${N}"
  echo -e "  ${G}10${N}  Deploy nginx fleet (3 replicas)"
  echo -e "  ${G}11${N}  Pod scheduling test + DNS"
  echo -e "  ${G}12${N}  Scale test — 20 pods across all workers"
  echo ""
  echo -e "  ${C}── Full Audit ──────────────────────────────────────────${N}"
  echo -e "  ${G}99${N}  Smoke test (all checks)"
  echo ""
  echo -e "  ${R} 0${N}  Clean up demo resources"
  echo -e "  ${R} q${N}  Quit"
  echo ""
  echo -ne "${W}  Select: ${N}"
}

# ── 1: Cluster Overview ───────────────────────────────────────
demo_overview() {
  header
  echo -e "${Y}=== Nodes ===${N}"
  _kctl get nodes -o wide
  echo ""
  echo -e "${Y}=== System Pods ===${N}"
  _kctl get pods -A -o wide | head -25
  echo ""
  echo -e "${Y}=== Namespaces ===${N}"
  _kctl get ns
  echo ""
  echo -e "${Y}=== Versions ===${N}"
  local kver cver
  kver="$(_kctl version -o yaml 2>/dev/null | grep gitVersion | head -1 | awk '{print $2}')"
  cver="$(_ssh_cp 'cilium version --client 2>/dev/null | head -1')"
  echo -e "  Kubernetes:  ${G}${kver}${N}"
  echo -e "  Cilium CLI:  ${G}${cver}${N}"
  echo -e "  Hubble:      ${G}$(_kctl get deploy -n kube-system hubble-relay -o jsonpath='{.status.readyReplicas}' 2>/dev/null)/1 ready${N}"
  echo -e "  MetalLB:     ${G}$(_kctl get deploy -n metallb-system metallb-controller -o jsonpath='{.status.readyReplicas}' 2>/dev/null)/1 ready${N}"

  local node_count ready_count
  node_count="$(_kctl get nodes --no-headers | wc -l)"
  ready_count="$(_kctl get nodes --no-headers | grep -c ' Ready')"
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Production Kubernetes Cluster${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Nodes:          ${G}${ready_count}/${node_count} Ready${N}"
  echo -e "  CNI:            ${G}Cilium (eBPF, replaces kube-proxy)${N}"
  echo -e "  Ingress:        ${G}Cilium Gateway API${N}"
  echo -e "  Load Balancer:  ${G}MetalLB (L2 mode)${N}"
  echo -e "  Observability:  ${G}Hubble (relay + UI)${N}"
  echo -e "  Backing store:  ${G}ZFS zvols (instant clone, ~75ms per node)${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 2: ZFS Clone Proof ────────────────────────────────────────
demo_zfs_clones() {
  header
  echo -e "${Y}=== ZFS Zvols (K8s Node Disks) ===${N}"
  zfs list -o name,used,refer,volsize -r rpool/vms -t all 2>/dev/null || echo "  No rpool/vms"
  echo ""

  echo -e "${Y}=== Disk Cost ===${N}"
  echo -e "  ${W}NODE              USED      PROVISIONED${N}"
  echo -e "  ────────────────  ────────  ───────────"
  for ds in $(zfs list -H -o name -t volume -r rpool/vms 2>/dev/null | grep -v golden); do
    local name used volsize
    name="$(basename "$ds")"
    used="$(zfs list -H -o used "$ds" 2>/dev/null)"
    volsize="$(zfs list -H -o volsize "$ds" 2>/dev/null)"
    echo -e "  ${G}${name}${N}$(printf '%*s' $((16 - ${#name})) '')${used}     ${volsize}"
  done
  local golden_used
  golden_used="$(zfs list -H -o used rpool/vms/k8s-golden 2>/dev/null)"
  echo ""
  echo -e "  Golden image:   ${C}${golden_used}${N} (source for all clones)"

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: ZFS Instant Cloning for Kubernetes${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Clone time:     ${G}<100ms per node${N}"
  echo -e "  Disk per clone: ${G}~0 bytes (copy-on-write)${N}"
  echo -e "  Golden image:   ${G}${golden_used} (shared by all nodes)${N}"
  echo -e "  Rebuild cluster:${G}destroy + re-clone in seconds${N}"
  echo -e "  Proxmox clone:  ${R}~2 min + full disk copy per node${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 3: Cilium Status ──────────────────────────────────────────
demo_cilium() {
  header
  echo -e "${Y}=== Cilium Status ===${N}"
  _ssh_cp "cilium status" || echo "  cilium CLI not available on CP"
  echo ""
  echo -e "${Y}=== Cilium Pods ===${N}"
  _kctl get pods -n kube-system -l k8s-app=cilium -o wide
  echo ""
  echo -e "${Y}=== eBPF Maps ===${N}"
  _ssh_cp "cilium bpf endpoint list 2>/dev/null | head -15" || echo "  N/A"

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Cilium eBPF Networking${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  kube-proxy:     ${G}replaced by eBPF${N} (no iptables rules)"
  echo -e "  Network policy: ${G}enforced in kernel${N} (not userland)"
  echo -e "  Observability:  ${G}Hubble sees every flow${N}"
  echo -e "  Gateway API:    ${G}native ingress (no nginx)${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 4: Connectivity Test ──────────────────────────────────────
demo_connectivity() {
  header
  echo -e "${Y}=== Cilium Connectivity Test ===${N}"
  echo -e "${D}Testing pod-to-pod, pod-to-service, pod-to-external...${N}"
  echo ""
  _ssh_cp "cilium connectivity test --test pod-to-pod --test pod-to-service 2>&1 | tail -20" \
    || echo "  Connectivity test not available"
  pause
}

# ── 5: Hubble ─────────────────────────────────────────────────
demo_hubble() {
  header
  echo -e "${Y}=== Hubble Status ===${N}"
  _ssh_cp "hubble status 2>/dev/null" || _kctl get deploy -n kube-system hubble-relay
  echo ""
  echo -e "${Y}=== Live Network Flows (5 seconds) ===${N}"
  echo -e "${D}Watching all pod traffic in real time...${N}"
  echo ""
  _ssh_cp "timeout 5 hubble observe --last 20 2>/dev/null" || echo "  Hubble CLI not available — use UI instead"
  echo ""
  echo -e "${Y}=== Hubble UI ===${N}"
  echo -e "  ${C}kubectl port-forward -n kube-system svc/hubble-ui 12000:80${N}"
  echo -e "  Then open: ${G}http://localhost:12000${N}"

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Hubble Network Observability${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Every DNS query:    ${G}visible${N}"
  echo -e "  Every HTTP request: ${G}visible${N}"
  echo -e "  Every TCP flow:     ${G}visible${N}"
  echo -e "  Every policy drop:  ${G}visible${N}"
  echo -e "  Agents required:    ${G}none${N} (kernel-native via eBPF)"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 6: MetalLB ────────────────────────────────────────────────
demo_metallb() {
  header
  echo -e "${Y}=== MetalLB Status ===${N}"
  _kctl get pods -n metallb-system
  echo ""
  echo -e "${Y}=== IP Address Pool ===${N}"
  _kctl get ipaddresspool -n metallb-system -o yaml 2>/dev/null | grep -A5 "addresses:" || echo "  No pool configured"
  echo ""

  echo -e "${Y}=== Deploy LoadBalancer Service ===${N}"
  _kctl create deployment demo-web --image=nginx --replicas=2 2>/dev/null || true
  _kctl expose deployment demo-web --type=LoadBalancer --port=80 2>/dev/null || true
  sleep 5

  echo ""
  echo -e "${Y}=== Service ===${N}"
  _kctl get svc demo-web
  local ext_ip
  ext_ip="$(_kctl get svc demo-web -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null)"
  if [[ -n "$ext_ip" ]]; then
    echo ""
    echo -e "  External IP: ${G}${ext_ip}${N}"
    echo -e "  curl http://${ext_ip}:"
    curl -s --connect-timeout 3 "http://${ext_ip}" 2>/dev/null | head -5 || echo "  (not reachable from host)"
  fi

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: MetalLB LoadBalancer on Bare Metal${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Service type:   ${G}LoadBalancer (not just NodePort)${N}"
  echo -e "  External IP:    ${G}${ext_ip:-pending}${N}"
  echo -e "  Cloud required: ${G}no${N} — L2 advertisement on your LAN"
  echo -e "  On vanilla K8s: ${R}LoadBalancer stays <pending> forever${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 7: Gateway API ────────────────────────────────────────────
demo_gateway() {
  header
  echo -e "${Y}=== Gateway API CRDs ===${N}"
  _kctl get gatewayclasses
  echo ""
  echo -e "${Y}=== Deploy HTTP Gateway ===${N}"
  _kctl apply -f - <<'GW' 2>/dev/null
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: demo-gateway
spec:
  gatewayClassName: cilium
  listeners:
    - name: http
      protocol: HTTP
      port: 8088
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: demo-route
spec:
  parentRefs:
    - name: demo-gateway
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: demo-web
          port: 80
GW
  sleep 3
  echo ""
  _kctl get gateway demo-gateway
  echo ""
  _kctl get httproute demo-route

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Cilium Gateway API (native ingress)${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Ingress controller: ${G}Cilium (eBPF, no nginx)${N}"
  echo -e "  API version:        ${G}gateway.networking.k8s.io/v1${N}"
  echo -e "  HTTP routing:       ${G}kernel-native via eBPF datapath${N}"
  echo -e "  Traditional:        ${R}nginx-ingress + ConfigMap hell${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 8: ZFS CSI PVC ────────────────────────────────────────────
demo_zfs_pvc() {
  header
  echo -e "${Y}=== Storage Classes ===${N}"
  _kctl get sc
  echo ""
  echo -e "${Y}=== Create PVC (50Gi, ZFS-backed) ===${N}"
  _kctl apply -f - <<'PVC' 2>/dev/null
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: demo-data
spec:
  storageClassName: zfs
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 50Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: demo-writer
spec:
  containers:
    - name: writer
      image: busybox
      command: ["sh", "-c", "echo 'ZFS-backed persistent data' > /data/test.txt && sleep 3600"]
      volumeMounts:
        - name: data
          mountPath: /data
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: demo-data
PVC
  echo ""
  echo -e "${D}Waiting for PVC to bind...${N}"
  sleep 10
  echo ""
  echo -e "${Y}=== PVC Status ===${N}"
  _kctl get pvc demo-data
  echo ""
  echo -e "${Y}=== PV (ZFS dataset) ===${N}"
  _kctl get pv 2>/dev/null | grep demo-data || echo "  PV not yet created"

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: ZFS-Backed Persistent Volumes${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  StorageClass:   ${G}zfs (default, 128K recordsize, lz4)${N}"
  echo -e "  Also available: ${G}zfs-db (8K recordsize, for databases)${N}"
  echo -e "  Every PV gets:  ${G}compression, checksums, snapshots${N}"
  echo -e "  VolumeSnapshot: ${G}real ZFS snapshot, not slow copy${N}"
  echo -e "  Traditional:    ${R}hostPath or cloud block (no snapshots)${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 9: Volume Snapshot ────────────────────────────────────────
demo_snapshot() {
  header
  echo -e "${Y}=== Snapshot PVC ===${N}"
  _kctl apply -f - <<'SNAP' 2>/dev/null
apiVersion: snapshot.storage.k8s.io/v1
kind: VolumeSnapshot
metadata:
  name: demo-data-snap
spec:
  volumeSnapshotClassName: zfs-snapshot
  source:
    persistentVolumeClaimName: demo-data
SNAP
  sleep 5
  _kctl get volumesnapshot demo-data-snap 2>/dev/null || echo "  VolumeSnapshot not available (ZFS CSI may not be installed)"
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: ZFS Snapshots for Kubernetes PVs${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Snapshot time:  ${G}instant (ZFS native)${N}"
  echo -e "  Disk cost:      ${G}0 bytes (copy-on-write)${N}"
  echo -e "  Restore:        ${G}clone the snapshot → new PV${N}"
  echo -e "  Use case:       ${G}snapshot before migration/upgrade${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 10: Nginx Fleet ───────────────────────────────────────────
demo_nginx() {
  header
  echo -e "${Y}=== Deploy nginx (3 replicas across workers) ===${N}"
  _kctl create deployment nginx-fleet --image=nginx --replicas=3 2>/dev/null || true
  _kctl expose deployment nginx-fleet --type=LoadBalancer --port=80 2>/dev/null || true
  sleep 8
  echo ""
  _kctl get pods -l app=nginx-fleet -o wide
  echo ""
  _kctl get svc nginx-fleet

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Workload Distribution${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Replicas:       ${G}3 nginx pods${N}"
  echo -e "  Spread across:  ${G}all worker nodes${N}"
  echo -e "  Service:        ${G}LoadBalancer (MetalLB)${N}"
  echo -e "  Nodes cloned:   ${G}<100ms each from golden image${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 11: Pod + DNS Test ────────────────────────────────────────
demo_pod_dns() {
  header
  echo -e "${Y}=== Pod Scheduling Test ===${N}"
  _kctl run test-pod --image=busybox --restart=Never --command -- sleep 30 2>/dev/null || true
  sleep 5
  _kctl get pod test-pod -o wide
  echo ""

  echo -e "${Y}=== DNS Resolution Test ===${N}"
  _kctl exec test-pod -- nslookup kubernetes.default.svc.cluster.local 2>/dev/null || echo "  DNS test running..."
  echo ""

  _kctl delete pod test-pod --grace-period=0 --force 2>/dev/null &

  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Cluster Fundamentals${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Pod scheduling: ${G}works${N}"
  echo -e "  DNS resolution: ${G}kubernetes.default resolves${N}"
  echo -e "  CoreDNS:        ${G}running${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 12: Scale Test ────────────────────────────────────────────
demo_scale() {
  header
  echo -e "${Y}=== Scale Test — 20 Pods ===${N}"
  _kctl create deployment scale-test --image=nginx --replicas=20 2>/dev/null || \
    _kctl scale deployment scale-test --replicas=20 2>/dev/null
  echo -e "${D}Waiting for pods to schedule...${N}"
  sleep 15
  echo ""
  echo -e "${Y}=== Pod Distribution ===${N}"
  _kctl get pods -l app=scale-test -o wide --no-headers | awk '{print $7}' | sort | uniq -c | sort -rn
  echo ""
  echo -e "${Y}=== All Pods ===${N}"
  _kctl get pods -l app=scale-test -o wide | head -25

  local total ready
  total="$(_kctl get pods -l app=scale-test --no-headers | wc -l)"
  ready="$(_kctl get pods -l app=scale-test --no-headers | grep -c Running)"
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  PROOF: Cluster Scale${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Pods requested: ${G}20${N}"
  echo -e "  Pods running:   ${G}${ready}/${total}${N}"
  echo -e "  Spread across:  ${G}all available nodes${N}"
  echo -e "  Node clone time:${G}<100ms (add more nodes instantly)${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  pause
}

# ── 99: Smoke Test ────────────────────────────────────────────
demo_smoke() {
  header
  echo -e "${Y}=== Running Full Smoke Test on Control Plane ===${N}"
  echo ""
  _ssh_cp "kube-smoke-test" || echo "kube-smoke-test not available on CP"
  pause
}

# ── 0: Cleanup ────────────────────────────────────────────────
demo_cleanup() {
  echo -ne "${Y}Cleaning up demo resources...${N} "
  _kctl delete deployment demo-web nginx-fleet scale-test 2>/dev/null || true
  _kctl delete svc demo-web nginx-fleet 2>/dev/null || true
  _kctl delete gateway demo-gateway 2>/dev/null || true
  _kctl delete httproute demo-route 2>/dev/null || true
  _kctl delete pod demo-writer test-pod 2>/dev/null || true
  _kctl delete pvc demo-data 2>/dev/null || true
  _kctl delete volumesnapshot demo-data-snap 2>/dev/null || true
  echo -e "${G}done${N}"
  pause
}

# ── Main Loop ─────────────────────────────────────────────────
_find_cp || { echo -e "${R}No Kubernetes control plane found.${N}"; echo "Run: kube-cluster bootstrap --workers 3"; exit 1; }

while true; do
  menu
  read -r c
  case $c in
    1)  demo_overview ;;
    2)  demo_zfs_clones ;;
    3)  demo_cilium ;;
    4)  demo_connectivity ;;
    5)  demo_hubble ;;
    6)  demo_metallb ;;
    7)  demo_gateway ;;
    8)  demo_zfs_pvc ;;
    9)  demo_snapshot ;;
    10) demo_nginx ;;
    11) demo_pod_dns ;;
    12) demo_scale ;;
    99) demo_smoke ;;
    0)  demo_cleanup ;;
    q)  echo ""; exit 0 ;;
    *)  echo -e "${R}Invalid option${N}"; sleep 1 ;;
  esac
done
