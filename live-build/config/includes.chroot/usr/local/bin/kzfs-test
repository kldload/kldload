#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════════
# kzfs-test — OpenZFS Test Lab
# ══════════════════════════════════════════════════════════════════════════
#
# OpenZFS Test Lab — runs zfs-tests.sh across 7 Linux distros in parallel
# using ZFS instant clones on KVM. Each distro VM is cloned from a sealed
# golden image in ~75ms, booted, tested, and destroyed.
#
# Distros:  CentOS Stream 9, Rocky 9, Fedora 44, Debian 13, Ubuntu 24.04,
#           Arch Linux, Alpine Linux
#
# Usage:
#   kzfs-test golden [distro|all]            Build golden images
#   kzfs-test run [--quick|--full] [--distro d1,d2,...]  Run tests
#   kzfs-test status                         Show VMs, goldens, running tests
#   kzfs-test results [run-id]               Show test matrix from last run
#   kzfs-test destroy [--all]                Destroy test VMs (--all = goldens too)
#   kzfs-test verify [distro|all]            Quick smoke test — ZFS loads? tests exist?
set -uo pipefail

if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

# ── Configuration ─────────────────────────────────────────────────────────
POOL="${POOL:-rpool}"
PREFIX="kzfstest"
SSH_KEY="${SSH_KEY:-/root/.ssh/id_ed25519}"
ISO_DIR="/var/lib/libvirt/isos"
RESULTS_DIR="/root/kzfs-test"
MASTER_LOG="${RESULTS_DIR}/kzfs-test.log"

# ZFS source mode: "repo" (default), "version:X.Y.Z", "git:owner/repo@ref", "tarball:/path"
ZFS_SOURCE="${ZFS_SOURCE:-repo}"

DISTROS=(centos rocky fedora debian ubuntu rhel)

# RHEL credentials — prompted at runtime, never logged or stored on disk
RHEL_USERNAME="${RHEL_USERNAME:-}"
RHEL_PASSWORD="${RHEL_PASSWORD:-}"
RHEL_CREDS_FILE="/root/.kzfs-rhel-creds"

# Arch and Alpine are deliberately absent. A rolling release has no stable
# kernel to build a module against — it moves between the image being fetched
# and the module being compiled — so there is no install path that reliably
# produces a working ZFS, and a result from a guest where the module failed to
# build says nothing about ZFS (operator, 2026-08-15). They were listed here
# but never in DISTROS, which made them look supported to anything reading the
# image map instead of the matrix.
declare -A CLOUD_IMAGES=(
    [centos]="https://cloud.centos.org/centos/9-stream/x86_64/images/CentOS-Stream-GenericCloud-9-latest.x86_64.qcow2"
    [rocky]="https://dl.rockylinux.org/pub/rocky/9/images/x86_64/Rocky-9-GenericCloud-Base.latest.x86_64.qcow2"
    # Fallback only — actual URL is dynamically resolved at use site
    # (Fedora bumps build numbers: 44-1.6 → 1.7 → …, no .latest. symlink).
    [fedora]="https://download.fedoraproject.org/pub/fedora/linux/releases/44/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-44-1.7.x86_64.qcow2"
    [debian]="https://cloud.debian.org/images/cloud/trixie/daily/latest/debian-13-genericcloud-amd64-daily.qcow2"
    [ubuntu]="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
    [rhel]="REQUIRES_MANUAL_DOWNLOAD"
)

declare -A OS_VARIANTS=(
    [centos]="centos-stream9"
    [rocky]="centos-stream9"
    [fedora]="fedora-unknown"
    [debian]="debian12"
    [ubuntu]="ubuntu24.04"
    [rhel]="centos-stream9"
)

declare -A DISTRO_FAMILY=(
    [centos]="dnf"
    [rocky]="dnf"
    [fedora]="dnf"
    [rhel]="dnf"
    [debian]="apt"
    [ubuntu]="apt"
)

# ── Sizing the golden VM ──────────────────────────────────────────────────
#
# Size against what is FREE, not what is installed, and for ONE VM, not all
# of them.
#
# The old sum did `(MemTotal - 12000) / 5` — dividing by the distro count as
# though the five goldens ran side by side. `golden all` builds them strictly
# one at a time, so that under-sized each VM on an idle host; and because it
# read MemTotal it could not see memory already committed to something else.
# On a host running a 6-node k8s cluster (36GB committed, 6.1GB actually
# available, no swap) it still asked for 8192MB per golden. qemu allocates
# lazily so `virsh start` succeeds, and the shortfall lands later as the OOM
# killer taking qemu down mid-compile — a golden that fails four minutes in,
# after the ZFS build, for a reason that is nowhere near the error message
# (fiend, 2026-08-16).
#
# MemAvailable is the kernel's own estimate of what can be had without
# swapping, so reclaimable page cache is already counted.
_host_ram_mb=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 32768)
_avail_ram_mb=$(awk '/MemAvailable/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo "$_host_ram_mb")
_host_cpus=$(nproc 2>/dev/null || echo 8)
_max_vms=${#DISTROS[@]}
# Leave 2GB of the free pool for the host and ARC; one golden runs at a time.
RAM="${RAM:-$((_avail_ram_mb - 2048))}"
[[ $RAM -lt 2048 ]] && RAM=2048
[[ $RAM -gt 8192 ]] && RAM=8192
# Same sequential logic as RAM: the compile is the long pole in a golden
# build, and slicing cores five ways for a VM that runs alone just made DKMS
# take five times longer. Half the host, capped at 8.
CPUS="${CPUS:-$((_host_cpus / 2 > 2 ? _host_cpus / 2 : 2))}"
[[ $CPUS -gt 8 ]] && CPUS=8
DISK="${DISK:-40}"

# ── Colors ────────────────────────────────────────────────────────────────
C="\033[1;36m"
G="\033[1;32m"
Y="\033[1;33m"
R="\033[1;31m"
W="\033[1;37m"
D="\033[0;37m"
N="\033[0m"

_ensure_log_dir() { mkdir -p "$RESULTS_DIR" 2>/dev/null; }
_ts() { date '+%Y-%m-%d %H:%M:%S'; }

# _plain — strip colour from a message before it goes into a log FILE.
#
# The terminal path uses `echo -e`, so $C/$G/$N render as colour there. The
# file path used a plain `echo`, so the same message arrived on disk as the
# literal text "\033[1;36mkzfstest-golden-centos\033[0m" — unreadable in a
# log an operator greps at 3am (seen in centos-20260816-154351.log).
#
# Strips both spellings: the literal backslash-033 form these vars actually
# hold, and a real ESC byte in case a callee emits one.
# Args: message on stdin.  Returns: cleaned message on stdout.
_plain() { sed -e 's/\\033\[[0-9;]*m//g' -e $'s/\033\[[0-9;]*m//g'; }

log() {
    _ensure_log_dir
    echo -e "${G}[kzfs-test]${N} $*"
    echo "[${$}] $(_ts) [INFO] $*" | _plain >>"$MASTER_LOG" 2>/dev/null
}
warn() {
    _ensure_log_dir
    echo -e "${Y}[kzfs-test]${N} $*" >&2
    echo "[${$}] $(_ts) [WARN] $*" | _plain >>"$MASTER_LOG" 2>/dev/null
}
die() {
    _ensure_log_dir
    echo -e "${R}[kzfs-test]${N} $*" >&2
    echo "[${$}] $(_ts) [FATAL] $*" | _plain >>"$MASTER_LOG" 2>/dev/null
    exit 1
}

# ── Helpers ───────────────────────────────────────────────────────────────

_ssh_cmd() {
    local ip="$1"
    shift
    # Try key auth first — probe stdin must be /dev/null so it never consumes
    # the caller's heredoc stdin (the bug that broke Fedora/Debian/Ubuntu goldens)
    if ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 -o BatchMode=yes \
        -i "$SSH_KEY" "root@${ip}" true </dev/null 2>/dev/null; then
        ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 \
            -o ServerAliveInterval=30 -o ServerAliveCountMax=120 \
            -i "$SSH_KEY" "root@${ip}" "$@"
    else
        sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 \
            -o ServerAliveInterval=30 -o ServerAliveCountMax=120 \
            "root@${ip}" "$@"
    fi
}

get_vm_ip() {
    local vm="$1" ip="" mac=""
    for _ in $(seq 1 90); do
        ip="$(virsh domifaddr "$vm" 2>/dev/null | awk '/ipv4/ {print $4}' | cut -d/ -f1)"
        [[ -n "$ip" ]] && break
        if [[ -z "$mac" ]]; then
            mac="$(virsh domiflist "$vm" 2>/dev/null | awk '/bridge/ {print $5}')"
        fi
        if [[ -n "$mac" ]]; then
            ip="$(virsh net-dhcp-leases default 2>/dev/null | grep "$mac" | awk '{print $5}' | cut -d/ -f1)"
            [[ -n "$ip" ]] && break
        fi
        sleep 2
    done
    echo "$ip"
}

wait_for_ssh() {
    local ip="$1" max="${2:-150}"
    local i=0
    while ! _ssh_cmd "$ip" true 2>/dev/null; do
        ((i++))
        [[ $i -ge $max ]] && return 1
        sleep 2
    done
    return 0
}

ensure_ssh_key() {
    if [[ ! -f "$SSH_KEY" ]]; then
        log "Generating SSH key..."
        ssh-keygen -t ed25519 -f "$SSH_KEY" -N "" -q
    fi
}

# ── RHEL Credentials ──────────────────────────────────────────────────────
# Prompted interactively. Stored only in memory and in a 0600 temp file
# that is deleted after golden build. Never logged.

_rhel_prompt_creds() {
    # Check env vars first
    if [[ -n "$RHEL_USERNAME" && -n "$RHEL_PASSWORD" ]]; then
        log "  Using RHEL credentials from environment"
        return 0
    fi
    # Check cached creds file (0600, root only)
    if [[ -f "$RHEL_CREDS_FILE" ]]; then
        source "$RHEL_CREDS_FILE"
        if [[ -n "$RHEL_USERNAME" && -n "$RHEL_PASSWORD" ]]; then
            log "  Using cached RHEL credentials"
            return 0
        fi
    fi
    # Prompt
    echo ""
    echo -e "  ${C}── RHEL Subscription Credentials ──────────────────────────${N}"
    echo -e "  ${D}Required for subscription-manager register.${N}"
    echo -e "  ${D}Credentials are stored in memory only (never logged).${N}"
    echo ""
    echo -ne "  ${W}RHEL Username: ${N}"
    read -r RHEL_USERNAME
    echo -ne "  ${W}RHEL Password: ${N}"
    read -rs RHEL_PASSWORD
    echo ""

    if [[ -z "$RHEL_USERNAME" || -z "$RHEL_PASSWORD" ]]; then
        warn "RHEL credentials required — skipping RHEL"
        return 1
    fi

    # Cache for this session (0600)
    umask 077
    cat >"$RHEL_CREDS_FILE" <<CREDS
RHEL_USERNAME='${RHEL_USERNAME}'
RHEL_PASSWORD='${RHEL_PASSWORD}'
CREDS
    chmod 600 "$RHEL_CREDS_FILE"
    log "  Credentials cached at ${RHEL_CREDS_FILE} (0600)"
    return 0
}

_rhel_ensure_image() {
    local img_file="${ISO_DIR}/rhel-cloud.qcow2"
    if [[ -f "$img_file" ]]; then
        echo "$img_file"
        return 0
    fi
    echo ""
    echo -e "  ${C}── RHEL Cloud Image ───────────────────────────────────────${N}"
    echo -e "  ${D}RHEL cloud images require a Red Hat account to download.${N}"
    echo -e "  ${D}Download from: https://access.redhat.com/downloads/content/rhel${N}"
    echo -e "  ${D}Look for: Red Hat Enterprise Linux 9 → KVM Guest Image (qcow2)${N}"
    echo ""
    echo -ne "  ${W}Path to RHEL 9 qcow2 image (or URL): ${N}"
    local src
    read -r src
    if [[ -z "$src" ]]; then
        warn "No RHEL image provided — skipping"
        return 1
    fi
    if [[ "$src" == http* ]]; then
        log "  Downloading RHEL cloud image..."
        curl -fSL -o "$img_file" "$src" || {
            warn "Download failed"
            return 1
        }
    elif [[ -f "$src" ]]; then
        cp "$src" "$img_file"
    else
        warn "File not found: ${src}"
        return 1
    fi
    echo "$img_file"
}

timer_start() { date +%s%N; }
timer_elapsed_ms() {
    local start="$1" now
    now=$(date +%s%N)
    echo $(((now - start) / 1000000))
}

golden_name() { echo "${PREFIX}-golden-${1}"; }
test_vm_name() { echo "${PREFIX}-${1}"; }
zvol_path() { echo "${POOL}/vms/${1}"; }
zvol_dev() { echo "/dev/zvol/${POOL}/vms/${1}"; }

validate_distro() {
    local d="$1"
    for valid in "${DISTROS[@]}"; do
        [[ "$d" == "$valid" ]] && return 0
    done
    die "Unknown distro: ${d}. Valid: ${DISTROS[*]}"
}

make_cloud_init_iso() {
    local name="$1" hostname="$2" ready_marker="${3:-}"

    ensure_ssh_key
    local pubkey
    pubkey="$(cat "${SSH_KEY}.pub")"

    local ci_dir ci_iso
    ci_dir="$(mktemp -d)"
    ci_iso="${ISO_DIR}/${name}-cloud-init.iso"

    cat >"${ci_dir}/meta-data" <<META
instance-id: ${name}-$(date +%s)
local-hostname: ${hostname}
META

    local runcmd_extra=""
    [[ -n "$ready_marker" ]] && runcmd_extra="  - touch ${ready_marker}"

    cat >"${ci_dir}/user-data" <<USERDATA
#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
disable_root: false
ssh_pwauth: true
users:
  - default
  - name: root
    lock_passwd: false
    ssh_authorized_keys:
      - ${pubkey}
    shell: /bin/bash
chpasswd:
  expire: false
  users:
    - name: root
      password: kldload
      type: text
ssh_authorized_keys:
  - ${pubkey}
package_update: false
write_files:
  - path: /etc/ssh/sshd_config.d/99-kzfstest.conf
    content: |
      PermitRootLogin yes
      PasswordAuthentication yes
    permissions: '0644'
runcmd:
  - sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
  - sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
  - systemctl stop firewalld 2>/dev/null || true
  - systemctl disable firewalld 2>/dev/null || true
  - systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true
${runcmd_extra}
USERDATA

    cat >"${ci_dir}/network-config" <<NETCFG
version: 2
ethernets:
  id0:
    match:
      name: "en*"
    dhcp4: true
  id1:
    match:
      name: "eth*"
    dhcp4: true
  id2:
    match:
      driver: "virtio*"
    dhcp4: true
NETCFG

    genisoimage -output "$ci_iso" -volid cidata -joliet -rock \
        "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null ||
        xorriso -as mkisofs -o "$ci_iso" -volid cidata -joliet -rock \
            "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null

    rm -rf "$ci_dir"
    echo "$ci_iso"
}

# ── ZFS Build-from-Source ─────────────────────────────────────────────────
# Builds ZFS from a git ref or tarball inside the VM. Used when ZFS_SOURCE
# is not "repo". Requires build deps already installed by the distro setup.
_install_zfs_from_source() {
    local ip="$1" source="$2"
    local mode="${source%%:*}"
    local ref="${source#*:}"

    log "  Building ZFS from source (${source})..."

    # Upload build script
    _ssh_cmd "$ip" bash -s -- "$mode" "$ref" <<'BUILDZFS'
set -e
MODE="$1"
REF="$2"
NCPU=$(nproc)
BUILD_DIR="/tmp/zfs-build"
rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

case "$MODE" in
  version)
    # Download release tarball
    echo "Downloading ZFS ${REF}..."
    curl -fSL -o "zfs-${REF}.tar.gz" \
      "https://github.com/openzfs/zfs/releases/download/zfs-${REF}/zfs-${REF}.tar.gz"
    tar xzf "zfs-${REF}.tar.gz"
    cd "zfs-${REF}"
    ;;
  git)
    # Ref format: "owner/repo@branch", "@branch" (openzfs/zfs), or a bare
    # branch name (also openzfs/zfs).
    #
    # The previous parser only handled the first form. It stripped REPO with
    # ${REF%%@*} and THEN tested `[[ "$REPO" == @* ]]`, which can never be true
    # because the @ has already been removed — so "@master" produced an empty
    # repo and cloned https://github.com/.git, and a bare "master" cloned
    # https://github.com/master.git. Both failed with a git error that looked
    # nothing like "your ref format is wrong" (fiend, 2026-08-16).
    case "$REF" in
    @*) REPO="openzfs/zfs" BRANCH="${REF#@}" ;;
    */*@*) REPO="${REF%%@*}" BRANCH="${REF#*@}" ;;
    */*) REPO="$REF" BRANCH="master" ;;
    *) REPO="openzfs/zfs" BRANCH="$REF" ;;
    esac
    [ -n "$BRANCH" ] || BRANCH="master"
    echo "Cloning https://github.com/${REPO}.git @ ${BRANCH}..."
    git clone --depth 1 --branch "$BRANCH" "https://github.com/${REPO}.git" zfs-src
    cd zfs-src
    ;;
  tarball)
    # Local tarball (already on the VM or SCP'd)
    echo "Extracting ${REF}..."
    tar xzf "$REF"
    cd zfs-*/ 2>/dev/null || cd "$(basename "$REF" .tar.gz)"
    ;;
  *)
    echo "ERROR: Unknown ZFS source mode: $MODE"
    exit 1
    ;;
esac

echo "Building ZFS ($(nproc) cores)..."
[ -f autogen.sh ] && sh autogen.sh
./configure --with-linux="$(ls -d /usr/src/kernels/$(uname -r) 2>/dev/null || ls -d /usr/lib/modules/$(uname -r)/build 2>/dev/null)" \
  --enable-debug 2>&1 || ./configure --enable-debug 2>&1
make -j${NCPU} 2>&1
make install 2>&1

# Load the just-built module
depmod -a 2>/dev/null || true
modprobe -r zfs 2>/dev/null || true
modprobe zfs 2>/dev/null || true

echo "ZFS version: $(zfs version 2>/dev/null || echo unknown)"
echo "ZFS from-source build complete"
BUILDZFS
}

# ── Per-Distro ZFS Test Setup ────────────────────────────────────────────
# Installs ZFS + zfs-tests.sh runtime. When ZFS_SOURCE is "repo", uses
# distro packages. Otherwise builds from source after installing deps.
setup_zfs_test_vm() {
    local ip="$1" distro="$2"
    local family="${DISTRO_FAMILY[$distro]}"

    # RHEL: register subscription before installing packages
    if [[ "$distro" == "rhel" && -n "$RHEL_USERNAME" && -n "$RHEL_PASSWORD" ]]; then
        log "  Registering RHEL subscription (credentials redacted)..."
        _ssh_cmd "$ip" bash -c "subscription-manager register --username='${RHEL_USERNAME}' --password='${RHEL_PASSWORD}' --auto-attach 2>&1 | sed 's/password=.*/password=REDACTED/g'" 2>&1 | sed "s/${RHEL_PASSWORD}/REDACTED/g"
    fi

    log "  Setting up ZFS test environment on ${distro} (source: ${ZFS_SOURCE})..."

    case "$family" in
    dnf)
        _ssh_cmd "$ip" bash -s <<'DNFSETUP'
set -e
# Disable ALL firewalling — CentOS cloud images block SSH after package installs
systemctl stop firewalld 2>/dev/null || true
systemctl disable firewalld 2>/dev/null || true
systemctl mask firewalld 2>/dev/null || true
iptables -F 2>/dev/null || true
iptables -X 2>/dev/null || true
nft flush ruleset 2>/dev/null || true
# Ensure sshd stays accessible
sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config 2>/dev/null || true
mkdir -p /etc/ssh/sshd_config.d
echo -e 'PermitRootLogin yes\nPasswordAuthentication yes' > /etc/ssh/sshd_config.d/99-kzfstest.conf 2>/dev/null || true
systemctl restart sshd 2>/dev/null || true

dnf install -y epel-release 2>/dev/null || true

# kernel-devel MUST match running kernel for DKMS
KVER=$(uname -r)
dnf install -y kernel-devel-${KVER} dkms gcc make autoconf automake libtool 2>/dev/null || \
  dnf install -y kernel-devel dkms gcc make autoconf automake libtool 2>/dev/null || true

# Detect distro for correct ZFS repo
DISTRO_ID=$(. /etc/os-release && echo "$ID")
if ! command -v zfs >/dev/null 2>&1; then
  if [ "$DISTRO_ID" = "fedora" ]; then
    # There is no OpenZFS repository for Fedora. This branch used to try three
    # zfs-release RPM URLs under https://zfsonlinux.org/fedora/ and swallow
    # every failure with `|| true`; that whole path is 404 — the directory
    # itself, not just the filenames (verified 2026-08-16). OpenZFS publishes
    # EL repos only.
    #
    # The old silence was expensive: dnf found no zfs package, the golden got
    # built and SEALED with no ZFS in it, and the only clue was a mangled DKMS
    # line where an "is not installed" message had been interpolated into a
    # path. Say the true thing, and name the fix — the lab already builds from
    # source for exactly this case.
    echo "kzfs-test: Fedora has no OpenZFS package repository (zfsonlinux.org/fedora is 404)."
    echo "kzfs-test: build from source instead:  ZFS_SOURCE=git:@master kzfs-test golden fedora"
    echo "kzfs-test: this golden will fail validation and will NOT be sealed."
  else
    # EL distros (CentOS, Rocky, RHEL)
    dnf install -y "https://zfsonlinux.org/epel/zfs-release-2-3$(rpm --eval "%{dist}").noarch.rpm" 2>/dev/null || true
  fi
  # Not silenced: when this fails it is the whole reason the golden ends up
  # empty, and the error belongs in the golden's log where somebody reads it.
  dnf install -y zfs zfs-dkms zfs-test 2>&1 | tail -20 ||
    echo "kzfs-test: zfs package install FAILED on ${DISTRO_ID}"
fi

# If zfs-test didn't install, try again explicitly
if ! test -f /usr/share/zfs/zfs-tests.sh; then
  dnf install -y zfs-test 2>/dev/null || true
fi

# Test suite deps — ksh is required by zfs-tests.sh
dnf install -y ksh fio parted attr bc acl sysstat \
  bpftrace bcc-tools wireguard-tools curl jq 2>/dev/null || true

# Load ZFS module
modprobe zfs || {
  # DKMS may not have auto-built — try manual build
  ZFS_VER=$(rpm -q --qf '%{VERSION}' zfs-dkms 2>/dev/null || echo "")
  if [ -n "$ZFS_VER" ]; then
    dkms build -m zfs -v "$ZFS_VER" -k "$KVER" 2>&1 || true
    dkms install -m zfs -v "$ZFS_VER" -k "$KVER" 2>&1 || true
    depmod -a "$KVER" 2>/dev/null || true
    modprobe zfs 2>/dev/null || true
  fi
}

# Create loopback devices for zfs-tests.sh
for i in 0 1 2 3; do
  truncate -s 4G /var/tmp/zfs-vdev${i}.img 2>/dev/null || true
done

# The unprivileged runner the OpenZFS suite insists on.
#
# zfs-tests.sh's first act is to refuse: "This script must not be run as
# root." We reach the guest over ssh AS root, so every run ended there —
# instantly, with no tests executed and no other output. The harness then
# wrote a summary of 0 pass / 0 fail / 0 skip, which reads as a clean pass
# to anything counting failures (fiend, 2026-08-15).
#
# The suite expects exactly this shape: an ordinary user that can sudo
# without a password, because the tests themselves escalate per operation.
# Creating it in the GOLDEN means every clone inherits it and no per-run
# setup can drift.
if ! id zfstest >/dev/null 2>&1; then
  useradd -m -s /bin/bash zfstest 2>/dev/null || true
fi
printf 'zfstest ALL=(ALL) NOPASSWD: ALL\n' >/etc/sudoers.d/zfstest
chmod 0440 /etc/sudoers.d/zfstest
# The runner has to be able to write the vdev images it is handed.
chown zfstest /var/tmp/zfs-vdev*.img 2>/dev/null || true
echo "zfstest user:  $(id zfstest >/dev/null 2>&1 && echo OK || echo MISSING)"

# Ensure network stays alive after all package installs
systemctl restart NetworkManager 2>/dev/null || systemctl restart systemd-networkd 2>/dev/null || true
# Re-disable firewall in case packages re-enabled it
systemctl stop firewalld 2>/dev/null || true
systemctl mask firewalld 2>/dev/null || true
iptables -F 2>/dev/null || true
nft flush ruleset 2>/dev/null || true
# Wait for network to come back
sleep 5

echo "=== DNF Setup Validation ==="
echo "zfs binary: $(command -v zfs 2>/dev/null || echo MISSING)"
echo "zfs module: $(lsmod | grep -c '^zfs ' 2>/dev/null | tr -d '[:space:]' || echo 0)"
echo "zfs-tests:  $(test -f /usr/share/zfs/zfs-tests.sh && echo OK || echo MISSING)"
echo "ksh:        $(command -v ksh 2>/dev/null || echo MISSING)"
echo "vdevs:      $(ls /var/tmp/zfs-vdev*.img 2>/dev/null | wc -l)/4"
echo "network:    $(ip -4 addr show | grep -c 'inet.*scope global' || echo 0) interfaces"
echo "DNF test setup complete"
DNFSETUP
        ;;
    apt)
        _ssh_cmd "$ip" bash -s <<'APTSETUP'
set -e
export DEBIAN_FRONTEND=noninteractive

# Enable contrib + universe repos (ZFS packages live there)
if [ -f /etc/apt/sources.list ]; then
  sed -i 's/^\(deb.*\) main$/\1 main contrib/' /etc/apt/sources.list
  sed -i '/^deb.*main contrib$/ s/$/ non-free/' /etc/apt/sources.list
fi
# Debian Trixie uses sources.list.d/debian.sources (DEB822 format)
if [ -f /etc/apt/sources.list.d/debian.sources ]; then
  sed -i 's/^Components: main$/Components: main contrib non-free/' /etc/apt/sources.list.d/debian.sources
fi
# Ubuntu uses universe
if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then
  sed -i 's/^Components: main restricted$/Components: main restricted universe/' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
fi

apt-get update -y

# Headers for DKMS
KVER=$(uname -r)
apt-get install -y linux-headers-${KVER} dkms gcc make 2>/dev/null || \
  apt-get install -y linux-headers-generic dkms gcc make 2>/dev/null || true

# ZFS + test suite
if ! command -v zfs >/dev/null 2>&1; then
  apt-get install -y zfsutils-linux zfs-dkms zfs-test 2>/dev/null || true
fi

# Test suite deps
apt-get install -y ksh fio parted attr bc acl sysstat \
  bpftrace bpfcc-tools wireguard-tools curl jq 2>/dev/null || true

modprobe zfs 2>/dev/null || true

for i in 0 1 2 3; do
  truncate -s 4G /var/tmp/zfs-vdev${i}.img 2>/dev/null || true
done


# The suite refuses to run as root, so it needs an ordinary user that can
# sudo without a password.
#
# This existed only in the DNF setup block. There are four of these heredocs
# — DNFSETUP/APTSETUP/PACSETUP/APKSETUP — and the fix was applied to one, so
# centos and rocky got a working golden while debian and ubuntu got one that
# aborts the moment a run starts:
#
#   FATAL: no zfstest user on this guest
#
# and the harness then wrote pass=0 fail=0 total=0 with status=pass. Exactly
# the single-family fix CLAUDE.md 4.3 is about (fiend, 2026-08-16).
if ! id zfstest >/dev/null 2>&1; then
  useradd -m -s /bin/bash zfstest 2>/dev/null || true
fi
printf 'zfstest ALL=(ALL) NOPASSWD: ALL\n' >/etc/sudoers.d/zfstest
chmod 0440 /etc/sudoers.d/zfstest
chown zfstest /var/tmp/zfs-vdev*.img 2>/dev/null || true
echo "zfstest user:  $(id zfstest >/dev/null 2>&1 && echo OK || echo MISSING)"

echo "=== APT Setup Validation ==="
echo "zfs binary: $(command -v zfs 2>/dev/null || echo MISSING)"
echo "zfs module: $(lsmod | grep -c '^zfs ' 2>/dev/null | tr -d '[:space:]' || echo 0)"
echo "zfs-tests:  $(test -f /usr/share/zfs/zfs-tests.sh && echo OK || echo MISSING)"
echo "ksh:        $(command -v ksh 2>/dev/null || echo MISSING)"
echo "vdevs:      $(ls /var/tmp/zfs-vdev*.img 2>/dev/null | wc -l)/4"
echo "APT test setup complete"
APTSETUP
        ;;
    pacman)
        _ssh_cmd "$ip" bash -s <<'PACSETUP'
set -e
pacman -Syu --noconfirm 2>/dev/null || true

# Headers + build tools
pacman -S --noconfirm linux-headers dkms gcc make \
  fio parted attr bc acl sysstat \
  bpftrace bcc-tools wireguard-tools curl jq 2>/dev/null || true

# ZFS on Arch requires archzfs repo
if ! command -v zfs >/dev/null 2>&1; then
  curl -fsSL https://archzfs.com/archzfs.gpg | pacman-key -a - 2>/dev/null || true
  pacman-key --lsign-key DDF7DB817396A49B2A2723F7403BD972F75D9D76 2>/dev/null || true
  echo -e '\n[archzfs]\nServer = https://archzfs.com/$repo/$arch' >> /etc/pacman.conf
  pacman -Sy --noconfirm zfs-dkms zfs-utils 2>/dev/null || true
fi

modprobe zfs 2>/dev/null || true

for i in 0 1 2 3; do
  truncate -s 4G /var/tmp/zfs-vdev${i}.img 2>/dev/null || true
done


# The suite refuses to run as root, so it needs an ordinary user that can
# sudo without a password.
#
# This existed only in the DNF setup block. There are four of these heredocs
# — DNFSETUP/APTSETUP/PACSETUP/APKSETUP — and the fix was applied to one, so
# centos and rocky got a working golden while debian and ubuntu got one that
# aborts the moment a run starts:
#
#   FATAL: no zfstest user on this guest
#
# and the harness then wrote pass=0 fail=0 total=0 with status=pass. Exactly
# the single-family fix CLAUDE.md 4.3 is about (fiend, 2026-08-16).
if ! id zfstest >/dev/null 2>&1; then
  useradd -m -s /bin/bash zfstest 2>/dev/null || true
fi
printf 'zfstest ALL=(ALL) NOPASSWD: ALL\n' >/etc/sudoers.d/zfstest
chmod 0440 /etc/sudoers.d/zfstest
chown zfstest /var/tmp/zfs-vdev*.img 2>/dev/null || true
echo "zfstest user:  $(id zfstest >/dev/null 2>&1 && echo OK || echo MISSING)"

echo "=== Pacman Setup Validation ==="
echo "zfs binary: $(command -v zfs 2>/dev/null || echo MISSING)"
echo "zfs module: $(lsmod | grep -c '^zfs ' 2>/dev/null | tr -d '[:space:]' || echo 0)"
echo "zfs-tests:  $(test -f /usr/share/zfs/zfs-tests.sh && echo OK || echo MISSING)"
echo "ksh:        $(command -v ksh 2>/dev/null || echo MISSING)"
echo "vdevs:      $(ls /var/tmp/zfs-vdev*.img 2>/dev/null | wc -l)/4"
echo "Pacman test setup complete"
PACSETUP
        ;;
    apk)
        _ssh_cmd "$ip" sh -s <<'APKSETUP'
set -e
apk update

# Enable community + testing repos for ZFS
if ! grep -q 'community' /etc/apk/repositories 2>/dev/null; then
  sed -i 's|^#\(.*community\)|\1|' /etc/apk/repositories
fi
apk update

apk add bash coreutils util-linux findutils grep sed attr acl bc fio \
  linux-lts-dev gcc make autoconf automake libtool \
  wireguard-tools curl jq 2>/dev/null || true

# ZFS — try multiple package names
apk add zfs zfs-lts zfs-utils 2>/dev/null || true
apk add zfs-test 2>/dev/null || true

# mksh as ksh substitute (Alpine has no ksh)
apk add mksh 2>/dev/null || true
ln -sf /usr/bin/mksh /usr/bin/ksh 2>/dev/null || true

modprobe zfs 2>/dev/null || true

for i in 0 1 2 3; do
  truncate -s 4G /var/tmp/zfs-vdev${i}.img 2>/dev/null || true
done


# The suite refuses to run as root, so it needs an ordinary user that can
# sudo without a password.
#
# This existed only in the DNF setup block. There are four of these heredocs
# — DNFSETUP/APTSETUP/PACSETUP/APKSETUP — and the fix was applied to one, so
# centos and rocky got a working golden while debian and ubuntu got one that
# aborts the moment a run starts:
#
#   FATAL: no zfstest user on this guest
#
# and the harness then wrote pass=0 fail=0 total=0 with status=pass. Exactly
# the single-family fix CLAUDE.md 4.3 is about (fiend, 2026-08-16).
if ! id zfstest >/dev/null 2>&1; then
  useradd -m -s /bin/bash zfstest 2>/dev/null || true
fi
printf 'zfstest ALL=(ALL) NOPASSWD: ALL\n' >/etc/sudoers.d/zfstest
chmod 0440 /etc/sudoers.d/zfstest
chown zfstest /var/tmp/zfs-vdev*.img 2>/dev/null || true
echo "zfstest user:  $(id zfstest >/dev/null 2>&1 && echo OK || echo MISSING)"

echo "=== APK Setup Validation ==="
echo "zfs binary: $(command -v zfs 2>/dev/null || echo MISSING)"
echo "zfs module: $(lsmod | grep -c '^zfs ' 2>/dev/null | tr -d '[:space:]' || echo 0)"
echo "zfs-tests:  $(test -f /usr/share/zfs/zfs-tests.sh && echo OK || echo MISSING)"
echo "ksh:        $(command -v ksh 2>/dev/null || echo MISSING)"
echo "vdevs:      $(ls /var/tmp/zfs-vdev*.img 2>/dev/null | wc -l)/4"
echo "APK test setup complete"
APKSETUP
        ;;
    esac

    # If building from source, install extra build deps then build
    # Fedora has no OpenZFS repository, so "repo" is not a thing that can
    # succeed there — zfsonlinux.org/fedora is 404, the whole directory
    # (verified 2026-08-16). Rather than build a golden that is guaranteed to
    # fail validation and be refused a seal, take the source path
    # automatically and say so. Every other distro keeps the operator's
    # choice; an explicit ZFS_SOURCE still wins everywhere.
    local _src="$ZFS_SOURCE"
    if [[ "$distro" == "fedora" && "$_src" == "repo" ]]; then
        # NOTE the '@': the ref parser reads git:<owner/repo>@<branch>, and a
        # bare "git:master" is therefore a REPO named master —
        # https://github.com/master.git, which is what it actually tried to
        # clone. "git:@master" is openzfs/zfs at master (fiend, 2026-08-16).
        _src="${KZFS_FEDORA_SOURCE:-git:@master}"
        log "  fedora has no OpenZFS repo — building from source (${_src})"
        ZFS_SOURCE="$_src"
    fi

    if [[ "$ZFS_SOURCE" != "repo" ]]; then
        log "  Installing build dependencies for from-source ZFS..."
        case "$family" in
        dnf)
            # Upstream's own list from the OpenZFS "Building ZFS" docs, plus
            # the kernel headers configure needs to find a build tree.
            #
            # NOT silenced. This used to end `2>/dev/null || true`, so a
            # missing package produced no output and the build died later at
            # ./configure on the first absent header — which read as "the
            # source build is broken" rather than "a dependency did not
            # install" (fiend, 2026-08-16). --skip-unavailable keeps one
            # renamed package from taking the whole transaction down, the same
            # lesson as rule 2a.
            # ONE argument, single-quoted locally.
            #
            # This was `_ssh_cmd "$ip" bash -c '...'`, and _ssh_cmd passes its
            # arguments to ssh, which joins them with spaces before the remote
            # shell ever sees them. So the remote ran `bash -c dnf install -y
            # ...` — `bash -c` took "dnf" as the whole command string and the
            # rest became $0, $1... dnf5 answered "Missing command. Add --help
            # for more information about the arguments." and installed nothing.
            #
            # It had `2>/dev/null || true` on it, so it had almost certainly
            # never installed a single package on ANY distro; un-silencing it
            # is what made this visible (fiend, 2026-08-16). Single quotes keep
            # $(uname -r) unexpanded locally so the guest resolves its own
            # kernel.
            _ssh_cmd "$ip" 'dnf install -y --skip-unavailable gcc make autoconf automake libtool rpm-build kernel-rpm-macros git libuuid-devel libblkid-devel libudev-devel openssl-devel libtirpc-devel libffi-devel libcurl-devel python3 python3-devel python3-setuptools python3-cffi libaio-devel libattr-devel ncompress elfutils-libelf-devel zlib-devel kernel-devel-$(uname -r)' ||
                warn "  build deps incomplete on ${distro} — ./configure will name what is missing"
            ;;
        apt)
            # Same single-argument form as the dnf branch above, for the same
            # reason.
            _ssh_cmd "$ip" 'DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends build-essential autoconf automake libtool gawk dkms git uuid-dev libblkid-dev libudev-dev libssl-dev libtirpc-dev libffi-dev libcurl4-openssl-dev python3 python3-dev python3-setuptools python3-cffi python3-packaging libaio-dev libattr1-dev ncompress libelf-dev zlib1g-dev linux-headers-$(uname -r)' ||
                warn "  build deps incomplete on ${distro} — ./configure will name what is missing"
            ;;
        pacman)
            _ssh_cmd "$ip" 'pacman -S --noconfirm --needed git openssl python python-cffi libtirpc base-devel' ||
                warn "  build deps incomplete on ${distro}"
            ;;
        apk)
            _ssh_cmd "$ip" 'apk add git libuuid libblkid openssl-dev libtirpc-dev python3-dev py3-cffi linux-headers autoconf automake libtool build-base' ||
                warn "  build deps incomplete on ${distro}"
            ;;
        esac

        # Tarball mode: SCP the file to the VM first
        if [[ "$ZFS_SOURCE" == tarball:* ]]; then
            local src_path="${ZFS_SOURCE#tarball:}"
            if [[ -f "$src_path" ]]; then
                local remote_path="/tmp/$(basename "$src_path")"
                scp -o StrictHostKeyChecking=no -i "$SSH_KEY" "$src_path" "root@${ip}:${remote_path}" 2>/dev/null
                ZFS_SOURCE="tarball:${remote_path}"
            fi
        fi

        _install_zfs_from_source "$ip" "$ZFS_SOURCE"
    fi

    log "  ZFS test environment ready on ${distro}"
}

# _has_esp <blockdev> — does the imported cloud image boot via UEFI?
#
# WHY: goldens were all booted on virt-install's default SeaBIOS, which suited
# the first distro tried — centos ships an MBR image with a boot flag. Rocky 9
# GenericCloud is GPT with a populated ESP and no working legacy path, so on
# SeaBIOS it spun at 100% CPU forever: no serial output, not one packet on the
# wire, and all the lab could see was "No IP" three minutes later — a firmware
# mismatch wearing a network error's clothes (fiend, 2026-08-16).
#
# Detect rather than hardcode: the distro list moves and upstream flips image
# layouts between releases. Matches the ESP type GUID from the UEFI spec.
# Args: block device holding the imported image.
# Returns: 0 if an ESP is present (boot UEFI), 1 otherwise (boot BIOS).
_has_esp() {
    sfdisk --dump "$1" 2>/dev/null |
        grep -qi 'C12A7328-F81F-11D2-BA4B-00A0C93EC93B'
}

# _root_partnum <blockdev> — which partition holds the OS root?
#
# WHY: the import step ran `growpart "$zdev" 1` unconditionally, which is only
# right for a single-partition MBR image like centos. Rocky 9 puts root on p4
# behind a 2MB BIOS-boot and a 100MB ESP, so partition 1 got "grown" instead and
# root stayed at 8.9G of a 40G zvol — invisible until the ZFS suite runs out of
# room laying down vdev images.
#
# Picks the largest partition, not the first or last: cloud images disagree
# about numbering (Debian roots on p1 behind p14/p15; Rocky on p4) but all of
# them make root by far the biggest. Verified against real sfdisk dumps for
# both layouts: centos -> 1, rocky -> 4.
# Args: block device.  stdout: partition number, empty if none found.
_root_partnum() {
    sfdisk --dump "$1" 2>/dev/null |
        awk '$1 ~ /^\/dev\// {
                 n = $1; gsub(/[^0-9]/, " ", n); split(n, a, " "); num = a[length(a)]
                 for (i = 1; i <= NF; i++) if ($i == "size=") { sz = $(i+1) + 0 }
                 if (sz > max) { max = sz; best = num }
             }
             END { if (best != "") print best }'
}

# UEFI, with Secure Boot explicitly OFF.
#
# WARN: do not simplify this to `--boot uefi`. That asks libvirt for its default
# EFI firmware, which on this host resolves to OVMF_CODE_4M.ms.fd — Microsoft
# keys, secure='yes', SMM on. Rocky's shim then refuses to hand off:
#
#     \EFI\rocky\shimx64.efi
#     error: grub-core/kern/efi/sb.c:169: prohibited by secure boot policy.
#
# and GRUB falls back to its interactive menu, waiting for a keypress that a
# --graphics none VM will never get. Identical symptom to the SeaBIOS failure —
# pegged CPU, no network, "No IP" — for an entirely different reason, which is
# what made this take two wrong diagnoses to find.
#
# These goldens exist to build and test out-of-tree ZFS modules; Secure Boot
# would reject those anyway. Verified: Rocky 9.8 boots to a login prompt and
# takes a DHCP lease under this firmware.
_UEFI_BOOT_ARGS='firmware=efi,firmware.feature0.name=secure-boot,firmware.feature0.enabled=no'

# ── Golden Build ──────────────────────────────────────────────────────────

build_golden_single() {
    local distro="$1"
    validate_distro "$distro"

    local name zpath zdev
    name="$(golden_name "$distro")"
    zpath="$(zvol_path "$name")"
    zdev="$(zvol_dev "$name")"

    if zfs list "${zpath}@golden" >/dev/null 2>&1; then
        # Check if existing golden is healthy — if log shows PARTIAL/FAIL, rebuild
        local _existing_log="${RESULTS_DIR}/goldens/${distro}-latest.log"
        local _existing_result=""
        [[ -f "$_existing_log" ]] && _existing_result="$(grep '  Result:' "$_existing_log" 2>/dev/null | tail -1 || echo "")"
        if [[ "$_existing_result" == *"FAIL"* || "$_existing_result" == *"PARTIAL"* ]]; then
            warn "Golden ${name} exists but validation was: ${_existing_result} — rebuilding"
        else
            log "Golden ${name} exists — skipping (destroy with: zfs destroy -Rf ${zpath})"
            return 0
        fi
    fi

    # Clean up everything — zero to hero, no leftovers
    log "  Cleaning up previous state..."
    virsh destroy "$name" 2>/dev/null || true
    virsh undefine "$name" --nvram 2>/dev/null || virsh undefine "$name" 2>/dev/null || true
    zfs destroy -Rf "$zpath" 2>/dev/null || true
    rm -f "${ISO_DIR}/${name}-cloud-init.iso" 2>/dev/null || true

    local t_start
    t_start="$(timer_start)"

    # Persistent log for this golden build
    local golden_log_dir="${RESULTS_DIR}/goldens"
    mkdir -p "$golden_log_dir"
    local golden_log="${golden_log_dir}/${distro}-$(date +%Y%m%d-%H%M%S).log"
    log "Building golden: ${C}${name}${N}"
    log "  Log: ${golden_log}"

    # Log header
    {
        echo "═══════════════════════════════════════════════════════════"
        echo "  OpenZFS Test Lab — Golden Build: ${distro}"
        echo "  Started: $(date)"
        echo "  Host: $(uname -n) ($(nproc) cores, $(awk '/MemTotal/ {printf "%.0fGB", $2/1048576}' /proc/meminfo) RAM)"
        echo "  ZFS Source: ${ZFS_SOURCE}"
        echo "═══════════════════════════════════════════════════════════"
        echo ""
    } | tee "$golden_log"

    # Download cloud image
    mkdir -p "$ISO_DIR"
    local url="${CLOUD_IMAGES[$distro]}"

    # Fedora cloud images bump build numbers (44-1.6 → 1.7 → …) and there's
    # no .latest. symlink. Resolve dynamically. See klab for the bug history.
    if [[ "$distro" == "fedora" ]] && command -v curl >/dev/null 2>&1; then
        local _ver _latest _base="https://download.fedoraproject.org/pub/fedora/linux/releases"
        for _ver in 44 43 42; do
            _latest=$(curl -sfL --max-time 10 "${_base}/${_ver}/Cloud/x86_64/images/" 2>/dev/null |
                grep -oE "Fedora-Cloud-Base-Generic-${_ver}-[0-9.]+\.x86_64\.qcow2" |
                sort -V -u | tail -1)
            if [[ -n "$_latest" ]]; then
                url="${_base}/${_ver}/Cloud/x86_64/images/${_latest}"
                break
            fi
        done
    fi

    local img_file="${ISO_DIR}/${distro}-cloud.qcow2"

    if [[ "$distro" == "rhel" ]]; then
        # RHEL builds from CentOS golden (same EL9 kernel) + subscription-manager
        _rhel_prompt_creds || return 1
        local centos_golden_zpath
        centos_golden_zpath="$(zvol_path "$(golden_name centos)")"
        if ! zfs list "${centos_golden_zpath}@golden" >/dev/null 2>&1; then
            warn "RHEL requires CentOS golden — building CentOS first..."
            build_golden_single centos || {
                warn "CentOS build failed — cannot build RHEL"
                return 1
            }
        fi
        # Clean up any previous failed RHEL build
        virsh destroy "$name" 2>/dev/null || true
        virsh undefine "$name" --nvram 2>/dev/null || virsh undefine "$name" 2>/dev/null || true
        zfs destroy -Rf "$zpath" 2>/dev/null || true

        log "  RHEL: cloning from CentOS golden (same EL9 kernel)..."
        zfs clone "${centos_golden_zpath}@golden" "$zpath" 2>/dev/null || die "Failed to clone CentOS golden for RHEL"

        # Boot the clone with cloud-init
        local ci_iso
        ci_iso="$(make_cloud_init_iso "$name" "$name" "/var/lib/cloud/instance/kzfstest-ready")"

        # RHEL clones the centos zvol, so it inherits that image's firmware
        # expectations — detect on the clone rather than assuming.
        local -a _fw=()
        if _has_esp "$zdev"; then
            _fw=(--boot "$_UEFI_BOOT_ARGS")
            log "  Image is UEFI (ESP present) — booting OVMF with Secure Boot off"
        fi

        log "  Booting RHEL golden VM..."
        virt-install \
            --name "$name" \
            --ram "$RAM" --vcpus "$CPUS" \
            --os-variant "${OS_VARIANTS[$distro]}" \
            --disk "path=${zdev},bus=virtio" \
            --disk "path=${ci_iso},device=cdrom" \
            --network bridge=virbr0,model=virtio \
            --graphics none \
            --noautoconsole \
            "${_fw[@]}" \
            --import \
            2>&1 || die "Failed to boot RHEL golden VM"

        local golden_ip
        log "  Waiting for IP..."
        golden_ip="$(get_vm_ip "$name")"
        [[ -n "$golden_ip" ]] || die "No IP for ${name}"
        log "  IP: ${golden_ip}"

        log "  Waiting for SSH..."
        wait_for_ssh "$golden_ip" 300 || die "SSH timeout on ${name}"

        # Install subscription-manager and register as RHEL
        log "  Installing subscription-manager..."
        _ssh_cmd "$golden_ip" "dnf install -y subscription-manager 2>&1 | tail -5" 2>&1 | tee -a "$golden_log"

        log "  Registering RHEL subscription (credentials redacted)..."
        _ssh_cmd "$golden_ip" bash -c "
      subscription-manager register --username='${RHEL_USERNAME}' --password='${RHEL_PASSWORD}' --auto-attach 2>&1 | sed 's/password=.*/password=REDACTED/g'
      subscription-manager repos --enable codeready-builder-for-rhel-9-x86_64-rpms 2>/dev/null || true
      subscription-manager identity 2>/dev/null | head -3
      echo 'RHEL registration complete'
    " 2>&1 | sed "s/${RHEL_PASSWORD}/REDACTED/g" | tee -a "$golden_log"

        # ZFS is already installed from CentOS golden — just verify
        log "  Verifying ZFS on RHEL..."
        _ssh_cmd "$golden_ip" "modprobe zfs 2>/dev/null; zfs version 2>/dev/null; zfs-tests.sh --help >/dev/null 2>&1 && echo 'zfs-tests: OK' || echo 'zfs-tests: MISSING'"

        # Skip the normal download/boot flow — jump to validation
        # (golden_ip is already set, VM is running)

        # Smoke-test
        log "  Validating golden ${distro}..."
        local _v_zfs _v_mod _v_tests _v_vdevs _v_ksh _v_ver _v_kernel _v_dkms
        _v_mod="$(_ssh_cmd "$golden_ip" "lsmod | grep -c '^zfs ' 2>/dev/null | tr -d '[:space:]' || echo 0")"
        _v_zfs="$(_ssh_cmd "$golden_ip" "command -v zfs >/dev/null 2>&1 && echo OK || echo MISSING")"
        _v_ver="$(_ssh_cmd "$golden_ip" "zfs version 2>/dev/null | head -1 || echo unknown")"
        _v_tests="$(_ssh_cmd "$golden_ip" "test -f /usr/share/zfs/zfs-tests.sh && echo OK || (command -v zfs-tests.sh >/dev/null 2>&1 && echo OK || echo MISSING)")"
        _v_vdevs="$(_ssh_cmd "$golden_ip" "ls /var/tmp/zfs-vdev*.img 2>/dev/null | wc -l")"
        _v_ksh="$(_ssh_cmd "$golden_ip" "command -v ksh >/dev/null 2>&1 && echo OK || echo MISSING")"
        _v_kernel="$(_ssh_cmd "$golden_ip" "uname -r" || echo "unknown")"
        _v_dkms="$(_ssh_cmd "$golden_ip" "dkms status 2>/dev/null | head -5" || echo "n/a")"
        local _v_rhel_id
        _v_rhel_id="$(_ssh_cmd "$golden_ip" "subscription-manager identity 2>/dev/null | head -1" || echo "not registered")"

        {
            echo ""
            echo "═══════════════════════════════════════════════════════════"
            echo "  Golden Validation Report: ${distro}"
            echo "═══════════════════════════════════════════════════════════"
            echo "  Kernel:         ${_v_kernel}"
            echo "  ZFS binary:     ${_v_zfs}"
            echo "  ZFS module:     $([[ $_v_mod -ge 1 ]] && echo "LOADED" || echo "NOT LOADED")"
            echo "  ZFS version:    ${_v_ver}"
            echo "  DKMS status:    ${_v_dkms}"
            echo "  zfs-tests.sh:   ${_v_tests}"
            echo "  vdev images:    ${_v_vdevs}/4"
            echo "  ksh:            ${_v_ksh}"
            echo "  RHEL sub:       ${_v_rhel_id}"
            echo "  ZFS source:     ${ZFS_SOURCE}"
            echo ""
            local _result="PASS"
            [[ "$_v_zfs" != "OK" || "$_v_mod" -lt 1 ]] && _result="FAIL"
            [[ "$_v_tests" != "OK" ]] && _result="PARTIAL (no tests)"
            echo "  Result:         ${_result}"
            echo "═══════════════════════════════════════════════════════════"
            echo ""
        } | tee -a "$golden_log"

        # Seal
        log "  Configuring ZFS autoload..."
        _ssh_cmd "$golden_ip" "echo zfs > /etc/modules-load.d/zfs.conf"
        _ssh_cmd "$golden_ip" "depmod -a 2>/dev/null || true"

        log "  Sealing golden..."
        _ssh_cmd "$golden_ip" "cloud-init clean --logs 2>/dev/null || true"
        _ssh_cmd "$golden_ip" "rm -f /etc/machine-id; touch /etc/machine-id"
        _ssh_cmd "$golden_ip" "truncate -s 0 /etc/hostname"
        _ssh_cmd "$golden_ip" "systemctl enable cloud-init-local cloud-init cloud-config cloud-final 2>/dev/null || true"
        _ssh_cmd "$golden_ip" "shutdown -h now" || true

        for _ in $(seq 1 30); do
            virsh domstate "$name" 2>/dev/null | grep -q "shut off" && break
            sleep 2
        done

        virsh detach-disk "$name" "$ci_iso" --config 2>/dev/null || true
        rm -f "$ci_iso"

        zfs snapshot "${zpath}@golden"

        local elapsed
        elapsed="$(timer_elapsed_ms "$t_start")"

        {
            echo "Golden build complete: ${name}"
            echo "  Time:     $((elapsed / 1000))s"
            echo "  Zvol:     ${zpath}"
            echo "  Snapshot: ${zpath}@golden"
            echo "  Size:     $(zfs get -Hp -o value used "$zpath" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo "?")"
            echo "  Method:   CentOS clone + subscription-manager"
            echo "  Finished: $(date)"
            echo ""
        } | tee -a "$golden_log"

        ln -sfn "$golden_log" "${golden_log_dir}/${distro}-latest.log"
        log "Golden ready: ${C}${name}${N} ($((elapsed / 1000))s) — log: ${golden_log}"
        return 0
    elif [[ ! -f "$img_file" ]]; then
        log "  Downloading ${distro} cloud image..."
        curl -fSL -o "$img_file" "$url" || die "Download failed for ${distro}"
    else
        log "  Using cached: ${img_file}"
    fi

    # Create zvol
    if zfs list "$zpath" >/dev/null 2>&1; then
        virsh destroy "$name" 2>/dev/null || true
        virsh undefine "$name" --nvram 2>/dev/null || virsh undefine "$name" 2>/dev/null || true
        zfs destroy -Rf "$zpath" 2>/dev/null || true
    fi

    log "  Creating zvol (${DISK}G, sparse, lz4)..."
    zfs create -V "${DISK}G" -s -o volblocksize=64k -o compression=lz4 "$zpath"

    for _ in $(seq 1 15); do
        [[ -b "$zdev" ]] && break
        sleep 1
    done
    [[ -b "$zdev" ]] || die "zvol device not found: ${zdev}"

    log "  Importing cloud image..."
    qemu-img convert -f qcow2 -O raw "$img_file" "$zdev"
    partx -u "$zdev" 2>/dev/null || true # re-read the table we just wrote

    # Grow the root partition into the rest of the zvol. Not fatal: growpart
    # exits non-zero when the partition is already at full size, which is a
    # legitimate no-op on a re-import — but a real failure is worth saying out
    # loud, because the suite only notices as "no space left" much later.
    local _rootpart
    _rootpart="$(_root_partnum "$zdev")"
    if [[ -n "$_rootpart" ]]; then
        growpart "$zdev" "$_rootpart" >/dev/null 2>&1 ||
            warn "growpart: root partition ${_rootpart} not resized (already full size?)"
    else
        warn "could not identify the root partition on ${zdev} — left unresized"
    fi

    local -a _fw=()
    if _has_esp "$zdev"; then
        _fw=(--boot "$_UEFI_BOOT_ARGS")
        log "  Image is UEFI (ESP present) — booting OVMF with Secure Boot off"
    fi

    local ci_iso
    ci_iso="$(make_cloud_init_iso "$name" "$name" "/var/lib/cloud/instance/kzfstest-ready")"

    log "  Booting golden VM..."
    virt-install \
        --name "$name" \
        --ram "$RAM" --vcpus "$CPUS" \
        --os-variant "${OS_VARIANTS[$distro]}" \
        --disk "path=${zdev},bus=virtio" \
        --disk "path=${ci_iso},device=cdrom" \
        --network bridge=virbr0,model=virtio \
        --graphics none \
        --noautoconsole \
        "${_fw[@]}" \
        --import \
        2>&1 || die "Failed to boot golden VM for ${distro}"

    local golden_ip
    log "  Waiting for IP..."
    golden_ip="$(get_vm_ip "$name")"
    [[ -n "$golden_ip" ]] || die "No IP for ${name}"
    log "  IP: ${golden_ip}"

    log "  Waiting for SSH..."
    wait_for_ssh "$golden_ip" 300 || die "SSH timeout on ${name}"

    log "  Waiting for cloud-init..."
    for _ in $(seq 1 90); do
        _ssh_cmd "$golden_ip" "test -f /var/lib/cloud/instance/kzfstest-ready" 2>/dev/null && break
        sleep 5
    done

    # Install ZFS test suite (log to file, NOT piped — pipe kills heredoc stdin)
    local _setup_log="/tmp/kzfstest-setup-${distro}.log"
    setup_zfs_test_vm "$golden_ip" "$distro" >"$_setup_log" 2>&1
    if [[ -n "$RHEL_PASSWORD" ]]; then
        sed "s/${RHEL_PASSWORD}/REDACTED/g" "$_setup_log" | tee -a "$golden_log"
    else
        cat "$_setup_log" | tee -a "$golden_log"
    fi
    rm -f "$_setup_log"

    # ── Smoke-test the golden before sealing ──
    # Run ALL validation in a single SSH call (CentOS network dies between calls)
    log "  Validating golden ${distro}..."
    local _val_tmp="/tmp/kzfstest-validate-${distro}.txt"
    _ssh_cmd "$golden_ip" bash -s <<'VALIDATE' >"$_val_tmp" 2>/dev/null || true
echo "V_KERNEL=$(uname -r 2>/dev/null || echo unknown)"
echo "V_ZFS=$(command -v zfs >/dev/null 2>&1 && echo OK || echo MISSING)"
echo "V_MOD=$(lsmod | grep -c '^zfs ' 2>/dev/null | tr -d '[:space:]' || echo 0)"
echo "V_VER=$(zfs version 2>/dev/null | head -1 || echo unknown)"
echo "V_DKMS=$(dkms status 2>/dev/null | head -1 || echo n/a)"
echo "V_TESTS=$(test -f /usr/share/zfs/zfs-tests.sh && echo OK || (command -v zfs-tests.sh >/dev/null 2>&1 && echo OK || echo MISSING))"
echo "V_VDEVS=$(ls /var/tmp/zfs-vdev*.img 2>/dev/null | wc -l)"
echo "V_KSH=$(command -v ksh >/dev/null 2>&1 && echo OK || echo MISSING)"
# Configure ZFS autoload + seal in same session (network may die after)
echo zfs > /etc/modules-load.d/zfs.conf 2>/dev/null || true
depmod -a 2>/dev/null || true
cloud-init clean --logs 2>/dev/null || true
rm -f /etc/machine-id; touch /etc/machine-id
truncate -s 0 /etc/hostname
rm -f /etc/netplan/*.yaml /etc/systemd/network/*.network 2>/dev/null || true
systemctl enable cloud-init-local cloud-init cloud-config cloud-final 2>/dev/null || true
mkdir -p /etc/systemd/network && cat > /etc/systemd/network/10-dhcp.network <<'NETD'
[Match]
Name=en* eth*

[Network]
DHCP=yes
NETD
echo "V_SEALED=OK"
shutdown -h now 2>/dev/null || true
VALIDATE

    # Parse validation results
    local _v_kernel _v_zfs _v_mod _v_ver _v_dkms _v_tests _v_vdevs _v_ksh
    _v_kernel="$(grep '^V_KERNEL=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "unknown")"
    _v_zfs="$(grep '^V_ZFS=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "MISSING")"
    _v_mod="$(grep '^V_MOD=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "0")"
    _v_ver="$(grep '^V_VER=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "unknown")"
    _v_dkms="$(grep '^V_DKMS=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "n/a")"
    _v_tests="$(grep '^V_TESTS=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "MISSING")"
    _v_vdevs="$(grep '^V_VDEVS=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "0")"
    _v_ksh="$(grep '^V_KSH=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "MISSING")"
    rm -f "$_val_tmp"

    [[ -z "$_v_kernel" ]] && _v_kernel="unknown"
    [[ -z "$_v_mod" ]] && _v_mod="0"

    # Log validation report
    {
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        echo "  Golden Validation Report: ${distro}"
        echo "═══════════════════════════════════════════════════════════"
        echo "  Kernel:         ${_v_kernel}"
        echo "  ZFS binary:     ${_v_zfs}"
        echo "  ZFS module:     $([[ $_v_mod -ge 1 ]] && echo "LOADED" || echo "NOT LOADED")"
        echo "  ZFS version:    ${_v_ver}"
        echo "  DKMS status:    ${_v_dkms}"
        echo "  zfs-tests.sh:   ${_v_tests}"
        echo "  vdev images:    ${_v_vdevs}/4"
        echo "  ksh:            ${_v_ksh}"
        echo "  ZFS source:     ${ZFS_SOURCE}"
        echo ""
        local _result="PASS"
        [[ "$_v_zfs" != "OK" || "$_v_mod" -lt 1 ]] && _result="FAIL"
        [[ "$_v_tests" != "OK" ]] && _result="PARTIAL (no tests)"
        echo "  Result:         ${_result}"
        echo "═══════════════════════════════════════════════════════════"
        echo ""
    } | tee -a "$golden_log"

    log "    ZFS binary:     ${_v_zfs}"
    log "    ZFS module:     $([[ $_v_mod -ge 1 ]] && echo "loaded" || echo "NOT LOADED")"
    log "    ZFS version:    ${_v_ver}"
    log "    Kernel:         ${_v_kernel}"
    log "    DKMS:           ${_v_dkms}"
    log "    zfs-tests.sh:   ${_v_tests}"
    log "    vdev images:    ${_v_vdevs}/4"
    log "    ksh:            ${_v_ksh}"

    # A golden that cannot run the suite must not be sealed.
    #
    # WHY: this used to warn and seal anyway — "the golden will still be
    # created but tests will fail on this distro". The fedora golden came back
    # with ZFS binary MISSING, module NOT LOADED and zfs-tests.sh MISSING, got
    # its @golden snapshot regardless, and was announced as "Golden ready" and
    # counted in the status table's Ready column. Every later run would clone
    # an empty image, test nothing, and report that quickly and cleanly
    # (fiend, 2026-08-16).
    #
    # The @golden snapshot is the lab's only durable claim that an image works;
    # refusing to take it is what keeps `status` and the ztx Lab tab honest,
    # and it agrees with the rebuild check above, which already treats an
    # existing FAIL/PARTIAL golden as something to rebuild.
    #
    # The zvol is left in place deliberately: unsealed it reads as PARTIAL, and
    # keeping it means the log and the disk are both still there to look at.
    if [[ "$_v_zfs" != "OK" || "$_v_mod" -lt 1 ]]; then
        warn "  FAILED: ZFS not functional on ${distro} (binary ${_v_zfs}, module loaded=${_v_mod})"
        warn "  Refusing to seal ${name} — an image with no ZFS would test nothing and pass"
        return 1
    fi
    if [[ "$_v_tests" != "OK" ]]; then
        warn "  FAILED: zfs-tests.sh missing on ${distro} — the suite cannot run there"
        warn "  Refusing to seal ${name} — see ${golden_log}"
        return 1
    fi

    # Seal + shutdown already done inside validation heredoc
    log "  Sealed + shutdown initiated in validation pass"

    for _ in $(seq 1 30); do
        virsh domstate "$name" 2>/dev/null | grep -q "shut off" && break
        sleep 2
    done

    virsh detach-disk "$name" "$ci_iso" --config 2>/dev/null || true
    rm -f "$ci_iso"

    zfs snapshot "${zpath}@golden"

    local elapsed
    elapsed="$(timer_elapsed_ms "$t_start")"

    # Log final summary
    {
        echo "Golden build complete: ${name}"
        echo "  Time:     $((elapsed / 1000))s"
        echo "  Zvol:     ${zpath}"
        echo "  Snapshot: ${zpath}@golden"
        echo "  Size:     $(zfs get -Hp -o value used "$zpath" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo "?")"
        echo "  Finished: $(date)"
        echo ""
    } | tee -a "$golden_log"

    # Symlink latest log for this distro
    ln -sfn "$golden_log" "${golden_log_dir}/${distro}-latest.log"

    log "Golden ready: ${C}${name}${N} ($((elapsed / 1000))s) — log: ${golden_log}"
}

cmd_golden() {
    local target="${1:-all}"
    ensure_ssh_key

    if [[ "$target" == "all" ]]; then
        # Failures are counted and re-reported, and they set the exit status.
        # This loop used to end in `|| warn`, which returns 0 — so `golden all`
        # exited 0 with a clean-looking tail even when every golden had failed,
        # and anything scripted on top of it (CI, the ztx GUI) read that as a
        # working lab. Same failure shape as a test run reporting 0/0/0 as a
        # pass: the thing that did not happen must not look like success.
        local _failed=() _built=()
        for distro in "${DISTROS[@]}"; do
            # Subshell on purpose. build_golden_single reports every one of its
            # ten failure paths through die(), which is `exit 1` — so a single
            # distro failing took the whole run down with it. A rocky VM that
            # came up without a DHCP lease ended the run at distro 2 of 5, and
            # fedora, debian and ubuntu were never attempted; the operator saw
            # "builds failed" with no build having been tried (fiend,
            # 2026-08-16). In a subshell that exit ends only this distro, the
            # loop records it and moves to the next.
            #
            # Safe because the builder keeps no state for the caller: every
            # variable it sets is `local` and its real output is a zvol, a
            # snapshot and a log on disk.
            if (build_golden_single "$distro"); then
                _built+=("$distro")
            else
                _failed+=("$distro")
                warn "Failed: ${distro}"
            fi
        done
        log "Goldens built: ${#_built[@]}/${#DISTROS[@]} (${_built[*]:-none})"
        if ((${#_failed[@]} > 0)); then
            warn "Goldens FAILED: ${_failed[*]}"
            return 1
        fi
    else
        validate_distro "$target"
        build_golden_single "$target"
    fi
}

# ── Verify (Smoke Test) ──────────────────────────────────────────────────
# Quick check: can each golden boot, load ZFS, and find zfs-tests.sh?
cmd_verify() {
    local target="${1:-all}"
    local distros_to_check=()

    if [[ "$target" == "all" ]]; then
        distros_to_check=("${DISTROS[@]}")
    else
        validate_distro "$target"
        distros_to_check=("$target")
    fi

    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
    echo -e "${W}  kzfs-test verify — smoke test golden images${N}"
    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
    echo ""

    local pass=0 fail=0 skip=0

    printf "  ${W}%-12s %-10s %-10s %-12s %-10s %-10s${N}\n" \
        "DISTRO" "GOLDEN" "BOOT" "ZFS MODULE" "ZFS VER" "TESTS"
    echo "  ─────────── ────────── ────────── ──────────── ────────── ──────────"

    for distro in "${distros_to_check[@]}"; do
        local name zpath
        name="$(golden_name "$distro")"
        zpath="$(zvol_path "$name")"

        # Check golden exists
        if ! zfs list "${zpath}@golden" >/dev/null 2>&1; then
            printf "  %-12s ${Y}%-10s${N} %-10s %-12s %-10s %-10s\n" \
                "$distro" "MISSING" "-" "-" "-" "-"
            ((skip++))
            continue
        fi

        # Clone and boot
        local vm_name ci_iso vm_ip
        vm_name="$(test_vm_name "verify-${distro}")"
        local vm_zpath
        vm_zpath="$(zvol_path "$vm_name")"
        local vm_zdev
        vm_zdev="$(zvol_dev "$vm_name")"

        # Cleanup any previous verify VM
        virsh destroy "$vm_name" 2>/dev/null || true
        virsh undefine "$vm_name" 2>/dev/null || true
        zfs destroy -Rf "$vm_zpath" 2>/dev/null || true

        # Clone
        local t_clone
        t_clone="$(timer_start)"
        zfs clone "${zpath}@golden" "$vm_zpath" 2>/dev/null || {
            printf "  %-12s ${G}%-10s${N} ${R}%-10s${N} %-12s %-10s %-10s\n" \
                "$distro" "OK" "CLONE FAIL" "-" "-" "-"
            ((fail++))
            continue
        }

        ci_iso="$(make_cloud_init_iso "$vm_name" "$vm_name")"

        virt-install --name "$vm_name" \
            --ram 2048 --vcpus 2 \
            --os-variant "${OS_VARIANTS[$distro]}" \
            --disk "path=${vm_zdev},bus=virtio" \
            --disk "path=${ci_iso},device=cdrom" \
            --network bridge=virbr0,model=virtio \
            --graphics none --noautoconsole --import >/dev/null 2>&1

        vm_ip="$(get_vm_ip "$vm_name")"
        if [[ -z "$vm_ip" ]]; then
            printf "  %-12s ${G}%-10s${N} ${R}%-10s${N} %-12s %-10s %-10s\n" \
                "$distro" "OK" "NO IP" "-" "-" "-"
            ((fail++))
            virsh destroy "$vm_name" 2>/dev/null || true
            virsh undefine "$vm_name" 2>/dev/null || true
            zfs destroy -Rf "$vm_zpath" 2>/dev/null || true
            rm -f "$ci_iso"
            continue
        fi

        wait_for_ssh "$vm_ip" 300 || {
            printf "  %-12s ${G}%-10s${N} ${R}%-10s${N} %-12s %-10s %-10s\n" \
                "$distro" "OK" "NO SSH" "-" "-" "-"
            ((fail++))
            virsh destroy "$vm_name" 2>/dev/null || true
            virsh undefine "$vm_name" 2>/dev/null || true
            zfs destroy -Rf "$vm_zpath" 2>/dev/null || true
            rm -f "$ci_iso"
            continue
        }

        # Check ZFS — try to load module if not already loaded
        local zfs_loaded zfs_ver tests_found
        _ssh_cmd "$vm_ip" "modprobe zfs 2>/dev/null || true"
        zfs_loaded="$(_ssh_cmd "$vm_ip" "lsmod | grep -q '^zfs ' && echo YES || echo NO")"
        zfs_ver="$(_ssh_cmd "$vm_ip" "zfs version 2>/dev/null | head -1 | awk '{print \$NF}'" || echo "?")"
        tests_found="$(_ssh_cmd "$vm_ip" "command -v zfs-tests.sh >/dev/null 2>&1 && echo YES || (test -f /usr/share/zfs/zfs-tests.sh && echo YES || echo NO)")"

        local zfs_color="$G" test_color="$G"
        [[ "$zfs_loaded" != "YES" ]] && zfs_color="$R"
        [[ "$tests_found" != "YES" ]] && test_color="$Y"

        printf "  %-12s ${G}%-10s${N} ${G}%-10s${N} ${zfs_color}%-12s${N} %-10s ${test_color}%-10s${N}\n" \
            "$distro" "OK" "${vm_ip}" "$zfs_loaded" "$zfs_ver" "$tests_found"

        if [[ "$zfs_loaded" == "YES" ]]; then
            ((pass++))
        else
            ((fail++))
        fi

        # Cleanup
        virsh destroy "$vm_name" 2>/dev/null || true
        virsh undefine "$vm_name" 2>/dev/null || true
        zfs destroy -Rf "$vm_zpath" 2>/dev/null || true
        rm -f "$ci_iso"
    done

    echo ""
    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
    echo -e "  ${G}Pass: ${pass}${N}  ${R}Fail: ${fail}${N}  ${Y}Skip: ${skip}${N}"
    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
}

# ── Run Tests ─────────────────────────────────────────────────────────────

run_tests_on_vm() {
    local distro="$1" mode="$2" run_dir="$3" ip="$4"
    local log_file="${run_dir}/${distro}.log"
    local progress_file="${run_dir}/${distro}.status"

    echo "running" >"$progress_file"
    log "  [${distro}] Starting ${mode} tests on ${ip}..."

    # NOTE: the arguments are built in _test_args below, NOT here. There used
    # to be a `test_cmd` assigned at this point and never read — dead since
    # the remote script was rewritten — which is a trap: the obvious place to
    # fix the invocation was the one place that had no effect on it.

    # Check if zfs-tests.sh exists first
    local tests_path
    tests_path="$(_ssh_cmd "$ip" "command -v zfs-tests.sh 2>/dev/null || echo /usr/share/zfs/zfs-tests.sh")"
    if ! _ssh_cmd "$ip" "test -f ${tests_path}" 2>/dev/null; then
        echo "SKIP: zfs-tests.sh not found on ${distro}" >"$log_file"
        echo "skip" >"$progress_file"
        return 0
    fi

    # Build test command — simple string, no heredocs
    local _test_args=""
    if [[ "$mode" == "quick" ]]; then
        # See the note above: -c runs nothing.
        _test_args="-vx -T functional"
    else
        _test_args="-vx"
    fi

    log "  [${distro}] Running: zfs-tests.sh ${_test_args}"

    _ssh_cmd "$ip" "
    echo '=== ZFS Test Run ==='
    echo \"Kernel: \$(uname -r)\"
    # Load ZFS — may need DKMS rebuild if kernel changed
    if ! modprobe zfs 2>/dev/null; then
      echo 'ZFS module failed to load — rebuilding DKMS...'
      dkms autoinstall 2>&1 | tail -5
      depmod -a 2>/dev/null
      modprobe zfs 2>&1
    fi
    echo \"ZFS: \$(zfs version 2>/dev/null | head -1)\"
    echo \"Module: \$(lsmod | grep -c '^zfs ')\"
    if ! lsmod | grep -q '^zfs '; then
      echo 'FATAL: ZFS module not loaded — cannot run tests'
      exit 1
    fi
    echo ''
    # Diagnostics around the run. A suite that produces no output at all
    # leaves nothing to explain itself with, and that is what happened:
    # 0 pass / 0 fail / 0 skip in one second, empty log (fiend, 2026-08-15).
    # Who we run as and whether the script is executable are the two things
    # that answer it — OpenZFS's zfs-tests.sh refuses to run as root, and
    # refusing quietly is indistinguishable from passing nothing.
    echo \"Connected as: \$(id -un) uid=\$(id -u)\"
    ls -l /usr/share/zfs/zfs-tests.sh 2>&1
    if ! id zfstest >/dev/null 2>&1; then
      echo 'FATAL: no zfstest user on this guest — the golden predates the'
      echo '       unprivileged-runner fix. Rebuild it: kzfs-test golden <distro>'
      exit 1
    fi
    echo ''
    # su -l, not sudo -u: the suite wants a real login environment (PATH,
    # HOME, and a shell that ksh scripts can rely on). Run as the
    # unprivileged user because zfs-tests.sh refuses root outright.
    su -l zfstest -c \"/usr/share/zfs/zfs-tests.sh ${_test_args}\" 2>&1
    _zt_rc=\$?
    echo ''
    echo \"zfs-tests.sh exited: \${_zt_rc}\"
    echo \"Finished: \$(date)\"
  " >"$log_file" 2>&1 || true

    # Parse results
    local total_pass total_fail total_skip
    total_pass="$(grep -c '\[PASS\]' "$log_file" 2>/dev/null)" || total_pass=0
    total_fail="$(grep -c '\[FAIL\]' "$log_file" 2>/dev/null)" || total_fail=0
    total_skip="$(grep -c '\[SKIP\]' "$log_file" 2>/dev/null)" || total_skip=0
    [[ "$total_pass" =~ ^[0-9]+$ ]] || total_pass=0
    [[ "$total_fail" =~ ^[0-9]+$ ]] || total_fail=0
    [[ "$total_skip" =~ ^[0-9]+$ ]] || total_skip=0

    local total_all=$((total_pass + total_fail + total_skip))

    # A run that executed NOTHING is not a pass.
    #
    # This was `if [[ $total_fail -eq 0 ]]`, and zero tests satisfies that
    # trivially — so a guest that aborted before running anything was written
    # down as pass=0 fail=0 skip=0 status=pass. That is precisely what the
    # debian and ubuntu guests did today: they hit "FATAL: no zfstest user"
    # and exited in one second, and the harness recorded a clean pass for
    # each. Nothing downstream could tell that apart from a real green run
    # (fiend, 2026-08-16).
    #
    # `error` is a distinct state from `fail` on purpose: fail means the suite
    # ran and something broke, error means we never got an answer at all, and
    # those call for different responses from whoever reads the report.
    local _status="pass"
    if [[ $total_all -eq 0 ]]; then
        _status="error"
    elif [[ $total_fail -gt 0 ]]; then
        _status="fail"
    fi

    # Write summary. status= is written into the summary too, so a consumer
    # never has to re-derive the verdict from the counts and get it wrong the
    # same way this function did.
    cat >"${run_dir}/${distro}.summary" <<SUMMARY
distro=${distro}
pass=${total_pass}
fail=${total_fail}
skip=${total_skip}
total=${total_all}
status=${_status}
SUMMARY

    echo "$_status" >"$progress_file"

    if [[ "$_status" == "error" ]]; then
        warn "  [${distro}] ran NO tests — see ${log_file}"
    fi

    log "  [${distro}] Done: ${total_pass} pass, ${total_fail} fail, ${total_skip} skip"
}

cmd_run() {
    local mode="quick"
    local distro_filter=""
    DESTROY_ALL="${DESTROY_ALL:-0}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
        --quick)
            mode="quick"
            shift
            ;;
        --full)
            mode="full"
            shift
            ;;
        --distro)
            distro_filter="$2"
            shift 2
            ;;
        *) die "Unknown option: $1" ;;
        esac
    done

    local selected_distros=()
    if [[ -n "$distro_filter" ]]; then
        IFS=',' read -ra selected_distros <<<"$distro_filter"
        for d in "${selected_distros[@]}"; do validate_distro "$d"; done
    else
        selected_distros=("${DISTROS[@]}")
    fi

    ensure_ssh_key

    local run_id
    run_id="$(date +%Y%m%d-%H%M%S)"
    local run_dir="${RESULTS_DIR}/${run_id}"
    mkdir -p "$run_dir"

    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
    echo -e "${W}  kzfs-test run — ${mode} mode${N}"
    echo -e "${D}  Distros: ${selected_distros[*]}${N}"
    echo -e "${D}  Results: ${run_dir}${N}"
    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
    echo ""

    local t_start
    t_start="$(timer_start)"

    # Phase 1: Clone and boot all VMs
    log "Phase 1: Cloning and booting VMs..."
    declare -A vm_ips=()

    for distro in "${selected_distros[@]}"; do
        local name zpath golden_zpath
        name="$(test_vm_name "$distro")"
        zpath="$(zvol_path "$name")"
        golden_zpath="$(zvol_path "$(golden_name "$distro")")"

        if ! zfs list "${golden_zpath}@golden" >/dev/null 2>&1; then
            warn "No golden for ${distro} — skipping (run: kzfs-test golden ${distro})"
            continue
        fi

        # Clean previous
        virsh destroy "$name" 2>/dev/null || true
        virsh undefine "$name" 2>/dev/null || true
        zfs destroy -Rf "$zpath" 2>/dev/null || true

        # Clone
        local ct
        ct="$(timer_start)"
        zfs clone "${golden_zpath}@golden" "$zpath"
        log "  Cloned ${distro} in $(timer_elapsed_ms "$ct")ms"

        local ci_iso zdev
        zdev="$(zvol_dev "$name")"
        ci_iso="$(make_cloud_init_iso "$name" "${PREFIX}-${distro}")"

        virt-install --name "$name" \
            --ram "$RAM" --vcpus "$CPUS" \
            --os-variant "${OS_VARIANTS[$distro]}" \
            --disk "path=${zdev},bus=virtio" \
            --disk "path=${ci_iso},device=cdrom" \
            --network bridge=virbr0,model=virtio \
            --graphics none --noautoconsole --import >/dev/null 2>&1 || {
            warn "Failed to boot ${distro}"
            continue
        }
    done

    # Phase 2: Wait for IPs and SSH
    log "Phase 2: Waiting for VMs..."
    for distro in "${selected_distros[@]}"; do
        local name
        name="$(test_vm_name "$distro")"
        virsh domstate "$name" 2>/dev/null | grep -q running || continue

        local ip
        ip="$(get_vm_ip "$name")"
        if [[ -n "$ip" ]]; then
            wait_for_ssh "$ip" 300 && {
                vm_ips[$distro]="$ip"
                log "  ${distro}: ${ip} (SSH OK)"
            } || warn "  ${distro}: SSH timeout at ${ip}"
        else
            warn "  ${distro}: no IP"
        fi
    done

    # Phase 3: Run tests in parallel
    log "Phase 3: Running ${mode} tests in parallel..."
    declare -A pids=()

    for distro in "${!vm_ips[@]}"; do
        run_tests_on_vm "$distro" "$mode" "$run_dir" "${vm_ips[$distro]}" &
        pids[$distro]=$!
    done

    # Wait for all
    for distro in "${!pids[@]}"; do
        wait "${pids[$distro]}" || true
    done

    local elapsed
    elapsed="$(timer_elapsed_ms "$t_start")"

    # Phase 4: Display results
    echo ""
    cmd_results "$run_id"

    log "Total time: $((elapsed / 1000))s"

    # Symlink latest
    ln -sfn "$run_dir" "${RESULTS_DIR}/latest"

    # Cleanup test VMs (keep goldens)
    log "Cleaning up test VMs..."
    for distro in "${selected_distros[@]}"; do
        local name
        name="$(test_vm_name "$distro")"
        virsh destroy "$name" 2>/dev/null || true
        virsh undefine "$name" 2>/dev/null || true
        zfs destroy -Rf "$(zvol_path "$name")" 2>/dev/null || true
        rm -f "${ISO_DIR}/${name}-cloud-init.iso" 2>/dev/null || true
    done
}

# ── Results ───────────────────────────────────────────────────────────────

cmd_results() {
    local run_id="${1:-}"
    local run_dir

    if [[ -n "$run_id" ]]; then
        run_dir="${RESULTS_DIR}/${run_id}"
    elif [[ -L "${RESULTS_DIR}/latest" ]]; then
        run_dir="$(readlink -f "${RESULTS_DIR}/latest")"
        run_id="$(basename "$run_dir")"
    else
        die "No results found. Run: kzfs-test run"
    fi

    [[ -d "$run_dir" ]] || die "Results not found: ${run_dir}"

    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
    echo -e "${W}  OpenZFS Test Lab — Run ${run_id}${N}"
    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
    echo ""

    printf "  ${W}%-12s %8s %8s %8s %8s %8s${N}\n" \
        "DISTRO" "PASS" "FAIL" "SKIP" "TOTAL" "STATUS"
    echo "  ─────────── ──────── ──────── ──────── ──────── ────────"

    local grand_pass=0 grand_fail=0 grand_skip=0

    for summary in "${run_dir}"/*.summary; do
        [[ -f "$summary" ]] || continue
        local distro pass fail skip total
        # shellcheck source=/dev/null
        source "$summary"

        local status_color="$G" status_text="PASS"
        if [[ "$fail" -gt 0 ]]; then
            status_color="$R"
            status_text="FAIL"
        fi

        printf "  %-12s ${G}%8s${N} ${R}%8s${N} ${Y}%8s${N} %8s ${status_color}%8s${N}\n" \
            "$distro" "$pass" "$fail" "$skip" "$total" "$status_text"

        grand_pass=$((grand_pass + pass))
        grand_fail=$((grand_fail + fail))
        grand_skip=$((grand_skip + skip))
    done

    echo "  ─────────── ──────── ──────── ──────── ──────── ────────"
    local grand_total=$((grand_pass + grand_fail + grand_skip))
    printf "  ${W}%-12s %8s %8s %8s %8s${N}\n" \
        "TOTAL" "$grand_pass" "$grand_fail" "$grand_skip" "$grand_total"

    echo ""
    if [[ $grand_fail -eq 0 && $grand_total -gt 0 ]]; then
        echo -e "  ${G}ALL TESTS PASSED${N}"
    elif [[ $grand_total -eq 0 ]]; then
        echo -e "  ${Y}No results yet${N}"
    else
        echo -e "  ${R}${grand_fail} FAILURES across matrix${N}"
        echo -e "  ${D}Check logs: ${run_dir}/<distro>.log${N}"
    fi
    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
}

# ── Status ────────────────────────────────────────────────────────────────

cmd_status() {
    echo -e "${C}══════════════════════════════════════════════════════════════════════════════════════════════${N}"
    echo -e "${W}  OpenZFS Test Lab — Status${N}"
    echo -e "${D}  Host: $(uname -n) • $(nproc) cores • $(awk '/MemTotal/ {printf "%.0fGB", $2/1048576}' /proc/meminfo) RAM • ZFS source: ${ZFS_SOURCE}${N}"
    echo -e "${C}══════════════════════════════════════════════════════════════════════════════════════════════${N}"
    echo ""

    echo -e "  ${W}Golden Images:${N}"
    echo ""
    printf "  ${W}%-10s %-8s %-10s %-28s %-16s %-8s %-6s %-6s${N}\n" \
        "DISTRO" "STATUS" "SIZE" "KERNEL" "ZFS" "DKMS" "TESTS" "KSH"
    echo "  ────────── ──────── ────────── ──────────────────────────── ──────────────── ──────── ────── ──────"

    local total_ready=0 total_fail=0 total_skip=0

    for distro in "${DISTROS[@]}"; do
        local name zpath
        name="$(golden_name "$distro")"
        zpath="$(zvol_path "$name")"

        if zfs list "${zpath}@golden" >/dev/null 2>&1; then
            local used _kernel _zfs_ver _dkms _tests _ksh _result_color
            used="$(zfs get -Hp -o value used "$zpath" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo "?")"

            # Read details from the latest golden build log
            local _log="${RESULTS_DIR}/goldens/${distro}-latest.log"
            if [[ -f "$_log" ]]; then
                _kernel="$(grep '  Kernel:' "$_log" 2>/dev/null | tail -1 | sed 's/.*Kernel: *//' | head -c 28)"
                _zfs_ver="$(grep '  ZFS version:' "$_log" 2>/dev/null | tail -1 | sed 's/.*ZFS version: *//' | head -c 16)"
                _dkms="$(grep '  Result:' "$_log" 2>/dev/null | tail -1 | sed 's/.*Result: *//')"
                _tests="$(grep '  zfs-tests.sh:' "$_log" 2>/dev/null | tail -1 | sed 's/.*zfs-tests.sh: *//')"
                _ksh="$(grep '  ksh:' "$_log" 2>/dev/null | tail -1 | sed 's/.*ksh: *//')"
            else
                _kernel="-" _zfs_ver="-" _dkms="-" _tests="-" _ksh="-"
            fi

            [[ -z "$_kernel" ]] && _kernel="-"
            [[ -z "$_zfs_ver" ]] && _zfs_ver="-"
            [[ -z "$_tests" ]] && _tests="-"
            [[ -z "$_ksh" ]] && _ksh="-"

            local _status_color="$G" _status="READY"
            if [[ "$_dkms" == *"FAIL"* ]]; then
                _status_color="$R"
                _status="FAIL"
                ((total_fail++))
            elif [[ "$_dkms" == *"PARTIAL"* ]]; then
                _status_color="$Y"
                _status="PARTIAL"
                ((total_fail++))
            else
                ((total_ready++))
            fi

            local _tests_color="$G"
            [[ "$_tests" != "OK" ]] && _tests_color="$R"
            local _ksh_color="$G"
            [[ "$_ksh" != "OK" ]] && _ksh_color="$Y"

            printf "  %-10s ${_status_color}%-8s${N} %-10s %-28s %-16s ${G}%-8s${N} ${_tests_color}%-6s${N} ${_ksh_color}%-6s${N}\n" \
                "$distro" "$_status" "$used" "$_kernel" "$_zfs_ver" "OK" "$_tests" "$_ksh"

        elif zfs list "$zpath" >/dev/null 2>&1; then
            printf "  %-10s ${Y}%-8s${N} %-10s %-28s %-16s %-8s %-6s %-6s\n" \
                "$distro" "PARTIAL" "-" "-" "-" "-" "-" "-"
            ((total_fail++))
        else
            printf "  %-10s ${D}%-8s${N} %-10s %-28s %-16s %-8s %-6s %-6s\n" \
                "$distro" "—" "-" "-" "-" "-" "-" "-"
            ((total_skip++))
        fi
    done

    echo "  ────────── ──────── ────────── ──────────────────────────── ──────────────── ──────── ────── ──────"
    echo -e "  ${G}Ready: ${total_ready}${N}  ${R}Failed: ${total_fail}${N}  ${D}Not built: ${total_skip}${N}  Total: ${#DISTROS[@]}"
    echo ""

    # Storage summary
    local _total_used
    _total_used="$(zfs get -Hp -o value used "${POOL}/vms" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo "?")"
    local _total_avail
    _total_avail="$(zfs get -Hp -o value available "${POOL}/vms" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo "?")"
    echo -e "  ${W}Storage:${N} ${_total_used} used / ${_total_avail} available on ${POOL}/vms"

    echo ""
    echo -e "  ${W}Test VMs:${N}"
    local running=0
    for distro in "${DISTROS[@]}"; do
        local name
        name="$(test_vm_name "$distro")"
        if virsh domstate "$name" 2>/dev/null | grep -q running; then
            local ip
            ip="$(get_vm_ip "$name" 2>/dev/null)"
            echo -e "    ${G}${name}${N}: running (${ip:-no IP})"
            ((running++))
        fi
    done
    [[ $running -eq 0 ]] && echo -e "    ${D}No test VMs running${N}"

    echo ""
    echo -e "  ${W}Results:${N}"
    if [[ -L "${RESULTS_DIR}/latest" ]]; then
        local latest
        latest="$(basename "$(readlink -f "${RESULTS_DIR}/latest")")"
        echo -e "    Latest run: ${latest}"
        echo -e "    Path: ${RESULTS_DIR}/${latest}/"
    else
        echo -e "    ${D}No test runs yet${N}"
    fi

    echo ""
    echo -e "  ${W}Logs:${N} ${RESULTS_DIR}/"
    if [[ -f "$MASTER_LOG" ]]; then
        local _log_lines
        _log_lines="$(wc -l <"$MASTER_LOG" 2>/dev/null || echo 0)"
        echo -e "    Master log: ${MASTER_LOG} (${_log_lines} lines)"
    fi
    local _golden_logs
    _golden_logs="$(ls "${RESULTS_DIR}/goldens/"*-latest.log 2>/dev/null | wc -l)"
    echo -e "    Golden logs: ${_golden_logs} distros"

    echo -e "${C}══════════════════════════════════════════════════════════════════════════════════════════════${N}"
}

# ── Destroy ───────────────────────────────────────────────────────────────

cmd_destroy() {
    local destroy_all="${DESTROY_ALL:-0}"

    if [[ $destroy_all -eq 1 ]]; then
        echo -e "${R}Destroying ALL kzfs-test VMs + golden images${N}"
    else
        echo -e "${Y}Destroying test VMs (goldens preserved)${N}"
    fi

    # Test VMs
    for distro in "${DISTROS[@]}"; do
        local name
        name="$(test_vm_name "$distro")"
        virsh destroy "$name" 2>/dev/null && log "  Stopped ${name}" || true
        virsh undefine "$name" 2>/dev/null || true
        zfs destroy -Rf "$(zvol_path "$name")" 2>/dev/null || true
        rm -f "${ISO_DIR}/${name}-cloud-init.iso" 2>/dev/null || true

        # Verify VMs too
        local vname
        vname="$(test_vm_name "verify-${distro}")"
        virsh destroy "$vname" 2>/dev/null || true
        virsh undefine "$vname" 2>/dev/null || true
        zfs destroy -Rf "$(zvol_path "$vname")" 2>/dev/null || true
    done

    if [[ $destroy_all -eq 1 ]]; then
        for distro in "${DISTROS[@]}"; do
            local name
            name="$(golden_name "$distro")"
            virsh destroy "$name" 2>/dev/null || true
            virsh undefine "$name" 2>/dev/null || true
            zfs destroy -Rf "$(zvol_path "$name")" 2>/dev/null || true
            rm -f "${ISO_DIR}/${name}-cloud-init.iso" 2>/dev/null || true
            log "  Destroyed golden: ${name}"
        done
    fi

    # Clean up RHEL credentials on full destroy
    if [[ $destroy_all -eq 1 && -f "$RHEL_CREDS_FILE" ]]; then
        rm -f "$RHEL_CREDS_FILE"
        RHEL_USERNAME="" RHEL_PASSWORD=""
        log "  RHEL credentials removed"
    fi

    log "Cleanup complete"
}

# ── Interactive Menu ──────────────────────────────────────────────────────

pause() {
    echo ""
    read -r -p "  Press Enter to continue..." _
}

_count_goldens() {
    local count=0
    for d in "${DISTROS[@]}"; do
        zfs list "$(zvol_path "$(golden_name "$d")")@golden" >/dev/null 2>&1 && ((count++))
    done
    echo "$count"
}

_count_running() {
    local count=0
    for d in "${DISTROS[@]}"; do
        virsh domstate "$(test_vm_name "$d")" 2>/dev/null | grep -q running && ((count++))
    done
    echo "$count"
}

menu_header() {
    clear
    local goldens running
    goldens="$(_count_goldens)"
    running="$(_count_running)"
    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
    echo -e "${W}   OpenZFS Test Lab — kldload 1.0.4                         ${N}"
    echo -e "${D}   ${goldens}/7 goldens • ${running} VMs running • $(nproc) cores • $(awk '/MemTotal/ {printf "%.0fGB", $2/1048576}' /proc/meminfo) RAM${N}"
    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
    echo ""
}

menu() {
    menu_header
    echo -e "  ${C}── Golden Images ──────────────────────────────────────────${N}"
    echo -e "  ${G} 1${N}  Build golden — single distro"
    echo -e "  ${G} 2${N}  Build golden — ALL distros"
    echo -e "  ${G} 3${N}  Status — show all goldens, VMs, results"
    echo ""
    echo -e "  ${C}── Verify ─────────────────────────────────────────────────${N}"
    echo -e "  ${G} 4${N}  Verify — single distro (boot, check ZFS, check tests)"
    echo -e "  ${G} 5${N}  Verify — ALL distros"
    echo ""
    echo -e "  ${C}── Run Tests ──────────────────────────────────────────────${N}"
    echo -e "  ${G} 6${N}  Quick test — single distro (~15 min)"
    echo -e "  ${G} 7${N}  Quick test — ALL distros (~15 min)"
    echo -e "  ${G} 8${N}  Full test — single distro (~2-4 hours)"
    echo -e "  ${G} 9${N}  Full test — ALL distros (~2-4 hours)"
    echo ""
    echo -e "  ${C}── Results & Logs ─────────────────────────────────────────${N}"
    echo -e "  ${G}10${N}  Show latest results matrix"
    echo -e "  ${G}11${N}  Show results by run ID"
    echo -e "  ${G}12${N}  View golden build log (per distro)"
    echo -e "  ${G}13${N}  View master log (tail)"
    echo ""
    echo -e "  ${C}── ZFS Version ────────────────────────────────────────────${N}"
    local _src_display="$ZFS_SOURCE"
    [[ "$ZFS_SOURCE" == "repo" ]] && _src_display="distro default"
    echo -e "  ${G}zv${N}  Change ZFS version ${D}(current: ${_src_display})${N}"
    echo -e "  ${D}      Logs: ${RESULTS_DIR}/${N}"
    echo ""
    echo -e "  ${C}── Cleanup ────────────────────────────────────────────────${N}"
    echo -e "  ${R} 0${N}  Destroy test VMs (keep goldens)"
    echo -e "  ${R}00${N}  Destroy EVERYTHING (VMs + goldens)"
    echo -e "  ${R} q${N}  Quit"
    echo ""
    echo -ne "${W}  Select: ${N}"
}

menu_pick_distro() {
    echo ""
    echo -e "  ${C}── Pick a distro ──────────────────────────────────────────${N}"
    local i=1
    for d in "${DISTROS[@]}"; do
        local status=""
        if zfs list "$(zvol_path "$(golden_name "$d")")@golden" >/dev/null 2>&1; then
            status="${G}[golden]${N}"
        fi
        printf "  ${G}%d${N}  %-12s %b\n" "$i" "$d" "$status"
        ((i++))
    done
    echo ""
    echo -ne "${W}  Select (1-${#DISTROS[@]}): ${N}"
    local choice
    read -r choice
    if [[ "$choice" =~ ^[0-9]+$ ]] && [[ "$choice" -ge 1 ]] && [[ "$choice" -le ${#DISTROS[@]} ]]; then
        PICKED_DISTRO="${DISTROS[$((choice - 1))]}"
        return 0
    else
        echo -e "${R}  Invalid selection${N}"
        return 1
    fi
}

menu_pick_zfs_version() {
    echo ""
    echo -e "  ${C}── ZFS Version ────────────────────────────────────────────${N}"
    echo -e "  ${G}1${N}  Distro default (whatever the repo ships)"
    echo -e "  ${G}2${N}  Release version (e.g., 2.3.0, 2.2.7)"
    echo -e "  ${G}3${N}  Git branch/PR (e.g., openzfs/zfs@master, openzfs/zfs@fix-deadlock)"
    echo -e "  ${G}4${N}  Local tarball (path to .tar.gz)"
    echo ""
    local _cur="$ZFS_SOURCE"
    [[ "$_cur" == "repo" ]] && _cur="distro default"
    echo -e "  ${D}Current: ${_cur}${N}"
    echo ""
    echo -ne "${W}  Select (1-4): ${N}"
    local choice
    read -r choice
    case "$choice" in
    1)
        ZFS_SOURCE="repo"
        log "ZFS source: distro default"
        ;;
    2)
        echo -ne "  ${W}Version (e.g., 2.3.0): ${N}"
        local ver
        read -r ver
        if [[ -n "$ver" ]]; then
            ZFS_SOURCE="version:${ver}"
            log "ZFS source: release ${ver}"
        fi
        ;;
    3)
        echo -ne "  ${W}Git ref (e.g., openzfs/zfs@master): ${N}"
        local ref
        read -r ref
        if [[ -n "$ref" ]]; then
            ZFS_SOURCE="git:${ref}"
            log "ZFS source: git ${ref}"
        fi
        ;;
    4)
        echo -ne "  ${W}Path to tarball: ${N}"
        local path
        read -r path
        if [[ -f "$path" ]]; then
            ZFS_SOURCE="tarball:${path}"
            log "ZFS source: tarball ${path}"
        else
            warn "File not found: ${path}"
        fi
        ;;
    *)
        echo -e "${R}  Invalid selection${N}"
        ;;
    esac
    echo ""
    echo -e "  ${W}NOTE:${N} Changing the ZFS version requires rebuilding goldens."
    echo -e "  ${D}Destroy existing goldens first, then rebuild.${N}"
}

menu_confirm_destroy() {
    echo ""
    echo -e "${R}  This will destroy ALL kzfs-test VMs and golden images.${N}"
    echo -e "${R}  Cloud images in ${ISO_DIR} will be preserved.${N}"
    echo ""
    read -r -p "  Type 'destroy' to confirm: " confirm
    [[ "$confirm" == "destroy" ]]
}

interactive_menu() {
    local PICKED_DISTRO=""

    while true; do
        menu
        local choice
        read -r choice
        case "$choice" in
        1)
            menu_header
            if menu_pick_distro; then
                cmd_golden "$PICKED_DISTRO"
                pause
            fi
            ;;
        2)
            menu_header
            cmd_golden all
            pause
            ;;
        3)
            menu_header
            cmd_status
            pause
            ;;
        4)
            menu_header
            if menu_pick_distro; then
                cmd_verify "$PICKED_DISTRO"
                pause
            fi
            ;;
        5)
            menu_header
            cmd_verify all
            pause
            ;;
        6)
            menu_header
            if menu_pick_distro; then
                cmd_run --quick --distro "$PICKED_DISTRO"
                pause
            fi
            ;;
        7)
            menu_header
            cmd_run --quick
            pause
            ;;
        8)
            menu_header
            if menu_pick_distro; then
                cmd_run --full --distro "$PICKED_DISTRO"
                pause
            fi
            ;;
        9)
            menu_header
            cmd_run --full
            pause
            ;;
        10)
            menu_header
            cmd_results ""
            pause
            ;;
        11)
            menu_header
            echo -e "  ${W}Available runs:${N}"
            ls -1 "$RESULTS_DIR" 2>/dev/null | grep -v latest || echo "  No runs yet"
            echo ""
            echo -ne "  ${W}Run ID: ${N}"
            local run_id
            read -r run_id
            [[ -n "$run_id" ]] && cmd_results "$run_id"
            pause
            ;;
        12)
            menu_header
            if menu_pick_distro; then
                local _glog="${RESULTS_DIR}/goldens/${PICKED_DISTRO}-latest.log"
                if [[ -f "$_glog" ]]; then
                    echo -e "  ${W}Golden build log: ${PICKED_DISTRO}${N}"
                    echo -e "  ${D}${_glog}${N}"
                    echo ""
                    cat "$_glog"
                else
                    echo -e "  ${Y}No golden build log for ${PICKED_DISTRO}${N}"
                    echo -e "  ${D}Build a golden first: option 1${N}"
                fi
                pause
            fi
            ;;
        13)
            menu_header
            echo -e "  ${W}Master log (last 50 lines):${N}"
            echo -e "  ${D}${MASTER_LOG}${N}"
            echo ""
            tail -50 "$MASTER_LOG" 2>/dev/null || echo "  No log yet"
            pause
            ;;
        0)
            menu_header
            DESTROY_ALL=0
            cmd_destroy
            pause
            ;;
        00)
            menu_header
            if menu_confirm_destroy; then
                DESTROY_ALL=1
                cmd_destroy
            else
                echo -e "${Y}  Cancelled${N}"
            fi
            pause
            ;;
        zv | ZV)
            menu_header
            menu_pick_zfs_version
            pause
            ;;
        q | Q)
            echo ""
            exit 0
            ;;
        *)
            echo -e "${R}  Invalid option${N}"
            sleep 1
            ;;
        esac
    done
}

# ── Usage ─────────────────────────────────────────────────────────────────

usage() {
    cat <<'USAGE'
kzfs-test — OpenZFS Test Lab

Usage:
  kzfs-test                                Interactive menu
  kzfs-test golden [distro|all]            Build golden images (one-time, cached)
  kzfs-test verify [distro|all]            Smoke test — boot, check ZFS, check tests
  kzfs-test run [--quick|--full] [--distro d1,d2]  Run zfs-tests.sh across distros
  kzfs-test status                         Show goldens, VMs, last results
  kzfs-test results [run-id]               Display test matrix
  kzfs-test destroy [--all]                Destroy test VMs (--all includes goldens)

Distros: centos rocky fedora debian ubuntu arch alpine

ZFS Version Flags (for golden/run):
  --zfs-version 2.3.0               Build from release tarball
  --zfs-git openzfs/zfs@master       Build from git branch
  --zfs-git @fix-deadlock            Build from openzfs/zfs branch (shorthand)
  --zfs-tarball /path/to/zfs.tar.gz  Build from local tarball

Examples:
  kzfs-test                                # Interactive menu
  kzfs-test golden all                     # Build all 7 golden images
  kzfs-test golden centos --zfs-version 2.3.0  # Golden with specific ZFS
  kzfs-test golden all --zfs-git @master   # All goldens from git master
  kzfs-test verify                         # Quick check all goldens work
  kzfs-test run --quick                    # ~15 min subset on all distros
  kzfs-test run --full --distro centos,debian  # Full suite on 2 distros
  kzfs-test results                        # Show last run's matrix
  kzfs-test destroy --all                  # Nuke everything
USAGE
    exit 0
}

# ── Dispatch ──────────────────────────────────────────────────────────────

DESTROY_ALL=0
CMD="${1:-}"

# No args = interactive menu
if [[ -z "$CMD" ]]; then
    interactive_menu
    exit 0
fi

shift

# Parse global flags
_args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
    --all)
        DESTROY_ALL=1
        shift
        ;;
    --zfs-version)
        ZFS_SOURCE="version:$2"
        shift 2
        ;;
    --zfs-git)
        ZFS_SOURCE="git:$2"
        shift 2
        ;;
    --zfs-tarball)
        ZFS_SOURCE="tarball:$2"
        shift 2
        ;;
    *)
        _args+=("$1")
        shift
        ;;
    esac
done
set -- "${_args[@]+"${_args[@]}"}"

case "$CMD" in
golden) cmd_golden "${1:-all}" ;;
verify) cmd_verify "${1:-all}" ;;
run) cmd_run "$@" ;;
status) cmd_status ;;
results) cmd_results "${1:-}" ;;
destroy) cmd_destroy ;;
menu) interactive_menu ;;
help | -h | --help) usage ;;
*) usage ;;
esac
