#!/usr/bin/env python3
"""kldload-app — native GTK/WebKit window that embeds one kldload web-console
view (Bob, Kubernetes, VMs, Metrics, ...) as a real desktop app: no browser
chrome, no "make Chrome default" nag, and the left nav menu stripped out so
each window is just its tool. Reuses the existing webui HTML — no rewrite.

Usage: kldload-app <view> [Title]
GTK3 + WebKit2 4.1 (avoids the GTK4/NVIDIA libnvidia-glcore crash).
"""
import sys
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gtk, WebKit2, GLib  # noqa: E402

VIEW = sys.argv[1] if len(sys.argv) > 1 else "bob"
TITLE = sys.argv[2] if len(sys.argv) > 2 else VIEW.replace("-", " ").title()
URL = "https://localhost:8443/?app=1#%s" % VIEW

# Strip the left nav + reclaim the space. The webui layout puts #sidebar beside
# #main; hiding it and zeroing #main's offset gives a clean single-tool window.
HIDE_CSS = (
    "#sidebar{display:none!important;}"
    "#main{margin-left:0!important;left:0!important;width:100vw!important;max-width:100vw!important;}"
    "#content{margin-left:0!important;}"
)

# Accept the self-signed localhost cert.
ctx = WebKit2.WebContext.get_default()
ctx.set_tls_errors_policy(WebKit2.TLSErrorsPolicy.IGNORE)

ucm = WebKit2.UserContentManager()
ucm.add_style_sheet(WebKit2.UserStyleSheet(
    HIDE_CSS,
    WebKit2.UserContentInjectedFrames.TOP_FRAME,
    WebKit2.UserStyleLevel.USER,
    None, None,
))

web = WebKit2.WebView.new_with_user_content_manager(ucm)
s = web.get_settings()
s.set_enable_media_stream(True)     # Bob's hot mic
s.set_enable_webrtc(True)
s.set_media_playback_requires_user_gesture(False)

# Auto-grant mic/media permission (local trusted app — no prompt for hot mic).
def _on_permission(_wv, request):
    try:
        request.allow()
    except Exception:
        pass
    return True
web.connect("permission-request", _on_permission)

win = Gtk.Window(title="kldload — %s" % TITLE)
win.set_default_size(1100, 820)
win.set_wmclass("kldload-%s" % VIEW, "kldload-%s" % VIEW)
win.connect("destroy", Gtk.main_quit)
win.add(web)
web.load_uri(URL)
win.show_all()
Gtk.main()
