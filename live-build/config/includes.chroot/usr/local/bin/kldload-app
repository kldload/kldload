#!/usr/bin/env python3
"""kldload-app — native GTK/WebKit window that embeds one kldload web-console
view (Bob, Kubernetes, VMs, Metrics, ...) as a real desktop app: no browser
chrome, no "make Chrome default" nag, and the left nav menu stripped out so
each window is just its tool. Reuses the existing webui HTML — no rewrite.

Usage: kldload-app <view> [Title]
GTK3 + WebKit2 4.1 (avoids the GTK4/NVIDIA libnvidia-glcore crash).
"""
import os
# NVIDIA + Wayland: WebKitGTK's DMABUF GPU renderer SIGSEGVs ("Error 71
# Protocol error dispatching to Wayland display") a few seconds after the
# window opens — the window appears then dies. Caught 2026-05-31 on .137
# (RTX 3080, GNOME 49 Wayland). Disabling just the DMABUF renderer fixes it
# surgically (the rest of the desktop keeps GPU accel). The compositing +
# software-GL fallbacks are belt-and-suspenders for older/odd GPUs.
# MUST be set before WebKit2 is imported/initialised.
os.environ.setdefault("WEBKIT_DISABLE_DMABUF_RENDERER", "1")
os.environ.setdefault("WEBKIT_DISABLE_COMPOSITING_MODE", "1")
os.environ.setdefault("GDK_BACKEND", "wayland,x11")
import sys
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gtk, WebKit2, GLib  # noqa: E402

VIEW = sys.argv[1] if len(sys.argv) > 1 else "bob"
TITLE = sys.argv[2] if len(sys.argv) > 2 else VIEW.replace("-", " ").title()
URL = "https://localhost:8443/?app=1#%s" % VIEW

# Strip the left nav + reclaim the space. The webui layout puts #sidebar beside
# #main; hiding it and zeroing #main's offset gives a clean single-tool window.
HIDE_CSS = (
    "#sidebar{display:none!important;}"
    "#main{margin-left:0!important;left:0!important;width:100vw!important;max-width:100vw!important;}"
    "#content{margin-left:0!important;}"
)

# Accept the self-signed localhost cert. The webui serves HTTPS on :8443 with a
# self-signed cert. The old WebContext.set_tls_errors_policy(IGNORE) is BOTH
# deprecated AND no longer honored in WebKitGTK 2.48 (RHEL 10 / el10) -> the
# cert is rejected -> blank white screen with a TLS error. Caught 2026-05-31 on
# .137. The reliable path in WebKit2 4.1: explicitly whitelist the cert for the
# host on the load-failed-with-tls-errors signal, then reload. Keep the policy
# call too (harmless where it still works on older webkit).
ctx = WebKit2.WebContext.get_default()
try:
    ctx.set_tls_errors_policy(WebKit2.TLSErrorsPolicy.IGNORE)
except Exception:
    pass

ucm = WebKit2.UserContentManager()
ucm.add_style_sheet(WebKit2.UserStyleSheet(
    HIDE_CSS,
    WebKit2.UserContentInjectedFrames.TOP_FRAME,
    WebKit2.UserStyleLevel.USER,
    None, None,
))

web = WebKit2.WebView.new_with_user_content_manager(ucm)
s = web.get_settings()
s.set_enable_media_stream(True)     # Bob's hot mic
s.set_enable_webrtc(True)
s.set_media_playback_requires_user_gesture(False)

# Auto-grant mic/media permission (local trusted app — no prompt for hot mic).
def _on_permission(_wv, request):
    try:
        request.allow()
    except Exception:
        pass
    return True
web.connect("permission-request", _on_permission)

# Self-signed localhost cert: whitelist it for the host and reload (the
# WebContext policy above is a no-op on WebKitGTK 2.48). Guard against a reload
# loop with a flag.
_tls_allowed = {"done": False}
def _on_tls_error(webview, failing_uri, certificate, errors):
    if _tls_allowed["done"]:
        return False
    _tls_allowed["done"] = True
    try:
        host = GLib.Uri.parse(failing_uri, GLib.UriFlags.NONE).get_host() or "localhost"
    except Exception:
        host = "localhost"
    try:
        ctx.allow_tls_certificate_for_host(certificate, host)
        webview.load_uri(failing_uri)
    except Exception as e:
        sys.stderr.write("kldload-app: TLS whitelist failed: %s\n" % e)
        return False
    return True
web.connect("load-failed-with-tls-errors", _on_tls_error)

win = Gtk.Window(title="kldload — %s" % TITLE)
win.set_default_size(1100, 820)
win.set_wmclass("kldload-%s" % VIEW, "kldload-%s" % VIEW)
win.connect("destroy", Gtk.main_quit)
win.add(web)
web.load_uri(URL)
win.show_all()
Gtk.main()
