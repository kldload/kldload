#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# kvm-clone — make a new VM from an existing one, as a ZFS clone of its disk.
#
#   1. checks both names, and that the source has a volume and a domain;
#   2. takes a snapshot of the source (pausing it for a moment if it is
#      running), or uses the one --snap names;
#   3. clones the snapshot to rpool/vms/<new>, which copies nothing: the
#      clone shares every block with the snapshot until either is written;
#   4. copies the source's UEFI variables and its libvirt definition, pointing
#      the copy at the new volume, a new MAC and a new UUID;
#   5. attaches a cloud-init seed so the clone boots with its own hostname,
#      machine-id, root key, sshd and guest agent (best effort);
#   6. registers the clone in the kldload state DB.
#
# WHY: a golden is prepared once and every machine after it is a clone --
# klab, kube-cluster, the estate tests and the consoles all clone through this.
# Man page: kvm-clone(8).
#
# Exit: 0 cloned, 1 failed (anything already created is removed again),
# 2 usage error.
# ─────────────────────────────────────────────────────────────────────────────
set -Eeuo pipefail
trap 'echo "kvm-clone: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

# Auto-elevate to root (ZFS + libvirt require it)
# Rule 9: -h/--help answers before this re-exec. These tools already had
# perfectly good usage text -- it just could not be reached without root.
if [[ $EUID -ne 0 && "${1:-}" != -h && "${1:-}" != --help ]]; then exec sudo "$0" "$@"; fi

usage() {
    cat <<EOF
Usage: kvm-clone <source-vm> <new-name> [--snap <snapshot>]

Creates an instant copy-on-write clone of a VM. Zero bytes copied --
the clone shares all data with the source until either is modified.
The clone gets its own MAC, UUID and UEFI variables, and a cloud-init
seed that gives it its own hostname, machine-id and root ssh key.
It is defined, not started: virsh start <new-name>.

Options:
  --snap <name>   Clone from an existing snapshot of the source:
                  golden, @golden, or rpool/vms/<source>@golden.
                  Without it, a new snapshot is taken (a running
                  source is paused for the moment it takes).

Examples:
  kvm-clone template webserver-01     # snapshot + clone
  kvm-clone template webserver-02     # another clone, instant
  kvm-clone myvm test --snap @stable  # clone from named snapshot

Names are letters, digits, '.', '_' and '-', starting with a letter or digit.

Exit: 0 cloned, 1 failed (anything it created is removed again),
2 usage error.
EOF
    # asked-for help is 0; a usage error is 2, apart from a clone that ran
    # and failed (1). It was 1 for both.
    exit "${1:-2}"
}

[[ "${1:-}" == -h || "${1:-}" == --help ]] && usage 0
[[ $# -lt 2 ]] && usage
SOURCE="$1"
DEST="$2"
shift 2

SNAP_NAME=""
_made_snap=0
while [[ $# -gt 0 ]]; do
    case "$1" in
    --snap)
        # a bare trailing --snap died with "unbound variable" under set -u
        [[ -n "${2:-}" && "${2:-}" != --* ]] || {
            echo "kvm-clone: --snap needs a snapshot name" >&2
            usage
        }
        SNAP_NAME="$2"
        shift 2
        ;;
    *)
        echo "kvm-clone: unknown option: $1" >&2
        usage
        ;;
    esac
done

die() {
    echo "kvm-clone: $*" >&2
    exit 1
}

# SAFETY: both names become dataset paths AND sed patterns below (the domain
# XML is rewritten by name). A "/" nests a dataset, a "." matches any
# character in the pattern, a "|" breaks the sed expression outright.
for _n in "$SOURCE" "$DEST"; do
    [[ "$_n" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$ ]] || {
        echo "kvm-clone: '${_n}' is not a plain name (letters, digits, . _ -)" >&2
        usage
    }
done
[[ "$SOURCE" != "$DEST" ]] || {
    echo "kvm-clone: the new name is the source's name" >&2
    usage
}
# the names as literal sed patterns: a "." in a name must match only a "."
_re() { printf '%s' "$1" | sed 's/[.]/\\./g'; }

SRC_ZVOL="rpool/vms/${SOURCE}"
DST_ZVOL="rpool/vms/${DEST}"

zfs list "${SRC_ZVOL}" >/dev/null 2>&1 || die "no volume ${SRC_ZVOL}"
# the definition is copied from the source's domain; without one, the clone
# was made and then removed with a misleading "Failed to define"
virsh dominfo "${SOURCE}" >/dev/null 2>&1 || die "${SOURCE} has a volume but no libvirt domain to copy"
zfs list "${DST_ZVOL}" >/dev/null 2>&1 && die "${DST_ZVOL} already exists"
virsh dominfo "${DEST}" >/dev/null 2>&1 && die "a domain named ${DEST} already exists"

# Create or use snapshot
if [[ -n "$SNAP_NAME" ]]; then
    # Accept all three spellings, because --help documents the one that used
    # to fail:  `--snap @golden`, `--snap golden`, `--snap rpool/vms/x@golden`.
    #
    # The test was `[[ "$SNAP_NAME" != *@* ]] && SNAP_NAME="${SRC_ZVOL}@..."`,
    # which asks "does it already contain an @?" — and "@golden" does. So the
    # dataset prefix was skipped and zfs got a bare "@golden":
    #   cannot open '@golden': empty component or misplaced '@' delimiter
    # That is the exact invocation in the EXAMPLES block above
    # (`kvm-clone myvm test --snap @stable`), so the only form that worked was
    # the one nobody was told about. Caught on fiend 2026-09-03 cloning a
    # desktop golden.
    #
    # A '/' is what actually distinguishes a fully-qualified snapshot from a
    # short name; '@' does not.
    case "$SNAP_NAME" in
    */*@*) SNAP="$SNAP_NAME" ;;
    *) SNAP="${SRC_ZVOL}@${SNAP_NAME#@}" ;;
    esac
    zfs list -H -t snapshot "${SNAP}" >/dev/null 2>&1 || die "no snapshot ${SNAP}"
else
    SNAP="${SRC_ZVOL}@clone-$(date +%Y%m%d_%H%M%S%N)"
    # A running source is paused for the snapshot, so its disk is consistent.
    # SAFETY: whatever happens to the snapshot, a paused source is resumed --
    # a failed `zfs snapshot` used to exit under set -e with the source (often
    # the golden) left paused, silently (man page review, 2026-09-29).
    STATE=$(virsh domstate "${SOURCE}" 2>/dev/null || echo "unknown")
    _paused=0
    if [[ "$STATE" == "running" ]]; then
        if virsh suspend "${SOURCE}" >/dev/null; then
            _paused=1
        else
            echo "kvm-clone: WARNING: could not pause ${SOURCE}; the snapshot is taken live (crash-consistent)" >&2
        fi
    fi
    _snap_rc=0
    zfs snapshot "${SNAP}" || _snap_rc=$?
    if ((_paused)); then
        virsh resume "${SOURCE}" >/dev/null ||
            echo "kvm-clone: WARNING: ${SOURCE} is still PAUSED -- virsh resume ${SOURCE}" >&2
    fi
    ((_snap_rc == 0)) || die "could not snapshot ${SRC_ZVOL}"
    _made_snap=1
fi

# Clone the zvol (instant, zero copy). From here on, a failure removes what
# this run created: an orphan clone blocks the name and holds the snapshot.
echo "Cloning ${SNAP} -> ${DST_ZVOL}..."
zfs clone "${SNAP}" "${DST_ZVOL}"
_undo() {
    virsh undefine --nvram "${DEST}" >/dev/null 2>&1 || true # not defined yet is the common case
    [[ -z "${NVRAM_DST:-}" ]] || rm -f "$NVRAM_DST"
    zfs destroy "${DST_ZVOL}" ||
        echo "kvm-clone: could not remove ${DST_ZVOL} -- zfs destroy ${DST_ZVOL}" >&2
    # only a snapshot this run took; one named with --snap is the operator's
    if ((_made_snap)); then
        zfs destroy "${SNAP}" ||
            echo "kvm-clone: could not remove ${SNAP} -- zfs destroy ${SNAP}" >&2
    fi
}
trap '_undo' EXIT

# Tag the clone with its origin snapshot for cleanup tracking
zfs set com.kldload:clone-origin="${SNAP}" "${DST_ZVOL}"

# The UEFI variable store: each VM needs its own. The path is READ from the
# source's definition, not assumed. It was assumed to be <name>_VARS.fd, and
# current libvirt writes <name>_VARS.qcow2 -- so on EL10/F44 hosts every clone
# of a UEFI VM (every kvm-create VM) kept the SOURCE's store in its definition:
# two VMs, one set of boot variables (man page review, onyx, 2026-09-29).
NVRAM_SRC="$(virsh dumpxml "${SOURCE}" | sed -n 's|.*<nvram[^>]*>\([^<]*\)</nvram>.*|\1|p' | head -n 1)"
NVRAM_DST=""
if [[ -n "$NVRAM_SRC" ]]; then
    NVRAM_DST="$(dirname "$NVRAM_SRC")/${DEST}_VARS.${NVRAM_SRC##*.}"
    if [[ -f "$NVRAM_SRC" ]]; then
        cp -p "$NVRAM_SRC" "$NVRAM_DST"
    else
        # never started: libvirt creates the store from its template on first
        # boot, so the clone only needs its own path in the definition
        :
    fi
fi

# Clone the libvirt domain definition via XML manipulation.
# The XML may reference the zvol as /dev/zvol/pool/name OR as the resolved
# /dev/zdN device. We must replace BOTH forms so the clone points to its
# own zvol, not the source's.
echo "Cloning VM definition..."
SRC_DEV="$(readlink -f "/dev/zvol/${SRC_ZVOL}" 2>/dev/null || echo "/dev/zvol/${SRC_ZVOL}")"
DST_DEV="$(readlink -f "/dev/zvol/${DST_ZVOL}" 2>/dev/null || echo "/dev/zvol/${DST_ZVOL}")"
virsh dumpxml "${SOURCE}" |
    sed "s|<name>$(_re "${SOURCE}")</name>|<name>${DEST}</name>|" |
    sed "s|$(_re "${SRC_ZVOL}")|${DST_ZVOL}|g" |
    sed "s|$(_re "${SRC_DEV}")|${DST_DEV}|g" |
    if [[ -n "$NVRAM_SRC" ]]; then sed "s|>$(_re "${NVRAM_SRC}")</nvram>|>${NVRAM_DST}</nvram>|"; else cat; fi |
    # Per-VM log paths. klab points <serial> and <console> at
    # /var/log/klab/<vm>-console.log, and a straight XML copy leaves every
    # clone pointing at the GOLDEN's file. libvirt opens it exclusively, so
    # the first clone to boot takes it and every later one dies with
    #   Cannot open log file: ... Device or resource busy
    # which caps a golden at exactly one running clone. Measured on .120
    # (2026-08-23): dtest-a started, dtest-b refused, same log path.
    # Rewrite the whole prefix rather than just -console.log, so any other
    # per-VM log klab adds later is carried along too.
    sed "s|/var/log/klab/$(_re "${SOURCE}")-|/var/log/klab/${DEST}-|g" |
    sed '/<uuid>/d' |
    sed '/<mac address/d' |
    virsh define /dev/stdin >/dev/null || die "could not define ${DEST} from ${SOURCE}'s definition"

# The source's OWN seed comes along in the copied definition when the source
# is itself a clone. Left there it took target sda, so the clone's seed could
# not attach ("seed built but could not be attached"), the clone booted with
# its source's hostname, and it pointed at the source's seed file -- which
# kvm-delete removes with the source, after which the clone no longer starts
# (a clone of a kvm-golden build, onyx, 2026-09-29). Only the file named for
# SOURCE is detached; any other cdrom stays.
while read -r _t _d _tgt _src; do
    if [[ "$_d" == cdrom && "${_src##*/}" == "${SOURCE}-seed.iso" ]]; then
        virsh detach-disk "$DEST" "$_tgt" --config >/dev/null ||
            die "could not detach ${SOURCE}'s seed from ${DEST}"
    fi
done < <(virsh domblklist "$DEST" --details | awk 'NR > 2 && NF >= 4 {print $1, $2, $3, $4}')
# The clone exists and is defined: from here on nothing is undone, because
# the seed below is best effort and a clone without it still boots.
trap - EXIT

# ── Give the clone an identity of its own ────────────────────────────────────
#
# A clone is a byte-for-byte copy of the golden, so without this it boots
# believing it IS the golden: same hostname, same machine-id, same (or absent)
# host keys. Three symptoms, one cause, all observed on .110 2026-08-21:
#
#   1. Its DHCP lease carries no hostname, so the inventory sync could not
#      match it and it never reached Ansible at all.
#   2. sshd is not configured for it — `ansible -m ping` gets connection
#      refused on every clone while every seeded VM answers SUCCESS.
#   3. qemu-guest-agent is not running, so libvirt can see nothing inside it
#      and can only ask it to shut down via ACPI.
#
# kspawn has always regenerated a seed per node, which is exactly why its
# clones behave and these did not. This gives kvm-clone the same treatment.
#
# cloud-init reads a NoCloud seed from a volume labelled "cidata". Writing a
# fresh one and attaching it as a cdrom is all it takes: on first boot the
# clone sets its own hostname, installs the operator's key, and starts sshd and
# the guest agent.
#
# BEST EFFORT, deliberately. A clone that boots is worth more than a clone that
# refused to be created because genisoimage was missing or the guest has no
# cloud-init — the clone itself already succeeded by this point, and every
# failure below leaves it exactly as it was before: usable, just anonymous.
_seed_dir="/var/lib/libvirt/images"
_seed_iso="${_seed_dir}/${DEST}-seed.iso"
_mkiso=""
for _c in genisoimage mkisofs xorrisofs; do
    command -v "$_c" >/dev/null 2>&1 && {
        _mkiso="$_c"
        break
    }
done

if [[ -n "$_mkiso" ]]; then
    _ssh_pub=""
    for _k in /root/.ssh/id_ed25519.pub /root/.ssh/id_rsa.pub; do
        [[ -r "$_k" ]] && {
            _ssh_pub="$(cat "$_k")"
            break
        }
    done

    _tmp="$(mktemp -d)"
    trap 'rm -rf "${_tmp}"' EXIT
    printf 'instance-id: %s\nlocal-hostname: %s\n' "$DEST" "$DEST" >"${_tmp}/meta-data"
    {
        echo "#cloud-config"
        echo "hostname: ${DEST}"
        echo "manage_etc_hosts: true"
        echo "preserve_hostname: false"
        # disable_root defaults to TRUE, and that is what installs the
        # forced-command banner in root's authorized_keys. Everything in this
        # estate connects as root, so say so here rather than undoing it below.
        echo "disable_root: false"
        [[ -n "$_ssh_pub" ]] && printf 'ssh_authorized_keys:\n  - %s\n' "$_ssh_pub"
        # ROOT's key, explicitly. The line above is cloud-init's top-level form,
        # which installs the key for the DEFAULT user only — root keeps whatever
        # the distro image shipped, and Debian/Ubuntu cloud images ship a forced
        # command that answers every root login with
        #   Please login as the user "debian" rather than the user "root".
        # Everything here connects as root: klab drives goldens that way,
        # kldload-enroll hardcodes root@, and so does the image test harness.
        # Measured on .120 (2026-08-23): four fresh clones, root refused on all
        # four, enrollment dead in the water.
        # write_files rather than a runcmd shell line: the key contains spaces
        # and +/= and would need quoting through two layers to survive.
        if [[ -n "$_ssh_pub" ]]; then
            printf 'write_files:\n'
            printf '  - path: /root/.ssh/kldload_authorized_key\n'
            printf '    permissions: %s\n' "'0600'"
            printf '    owner: root:root\n'
            printf '    content: %s\n' "$_ssh_pub"
        fi
        # Regenerate the machine-id: cloned guests otherwise share the golden's,
        # and a duplicate machine-id makes DHCP hand out the same lease twice
        # and systemd-journald collide on the same identifier.
        echo "runcmd:"
        echo "  - [ sh, -c, \"rm -f /etc/machine-id && systemd-machine-id-setup\" ]"
        # One unit name per family, tried in turn. `enable --now ssh.service
        # sshd.service` in ONE call failed on both: on RPM ssh.service does not
        # exist, so systemctl refused the whole call and sshd was never
        # enabled; on Debian sshd.service is only an alias until ssh.service
        # is enabled. Then the outcome is checked with is-enabled and a miss
        # is written to cloud-init's own log (/var/log/cloud-init-output.log
        # in the guest), which is where anyone debugging "no ssh to the clone"
        # looks first (2026-09-23).
        echo "  - [ sh, -c, \"systemctl enable --now sshd.service 2>/dev/null || systemctl enable --now ssh.service 2>/dev/null; systemctl is-enabled sshd.service ssh.service 2>/dev/null | grep -qx enabled || echo 'kldload: WARNING: no ssh unit is enabled (tried sshd.service and ssh.service)' >&2; true\" ]"
        # `; true` on both lines: cloud-init runs runcmd as one script and a
        # non-zero last item marks the module FAILED, so `cloud-init status`
        # reports an error for a guest that is fine. The outcome is logged
        # above instead. The guest agent is optional (not every cloud image
        # ships it) and only improves IP discovery, hence no warning for it.
        echo "  - [ sh, -c, \"systemctl enable --now qemu-guest-agent 2>/dev/null; true\" ]"
        # Install root's key LAST. cloud-init's ssh module has already run by
        # now and has rewritten /root/.ssh/authorized_keys with the distro's
        # forced-command banner ("Please login as the user debian..."), so
        # anything written earlier is gone. Everything in this estate connects
        # as root — klab, kldload-enroll, the image harness — so this is not
        # cosmetic. Copied from the staged file so the key never has to survive
        # shell quoting.
        [[ -n "$_ssh_pub" ]] &&
            echo "  - [ sh, -c, \"install -d -m 0700 /root/.ssh && install -m 0600 -o root -g root /root/.ssh/kldload_authorized_key /root/.ssh/authorized_keys\" ]"
        # PERMIT THE LOGIN THE KEY IS FOR.
        #
        # A key in authorized_keys is not access: sshd still has to allow root.
        # Four tools each grew their own drop-in for exactly this -- kube-cluster
        # writes 99-kldload.conf, klab writes 99-klab.conf in two places, the
        # webui writes a third -- and every one of them calls THIS script to do
        # the cloning. kvm-clone, the verb they all go through, was the only one
        # that did not, so a clone made with kvm-clone alone could not be
        # enrolled: kldload-enroll connects as root, got refused, wrote the DB
        # row and left the guest off the mesh.
        #
        # fiend, 2026-09-22, deb-4-k8s: "estate-probe-...: no SSH as root while
        # reading its node id — cannot enrol on the mesh". The cluster's own six
        # nodes were meshed in the same sweep, because kube-cluster had added
        # its drop-in on top. The estate-lifecycle mesh check had never been able
        # to pass, so this went unseen for as long as both were broken.
        #
        # prohibit-password, not yes: enrollment is key-only, and the callers
        # that genuinely want a password still layer their own drop-in over this.
        echo "  - [ sh, -c, \"mkdir -p /etc/ssh/sshd_config.d && printf 'PermitRootLogin prohibit-password\\n' > /etc/ssh/sshd_config.d/99-kldload-clone.conf && systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null; true\" ]"
    } >"${_tmp}/user-data"

    mkdir -p "$_seed_dir"
    if "$_mkiso" -output "$_seed_iso" -volid cidata -joliet -rock \
        "${_tmp}/user-data" "${_tmp}/meta-data" >/dev/null 2>&1; then
        chmod 0600 "$_seed_iso" 2>/dev/null
        # --config so it persists into the definition rather than only the
        # running domain; the clone is defined but not started at this point.
        # TARGET sda ON THE SATA BUS, NOT sdz ON SCSI.
        #
        # `sdz` is the 26th SCSI device. The goldens have no SCSI controller at
        # all (their disk is virtio, vda), so asking for that address made
        # libvirt silently synthesise FOUR lsilogic controllers to reach unit
        # 25 — and the guest kernel never enumerated a drive there. The seed
        # was attached, visible in the domain XML, and completely absent
        # inside the VM: `blkid` showed no cidata volume, and cloud-init fell
        # through to DataSourceNone ("Used fallback datasource"), so no
        # hostname, no authorized key, no host keys and no guest agent.
        #
        # That is why clones came up as `localhost` with sshd refusing
        # connections (.107, 2026-08-22) — the seed this function carefully
        # builds was never readable by the guest that needed it.
        #
        # Every golden already has a SATA controller, and cloud-init's NoCloud
        # datasource does not care which bus the cidata volume arrives on.
        if virsh attach-disk "$DEST" "$_seed_iso" sda \
            --type cdrom --mode readonly --config --targetbus sata >/dev/null 2>&1; then
            echo "  Seed:   ${_seed_iso} (hostname, ssh key, guest agent)"
        else
            echo "  NOTE: seed built but could not be attached — clone will boot as '${SOURCE}'" >&2
        fi
    else
        echo "  NOTE: could not build a cloud-init seed — clone will boot as '${SOURCE}'" >&2
    fi
    rm -rf "${_tmp}"
    trap - EXIT
else
    echo "  NOTE: no genisoimage/mkisofs/xorrisofs — clone will boot as '${SOURCE}'" >&2
fi

echo ""
echo "Cloned '${SOURCE}' -> '${DEST}' (instant, zero bytes copied)"
echo "  Source: /dev/zvol/${SRC_ZVOL}"
echo "  Clone:  /dev/zvol/${DST_ZVOL}"
echo "  Start:  virsh start ${DEST}"
echo "  Snap:   kvm-snap ${DEST}"

# Register the clone so dynamic inventory picks it up immediately. Role and
# cluster are inferred from the naming convention kube-cluster uses:
#   <cluster>-cp-*    → control_plane
#   <cluster>-worker-* → worker
if command -v kldload-db >/dev/null 2>&1; then
    _role="clone"
    _cluster=""
    # MATCH THE NAMES kube-cluster ACTUALLY USES.
    #
    # kube-cluster sets WORKER_PREFIX="${CLUSTER_NAME}-w" (kube-cluster:182),
    # so its workers are kldload-w-1, kldload-w-2 … The patterns here only
    # looked for -worker-, which matches none of them. Every worker a cluster
    # ever built was therefore filed as role="clone" with an EMPTY cluster,
    # which is exactly what a running host showed: kldload-cp correctly
    # control_plane, and kldload-w-1/2/3 as unclustered clones (.104,
    # 2026-08-20). kube_workers in the Ansible inventory is role="worker", so
    # those three nodes could never be targeted as workers by any playbook.
    #
    # -w-<digits> is anchored on the digits so a VM legitimately called
    # something like "db-w-cache" is not mistaken for a worker.
    case "$DEST" in
    *-cp | *-cp-*) _role="control_plane" ;;
    *-worker-* | *worker*) _role="worker" ;;
    *-w-[0-9] | *-w-[0-9][0-9]) _role="worker" ;;
    esac
    # Extract cluster prefix (everything before the first role suffix).
    case "$DEST" in
    *-cp*) _cluster="${DEST%%-cp*}" ;;
    *-worker*) _cluster="${DEST%%-worker*}" ;;
    *-w-[0-9] | *-w-[0-9][0-9]) _cluster="${DEST%-w-*}" ;;
    esac
    # A failed registration does not undo a working clone, but it is said: a
    # clone the DB never heard of is missing from the estate and from Ansible.
    kldload-db vm-register --name "$DEST" --role "$_role" \
        --cluster "$_cluster" --golden-src "$SOURCE" --status "cloned" >/dev/null ||
        echo "kvm-clone: WARNING: ${DEST} is not in the kldload state DB (kldload-db vm-register failed)" >&2
    kldload-db event --type "vm" --subject "$DEST" \
        --message "cloned from ${SOURCE}" >/dev/null ||
        echo "kvm-clone: WARNING: could not record the clone event" >&2
fi
