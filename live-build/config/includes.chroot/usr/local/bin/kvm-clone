#!/usr/bin/env bash
# kvm-clone — instant CoW clone of a VM using ZFS
set -euo pipefail

# Auto-elevate to root (ZFS + libvirt require it)
if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

usage() {
    cat <<EOF
Usage: kvm-clone <source-vm> <new-name> [--snap <snapshot>]

Creates an instant copy-on-write clone of a VM. Zero bytes copied —
the clone shares all data with the source until either is modified.

Options:
  --snap <name>   Clone from a specific snapshot (default: creates one)

Examples:
  kvm-clone template webserver-01     # snapshot + clone
  kvm-clone template webserver-02     # another clone, instant
  kvm-clone myvm test --snap @stable  # clone from named snapshot
EOF
    exit 1
}

[[ $# -lt 2 ]] && usage
SOURCE="$1"
DEST="$2"
shift 2

SNAP_NAME=""
while [[ $# -gt 0 ]]; do
    case "$1" in
    --snap)
        SNAP_NAME="$2"
        shift 2
        ;;
    *)
        echo "Unknown option: $1"
        usage
        ;;
    esac
done

SRC_ZVOL="rpool/vms/${SOURCE}"
DST_ZVOL="rpool/vms/${DEST}"

# Verify source exists
if ! zfs list "${SRC_ZVOL}" >/dev/null 2>&1; then
    echo "Error: Source VM zvol '${SRC_ZVOL}' not found"
    exit 1
fi

# Check dest doesn't exist
if zfs list "${DST_ZVOL}" >/dev/null 2>&1; then
    echo "Error: Destination '${DST_ZVOL}' already exists"
    exit 1
fi

# Create or use snapshot
if [[ -n "$SNAP_NAME" ]]; then
    [[ "$SNAP_NAME" != *@* ]] && SNAP_NAME="${SRC_ZVOL}@${SNAP_NAME}"
    SNAP="${SNAP_NAME}"
else
    SNAP="${SRC_ZVOL}@clone-$(date +%Y%m%d_%H%M%S%N)"
    # Pause source if running for consistent snapshot
    STATE=$(virsh domstate "${SOURCE}" 2>/dev/null || echo "unknown")
    [[ "$STATE" == "running" ]] && virsh suspend "${SOURCE}" 2>/dev/null || true
    zfs snapshot "${SNAP}"
    [[ "$STATE" == "running" ]] && virsh resume "${SOURCE}" 2>/dev/null || true
fi

# Clone the zvol (instant, zero copy)
echo "Cloning ${SNAP} → ${DST_ZVOL}..."
zfs clone "${SNAP}" "${DST_ZVOL}"

# Tag the clone with its origin snapshot for cleanup tracking
zfs set com.kldload:clone-origin="${SNAP}" "${DST_ZVOL}"

# Copy UEFI NVRAM file if it exists (each VM needs its own)
NVRAM_SRC="/var/lib/libvirt/qemu/nvram/${SOURCE}_VARS.fd"
NVRAM_DST="/var/lib/libvirt/qemu/nvram/${DEST}_VARS.fd"
if [[ -f "${NVRAM_SRC}" ]]; then
    cp "${NVRAM_SRC}" "${NVRAM_DST}"
fi

# Clone the libvirt domain definition via XML manipulation.
# The XML may reference the zvol as /dev/zvol/pool/name OR as the resolved
# /dev/zdN device. We must replace BOTH forms so the clone points to its
# own zvol, not the source's.
echo "Cloning VM definition..."
SRC_DEV="$(readlink -f "/dev/zvol/${SRC_ZVOL}" 2>/dev/null || echo "/dev/zvol/${SRC_ZVOL}")"
DST_DEV="$(readlink -f "/dev/zvol/${DST_ZVOL}" 2>/dev/null || echo "/dev/zvol/${DST_ZVOL}")"
virsh dumpxml "${SOURCE}" |
    sed "s|<name>${SOURCE}</name>|<name>${DEST}</name>|" |
    sed "s|${SRC_ZVOL}|${DST_ZVOL}|g" |
    sed "s|${SRC_DEV}|${DST_DEV}|g" |
    sed "s|${SOURCE}_VARS.fd|${DEST}_VARS.fd|g" |
    # Per-VM log paths. klab points <serial> and <console> at
    # /var/log/klab/<vm>-console.log, and a straight XML copy leaves every
    # clone pointing at the GOLDEN's file. libvirt opens it exclusively, so
    # the first clone to boot takes it and every later one dies with
    #   Cannot open log file: ... Device or resource busy
    # which caps a golden at exactly one running clone. Measured on .120
    # (2026-08-23): dtest-a started, dtest-b refused, same log path.
    # Rewrite the whole prefix rather than just -console.log, so any other
    # per-VM log klab adds later is carried along too.
    sed "s|/var/log/klab/${SOURCE}-|/var/log/klab/${DEST}-|g" |
    sed '/<uuid>/d' |
    sed '/<mac address/d' |
    virsh define /dev/stdin || {
    echo "ERROR: Failed to define VM ${DEST}"
    zfs destroy "${DST_ZVOL}" 2>/dev/null
    exit 1
}

# ── Give the clone an identity of its own ────────────────────────────────────
#
# A clone is a byte-for-byte copy of the golden, so without this it boots
# believing it IS the golden: same hostname, same machine-id, same (or absent)
# host keys. Three symptoms, one cause, all observed on .110 2026-08-21:
#
#   1. Its DHCP lease carries no hostname, so the inventory sync could not
#      match it and it never reached Ansible at all.
#   2. sshd is not configured for it — `ansible -m ping` gets connection
#      refused on every clone while every seeded VM answers SUCCESS.
#   3. qemu-guest-agent is not running, so libvirt can see nothing inside it
#      and can only ask it to shut down via ACPI.
#
# kspawn has always regenerated a seed per node, which is exactly why its
# clones behave and these did not. This gives kvm-clone the same treatment.
#
# cloud-init reads a NoCloud seed from a volume labelled "cidata". Writing a
# fresh one and attaching it as a cdrom is all it takes: on first boot the
# clone sets its own hostname, installs the operator's key, and starts sshd and
# the guest agent.
#
# BEST EFFORT, deliberately. A clone that boots is worth more than a clone that
# refused to be created because genisoimage was missing or the guest has no
# cloud-init — the clone itself already succeeded by this point, and every
# failure below leaves it exactly as it was before: usable, just anonymous.
_seed_dir="/var/lib/libvirt/images"
_seed_iso="${_seed_dir}/${DEST}-seed.iso"
_mkiso=""
for _c in genisoimage mkisofs xorrisofs; do
    command -v "$_c" >/dev/null 2>&1 && {
        _mkiso="$_c"
        break
    }
done

if [[ -n "$_mkiso" ]]; then
    _ssh_pub=""
    for _k in /root/.ssh/id_ed25519.pub /root/.ssh/id_rsa.pub; do
        [[ -r "$_k" ]] && {
            _ssh_pub="$(cat "$_k")"
            break
        }
    done

    _tmp="$(mktemp -d)"
    trap 'rm -rf "${_tmp}"' EXIT
    printf 'instance-id: %s\nlocal-hostname: %s\n' "$DEST" "$DEST" >"${_tmp}/meta-data"
    {
        echo "#cloud-config"
        echo "hostname: ${DEST}"
        echo "manage_etc_hosts: true"
        echo "preserve_hostname: false"
        [[ -n "$_ssh_pub" ]] && printf 'ssh_authorized_keys:\n  - %s\n' "$_ssh_pub"
        # ROOT's key, explicitly. The line above is cloud-init's top-level form,
        # which installs the key for the DEFAULT user only — root keeps whatever
        # the distro image shipped, and Debian/Ubuntu cloud images ship a forced
        # command that answers every root login with
        #   Please login as the user "debian" rather than the user "root".
        # Everything here connects as root: klab drives goldens that way,
        # kldload-enroll hardcodes root@, and so does the image test harness.
        # Measured on .120 (2026-08-23): four fresh clones, root refused on all
        # four, enrollment dead in the water.
        # write_files rather than a runcmd shell line: the key contains spaces
        # and +/= and would need quoting through two layers to survive.
        if [[ -n "$_ssh_pub" ]]; then
            printf 'write_files:\n'
            printf '  - path: /root/.ssh/kldload_authorized_key\n'
            printf '    permissions: %s\n' "'0600'"
            printf '    owner: root:root\n'
            printf '    content: %s\n' "$_ssh_pub"
        fi
        # Regenerate the machine-id: cloned guests otherwise share the golden's,
        # and a duplicate machine-id makes DHCP hand out the same lease twice
        # and systemd-journald collide on the same identifier.
        echo "runcmd:"
        echo "  - [ sh, -c, \"rm -f /etc/machine-id && systemd-machine-id-setup\" ]"
        echo "  - [ sh, -c, \"systemctl enable --now ssh.service sshd.service 2>/dev/null; true\" ]"
        echo "  - [ sh, -c, \"systemctl enable --now qemu-guest-agent 2>/dev/null; true\" ]"
        # Install root's key LAST. cloud-init's ssh module has already run by
        # now and has rewritten /root/.ssh/authorized_keys with the distro's
        # forced-command banner ("Please login as the user debian..."), so
        # anything written earlier is gone. Everything in this estate connects
        # as root — klab, kldload-enroll, the image harness — so this is not
        # cosmetic. Copied from the staged file so the key never has to survive
        # shell quoting.
        [[ -n "$_ssh_pub" ]] &&
            echo "  - [ sh, -c, \"install -d -m 0700 /root/.ssh && install -m 0600 -o root -g root /root/.ssh/kldload_authorized_key /root/.ssh/authorized_keys\" ]"
    } >"${_tmp}/user-data"

    mkdir -p "$_seed_dir"
    if "$_mkiso" -output "$_seed_iso" -volid cidata -joliet -rock \
        "${_tmp}/user-data" "${_tmp}/meta-data" >/dev/null 2>&1; then
        chmod 0600 "$_seed_iso" 2>/dev/null
        # --config so it persists into the definition rather than only the
        # running domain; the clone is defined but not started at this point.
        # TARGET sda ON THE SATA BUS, NOT sdz ON SCSI.
        #
        # `sdz` is the 26th SCSI device. The goldens have no SCSI controller at
        # all (their disk is virtio, vda), so asking for that address made
        # libvirt silently synthesise FOUR lsilogic controllers to reach unit
        # 25 — and the guest kernel never enumerated a drive there. The seed
        # was attached, visible in the domain XML, and completely absent
        # inside the VM: `blkid` showed no cidata volume, and cloud-init fell
        # through to DataSourceNone ("Used fallback datasource"), so no
        # hostname, no authorized key, no host keys and no guest agent.
        #
        # That is why clones came up as `localhost` with sshd refusing
        # connections (.107, 2026-08-22) — the seed this function carefully
        # builds was never readable by the guest that needed it.
        #
        # Every golden already has a SATA controller, and cloud-init's NoCloud
        # datasource does not care which bus the cidata volume arrives on.
        if virsh attach-disk "$DEST" "$_seed_iso" sda \
            --type cdrom --mode readonly --config --targetbus sata >/dev/null 2>&1; then
            echo "  Seed:   ${_seed_iso} (hostname, ssh key, guest agent)"
        else
            echo "  NOTE: seed built but could not be attached — clone will boot as '${SOURCE}'" >&2
        fi
    else
        echo "  NOTE: could not build a cloud-init seed — clone will boot as '${SOURCE}'" >&2
    fi
    rm -rf "${_tmp}"
    trap - EXIT
else
    echo "  NOTE: no genisoimage/mkisofs/xorrisofs — clone will boot as '${SOURCE}'" >&2
fi

echo ""
echo "✔ Cloned '${SOURCE}' → '${DEST}' (instant, zero bytes copied)"
echo "  Source: /dev/zvol/${SRC_ZVOL}"
echo "  Clone:  /dev/zvol/${DST_ZVOL}"
echo "  Start:  virsh start ${DEST}"
echo "  Snap:   kvm-snap ${DEST}"

# Register the clone so dynamic inventory picks it up immediately. Role and
# cluster are inferred from the naming convention kube-cluster uses:
#   <cluster>-cp-*    → control_plane
#   <cluster>-worker-* → worker
if command -v kldload-db >/dev/null 2>&1; then
    _role="clone"
    _cluster=""
    # MATCH THE NAMES kube-cluster ACTUALLY USES.
    #
    # kube-cluster sets WORKER_PREFIX="${CLUSTER_NAME}-w" (kube-cluster:182),
    # so its workers are kldload-w-1, kldload-w-2 … The patterns here only
    # looked for -worker-, which matches none of them. Every worker a cluster
    # ever built was therefore filed as role="clone" with an EMPTY cluster,
    # which is exactly what a running host showed: kldload-cp correctly
    # control_plane, and kldload-w-1/2/3 as unclustered clones (.104,
    # 2026-08-20). kube_workers in the Ansible inventory is role="worker", so
    # those three nodes could never be targeted as workers by any playbook.
    #
    # -w-<digits> is anchored on the digits so a VM legitimately called
    # something like "db-w-cache" is not mistaken for a worker.
    case "$DEST" in
    *-cp | *-cp-*) _role="control_plane" ;;
    *-worker-* | *worker*) _role="worker" ;;
    *-w-[0-9] | *-w-[0-9][0-9]) _role="worker" ;;
    esac
    # Extract cluster prefix (everything before the first role suffix).
    case "$DEST" in
    *-cp*) _cluster="${DEST%%-cp*}" ;;
    *-worker*) _cluster="${DEST%%-worker*}" ;;
    *-w-[0-9] | *-w-[0-9][0-9]) _cluster="${DEST%-w-*}" ;;
    esac
    kldload-db vm-register --name "$DEST" --role "$_role" \
        --cluster "$_cluster" --golden-src "$SOURCE" --status "cloned" 2>/dev/null || true
    kldload-db event --type "vm" --subject "$DEST" \
        --message "cloned from ${SOURCE}" 2>/dev/null || true
fi
