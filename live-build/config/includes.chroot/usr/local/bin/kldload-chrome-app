#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# kldload-chrome-app — open a kldload SPA view as a standalone Chrome app window
#
# WHAT IT DOES, IN ORDER:
#   1. Take an app-id (window class) and a URL.
#   2. Launch Chrome in --app mode against a DEDICATED kldload profile dir, so
#      the window is a frameless standalone app window grouped under its own
#      icon (--class == the .desktop StartupWMClass).
#
# WHY THIS EXISTS:
#   kldload's UI is a single SPA served at https://localhost:8443/. It used to
#   render through kldload-webview (GTK4 + WebKit6). WebKit does NOT implement
#   the Web Speech API, so Bob's voice/hot-mic broke with "Speech recognition
#   not available in this browser." Chrome is the default browser throughout
#   kldload and *does* support it — so every SPA window now runs in Chrome.
#
#   Using a dedicated --user-data-dir (not the user's main Chrome profile) means:
#     - launches reliably open a NEW app window instead of being swallowed by an
#       already-running main browser ("Opening in existing browser session"),
#     - the kldload UI is isolated from the user's browsing/extensions/logins,
#     - the localhost:8443 cert is still trusted: Chrome reads ~/.pki/nssdb and
#       the system trust store (kldload-webui.crt lives in both), which are
#       independent of the Chrome profile.
#
# USAGE:    kldload-chrome-app <app-id> <url>
# EXAMPLE:  kldload-chrome-app com.kldload.bob 'https://localhost:8443/?app=1#bob'
# EXIT:     execs Chrome (replaces this process); non-zero only on bad args.
#
# NOTES:
#   - Mic on https://localhost is a secure context, so Chrome allows it; the
#     first use may prompt once per profile to allow the microphone.
#   - SEE ALSO: bob-chat.desktop, kldload-webui.desktop, kldload-webview(1).
# ─────────────────────────────────────────────────────────────────────────────
set -Eeuo pipefail

app_id="${1:?usage: kldload-chrome-app <app-id> <url>}"
url="${2:?usage: kldload-chrome-app <app-id> <url>}"

# PER-APP browser profile — one profile dir per app_id, NOT one shared kldload
# profile. WHY (verified on .139 2026-06-15): a shared profile makes every tool
# open as a window inside ONE Chrome process, and GNOME groups all of a single
# process's windows under ONE dock icon (the .desktop that launched the process)
# — it ignores the per-window Wayland app_id for grouping. So all tools collapsed
# onto the kldload-console (dashboard) icon even though each window's app_id was
# correct. A distinct --user-data-dir per app_id makes each tool its OWN Chrome
# PROCESS, so GNOME gives it its own dock/window icon (matched by app_id →
# StartupWMClass → kldload-<tool>). Still isolated from the user's main browser;
# the localhost:8443 cert is trusted via ~/.pki/nssdb + the system store, which
# are independent of the Chrome profile, so every per-app profile trusts it.
profile_dir="${XDG_DATA_HOME:-$HOME/.local/share}/kldload-chrome/${app_id}"
mkdir -p "$profile_dir"

# Browser: google-chrome on the RPM distros (kldload default), chromium on
# Debian/Ubuntu — and chromium as a fallback anywhere google-chrome isn't
# installed. Both are Chromium-based, so --app mode, Bob's Web Speech API, and
# the ~/.pki/nssdb cert trust all behave identically. WHY this matters: without
# the fallback, kldload-chrome-app exited "not found" on Debian and EVERY web-UI
# tool failed to launch (.139 debian-trixie 2026-06-15). NOTE: the Wayland
# app_id PREFIX differs by binary (chrome- vs chromium-), so profiles.sh aligns
# each launcher's StartupWMClass to the installed browser so dock icons match.
chrome="$(command -v google-chrome-stable || command -v google-chrome ||
    command -v chromium || command -v chromium-browser || true)"
if [[ -z "$chrome" ]]; then
    echo "kldload-chrome-app: no Chromium-based browser (google-chrome/chromium) found" >&2
    exit 1
fi

# Appliance-mode flags — suppress every first-run nag/check that can block or
# clutter the kldload UI window on a fresh GNOME session:
#   --no-first-run / --no-default-browser-check : skip the welcome + "make
#       Chrome your default?" prompts.
#   --password-store=basic : do NOT touch gnome-keyring. On a fresh live/desktop
#       session the keyring is locked, so Chrome otherwise pops a BLOCKING
#       "unlock your keyring / create password" dialog (or hangs) before the app
#       window ever appears — a frequent "the UI never opened" cause. The kldload
#       app profile stores nothing sensitive, so a basic store is fine.
#   --disable-session-crashed-bubble : no "Restore pages?" bubble after the
#       window is killed (logout / bobctl), which would steal focus from the SPA.
#   --disable-features=Translate : no translate infobar over the dashboard.
#   --ozone-platform=wayland : run as a NATIVE Wayland client, never XWayland —
#       kldload is a modern Wayland desktop with no legacy X11 fallback. IMPORTANT
#       consequence: in native Wayland, Chrome 149 IGNORES --class for the surface
#       app_id and derives it from the URL host+path (port/query/fragment
#       stripped), so https://localhost:8443/?app=1#<anything> -> app_id
#       "chrome-localhost__-Default". Verified via WAYLAND_DEBUG set_app_id on
#       .139 (2026-06-15). The window/dock icon is therefore matched by a
#       .desktop whose StartupWMClass equals that URL-derived id (see
#       kldload-webui.desktop), NOT by --class. Every tool opens the same root
#       URL, so they all share that one app_id — one cohesive console icon.
#       --class is kept only as a harmless hint for any future XWayland path.
# ── Ozone platform: follow the SESSION, do not assume Wayland ────────────────
# `--ozone-platform=wayland` was hardcoded because the Fedora/RHEL substrates
# run GDM, which defaults to a Wayland session. Debian deliberately runs
# lightdm (GDM 48 has a systemd bug on Trixie), and lightdm defaults to X11 —
# so chromium was told to use a Wayland display that does not exist and exited
# immediately with:
#     Failed to connect to Wayland display
#     The platform failed to initialize.  Exiting.
# Every dock/app-grid tile therefore did nothing at all when clicked.
# HISTORY: 2026-08-14, fiend rc3 (Debian 13, XDG_SESSION_TYPE=x11).
#
# Honour an explicit override, else take the session's own answer, else let
# chromium decide for itself ("auto") rather than forcing a wrong platform.
_ozone="${KLDLOAD_OZONE_PLATFORM:-}"
if [[ -z "$_ozone" ]]; then
    case "${XDG_SESSION_TYPE:-}" in
    wayland) _ozone=wayland ;;
    x11) _ozone=x11 ;;
    *) _ozone="$([[ -n "${WAYLAND_DISPLAY:-}" ]] && echo wayland || echo auto)" ;;
    esac
fi

exec "$chrome" \
    --ozone-platform="$_ozone" \
    --user-data-dir="$profile_dir" \
    --class="$app_id" \
    --no-first-run \
    --no-default-browser-check \
    --password-store=basic \
    --disable-session-crashed-bubble \
    --disable-features=Translate \
    --app="$url"
