#!/usr/bin/env python3
"""bob-agent — Ollama tool-use agent. Bob calls real functions.

Bob receives a natural language request, decides which tools to use,
calls them, reads the output, and calls more tools until done.

Usage:
    bob-agent "open a terminal running htop"
    bob-agent "check disk health and fix issues"
    bob-agent "play some jazz music"
    bob-agent "start jellyfin"
    bob-agent --verbose "set up nginx reverse proxy for port 3000"
"""
import json
import os
import subprocess
import sys
import time
import urllib.parse
import urllib.request
import urllib.error

OLLAMA_URL = os.environ.get("OLLAMA_URL", "http://localhost:11434")
BOB_MODEL = os.environ.get("BOB_MODEL", "bob")
VERBOSE = "--verbose" in sys.argv or "-v" in sys.argv
MAX_ITERATIONS = 15

# ---------------------------------------------------------------------------
# Tools — each function is something Bob can actually do
# ---------------------------------------------------------------------------

def run_command(command, timeout=30):
    """Execute a shell command and return output."""
    try:
        result = subprocess.run(
            command, shell=True, capture_output=True, text=True,
            timeout=timeout, env={**os.environ, "TERM": "dumb"}
        )
        output = result.stdout + result.stderr
        return {"exit_code": result.returncode, "output": output[:4000]}
    except subprocess.TimeoutExpired:
        return {"exit_code": -1, "output": "Command timed out"}
    except Exception as e:
        return {"exit_code": -1, "output": str(e)}


def spawn_terminal(command="", title="Bob Terminal"):
    """Open a GNOME terminal, optionally running a command."""
    display = os.environ.get("DISPLAY", ":0")
    env = f"DISPLAY={display}"
    if command:
        cmd = f"{env} gnome-terminal --title='{title}' -- bash -c '{command}; exec bash'"
    else:
        cmd = f"{env} gnome-terminal --title='{title}'"
    subprocess.Popen(cmd, shell=True, env={**os.environ, "DISPLAY": display})
    return {"status": "opened", "command": command}


def open_app(app_name):
    """Open an application by name."""
    display = os.environ.get("DISPLAY", ":0")
    # Map common names to actual commands
    app_map = {
        "firefox": "firefox",
        "browser": "firefox",
        "files": "nautilus",
        "file manager": "nautilus",
        "nautilus": "nautilus",
        "terminal": "gnome-terminal",
        "text editor": "gedit",
        "gedit": "gedit",
        "settings": "gnome-control-center",
        "calculator": "gnome-calculator",
    }
    cmd = app_map.get(app_name.lower(), app_name)
    subprocess.Popen(
        cmd, shell=True,
        env={**os.environ, "DISPLAY": display},
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )
    return {"status": "opened", "app": cmd}


def open_browser(url):
    """Open a URL in Firefox."""
    display = os.environ.get("DISPLAY", ":0")
    subprocess.Popen(
        f"firefox '{url}'", shell=True,
        env={**os.environ, "DISPLAY": display},
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )
    return {"status": "opened", "url": url}


def get_system_info():
    """Get comprehensive system information."""
    info = {}
    # CPU
    try:
        with open("/proc/cpuinfo") as f:
            for line in f:
                if "model name" in line:
                    info["cpu"] = line.split(":")[1].strip()
                    break
    except Exception:
        pass
    # RAM
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if "MemTotal" in line:
                    kb = int(line.split()[1])
                    info["ram_gb"] = round(kb / 1024 / 1024, 1)
                elif "MemAvailable" in line:
                    kb = int(line.split()[1])
                    info["ram_available_gb"] = round(kb / 1024 / 1024, 1)
    except Exception:
        pass
    # Disk
    try:
        r = subprocess.run(["df", "-h", "/"], capture_output=True, text=True)
        info["disk"] = r.stdout
    except Exception:
        pass
    # GPU
    try:
        r = subprocess.run(
            ["lspci"], capture_output=True, text=True
        )
        for line in r.stdout.split("\n"):
            if any(x in line.lower() for x in ("vga", "3d", "display")):
                info["gpu"] = line.split(": ", 1)[-1] if ": " in line else line
                break
    except Exception:
        pass
    # Load
    try:
        with open("/proc/loadavg") as f:
            info["load"] = f.read().strip()
    except Exception:
        pass
    # Uptime
    try:
        with open("/proc/uptime") as f:
            seconds = float(f.read().split()[0])
            hours = int(seconds // 3600)
            mins = int((seconds % 3600) // 60)
            info["uptime"] = f"{hours}h {mins}m"
    except Exception:
        pass
    return info


def read_file(path, max_lines=100):
    """Read a file and return its contents."""
    try:
        path = os.path.expanduser(path)
        with open(path) as f:
            lines = f.readlines()[:max_lines]
        return {"path": path, "lines": len(lines), "content": "".join(lines)[:4000]}
    except Exception as e:
        return {"error": str(e)}


def write_file(path, content):
    """Write content to a file."""
    try:
        path = os.path.expanduser(path)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(content)
        return {"status": "written", "path": path, "bytes": len(content)}
    except Exception as e:
        return {"error": str(e)}


def list_files(path=".", pattern="*"):
    """List files in a directory."""
    try:
        path = os.path.expanduser(path)
        import glob
        files = glob.glob(os.path.join(path, pattern))
        entries = []
        for f in sorted(files)[:50]:
            try:
                stat = os.stat(f)
                entries.append({
                    "name": os.path.basename(f),
                    "path": f,
                    "size": stat.st_size,
                    "is_dir": os.path.isdir(f),
                })
            except Exception:
                pass
        return {"path": path, "count": len(entries), "files": entries}
    except Exception as e:
        return {"error": str(e)}


def send_notification(title, message, urgency="normal"):
    """Send a desktop notification."""
    display = os.environ.get("DISPLAY", ":0")
    subprocess.run(
        ["notify-send", f"--urgency={urgency}", title, message],
        env={**os.environ, "DISPLAY": display},
        capture_output=True
    )
    return {"status": "sent", "title": title}


def take_screenshot(filename="/tmp/bob-screenshot.png"):
    """Take a screenshot of the current screen."""
    display = os.environ.get("DISPLAY", ":0")
    result = subprocess.run(
        ["gnome-screenshot", "-f", filename],
        env={**os.environ, "DISPLAY": display},
        capture_output=True, text=True
    )
    if result.returncode == 0:
        return {"status": "saved", "path": filename}
    return {"error": result.stderr}


def set_volume(level):
    """Set system volume (0-100 or 'mute'/'unmute')."""
    if level in ("mute", "unmute"):
        flag = "1" if level == "mute" else "0"
        subprocess.run(["pactl", "set-sink-mute", "@DEFAULT_SINK@", flag], capture_output=True)
        return {"status": level}
    try:
        pct = max(0, min(100, int(level)))
        subprocess.run(
            ["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{pct}%"],
            capture_output=True
        )
        return {"status": "set", "volume": pct}
    except ValueError:
        return {"error": f"Invalid volume: {level}"}


def get_processes(sort_by="cpu", limit=15):
    """Get top processes by CPU or memory usage."""
    flag = "--sort=-%cpu" if sort_by == "cpu" else "--sort=-%mem"
    result = subprocess.run(
        ["ps", "aux", flag],
        capture_output=True, text=True
    )
    lines = result.stdout.strip().split("\n")[:limit + 1]
    return {"processes": "\n".join(lines)}


def check_service(name):
    """Check the status of a systemd service."""
    result = subprocess.run(
        ["systemctl", "status", name],
        capture_output=True, text=True
    )
    active = "active (running)" in result.stdout
    return {
        "service": name,
        "active": active,
        "output": result.stdout[:2000]
    }


def control_service(name, action="start"):
    """Start, stop, restart, or enable a systemd service."""
    if action not in ("start", "stop", "restart", "enable", "disable", "status"):
        return {"error": f"Invalid action: {action}"}
    result = subprocess.run(
        ["systemctl", action, name],
        capture_output=True, text=True
    )
    return {
        "service": name,
        "action": action,
        "exit_code": result.returncode,
        "output": (result.stdout + result.stderr)[:2000]
    }


def play_media(query, player="auto"):
    """Play media — music, video, or stream. Uses available players."""
    # Try different approaches based on what's available
    display = os.environ.get("DISPLAY", ":0")
    env = {**os.environ, "DISPLAY": display}

    # If it's a URL, open in browser or mpv
    if query.startswith("http"):
        # Try mpv first (best for media)
        if subprocess.run(["which", "mpv"], capture_output=True).returncode == 0:
            subprocess.Popen(["mpv", query], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return {"status": "playing", "player": "mpv", "url": query}
        # Fallback to browser
        subprocess.Popen(f"firefox '{query}'", shell=True, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return {"status": "playing", "player": "firefox", "url": query}

    # Search for local files
    result = subprocess.run(
        ["find", "/home", "/mnt", "-maxdepth", "4",
         "-iname", f"*{query}*",
         "-type", "f",
         "(",  "-name", "*.mp3", "-o", "-name", "*.mp4",
         "-o", "-name", "*.mkv", "-o", "-name", "*.flac",
         "-o", "-name", "*.wav", "-o", "-name", "*.avi",
         "-o", "-name", "*.webm", ")"],
        capture_output=True, text=True, timeout=10
    )
    files = [f for f in result.stdout.strip().split("\n") if f]

    if files:
        target = files[0]
        if subprocess.run(["which", "mpv"], capture_output=True).returncode == 0:
            subprocess.Popen(["mpv", target], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return {"status": "playing", "player": "mpv", "file": target}
        subprocess.Popen(f"xdg-open '{target}'", shell=True, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return {"status": "playing", "player": "xdg-open", "file": target}

    return {"status": "not_found", "query": query, "hint": "Try providing a URL or check if media files exist"}


def manage_container(name, action="start", image=None):
    """Manage podman containers — start, stop, pull, run."""
    if action == "pull" and image:
        result = subprocess.run(["podman", "pull", image], capture_output=True, text=True, timeout=300)
        return {"action": "pull", "image": image, "exit_code": result.returncode, "output": result.stdout[:2000]}
    elif action == "run" and image:
        result = subprocess.run(
            ["podman", "run", "-d", "--name", name, "--network", "host", image],
            capture_output=True, text=True, timeout=60
        )
        return {"action": "run", "name": name, "exit_code": result.returncode, "output": result.stdout[:2000]}
    elif action in ("start", "stop", "restart", "rm"):
        result = subprocess.run(["podman", action, name], capture_output=True, text=True, timeout=60)
        return {"action": action, "name": name, "exit_code": result.returncode, "output": (result.stdout + result.stderr)[:2000]}
    elif action == "list":
        result = subprocess.run(["podman", "ps", "-a", "--format", "json"], capture_output=True, text=True)
        try:
            return {"containers": json.loads(result.stdout)}
        except Exception:
            return {"output": result.stdout[:2000]}
    return {"error": f"Unknown action: {action}"}


def schedule_reminder(message, minutes=10):
    """Schedule a desktop notification reminder."""
    display = os.environ.get("DISPLAY", ":0")
    cmd = f'sleep {int(minutes) * 60} && DISPLAY={display} notify-send "Bob Reminder" "{message}"'
    subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return {"status": "scheduled", "message": message, "in_minutes": minutes}


def plex_control(action, query="", client=""):
    """Control Plex media server — search, play, pause, stop."""
    try:
        with open("/etc/bob/bob.conf") as f:
            conf = json.load(f)
        svc = conf.get("services", {}).get("plex", {})
        url = svc.get("url", "").rstrip("/")
        token = svc.get("token", "")
        if not url or not token:
            return {"error": "Plex not configured. Set up in Bob Builder (/builder)."}
    except Exception:
        return {"error": "Bob config not found. Visit /builder to set up Plex."}

    headers = {"X-Plex-Token": token, "Accept": "application/json"}

    if action == "search" and query:
        req = urllib.request.Request(f"{url}/search?query={urllib.parse.quote(query)}", headers=headers)
        resp = urllib.request.urlopen(req, timeout=10)
        data = json.loads(resp.read())
        results = []
        for item in data.get("MediaContainer", {}).get("Metadata", [])[:10]:
            results.append({
                "title": item.get("title"),
                "type": item.get("type"),
                "year": item.get("year"),
                "key": item.get("key"),
                "ratingKey": item.get("ratingKey"),
            })
        return {"results": results}

    elif action == "play" and query:
        # Search first, then play on a client
        req = urllib.request.Request(f"{url}/search?query={urllib.parse.quote(query)}", headers=headers)
        resp = urllib.request.urlopen(req, timeout=10)
        data = json.loads(resp.read())
        items = data.get("MediaContainer", {}).get("Metadata", [])
        if not items:
            return {"error": f"Nothing found for '{query}'"}

        item = items[0]
        # Get available clients
        req2 = urllib.request.Request(f"{url}/clients", headers=headers)
        resp2 = urllib.request.urlopen(req2, timeout=10)
        clients_data = json.loads(resp2.read())
        clients = clients_data.get("MediaContainer", {}).get("Server", [])

        if client:
            target = next((c for c in clients if client.lower() in c.get("name", "").lower()), None)
        else:
            target = clients[0] if clients else None

        if not target:
            return {"error": "No Plex client found to play on", "available_clients": [c.get("name") for c in clients]}

        # Play via client
        machine_id = target.get("machineIdentifier", "")
        play_url = f"{url}/player/playback/playMedia?key={item['key']}&machineIdentifier={machine_id}"
        req3 = urllib.request.Request(play_url, headers=headers)
        urllib.request.urlopen(req3, timeout=10)
        return {"status": "playing", "title": item.get("title"), "client": target.get("name")}

    elif action in ("pause", "stop", "resume"):
        cmd_map = {"pause": "pause", "stop": "stop", "resume": "play"}
        req = urllib.request.Request(f"{url}/player/playback/{cmd_map[action]}", headers=headers)
        urllib.request.urlopen(req, timeout=10)
        return {"status": action}

    elif action == "clients":
        req = urllib.request.Request(f"{url}/clients", headers=headers)
        resp = urllib.request.urlopen(req, timeout=10)
        data = json.loads(resp.read())
        clients = [c.get("name") for c in data.get("MediaContainer", {}).get("Server", [])]
        return {"clients": clients}

    return {"error": f"Unknown action: {action}"}


def jellyfin_control(action, query="", user_id=""):
    """Control Jellyfin media server — search, play, get libraries."""
    try:
        with open("/etc/bob/bob.conf") as f:
            conf = json.load(f)
        svc = conf.get("services", {}).get("jellyfin", {})
        url = svc.get("url", "").rstrip("/")
        key = svc.get("key", "")
        if not url or not key:
            return {"error": "Jellyfin not configured. Set up in Bob Builder (/builder)."}
    except Exception:
        return {"error": "Bob config not found. Visit /builder to set up Jellyfin."}

    headers = {"X-Emby-Token": key, "Content-Type": "application/json"}

    if action == "search" and query:
        search_url = f"{url}/Items?searchTerm={urllib.parse.quote(query)}&Limit=10&Recursive=true"
        req = urllib.request.Request(search_url, headers=headers)
        resp = urllib.request.urlopen(req, timeout=10)
        data = json.loads(resp.read())
        results = []
        for item in data.get("Items", [])[:10]:
            results.append({
                "title": item.get("Name"),
                "type": item.get("Type"),
                "year": item.get("ProductionYear"),
                "id": item.get("Id"),
            })
        return {"results": results}

    elif action == "libraries":
        req = urllib.request.Request(f"{url}/Library/VirtualFolders", headers=headers)
        resp = urllib.request.urlopen(req, timeout=10)
        data = json.loads(resp.read())
        return {"libraries": [{"name": lib.get("Name"), "type": lib.get("CollectionType")} for lib in data]}

    elif action == "play" and query:
        # Search then return stream URL
        search_url = f"{url}/Items?searchTerm={urllib.parse.quote(query)}&Limit=1&Recursive=true"
        req = urllib.request.Request(search_url, headers=headers)
        resp = urllib.request.urlopen(req, timeout=10)
        data = json.loads(resp.read())
        items = data.get("Items", [])
        if not items:
            return {"error": f"Nothing found for '{query}'"}
        item = items[0]
        stream_url = f"{url}/Items/{item['Id']}/Download?api_key={key}"
        return {"title": item.get("Name"), "stream_url": stream_url, "hint": "Open this URL in browser or mpv to play"}

    return {"error": f"Unknown action: {action}"}


def homeassistant_control(action, entity_id="", service_data=None):
    """Control Home Assistant — get states, call services, toggle devices."""
    try:
        with open("/etc/bob/bob.conf") as f:
            conf = json.load(f)
        svc = conf.get("services", {}).get("homeassistant", {})
        url = svc.get("url", "").rstrip("/")
        token = svc.get("token", "")
        if not url or not token:
            return {"error": "Home Assistant not configured. Set up in Bob Builder (/builder)."}
    except Exception:
        return {"error": "Bob config not found. Visit /builder to set up Home Assistant."}

    headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}

    if action == "states":
        req = urllib.request.Request(f"{url}/api/states", headers=headers)
        resp = urllib.request.urlopen(req, timeout=10)
        states = json.loads(resp.read())
        # Return summary
        summary = []
        for s in states[:50]:
            summary.append({
                "entity_id": s.get("entity_id"),
                "state": s.get("state"),
                "name": s.get("attributes", {}).get("friendly_name", ""),
            })
        return {"states": summary, "total": len(states)}

    elif action == "toggle" and entity_id:
        domain = entity_id.split(".")[0]
        payload = json.dumps({"entity_id": entity_id}).encode()
        req = urllib.request.Request(
            f"{url}/api/services/{domain}/toggle",
            data=payload, headers=headers, method="POST"
        )
        urllib.request.urlopen(req, timeout=10)
        return {"status": "toggled", "entity_id": entity_id}

    elif action == "call_service" and entity_id:
        domain = entity_id.split(".")[0]
        svc_name = service_data.get("service", "toggle") if service_data else "toggle"
        payload = json.dumps({"entity_id": entity_id, **(service_data or {})}).encode()
        req = urllib.request.Request(
            f"{url}/api/services/{domain}/{svc_name}",
            data=payload, headers=headers, method="POST"
        )
        urllib.request.urlopen(req, timeout=10)
        return {"status": "called", "service": f"{domain}.{svc_name}", "entity_id": entity_id}

    return {"error": f"Unknown action: {action}"}


def clipboard_read():
    """Read the current clipboard contents."""
    display = os.environ.get("DISPLAY", ":0")
    try:
        # Try wl-paste for Wayland
        result = subprocess.run(["wl-paste"], capture_output=True, text=True, timeout=5,
                                env={**os.environ, "WAYLAND_DISPLAY": "wayland-0"})
        if result.returncode == 0:
            return {"content": result.stdout[:4000], "source": "wayland"}
    except FileNotFoundError:
        pass
    try:
        # Fallback to xclip for X11
        result = subprocess.run(["xclip", "-selection", "clipboard", "-o"],
                                capture_output=True, text=True, timeout=5,
                                env={**os.environ, "DISPLAY": display})
        if result.returncode == 0:
            return {"content": result.stdout[:4000], "source": "x11"}
    except FileNotFoundError:
        pass
    return {"error": "No clipboard tool available (install wl-clipboard or xclip)"}


def clipboard_write(text):
    """Write text to the clipboard."""
    try:
        subprocess.run(["wl-copy", text], timeout=5,
                        env={**os.environ, "WAYLAND_DISPLAY": "wayland-0"})
        return {"status": "copied", "chars": len(text)}
    except FileNotFoundError:
        pass
    try:
        proc = subprocess.Popen(["xclip", "-selection", "clipboard"],
                                stdin=subprocess.PIPE,
                                env={**os.environ, "DISPLAY": os.environ.get("DISPLAY", ":0")})
        proc.communicate(text.encode(), timeout=5)
        return {"status": "copied", "chars": len(text)}
    except FileNotFoundError:
        return {"error": "No clipboard tool available"}


def search_files(query, path="/home", max_results=20):
    """Search for files by name or content."""
    results = []
    try:
        # Search by filename
        r = subprocess.run(
            ["find", path, "-maxdepth", "5", "-iname", f"*{query}*", "-type", "f"],
            capture_output=True, text=True, timeout=15
        )
        for f in r.stdout.strip().split("\n")[:max_results]:
            if f:
                try:
                    stat = os.stat(f)
                    results.append({
                        "path": f,
                        "size": stat.st_size,
                        "modified": time.strftime("%Y-%m-%d %H:%M", time.localtime(stat.st_mtime))
                    })
                except Exception:
                    results.append({"path": f})
    except Exception as e:
        return {"error": str(e)}
    return {"query": query, "results": results, "count": len(results)}


def system_monitor():
    """Get detailed system health — CPU, RAM, GPU, disk, temps, alerts."""
    info = {}
    alerts = []

    # CPU load
    try:
        with open("/proc/loadavg") as f:
            load = float(f.read().split()[0])
        cores = os.cpu_count() or 1
        info["cpu_load"] = load
        info["cpu_cores"] = cores
        info["cpu_pct"] = round(load / cores * 100)
        if info["cpu_pct"] > 90:
            alerts.append("CPU load is very high!")
    except Exception:
        pass

    # RAM
    try:
        with open("/proc/meminfo") as f:
            lines = f.readlines()
        meminfo = {}
        for line in lines:
            parts = line.split()
            meminfo[parts[0].rstrip(":")] = int(parts[1])
        total = meminfo.get("MemTotal", 0)
        avail = meminfo.get("MemAvailable", 0)
        used_pct = round((total - avail) / total * 100) if total else 0
        info["ram_total_gb"] = round(total / 1024 / 1024, 1)
        info["ram_available_gb"] = round(avail / 1024 / 1024, 1)
        info["ram_used_pct"] = used_pct
        if used_pct > 90:
            alerts.append("RAM is almost full!")
    except Exception:
        pass

    # Disk
    try:
        r = subprocess.run(["df", "-h", "/"], capture_output=True, text=True)
        parts = r.stdout.strip().split("\n")[1].split()
        info["disk_used"] = parts[2]
        info["disk_total"] = parts[1]
        info["disk_pct"] = int(parts[4].rstrip("%"))
        if info["disk_pct"] > 90:
            alerts.append("Disk space is running low!")
    except Exception:
        pass

    # GPU
    try:
        r = subprocess.run(
            ["nvidia-smi", "--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=5
        )
        if r.returncode == 0:
            parts = r.stdout.strip().split(", ")
            info["gpu_name"] = parts[0]
            info["gpu_util"] = int(parts[1])
            info["gpu_mem_used"] = int(parts[2])
            info["gpu_mem_total"] = int(parts[3])
            info["gpu_temp"] = int(parts[4])
            if info["gpu_temp"] > 85:
                alerts.append(f"GPU temperature is high: {info['gpu_temp']}C!")
    except Exception:
        pass

    # Failed services
    try:
        r = subprocess.run(["systemctl", "--failed", "--no-legend"], capture_output=True, text=True)
        failed = [l.strip() for l in r.stdout.strip().split("\n") if l.strip()]
        if failed:
            info["failed_services"] = failed
            alerts.append(f"{len(failed)} failed service(s)!")
    except Exception:
        pass

    info["alerts"] = alerts
    info["healthy"] = len(alerts) == 0
    return info


def manage_contacts(action, name=None, phone=None, email=None):
    """Manage Bob's contact book — add, list, search contacts."""
    contacts_file = os.path.expanduser("~/.bob/contacts.json")
    os.makedirs(os.path.dirname(contacts_file), exist_ok=True)

    try:
        with open(contacts_file) as f:
            contacts = json.load(f)
    except Exception:
        contacts = []

    if action == "list":
        return {"contacts": contacts}
    elif action == "search" and name:
        found = [c for c in contacts if name.lower() in c.get("name", "").lower()]
        return {"results": found}
    elif action == "add" and name:
        contact = {"name": name}
        if phone:
            contact["phone"] = phone
        if email:
            contact["email"] = email
        contacts.append(contact)
        with open(contacts_file, "w") as f:
            json.dump(contacts, f, indent=2)
        return {"status": "added", "contact": contact}
    elif action == "remove" and name:
        contacts = [c for c in contacts if name.lower() not in c.get("name", "").lower()]
        with open(contacts_file, "w") as f:
            json.dump(contacts, f, indent=2)
        return {"status": "removed", "name": name}
    return {"error": f"Unknown action: {action}"}


def manage_calendar(action, title=None, when=None, reminder_minutes=None):
    """Manage Bob's calendar — add events, list upcoming, set reminders."""
    cal_file = os.path.expanduser("~/.bob/calendar.json")
    os.makedirs(os.path.dirname(cal_file), exist_ok=True)

    try:
        with open(cal_file) as f:
            events = json.load(f)
    except Exception:
        events = []

    if action == "list":
        # Sort by date, show upcoming
        now = time.strftime("%Y-%m-%d %H:%M")
        upcoming = [e for e in events if e.get("when", "") >= now]
        upcoming.sort(key=lambda e: e.get("when", ""))
        return {"events": upcoming[:20]}
    elif action == "add" and title:
        event = {
            "id": str(uuid.uuid4())[:8],
            "title": title,
            "when": when or time.strftime("%Y-%m-%d %H:%M"),
            "created": time.strftime("%Y-%m-%d %H:%M"),
        }
        events.append(event)
        with open(cal_file, "w") as f:
            json.dump(events, f, indent=2)

        # Set reminder if requested
        if reminder_minutes:
            display = os.environ.get("DISPLAY", ":0")
            cmd = f'sleep {int(reminder_minutes) * 60} && DISPLAY={display} notify-send --urgency=critical "Bob Reminder" "{title}"'
            subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        return {"status": "added", "event": event}
    elif action == "remove" and title:
        events = [e for e in events if title.lower() not in e.get("title", "").lower()]
        with open(cal_file, "w") as f:
            json.dump(events, f, indent=2)
        return {"status": "removed"}
    return {"error": f"Unknown action: {action}"}


def dictate_to_editor(content, filename="/tmp/bob-note.txt", editor="vim"):
    """Open an editor and type content character by character like Bob is writing it live."""
    display = os.environ.get("DISPLAY", ":0")
    env = {**os.environ, "DISPLAY": display}

    # Write content to file first
    with open(filename, "w") as f:
        f.write(content)

    # Open in a terminal with the editor
    subprocess.Popen(
        f'gnome-terminal --title="Bob is writing..." -- bash -c "{editor} {filename}; exec bash"',
        shell=True, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )
    return {"status": "opened", "file": filename, "editor": editor, "lines": content.count("\n") + 1}


def dictate_live(content, filename="/tmp/bob-note.txt"):
    """Open a terminal and type content character by character — like Bob is dictating."""
    display = os.environ.get("DISPLAY", ":0")
    env = {**os.environ, "DISPLAY": display}

    # Create a script that types it out with a delay
    script = f'''#!/usr/bin/env bash
FILE="{filename}"
cat /dev/null > "$FILE"
echo "Bob is dictating to $FILE..."
echo "---"
sleep 1
while IFS= read -r line; do
    for ((i=0; i<=${{#line}}; i++)); do
        printf "%s" "${{line:$i:1}}"
        printf "%s" "${{line:$i:1}}" >> "$FILE"
        sleep 0.02
    done
    echo
    echo >> "$FILE"
    sleep 0.1
done << 'BOBTEXT'
{content}
BOBTEXT
echo
echo "--- Saved to $FILE ---"
exec bash
'''
    script_path = "/tmp/bob-dictate.sh"
    with open(script_path, "w") as f:
        f.write(script)
    os.chmod(script_path, 0o755)

    subprocess.Popen(
        f'gnome-terminal --title="Bob is dictating..." -- bash -c "{script_path}"',
        shell=True, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )
    return {"status": "dictating", "file": filename, "chars": len(content)}


def describe_image(image_path):
    """Use LLaVA to describe what's in an image."""
    import base64
    try:
        path = os.path.expanduser(image_path)
        with open(path, "rb") as f:
            img_b64 = base64.b64encode(f.read()).decode()

        payload = json.dumps({
            "model": "llava:7b",
            "prompt": "Describe this image in detail. What do you see?",
            "images": [img_b64],
            "stream": False,
        }).encode()

        req = urllib.request.Request(
            f"{OLLAMA_URL}/api/generate",
            data=payload,
            headers={"Content-Type": "application/json"},
        )
        resp = urllib.request.urlopen(req, timeout=120)
        data = json.loads(resp.read())
        return {"description": data.get("response", ""), "model": "llava:7b"}
    except FileNotFoundError:
        return {"error": f"Image not found: {image_path}"}
    except Exception as e:
        return {"error": str(e)}


def capture_and_describe():
    """Take a screenshot and describe what's on screen."""
    display = os.environ.get("DISPLAY", ":0")
    screenshot_path = "/tmp/bob-screen-capture.png"
    subprocess.run(
        ["gnome-screenshot", "-f", screenshot_path],
        env={**os.environ, "DISPLAY": display},
        capture_output=True
    )
    if os.path.exists(screenshot_path):
        return describe_image(screenshot_path)
    return {"error": "Screenshot failed"}


def _get_service(name):
    """Load a service config from /etc/bob/bob.conf."""
    try:
        with open("/etc/bob/bob.conf") as f:
            return json.load(f).get("services", {}).get(name, {})
    except Exception:
        return {}


def get_weather(location="auto"):
    """Get current weather for a location."""
    svc = _get_service("weather")
    key = svc.get("key", "")
    if not key:
        return {"error": "OpenWeatherMap not configured. Set up in Bob Builder."}
    if location == "auto":
        try:
            geo = json.loads(urllib.request.urlopen("http://ip-api.com/json/", timeout=5).read())
            location = f"{geo.get('city','')},{geo.get('countryCode','')}"
        except Exception:
            location = "New York"
    url = f"http://api.openweathermap.org/data/2.5/weather?q={urllib.parse.quote(location)}&appid={key}&units=metric"
    resp = urllib.request.urlopen(url, timeout=10)
    data = json.loads(resp.read())
    return {
        "location": data.get("name"),
        "temp_c": data["main"]["temp"],
        "feels_like": data["main"]["feels_like"],
        "humidity": data["main"]["humidity"],
        "description": data["weather"][0]["description"],
        "wind_kph": round(data["wind"]["speed"] * 3.6, 1),
    }


def send_sms(to, message):
    """Send an SMS via Twilio."""
    svc = _get_service("twilio")
    sid, token, from_num = svc.get("sid",""), svc.get("token",""), svc.get("from","")
    if not all([sid, token, from_num]):
        return {"error": "Twilio not configured. Set up in Bob Builder."}
    data = urllib.parse.urlencode({"To": to, "From": from_num, "Body": message}).encode()
    req = urllib.request.Request(
        f"https://api.twilio.com/2010-04-01/Accounts/{sid}/Messages.json",
        data=data
    )
    import base64
    creds = base64.b64encode(f"{sid}:{token}".encode()).decode()
    req.add_header("Authorization", f"Basic {creds}")
    resp = urllib.request.urlopen(req, timeout=15)
    result = json.loads(resp.read())
    return {"status": "sent", "to": to, "sid": result.get("sid","")}


def push_notification(title, message, priority=0):
    """Send a push notification to phone via Pushover."""
    svc = _get_service("pushover")
    user, token = svc.get("user",""), svc.get("token","")
    if not user or not token:
        return {"error": "Pushover not configured. Set up in Bob Builder."}
    data = urllib.parse.urlencode({
        "token": token, "user": user, "title": title,
        "message": message, "priority": priority
    }).encode()
    req = urllib.request.Request("https://api.pushover.net/1/messages.json", data=data)
    resp = urllib.request.urlopen(req, timeout=10)
    return {"status": "sent", "title": title}


def discord_message(message):
    """Send a message to Discord via webhook."""
    svc = _get_service("discord")
    webhook = svc.get("webhook","")
    if not webhook:
        return {"error": "Discord webhook not configured. Set up in Bob Builder."}
    data = json.dumps({"content": message}).encode()
    req = urllib.request.Request(webhook, data=data, headers={"Content-Type": "application/json"})
    urllib.request.urlopen(req, timeout=10)
    return {"status": "sent", "message": message[:100]}


def hue_control(action, light_id="1", brightness=None, color=None):
    """Control Philips Hue lights."""
    svc = _get_service("hue")
    ip, user = svc.get("ip","").rstrip("/"), svc.get("user","")
    if not ip or not user:
        return {"error": "Philips Hue not configured. Set up in Bob Builder."}

    if action == "list":
        resp = urllib.request.urlopen(f"{ip}/api/{user}/lights", timeout=5)
        lights = json.loads(resp.read())
        return {"lights": {k: {"name": v["name"], "on": v["state"]["on"]} for k, v in lights.items()}}
    elif action in ("on", "off"):
        state = json.dumps({"on": action == "on"}).encode()
        req = urllib.request.Request(f"{ip}/api/{user}/lights/{light_id}/state", data=state, method="PUT")
        urllib.request.urlopen(req, timeout=5)
        return {"status": action, "light": light_id}
    elif action == "brightness" and brightness is not None:
        bri = max(1, min(254, int(brightness * 254 / 100)))
        state = json.dumps({"on": True, "bri": bri}).encode()
        req = urllib.request.Request(f"{ip}/api/{user}/lights/{light_id}/state", data=state, method="PUT")
        urllib.request.urlopen(req, timeout=5)
        return {"status": "brightness set", "light": light_id, "brightness": brightness}
    return {"error": f"Unknown action: {action}"}


def speak(text):
    """Speak text aloud using piper TTS or espeak fallback."""
    # Try piper first
    if os.path.exists("/opt/piper/piper"):
        try:
            proc = subprocess.run(
                ["/opt/piper/piper",
                 "--model", "/opt/piper/models/en_US-lessac-medium.onnx",
                 "--output_file", "/tmp/bob-speech.wav"],
                input=text, capture_output=True, text=True, timeout=30
            )
            if proc.returncode == 0:
                subprocess.run(["aplay", "-q", "/tmp/bob-speech.wav"], capture_output=True, timeout=30)
                return {"status": "spoken", "engine": "piper"}
        except Exception:
            pass

    # Fallback to espeak
    try:
        subprocess.run(
            ["espeak-ng", "-s", "160", text],
            capture_output=True, timeout=30
        )
        return {"status": "spoken", "engine": "espeak-ng"}
    except Exception:
        return {"error": "No TTS engine available"}


# ---------------------------------------------------------------------------
# Tmux cockpit integration — Bob drives the same kldload-console session
# the human looks at. F-keys, Alt-letters, ad-hoc windows. Persistent so
# the human can inspect afterwards.
# ---------------------------------------------------------------------------
KLDLOAD_TMUX_SESSION = "kldload"  # default: klab/cluster cockpit
KLDLOAD_OS_SESSION   = "sysdiag"   # local-OS cockpit (kldload-sysdiag)


def tmux_ensure(session=KLDLOAD_TMUX_SESSION):
    """Start a kldload tmux cockpit session detached if it doesn't exist.

    Session names:
        'kldload' (default) — klab/cluster cockpit (kldload-console)
        'sysdiag'           — local-OS cockpit (kldload-sysdiag, F2 htop /
                              F3 journal / F4 dmesg / F8 zfs / etc)
    """
    has = subprocess.run(
        ["tmux", "has-session", "-t", session],
        capture_output=True,
    )
    if has.returncode == 0:
        return {"status": "exists", "session": session}
    bootstrapper = "kldload-sysdiag" if session == KLDLOAD_OS_SESSION else "kldload-console"
    subprocess.Popen(
        ["bash", "-lc", f"tmux new-session -d -s {session} '{bootstrapper}'"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    import time
    for _ in range(10):
        time.sleep(0.3)
        if subprocess.run(
            ["tmux", "has-session", "-t", session],
            capture_output=True,
        ).returncode == 0:
            return {"status": "created", "session": session}
    return {"status": "failed", "error": "tmux session did not come up"}


def tmux_status(session=KLDLOAD_TMUX_SESSION):
    """List windows in the cockpit + which one is active."""
    out = subprocess.run(
        ["tmux", "list-windows", "-t", session,
         "-F", "#{window_index}\t#{window_name}\tactive=#{window_active}"],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        return {"error": "session not running",
                "stderr": out.stderr.strip(),
                "hint": "call tmux_ensure first"}
    windows = []
    active = None
    for line in out.stdout.strip().splitlines():
        parts = line.split("\t")
        if len(parts) >= 3:
            idx, name, act = parts[0], parts[1], parts[2]
            windows.append({"index": int(idx), "name": name})
            if act.endswith("=1"):
                active = name
    return {"session": session, "windows": windows, "active": active}


def tmux_capture(window="klab", session=KLDLOAD_TMUX_SESSION, lines=80):
    """Return the last N visible lines of a cockpit window's pane.

    Window names map to F-keys: klab (home), k9s (F2), follow (F3),
    disk (F5), syscall (F6), tcp (F7), cilium (F8), top (F9), zfs (F10),
    tracing (F11), kernel-stress (F12), bob (Alt+B).
    """
    target = f"{session}:{window}"
    out = subprocess.run(
        ["tmux", "capture-pane", "-t", target, "-p", "-S", f"-{lines}"],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        return {"error": f"can't capture {target}",
                "stderr": out.stderr.strip(),
                "hint": "list windows with tmux_status; key may not be opened yet"}
    text = out.stdout.rstrip()
    return {"window": window, "lines": text.count("\n") + 1, "content": text[-4000:]}


def tmux_press(key, session=KLDLOAD_TMUX_SESSION):
    """Send a key to the cockpit (F1-F12, M-letter for Alt, S-F* for Shift-F).

    F-keys open primary observability panes. Alt-letter brings up popups
    (M-v VMs, M-c cluster, M-z ZFS, M-w WireGuard, etc). S-F is deep dive
    (S-F2 root shell, S-F5 kldload-doctor live loop).
    """
    out = subprocess.run(
        ["tmux", "send-keys", "-t", session, key],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        return {"error": "send-keys failed", "stderr": out.stderr.strip()}
    import time
    time.sleep(0.5)
    return {"sent": key, "session": session}


def tmux_run(command, window_name="bob-task", session=KLDLOAD_TMUX_SESSION,
             timeout=20, capture_lines=80):
    """Open a NEW window in the cockpit, run a shell command, capture output.

    The window persists after the command finishes so the human can inspect
    it later. If a window with this name already exists, it's replaced.
    """
    target = f"{session}:{window_name}"
    subprocess.run(["tmux", "kill-window", "-t", target], capture_output=True)
    sentinel = "BOB_TASK_DONE_MARKER"
    wrapped = f"bash -c \"{command}; echo {sentinel}; exec bash\""
    out = subprocess.run(
        ["tmux", "new-window", "-t", session, "-n", window_name, wrapped],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        return {"error": "new-window failed", "stderr": out.stderr.strip(),
                "hint": "call tmux_ensure first"}
    import time
    waited = 0
    while waited < timeout:
        time.sleep(1)
        waited += 1
        cap = subprocess.run(
            ["tmux", "capture-pane", "-t", target, "-p", "-S", f"-{capture_lines}"],
            capture_output=True, text=True,
        )
        if cap.returncode == 0 and sentinel in cap.stdout:
            content = cap.stdout.split(sentinel)[0].rstrip()
            return {"window": window_name, "elapsed_s": waited,
                    "content": content[-4000:]}
    cap = subprocess.run(
        ["tmux", "capture-pane", "-t", target, "-p", "-S", f"-{capture_lines}"],
        capture_output=True, text=True,
    )
    return {"window": window_name, "timed_out": True, "elapsed_s": waited,
            "content": cap.stdout[-4000:],
            "hint": "command may still be running; window persists for inspection"}


# ---------------------------------------------------------------------------
# kldload ops — high-level operator tools (diagnostics + scaling +
# replication). Bob isn't a chat bot; it's a system operator that drives
# the kldload tool catalog.
# ---------------------------------------------------------------------------


def _run_capture(cmd, timeout=30):
    """Run a command list, capture stdout/stderr/rc — no shell."""
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return {"rc": out.returncode, "stdout": out.stdout.strip(),
                "stderr": out.stderr.strip()}
    except subprocess.TimeoutExpired:
        return {"rc": -1, "error": f"timeout after {timeout}s"}
    except FileNotFoundError:
        return {"rc": -1, "error": f"not found: {cmd[0]}"}


def kldload_doctor():
    """Run kldload-doctor — canonical 'state of the box' snapshot."""
    r = _run_capture(["kldload-doctor"], timeout=60)
    if r.get("rc") == 0 and r.get("stdout"):
        try:
            return {"health": json.loads(r["stdout"])}
        except json.JSONDecodeError:
            return {"health_text": r["stdout"][:4000]}
    return {"error": r.get("error") or r.get("stderr") or "kldload-doctor failed", "rc": r.get("rc")}


def k8s_overview():
    """K8s cluster overview — nodes, pod counts, warning events."""
    env = os.environ.copy()
    env["KUBECONFIG"] = env.get("KUBECONFIG", "/root/.kube/config")
    nodes = _run_capture(["kubectl", "get", "nodes", "-o",
                          "custom-columns=NAME:.metadata.name,STATUS:.status.conditions[-1].type,ROLE:.metadata.labels.kubernetes\\.io/role,VER:.status.nodeInfo.kubeletVersion",
                          "--no-headers"], timeout=10)
    pods = _run_capture(["kubectl", "get", "pods", "-A", "--no-headers"], timeout=10)
    events = _run_capture(["kubectl", "get", "events", "-A",
                           "--field-selector=type=Warning",
                           "--sort-by=.lastTimestamp",
                           "-o", "custom-columns=TIME:.lastTimestamp,NS:.metadata.namespace,REASON:.reason,MSG:.message",
                           "--no-headers"], timeout=10)
    pod_lines = [l for l in (pods.get("stdout") or "").splitlines() if l.strip()]
    not_running = [l for l in pod_lines if l.split()[3:4] and l.split()[3] != "Running"]
    return {
        "nodes": (nodes.get("stdout") or "").splitlines(),
        "pod_count": len(pod_lines),
        "pods_not_running": not_running[:20],
        "recent_warnings": (events.get("stdout") or "").splitlines()[-10:],
    }


def klab_status():
    """klab goldens + blue/green sites — golden snapshots + running VMs."""
    snaps = _run_capture(["zfs", "list", "-H", "-t", "snapshot", "-o", "name"], timeout=10)
    golden = sorted({s for s in (snaps.get("stdout") or "").splitlines() if "@golden" in s})
    vms = _run_capture(["virsh", "list", "--all", "--name"], timeout=10)
    vm_list = [v for v in (vms.get("stdout") or "").splitlines() if v.strip()]
    blue = sorted([v for v in vm_list if v.startswith("klab-blue-") or "klab-" in v and "-blue" in v])
    green = sorted([v for v in vm_list if v.startswith("klab-green-") or "klab-" in v and "-green" in v])
    return {
        "goldens": golden,
        "blue_sites": blue,
        "green_sites": green,
        "total_vms": len(vm_list),
    }


def zfs_health():
    """ZFS pool status + scrub + ARC + dataset usage summary."""
    pools = _run_capture(["zpool", "status", "-x"], timeout=10)
    pool_list = _run_capture(["zpool", "list", "-H", "-o",
                              "name,size,alloc,free,frag,cap,health"], timeout=10)
    arc = ""
    try:
        with open("/proc/spl/kstat/zfs/arcstats") as f:
            for line in f:
                if line.split()[0] in ("size", "c_max", "hits", "misses"):
                    arc += line
    except FileNotFoundError:
        arc = "(arcstats unavailable)"
    datasets = _run_capture(["zfs", "list", "-H", "-o",
                             "name,used,refer,mountpoint"], timeout=10)
    return {
        "pool_health": (pools.get("stdout") or "").strip()[:2000],
        "pools": (pool_list.get("stdout") or "").splitlines(),
        "arc_summary": arc[:1000],
        "dataset_count": len((datasets.get("stdout") or "").splitlines()),
    }


def find_recent_errors(minutes=15, units=None):
    """journalctl error+ in the last N minutes, optionally per-unit."""
    cmd = ["journalctl", "-p", "err", "--since", f"{minutes} min ago",
           "--no-pager", "-o", "short"]
    for u in (units or []):
        cmd.extend(["-u", u])
    r = _run_capture(cmd, timeout=15)
    lines = [l for l in (r.get("stdout") or "").splitlines()
             if l and "Guest agent is not responding" not in l]
    seen = set()
    deduped = []
    for l in lines:
        sig = " ".join(l.split()[3:])[:120]
        if sig not in seen:
            seen.add(sig)
            deduped.append(l)
    return {
        "window_minutes": minutes,
        "units": units or [],
        "error_lines": deduped[:40],
        "total_unique": len(deduped),
    }


def profile_system(duration_s=5):
    """Sample CPU/disk/memory pressure for N seconds — what's eating the box."""
    top = _run_capture(["top", "-bn1", "-w", "120"], timeout=10)
    top_lines = (top.get("stdout") or "").splitlines()
    cpu_top = top_lines[7:17] if len(top_lines) > 17 else []
    io_stat = _run_capture(["iostat", "-xm", "1", str(duration_s)], timeout=duration_s + 10)
    psi = {}
    for k in ("cpu", "memory", "io"):
        try:
            with open(f"/proc/pressure/{k}") as f:
                psi[k] = f.read().strip()
        except FileNotFoundError:
            psi[k] = "(PSI unavailable)"
    return {
        "cpu_top_processes": cpu_top,
        "io_sample": (io_stat.get("stdout") or "").splitlines()[-20:],
        "pressure": psi,
    }


def k8s_add_worker(count=1):
    """Add N worker nodes to the cluster — DESTRUCTIVE."""
    r = _run_capture(["kube-cluster", "add-worker", "--count", str(count)], timeout=600)
    return {
        "rc": r.get("rc"),
        "stdout": (r.get("stdout") or "")[-2000:],
        "stderr": (r.get("stderr") or "")[-2000:],
        "warning": "destructive: confirm with user before running",
    }


def klab_spawn(distro, site="green"):
    """Clone a single golden into a fresh blue or green site VM."""
    if distro not in ("centos", "rocky", "debian", "fedora", "ubuntu", "rhel"):
        return {"error": f"unknown distro: {distro}"}
    if site not in ("blue", "green"):
        return {"error": f"site must be blue or green, got: {site}"}
    r = _run_capture(["klab", "deploy", site, "--distro", distro], timeout=120)
    return {
        "distro": distro, "site": site,
        "rc": r.get("rc"),
        "stdout": (r.get("stdout") or "")[-2000:],
        "stderr": (r.get("stderr") or "")[-2000:],
    }


def klab_destroy(distro, site):
    """Tear down a klab blue or green site VM — DESTRUCTIVE."""
    if distro not in ("centos", "rocky", "debian", "fedora", "ubuntu", "rhel"):
        return {"error": f"unknown distro: {distro}"}
    if site not in ("blue", "green"):
        return {"error": f"site must be blue or green, got: {site}"}
    r = _run_capture(["klab", "destroy", site, "--distro", distro], timeout=60)
    return {
        "distro": distro, "site": site,
        "rc": r.get("rc"),
        "stdout": (r.get("stdout") or "")[-2000:],
        "warning": "destructive: confirm with user before running",
    }


