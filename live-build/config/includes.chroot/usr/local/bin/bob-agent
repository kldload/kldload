# ---------------------------------------------------------------------------
# Agent loop
# ---------------------------------------------------------------------------
def call_ollama(messages, tools=None):
    """Call Ollama chat API with optional tools."""
    payload = {
        "model": BOB_MODEL,
        "messages": messages,
        "stream": False,
    }
    if tools:
        payload["tools"] = tools

    data = json.dumps(payload).encode()
    req = urllib.request.Request(
        f"{OLLAMA_URL}/api/chat",
        data=data,
        headers={"Content-Type": "application/json"},
    )
    resp = urllib.request.urlopen(req, timeout=300)
    return json.loads(resp.read())


def execute_tool(name, args):
    """Execute a tool function by name with given arguments."""
    func = TOOL_MAP.get(name)
    if not func:
        return {"error": f"Unknown tool: {name}"}
    try:
        if VERBOSE:
            print(f"  [tool] {name}({json.dumps(args, indent=None)[:200]})")
        result = func(**args)
        if VERBOSE:
            print(f"  [result] {json.dumps(result, indent=None)[:200]}")
        return result
    except Exception as e:
        return {"error": f"{name} failed: {str(e)}"}


def agent_loop(user_input):
    """Run the agent loop — Bob thinks, calls tools, thinks again."""
    messages = [
        {"role": "user", "content": user_input}
    ]

    for iteration in range(MAX_ITERATIONS):
        if VERBOSE:
            print(f"\n--- Iteration {iteration + 1} ---")

        response = call_ollama(messages, tools=TOOLS)
        msg = response.get("message", {})

        # If Bob has tool calls, execute them
        tool_calls = msg.get("tool_calls", [])
        if tool_calls:
            messages.append(msg)
            for tc in tool_calls:
                fn = tc.get("function", {})
                name = fn.get("name", "")
                args = fn.get("arguments", {})

                result = execute_tool(name, args)

                messages.append({
                    "role": "tool",
                    "content": json.dumps(result),
                })
        else:
            # No tool calls — Bob is done, print response
            content = msg.get("content", "")
            if content:
                print(content)
            return

    print("Bob hit the iteration limit. Might need a simpler request.")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
if __name__ == "__main__":
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    if not args:
        print("Usage: bob-agent \"your request\"")
        print("       bob-agent --verbose \"check system health\"")
        sys.exit(1)

    user_input = " ".join(args)

    try:
        agent_loop(user_input)
    except urllib.error.URLError:
        print("Can't reach Ollama. Is it running? (systemctl status ollama)")
    except KeyboardInterrupt:
        print("\nBob out.")
    except Exception as e:
        print(f"Error: {e}")
        if VERBOSE:
            import traceback
            traceback.print_exc()
