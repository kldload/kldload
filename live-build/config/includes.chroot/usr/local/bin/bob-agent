    {"type": "function", "function": {
        "name": "klab_destroy",
        "description": "Tear down a klab blue or green site VM. Use to recycle the playground demo. DESTRUCTIVE — confirm with user before calling.",
        "parameters": {"type": "object", "properties": {
            "distro": {"type": "string", "description": "centos / rocky / debian / fedora / ubuntu / rhel"},
            "site": {"type": "string", "description": "blue or green"}}, "required": ["distro", "site"]}}},
]

