#!/usr/bin/env bash
# Convenience forwarder — the real installer is /usr/sbin/kldload-install-target.
# This exists so the tool is reachable from PATH without a full sbin lookup.

set -Eeuo pipefail
trap 'echo "kldload-install-target: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

exec /usr/sbin/kldload-install-target "$@"
