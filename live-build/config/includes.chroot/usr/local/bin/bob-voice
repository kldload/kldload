#!/usr/bin/env bash
# bob-voice — voice input via whisper.cpp
# Records audio, transcribes with whisper, sends to Bob.
#
# Usage: bob-voice              (continuous loop)
#        bob-voice --once       (single question)
set -euo pipefail

GREEN='\033[0;32m'
CYAN='\033[0;36m'
DIM='\033[2m'
YELLOW='\033[1;33m'
NC='\033[0m'

WHISPER=/opt/whisper.cpp/build/bin/whisper-cli
MODEL=/opt/whisper.cpp/models/ggml-base.en.bin
REC=/tmp/bob-voice.wav
ONCE=false

[[ "${1:-}" == "--once" ]] && ONCE=true

# ── Checks ───────────────────────────────────────────────────────────────────
if ! command -v arecord &>/dev/null; then
  echo -e "${YELLOW}arecord not found. Install alsa-utils.${NC}"
  exit 1
fi

if [[ ! -x "$WHISPER" ]]; then
  echo -e "${YELLOW}whisper.cpp not found at ${WHISPER}${NC}"
  echo -e "${DIM}Bob voice needs whisper.cpp built and installed.${NC}"
  exit 1
fi

if [[ ! -f "$MODEL" ]]; then
  echo -e "${YELLOW}Whisper model not found at ${MODEL}${NC}"
  exit 1
fi

# ── Record + transcribe + ask ────────────────────────────────────────────────
echo -e "${CYAN}Bob Voice${NC} — speak your question"
echo -e "${DIM}Press Enter to record, Enter again to stop${NC}"
echo ""

while true; do
  read -rp "  [Enter to record] "
  echo -e "  ${DIM}Listening... (Enter to stop)${NC}"
  arecord -f S16_LE -r 16000 -c 1 -d 30 "$REC" 2>/dev/null &
  REC_PID=$!
  read -r
  kill $REC_PID 2>/dev/null; wait $REC_PID 2>/dev/null || true

  echo -e "  ${DIM}Transcribing...${NC}"
  TEXT=$($WHISPER -m "$MODEL" -f "$REC" --no-timestamps 2>/dev/null \
    | grep -v '^\[' | grep -v '^$' | head -5 | tr '\n' ' ' | sed 's/  */ /g;s/^ *//;s/ *$//')

  if [[ -z "$TEXT" ]]; then
    echo -e "  ${YELLOW}(nothing detected)${NC}"
    [[ "$ONCE" == true ]] && exit 0
    continue
  fi

  echo -e "  ${GREEN}You said:${NC} ${TEXT}"
  echo ""
  bob "$TEXT"
  echo ""

  [[ "$ONCE" == true ]] && exit 0
done
