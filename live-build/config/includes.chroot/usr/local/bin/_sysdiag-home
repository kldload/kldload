#!/usr/bin/env bash
# Render the sysdiag cockpit reference card. Two-column layout, same
# style as _kconsole-home (the klab cockpit cheatsheet). Called by
# kldload-sysdiag at session start and via the `menu` alias.
set -u

# Colors: always emit so capture-pane gets the codes.
# Light-mode safety: W (label color) is now BOLD with NO color, so it
# adapts to the terminal's foreground. Bright-white-on-white was
# invisible in light mode — operator on .142 b644 2026-06-07: "need to
# fix the white text because it's invisible in light mode."
G=$'\e[38;5;85m'  # accent green
C=$'\e[38;5;117m' # accent cyan
Y=$'\e[38;5;221m' # warn amber
P=$'\e[38;5;177m' # accent purple
M=$'\e[38;5;245m' # muted
W=$'\e[1m'        # label = bold, terminal default fg (works in both modes)
D=$'\e[38;5;240m' # dim
N=$'\e[0m'
B=$'\e[1m'

LC_ALL=${LC_ALL:-C.UTF-8}
# ── Width adaptation ─────────────────────────────────────────────────
# The cheatsheet was laid out for a terminal it does not always get. Two
# columns of key(12) + name(22) + desc(36) needs ~140 columns; the launcher
# asks for 200x60, but that request is not always honoured — Wayland may
# ignore a geometry hint, a small screen clamps it, and ptyxis and
# gnome-console (which replace gnome-terminal on newer GNOME) take no
# geometry argument at all. When it is not honoured the right-hand column
# wraps into the left and the menu is unreadable until the operator resizes
# the window by hand.
#
# HISTORY: reported 2026-08-10 — "the terminal also needs to be resized to
# see the os menu".
#
# Three layouts, chosen from the width we actually have:
#   >=136  two columns with descriptions   (the original)
#   >=72   two columns, descriptions dropped
#   <72    one column, stacked, descriptions dropped
# stty is asked before tput because COLUMNS is not exported into a command
# substitution, and tput reads the terminfo size which can be stale after a
# resize; stty size asks the kernel.
# SYSDIAG_COLS lets the caller state the budget. _sysdiag-greeting sets it
# to (terminal - fastfetch - padding) when it composes side by side; without
# it each block sized to the full terminal and the sum overflowed — 154
# columns of output in a 140-column window (measured 2026-08-10).
_COLS="${SYSDIAG_COLS:-}"
[[ -z "$_COLS" ]] && _COLS=$( (stty size 2>/dev/null | awk '{print $2}') || true)
[[ -z "${_COLS:-}" || "${_COLS}" -lt 20 ]] && _COLS=$(tput cols 2>/dev/null || echo 80)
# The rule spans the usable width rather than a hardcoded 76 characters.
_RULE=""
_rw=$((_COLS - 4))
((_rw < 8)) && _rw=8
((_rw > 76)) && _rw=76
for ((_i = 0; _i < _rw; _i++)); do _RULE+="─"; done

if ((_COLS >= 136)); then
    _LAYOUT=wide
elif ((_COLS >= 72)); then
    _LAYOUT=medium
else
    _LAYOUT=narrow
fi

_pad() {
    local s="$1" w="$2" cl=${#1}
    if ((cl < w)); then
        printf '%s%*s' "$s" $((w - cl)) ''
    else
        printf '%s' "$s"
    fi
}

cat <<BANNER

${W}  sysdiag${N}${M}  ─ local-OS observability cockpit ${D}(parallel to klab)${N}
${D}  ${_RULE}${N}

BANNER

L_ROWS=()
R_ROWS=()

_head() {
    local col="$1" title="$2" subtitle="$3" color="$4"
    local row
    if [[ "$_LAYOUT" == wide ]]; then
        row="${color}${B}$(_pad "$title" 40)${N}${M}$(_pad "$subtitle" 32)${N}"
    else
        row="${color}${B}${title}${N}"
    fi
    if [[ "$col" == "L" ]]; then L_ROWS+=("$row"); else R_ROWS+=("$row"); fi
}
_emit() {
    local col="$1" key="$2" name="$3" desc="$4" color="$5"
    local row
    if [[ "$_LAYOUT" == wide ]]; then
        row="${color}$(_pad "  $key" 12)${W}$(_pad "$name" 22)${N}${M}$(_pad "$desc" 36)${N}"
    else
        # Drop the description, keep the binding and its name — the two
        # things the sheet exists to tell you.
        row="${color}$(_pad "  $key" 12)${W}$(_pad "$name" 20)${N}"
    fi
    if [[ "$col" == "L" ]]; then L_ROWS+=("$row"); else R_ROWS+=("$row"); fi
}
_blank() {
    if [[ "$1" == "L" ]]; then L_ROWS+=(""); else R_ROWS+=(""); fi
}

# ── LEFT column: F-keys (primary panes) + navigation ────────────────
_head L "▸ F-keys (toggle)" "press once = open; press again = close" "$G"
_emit L "F1" "help" "redraw this cheatsheet" "$G"
_emit L "F2" "k9s" "cluster TUI" "$G"
_emit L "F3" "journal" "journalctl -f live stream" "$G"
_emit L "F4" "dmesg" "kernel ring (follow)" "$G"
_emit L "F5" "DISK bcc (4w)" "biosnoop + biolatency + fileslower + zfsdist" "$G"
_emit L "F6" "SYSCALL (5w)" "exec + open + kill + syscount + capable" "$G"
_emit L "F7" "TCP bcc (3w)" "tcpconnect + tcpretrans + tcplife" "$G"
_emit L "F8" "NET" "ss + ip + listeners + active" "$G"
_emit L "F9" "SERVICES" "failed + recently-restarted" "$G"
_emit L "F10" "ZFS (2w)" "zpool-io + zfs-internals" "$G"
_emit L "Alt+r" "KERNEL-STRESS" "psi + runqlat + softirqs + hardirqs + bpfp" "$G"
_emit L "F12/Alt+t" "BANDWIDTH" "tcptop + nethogs" "$G"
_blank L
_emit L "S-F6" "hardware" "lscpu + lspci + sensors" "$P"
_emit L "S-F7" "packages" "rpm/dnf last + history" "$P"
_emit L "S-F8" "kernel" "uname + modules + sysctl" "$P"

_blank L
_head L "▸ Navigation — one pattern" "Alt walks, Alt+Shift splits" "$C"
_emit L "Alt+←/→" "prev / next" "walk windows" "$C"
_emit L "Alt+1..9" "jump window" "direct by number" "$C"
_emit L "click tab" "any window" "mouse the status bar" "$C"
_emit L "Alt+Sh+→" "split w/ next" "current LEFT, next RIGHT" "$C"
_emit L "Alt+Sh+←" "split w/ prev" "prev LEFT, current RIGHT" "$C"
_emit L "Alt+Sh+↓" "split below" "current TOP, next BELOW" "$C"
_emit L "Alt+Sh+↑" "split above" "prev TOP, current BELOW" "$C"
_emit L "Alt+x" "un-split" "drop other panes, return one" "$C"
_emit L "Alt+Enter" "new window" "blank shell" "$C"
_emit L "Ctrl+q" "close pane" "kills pane, then window" "$C"

# ── RIGHT column: Alt-letter heads-up + Shift-F deep dive ────────────
_head R "▸ Heads-up popups" "(Alt+letter — auto-dismiss on Enter)" "$Y"
_emit R "Alt+u" "uptime" "uptime + who + last logins" "$Y"
_emit R "Alt+m" "memory" "PSI + free -h + top RSS" "$Y"
_emit R "Alt+d" "disk" "lsblk + df + smartctl health" "$Y"
_emit R "Alt+n" "network" "interfaces + routes + dns" "$Y"
_emit R "Alt+s" "services" "failed + recent err" "$Y"
_emit R "Alt+z" "ZFS" "pool + list + recent snapshots" "$Y"
_emit R "Alt+p" "processes" "top by CPU + top by RAM" "$Y"
_emit R "Alt+l" "logins" "who / w / last 20" "$Y"

_blank R
_head R "▸ Scrollback" "(no prefix needed)" "$C"
_emit R "PageUp" "scrollback" "into copy-mode, scroll up" "$C"
_emit R "S-PageUp" "jump top" "history-top" "$C"
_emit R "S-PageDown" "jump bottom" "back to live" "$C"
_emit R "Mouse wheel" "scrollback" "auto-enters copy-mode" "$C"
_emit R "q / Enter" "exit scroll" "back to live view" "$C"

_blank R
_head R "▸ Deep-dive" "(Shift+F<N>, full-screen)" "$P"
_emit R "S-F2" "root shell" "sudo -i" "$P"
_emit R "S-F3" "dmesg search" "interactive grep prompt" "$P"
_emit R "S-F4" "sysctl explorer" "sysctl -a | less" "$P"
_emit R "S-F5" "doctor loop" "kldload-doctor live refresh 15s" "$P"
_emit R "S-F9" "htop" "process explorer (was F2)" "$P"

_blank R
_head R "▸ GNOME desktop" "(outside tmux — 4 workspaces in + layout)" "$M"
_emit R "Ctrl-Alt+↑/←/→/↓" "switch ws" "go to ws 1/2/3/4 (no window)" "$M"
_emit R "Super+↑/←/→/↓" "send + go" "move active window + follow" "$M"
_emit R "Super-Sh+↑" "max toggle" "maximize / restore" "$M"
_emit R "Super-Sh+↓" "minimize" "drop to dock" "$M"
_emit R "Super-Sh+←/→" "tile L/R" "snap to half-screen" "$M"

# ── Compose side-by-side ─────────────────────────────────────────────
_max=${#L_ROWS[@]}
((${#R_ROWS[@]} > _max)) && _max=${#R_ROWS[@]}
if [[ "$_LAYOUT" == narrow ]]; then
    # Too thin for two columns at all: stack them so nothing wraps.
    printf '%s\n' "${L_ROWS[@]}"
    printf '\n'
    printf '%s\n' "${R_ROWS[@]}"
else
    for ((i = 0; i < _max; i++)); do
        L="${L_ROWS[i]:-}"
        R="${R_ROWS[i]:-}"
        printf '%s   %s\n' "$L" "$R"
    done
fi

# The worked example is ~100 columns; keep it only when it fits.
_BOBEG=""
((_COLS >= 110)) && _BOBEG=" ${D}Ask: ${N}${C}\"sysdiag: open zfs pane, tell me if any pool is degraded\"${N}"

cat <<FOOT

${M}  ${D}Type ${N}${C}menu${M}${D} to redraw, ${N}${C}help${M}${D} for the full kldload-help docs.${N}
${M}  ${D}Bob can drive these same panes.${N}${_BOBEG}

FOOT
