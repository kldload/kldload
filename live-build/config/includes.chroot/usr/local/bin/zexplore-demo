#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# zexplore-demo — a narrated walkthrough AND a functional test of every zexplore
#                 feature, in the spirit of kvm-demo / kube-demo.
# ─────────────────────────────────────────────────────────────────────────────
# WHAT IT DOES, IN ORDER:
#   0. Builds a self-contained, file-backed scratch estate (two pools) so nothing
#      touches your real data, and a demo dataset with sample files.
#   1. Dossier      — zexplore's full properties + permissions view of a dataset.
#   2. Snapshot     — snapshot on tap.
#   3. Clone        — an instant, independent writable fork.
#   4. Replicate    — point-and-shoot send/recv to a second LOCAL pool.
#   5. Replicate →  — the same, to a REMOTE host (onyx by default), over SSH.
#   6. Incremental  — a second snapshot replicated as a delta, local + remote.
#   7. Rollback     — mutate the data, then undo it — the "roll back the machine".
#   8. Txn API      — zexplore-txn: snapshot → mutate → rollback, as a function.
#   9. Cleanup      — destroy the scratch estate + the remote demo dataset.
#   Every step ASSERTS its result (✓/✗), so a clean run is also a passing test.
#
# WHY: one artifact that (a) demos the tool for a video, (b) proves it works end
#      to end, and (c) shows cross-machine replication against a real peer.
#
# INPUTS:
#   --no-pause            run start-to-finish (video / CI); default pauses per step
#   --remote [user@]host:pool   replication target (default: the REMOTE env below)
#   REMOTE env            same, e.g. REMOTE=zexp@10.100.10.142:zxdemo
#   Remote must accept the local root's SSH key and let $user `zfs recv` into pool
#   (root, or a user holding `zfs allow receive,create,mount` — the delegated way).
#
# NOTES: root required (zpool/zfs). File-backed pools live under $WORK and are
#   destroyed on exit even if a step fails (trap). Safe to re-run.
# ─────────────────────────────────────────────────────────────────────────────
set -Eeuo pipefail
trap 'echo -e "\n\033[1;31m[demo] FAIL at line $LINENO: $BASH_COMMAND\033[0m" >&2' ERR

if [[ $EUID -ne 0 ]]; then exec sudo -E "$0" "$@"; fi

# ── config ───────────────────────────────────────────────────────────────────
PAUSE=1
REMOTE="${REMOTE:-root@10.100.10.142:zxdemo}" # onyx by default
while [[ $# -gt 0 ]]; do
    case "$1" in
    --no-pause) PAUSE=0 ;;
    --remote)
        REMOTE="$2"
        shift
        ;;
    -h | --help)
        sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    *)
        echo "unknown arg: $1" >&2
        exit 2
        ;;
    esac
    shift
done
SRC=zxdemo  # source pool (file-backed)
BAK=zxbak   # local replication target pool (file-backed)
DS=$SRC/app # the demo dataset
WORK="$(mktemp -d /var/tmp/zexplore-demo.XXXXXX)"
PASS=0 FAILN=0

C=$'\033[1;36m' G=$'\033[1;32m' Y=$'\033[1;33m' R=$'\033[1;31m' M=$'\033[1;35m' D=$'\033[2m' N=$'\033[0m'
say() { echo -e "${C}▸${N} $*"; }
run() {
    echo -e "  ${D}\$ $*${N}"
    eval "$@"
}
ok() {
    PASS=$((PASS + 1))
    echo -e "  ${G}✓${N} $*"
}
bad() {
    FAILN=$((FAILN + 1))
    echo -e "  ${R}✗ $*${N}"
}
assert() { # assert <cmd...> :: <description>
    local desc="${*##*:: }" cmd="${*%% :: *}"
    if eval "$cmd" >/dev/null 2>&1; then ok "$desc"; else bad "$desc"; fi
}
step() {
    echo
    echo -e "${M}━━ $* ━━${N}"
}
pause() { [[ $PAUSE == 1 ]] && read -r -p "$(echo -e "${D}   ↵ continue…${N}")" _ || true; }

cleanup() {
    echo -e "\n${D}[demo] tearing down the scratch estate…${N}"
    local rhost="${REMOTE%%:*}" rpool="${REMOTE#*:}"
    [[ "$rhost" == *@* ]] || rhost="root@${rhost}"
    ssh -o StrictHostKeyChecking=no -o ConnectTimeout=6 "$rhost" "zfs destroy -r ${rpool%%/*}/appfromdemo 2>/dev/null; zfs destroy -r ${rpool}/app 2>/dev/null" 2>/dev/null || true
    zpool destroy "$SRC" 2>/dev/null || true
    zpool destroy "$BAK" 2>/dev/null || true
    rm -rf "$WORK"
}
trap cleanup EXIT

# ── 0. build the scratch estate ──────────────────────────────────────────────
clear 2>/dev/null || true
echo -e "${C}╭─────────────────────────────────────────────╮"
echo -e "│   zexplore — the ZFS primitives, demonstrated │"
echo -e "╰─────────────────────────────────────────────╯${N}"
echo -e "${D}   remote target: ${REMOTE}   (self-contained; nothing touches real data)${N}"
pause

step "0 · build a self-contained scratch estate"
truncate -s 900M "$WORK/src.img" "$WORK/bak.img"
run "zpool create -f $SRC $WORK/src.img"
run "zpool create -f $BAK $WORK/bak.img"
run "zfs create $DS"
echo "the-original-data" >"/$DS/state.txt"
mkdir -p "/$DS/config" && echo "port=8080" >"/$DS/config/app.conf"
assert "zfs list $DS :: demo dataset $DS created with data"
pause

# ── 1. dossier ───────────────────────────────────────────────────────────────
step "1 · the dossier — everything about a dataset at a glance"
say "zexplore's detail pane: space, every property, BOTH permission layers."
zexplore --preview "$DS" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | sed 's/^/   /'
pause

# ── 2. snapshot ──────────────────────────────────────────────────────────────
step "2 · snapshot on tap"
run "zexplore snap $DS v1"
assert "zfs list -t snapshot ${DS}@v1 :: snapshot ${DS}@v1 taken"
pause

# ── 3. clone ─────────────────────────────────────────────────────────────────
step "3 · instant clone — a writable fork in milliseconds"
run "zfs clone ${DS}@v1 $SRC/clone"
assert "zfs list $SRC/clone :: clone $SRC/clone is live and independent"
pause

# ── 4. replicate locally ─────────────────────────────────────────────────────
step "4 · replicate — point-and-shoot to a second local pool"
say "full send the first time; the target is forced readonly so it never drifts."
echo y | zexplore replicate "${DS}@v1" "$BAK/app" 2>&1 | sed 's/^/   /' | grep -viE '^\s*$' || true
assert "zfs list ${BAK}/app@v1 :: ${DS}@v1 replicated to ${BAK}/app"
assert "[ \"\$(zfs get -H -o value readonly ${BAK}/app)\" = on ] :: replica is readonly (drift-proof)"
pause

# ── 5. replicate to a remote host (onyx) ─────────────────────────────────────
step "5 · replicate → a remote host, over SSH"
rhost="${REMOTE%%:*}"
rpool="${REMOTE#*:}"
sshd="$rhost"
[[ "$rhost" == *@* ]] || sshd="root@${rhost}"
if ssh -o StrictHostKeyChecking=no -o ConnectTimeout=6 "$sshd" true 2>/dev/null; then
    say "same command, a remote target: ${M}${REMOTE}/app${N}"
    echo y | zexplore replicate "${DS}@v1" "${REMOTE}/app" 2>&1 | sed 's/^/   /' | grep -viE '^\s*$' || true
    assert "ssh $sshd zfs list ${rpool}/app@v1 :: ${DS}@v1 landed on ${rhost}"
else
    bad "remote ${sshd} unreachable — skipping (set --remote or fix SSH/zfs-allow)"
fi
pause

# ── 6. incremental ───────────────────────────────────────────────────────────
step "6 · incremental — a second snapshot ships only the delta"
echo "a-migration-happened" >>"/$DS/state.txt"
run "zexplore snap $DS v2"
say "local:"
echo y | zexplore replicate "${DS}@v2" "$BAK/app" 2>&1 | grep -iE 'incremental|replicated' | sed 's/^/   /' || true
assert "zfs list ${BAK}/app@v2 :: incremental v1→v2 landed locally"
if ssh -o StrictHostKeyChecking=no -o ConnectTimeout=6 "$sshd" true 2>/dev/null; then
    say "remote:"
    echo y | zexplore replicate "${DS}@v2" "${REMOTE}/app" 2>&1 | grep -iE 'incremental|replicated' | sed 's/^/   /' || true
    assert "ssh $sshd zfs list ${rpool}/app@v2 :: incremental v1→v2 landed on ${rhost}"
fi
pause

# ── 7. rollback — undo the machine ───────────────────────────────────────────
step "7 · rollback — undo a bad change, instantly"
echo "CATASTROPHIC-BAD-DEPLOY" >"/$DS/state.txt"
say "state is now: ${R}$(cat "/$DS/state.txt")${N}"
run "zfs rollback -r ${DS}@v1"
say "after rollback: ${G}$(cat "/$DS/state.txt")${N}"
assert "[ \"\$(cat /$DS/state.txt)\" = the-original-data ] :: data restored to the v1 snapshot"
pause

# ── 8. instant rollback as a function ────────────────────────────────────────
step "8 · instant rollback as a function — the transaction API"
say "an app can bracket a risky op with a guaranteed undo. Here, host-side:"
mkfs_ok=1
run "zfs create -V 64M $SRC/txvol" || mkfs_ok=0
if [[ $mkfs_ok == 1 ]]; then
    for _ in $(seq 1 20); do
        [[ -b /dev/zvol/$SRC/txvol ]] && break
        sleep 0.3
    done
    mkfs.ext4 -q -F "/dev/zvol/$SRC/txvol" 2>/dev/null
    MP="$(mktemp -d)"
    mount "/dev/zvol/$SRC/txvol" "$MP"
    echo "before" >"$MP/db.txt"
    SOCK=/run/zexplore-demo.sock
    ZEXPLORE_VM_BASE=$SRC zexplore-api --unix "$SOCK" >/dev/null 2>&1 &
    apipid=$!
    sleep 1
    sync # flush the ext4 write to the zvol block device BEFORE snapshotting
    TXN="$(zexplore-txn --unix "$SOCK" --vm txvol begin)"
    say "txn opened: ${TXN}"
    echo "AFTER-BROKEN-MIGRATION" >"$MP/db.txt"
    umount "$MP"
    zexplore-txn --unix "$SOCK" --vm txvol rollback "$TXN" >/dev/null
    mount "/dev/zvol/$SRC/txvol" "$MP"
    say "after rollback: ${G}$(cat "$MP/db.txt")${N}"
    assert "[ \"\$(cat $MP/db.txt)\" = before ] :: app data rolled back via the API"
    umount "$MP"
    rmdir "$MP"
    kill $apipid 2>/dev/null || true
    rm -f "$SOCK"
else
    say "(zvol create unavailable here — skipping the API step)"
fi
pause

# ── done ─────────────────────────────────────────────────────────────────────
step "done"
echo -e "   ${G}${PASS} passed${N}   $([[ $FAILN -gt 0 ]] && echo "${R}${FAILN} failed${N}" || echo "${D}0 failed${N}")"
echo -e "   ${D}zexplore: browse · snapshot · clone · replicate (local + remote) · rollback · txn-API${N}"
[[ $FAILN -eq 0 ]]
