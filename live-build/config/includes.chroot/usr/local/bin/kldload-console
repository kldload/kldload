#!/bin/bash
# Browser-embedded terminal entry point (ttyd → tmux → operator console).
# Lives as a persistent tmux session named "kldload" so iframe reloads
# re-attach instead of losing state. F-keys below are bound without the
# Ctrl+B prefix so every pane is one keystroke away.
export KUBECONFIG=/root/.kube/config
export TERM=xterm-256color
SESSION=kldload

# ── helpers ────────────────────────────────────────────────────────────
# k9s wrapper: only run k9s when kubectl is reachable; otherwise print a
# helpful message and poll. Prevents a crash loop when the cluster isn't
# bootstrapped yet.
_k9s_wrap() {
    while true; do
        if [ -r "$KUBECONFIG" ] && kubectl --request-timeout=3s get nodes >/dev/null 2>&1; then
            k9s
        else
            echo "▼ k9s waiting for cluster — will start as soon as kubectl is reachable."
            echo "  (Bootstrap your cluster first: kube-cluster bootstrap --workers 3)"
            echo ""
            echo "  Polling every 10s. Ctrl+C to drop to a shell here."
            sleep 10
        fi
    done
}
export -f _k9s_wrap

# Helper to spawn a command in a named window, overwriting if it already
# exists. Used by every F-key-to-content binding so a second press
# doesn't pile up windows.
_spawn() {
    local name="$1"
    shift
    local cmd="$*"
    tmux kill-window -t "${SESSION}:${name}" 2>/dev/null || true
    tmux new-window -t "$SESSION" -n "$name" "$cmd"
}

_kinspect_picker() {
    # Interactive picker: list libvirt domains + cluster pods, let the user
    # type two selections, then launch kinspect.
    echo "── kinspect: pick two endpoints ───────────────────────────"
    echo ""
    echo "-- Running VMs --"
    virsh list --name 2>/dev/null | awk 'NF'
    echo ""
    echo "-- Pods (cluster) --"
    kubectl get pods -A --no-headers 2>/dev/null | awk '{printf "  %s/%s\n", $1, $2}' | head -40
    echo ""
    read -r -p "Endpoint 1 (vm name, ns/pod, or ip): " e1
    read -r -p "Endpoint 2 (vm name, ns/pod, or ip): " e2
    if [[ "$e1" == */* ]]; then
        kinspect --pod "$e1" "$e2"
    elif [[ "$e1" =~ ^[0-9]+\. ]]; then
        kinspect --ip "$e1" "$e2"
    else
        kinspect "$e1" "$e2"
    fi
    echo ""
    read -r -p "Press Enter to return…" _
}
export -f _kinspect_picker

# ── bootstrap the session ──────────────────────────────────────────────
if ! tmux has-session -t $SESSION 2>/dev/null; then
    # Start with a single minimal shell as the landing pad — NO panes
    # pre-loaded. Every F-key brings up its own content window on demand,
    # and pressing the same key again closes it. User controls what's
    # running, nothing steals CPU/memory just because the drawer is open.
    tmux new-session -d -s $SESSION -n klab
    # Session-level survivability:
    #   destroy-unattached off — when ttyd's browser tab disconnects momentarily
    #     (network blip, iframe reload, F-key window churn under load), tmux
    #     would otherwise destroy the session as soon as the last client
    #     detaches. That's what caused the 2026-05-12 "press enter to reconnect"
    #     → hard-refresh-required loop on F11+shift-arrow navigation: tcplife
    #     exited fast, last client detached during the race, session GC'd,
    #     reconnect found nothing to attach to.
    #   remain-on-exit on — when an F-key window's command exits (bcc tool
    #     fails on a missing tracepoint, htop dies on OOM, Ctrl+C of an
    #     execsnoop trace, etc.) the window stays with the last screen of
    #     output visible. Without this, the window closes silently and
    #     the operator never sees WHY a tool failed.
    #
    #     Tried `remain-on-exit failed` 2026-05-18 to make clean-exit
    #     panes auto-close — backed out within minutes because the
    #     synchronous window-close racing with ttyd's pty link dropped
    #     the ttyd client and showed "press enter to reconnect". `on`
    #     paired with the dead-pane hook below gives a cleaner UX: the
    #     dead pane shows the closeout banner, any of Alt+X / Alt+Q /
    #     Ctrl+Q / Enter dismisses it.
    tmux set-option -g destroy-unattached off
    tmux set-option -g remain-on-exit on
    # Dead-pane hook — once a tool exits, drop a one-line banner so the
    # operator knows the pane can be dismissed with Enter/Alt+X/Alt+Q.
    # `display-message -p` writes into the dead pane's preserved buffer
    # so it shows up at the bottom of the surviving output.
    tmux set-hook -g pane-died 'display-message -d 0 "↩ tool exited — press Enter or Alt+X to close this pane"'
    # Bind Enter in dead panes to kill-pane via if-shell guard. The
    # guard prevents Enter from killing live panes (where Enter is just
    # a newline). Tmux's pane_dead format flag flips to 1 the moment
    # remain-on-exit kicks in.
    tmux bind-key -T root -N "close dead pane with Enter" Enter \
        if-shell -F "#{pane_dead}" "kill-pane" "send-keys Enter"
    # The klab home tab opens with a distro banner (fastfetch — OS / kernel
    # / ZFS version / uptime + the ASCII logo so you can tell which distro
    # you're on at a glance) followed by the F-key cheatsheet. `menu` and
    # `help` aliases let an operator redraw either inline at any time.
    tmux send-keys -t $SESSION:klab "alias menu='_kconsole-home'; alias help='kldload-help'; clear; _kconsole-greeting" Enter

    # F1 = redraw the cheatsheet INSIDE the klab window. Not a popup —
    # popups created a second tmux client connection that pulled focus
    # away from the user's current pane, and crucially the old
    # _khelp-toggle / _khelp-close chain used `\;` which tmux parses as
    # a top-level command separator (NOT a bind-internal sequence), so
    # every chained run-shell fired AT BIND TIME instead of on key press.
    # That bug spawned all 27 cockpit windows + every Shift+F window the
    # moment the script ran. Single-command bind, no chaining, no popup,
    # no bug. Operator can also type `menu` at the klab prompt anytime.
    tmux bind -n F1 if-shell -F "#{!=:#{window_name},klab}" \
        "select-window -t '${SESSION}:=klab'" \
        "send-keys -t '${SESSION}:=klab' 'clear; _kconsole-greeting' Enter"

    # ── Primary F-keys (content panes) ────────────────────────────────
    # 2026-05-20 reorg — themed mini-cockpits across F5..F12. Each F-key
    # opens a small group (2-3 windows) of related views — disk, syscall,
    # net, top, zfs, etc. — so you get the cross-view context you'd want
    # for that question without 30 windows in your face. The big all-up
    # cockpits (5 / 7 / 15 windows) are still on disk as typed commands:
    #   _kebpf-syscalls   full 5-window syscall cockpit (demo finale)
    #   _kebpf-io         full 7-window I/O + ZFS cockpit
    #   _kcockpit         full 15-window kernel/Cilium/Tetragon cockpit
    #   _ktcp-expanded    2-pane TCP cockpit (ss awk + nethogs)
    #   _kclose-all       kill every non-klab window
    # Run those from F10 (scratch shell) when you want the firehose.
    #
    # F-key layout:
    #   F1  help (popup toggle)
    #   F2  k9s
    #   F3  logs — kldload-follow unified tail
    #   F4  webui+ttyd journalctl
    #   F5  DISK bcc       — biosnoop + biolatency + fileslower + zfsdist
    #   F6  SYSCALL bcc    — exec + open + kill + syscount + capable
    #   F7  TCP bcc        — tcpconnect + tcpretrans + tcplife
    #   F8  CILIUM state   — cilium-status + lb + netpol + bpf-maps
    #   F9  IN-KERNEL TOP  — htop + k8s-top + zpool-iostat + bpf-prog
    #   F10 ZFS group      — zpool-io + zfs-internals
    #   F11 TRACING        — hubble + tetragon + tracingpol + kernel-log
    #   F12 KERNEL-STRESS  — _kgroup kernel-stress (PSI + runqlat + softirqs + hardirqs + bpf-prog)
    # CRITICAL — DO NOT chain run-shell calls with `\;` inside `tmux bind`.
    # Bash escapes `\;` to a literal `;` arg, but tmux's CLI parser treats
    # that as a TOP-LEVEL command separator (between distinct tmux
    # commands), NOT as a sequence-inside-bind. So
    #     tmux bind -n F2 run-shell X \; run-shell Y
    # gets parsed as TWO tmux commands: `(bind -n F2 run-shell X)` and
    # `(run-shell Y)` — and the SECOND run-shell fires immediately at
    # bind-setup time. Earlier version of this file used that pattern to
    # chain `_khelp-close` before each F-key action; the result was every
    # F-key and Shift+F-key action firing the moment kldload-console ran,
    # spawning ~35 windows in an empty session. Burned a debugging
    # session 2026-05-20. Rule from here on: one tmux command per bind,
    # NO `\;` chains. The popup is gone (help renders inline in klab),
    # so there's nothing to dismiss before the action.
    tmux bind -n F2 run-shell "_ktoggle-win k9s    'bash -c _k9s_wrap'"
    # F3 = unified live tail across every post-install log stream
    # (autodeploy + klab driver + firstboot + kube-bootstrap + every VM
    # console under /var/log/klab/). Single command, all of it.
    tmux bind -n F3 run-shell "_ktoggle-win follow 'kldload-follow'"
    # F4 = webui+ttyd journalctl — the install/operator-surface logs.
    tmux bind -n F4 run-shell "_ktoggle-win logs   'journalctl -f -u kldload-webui -u ttyd-k9s'"
    # F5..F12 = themed mini-cockpit groups (each opens 2-3 related windows
    # for that question, toggle off with the same key).
    tmux bind -n F5 run-shell "_kgroup disk"
    tmux bind -n F6 run-shell "_kgroup syscall"
    tmux bind -n F7 run-shell "_kgroup tcp"
    tmux bind -n F8 run-shell "_kgroup cilium"
    tmux bind -n F9 run-shell "_kgroup top"
    tmux bind -n F10 run-shell "_kgroup zfs"
    tmux bind -n F11 run-shell "_kgroup tracing"
    # F12 = the kernel-stress cockpit (replaces the older _ktcp-expanded
    # TCP rich view — that data was already on F7's TCP bcc cockpit
    # anyway). Five panes, eBPF-heavy:
    #   psi      live /proc/pressure/{cpu,io,memory} — the single best
    #            "what is stalled right now" surface in the kernel,
    #            available since 4.20 and almost nobody runs it
    #   runqlat  bcc — scheduler queue latency histogram every 5s
    #   softirqs bcc — softirq runtime breakdown (NET_RX, RCU, TIMER…)
    #   hardirqs bcc — IRQ handler runtime (NIC, NVMe, etc.)
    #   bpf-prog bpftool prog show watched every 5s — the BPF tax view
    # This is the "in-kernel top" cockpit F9 was *labeled* as for a while
    # but never actually delivered (F9 is plain htop). Adopted 2026-05-27.
    tmux bind -n F12 run-shell "_kgroup kernel-stress"

    # NO client-attached welcome hook here — the old hook fired
    # _khelp-toggle (a tmux display-popup) on first attach. The popup
    # pulled a second client onto the session and felt intrusive. Help
    # is rendered into the klab window at session start (fastfetch +
    # _kconsole-home) instead, and F1 redraws it on demand.

    # Shift+F<N> — deeper complementary single-tool views. Same single-
    # command bind rule (NO `\;` chains).
    tmux bind -n S-F2 run-shell "_ktoggle-win k-evts  'kubectl get events -A --watch --field-selector type=Warning 2>&1 || (echo no-cluster; sleep 99)'"
    tmux bind -n S-F3 new-window -n root 'sudo -i'
    tmux bind -n S-F4 run-shell "_ktoggle-win dmesg   'sudo dmesg --follow --human --ctime'"
    tmux bind -n S-F5 run-shell "_ktoggle-win doctor  'while true; do clear; kldload-doctor 2>/dev/null | python3 -m json.tool | head -80; sleep 15; done'"
    tmux bind -n S-F6 run-shell "_ktoggle-win iotop   'sudo iotop -o -P'"
    tmux bind -n S-F7 run-shell "_ktoggle-win k-top   'watch -n 3 kubectl top pods -A --sort-by=memory'"
    tmux bind -n S-F8 run-shell "_ktoggle-win c-drop  'kubectl -n kube-system exec ds/cilium -c cilium-agent -- cilium-dbg monitor --type drop 2>&1 || (echo cilium-unavailable; sleep 99)'"
    tmux bind -n S-F9 run-shell "_ktoggle-win zfsio   'zfs iostat -l -v 2'"
    tmux bind -n S-F10 run-shell "_ktoggle-win kinspect 'bash -c _kinspect_picker'"
    tmux bind -n S-F11 run-shell "_ktoggle-win retrans 'sudo /usr/share/bcc/tools/tcpretrans 2>/dev/null || sudo tcpretrans-bpfcc 2>/dev/null || (echo need-bcc-tools; sleep 99)'"
    tmux bind -n S-F12 run-shell "_ktoggle-win connect 'sudo /usr/share/bcc/tools/tcpconnect 2>/dev/null || sudo tcpconnect-bpfcc 2>/dev/null || (echo need-bcc-tools; sleep 99)'"

    # ── Pane manipulation (Alt-shortcuts, no prefix) ──────────────────
    # Alt+left/right + Alt+h/l walk WINDOWS (Shift+Arrow gets eaten by
    # the browser's text-selection / history-nav before xterm.js sees
    # it, so we lean on Alt). Alt+up/down + Alt+j/k walk PANES within a
    # window. Two key faces for each direction is intentional: vim
    # users reach for h/l, everyone else for arrows; both work in the
    # native terminal AND inside the ttyd iframe. (Reorganised
    # 2026-05-19 after the user reported Shift+Arrow never working.)
    tmux bind -n M-Left previous-window
    tmux bind -n M-Right next-window
    tmux bind -n M-h previous-window
    tmux bind -n M-l next-window
    tmux bind -n M-Up select-pane -U
    tmux bind -n M-Down select-pane -D
    tmux bind -n M-k select-pane -U
    tmux bind -n M-j select-pane -D
    # Ctrl+arrow as a third pane-nav alternative — terminals send these
    # as CSI sequences that the browser doesn't grab.
    tmux bind -n C-Left select-pane -L
    tmux bind -n C-Right select-pane -R
    tmux bind -n C-Up select-pane -U
    tmux bind -n C-Down select-pane -D

    # ── Scrollback nav without ceremony (2026-05-19) ──────────────────
    # Browser-embedded ttyd makes default tmux scrollback awkward:
    #   * mouse wheel often goes to xterm.js's outer buffer, not tmux's
    #     pane history; the data exists but is unreachable
    #   * the canonical "Ctrl-B [" then PageUp is two-step and assumes
    #     the operator knows tmux copy-mode
    # PageUp without prefix enters tmux copy-mode and scrolls one screen
    # back. Subsequent PageUp / PageDown / Up / Down (in copy-mode) walks
    # the history. Press q or Enter to exit back to live view.
    # Shift+PageUp = jump-to-top; Shift+PageDown = jump-to-bottom.
    tmux bind -n PageUp copy-mode -u
    tmux bind -n S-PageUp copy-mode \; send-keys -X history-top
    tmux bind -n S-PageDown send-keys -X history-bottom
    # Mouse wheel scrolling on a pane: enter copy-mode + scroll three
    # lines. Hovering scroll on a live pane no longer dumps the wheel
    # event into an inert xterm.js buffer; instead tmux owns it.
    tmux bind -n WheelUpPane if-shell -F -t = "#{pane_in_mode}" "send-keys -X -N 3 scroll-up" "copy-mode -e ; send-keys -X -N 3 scroll-up"
    tmux bind -n WheelDownPane if-shell -F -t = "#{pane_in_mode}" "send-keys -X -N 3 scroll-down" ""
    # Shift+arrows walk between WINDOWS (tabs) in order. Lets you flip
    # through open F-key panes without remembering which key opened which.
    # Shift+Right = next window, Shift+Left = previous window.
    tmux bind -n S-Right next-window
    tmux bind -n S-Left previous-window
    # Shift+Up/Down jump to the newest / oldest window.
    tmux bind -n S-Up select-window -t :+
    tmux bind -n S-Down select-window -t :-
    tmux bind -n M-Enter new-window
    tmux bind -n "M-\\" split-window -h -c "#{pane_current_path}"
    tmux bind -n M-- split-window -v -c "#{pane_current_path}"
    # Window close — Alt+q is the canonical "quit this window". Ctrl+q is
    # the home-row alias. We do NOT bind Alt+x / Alt+Shift+X to anything
    # because they collide with everyday apps: emacs Meta-x (execute-
    # extended-command — the central emacs interaction), readline Meta-x
    # (revert-line), vim's Esc/Alt+X workflows, etc. Operators close panes
    # via the toggle key that opened them (re-press Alt+E to close exec,
    # F11 to close tcplife, etc.) or via Alt+q for the whole window.
    # Single close-pane key (2026-05-19 consolidation): Ctrl+q kills the
    # current pane. If it's the only pane in the window (the common case
    # in kldload-console — most F-keys open single-pane windows), the
    # window closes too. Not using Ctrl+X because editors (nano, vim
    # in insert mode, emacs) bind Ctrl+X for save/cut. Not using Ctrl+W
    # because the browser eats it. Not using Alt+q either — used to also
    # be bound to kill-window, but having two close keys created confusion
    # ("did I just close the wrong thing?"). One key, one job.
    tmux unbind -n M-q 2>/dev/null || true
    tmux bind -n C-q kill-pane
    # Belt-and-suspenders: explicitly leave Ctrl+X untouched. Older
    # versions of this config tried to bind it; not anymore.
    tmux unbind -n C-x 2>/dev/null || true
    # Explicitly unbind Alt+x / Alt+Shift+X in EVERY key table that tmux
    # builds in by default. The root unbind covers normal-mode use, but
    # tmux also ships copy-mode + copy-mode-vi bindings (M-x →
    # jump-to-mark) that fire when the operator is inside a selection
    # and presses Alt+X, producing surprising cursor jumps that look
    # like an unwanted line selection. Unbinding everywhere = Alt+X
    # passes through to the PTY in every mode.
    for _tbl in root prefix copy-mode copy-mode-vi; do
        tmux unbind -T "$_tbl" M-x 2>/dev/null || true
        tmux unbind -T "$_tbl" M-X 2>/dev/null || true
    done
    # Pre-emptive: -n binds resolve to the root table; redundant with the
    # loop above but keeps the intent explicit.
    tmux unbind -n M-x 2>/dev/null || true
    tmux unbind -n M-X 2>/dev/null || true

    # ── bcc-tools "trace" group (Alt+letter) ─────────────────────────
    # Complements the bcc-tools on F11/F12 (network-focused). These
    # answer "what is the system actually DOING right now?" — every
    # exec/open/block-io event with the real command line. Toggle same
    # as the F-keys: press to open, press again to close.
    # Alt+e/o/b/k trace bindings removed 2026-05-19 — superseded by the
    # F4 eBPF syscall cockpit (execsnoop + opensnoop + killsnoop + more)
    # and F5 eBPF I/O cockpit (biosnoop + biolatency + tcplife + zfsdist).
    # The standalone single-window versions were redundant AND clashed
    # with Alt+k for pane-up navigation (Alt+k=killsnoop overrode the
    # pane-up bind earlier in this file). Pane nav now reliably uses
    # Alt+h / Alt+j / Alt+k / Alt+l for left / down / up / right.

    # ── Heads-up popups (Alt+letter) ─────────────────────────────────
    # Quick info overlays — tmux display-popup floats a window over the
    # current pane, runs the command, waits for Enter, then closes. No
    # window churn, no context switch: glance → dismiss. For "what's the
    # state of X right now" questions that don't deserve a full pane.
    tmux bind -n M-v display-popup -E -w 85% -h 80% "\
    echo '── VMs & network ──────────────────────────────────────'; \
    virsh list --all 2>/dev/null; echo; \
    echo '── DHCP leases (virbr0) ───────────────────────────────'; \
    virsh net-dhcp-leases default 2>/dev/null; echo; \
    echo '── Host interfaces ────────────────────────────────────'; \
    ip -br addr; echo; \
    echo '── Default gateway ────────────────────────────────────'; \
    ip route show default; echo; \
    read -r -p 'Enter to dismiss…' _"

    tmux bind -n M-z display-popup -E -w 85% -h 75% "\
    echo '── ZFS pools ──────────────────────────────────────────'; \
    zpool list; echo; \
    zpool status -x; echo; \
    echo '── Top datasets by USED ───────────────────────────────'; \
    zfs list -o name,used,avail,referenced,mountpoint -s used -S 2>/dev/null | head -20; \
    echo; \
    echo '── ARC stats ──────────────────────────────────────────'; \
    awk '/^size/ {printf \"size=%s\\n\",\$3}; /^c_max/ {printf \"max=%s\\n\",\$3}; /^hits/ {h=\$3}; /^misses/ {m=\$3} END {printf \"hits=%d misses=%d ratio=%.1f%%\\n\", h, m, 100*h/(h+m+1)}' /proc/spl/kstat/zfs/arcstats 2>/dev/null; \
    echo; \
    read -r -p 'Enter to dismiss…' _"

    tmux bind -n M-w display-popup -E -w 85% -h 65% "\
    echo '── WireGuard ──────────────────────────────────────────'; \
    wg show 2>/dev/null || echo '(no wireguard interfaces)'; echo; \
    echo '── IP interfaces ──────────────────────────────────────'; \
    ip -br addr; echo; \
    echo '── Routing table ──────────────────────────────────────'; \
    ip route; echo; \
    echo '── Active connections (established) ───────────────────'; \
    ss -tn state established 2>/dev/null | head -20; \
    read -r -p 'Enter to dismiss…' _"

    tmux bind -n M-d display-popup -E -w 85% -h 55% "\
    echo '── Disk usage ─────────────────────────────────────────'; \
    df -h -x tmpfs -x devtmpfs; echo; \
    echo '── Memory ─────────────────────────────────────────────'; \
    free -h; echo; \
    echo '── CPU ────────────────────────────────────────────────'; \
    nproc; lscpu | grep -E 'Model name|Socket|Core|Thread'; \
    read -r -p 'Enter to dismiss…' _"

    tmux bind -n M-u display-popup -E -w 85% -h 45% "\
    echo '── Uptime & load ──────────────────────────────────────'; \
    uptime; echo; \
    echo '── Logged-in users ────────────────────────────────────'; \
    w -h; echo; \
    echo '── Recent logins ──────────────────────────────────────'; \
    last -n 5 2>/dev/null | head -5; \
    read -r -p 'Enter to dismiss…' _"

    tmux bind -n M-c display-popup -E -w 90% -h 85% "\
    echo '── Cluster nodes ──────────────────────────────────────'; \
    kubectl get nodes -o wide 2>/dev/null; echo; \
    echo '── Pods not Running ───────────────────────────────────'; \
    kubectl get pods -A 2>/dev/null | awk 'NR==1 || \$4!=\"Running\"' | head -20; echo; \
    echo '── Recent events (warnings) ───────────────────────────'; \
    kubectl get events -A --field-selector type=Warning --sort-by=.lastTimestamp 2>/dev/null | tail -10; \
    read -r -p 'Enter to dismiss…' _"

    # ── Bandwidth top (pftop equivalents) ────────────────────────────
    # iftop is the closest Linux match for OpenBSD's pftop — top-like
    # view of connections sorted by bandwidth with per-direction bars.
    # nethogs shows the same data grouped by PROCESS — "who's eating
    # the pipe". Default interface is the default-route one.
    tmux bind -n M-p run-shell "_ktoggle-win iftop    'sudo iftop -i \$(ip route show default 2>/dev/null | awk \"/default/ {print \\\$5; exit}\") -N -n -P 2>/dev/null || sudo iftop -N -n -P 2>/dev/null || (echo need-iftop; sleep 99)'"
    tmux bind -n M-n run-shell "_ktoggle-win nethogs  'sudo nethogs 2>/dev/null || (echo need-nethogs; sleep 99)'"

    # ── Bob: AI ops chat in the cockpit (Alt+B) ──────────────────────
    # Drops into the `bob` CLI as a toggle-window — press once to open,
    # press again to close. Same pattern as F2 (k9s) and Alt+v (VMs).
    # Bob reads /etc/bob/personas.json + /usr/local/share/klab-bob/* and
    # talks to ollama on localhost:11434 (qwen3:14b on AI-enabled installs).
    # If ollama isn't up yet, `bob` prints a one-line "starting" status and
    # polls — no crash loop. This is the "integration with bob" the .140
    # workstation operator asked for: cockpit-level access to Bob next to
    # the kernel/cluster heads-up popups, not buried in a separate web tab.
    tmux bind -n M-b run-shell "_ktoggle-win bob      'bash -lc \"bob 2>&1 || (echo Bob needs ollama running; sleep 99)\"'"

    tmux set -g default-terminal "xterm-256color"
    tmux set -g mouse on

    # ── kldload theme + base behavior — sourced from /etc/skel/.tmux.conf ─
    # The skeleton tmux.conf carries the canonical kldload palette
    # (#34d399 emerald accent, #60a5fa accent2, #161b25 surface — same
    # colors the webui CSS uses) plus pane-nav / resize / window-switch
    # quality-of-life binds the user already knows from running tmux
    # outside the browser. Sourcing here keeps the theme single-source-
    # of-truth instead of duplicating hex codes in two places.
    #
    # Sourced BEFORE the kldload-console F-key / Alt-letter bindings so
    # any colliding `-n` bind (e.g. S-Left resize-pane vs S-Left
    # previous-window) gets overridden by ours below — kldload-console
    # binds are the application-specific layer that should win.
    for _cfg in /etc/skel/.tmux.conf "$HOME/.tmux.conf"; do
        [[ -r "$_cfg" ]] && tmux source-file "$_cfg" 2>/dev/null || true
    done
    # ── Re-bind nav keys AFTER sourcing skel (2026-05-19) ─────────────
    # Skel sources HERE, after our nav binds above, so its M-Left=pane
    # and S-Left=resize-pane assignments would otherwise win. Re-state
    # the kldload binds last so they stick. Shift+Arrow stays bound for
    # native-terminal users; in the ttyd iframe browsers eat it, which
    # is why Alt+arrow/Alt+hjkl exist alongside.
    tmux bind -n S-Right next-window
    tmux bind -n S-Left previous-window
    tmux bind -n S-Up select-window -t :+
    tmux bind -n S-Down select-window -t :-
    tmux bind -n M-Left previous-window
    tmux bind -n M-Right next-window
    tmux bind -n M-h previous-window
    tmux bind -n M-l next-window
    tmux bind -n M-Up select-pane -U
    tmux bind -n M-Down select-pane -D
    tmux bind -n M-k select-pane -U
    tmux bind -n M-j select-pane -D
    tmux set -g display-time 3000
    # ── Clipboard bridge (browser ⇄ tmux) ─────────────────────────────
    # set-clipboard on tells tmux to emit OSC 52 escapes when copying
    # from copy-mode; ttyd + xterm.js intercept OSC 52 and write to the
    # browser's clipboard. Without this, mouse-drag selections are lost
    # the moment you release the button.
    tmux set -g set-clipboard on
    # Make tmux advertise itself as OSC-52-capable so clients (xterm.js
    # inside ttyd) trust the sequence. xterm-256color sometimes trips up
    # the permission check; the `Ms` terminfo override makes it explicit.
    tmux set -ag terminal-overrides ',xterm*:Ms=\E]52;c;%p2%s\007'
    # vi keys in copy-mode (Prefix [ to enter, then v to start selection,
    # y to yank).
    tmux set -g mode-keys vi
    tmux bind-key -T copy-mode-vi v send-keys -X begin-selection

    # Mouse-drag copy: changed `copy-selection-and-cancel` → `copy-selection`
    # 2026-05-18. The -and-cancel variant exits copy-mode the moment the OSC
    # 52 escape goes out — but if Chrome silently drops the clipboard API
    # call (which it does on self-signed-cert origins), the user gets ZERO
    # feedback: the highlight vanishes, nothing lands on the system
    # clipboard, and there's no path to retry. `copy-selection` (no cancel)
    # keeps the highlight visible AND emits OSC 52 — if the clipboard write
    # silently fails, the user can at least right-click → Copy Selection
    # from the explicit tmux menu below.
    # Status-bar toast on drag-release shows a live snippet of what was
    # captured (first 80 chars + total length) so the operator has visible
    # confirmation even when xterm.js doesn't paint the selection highlight
    # for long (some redraw paths repaint the inverse-color cells). Toast
    # stays up for 3s — long enough to read, short enough not to pile up.
    tmux set -g display-time 3000
    tmux bind-key -T copy-mode-vi y send-keys -X copy-selection-no-clear \; display-message -d 3000 "✓ captured: #{=80:buffer_sample} (#{buffer_size}c)"
    tmux bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-selection-no-clear \; display-message -d 3000 "✓ captured: #{=80:buffer_sample} (#{buffer_size}c) — Pull selection / right-click Copy"
    # ALSO override the non-vi copy-mode table — entering copy-mode via
    # `copy-mode -M` (which is what MouseDrag1Pane in the root table calls)
    # uses whichever table tmux picks based on mode-keys. Even with
    # `mode-keys vi` set globally, the built-in `copy-mode` table still
    # carries `copy-pipe-and-cancel` and an unlucky path lands you there.
    # Override both tables so a mouse drag NEVER auto-cancels the highlight.
    tmux bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-selection-no-clear \; display-message -d 3000 "✓ captured: #{=80:buffer_sample} (#{buffer_size}c) — Pull selection / right-click Copy"
    tmux bind-key -T copy-mode y send-keys -X copy-selection-no-clear \; display-message -d 3000 "✓ captured: #{=80:buffer_sample} (#{buffer_size}c)"

    # Explicit copy keys for the cases where OSC 52 / Clipboard API silently
    # fail. `copy-pipe` to a literal echo writes the selection back into the
    # tmux buffer AND emits another OSC 52 (some browsers honour the second
    # one when the user's just pressed a key — explicit user gesture, no
    # auto-fire heuristic). Ctrl+Shift+C is the universal "copy" key.
    tmux bind-key -T copy-mode-vi C-c send-keys -X copy-selection-no-clear
    tmux bind-key -n C-S-c run-shell -b "tmux send-keys -t '#{pane_id}' -X copy-selection 2>/dev/null"

    # Paste: Ctrl+Shift+V at the browser level pastes the system
    # clipboard directly into the PTY. For tmux's own buffer, Prefix + ]
    # still works (Ctrl+B ]). No-prefix Alt+V pastes tmux buffer too.
    tmux bind-key -n M-V paste-buffer

    # Right-click menu — restored 2026-05-18. The original concern was
    # visual stacking with the browser's own right-click menu; tmux 3.2+
    # display-menu draws into the terminal grid which renders on TOP of
    # the browser's HTML context menu (the canvas paints over native UI),
    # so the tmux menu wins the visual layer. We don't try to silence the
    # browser menu — that's cross-iframe restricted and not worth the
    # complexity.
    #
    # The menu offers Copy Selection (writes to tmux paste-buffer AND
    # fires OSC 52 again on confirm — a fresh user gesture which the
    # Clipboard API tends to honour after copyOnSelect did not), Copy
    # Visible Lines (whole pane scrollback), and Paste.
    tmux bind-key -n MouseDown3Pane display-menu -T "#[fg=cyan]Copy / Paste" -x M -y M \
        "Copy Selection" c "send-keys -X copy-selection-no-clear-and-cancel" \
        "Copy Visible Lines" l "copy-mode \\; send-keys -X history-bottom \\; send-keys -X begin-selection \\; send-keys -X history-top \\; send-keys -X copy-selection-no-clear-and-cancel" \
        "" "" "" \
        "Paste" p "paste-buffer" \
        "Paste from Browser" b "send-keys 'Use Ctrl+Shift+V'" \
        "" "" "" \
        "Clear Selection" x "send-keys -X cancel"
    # Right-click on status line shows the same menu — saves the user from
    # having to aim at a pane edge.
    tmux bind-key -n MouseDown3Status display-menu -T "#[fg=cyan]Copy / Paste" -x M -y S \
        "Copy Selection" c "send-keys -X copy-selection-no-clear-and-cancel" \
        "Paste" p "paste-buffer"
fi
# Attach with transient-detect retry. Background: on firstboot the
# tmux server racing with kldload-tls-cert / webui restarts / port :7681
# contention sometimes makes `tmux attach-session` return clean (exit 0)
# in ~1.5s before any user could have detached. That clean exit propagated
# to ttyd-k9s which propagated to systemd, which burned the StartLimit
# budget (see ttyd-k9s.service header for the full trace).
#
# Heuristic: a real interactive detach is always >2s (Ctrl+B d takes at
# least one human second). If attach returns in <2s we know it's the
# transient — sleep + re-exec the script to re-bootstrap the session.
# Real detach (long-running attach) exits cleanly so ttyd treats it as
# normal browser disconnect.
while true; do
    _start_ts=$(date +%s%N)
    tmux attach-session -t $SESSION
    _rc=$?
    _elapsed_ms=$((($(date +%s%N) - _start_ts) / 1000000))
    if [ $_rc -eq 0 ] && [ $_elapsed_ms -lt 2000 ]; then
        # Transient: session got GC'd or server was busy. Wait for the
        # ambient firstboot churn to settle, then re-bootstrap by re-execing.
        sleep 2
        exec "$0" "$@"
    fi
    # Either a real detach (>2s) or attach explicitly failed (e.g. user
    # did kill-server). Exit so ttyd cleans up the PTY; systemd doesn't
    # restart us — ttyd handles the next browser connect.
    exit $_rc
done
