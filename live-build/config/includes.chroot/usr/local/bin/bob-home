#!/usr/bin/env bash
# bob-home — continuous voice + text loop
# Bob listens, routes to the right tool, speaks back.
#
# Routes automatically:
#   desktop requests → bob-desktop
#   system questions → bob (with context)
#   execution requests → bob-do
#   media requests → bob-agent
#
# Usage: bob-home              (text mode)
#        bob-home --voice      (voice input + TTS output)
set -euo pipefail

# ── Colors ───────────────────────────────────────────────────────────────────
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

VOICE_MODE=false
BOB_SPEAK="${BOB_SPEAK:-false}"

for arg in "$@"; do
    case "$arg" in
    --voice | -V)
        VOICE_MODE=true
        BOB_SPEAK=true
        ;;
    --speak) BOB_SPEAK=true ;;
    esac
done

# ── TTS helper ───────────────────────────────────────────────────────────────
speak() {
    [[ "$BOB_SPEAK" != "true" ]] && return
    local text="$1"
    # Try piper
    if [[ -x /opt/piper/piper ]]; then
        echo "$text" | /opt/piper/piper \
            --model /opt/piper/models/en_US-lessac-medium.onnx \
            --output_file /tmp/bob-speech.wav 2>/dev/null
        aplay -q /tmp/bob-speech.wav 2>/dev/null
        return
    fi
    # Fallback to espeak
    if command -v espeak-ng &>/dev/null; then
        espeak-ng -s 160 "$text" 2>/dev/null
        return
    fi
    if command -v espeak &>/dev/null; then
        espeak -s 160 "$text" 2>/dev/null
        return
    fi
}

# ── Voice input helper ───────────────────────────────────────────────────────
listen() {
    if [[ "$VOICE_MODE" != true ]]; then
        return 1
    fi
    if ! command -v arecord &>/dev/null; then
        echo -e "${YELLOW}arecord not found — voice input unavailable${NC}"
        return 1
    fi
    echo -e "${DIM}Listening... (speak now, press Ctrl+C to stop)${NC}"
    arecord -f S16_LE -r 16000 -c 1 -d 10 /tmp/bob-voice-input.wav 2>/dev/null

    # Transcribe with whisper
    if [[ -x /opt/whisper.cpp/build/bin/whisper-cli ]]; then
        _text=$(/opt/whisper.cpp/build/bin/whisper-cli \
            -m /opt/whisper.cpp/models/ggml-base.en.bin \
            -f /tmp/bob-voice-input.wav \
            --no-timestamps 2>/dev/null | grep -v '^\[' | grep -v '^$' | head -5)
        echo "$_text"
        return 0
    fi
    echo -e "${YELLOW}whisper not found — can't transcribe${NC}"
    return 1
}

# ── Route detection ──────────────────────────────────────────────────────────
# Returns: desktop, execute, media, agent, chat
detect_route() {
    local input=$(echo "$1" | tr '[:upper:]' '[:lower:]')

    # Desktop actions
    if echo "$input" | grep -qE 'open.*(terminal|browser|firefox|file|app|settings|editor)|screenshot|volume|mute|unmute|remind|notification|notify'; then
        echo "desktop"
        return
    fi

    # Execution requests
    if echo "$input" | grep -qE '^(install|setup|configure|create|make|build|deploy|start|stop|restart|enable|disable|remove|delete|update|upgrade)'; then
        echo "execute"
        return
    fi

    # Media requests
    if echo "$input" | grep -qE 'play|stream|music|movie|show|plex|jellyfin|media|song|video|pause|resume|next|previous'; then
        echo "media"
        return
    fi

    # Agent tasks (complex multi-step)
    if echo "$input" | grep -qE 'check.*(health|disk|service|system)|fix|diagnose|monitor|scan|find.*file|list.*process'; then
        echo "agent"
        return
    fi

    # Default: chat
    echo "chat"
}

# ── Main loop ────────────────────────────────────────────────────────────────
echo -e "${BOLD}BOB HOME${NC}"
echo -e "${DIM}Type or speak. Bob routes automatically.${NC}"
echo -e "${DIM}Commands: /voice (toggle voice), /speak (toggle TTS), /quit${NC}"
echo ""

speak "Bob here. What do you need?"
echo -e "${GREEN}Bob here. What do you need?${NC}"
echo ""

while true; do
    # Get input
    _input=""
    if [[ "$VOICE_MODE" == true ]]; then
        echo -e -n "${CYAN}[voice]${NC} Press Enter to speak (or type): "
        read -r _typed
        if [[ -z "$_typed" ]]; then
            _input=$(listen 2>/dev/null || true)
            [[ -z "$_input" ]] && continue
            echo -e "${DIM}You said: ${_input}${NC}"
        else
            _input="$_typed"
        fi
    else
        echo -e -n "${CYAN}bob> ${NC}"
        read -r _input
    fi

    [[ -z "$_input" ]] && continue

    # Commands
    case "$_input" in
    /quit | /exit | /q)
        echo -e "${DIM}Bob out.${NC}"
        exit 0
        ;;
    /voice)
        VOICE_MODE=$([[ "$VOICE_MODE" == true ]] && echo false || echo true)
        echo -e "${DIM}Voice mode: ${VOICE_MODE}${NC}"
        continue
        ;;
    /speak)
        BOB_SPEAK=$([[ "$BOB_SPEAK" == "true" ]] && echo false || echo true)
        echo -e "${DIM}TTS: ${BOB_SPEAK}${NC}"
        continue
        ;;
    /sys)
        bob-sys
        continue
        ;;
    /model)
        bob-model
        continue
        ;;
    /help)
        echo -e "${DIM}Routes:${NC}"
        echo -e "${DIM}  Desktop: 'open terminal', 'set volume', 'screenshot'${NC}"
        echo -e "${DIM}  Execute: 'install nginx', 'setup k3s'${NC}"
        echo -e "${DIM}  Media:   'play jazz', 'start plex'${NC}"
        echo -e "${DIM}  Agent:   'check disk health', 'find large files'${NC}"
        echo -e "${DIM}  Chat:    everything else${NC}"
        echo -e "${DIM}Commands: /voice /speak /sys /model /quit${NC}"
        continue
        ;;
    esac

    # Route
    _route=$(detect_route "$_input")
    echo -e "${DIM}[${_route}]${NC}"

    case "$_route" in
    desktop)
        bob-desktop "$_input" 2>&1
        speak "Done."
        ;;
    execute)
        bob-do "$_input" 2>&1
        speak "Task complete."
        ;;
    media)
        _response=$(bob-agent "$_input" 2>&1)
        echo "$_response"
        # Extract a summary to speak
        _summary=$(echo "$_response" | tail -3 | head -1)
        speak "$_summary"
        ;;
    agent)
        _response=$(bob-agent "$_input" 2>&1)
        echo "$_response"
        _summary=$(echo "$_response" | tail -3 | head -1)
        speak "$_summary"
        ;;
    chat)
        _response=$(bob "$_input" 2>&1)
        echo "$_response"
        # Speak first ~200 chars
        _spoken=$(echo "$_response" | head -5 | cut -c1-300)
        speak "$_spoken"
        ;;
    esac

    echo ""
done
