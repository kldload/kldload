#!/usr/bin/env bash
# kldload 1.0.3 — Superpower Demo for Screenshots
# 64GB RAM / 24 cores / RTX 3080

B="\033[1;34m"; G="\033[1;32m"; C="\033[1;36m"; Y="\033[1;33m"
R="\033[1;31m"; W="\033[1;37m"; D="\033[0;37m"; N="\033[0m"

header() {
  clear
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}   kldload 1.0.3 — KVM Hypervisor with OpenZFS Superpowers  ${N}"
  echo -e "${D}   OpenZFS + WireGuard + eBPF + NVIDIA RTX 3080             ${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
}

pause() { echo ""; echo -e "${D}Press Enter...${N}"; read -r; }

# ── GLOBAL CLEANUP ─────────────────────────────────────────
nuke_all() {
  echo -ne "${Y}Resetting demo environment...${N} "

  # Kill all demo containers
  for ctr in ollama-1 ollama-2 ollama-demo demo-nginx demo-redis demo-postgres gpu-bench; do
    podman rm -f -t 2 "$ctr" &>/dev/null || true
  done

  # Kill all demo VMs
  for vm in golden web-1 web-2 web-3 web-4 db-1 db-2; do
    virsh destroy "$vm" &>/dev/null || true
    virsh undefine "$vm" --nvram &>/dev/null || virsh undefine "$vm" &>/dev/null || true
  done

  # Nuke all demo zvols (force recursive to handle snapshots+clones)
  for ds in $(zfs list -H -o name -r rpool/vms -t all 2>/dev/null | grep -v isos | grep -v '^rpool/vms$' | tac); do
    zfs destroy -Rf "$ds" &>/dev/null || true
  done

  # Nuke container datasets
  zfs destroy -Rf rpool/srv/demo &>/dev/null || true

  # Clean NVRAM files
  rm -f /var/lib/libvirt/qemu/nvram/golden_VARS.fd &>/dev/null
  rm -f /var/lib/libvirt/qemu/nvram/web-*_VARS.fd &>/dev/null
  rm -f /var/lib/libvirt/qemu/nvram/db-*_VARS.fd &>/dev/null

  echo -e "${G}clean.${N}"
}

# ── SECTION CLEANUPS ───────────────────────────────────────
clean_vms() {
  echo -ne "${D}  Cleaning VMs...${N} "
  for vm in golden web-1 web-2 web-3 web-4 db-1 db-2; do
    virsh destroy "$vm" &>/dev/null || true
    virsh undefine "$vm" --nvram &>/dev/null || virsh undefine "$vm" &>/dev/null || true
  done
  for ds in $(zfs list -H -o name -r rpool/vms -t all 2>/dev/null | grep -v isos | grep -v '^rpool/vms$' | tac); do
    zfs destroy -Rf "$ds" &>/dev/null || true
  done
  rm -f /var/lib/libvirt/qemu/nvram/golden_VARS.fd /var/lib/libvirt/qemu/nvram/web-*_VARS.fd /var/lib/libvirt/qemu/nvram/db-*_VARS.fd &>/dev/null
  echo -e "${G}done${N}"
}

clean_gpu() {
  echo -ne "${D}  Cleaning GPU containers...${N} "
  for ctr in ollama-1 ollama-2 ollama-demo gpu-bench; do
    podman rm -f -t 2 "$ctr" &>/dev/null || true
  done
  # Kill anything on ollama ports
  fuser -k 11434/tcp &>/dev/null || true
  fuser -k 11435/tcp &>/dev/null || true
  echo -e "${G}done${N}"
}

clean_containers() {
  echo -ne "${D}  Cleaning demo containers...${N} "
  for ctr in demo-nginx demo-redis demo-postgres; do
    podman rm -f -t 2 "$ctr" &>/dev/null || true
  done
  zfs destroy -Rf rpool/srv/demo &>/dev/null || true
  echo -e "${G}done${N}"
}

# ── MENU ───────────────────────────────────────────────────
menu() {
  header
  echo -e "${Y}  VM MANAGEMENT${N}"
  echo -e "  ${G} 1${N}  Create golden + clone 4 VMs + start all (full demo)"
  echo -e "  ${G} 2${N}  List all VMs + ZFS usage"
  echo -e "  ${G} 3${N}  Snapshot all VMs"
  echo -e "  ${G} 4${N}  Rollback a VM"
  echo -e "  ${G} 5${N}  Destroy all VMs (clean)"
  echo ""
  echo -e "${Y}  GPU SHARING${N}"
  echo -e "  ${G} 6${N}  NVIDIA GPU status"
  echo -e "  ${G} 7${N}  Launch 2 Ollama AI instances on same GPU"
  echo -e "  ${G} 8${N}  Ask both AI models simultaneously"
  echo -e "  ${G} 9${N}  Show GPU sharing (all processes)"
  echo -e "  ${G}10${N}  Destroy GPU containers (clean)"
  echo ""
  echo -e "${Y}  CONTAINERS ON ZFS${N}"
  echo -e "  ${G}11${N}  Launch nginx + redis + postgres on ZFS datasets"
  echo -e "  ${G}12${N}  Snapshot the entire container stack"
  echo -e "  ${G}13${N}  Show container ZFS usage"
  echo -e "  ${G}14${N}  Destroy container stack (clean)"
  echo ""
  echo -e "${Y}  INFRASTRUCTURE${N}"
  echo -e "  ${G}15${N}  ZFS pool + all datasets"
  echo -e "  ${G}16${N}  WireGuard status"
  echo -e "  ${G}17${N}  eBPF — trace TCP connections (5s)"
  echo -e "  ${G}18${N}  eBPF — disk I/O latency (5s)"
  echo -e "  ${G}19${N}  System health (kst)"
  echo -e "  ${G}20${N}  Replication commands"
  echo ""
  echo -e "${Y}  GOLDEN IMAGE DEPLOY${N}"
  echo -e "  ${G}21${N}  Build golden image from cloud image"
  echo -e "  ${G}22${N}  Deploy 4 VMs with cloud-init (unique hostnames)"
  echo -e "  ${G}23${N}  Show deployed fleet"
  echo -e "  ${G}24${N}  Destroy fleet (clean)"
  echo ""
  echo -e "${Y}  SCREENSHOT${N}"
  echo -e "  ${G}99${N}  One-shot proof (clone + snapshot + proof in one screen)"
  echo ""
  echo -e "  ${R} 0${N}  NUKE EVERYTHING (full reset)"
  echo -e "  ${R} q${N}  Quit"
  echo ""
  echo -ne "${W}  Select: ${N}"
}

# ── MAIN LOOP ──────────────────────────────────────────────
while true; do
  menu
  read -r c
  case $c in

    # ── VM: full demo ──────────────────────────────────────
    1)
      header
      clean_vms
      echo ""
      echo -e "${Y}=== Step 1: Create Golden Image ===${N}"
      echo ""
      kvm-create golden --ram 2048 --cpus 1 --disk 10 --iso /var/lib/libvirt/isos/kldload-1.0.2-x86_64.iso --os centos-stream9
      sleep 1

      echo ""
      echo -e "${Y}=== Step 2: Clone 4 VMs ===${N}"
      echo ""
      for vm in web-1 web-2 web-3 db-1; do
        echo -ne "  kvm-clone golden $vm ... "
        S=$(date +%s%N)
        kvm-clone golden $vm >/dev/null 2>&1
        E=$(date +%s%N)
        echo -e "${G}done${N} (${C}$(( (E-S)/1000000 ))ms${N})"
      done

      echo ""
      echo -e "${Y}=== Step 3: Start All VMs ===${N}"
      echo ""
      for vm in golden web-1 web-2 web-3 db-1; do
        virsh start $vm &>/dev/null && echo -e "  ${G}$vm${N} started" || echo -e "  ${R}$vm${N} failed to start"
      done
      sleep 2

      echo ""
      echo -e "${Y}=== Result ===${N}"
      echo ""
      kvm-list

      echo ""
      echo -e "${Y}=== VNC Access ===${N}"
      for vm in golden web-1 web-2 web-3 db-1; do
        PORT=$(virsh vncdisplay $vm 2>/dev/null)
        if [[ -n "$PORT" ]]; then
          NUM=${PORT#:}
          REAL=$((5900 + NUM))
          echo -e "  ${C}$vm${N}  →  vnc://10.100.10.120:$REAL"
        fi
      done

      echo ""
      echo -e "${Y}=== ZFS Disk Cost ===${N}"
      echo ""
      echo -e "  ${W}VM              USED      PROVISIONED${N}"
      echo -e "  ──────────────  ────────  ───────────"
      for vm in golden web-1 web-2 web-3 db-1; do
        U=$(zfs list -H -o used rpool/vms/$vm 2>/dev/null)
        V=$(zfs list -H -o volsize rpool/vms/$vm 2>/dev/null)
        if [[ "$vm" == "golden" ]]; then
          echo -e "  ${C}$vm${N}          $U       $V  ${D}(source)${N}"
        else
          echo -e "  ${G}$vm${N}           $U        $V  ${G}← zero cost${N}"
        fi
      done
      echo ""
      VM_COUNT=$(virsh list --all --name 2>/dev/null | grep -c -v '^$')
      RUNNING=$(virsh list --name 2>/dev/null | grep -c -v '^$')
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      echo -e "${W}  PROOF: KVM + OpenZFS Instant Cloning${N}"
      echo -e "${C}──────────────────────────────────────────────────────────────${N}"
      echo -e "  VMs created:        ${G}${VM_COUNT}${N} (1 golden + 4 clones)"
      echo -e "  VMs running:        ${G}${RUNNING}${N}"
      echo -e "  Clone time:         ${G}<100ms each${N}"
      echo -e "  Provisioned:        50GB (5 x 10GB)"
      echo -e "  Actual disk used:   ${G}0 bytes${N} (copy-on-write)"
      echo -e "  Backing storage:    ${G}OpenZFS zvols${N}"
      echo -e "  Proxmox equivalent: ${R}~2 minutes + 40GB disk${N}"
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      pause ;;

    # ── VM: list ───────────────────────────────────────────
    2)
      header
      echo -e "${Y}=== VM Inventory ===${N}"
      echo ""
      kvm-list
      echo ""
      echo -e "${Y}=== ZFS Zvols ===${N}"
      echo ""
      zfs list -o name,used,refer,volsize -r rpool/vms -t volume 2>/dev/null || echo "No VMs"
      echo ""
      echo -e "${Y}=== Snapshots ===${N}"
      echo ""
      zfs list -t snapshot -r rpool/vms 2>/dev/null || echo "None"
      pause ;;

    # ── VM: snapshot all ───────────────────────────────────
    3)
      header
      echo -e "${Y}=== Snapshot All VMs ===${N}"
      echo ""
      for vm in $(zfs list -H -o name -t volume -r rpool/vms 2>/dev/null); do
        NAME=$(basename $vm)
        kvm-snap $NAME 2>/dev/null && echo -e "  ${G}$NAME${N} snapshotted" || echo -e "  ${D}$NAME skipped${N}"
      done
      echo ""
      echo -e "${Y}=== All Snapshots ===${N}"
      zfs list -t snapshot -r rpool/vms 2>/dev/null || echo "None"
      pause ;;

    # ── VM: rollback ───────────────────────────────────────
    4)
      header
      echo -e "${Y}=== Rollback ===${N}"
      echo ""
      zfs list -t snapshot -r rpool/vms 2>/dev/null || echo "No snapshots"
      echo ""
      echo -ne "${W}  VM name to rollback: ${N}"
      read -r RNAME
      if [[ -n "$RNAME" ]]; then
        kvm-snap "$RNAME" rollback
      fi
      pause ;;

    # ── VM: destroy ────────────────────────────────────────
    5)
      header
      clean_vms
      echo ""
      kvm-list
      pause ;;

    # ── GPU: status ────────────────────────────────────────
    6)
      header
      echo -e "${Y}=== NVIDIA RTX 3080 ===${N}"
      echo ""
      nvidia-smi
      pause ;;

    # ── GPU: launch 2 Ollama ───────────────────────────────
    7)
      header
      clean_gpu
      echo ""
      echo -e "${Y}=== Launching 2 AI Instances on 1 GPU ===${N}"
      echo ""

      echo -e "${D}Starting Ollama #1 on GPU (port 11434)...${N}"
      podman run -d --name ollama-1 \
        --device nvidia.com/gpu=all \
        -p 11434:11434 \
        docker.io/ollama/ollama >/dev/null 2>&1
      sleep 2

      echo -e "${D}Starting Ollama #2 on GPU (port 11435)...${N}"
      podman run -d --name ollama-2 \
        --device nvidia.com/gpu=all \
        -p 11435:11434 \
        docker.io/ollama/ollama >/dev/null 2>&1
      sleep 3

      # Verify both are running
      if ! podman ps --format '{{.Names}}' | grep -q ollama-1; then
        echo -e "${R}ollama-1 failed to start. Check: podman logs ollama-1${N}"
        pause
        continue
      fi
      if ! podman ps --format '{{.Names}}' | grep -q ollama-2; then
        echo -e "${R}ollama-2 failed to start. Check: podman logs ollama-2${N}"
        pause
        continue
      fi

      echo -e "${D}Pulling model on instance #1...${N}"
      podman exec ollama-1 ollama pull llama3.2:1b 2>&1 | tail -2
      echo -e "${D}Pulling model on instance #2...${N}"
      podman exec ollama-2 ollama pull llama3.2:1b 2>&1 | tail -2

      echo ""
      echo -e "${G}Two AI containers sharing one RTX 3080:${N}"
      podman ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" | grep ollama
      echo ""
      echo -e "${D}No PCIe passthrough. No vGPU license. CUDA time-slicing.${N}"
      pause ;;

    # ── GPU: ask both ──────────────────────────────────────
    8)
      header
      echo -e "${Y}=== Two AI Models, One GPU, Simultaneous ===${N}"
      echo ""

      if ! podman ps --format '{{.Names}}' | grep -q ollama-1; then
        echo -e "${R}Run option 7 first to start Ollama instances.${N}"
        pause
        continue
      fi

      echo -e "${C}Ollama #1:${N} What is OpenZFS in one sentence?"
      echo -e "${C}Ollama #2:${N} What is WireGuard in one sentence?"
      echo ""
      echo -e "${D}Asking both simultaneously...${N}"
      echo ""

      echo -e "${C}--- Ollama #1 ---${N}"
      podman exec ollama-1 ollama run llama3.2:1b "What is OpenZFS? One sentence only." &
      PID1=$!

      echo -e "${C}--- Ollama #2 ---${N}"
      podman exec ollama-2 ollama run llama3.2:1b "What is WireGuard? One sentence only." &
      PID2=$!

      wait $PID1 $PID2 2>/dev/null
      echo ""

      echo -e "${Y}GPU during inference:${N}"
      nvidia-smi --query-gpu=name,memory.used,memory.total,utilization.gpu --format=csv
      echo ""
      echo ""
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      echo -e "${W}  PROOF: GPU Sharing — No vGPU License Required${N}"
      echo -e "${C}──────────────────────────────────────────────────────────────${N}"
      echo -e "  GPU:                ${G}$(nvidia-smi --query-gpu=name --format=csv,noheader)${N}"
      echo -e "  VRAM:               $(nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader)"
      echo -e "  AI containers:      ${G}2${N} (ollama-1, ollama-2)"
      echo -e "  Running on:         ${G}same physical GPU${N}"
      echo -e "  Inference:          ${G}simultaneous${N}"
      echo -e "  vGPU license:       ${G}not required${N}"
      echo -e "  PCIe passthrough:   ${G}not required${N}"
      echo -e "  Method:             CUDA time-slicing (kernel-native)"
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      pause ;;

    # ── GPU: show sharing ──────────────────────────────────
    9)
      header
      echo -e "${Y}=== GPU Sharing — All Processes ===${N}"
      echo ""
      echo -e "${W}Containers with GPU:${N}"
      podman ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null
      echo ""
      echo -e "${W}NVIDIA GPU:${N}"
      nvidia-smi --query-gpu=name,memory.used,memory.total,utilization.gpu --format=csv
      echo ""
      echo -e "${W}GPU processes:${N}"
      nvidia-smi pmon -c 1 2>/dev/null || echo "No active GPU processes"
      pause ;;

    # ── GPU: destroy ───────────────────────────────────────
    10)
      header
      clean_gpu
      echo ""
      echo -e "${G}GPU containers removed.${N}"
      nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv
      pause ;;

    # ── Containers: launch stack ───────────────────────────
    11)
      header
      clean_containers
      echo ""
      echo -e "${Y}=== Container Stack on ZFS Datasets ===${N}"
      echo ""

      echo -e "${D}Creating ZFS datasets (per-service tuning)...${N}"
      zfs create -o mountpoint=/srv/demo -o compression=lz4 -o atime=off rpool/srv/demo 2>/dev/null || true
      zfs create -o mountpoint=/srv/demo/nginx -o compression=lz4 rpool/srv/demo/nginx 2>/dev/null || true
      zfs create -o mountpoint=/srv/demo/redis -o recordsize=16k -o compression=lz4 rpool/srv/demo/redis 2>/dev/null || true
      zfs create -o mountpoint=/srv/demo/postgres -o recordsize=8k -o compression=lz4 rpool/srv/demo/postgres 2>/dev/null || true

      echo ""
      echo -e "${G}ZFS datasets:${N}"
      zfs list -o name,mountpoint,recordsize,compression -r rpool/srv/demo
      echo ""

      echo -e "${D}Starting nginx...${N}"
      mkdir -p /srv/demo/nginx
      echo "<h1>Hello from kldload on OpenZFS</h1><p>nginx running on a ZFS dataset with lz4 compression</p>" > /srv/demo/nginx/index.html
      podman run -d --name demo-nginx -p 8080:80 \
        -v /srv/demo/nginx:/usr/share/nginx/html:Z \
        docker.io/nginx:alpine >/dev/null 2>&1

      echo -e "${D}Starting redis (recordsize=16k)...${N}"
      podman run -d --name demo-redis -p 6379:6379 \
        -v /srv/demo/redis:/data:Z \
        docker.io/redis:7-alpine >/dev/null 2>&1

      echo -e "${D}Starting postgres (recordsize=8k)...${N}"
      podman run -d --name demo-postgres -p 5432:5432 \
        -e POSTGRES_PASSWORD=demo \
        -v /srv/demo/postgres:/var/lib/postgresql/data:Z \
        docker.io/postgres:16-alpine >/dev/null 2>&1

      sleep 2
      echo ""
      echo -e "${G}Running containers:${N}"
      podman ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" | grep demo
      echo ""
      echo ""
      CTR_COUNT=$(podman ps --format '{{.Names}}' | grep -c demo)
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      echo -e "${W}  PROOF: Per-Service ZFS Datasets${N}"
      echo -e "${C}──────────────────────────────────────────────────────────────${N}"
      echo -e "  Containers running: ${G}${CTR_COUNT}${N} (nginx, redis, postgres)"
      echo -e "  ZFS datasets:       ${G}3${N} (one per service)"
      echo -e "  nginx recordsize:   128K (default, web content)"
      echo -e "  redis recordsize:   ${G}16K${N} (matches Redis page size)"
      echo -e "  postgres recordsize:${G}8K${N} (matches PG page size)"
      echo -e "  Compression:        lz4 on all"
      echo -e "  Snapshots:          ${G}independent per service${N}"
      echo -e "  On ext4:            ${R}one filesystem, one size, no snapshots${N}"
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      pause ;;

    # ── Containers: snapshot ───────────────────────────────
    12)
      header
      echo -e "${Y}=== Snapshot Container Stack ===${N}"
      echo ""
      if ! zfs list rpool/srv/demo >/dev/null 2>&1; then
        echo -e "${R}Run option 11 first.${N}"
      else
        SNAP="demo-$(date +%H%M%S)"
        zfs snapshot -r rpool/srv/demo@$SNAP
        echo -e "${G}Atomic recursive snapshot — all 3 services captured at the same instant:${N}"
        echo ""
        zfs list -t snapshot -r rpool/srv/demo
        SNAP_COUNT=$(zfs list -t snapshot -H -r rpool/srv/demo 2>/dev/null | wc -l)
        echo ""
        echo -e "${C}══════════════════════════════════════════════════════════════${N}"
        echo -e "${W}  PROOF: Atomic Multi-Service Snapshot${N}"
        echo -e "${C}──────────────────────────────────────────────────────────────${N}"
        echo -e "  Services captured:  ${G}3${N} (nginx + redis + postgres)"
        echo -e "  Snapshots created:  ${G}${SNAP_COUNT}${N} (recursive, one per dataset)"
        echo -e "  Consistency:        ${G}atomic${N} — all 3 at the exact same instant"
        echo -e "  Rollback command:   zfs rollback -r rpool/srv/demo@$SNAP"
        echo -e "  Rollback time:      ${G}<2 seconds${N}"
        echo -e "  Traditional backup: ${R}pg_dump + redis-cli SAVE + tar = minutes${N}"
        echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      fi
      pause ;;

    # ── Containers: ZFS usage ──────────────────────────────
    13)
      header
      echo -e "${Y}=== Container ZFS Usage ===${N}"
      echo ""
      zfs list -o name,used,avail,compressratio,recordsize -r rpool/srv/demo 2>/dev/null || echo "No container datasets. Run option 11."
      echo ""
      echo -e "${Y}=== Snapshots ===${N}"
      echo ""
      zfs list -t snapshot -r rpool/srv/demo 2>/dev/null || echo "None"
      pause ;;

    # ── Containers: destroy ────────────────────────────────
    14)
      header
      clean_containers
      echo ""
      echo -e "${G}Container stack destroyed. ZFS datasets removed. Space reclaimed.${N}"
      pause ;;

    # ── Infra: ZFS ─────────────────────────────────────────
    15)
      header
      echo -e "${Y}=== ZFS Pool ===${N}"
      echo ""
      zpool status -x
      zpool list
      echo ""
      echo -e "${Y}=== All Datasets ===${N}"
      echo ""
      zfs list -o name,used,avail,compressratio
      pause ;;

    # ── Infra: WireGuard ───────────────────────────────────
    16)
      header
      echo -e "${Y}=== WireGuard ===${N}"
      echo ""
      if ip link show wg0 >/dev/null 2>&1; then
        wg show
      else
        echo "WireGuard installed. No tunnels configured."
        wg --version
        echo ""
        echo -e "${D}To configure: edit /etc/wireguard/wg0.conf${N}"
        echo -e "${D}To start:     systemctl enable --now wg-quick@wg0${N}"
      fi
      pause ;;

    # ── Infra: eBPF TCP ────────────────────────────────────
    17)
      header
      echo -e "${Y}=== eBPF — Live TCP Connections (5s) ===${N}"
      echo -e "${D}Tracing kernel — every outbound TCP connection with PID...${N}"
      echo ""
      timeout 5 /usr/share/bcc/tools/tcpconnect 2>/dev/null || echo "Generate traffic (curl, etc.) to see connections"
      echo ""
      echo ""
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      echo -e "${W}  PROOF: eBPF Kernel Observability${N}"
      echo -e "${C}──────────────────────────────────────────────────────────────${N}"
      echo -e "  Tool:               /usr/share/bcc/tools/tcpconnect"
      echo -e "  Runs in:            ${G}kernel space${N} (not userland)"
      echo -e "  Overhead:           ${G}near zero${N}"
      echo -e "  Agents required:    ${G}none${N}"
      echo -e "  Log parsing:        ${G}none${N} — kernel reports directly"
      echo -e "  Pre-installed:      ${G}yes${N} (bcc-tools + bpftrace)"
      echo -e "  Traditional:        ${R}tcpdump + grep + hope${N}"
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      pause ;;

    # ── Infra: eBPF I/O ───────────────────────────────────
    18)
      header
      echo -e "${Y}=== eBPF — Disk I/O Latency (5s) ===${N}"
      echo -e "${D}Measuring every disk operation in the kernel...${N}"
      echo ""
      timeout 5 /usr/share/bcc/tools/biolatency 2>/dev/null || echo "biolatency not available"
      echo ""
      echo -e "${G}I/O latency histogram. Kernel-native. Zero overhead.${N}"
      pause ;;

    # ── Infra: kst ─────────────────────────────────────────
    19)
      header
      echo -e "${Y}=== System Health ===${N}"
      echo ""
      kst 2>/dev/null || echo "kst not available"
      pause ;;

    # ── Infra: replication ─────────────────────────────────
    20)
      header
      echo -e "${Y}=== Replication Commands ===${N}"
      echo ""
      echo "Replicate one VM to DR host:"
      echo -e "  ${C}kvm-replicate rpool/vms/golden dr-host${N}"
      echo ""
      echo "Replicate all VMs:"
      echo -e "  ${C}syncoid --recursive rpool/vms root@dr-host:rpool/vms${N}"
      echo ""
      echo "How it works:"
      echo "  First run:  full send (entire zvol)"
      echo "  After:      incremental — only changed blocks"
      echo "  20GB VM, 50MB changed = sends 50MB"
      echo ""
      echo "Failover on DR host:"
      echo "  Data already there from replication."
      echo -e "  ${C}virsh define golden.xml && virsh start golden${N}"
      echo "  Boot time: seconds. RPO: your replication interval."
      pause ;;

    # ── NUKE ───────────────────────────────────────────────
    0)
      header
      nuke_all
      echo ""
      echo -e "${G}Everything destroyed. Clean slate.${N}"
      echo ""
      kvm-list
      echo ""
      zfs list -r rpool/vms
      pause ;;

    # ── Golden Image: build ──────────────────────────────────
    21)
      header
      echo -e "${Y}=== Build Golden Image from CentOS Cloud Image ===${N}"
      echo ""

      # Clean previous
      for vm in golden-cloud node-1 node-2 node-3 node-4; do
        virsh destroy "$vm" &>/dev/null || true
        virsh undefine "$vm" --nvram &>/dev/null || virsh undefine "$vm" &>/dev/null || true
        zfs destroy -Rf "rpool/vms/$vm" &>/dev/null || true
        rm -f "/var/lib/libvirt/qemu/nvram/${vm}_VARS.fd" &>/dev/null
      done

      CLOUD_IMG="/var/lib/libvirt/isos/CentOS-Stream-9-GenericCloud.qcow2"
      if [[ ! -f "$CLOUD_IMG" ]]; then
        echo -e "${R}Cloud image not found. Downloading...${N}"
        curl -L -o "$CLOUD_IMG" \
          https://cloud.centos.org/centos/9-stream/x86_64/images/CentOS-Stream-GenericCloud-9-latest.x86_64.qcow2 2>&1 | tail -3
      fi

      echo -e "${D}Creating 10GB ZFS zvol for golden image...${N}"
      zfs create -V 10G -s -o compression=off -o volblocksize=64K rpool/vms/golden-cloud

      echo -e "${D}Writing cloud image to ZFS zvol...${N}"
      qemu-img convert -f qcow2 -O raw "$CLOUD_IMG" /dev/zvol/rpool/vms/golden-cloud 2>&1

      echo -e "${D}Resizing filesystem to fill zvol...${N}"
      # The qcow2 is smaller than 10GB — resize the partition
      growpart /dev/zvol/rpool/vms/golden-cloud 1 &>/dev/null || true

      echo ""
      echo -e "${G}Golden image ready on ZFS zvol:${N}"
      zfs list -o name,used,volsize rpool/vms/golden-cloud
      echo ""
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      echo -e "${W}  PROOF: Cloud Image on ZFS Zvol${N}"
      echo -e "${C}──────────────────────────────────────────────────────────────${N}"
      echo -e "  Source:       CentOS Stream 9 GenericCloud"
      echo -e "  Stored on:    ${G}ZFS zvol${N} (thin provisioned)"
      USED=$(zfs list -H -o used rpool/vms/golden-cloud)
      echo -e "  Disk used:    ${G}${USED}${N} (vs 10GB provisioned)"
      echo -e "  Ready to:     clone instantly, cloud-init each clone"
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      pause ;;

    # ── Golden Image: deploy fleet ─────────────────────────
    22)
      header
      echo -e "${Y}=== Deploy 4 Nodes from Golden Image ===${N}"
      echo ""

      if ! zfs list rpool/vms/golden-cloud >/dev/null 2>&1; then
        echo -e "${R}Run option 21 first to build the golden image.${N}"
        pause
        continue
      fi

      # Clean previous nodes
      for vm in node-1 node-2 node-3 node-4; do
        virsh destroy "$vm" &>/dev/null || true
        virsh undefine "$vm" --nvram &>/dev/null || virsh undefine "$vm" &>/dev/null || true
        zfs destroy -Rf "rpool/vms/$vm" &>/dev/null || true
      done

      echo -e "${Y}Step 1: Clone golden image x4${N}"
      echo ""
      for i in 1 2 3 4; do
        echo -ne "  Cloning golden-cloud → node-$i ... "
        S=$(date +%s%N)
        zfs snapshot "rpool/vms/golden-cloud@clone-node${i}-$(date +%s%N)" &>/dev/null
        SNAP=$(zfs list -t snapshot -H -o name rpool/vms/golden-cloud 2>/dev/null | tail -1)
        zfs clone "$SNAP" "rpool/vms/node-$i"
        E=$(date +%s%N)
        echo -e "${G}done${N} (${C}$(( (E-S)/1000000 ))ms${N})"
      done

      echo ""
      echo -e "${Y}Step 2: Create cloud-init configs (unique per node)${N}"
      echo ""
      for i in 1 2 3 4; do
        CIDIR="/tmp/cloud-init-node-$i"
        mkdir -p "$CIDIR"

        cat > "$CIDIR/meta-data" << METAEOF
instance-id: node-$i
local-hostname: node-$i
METAEOF

        cat > "$CIDIR/user-data" << USEREOF
#cloud-config
hostname: node-$i
fqdn: node-$i.kldload.local
manage_etc_hosts: true
users:
  - name: admin
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: kldload
    ssh_authorized_keys:
      - $(cat /root/.ssh/id_rsa.pub 2>/dev/null || echo "ssh-rsa DEMO-KEY")
runcmd:
  - echo "node-$i deployed by kldload golden image workflow" > /etc/motd
USEREOF

        # Create cloud-init seed ISO
        genisoimage -output "/tmp/cloud-init-node-$i.iso" -V cidata -r -J \
          "$CIDIR/meta-data" "$CIDIR/user-data" &>/dev/null 2>&1 || \
        mkisofs -output "/tmp/cloud-init-node-$i.iso" -V cidata -r -J \
          "$CIDIR/meta-data" "$CIDIR/user-data" &>/dev/null 2>&1 || \
        xorrisofs -output "/tmp/cloud-init-node-$i.iso" -V cidata -r -J \
          "$CIDIR/meta-data" "$CIDIR/user-data" &>/dev/null 2>&1

        echo -e "  ${G}node-$i${N}: hostname=node-$i password=kldload"
      done

      echo ""
      echo -e "${Y}Step 3: Define and start VMs${N}"
      echo ""
      for i in 1 2 3 4; do
        virt-install \
          --name "node-$i" \
          --ram 1024 --vcpus 1 \
          --disk "source.dev=/dev/zvol/rpool/vms/node-$i,type=block,bus=virtio,cache=none" \
          --disk "/tmp/cloud-init-node-$i.iso,device=cdrom" \
          --os-variant centos-stream9 \
          --network bridge=br0 \
          --graphics vnc,listen=0.0.0.0 \
          --boot hd \
          --noautoconsole \
          --import &>/dev/null && \
        echo -e "  ${G}node-$i${N} started" || \
        echo -e "  ${R}node-$i${N} failed"
      done

      sleep 3
      echo ""
      echo -e "${Y}=== Fleet Deployed ===${N}"
      echo ""

      kvm-list 2>/dev/null || true

      echo ""
      echo -e "${Y}=== VNC Access ===${N}"
      for i in 1 2 3 4; do
        PORT=$(virsh vncdisplay "node-$i" 2>/dev/null)
        if [[ -n "$PORT" ]]; then
          NUM=${PORT#:}
          REAL=$((5900 + NUM))
          echo -e "  ${C}node-$i${N}  →  vnc://10.100.10.120:$REAL"
        fi
      done

      echo ""
      echo -e "${Y}=== ZFS Clone Cost ===${N}"
      echo ""
      echo -e "  ${W}NODE        USED      PROVISIONED${N}"
      echo -e "  ──────────  ────────  ───────────"
      GOLDEN_USED=$(zfs list -H -o used rpool/vms/golden-cloud 2>/dev/null)
      echo -e "  ${C}golden${N}      $GOLDEN_USED     10G  ${D}(source image)${N}"
      for i in 1 2 3 4; do
        U=$(zfs list -H -o used "rpool/vms/node-$i" 2>/dev/null)
        echo -e "  ${G}node-$i${N}      $U        10G  ${G}← zero cost clone${N}"
      done

      echo ""
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      echo -e "${W}  PROOF: Golden Image → Fleet Deployment${N}"
      echo -e "${C}──────────────────────────────────────────────────────────────${N}"
      echo -e "  Golden image:       CentOS Stream 9 (cloud image on ZFS zvol)"
      echo -e "  Nodes deployed:     ${G}4${N}"
      echo -e "  Clone time:         ${G}<150ms each${N}"
      echo -e "  Cloud-init:         ${G}unique hostname, password, SSH key per node${N}"
      echo -e "  Disk per clone:     ${G}0 bytes${N} (copy-on-write)"
      echo -e "  Total provisioned:  50GB (1 golden + 4 nodes x 10GB)"
      echo -e "  Total actual disk:  ${G}~${GOLDEN_USED}${N} (just the golden image)"
      echo -e "  Traditional deploy: ${R}4 installs x 20min = 80 minutes + 40GB${N}"
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      pause ;;

    # ── Golden Image: show fleet ───────────────────────────
    23)
      header
      echo -e "${Y}=== Deployed Fleet ===${N}"
      echo ""
      kvm-list 2>/dev/null || true
      echo ""
      echo -e "${Y}=== ZFS Zvols ===${N}"
      echo ""
      zfs list -o name,used,refer,volsize -r rpool/vms -t volume 2>/dev/null || echo "No VMs"
      echo ""
      echo -e "${Y}=== VNC Access ===${N}"
      for vm in golden-cloud node-1 node-2 node-3 node-4; do
        PORT=$(virsh vncdisplay "$vm" 2>/dev/null)
        if [[ -n "$PORT" ]]; then
          NUM=${PORT#:}
          REAL=$((5900 + NUM))
          echo -e "  ${C}$vm${N}  →  vnc://10.100.10.120:$REAL"
        fi
      done
      echo ""
      echo -e "${Y}=== Cloud-init Status (SSH to verify) ===${N}"
      echo ""
      for i in 1 2 3 4; do
        IP=$(virsh domifaddr "node-$i" 2>/dev/null | grep ipv4 | awk '{print $4}' | cut -d/ -f1)
        if [[ -n "$IP" ]]; then
          echo -e "  ${G}node-$i${N}  →  ssh admin@$IP  (password: kldload)"
        else
          echo -e "  ${D}node-$i${N}  →  waiting for DHCP..."
        fi
      done
      pause ;;

    # ── Golden Image: destroy ──────────────────────────────
    24)
      header
      echo -ne "${D}  Destroying fleet...${N} "
      for vm in golden-cloud node-1 node-2 node-3 node-4; do
        virsh destroy "$vm" &>/dev/null || true
        virsh undefine "$vm" --nvram &>/dev/null || virsh undefine "$vm" &>/dev/null || true
        zfs destroy -Rf "rpool/vms/$vm" &>/dev/null || true
        rm -f "/var/lib/libvirt/qemu/nvram/${vm}_VARS.fd" &>/dev/null
      done
      rm -f /tmp/cloud-init-node-*.iso &>/dev/null
      rm -rf /tmp/cloud-init-node-* &>/dev/null
      echo -e "${G}done${N}"
      echo ""
      echo -e "${G}Fleet destroyed. Golden image removed. Space reclaimed.${N}"
      pause ;;

    # ── SCREENSHOT: one-shot proof ─────────────────────────
    99)
      clear
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      echo -e "${W}   kldloadOS 1.0.3 — ZFS KVM Hypervisor Proof              ${N}"
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      echo ""

      # Clean
      for vm in proof-golden proof-1 proof-2 proof-3 proof-4; do
        virsh destroy "$vm" &>/dev/null || true
        virsh undefine "$vm" --nvram &>/dev/null || virsh undefine "$vm" &>/dev/null || true
      done
      for ds in $(zfs list -H -o name -r rpool/vms -t all 2>/dev/null | grep proof | tac); do
        zfs destroy -Rf "$ds" &>/dev/null || true
      done

      # Create golden zvol
      echo -e "${Y}[1] Create golden image (10GB thin-provisioned ZFS zvol)${N}"
      zfs create -V 10G -s -o compression=off -o volblocksize=64K rpool/vms/proof-golden 2>/dev/null
      echo -e "    ${G}✓${N} rpool/vms/proof-golden created"
      echo ""

      # Clone 4 VMs with timing
      echo -e "${Y}[2] Clone 4 VMs from golden image${N}"
      TOTAL_MS=0
      for i in 1 2 3 4; do
        S=$(date +%s%N)
        zfs snapshot "rpool/vms/proof-golden@clone-$i"
        zfs clone "rpool/vms/proof-golden@clone-$i" "rpool/vms/proof-$i"
        E=$(date +%s%N)
        MS=$(( (E-S)/1000000 ))
        TOTAL_MS=$((TOTAL_MS + MS))
        echo -e "    ${G}✓${N} proof-$i cloned in ${C}${MS}ms${N}"
      done
      echo -e "    Total: ${C}${TOTAL_MS}ms${N} for 4 clones"
      echo ""

      # Snapshot all
      echo -e "${Y}[3] Snapshot all 5 VMs atomically${N}"
      SNAP_TS=$(date -u +%Y%m%dT%H%M%SZ)
      for vm in proof-golden proof-1 proof-2 proof-3 proof-4; do
        zfs snapshot "rpool/vms/${vm}@snap-${SNAP_TS}" 2>/dev/null
      done
      SNAP_COUNT=$(zfs list -t snapshot -H -r rpool/vms 2>/dev/null | grep proof | grep "snap-" | wc -l)
      echo -e "    ${G}✓${N} ${SNAP_COUNT} snapshots created"
      echo ""

      # Proof table
      echo -e "${Y}[4] Proof — ZFS disk usage${N}"
      echo ""
      echo -e "    ${W}VM              USED       PROVISIONED  SNAPSHOTS${N}"
      echo -e "    ──────────────  ─────────  ───────────  ─────────"
      for vm in proof-golden proof-1 proof-2 proof-3 proof-4; do
        U=$(zfs list -H -o used "rpool/vms/$vm" 2>/dev/null)
        V=$(zfs list -H -o volsize "rpool/vms/$vm" 2>/dev/null)
        SC=$(zfs list -t snapshot -H "rpool/vms/$vm" 2>/dev/null | wc -l)
        if [[ "$vm" == "proof-golden" ]]; then
          printf "    ${C}%-16s${N} %-10s %-12s %s ${D}(source)${N}\n" "$vm" "$U" "$V" "$SC"
        else
          printf "    ${G}%-16s${N} %-10s %-12s %s ${G}← zero cost clone${N}\n" "$vm" "$U" "$V" "$SC"
        fi
      done

      echo ""
      TOTAL_SNAP=$(zfs list -t snapshot -H -r rpool/vms 2>/dev/null | grep proof | wc -l)
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      echo -e "${W}  PROOF: OpenZFS + KVM = Instant Infrastructure            ${N}"
      echo -e "${C}──────────────────────────────────────────────────────────────${N}"
      echo -e "  VMs cloned:         ${G}4${N} from 1 golden image"
      echo -e "  Total clone time:   ${G}${TOTAL_MS}ms${N}"
      echo -e "  Disk per clone:     ${G}0 bytes${N} (copy-on-write)"
      echo -e "  Snapshots:          ${G}${TOTAL_SNAP}${N} (atomic, block-level)"
      echo -e "  Rollback:           ${G}instant${N} (any snapshot, any time)"
      echo -e "  Replication:        ${G}incremental${N} (only changed blocks)"
      echo -e "  Provisioned:        50GB across 5 VMs"
      echo -e "  Actual disk:        ${G}~0 bytes${N} (only golden image data)"
      echo -e "  GPU:                ${G}$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null || echo 'N/A')${N}"
      echo -e "  eBPF:               ${G}$(bpftool version 2>/dev/null | head -1 || echo 'N/A')${N}"
      echo -e "  WireGuard:          ${G}$(wg --version 2>/dev/null || echo 'installed')${N}"
      echo -e "  ZFS:                ${G}$(zfs version 2>/dev/null | head -1)${N}"
      echo -e "  Kernel:             $(uname -r)"
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"
      echo -e "${D}  kldload.com — your platform, your way, anywhere, free     ${N}"
      echo -e "${C}══════════════════════════════════════════════════════════════${N}"

      # Cleanup
      for ds in $(zfs list -H -o name -r rpool/vms -t all 2>/dev/null | grep proof | tac); do
        zfs destroy -Rf "$ds" &>/dev/null || true
      done
      pause ;;

    q|Q) echo ""; exit 0 ;;
    *) ;;
  esac
done
