#!/usr/bin/env bash
# Toggle the kldload "kernel-tcp" cockpit (F12). Opens TWO full-pane
# tmux windows side-by-side in the window list, both togglable as a
# pair:
#
#   1. kernel-tcp -- ss -tnHpi state established | ktcp-format.awk
#      Every ESTABLISHED TCP socket with full TCP_INFO (RTT,
#      retransmits, cwnd, bytes), sorted by current rate, colour-
#      coded by health, with per-process roll-up and rate sparkline.
#
#   2. nethogs    -- sudo nethogs
#      Per-process bandwidth live (bytes/sec).
#
# Build #50 rewrite (was: single window with a split-pane top/bottom):
#   - Split-pane render left the top half blank until the operator
#     nudged the mouse / got a redraw signal. Separating into two
#     windows sidesteps that entirely -- each window renders
#     independently when activated.
#   - 4-level-nested shell quoting (`bash -c "watch -n 2 -c \"printf
#     '\\\\033...'\""`) leaked literal `\\033[1;36m` sequences into
#     the pane on RHEL 10. Watch loops now live in tempfiles -- one
#     level of bash invocation, no escape gymnastics.
#
# Operator switches between the two with C-b 0..9 or C-b w. F12 again
# closes both as a pair.
set -u
SESSION="${KLDLOAD_TMUX_SESSION:-kldload}"
KTCP_NAME="kernel-tcp"
NHOG_NAME="nethogs"

# Toggle: if EITHER window exists, kill BOTH and exit.
_have_window() {
    tmux list-windows -t "$SESSION" -F '#W' 2>/dev/null | grep -qx "$1"
}
if _have_window "$KTCP_NAME" || _have_window "$NHOG_NAME"; then
    _have_window "$KTCP_NAME" && tmux kill-window -t "${SESSION}:=${KTCP_NAME}"
    _have_window "$NHOG_NAME" && tmux kill-window -t "${SESSION}:=${NHOG_NAME}"
    exit 0
fi

# Sanity: the awk formatter MUST be on disk. Without this check the
# kernel-tcp pane would restart-loop printing "awk: cannot open source
# file". Better to fail loud with a useful message.
AWK_FMT=/usr/local/share/kldload/ktcp-format.awk
if [[ ! -r "$AWK_FMT" ]]; then
    tmux new-window -t "$SESSION" -n "$KTCP_NAME" -d \
        "bash -c 'echo \"ERROR: $AWK_FMT not found.\"; \
                  echo \"  F12 kernel-tcp cockpit needs this file.\"; \
                  echo \"  Re-run installer or copy from live ISO.\"; \
                  echo; echo \"Press any key to close...\"; read -n1'"
    tmux select-window -t "${SESSION}:=${KTCP_NAME}"
    exit 0
fi

# ── kernel-tcp watch loop (tempfile, not nested-quoted heredoc) ───
KTCP_SCRIPT=/run/kldload-ktcp.sh
cat > "$KTCP_SCRIPT" <<'KTCP'
#!/usr/bin/env bash
# Inner runner for F12 kernel-tcp window. Restart loop -- watch can
# exit on terminal resize, ss can fail transiently during a netns
# flap, awk can choke on a wonky ss line. Print exit reason, sleep,
# retry. Operator sees a brief banner instead of a dead pane.
SS_CMD='ss -tnHpi state established'
AWK_FMT=/usr/local/share/kldload/ktcp-format.awk
while :; do
    watch -n 2 -c "
        printf '\033[1;36m\$ %s | awk -f %s\033[0m\n' '$SS_CMD' '$AWK_FMT'
        printf '\033[2;37mi  every TCP socket - sorted by rate, RTT/retrans colour-coded\033[0m\n\n'
        $SS_CMD 2>&1 | awk -f '$AWK_FMT'
    "
    printf '\n[ss/awk watch exited (rc=%d) - restarting in 3s. Ctrl-C aborts.]\n' "$?"
    sleep 3
done
KTCP
chmod +x "$KTCP_SCRIPT"

# ── nethogs restart loop (also tempfile for consistency) ──────────
NHOG_SCRIPT=/run/kldload-nethogs.sh
cat > "$NHOG_SCRIPT" <<'NHOG'
#!/usr/bin/env bash
# Inner runner for F12 nethogs window. Restart loop -- nethogs exits
# when an interface vanishes, when sudo TTY heuristics trip, etc.
while :; do
    printf '\033[1;36m$ sudo nethogs\033[0m\n'
    printf '\033[2;37mi  per-process bandwidth - bytes/sec live\033[0m\n\n'
    if command -v nethogs >/dev/null 2>&1; then
        sudo nethogs
    else
        echo '[nethogs not installed -- dnf install nethogs (RHEL/EPEL) or apt install nethogs]'
        sleep 60
    fi
    printf '\n[nethogs exited (rc=%d) - restarting in 3s. Ctrl-C aborts.]\n' "$?"
    sleep 3
done
NHOG
chmod +x "$NHOG_SCRIPT"

# Open both windows. -d = don't auto-switch (we explicitly select the
# kernel-tcp one at the end so the operator lands on the TCP view).
tmux new-window -t "$SESSION" -n "$KTCP_NAME" -d "bash '$KTCP_SCRIPT'"
tmux new-window -t "$SESSION" -n "$NHOG_NAME" -d "bash '$NHOG_SCRIPT'"
tmux select-window -t "${SESSION}:=${KTCP_NAME}"
