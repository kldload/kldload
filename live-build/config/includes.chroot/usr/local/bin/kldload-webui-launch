#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# kldload-webui-launch — wait for the local webui, then open it in Chrome
#
# WHAT IT DOES:
#   1. Poll https://localhost:8443/ for up to ~60s until the SPA backend answers
#      (it comes up shortly after login via kldload-webui.service / nginx).
#   2. Hand off to kldload-chrome-app, which opens the UI as a standalone Chrome
#      app window (the kldload default browser, with Web Speech API for Bob).
#
# WHY A SCRIPT (not an inline Exec=):
#   The autostart .desktop used to carry the whole `bash -c 'for ...; curl ...'`
#   pipeline inline. That is invalid per the Desktop Entry spec (reserved chars
#   $ ( ) ; & > ' in Exec) and trips desktop-file-validate. Factoring it into a
#   script keeps the .desktop a single clean Exec= and is the documented fix.
#
# USAGE:  kldload-webui-launch            (invoked from kldload-webui autostart)
# EXIT:   execs Chrome; the poll never hard-fails — if the backend never answers
#         it still opens the window so the operator sees the connection error in
#         the UI rather than a silent no-show.
# SEE ALSO: kldload-chrome-app, kldload-webui.service.
# ─────────────────────────────────────────────────────────────────────────────
set -Eeuo pipefail

# ── Open once after an install, then stop autostarting ───────────────────────
#
# The console is a tool you reach for (win+A), not something that should fling
# a window open at every login for the rest of the machine's life. It IS worth
# opening automatically on the first boots after an install, while the operator
# is still watching the machine build itself — that is when they want to see it.
#
# So: once the build has finished (all-ready) AND this has already opened once,
# retire the autostart. Both conditions matter. Retiring on all-ready alone
# would mean a machine that finished building overnight never shows the console
# at all; retiring on first-run alone would kill it while the build is still
# going, which is exactly when it is useful.
#
# HISTORY: operator request, twice, 2026-08-13 — "I don't want it appearing
# every time the computer reboots". An earlier removal exists in
# kldload-firstboot but is buried inside arm_vm_restore() and did not run;
# self-retirement here does not depend on that plumbing, on ROLE being
# resolved correctly, or on the installer having taken the desktop branch.
#
# Removes the SYSTEM entry when writable, otherwise masks it with a per-user
# override — an autostart entry is disabled by a same-named file carrying
# Hidden=true in ~/.config/autostart.
_retire_autostart() {
    local sys=/etc/xdg/autostart/kldload-webui.desktop
    local usr="${HOME}/.config/autostart/kldload-webui.desktop"
    [[ -f /var/lib/kldload/all-ready ]] || return 0
    [[ -f "${HOME}/.local/state/kldload/webui-opened" ]] || return 0
    if [[ -w /etc/xdg/autostart ]] && rm -f "$sys" 2>/dev/null; then
        return 0
    fi
    mkdir -p "$(dirname "$usr")" 2>/dev/null || return 0
    printf '[Desktop Entry]\nType=Application\nName=kldload Web UI\nHidden=true\n' >"$usr" 2>/dev/null || true
}
_retire_autostart
mkdir -p "${HOME}/.local/state/kldload" 2>/dev/null || true
: >"${HOME}/.local/state/kldload/webui-opened" 2>/dev/null || true

url='https://localhost:8443/'

# Wait for the SPA to answer (up to ~60s). `curl -k` because the cert is the
# local kldload-webui cert; we only care that the endpoint is serving.
for _ in $(seq 1 60); do
    if curl -sk -o /dev/null "$url" 2>/dev/null; then
        break
    fi
    sleep 1
done
sleep 2 # let nginx finish wiring the upstream before we paint the SPA

# Also wait for the PKI seed before painting — but ONLY on an installed system.
# firstboot generates the CA, issues the webui cert, seeds it into each user's
# ~/.pki/nssdb (the store Chrome reads), THEN touches this marker. On a FRESH
# install the graphical login can beat that seed by ~1 min (login 09:06 vs nssdb
# seed 09:07 on .111 2026-07-25), so Chrome's first paint would flash a cert
# warning that self-heals seconds later. Waiting for the marker means it's trusted
# on first paint — no warning ever.
#
# The LIVE image is different: that firstboot desktop seed path does not run, so
# pki-ready is NEVER touched — and the old unconditional wait blocked the desktop
# for the full 90s bound waiting for a marker that never comes (the ~45-90s live-
# boot GUI stall reported on 1.3.2, .111 2026-07-26). Detect the live image by the
# dracut live marker and skip the wait there — the live env is ephemeral, so a
# brief self-healing warning is fine and far better than a blank desktop. On an
# installed system the marker is absent, so the wait runs as before.
if [[ ! -e /run/initramfs/live ]]; then
    for _ in $(seq 1 90); do
        [[ -f /var/lib/kldload/pki-ready ]] && break
        sleep 1
    done
fi

exec /usr/local/bin/kldload-chrome-app com.kldload.webui "$url"
