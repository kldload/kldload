#!/usr/bin/env python3
# ══════════════════════════════════════════════════════════════════════════════
# kldload-doctor — diagnose a kldload host and prescribe fixes
# ══════════════════════════════════════════════════════════════════════════════
#
# Like `brew doctor` or `rustup doctor`: runs a suite of known-good checks
# and tells you which subsystems are healthy, which are drifting, and the
# exact command to run to fix each one. The opposite of a status board —
# a status board reports state; this profiles state against a baseline
# and answers "is this right?" plus "if not, do this".
#
# Output: JSON to stdout. Consumed by the web UI dashboard and by CI.
# Exit code: 0 if all checks pass, 1 if any fail, 2 if any crash.
#
# Each check is a callable that returns a dict:
#   {
#     "subsystem": "zfs",           # grouping in UI
#     "name":      "pool online",
#     "status":    "ok|fail|warn|skip",
#     "expected":  "rpool ONLINE with 0 errors",
#     "actual":    "rpool ONLINE, errors=0",
#     "severity":  "critical|high|medium|low",
#     "remediation": "zpool clear rpool; zpool scrub rpool"
#   }
#
# Add checks at the bottom — they're just functions that return a dict.
# ══════════════════════════════════════════════════════════════════════════════

from __future__ import annotations
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path


def _run(cmd, timeout=5):
    """Return (rc, stdout, stderr). Never raises — subprocess failures
    surface as rc != 0 with empty stdout; that's what checks expect."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except Exception as e:
        return -1, "", str(e)


def _has(cmd):
    """True if a binary is on PATH."""
    rc, _, _ = _run(["which", cmd])
    return rc == 0


def _result(subsystem, name, status, expected, actual,
            severity="medium", remediation=""):
    return {
        "subsystem":   subsystem, "name": name, "status": status,
        "expected":    expected, "actual": actual,
        "severity":    severity, "remediation": remediation,
    }


# ── ZFS checks ────────────────────────────────────────────────────────────────

def check_zfs_pool():
    rc, out, _ = _run(["zpool", "list", "-H", "-o", "health", "rpool"])
    if rc != 0:
        return _result("zfs", "rpool exists", "fail",
                       "rpool imported and ONLINE",
                       "rpool not imported",
                       severity="critical",
                       remediation="zpool import rpool")
    if out == "ONLINE":
        return _result("zfs", "rpool health", "ok",
                       "ONLINE", out, severity="critical")
    return _result("zfs", "rpool health", "fail",
                   "ONLINE", out, severity="critical",
                   remediation="zpool status rpool; resilver or replace failed vdev")

def check_zfs_errors():
    rc, out, _ = _run(["zpool", "status", "-x"])
    if rc != 0:
        return _result("zfs", "pool errors", "skip", "", "zpool missing")
    if "all pools are healthy" in out.lower():
        return _result("zfs", "pool errors", "ok",
                       "all pools healthy", "all pools healthy")
    return _result("zfs", "pool errors", "warn",
                   "all pools healthy", out.splitlines()[0] if out else "unknown",
                   severity="high",
                   remediation="zpool status; zpool clear <pool> after review")

def check_zfs_arc_target():
    """ARC should be sized sensibly — not eating all RAM, not starved."""
    try:
        arc = Path("/proc/spl/kstat/zfs/arcstats").read_text()
    except Exception:
        return _result("zfs", "arc sized", "skip", "", "arcstats missing")
    stats = {}
    for line in arc.splitlines()[2:]:
        parts = line.split()
        if len(parts) >= 3:
            stats[parts[0]] = int(parts[2])
    size  = stats.get("size", 0)
    tgt   = stats.get("c", 0)
    mem   = int(subprocess.check_output(
        ["awk", "/MemTotal/ {print $2*1024}", "/proc/meminfo"]).strip())
    actual = f"ARC {size//2**20}M / target {tgt//2**20}M / ram {mem//2**20}M"
    # Rough sanity: ARC should be < 80% of RAM on a live host
    if mem and size / mem > 0.8:
        return _result("zfs", "arc sized", "warn",
                       "ARC < 80% of RAM", actual, severity="medium",
                       remediation="echo $((RAM*2/3)) > /sys/module/zfs/parameters/zfs_arc_max")
    return _result("zfs", "arc sized", "ok", "ARC within bounds", actual)

def check_sanoid_timer():
    rc, out, _ = _run(["systemctl", "is-active", "sanoid.timer"])
    if rc == 0 and out == "active":
        return _result("zfs", "sanoid timer", "ok",
                       "active", out, severity="medium")
    return _result("zfs", "sanoid timer", "warn",
                   "active", out or "inactive", severity="medium",
                   remediation="systemctl enable --now sanoid.timer")


# ── kldload ZFS namespace (secrets + state + playbooks datasets) ──────────────

def check_kldload_datasets():
    expected = ["rpool/kldload", "rpool/kldload/secrets",
                "rpool/kldload/state", "rpool/kldload/playbooks"]
    rc, out, _ = _run(["zfs", "list", "-H", "-o", "name", "-r", "rpool/kldload"])
    if rc != 0:
        return _result("kldload-zfs", "namespace exists", "warn",
                       "rpool/kldload namespace",
                       "not created (will auto-create on first webui run)",
                       severity="low",
                       remediation="restart kldload-webui — it creates the namespace lazily")
    present = set(out.splitlines())
    missing = [d for d in expected if d not in present]
    if not missing:
        return _result("kldload-zfs", "namespace exists", "ok",
                       "4/4 datasets", "4/4 datasets", severity="medium")
    return _result("kldload-zfs", "namespace exists", "warn",
                   "4/4 datasets", f"missing: {','.join(missing)}",
                   severity="medium",
                   remediation="restart kldload-webui to recreate missing datasets")

def check_secrets_encryption():
    rc, out, _ = _run(["zfs", "get", "-H", "-o", "value", "encryption",
                       "rpool/kldload/secrets"])
    if rc != 0:
        return _result("kldload-zfs", "secrets encrypted", "skip",
                       "aes-256-gcm", "dataset missing")
    if "aes" in out.lower():
        return _result("kldload-zfs", "secrets encrypted", "ok",
                       "aes-256-gcm", out, severity="high")
    return _result("kldload-zfs", "secrets encrypted", "fail",
                   "aes-256-gcm", out or "off", severity="high",
                   remediation="Dataset lost encryption — destroy and recreate")


# ── Network / WireGuard ───────────────────────────────────────────────────────

def check_wireguard_module():
    rc, out, _ = _run(["lsmod"])
    if "wireguard" in out:
        return _result("network", "wireguard module", "ok",
                       "loaded", "loaded")
    return _result("network", "wireguard module", "warn",
                   "loaded", "not loaded",
                   severity="medium",
                   remediation="modprobe wireguard")

def check_wg_interfaces():
    """If we're on a K8s CP, wg-mgmt should be up."""
    rc, out, _ = _run(["ip", "-br", "link", "show", "type", "wireguard"])
    if rc != 0 or not out:
        return _result("network", "wireguard mesh", "skip",
                       "wg interfaces when clustered",
                       "no WireGuard mesh yet")
    ifaces = [line.split()[0] for line in out.splitlines()]
    return _result("network", "wireguard mesh", "ok",
                   "mesh interfaces present", f"{len(ifaces)} ifaces: {','.join(ifaces)}")

def check_virbr0():
    rc, out, _ = _run(["ip", "-br", "link", "show", "virbr0"])
    if rc == 0 and "UP" in out:
        return _result("network", "virbr0 up", "ok", "UP", out.split()[1])
    if rc != 0:
        return _result("network", "virbr0 up", "skip",
                       "libvirt default bridge",
                       "not configured (OK if no libvirt yet)")
    return _result("network", "virbr0 up", "warn", "UP",
                   out.split()[1] if len(out.split()) > 1 else "unknown",
                   severity="medium",
                   remediation="virsh net-start default; virsh net-autostart default")


# ── Kubernetes ────────────────────────────────────────────────────────────────

def _powered_off_nodes():
    """Node names whose backing VM is deliberately powered down.

    kldload BUILDS a cluster with 3 control planes and 3 workers and RUNS it
    with 2 of each: quiesce_idle_vms() powers the rest off once the build is
    done, because two of a three-member etcd is still a strict majority and a
    desktop that is also a hypervisor should not carry six idle VMs. See the
    quiesce block in kldload-autodeploy.

    Without this, every quiesced machine reports four permanent failures --
    nodes, cilium health, cilium agents, metallb -- all saying 4/6 when 4/6 is
    the intended state. An audit whose loudest items are wrong by design
    teaches the operator to ignore the red, which costs more than the checks
    are worth (observed on .145, 2026-08-15).

    Returns: a set of node names known to be off. Empty when virsh is absent
    or unreadable -- in which case the checks behave exactly as before.
    """
    if not _has("virsh"):
        return set()
    rc, out, _ = _run(["virsh", "list", "--all", "--name"], timeout=10)
    if rc != 0:
        return set()
    all_vms = {n.strip() for n in out.splitlines() if n.strip()}
    rc, out, _ = _run(["virsh", "list", "--state-running", "--name"], timeout=10)
    if rc != 0:
        return set()
    running = {n.strip() for n in out.splitlines() if n.strip()}
    return all_vms - running


def _node_expectation(total):
    """(expected_ready, note) for a cluster of `total` registered nodes.

    Every registered node is expected Ready. Full stop.

    WHY THIS USED TO SUBTRACT: nodes powered off by the end-of-run quiesce were
    deducted from the expectation, so a 6-node cluster running on 4 reported
    "ok". The tool had been calibrated to accept a defect — and it worked
    exactly as designed on 2026-08-19, staying green while an etcd member, an
    apiserver and a scheduler were all down. quiesce no longer touches cluster
    nodes, and even if it did, a node that is off is a finding, not an
    expectation. The note still NAMES the powered-off nodes, because that turns
    "4/6 Ready" into something an operator can act on in one step.
    """
    off = _powered_off_nodes()
    rc, out, _ = _run(["kubectl", "get", "nodes", "-o=jsonpath={.items[*].metadata.name}"],
                      timeout=10)
    if rc != 0 or not out:
        return total, ""
    off_nodes = [n for n in out.split() if n in off]
    if not off_nodes:
        return total, ""
    return total, " (%d powered off: %s — start with: virsh start <name>)" % (
        len(off_nodes), ", ".join(sorted(off_nodes)))

def check_k8s_nodes():
    if not _has("kubectl"):
        return _result("kubernetes", "nodes ready", "skip",
                       "all nodes Ready", "kubectl not installed")
    rc, out, _ = _run(["kubectl", "get", "nodes",
                       "-o=jsonpath={.items[*].status.conditions[?(@.type==\"Ready\")].status}"],
                      timeout=10)
    if rc != 0:
        return _result("kubernetes", "nodes ready", "skip",
                       "all nodes Ready",
                       "no cluster or no kubeconfig")
    statuses = out.split() if out else []
    ready = statuses.count("True")
    total = len(statuses)
    if total == 0:
        return _result("kubernetes", "nodes ready", "skip",
                       "nodes registered", "no nodes")
    want, note = _node_expectation(total)
    if ready >= want:
        return _result("kubernetes", "nodes ready", "ok",
                       f"{want}/{total} Ready{note}", f"{ready}/{total} Ready",
                       severity="critical")
    return _result("kubernetes", "nodes ready", "fail",
                   f"{want}/{total} Ready{note}", f"{ready}/{total} Ready",
                   severity="critical",
                   remediation="kubectl get nodes -o wide; kube-status")

def check_cilium():
    # Rather than depending on the `cilium` CLI (not always installed on the
    # host, and needs KUBECONFIG env which subprocess sometimes loses),
    # just count the Cilium agent daemon pods via kubectl — same signal.
    if not _has("kubectl"):
        return _result("kubernetes", "cilium healthy", "skip",
                       "cilium daemon Running", "no kubectl")
    ready, total = _pods_ready("kube-system", "k8s-app=cilium")
    if total == 0:
        return _result("kubernetes", "cilium healthy", "skip", "", "no cilium pods")
    # One agent per node: a node powered down by quiesce has no pod to be
    # Ready, so expect the running-node count, not the registered-node count.
    want, note = _node_expectation(total)
    ok = ready >= want
    return _result("kubernetes", "cilium healthy",
                   "ok" if ok else "fail",
                   f"{want}/{total} daemon Ready{note}",
                   f"{ready}/{total} daemon Ready",
                   severity="critical" if not ok else "medium",
                   remediation="kubectl -n kube-system get po -l k8s-app=cilium")


# ── kldload services ─────────────────────────────────────────────────────────

def check_webui_running():
    rc, out, _ = _run(["systemctl", "is-active", "kldload-webui"])
    if rc == 0 and out == "active":
        return _result("services", "kldload-webui", "ok", "active", "active",
                       severity="high")
    return _result("services", "kldload-webui", "warn",
                   "active", out or "inactive",
                   severity="high",
                   remediation="systemctl start kldload-webui; journalctl -u kldload-webui -n 50")

def check_libvirtd():
    rc, out, _ = _run(["systemctl", "is-active", "libvirtd"])
    state = "active" if (rc == 0 and out == "active") else (out or "inactive")
    return _result("services", "libvirtd",
                   "ok" if state == "active" else "warn",
                   "active", state,
                   severity="medium",
                   remediation="systemctl enable --now libvirtd")

def check_kldload_tools():
    """Verify the core CLI set is present."""
    expected = ["kvm-create", "kvm-clone", "kube-cluster", "kldload-db",
                "kldload-inventory", "kldload-doctor", "kexport"]
    missing = [t for t in expected if not _has(t)]
    if not missing:
        return _result("services", "cli tools",
                       "ok", f"{len(expected)} tools", f"{len(expected)} tools")
    return _result("services", "cli tools", "warn",
                   f"{len(expected)} tools",
                   f"missing: {','.join(missing)}", severity="medium",
                   remediation="Run install-on-target or reboot into the live ISO")


# ── Runner ───────────────────────────────────────────────────────────────────

# ── kldload-internal stack (Cilium, MetalLB, Hubble, ZFS CSI, Gateway) ───────
# These only exist after a kube-cluster bootstrap. They each report SKIP when
# there's no cluster (kubectl unreachable), and ok/fail when there is.

def _kubectl_json(args, default=None):
    # Force KUBECONFIG so it works even when run via subprocess from a
    # service that inherited a minimal env (webui, systemd oneshot, etc.).
    env = dict(os.environ)
    env.setdefault("KUBECONFIG", "/root/.kube/config")
    env.setdefault("HOME", "/root")
    try:
        out = subprocess.check_output(["kubectl"] + args + ["-o", "json"],
                                      text=True, stderr=subprocess.DEVNULL,
                                      timeout=8, env=env)
        return json.loads(out)
    except Exception:
        return default

def _pods_ready(namespace, selector):
    d = _kubectl_json(["get", "pods", "-n", namespace, "-l", selector], default={"items": []})
    pods = d.get("items", [])
    ready = 0
    for p in pods:
        conds = {c["type"]: c["status"] for c in p.get("status", {}).get("conditions", [])}
        if conds.get("Ready") == "True":
            ready += 1
    return ready, len(pods)

def check_cilium_pods():
    if not _has("kubectl"):
        return _result("k8s-stack", "cilium agents", "skip", "", "no kubectl")
    ready, total = _pods_ready("kube-system", "k8s-app=cilium")
    if total == 0:
        return _result("k8s-stack", "cilium agents", "skip",
                       "Cilium DaemonSet pods Ready", "no Cilium pods — is kube-cluster bootstrapped?")
    want, note = _node_expectation(total)  # see check_cilium(): one per node
    ok = ready >= want
    return _result("k8s-stack", "cilium agents", "ok" if ok else "fail",
                   f"{want}/{total} Ready{note}", f"{ready}/{total} Ready",
                   severity="critical" if not ok else "medium",
                   remediation="kubectl -n kube-system get po -l k8s-app=cilium; cilium status --verbose")

def check_cilium_operator():
    if not _has("kubectl"):
        return _result("k8s-stack", "cilium operator", "skip", "", "no kubectl")
    ready, total = _pods_ready("kube-system", "io.cilium/app=operator")
    if total == 0:
        return _result("k8s-stack", "cilium operator", "skip", "", "not deployed")
    return _result("k8s-stack", "cilium operator",
                   "ok" if ready == total and total > 0 else "fail",
                   "operator Ready", f"{ready}/{total} Ready")

def check_hubble_relay():
    if not _has("kubectl"):
        return _result("k8s-stack", "hubble relay", "skip", "", "no kubectl")
    ready, total = _pods_ready("kube-system", "k8s-app=hubble-relay")
    if total == 0:
        return _result("k8s-stack", "hubble relay", "skip", "", "not deployed — enable via kube-cluster")
    return _result("k8s-stack", "hubble relay",
                   "ok" if ready == total else "fail",
                   "relay Ready", f"{ready}/{total} Ready")

def check_hubble_ui():
    if not _has("kubectl"):
        return _result("k8s-stack", "hubble ui", "skip", "", "no kubectl")
    ready, total = _pods_ready("kube-system", "k8s-app=hubble-ui")
    if total == 0:
        return _result("k8s-stack", "hubble ui", "skip", "", "not deployed")
    return _result("k8s-stack", "hubble ui",
                   "ok" if ready == total else "warn",
                   "UI Ready", f"{ready}/{total} Ready", severity="low")

def check_metallb():
    if not _has("kubectl"):
        return _result("k8s-stack", "metallb", "skip", "", "no kubectl")
    # metallb helm chart uses app.kubernetes.io/name=metallb (newer),
    # older charts used app=metallb. Try new first, fall back.
    ready, total = _pods_ready("metallb-system", "app.kubernetes.io/name=metallb")
    if total == 0:
        ready, total = _pods_ready("metallb-system", "app=metallb")
    if total == 0:
        return _result("k8s-stack", "metallb", "skip", "", "not deployed")
    return _result("k8s-stack", "metallb",
                   "ok" if ready == total else "fail",
                   "speaker + controller Ready", f"{ready}/{total} Ready",
                   severity="high",
                   remediation="kubectl -n metallb-system get po")

def check_zfs_csi():
    if not _has("kubectl"):
        return _result("k8s-stack", "zfs csi", "skip", "", "no kubectl")
    # openebs-zfs-localpv chart labels pods app=openebs-zfs-controller and
    # app=openebs-zfs-node. Count both as "zfs csi" being up.
    r1, t1 = _pods_ready("openebs", "app=openebs-zfs-controller")
    r2, t2 = _pods_ready("openebs", "app=openebs-zfs-node")
    ready, total = r1 + r2, t1 + t2
    if total == 0:
        return _result("k8s-stack", "zfs csi", "skip", "", "not deployed")
    return _result("k8s-stack", "zfs csi",
                   "ok" if ready == total else "fail",
                   "CSI driver + node agents Ready", f"{ready}/{total} Ready",
                   severity="high")

def check_gateway_api():
    if not _has("kubectl"):
        return _result("k8s-stack", "gateway api", "skip", "", "no kubectl")
    # CRDs present?
    d = _kubectl_json(["get", "crd"], default={"items": []})
    has_crd = any(i.get("metadata", {}).get("name", "").endswith("gateways.gateway.networking.k8s.io")
                  for i in d.get("items", []))
    if not has_crd:
        return _result("k8s-stack", "gateway api", "skip", "", "CRDs not installed")
    return _result("k8s-stack", "gateway api", "ok", "CRDs present", "CRDs present")

def check_helm_releases():
    if not _has("helm"):
        return _result("helm", "helm CLI", "skip", "", "helm not installed")
    try:
        out = subprocess.check_output(["helm", "list", "-A", "-o", "json"],
                                      text=True, stderr=subprocess.DEVNULL, timeout=8)
        releases = json.loads(out)
        if not releases:
            return _result("helm", "releases", "skip", "", "no releases")
        bad = [r for r in releases if r.get("status") not in ("deployed", "superseded")]
        if bad:
            names = ", ".join(r.get("name", "?") for r in bad[:3])
            return _result("helm", "releases", "fail",
                           "all releases deployed",
                           f"{len(bad)}/{len(releases)} in bad state: {names}",
                           severity="high",
                           remediation=f"helm status {bad[0].get('name', '')} -n {bad[0].get('namespace', '')}")
        return _result("helm", "releases", "ok",
                       f"{len(releases)} deployed", f"{len(releases)} deployed")
    except Exception:
        return _result("helm", "releases", "skip", "", "helm unreachable")


# ── Observability pipeline (metrics-server, prometheus, scrape labels, grafana)
# Added after the "no data in cilium/tetragon dashboards" incident. These
# catch the specific regressions we fixed: unresolved DS_PROMETHEUS in
# dashboards, missing k8s_app labels on cilium metrics, firewall dropping
# inter-node metrics scrape, no metrics-server installed.

def check_metrics_server():
    if not _has("kubectl"):
        return _result("observability", "metrics-server", "skip", "", "no kubectl")
    ready, total = _pods_ready("kube-system", "k8s-app=metrics-server")
    if total == 0:
        return _result("observability", "metrics-server", "fail",
                       "metrics-server deploy Ready — powers kubectl top + web UI CPU%/Mem% overlay",
                       "not installed",
                       severity="medium",
                       remediation="kubectl apply -f https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml")
    if ready < total:
        return _result("observability", "metrics-server", "fail",
                       f"{total}/{total} Ready", f"{ready}/{total} Ready",
                       severity="medium",
                       remediation="kubectl -n kube-system logs deploy/metrics-server | tail -20")
    # Also verify the API actually works — "Ready" isn't enough if certs fail.
    rc, _, _ = _run(["kubectl", "top", "node", "--no-headers"], timeout=6)
    if rc != 0:
        return _result("observability", "metrics-server", "warn",
                       "kubectl top returns data",
                       "pods Ready but API not responding yet (may need --kubelet-insecure-tls)",
                       severity="medium",
                       remediation='kubectl -n kube-system patch deploy metrics-server --type=json -p=\'[{"op":"add","path":"/spec/template/spec/containers/0/args/-","value":"--kubelet-insecure-tls"}]\'')
    return _result("observability", "metrics-server", "ok",
                   "Ready + kubectl top works", "Ready + kubectl top works")

def _prom_query(q, timeout=4):
    """Return parsed Prometheus instant query result or None."""
    import urllib.parse, urllib.request
    try:
        url = f"http://localhost:9090/api/v1/query?query={urllib.parse.quote(q)}"
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return json.loads(r.read().decode()).get("data", {}).get("result", [])
    except Exception:
        return None

def check_prometheus_running():
    rc, out, _ = _run(["systemctl", "is-active", "prometheus"])
    if rc == 0 and "active" in out:
        return _result("observability", "prometheus", "ok",
                       "prometheus.service active", out)
    return _result("observability", "prometheus", "fail",
                   "prometheus.service active", out or "inactive",
                   severity="high",
                   remediation="systemctl start prometheus && journalctl -u prometheus -n 30")

def check_prometheus_targets():
    # All scrape targets should be 'up'. Downs that are expected (operator on
    # non-host-port nodes, klab VMs that aren't running) are tolerated by
    # requiring that AT LEAST ONE node in each cluster job is up.
    import urllib.request
    try:
        with urllib.request.urlopen("http://localhost:9090/api/v1/targets", timeout=4) as r:
            data = json.loads(r.read().decode())
    except Exception:
        return _result("observability", "prometheus targets", "skip",
                       "", "prometheus API unreachable")
    jobs_up = {}
    for t in data.get("data", {}).get("activeTargets", []):
        j = t.get("labels", {}).get("job", "?")
        jobs_up.setdefault(j, []).append(t.get("health") == "up")
    # Required jobs are satisfied by ANY of the listed aliases — different
    # firstboot paths / klab vs kldload templates use different job names
    # for the same underlying scrape (host node_exporter especially).
    required_groups = {
        "cilium-agent":   ["cilium-agent"],
        "hubble-metrics": ["hubble-metrics"],
        "tetragon":       ["tetragon"],
        "host node_exporter": ["node_exporter", "kldload-host", "klab-host", "node"],
    }
    missing, broken = [], []
    for label, aliases in required_groups.items():
        present = [a for a in aliases if a in jobs_up]
        if not present:
            missing.append(label)
        elif not any(any(jobs_up[a]) for a in present):
            broken.append(label)
    if missing:
        return _result("observability", "prometheus scrape", "fail",
                       "cilium-agent, hubble-metrics, tetragon, node_exporter all present",
                       f"missing jobs: {', '.join(missing)}",
                       severity="high",
                       remediation="add missing scrape jobs to /etc/prometheus/prometheus.yml and restart prometheus")
    if broken:
        return _result("observability", "prometheus scrape", "fail",
                       "at least one target up per required job",
                       f"all targets down for: {', '.join(broken)}",
                       severity="high",
                       remediation="curl http://<node>:<port>/metrics from the host — likely a firewall drop (see kube-network nft)")
    return _result("observability", "prometheus scrape", "ok",
                   "cilium/hubble/tetragon/node_exporter all scraping",
                   f"{len(jobs_up)} jobs, all have ≥1 up target")

def check_cilium_scrape_labels():
    # Stock grafana.com Cilium dashboards filter by {k8s_app="cilium"} and
    # {pod=~"$pod"}. This verifies our synthesized labels are actually stamped.
    r = _prom_query('cilium_version{k8s_app="cilium"}')
    if r is None:
        return _result("observability", "cilium scrape labels", "skip", "", "prometheus unreachable")
    if not r:
        # "No series" has two very different causes and only one is a defect.
        #
        # If Prometheus has never scraped the cilium-agent job, there are no
        # series yet because the scrape has not happened — the cluster is
        # still converging. If it HAS scraped and the labelled series is still
        # absent, the labels really are missing from the scrape config.
        #
        # Without this split, every fresh install failed here: the post-install
        # smoke test runs seconds after the cluster is declared ready, and the
        # same box had 127 cilium metric names minutes later (fiend, .127 and
        # .137, 2026-08-19). A check that fails on every healthy install is a
        # check people learn to ignore.
        # `up` MUST be compared to 1. A target that Prometheus has merely
        # DISCOVERED — file_sd regenerates cilium targets every 30s — already
        # has an up series carrying the value 0, so testing only for the
        # series' existence lets this fall through to `fail` during the window
        # between discovery and the first successful scrape. That is precisely
        # what happened on .107 2026-08-22: k8s-ready was written at 05:26:13,
        # the check ran at 05:26:42 and failed, and minutes later the same box
        # served cilium_version with k8s_app="cilium" from 12 healthy
        # cilium-agent targets. Same false negative this guard was added for
        # (.127/.137, 2026-08-19), one layer further in.
        # Two guards, because "up" and "the metric exists" are different clocks.
        #
        # up==1 goes true on the FIRST successful scrape, but the labelled
        # series can take another scrape interval to appear — so testing only
        # up==1 still fails during that window. Measured on .120 2026-08-22:
        # the post-install smoke test failed here while, minutes later, the
        # same box served 6 scraped targets and 6 labelled series.
        #
        # So ask the metric itself. If cilium_version does not exist AT ALL,
        # nothing has been scraped yet and this is a timing question. If it
        # exists but the k8s_app-labelled form does not, the labels really are
        # missing from the scrape config and that is worth failing on.
        if not _prom_query('up{job="cilium-agent"} == 1'):
            return _result("observability", "cilium scrape labels", "skip", "",
                           "cilium-agent not scraped yet — cluster still converging")
        if not _prom_query('cilium_version'):
            return _result("observability", "cilium scrape labels", "skip", "",
                           "cilium_version not present yet — scraped but metrics not landed")
        return _result("observability", "cilium scrape labels", "fail",
                       'cilium_version{k8s_app="cilium"} returns ≥1 series (needed for dashboard 16611)',
                       "no series — synthesized labels missing from scrape config",
                       severity="high",
                       remediation="edit /etc/prometheus/prometheus.yml, add labels: {k8s_app: cilium, pod: cilium-<node>} to each cilium-agent target")
    return _result("observability", "cilium scrape labels", "ok",
                   "cilium_version{k8s_app=\"cilium\"} resolves",
                   f"{len(r)} agents reporting")

def check_tetragon_scrape():
    # Same convergence split as the cilium check above: an unscraped job is
    # "not yet", not "broken".
    if not _prom_query('up{job="tetragon"}'):
        return _result("observability", "tetragon scrape", "skip", "",
                       "tetragon not scraped yet — cluster still converging")
    r = _prom_query("tetragon_events_total")
    if r is None:
        return _result("observability", "tetragon scrape", "skip", "", "prometheus unreachable")
    if not r:
        return _result("observability", "tetragon scrape", "fail",
                       "tetragon_events_total > 0 series",
                       "no data — tetragon not scraped or not generating events",
                       severity="medium",
                       remediation="curl http://<node>:2112/metrics and add to prometheus.yml scrape_configs")
    total = sum(float(s.get("value", [0, 0])[1] or 0) for s in r)
    return _result("observability", "tetragon scrape", "ok",
                   "tetragon_events_total > 0",
                   f"{len(r)} series, Σ events = {int(total)}")

def check_hubble_scrape():
    r = _prom_query("hubble_flows_processed_total")
    if r is None:
        return _result("observability", "hubble scrape", "skip", "", "prometheus unreachable")
    if not r:
        return _result("observability", "hubble scrape", "fail",
                       "hubble_flows_processed_total > 0 series",
                       "no data — hubble metrics port 9965 not scraped or firewall drop",
                       severity="medium",
                       remediation="kube-network nft (reapply firewall with node subnet trust)")
    return _result("observability", "hubble scrape", "ok",
                   "hubble flows recorded", f"{len(r)} series")

def check_grafana_dashboards():
    # Provisioned dashboards must have no unresolved ${DS_PROMETHEUS}
    # placeholders, otherwise every panel renders "No data". Regression
    # source: grafana.com dashboards ship packaged for UI import.
    import glob
    dash_dir = "/var/lib/grafana/dashboards"
    if not os.path.isdir(dash_dir):
        return _result("observability", "grafana dashboards", "skip", "", "no dashboards provisioned")
    bad = []
    for p in glob.glob(f"{dash_dir}/*.json"):
        try:
            with open(p) as f:
                txt = f.read()
            if "${DS_PROMETHEUS" in txt or '"__inputs"' in txt:
                bad.append(os.path.basename(p))
        except Exception:
            continue
    if bad:
        return _result("observability", "grafana dashboards", "fail",
                       "no unresolved ${DS_PROMETHEUS} placeholders",
                       f"{len(bad)} dashboards still template-unresolved: {', '.join(bad[:3])}",
                       severity="high",
                       remediation="rerun the DS_PROMETHEUS strip in kldload-firstboot or re-provision from cache")
    n = len(glob.glob(f"{dash_dir}/*.json"))
    return _result("observability", "grafana dashboards", "ok",
                   "all dashboards have resolved datasource refs",
                   f"{n} dashboards provisioned cleanly")

def check_grafana_running():
    rc, out, _ = _run(["systemctl", "is-active", "grafana-server"])
    if rc == 0 and "active" in out:
        return _result("observability", "grafana", "ok",
                       "grafana-server active", out)
    return _result("observability", "grafana", "fail",
                   "grafana-server active", out or "inactive",
                   severity="medium",
                   remediation="systemctl start grafana-server")

def check_cluster_firewall():
    # Validates the regression fix where kube-network's policy-drop nft
    # chain was blocking kubelet:10250 / hubble-peer:4244 / metrics ports
    # between K8s nodes. Requires node subnet trust rule to be present.
    if not os.path.exists("/etc/nftables.conf"):
        return _result("observability", "cluster firewall", "skip", "", "no /etc/nftables.conf")
    # A trust rule is only needed where something is DROPPING. This check
    # exists to catch a policy-drop chain that blocked kubelet:10250 and
    # hubble:4244 between nodes — but it read the config file alone, so on a
    # host where nftables is inactive and disabled, with no policy drop
    # anywhere in the file, it failed anyway and announced that "metrics
    # scrape will timeout" while every one of 25 scrape targets was up
    # (fiend, 2026-08-16).
    #
    # Ask the running firewall, not the file on disk: if nothing is dropping,
    # there is nothing to trust-list.
    # _run returns (rc, stdout, stderr) — three values, as every other check
    # here unpacks it. And `systemctl is-active` prints "inactive", which
    # CONTAINS "active", so this must be an equality test and not a substring
    # one; the first version of this fix got both wrong and raised ValueError
    # inside the check, which the harness reported as the very failure it was
    # meant to clear.
    _rc, _active, _ = _run(["systemctl", "is-active", "nftables"])
    _rc2, _live, _ = _run(["nft", "list", "ruleset"])
    if (_active or "").strip() != "active" or "policy drop" not in (_live or ""):
        return _result("observability", "cluster firewall", "skip", "",
                       "no policy-drop firewall in effect — nothing to trust-list")
    try:
        with open("/etc/nftables.conf") as f:
            conf = f.read()
    except Exception:
        return _result("observability", "cluster firewall", "skip", "", "unreadable")
    # Heuristics: either a "ip saddr <subnet> accept" rule, or explicit port
    # opens for 10250/4244.
    has_subnet = "ip saddr" in conf and ("192.168.122" in conf or "node_cidr" in conf or "/24" in conf)
    has_pod_cidr = "10.244" in conf or "pod_cidr" in conf
    has_kubelet = "10250" in conf
    has_hubble = "4244" in conf
    if not (has_subnet or has_kubelet):
        return _result("observability", "cluster firewall", "fail",
                       "inet filter trusts node subnet OR opens kubelet:10250",
                       "no such rule — hubble-relay and metrics scrape will timeout",
                       severity="high",
                       remediation="kube-network nft (reapply with updated template)")
    if not has_pod_cidr:
        return _result("observability", "cluster firewall", "warn",
                       "pod CIDR (10.244.0.0/16) accepted on input",
                       "no pod CIDR rule — pod-to-node scrape won't work",
                       severity="medium",
                       remediation="add 'ip saddr 10.244.0.0/16 accept' to inet filter input chain")
    return _result("observability", "cluster firewall", "ok",
                   "node subnet + pod CIDR trusted, key ports open",
                   "firewall permits metrics + kubelet + hubble-peer")


# ── Bob / webui tooling ──────────────────────────────────────────────────────
# Bob can only diagnose the cluster if Ollama is reachable AND the webui
# exposes the observability tools. These catch "Bob says I can't see
# anything" regressions.

def check_ollama():
    import urllib.request
    try:
        with urllib.request.urlopen("http://localhost:11434/api/ps", timeout=3) as r:
            data = json.loads(r.read().decode())
    except Exception as e:
        return _result("bob", "ollama", "fail",
                       "http://localhost:11434/api/ps responds",
                       f"unreachable: {e}",
                       severity="medium",
                       remediation="systemctl start ollama")
    models = data.get("models", [])
    if not models:
        return _result("bob", "ollama model loaded", "warn",
                       "at least one model in memory",
                       "no models loaded — Bob will be slow on first prompt",
                       severity="low",
                       remediation="ollama run llama3.1:8b 'hi' to warm")
    return _result("bob", "ollama", "ok",
                   "reachable + model in VRAM",
                   ", ".join(m.get("name", "?") for m in models))

def check_install_artifacts():
    """Verify the install-time artifacts that profiles.sh should have
    dropped on the target. Silent cp failures in profiles.sh were the
    common root cause across 1.0.4 regressions: autodeploy binary
    missing, ansible playbook dir missing, ttyd-k9s unit missing."""
    want = {
        "/usr/sbin/kldload-autodeploy":                        "autodeploy orchestrator binary",
        "/usr/lib/systemd/system/kldload-autodeploy.service":  "autodeploy systemd unit",
        "/usr/lib/systemd/system/ttyd-k9s.service":            "terminal drawer unit",
        "/usr/local/share/kldload-ansible/playbooks/provision-golden.yml": "ansible playbook library",
        "/usr/local/bin/kube-cluster":                         "kube-cluster tool",
        "/usr/local/bin/kldload-doctor":                       "doctor tool (self)",
    }
    missing = [desc for path, desc in want.items() if not os.path.exists(path)]
    if missing:
        return _result("installer", "artifacts", "fail",
                       "all install-time artifacts present",
                       f"missing: {', '.join(missing[:3])}" + (" …" if len(missing) > 3 else ""),
                       severity="high",
                       remediation="re-run: kldload-install-target profile=<your-profile>, or rebuild the ISO")
    return _result("installer", "artifacts", "ok",
                   f"{len(want)} artifacts checked", "all present")


def check_bob_tools_present():
    # Simply greps the webui for the new tool names. If any are missing,
    # the build regressed.
    p = "/usr/local/bin/kldload-webui"
    if not os.path.isfile(p):
        return _result("bob", "webui tools", "skip", "", "webui not installed")
    try:
        with open(p) as f:
            src = f.read()
    except Exception:
        return _result("bob", "webui tools", "skip", "", "unreadable")
    expected = ["k8s_get_pods", "k8s_describe", "k8s_logs", "k8s_events",
                "prom_query", "zfs_status", "host_vitals", "doctor_check"]
    missing = [t for t in expected if t not in src]
    if missing:
        return _result("bob", "webui tools", "fail",
                       "all observability tools present",
                       f"missing from kldload-webui: {', '.join(missing)}",
                       severity="high",
                       remediation="reinstall kldload-webui from the fresh ISO")
    return _result("bob", "webui tools", "ok",
                   "8 observability tools registered",
                   "k8s_*, prom_query, zfs_status, host_vitals, doctor_check")



def check_wg_mesh_coherence():
    """Every cluster node peers with every other node, and with nobody who left.

    WHY this check exists: the WireGuard mesh was only ever built
    incrementally, and every incremental path had a hole. Adds peered a new
    node with the first control plane alone; removals dropped nothing at all.
    Nothing ever compared the result against the cluster that actually
    existed, so the drift was invisible until something downstream broke:
    two control planes with no InternalIP, MetalLB stuck at 4/6, a worker
    carrying one peer with all four of its metrics targets dark, and the
    first control plane carrying 17 peers where 8 were correct
    (fiend, 2026-08-16).

    Expected: N running cluster nodes each hold N-1 node peers plus the
    hypervisor. Anything else is drift, and `kube-cluster mesh-repair`
    reconciles it.
    """
    rc, out, _ = _run(["virsh", "list", "--state-running", "--name"], timeout=15)
    if rc != 0:
        return _result("kubernetes", "cluster mesh peers", "skip", "", "libvirt not reachable")
    nodes = [n.strip() for n in out.splitlines()
             if n.strip().startswith("kldload-cp") or n.strip().startswith("kldload-w")]
    if len(nodes) < 2:
        return _result("kubernetes", "cluster mesh peers", "skip", "",
                       f"{len(nodes)} cluster node(s) running — nothing to mesh")

    # Expected peer count: the other nodes, plus the hypervisor at .100.
    expect = len(nodes) - 1
    rc, hv, _ = _run(["wg", "show", "wg-k8s", "peers"], timeout=15)
    host_on_mesh = rc == 0 and bool(hv.strip())
    if host_on_mesh:
        expect += 1

    bad = []
    for n in nodes:
        rc, ip, _ = _run(["bash", "-c",
                          "virsh domifaddr %s --source lease 2>/dev/null | "
                          "awk '/ipv4/{split($4,a,\"/\");print a[1];exit}'" % n], timeout=15)
        ip = (ip or "").strip()
        if not ip:
            continue
        rc, cnt, _ = _run(["bash", "-c",
                           "timeout 12 ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no "
                           "-o BatchMode=yes -i /root/.ssh/id_ed25519 root@%s "
                           "'wg show wg-k8s peers | wc -l' </dev/null" % ip], timeout=20)
        cnt = (cnt or "").strip()
        if not cnt.isdigit():
            continue
        if int(cnt) != expect:
            bad.append(f"{n}={cnt}")

    if not bad:
        return _result("kubernetes", "cluster mesh peers", "ok",
                       f"every node holds {expect} peers",
                       f"{len(nodes)} nodes, full mesh")
    return _result("kubernetes", "cluster mesh peers", "fail",
                   f"every node holds {expect} peers",
                   "peer-count drift: " + ", ".join(bad),
                   severity="high",
                   remediation="kube-cluster mesh-repair")


def check_darksite_charts():
    """Can this box deploy Kubernetes with no network?

    WHY: the ISO shipped helm charts and the install still pulled everything
    from quay.io, because kldload-firstboot deleted /root/darksite eight
    minutes before the k8s phase looked in it, and the installer never copied
    helm-charts/ onto the target in the first place. Nothing noticed — the
    deploy simply logged "chart not in darksite, trying online helm repo" and
    carried on, which reads like a fallback rather than the air-gap promise
    being broken (fiend, 2026-08-16).
    """
    d = "/root/darksite/helm-charts"
    if not os.path.isdir(d):
        return _result("k8s-stack", "darksite charts", "fail",
                       "helm charts staged for offline deploy",
                       "no /root/darksite/helm-charts — k8s deploy needs a network",
                       severity="medium",
                       remediation="rebuild the ISO; charts are staged by builder/build-iso.sh")
    try:
        charts = sorted(f[:-4] for f in os.listdir(d) if f.endswith(".tgz"))
    except Exception:
        charts = []
    want = {"cilium", "tetragon", "argo-cd", "metallb"}
    missing = sorted(want - set(charts))
    if missing:
        return _result("k8s-stack", "darksite charts", "warn",
                       "cilium, tetragon, argo-cd, metallb staged",
                       f"missing: {', '.join(missing)} (present: {', '.join(charts) or 'none'})",
                       severity="medium",
                       remediation="rebuild the ISO")
    return _result("k8s-stack", "darksite charts", "ok",
                   "charts staged for offline deploy", ", ".join(charts))


def check_darksite_images():
    """Are the container images cached, or will the cluster phone home?

    Counts the tarballs the build staged against the list it was built from.
    A short count is how ~129 of 138 images ended up being pulled from public
    registries on a machine advertised as air-gapped.
    """
    d = "/root/darksite/k8s-images"
    if not os.path.isdir(d):
        return _result("k8s-stack", "darksite images", "skip", "",
                       "no /root/darksite/k8s-images on this install")
    try:
        have = len([f for f in os.listdir(d) if f.endswith(".tar")])
    except Exception:
        have = 0
    if have == 0:
        return _result("k8s-stack", "darksite images", "fail",
                       "k8s container images cached", "no image tarballs",
                       severity="medium", remediation="rebuild the ISO")
    return _result("k8s-stack", "darksite images", "ok",
                   "k8s container images cached", f"{have} image tarball(s)")


def check_docker_storage_driver():
    """Docker must use the zfs driver, not overlay2.

    WHY THIS CHECK EXISTS: kldload shipped claiming "Docker with its layers on
    ZFS" while Docker was running on overlay2 on a real install. Everything
    worked — pulls, runs, builds — so nothing complained. What was lost is the
    entire reason for the claim: on zfs each layer is a dataset, a pull is a
    clone, layers inherit compression, and the whole container estate can be
    snapshotted and sent as one recursive stream. On overlay2 a layer is a
    directory with no handle to snapshot or send.

    It is also nearly unfixable after the fact: Docker records its driver on
    first start and will not move to zfs without discarding every image. So the
    window to catch it is now, not when someone tries to replicate a container
    estate and finds there is nothing to send.
    """
    if not shutil.which("docker"):
        return _result("containers", "docker storage driver", "skip", "",
                       "docker not installed")
    try:
        out = subprocess.run(["docker", "info", "--format", "{{.Driver}}"],
                             capture_output=True, text=True, timeout=10)
        driver = (out.stdout or "").strip()
    except Exception:
        return _result("containers", "docker storage driver", "skip", "",
                       "could not query the docker daemon")
    if not driver:
        return _result("containers", "docker storage driver", "skip", "",
                       "docker daemon not answering")
    if driver == "zfs":
        return _result("containers", "docker storage driver", "ok",
                       "docker info reports the zfs driver",
                       "layers are datasets — snapshot, clone and send apply")
    return _result("containers", "docker storage driver", "fail",
                   "docker info reports the zfs driver",
                   f"running on {driver} — layers are ordinary "
                   "directories, so they cannot be snapshotted or sent",
                   severity="high",
                   remediation=(
                       "Docker keeps its first choice. With no images worth "
                       "preserving: systemctl stop docker; rm -rf "
                       "/var/lib/docker; zfs create -o "
                       "mountpoint=/var/lib/docker rpool/var/lib/docker; "
                       "printf '{\"storage-driver\":\"zfs\"}' > "
                       "/etc/docker/daemon.json; systemctl start docker"))


def check_zfs_bootfs():
    """bootfs is what ZFSBootMenu picks as the default boot environment.

    Without it ZBM lists boot environments but has no default to select, so
    an unattended reboot stops at a menu. The installer used to set it with
    `|| true`, which meant a failure here was invisible until somebody
    watched the machine not boot (2026-08-19).
    """
    rc, out, _ = _run(["zpool", "get", "-H", "-o", "value", "bootfs", "rpool"])
    if rc != 0:
        return _result("boot", "bootfs set", "skip", "", "rpool not imported")
    if out and out != "-":
        return _result("boot", "bootfs set", "ok", "a boot environment", out,
                       severity="critical")
    return _result("boot", "bootfs set", "fail",
                   "a boot environment", "unset",
                   severity="critical",
                   remediation="zpool set bootfs=rpool/ROOT/$(hostname) rpool")


def _seat_session():
    """Return (username, uid) of the session attached to a seat, or None.

    loginctl is authoritative: a session with a SEAT is a human at a screen,
    which is the one running pipewire. Picking "whoever owns /run/user/1000"
    instead is a guess, and it guesses wrong on a multi-user box.
    """
    rc, out, _ = _run(["loginctl", "list-sessions", "--no-legend"])
    if rc != 0:
        return None
    for line in out.splitlines():
        parts = line.split()
        # SESSION UID USER SEAT ...  — a "-" in the seat column means no screen.
        if len(parts) < 4 or parts[3] in ("-", ""):
            continue
        try:
            return parts[2], int(parts[1])
        except ValueError:
            continue
    return None


def check_audio_stack():
    """PipeWire needs a user D-Bus; without one it fails at the queueing stage.

    dbus-user-session ships /usr/lib/systemd/user/dbus.{socket,service}. When
    it was missing, pipewire.socket failed with "Unit dbus.service not found",
    pipewire and wireplumber never started, and the desktop had no audio at
    all while the hardware sat there fully driven (2026-08-18).
    """
    if not _has("pactl"):
        return _result("desktop", "audio sinks", "skip", "", "pactl absent")

    # PipeWire is a USER service. Asked as root, pactl has no session bus to
    # reach and answers "Connection refused" — which is not "no sinks", it is
    # "wrong question". Reporting that as a failure told an operator their
    # audio was broken on a machine with two working sinks (2026-08-19), and a
    # check that cries wolf is worse than no check, because the next real
    # failure gets ignored too.
    #
    # So ask as the logged-in graphical user when we are root. Their session
    # is the one that owns the sinks.
    argv = ["pactl", "list", "short", "sinks"]
    if os.geteuid() == 0:
        seat = _seat_session()
        if not seat:
            return _result("desktop", "audio sinks", "skip", "",
                           "no seat session to query")
        user, uid = seat
        # XDG_RUNTIME_DIR is not optional here. runuser alone leaves it unset,
        # pactl then has no socket path, and the answer is "Connection
        # refused" — indistinguishable from a broken audio stack unless you
        # know to look. Measured on a host with two healthy sinks.
        argv = ["env", f"XDG_RUNTIME_DIR=/run/user/{uid}",
                "runuser", "-u", user, "--"] + argv

    rc, out, _ = _run(argv)
    n = len([ln for ln in out.splitlines() if ln.strip()]) if rc == 0 else 0
    if n > 0:
        return _result("desktop", "audio sinks", "ok",
                       "at least one sink", f"{n} sink(s)")
    return _result("desktop", "audio sinks", "fail",
                   "at least one sink", "none",
                   severity="medium",
                   remediation="apt-get install -y dbus-user-session; "
                               "systemctl --user restart pipewire.socket")


def check_dock_pins():
    """Dock pins are the visible half of firstboot having actually run.

    They are written near the end of a 3698-line script. When firstboot died
    at line 55, everything after it silently did not happen, and an empty dock
    was the first symptom anybody noticed (2026-08-19).
    """
    if not _has("gsettings"):
        return _result("desktop", "dock pins", "skip", "", "gsettings absent")
    rc, out, _ = _run(["gsettings", "get", "org.gnome.shell", "favorite-apps"])
    if rc != 0:
        return _result("desktop", "dock pins", "skip", "", "no GNOME schema")
    n = out.count(".desktop")
    if n > 0:
        return _result("desktop", "dock pins", "ok", "kldload tools pinned",
                       f"{n} pinned")
    return _result("desktop", "dock pins", "fail",
                   "kldload tools pinned", "dock is empty",
                   severity="medium",
                   remediation="check kldload-firstboot ran to completion: "
                               "systemctl status kldload-firstboot")


def check_ai_payload_reclaimed():
    """The darksite AI payload is 3.3G and one-shot.

    The runtime is installed, the Open WebUI image is loaded and the Whisper
    weights are staged; afterwards the copy under /root is dead weight on
    every installed machine. Kept deliberately on LAN-mirror hosts.
    """
    if os.path.exists("/etc/kldload/keep-darksite"):
        return _result("disk", "AI payload reclaimed", "ok",
                       "kept (LAN-mirror mode)", "kept by policy")
    if not os.path.isdir("/root/darksite/ollama"):
        return _result("disk", "AI payload reclaimed", "ok",
                       "reclaimed after use", "reclaimed")
    rc, out, _ = _run(["du", "-sh", "/root/darksite/ollama"])
    size = out.split()[0] if rc == 0 and out else "?"
    return _result("disk", "AI payload reclaimed", "warn",
                   "reclaimed after use", f"still present ({size})",
                   severity="low",
                   remediation="rm -rf /root/darksite/ollama  "
                               "(safe once Ollama and Open WebUI are running)")


CHECKS = [
    check_zfs_bootfs,
    check_audio_stack,
    check_dock_pins,
    check_ai_payload_reclaimed,
    check_docker_storage_driver,
    check_zfs_pool, check_zfs_errors, check_zfs_arc_target, check_sanoid_timer,
    check_kldload_datasets, check_secrets_encryption,
    check_wireguard_module, check_wg_interfaces, check_virbr0,
    check_k8s_nodes, check_cilium,
    check_cilium_pods, check_cilium_operator,
    check_hubble_relay, check_hubble_ui,
    check_metallb, check_zfs_csi, check_gateway_api,
    check_helm_releases,
    check_metrics_server,
    check_prometheus_running, check_prometheus_targets,
    check_cilium_scrape_labels, check_tetragon_scrape, check_hubble_scrape,
    check_grafana_running, check_grafana_dashboards,
    check_cluster_firewall,
    check_wg_mesh_coherence,
    check_darksite_charts, check_darksite_images,
    check_ollama, check_bob_tools_present,
    check_install_artifacts,
    check_webui_running, check_libvirtd, check_kldload_tools,
]


def _log_run(payload):
    """Append each Doctor run to /root/kldload-doctor.log for auditability.
    Keeps the last ~50 runs rolling so humans (and Bob) can grep history:
        grep -A5 "ts=" /root/kldload-doctor.log | tail -100"""
    from datetime import datetime
    try:
        line = (f"# ts={datetime.now().isoformat()} "
                f"ok={payload['summary']['ok']} fail={payload['summary']['fail']} "
                f"warn={payload['summary']['warn']} skip={payload['summary']['skip']}")
        with open("/root/kldload-doctor.log", "a") as f:
            f.write(line + "\n")
            for r in payload["results"]:
                if r["status"] in ("fail", "warn"):
                    f.write(f"  [{r['status'].upper():4}] {r['subsystem']}/{r['name']}: {r['actual']}\n")
        # Rotate at 2MB — doctor runs can be frequent.
        if os.path.exists("/root/kldload-doctor.log") and \
           os.path.getsize("/root/kldload-doctor.log") > 2_000_000:
            os.rename("/root/kldload-doctor.log", "/root/kldload-doctor.log.old")
    except Exception:
        pass


def main():
    results = []
    crashed = 0
    for fn in CHECKS:
        try:
            r = fn()
            if isinstance(r, dict):
                results.append(r)
        except Exception as e:
            crashed += 1
            results.append(_result(
                "runner", fn.__name__, "fail",
                "check runs cleanly", f"crashed: {e}",
                severity="low",
                remediation=f"Fix {fn.__name__} in kldload-profile"))
    # Summary + grouped output
    by_subsystem = {}
    for r in results:
        by_subsystem.setdefault(r["subsystem"], []).append(r)
    counts = {"ok": 0, "fail": 0, "warn": 0, "skip": 0}
    for r in results:
        counts[r["status"]] = counts.get(r["status"], 0) + 1
    out = {
        "version":    "1.0",
        "summary":    counts,
        "subsystems": by_subsystem,
        "results":    results,
    }
    print(json.dumps(out, indent=2, sort_keys=True))
    _log_run(out)
    if crashed:
        return 2
    return 0 if counts["fail"] == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
