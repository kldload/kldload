#!/usr/bin/env bash
# kube-load-images — import pre-pulled container images from darksite into containerd
# Run before kube-init on offline/air-gapped systems
set -Eeuo pipefail
trap 'echo "kube-load-images: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

# --help answers before the root re-exec below: asking a tool what it does
# must never need a password, and on a machine where the operator has no
# sudo rights it could not answer at all (swept 2026-09-16).
case "${1:-}" in
-h | --help)
    cat <<'USAGE'
Usage: kube-load-images [IMAGES_DIR]

Import pre-pulled container images into containerd from a darksite directory,
so an air-gapped node can start a cluster without reaching a registry. Run it
before kube-init.

  IMAGES_DIR   where the image tarballs are. Default
               /root/darksite/k8s-images.

Needs root, because it talks to containerd through ctr.

An empty or missing directory is not an error: it says so and exits 0, leaving
the node to pull from the internet as it normally would. A missing ctr IS an
error (exit 1), because that means containerd is not installed, and so is any
tarball that does not import (exit 1, each one named).

See also: kube-init, kube-join.
USAGE
    exit 0
    ;;
esac

if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

IMAGES_DIR="${1:-/root/darksite/k8s-images}"

log() { echo -e "\033[1;32m[kube-load-images]\033[0m $*"; }
err() { echo -e "\033[1;31m[kube-load-images]\033[0m $*" >&2; }

if [[ ! -d "$IMAGES_DIR" ]] || [[ -z "$(ls -A "$IMAGES_DIR" 2>/dev/null)" ]]; then
    log "No pre-pulled images found at $IMAGES_DIR — will pull from internet"
    exit 0
fi

command -v ctr >/dev/null 2>&1 || {
    err "ctr not found — containerd not installed?"
    exit 1
}

# Counted by outcome. This was `import || true` and "Loaded N" where N was the
# number of files tried, so a golden reported every image loaded while the
# digest-pinned Cilium archives, saved with no name, gave containerd nothing it
# could find (2026-09-27).
count=0 given=0
failed=()
for tarball in "$IMAGES_DIR"/*.tar; do
    [[ -f "$tarball" ]] || continue
    given=$((given + 1))
    if ctr -n k8s.io images import "$tarball" >/dev/null; then
        count=$((count + 1))
    else
        failed+=("$(basename "$tarball")")
    fi
done
log "Loaded ${count} of ${given} container image archives into containerd"
if ((${#failed[@]})); then
    err "FAILED to import: ${failed[*]}"
    exit 1
fi
