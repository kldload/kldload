#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# kvm-golden — build your own golden (or VM) from a base golden plus a
#              post-install of your own.
#
# What it does, in order:
#   1. clones the base (a klab golden by distro name, or any VM/golden by
#      name) as <name> with kvm-clone — seed ISO, root's ssh key, guest agent;
#   2. boots it and waits for an address and for root ssh to answer;
#   3. runs the post-install in the guest as root: a file streamed to
#      `bash -s`, or a --run command line, or nothing;
#   4. with --keep: leaves the machine running — that is "build your own VM";
#      otherwise shuts it down, waits, seals the zvol with kldload-seal and
#      takes <name>@golden — that is "build your own golden", which kvm-clone
#      (and kld's c) clones from.
#
# Why: the platform had thirty goldens it knew how to build and no button for
# "one like that, plus my script" — the operator's ask, 2026-09-26. Nothing
# here is new machinery: kvm-clone, kldload-vm-ip, ssh, kldload-seal, zfs.
#
# Inputs:   <name> --from <distro|vm>  [--post FILE] [--run 'cmd'] [--keep]
#           [--ram MB] [--cpus N]  (applied for the next boot via virsh)
#           A base with an @golden snapshot is cloned from that snapshot,
#           not from whatever its disk holds now.
# Outputs:  rpool/vms/<name> (+ @golden unless --keep), the domain <name>
# Exit:     0 built; 1 a step failed (the machine is left for inspection,
#           the log says which step); 2 usage
# Notes:    the base for a distro is klab-golden-<distro>, built by
#           `klab golden <distro>`. A seal needs partitions: a blank disk
#           fails it, which is what kldload-seal reports.
#           See kvm-golden(8).
# ─────────────────────────────────────────────────────────────────────────────
set -Eeuo pipefail
trap 'echo "kvm-golden: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

usage() {
    # asked for: stdout, 0; a usage error: stderr, 2
    local rc="${1:-2}"
    sed -n '2,${/^#/!q; s/^# \{0,1\}//; p}' "$0" >&$((rc == 0 ? 1 : 2))
    exit "$rc"
}
_bad() {
    echo "kvm-golden: $*" >&2
    exit 2
}
# HISTORY: with no arguments this ended in `[[ -n "" ]]` under set -e and
# exited 1 through the ERR trap, and `--ram` with no value died of the shell's
# own "parameter null or not set" (both found writing kvm-golden(8),
# 2026-09-29). Every usage error is now a message and 2.
case "${1:-}" in
-h | --help) usage 0 ;;
"") usage 2 ;;
-*) _bad "the first argument is the new machine's name, not $1" ;;
esac

# WHY a copy: the loop below shifts the options away, and the sudo re-exec
# further down passed "$NAME" "$@" -- the name alone -- so every run as a
# user failed with "--from is required".
ARGS=("$@")
NAME="$1"
shift
FROM="" POST="" RUN="" KEEP=0 RAM="" CPUS=""
_val() { [[ $# -ge 2 && -n "$2" ]] || _bad "$1 needs a value"; }
while (($#)); do
    case "$1" in
    --from)
        _val "$@"
        FROM="$2"
        shift 2
        ;;
    --post)
        _val "$@"
        POST="$2"
        shift 2
        ;;
    --run)
        _val "$@"
        RUN="$2"
        shift 2
        ;;
    --keep)
        KEEP=1
        shift
        ;;
    --ram)
        _val "$@"
        [[ "$2" =~ ^[0-9]+$ ]] && (($2 >= 256)) || _bad "--ram is MiB, a whole number of at least 256: '$2'"
        RAM="$2"
        shift 2
        ;;
    --cpus)
        _val "$@"
        [[ "$2" =~ ^[1-9][0-9]*$ ]] || _bad "--cpus is a whole number of at least 1: '$2'"
        CPUS="$2"
        shift 2
        ;;
    *)
        echo "kvm-golden: unknown option $1" >&2
        usage 2
        ;;
    esac
done
[[ "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$ ]] || {
    echo "kvm-golden: '$NAME' is not a VM name" >&2
    exit 2
}
[[ -n "$FROM" ]] || {
    echo "kvm-golden: --from <distro|vm> is required" >&2
    exit 2
}
[[ -z "$POST" || -r "$POST" ]] || {
    echo "kvm-golden: cannot read --post $POST" >&2
    exit 2
}
if ((EUID != 0)); then exec sudo -n -- "$0" "${ARGS[@]}"; fi

# the base: a distro names its klab golden; anything else must be a VM
case "$FROM" in
centos | rocky | fedora | debian | ubuntu) BASE="klab-golden-$FROM" ;;
*) BASE="$FROM" ;;
esac
virsh dominfo "$BASE" >/dev/null 2>&1 || {
    if [[ "$BASE" == klab-golden-* ]]; then
        echo "kvm-golden: no base VM '$BASE' (klab golden $FROM builds it)" >&2
    else
        echo "kvm-golden: no VM named '$BASE' to build from" >&2
    fi
    exit 1
}
if virsh dominfo "$NAME" >/dev/null 2>&1 || zfs list -H "rpool/vms/$NAME" >/dev/null 2>&1; then
    echo "kvm-golden: '$NAME' already exists" >&2
    exit 1
fi

# WHY @golden when there is one: without --snap kvm-clone snapshots the base's
# disk as it is now, and a golden that was booted after it was sealed is no
# longer the golden -- it carries that boot's identity and logs.
SNAP=()
if zfs list -H "rpool/vms/$BASE@golden" >/dev/null 2>&1; then SNAP=(--snap golden); fi
echo "== clone $BASE$( ((${#SNAP[@]})) && echo @golden) -> $NAME"
kvm-clone "$BASE" "$NAME" "${SNAP[@]}" || {
    echo "kvm-golden: kvm-clone failed; it removed what it had made" >&2
    exit 1
}
# WHY each checked on its own: as `a && b` inside an if, a failed setmaxmem
# was exempt from set -e and --ram was silently not applied. virsh prints a
# blank line for each of these on success; that is all >/dev/null drops.
_set() {
    "$@" >/dev/null || {
        echo "kvm-golden: '$*' failed; $NAME is defined, not started" >&2
        exit 1
    }
}
if [[ -n "$RAM" ]]; then
    _set virsh setmaxmem "$NAME" "${RAM}M" --config
    _set virsh setmem "$NAME" "${RAM}M" --config
fi
if [[ -n "$CPUS" ]]; then
    _set virsh setvcpus "$NAME" "$CPUS" --config --maximum
    _set virsh setvcpus "$NAME" "$CPUS" --config
fi

echo "== boot $NAME"
virsh start "$NAME" >/dev/null
IP=""
for _ in $(seq 1 120); do
    IP="$(kldload-vm-ip "$NAME" 2>/dev/null || true)"
    [[ -n "$IP" ]] && break
    sleep 2
done
[[ -n "$IP" ]] || {
    echo "kvm-golden: $NAME got no address in 4 minutes" >&2
    exit 1
}
echo "   address $IP"
SSH=(ssh -i /root/.ssh/id_ed25519 -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=5)
# a clone's host key is new every time, hence no pinning (the same choice
# kldload-enroll and the doctor make for guests)
for _ in $(seq 1 60); do
    "${SSH[@]}" "root@$IP" true 2>/dev/null && break
    sleep 3
done
"${SSH[@]}" "root@$IP" true 2>/dev/null || {
    echo "kvm-golden: root ssh to $IP never answered" >&2
    exit 1
}
"${SSH[@]}" "root@$IP" 'command -v cloud-init >/dev/null && cloud-init status --wait >/dev/null 2>&1 || true' # a base without cloud-init has nothing to wait for

if [[ -n "$POST" ]]; then
    echo "== post-install: $POST (as root in $NAME)"
    if ! "${SSH[@]}" "root@$IP" 'bash -s' <"$POST"; then
        echo "kvm-golden: the post-install failed; $NAME is left running at $IP to look at" >&2
        exit 1
    fi
fi
if [[ -n "$RUN" ]]; then
    echo "== run: $RUN"
    # the command goes down stdin to bash -s, never onto a remote argv
    if ! printf '%s\n' "$RUN" | "${SSH[@]}" "root@$IP" 'bash -s'; then
        echo "kvm-golden: the --run command failed; $NAME is left running at $IP to look at" >&2
        exit 1
    fi
fi

if ((KEEP)); then
    echo "== $NAME is running at $IP (--keep: not sealed)"
    exit 0
fi

echo "== shut $NAME down"
virsh shutdown "$NAME" >/dev/null
for _ in $(seq 1 180); do
    virsh domstate "$NAME" | grep -q 'shut off' && break
    sleep 1
done
virsh domstate "$NAME" | grep -q 'shut off' || {
    echo "kvm-golden: $NAME did not shut down in 3 minutes" >&2
    exit 1
}
echo "== seal /dev/zvol/rpool/vms/$NAME"
kldload-seal "/dev/zvol/rpool/vms/$NAME" || {
    echo "kvm-golden: the seal failed; $NAME is shut off and NOT a golden" >&2
    exit 1
}
echo "== snapshot rpool/vms/$NAME@golden"
zfs snapshot "rpool/vms/$NAME@golden"
zfs list -H "rpool/vms/$NAME@golden" >/dev/null # outcome, not exit code
echo "== $NAME@golden is a golden: kvm-clone $NAME <new> (kld: c on its row)"
