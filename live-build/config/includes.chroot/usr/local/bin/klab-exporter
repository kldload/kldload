#!/usr/bin/env python3
"""
klab-exporter — Prometheus metrics exporter for the klab estate.

Serves metrics on :9101 describing golden images, site VMs, test results,
and ZFS pool health. All data comes from ZFS, libvirt, and klab's results
directory — no agents needed, pure host-side state.

Scraped by the host Prometheus instance every 30s. Grafana dashboard
visualizes the estate in real time.
"""

import http.server
import os
import subprocess
import re
import time
import json

PORT = 9101
POOL = os.environ.get("POOL", "rpool")
PREFIX = "klab"
RESULTS_DIR = "/root/klab"
DISTROS = ["centos", "rocky", "fedora", "debian", "ubuntu", "rhel"]


def run(cmd):
    """Run a shell command, return stdout or empty string on failure."""
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=10)
        return r.stdout.strip()
    except Exception:
        return ""


def collect_metrics():
    lines = []
    lines.append("# HELP klab_info klab platform info")
    lines.append('# TYPE klab_info gauge')
    lines.append(f'klab_info{{pool="{POOL}"}} 1')

    # ── Golden images ────────────────────────────────────────────────
    lines.append("")
    lines.append("# HELP klab_golden_ready Whether golden image is ready (1=yes, 0=no)")
    lines.append("# TYPE klab_golden_ready gauge")
    lines.append("# HELP klab_golden_size_bytes Golden image disk usage in bytes")
    lines.append("# TYPE klab_golden_size_bytes gauge")
    lines.append("# HELP klab_golden_info Golden image metadata (kernel, ZFS version)")
    lines.append("# TYPE klab_golden_info gauge")

    goldens_ready = 0
    for distro in DISTROS:
        name = f"{PREFIX}-golden-{distro}"
        zpath = f"{POOL}/vms/{name}"
        snap = f"{zpath}@golden"

        rc = os.system(f"zfs list {snap} >/dev/null 2>&1")
        ready = 1 if rc == 0 else 0

        if ready:
            goldens_ready += 1
            used = run(f"zfs get -Hp -o value used {zpath}")
            kernel = ""
            zfs_ver = ""
            log_file = f"{RESULTS_DIR}/goldens/{distro}-latest.log"
            if os.path.isfile(log_file):
                with open(log_file, "r") as f:
                    for line in f:
                        if "Kernel:" in line and not kernel:
                            kernel = line.split("Kernel:")[-1].strip()[:40]
                        if "ZFS version:" in line and not zfs_ver:
                            zfs_ver = line.split("ZFS version:")[-1].strip()[:20]
            if not kernel:
                kernel = "unknown"
            if not zfs_ver:
                zfs_ver = "unknown"
            lines.append(f'klab_golden_ready{{distro="{distro}",kernel="{kernel}",zfs="{zfs_ver}"}} 1')
            if used.isdigit():
                lines.append(f'klab_golden_size_bytes{{distro="{distro}"}} {used}')
            lines.append(f'klab_golden_info{{distro="{distro}",kernel="{kernel}",zfs="{zfs_ver}",size="{used}"}} 1')
        else:
            lines.append(f'klab_golden_ready{{distro="{distro}",kernel="",zfs=""}} 0')

    lines.append("")
    lines.append("# HELP klab_goldens_ready_total Number of ready golden images")
    lines.append("# TYPE klab_goldens_ready_total gauge")
    lines.append(f"klab_goldens_ready_total {goldens_ready}")
    lines.append(f"klab_distros_total {len(DISTROS)}")

    # ── Site VMs ─────────────────────────────────────────────────────
    lines.append("")
    lines.append("# HELP klab_site_vm_running Whether site VM is running (1=yes, 0=no)")
    lines.append("# TYPE klab_site_vm_running gauge")

    for site in ["blue", "green"]:
        for distro in DISTROS:
            sname = f"{PREFIX}-{site}-{distro}"
            state = run(f"virsh domstate {sname} 2>/dev/null")
            running = 1 if state == "running" else 0
            lines.append(f'klab_site_vm_running{{site="{site}",distro="{distro}"}} {running}')

    # ── Test VMs ─────────────────────────────────────────────────────
    lines.append("")
    lines.append("# HELP klab_test_vm_running Whether test VM is running")
    lines.append("# TYPE klab_test_vm_running gauge")
    for distro in DISTROS:
        tname = f"{PREFIX}-test-{distro}"
        state = run(f"virsh domstate {tname} 2>/dev/null")
        running = 1 if state == "running" else 0
        lines.append(f'klab_test_vm_running{{distro="{distro}"}} {running}')

    # ── Test results (latest run) ────────────────────────────────────
    latest_link = f"{RESULTS_DIR}/latest"
    if os.path.islink(latest_link):
        run_dir = os.path.realpath(latest_link)
        run_id = os.path.basename(run_dir)

        lines.append("")
        lines.append("# HELP klab_test_pass_total Tests passed in latest run")
        lines.append("# TYPE klab_test_pass_total gauge")
        lines.append("# HELP klab_test_fail_total Tests failed in latest run")
        lines.append("# TYPE klab_test_fail_total gauge")
        lines.append("# HELP klab_test_skip_total Tests skipped in latest run")
        lines.append("# TYPE klab_test_skip_total gauge")

        for f in sorted(os.listdir(run_dir)):
            if f.endswith(".summary"):
                summary = {}
                with open(os.path.join(run_dir, f)) as sf:
                    for line in sf:
                        if "=" in line:
                            k, v = line.strip().split("=", 1)
                            summary[k] = v
                d = summary.get("distro", f.replace(".summary", ""))
                lines.append(f'klab_test_pass_total{{distro="{d}",run="{run_id}"}} {summary.get("pass", 0)}')
                lines.append(f'klab_test_fail_total{{distro="{d}",run="{run_id}"}} {summary.get("fail", 0)}')
                lines.append(f'klab_test_skip_total{{distro="{d}",run="{run_id}"}} {summary.get("skip", 0)}')

    # ── ZFS pool health ──────────────────────────────────────────────
    lines.append("")
    lines.append("# HELP klab_pool_size_bytes Total pool size")
    lines.append("# TYPE klab_pool_size_bytes gauge")
    lines.append("# HELP klab_pool_used_bytes Pool used space")
    lines.append("# TYPE klab_pool_used_bytes gauge")
    lines.append("# HELP klab_pool_free_bytes Pool free space")
    lines.append("# TYPE klab_pool_free_bytes gauge")

    pool_size = run(f"zfs get -Hp -o value available {POOL}")
    pool_used = run(f"zfs get -Hp -o value used {POOL}")
    if pool_size.isdigit():
        lines.append(f'klab_pool_free_bytes{{pool="{POOL}"}} {pool_size}')
    if pool_used.isdigit():
        lines.append(f'klab_pool_used_bytes{{pool="{POOL}"}} {pool_used}')
        if pool_size.isdigit():
            lines.append(f'klab_pool_size_bytes{{pool="{POOL}"}} {int(pool_size) + int(pool_used)}')

    # Pool health
    health = run(f"zpool get -H -o value health {POOL}")
    healthy = 1 if health == "ONLINE" else 0
    lines.append(f'klab_pool_healthy{{pool="{POOL}"}} {healthy}')

    # Pool compression ratio
    compratio = run(f"zfs get -Hp -o value compressratio {POOL}")
    try:
        lines.append(f'klab_pool_compress_ratio{{pool="{POOL}"}} {float(compratio.replace("x",""))}')
    except (ValueError, AttributeError):
        pass

    # Pool fragmentation
    frag = run(f"zpool list -Hp -o frag {POOL}")
    try:
        lines.append(f'klab_pool_fragmentation{{pool="{POOL}"}} {int(frag.replace("%",""))}')
    except (ValueError, AttributeError):
        pass

    # ── ZFS ARC stats (from /proc/spl/kstat/zfs/arcstats) ───────────
    lines.append("")
    lines.append("# HELP klab_zfs_arc_hits_total ARC cache hits")
    lines.append("# TYPE klab_zfs_arc_hits_total counter")
    lines.append("# HELP klab_zfs_arc_misses_total ARC cache misses")
    lines.append("# TYPE klab_zfs_arc_misses_total counter")
    lines.append("# HELP klab_zfs_arc_size_bytes Current ARC size")
    lines.append("# TYPE klab_zfs_arc_size_bytes gauge")
    lines.append("# HELP klab_zfs_arc_target_bytes ARC target size (c)")
    lines.append("# TYPE klab_zfs_arc_target_bytes gauge")
    lines.append("# HELP klab_zfs_arc_max_bytes ARC max size (c_max)")
    lines.append("# TYPE klab_zfs_arc_max_bytes gauge")
    lines.append("# HELP klab_zfs_arc_min_bytes ARC min size (c_min)")
    lines.append("# TYPE klab_zfs_arc_min_bytes gauge")
    lines.append("# HELP klab_zfs_arc_hit_ratio ARC hit ratio (0-1)")
    lines.append("# TYPE klab_zfs_arc_hit_ratio gauge")
    lines.append("# HELP klab_zfs_arc_mru_size_bytes MRU (recently used) size")
    lines.append("# TYPE klab_zfs_arc_mru_size_bytes gauge")
    lines.append("# HELP klab_zfs_arc_mfu_size_bytes MFU (frequently used) size")
    lines.append("# TYPE klab_zfs_arc_mfu_size_bytes gauge")
    lines.append("# HELP klab_zfs_arc_evict_total Total ARC evictions")
    lines.append("# TYPE klab_zfs_arc_evict_total counter")
    lines.append("# HELP klab_zfs_arc_l2_hits_total L2ARC hits")
    lines.append("# TYPE klab_zfs_arc_l2_hits_total counter")
    lines.append("# HELP klab_zfs_arc_l2_misses_total L2ARC misses")
    lines.append("# TYPE klab_zfs_arc_l2_misses_total counter")
    lines.append("# HELP klab_zfs_arc_demand_hits_total Demand data hits")
    lines.append("# TYPE klab_zfs_arc_demand_hits_total counter")
    lines.append("# HELP klab_zfs_arc_prefetch_hits_total Prefetch hits")
    lines.append("# TYPE klab_zfs_arc_prefetch_hits_total counter")

    arcstats = {}
    try:
        with open("/proc/spl/kstat/zfs/arcstats") as f:
            for line in f:
                parts = line.split()
                if len(parts) == 3 and parts[1].isdigit():
                    arcstats[parts[0]] = int(parts[2])
    except FileNotFoundError:
        pass

    if arcstats:
        hits = arcstats.get("hits", 0)
        misses = arcstats.get("misses", 0)
        lines.append(f"klab_zfs_arc_hits_total {hits}")
        lines.append(f"klab_zfs_arc_misses_total {misses}")
        total = hits + misses
        if total > 0:
            lines.append(f"klab_zfs_arc_hit_ratio {hits / total:.4f}")

        for key, metric in [
            ("size", "klab_zfs_arc_size_bytes"),
            ("c", "klab_zfs_arc_target_bytes"),
            ("c_max", "klab_zfs_arc_max_bytes"),
            ("c_min", "klab_zfs_arc_min_bytes"),
            ("mru_size", "klab_zfs_arc_mru_size_bytes"),
            ("mfu_size", "klab_zfs_arc_mfu_size_bytes"),
            ("evict_l2_eligible", "klab_zfs_arc_evict_total"),
            ("l2_hits", "klab_zfs_arc_l2_hits_total"),
            ("l2_misses", "klab_zfs_arc_l2_misses_total"),
            ("demand_data_hits", "klab_zfs_arc_demand_hits_total"),
            ("prefetch_data_hits", "klab_zfs_arc_prefetch_hits_total"),
        ]:
            if key in arcstats:
                lines.append(f"{metric} {arcstats[key]}")

    # ── ZFS I/O stats (zpool iostat) ─────────────────────────────────
    lines.append("")
    lines.append("# HELP klab_zfs_pool_read_ops Pool read operations per second")
    lines.append("# TYPE klab_zfs_pool_read_ops gauge")
    lines.append("# HELP klab_zfs_pool_write_ops Pool write operations per second")
    lines.append("# TYPE klab_zfs_pool_write_ops gauge")
    lines.append("# HELP klab_zfs_pool_read_bw_bytes Pool read bandwidth bytes/sec")
    lines.append("# TYPE klab_zfs_pool_read_bw_bytes gauge")
    lines.append("# HELP klab_zfs_pool_write_bw_bytes Pool write bandwidth bytes/sec")
    lines.append("# TYPE klab_zfs_pool_write_bw_bytes gauge")

    iostat = run(f"zpool iostat -Hp {POOL} 1 2 2>/dev/null | tail -1")
    if iostat:
        parts = iostat.split()
        if len(parts) >= 7:
            try:
                lines.append(f'klab_zfs_pool_read_ops{{pool="{POOL}"}} {int(parts[3])}')
                lines.append(f'klab_zfs_pool_write_ops{{pool="{POOL}"}} {int(parts[4])}')
                lines.append(f'klab_zfs_pool_read_bw_bytes{{pool="{POOL}"}} {int(parts[5])}')
                lines.append(f'klab_zfs_pool_write_bw_bytes{{pool="{POOL}"}} {int(parts[6])}')
            except (ValueError, IndexError):
                pass

    # ── ZFS dataset stats (per-dataset usage) ────────────────────────
    lines.append("")
    lines.append("# HELP klab_zfs_dataset_used_bytes Dataset used space")
    lines.append("# TYPE klab_zfs_dataset_used_bytes gauge")
    lines.append("# HELP klab_zfs_dataset_refer_bytes Dataset referenced space")
    lines.append("# TYPE klab_zfs_dataset_refer_bytes gauge")
    lines.append("# HELP klab_zfs_dataset_compress_ratio Dataset compression ratio")
    lines.append("# TYPE klab_zfs_dataset_compress_ratio gauge")

    ds_output = run(f"zfs list -Hp -o name,used,refer,compressratio -r {POOL} -t filesystem,volume 2>/dev/null")
    for line in ds_output.split("\n"):
        parts = line.split("\t")
        if len(parts) >= 4:
            dsname = parts[0]
            # Only export klab-relevant datasets
            if "klab" in dsname or dsname == POOL or dsname.startswith(f"{POOL}/ROOT") or dsname.startswith(f"{POOL}/vms"):
                short = dsname.replace(f"{POOL}/", "")
                try:
                    lines.append(f'klab_zfs_dataset_used_bytes{{dataset="{short}"}} {int(parts[1])}')
                    lines.append(f'klab_zfs_dataset_refer_bytes{{dataset="{short}"}} {int(parts[2])}')
                    cr = float(parts[3].replace("x", ""))
                    lines.append(f'klab_zfs_dataset_compress_ratio{{dataset="{short}"}} {cr}')
                except (ValueError, IndexError):
                    pass

    # ── ZFS snapshot count per dataset ───────────────────────────────
    lines.append("")
    lines.append("# HELP klab_zfs_snapshot_count Number of snapshots per dataset")
    lines.append("# TYPE klab_zfs_snapshot_count gauge")
    snap_output = run(f"zfs list -Hp -o name -t snapshot -r {POOL}/vms 2>/dev/null")
    snap_counts = {}
    for line in snap_output.split("\n"):
        if "@" in line:
            ds = line.split("@")[0].replace(f"{POOL}/", "")
            snap_counts[ds] = snap_counts.get(ds, 0) + 1
    for ds, count in snap_counts.items():
        lines.append(f'klab_zfs_snapshot_count{{dataset="{ds}"}} {count}')

    # ── ZFS txg (transaction group) stats ────────────────────────────
    lines.append("")
    lines.append("# HELP klab_zfs_txg_synced_total Total synced transaction groups")
    lines.append("# TYPE klab_zfs_txg_synced_total counter")
    try:
        with open("/proc/spl/kstat/zfs/dmu_tx") as f:
            for line in f:
                parts = line.split()
                if len(parts) == 3 and parts[0] == "dmu_tx_assigned":
                    lines.append(f"klab_zfs_txg_synced_total {int(parts[2])}")
    except FileNotFoundError:
        pass

    # ── Host info ────────────────────────────────────────────────────
    lines.append("")
    lines.append("# HELP klab_host_cpus Number of host CPUs")
    lines.append("# TYPE klab_host_cpus gauge")
    cpus = run("nproc")
    if cpus.isdigit():
        lines.append(f"klab_host_cpus {cpus}")

    ram_kb = run("awk '/MemTotal/ {print $2}' /proc/meminfo")
    if ram_kb.isdigit():
        lines.append(f"klab_host_ram_bytes {int(ram_kb) * 1024}")

    # GPU
    gpu = run("lspci 2>/dev/null | grep -ci nvidia")
    lines.append(f"klab_host_gpu_detected {1 if gpu and int(gpu) > 0 else 0}")

    lines.append("")
    return "\n".join(lines) + "\n"


class MetricsHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/metrics" or self.path == "/":
            body = collect_metrics()
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; version=0.0.4; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body.encode())
        else:
            self.send_response(404)
            self.end_headers()

    def log_message(self, format, *args):
        pass  # suppress access logs


if __name__ == "__main__":
    server = http.server.HTTPServer(("0.0.0.0", PORT), MetricsHandler)
    print(f"klab-exporter serving on :{PORT}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
