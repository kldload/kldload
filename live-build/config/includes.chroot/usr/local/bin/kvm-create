#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# kvm-create — create a KVM virtual machine whose disk is a ZFS zvol.
#
#   1. checks the name and every value before touching anything;
#   2. creates rpool/vms/<name>, thin and compressed, and waits for its device;
#   3. defines and starts the VM with virt-install (UEFI, q35, virtio disk with
#      discard, virtio NIC on a bridge, VNC console);
#   4. destroys the zvol again if virt-install fails;
#   5. registers the VM in the kldload state DB, so the estate and the
#      Ansible inventory see it.
#
# WHY a zvol and not a qcow2 file: the disk is then a ZFS dataset -- snapshot
# (kvm-snap), clone (kvm-clone), send and replicate it like any other.
# Man page: kvm-create(8).
#
# Exit: 0 created, 1 zvol or virt-install failed, 2 usage error (a missing or
# bad value, an unknown flag, no name, a name that is not a plain name).
# ─────────────────────────────────────────────────────────────────────────────
set -Eeuo pipefail
trap 'echo "kvm-create: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

# Auto-elevate to root (ZFS + libvirt require it)
# Rule 9: -h/--help answers BEFORE this re-exec. Asking a tool to explain
# itself must never need a password, and on a machine where the operator has
# no sudo rights the tool could not describe itself at all. Proven by running
# each one with a stub sudo on PATH: eight asked for root to print text
# (swept 2026-09-16, same defect klab had).
if [[ $EUID -ne 0 && "${1:-}" != -h && "${1:-}" != --help ]]; then exec sudo "$0" "$@"; fi

usage() {
    cat <<EOF
Usage: kvm-create <name> [options]

Options:
  --ram    <MB>       RAM in MB (default: 2048)
  --cpus   <N>        vCPUs (default: 2)
  --disk   <GB>       Disk size in GB (default: 20)
  --iso    <path>     Boot ISO (optional)
  --bridge <name>     Bridge interface (default: br0)
  --os     <variant>  OS variant for virt-install (default: generic);
                      (osinfo-query os lists them)
  --vnc-listen <addr> address the VM's VNC console listens on (default:
                      0.0.0.0, every interface, no password -- anyone who
                      can reach this host can see the console; 127.0.0.1
                      keeps it local, reached with an ssh tunnel)
  --volblocksize <sz> zvol block size (default: 64K). 64K favours
                      sequential I/O, compression and clone efficiency;
                      pick 8K-16K for guests running databases with
                      small random writes (PostgreSQL/MySQL).

Examples:
  kvm-create myvm
  kvm-create webserver --ram 4096 --cpus 4 --disk 40
  kvm-create testbox --iso /tmp/debian.iso --ram 2048
  kvm-create pgbox --disk 60 --volblocksize 16K

The VM disk is a ZFS zvol at rpool/vms/<name> — thin provisioned,
compressed, snapshotable. Clone with kvm-clone, snapshot with kvm-snap.

A name is letters, digits, '.', '_' and '-', starting with a letter or digit.

Exit: 0 created, 1 zvol or virt-install failed, 2 usage error (a missing or
bad value, an unknown flag, no name, a name that is not a plain name).
EOF
    # asked-for help is 0; a usage error is 2, distinct from a create that
    # ran and failed (1).
    exit "${1:-2}"
}

# _need_value FLAG VALUE — a flag given as the last word, or followed by
# another flag, is a usage error with the flag's name in it. Under set -u the
# bare "$2" used to die with "unbound variable" instead (2026-09-23).
_need_value() {
    [[ -n "${2:-}" && "${2:-}" != -* ]] || {
        echo "kvm-create: $1 needs a value" >&2
        usage
    }
}

[[ $# -lt 1 ]] && usage
# A leading dash is a flag, never a VM name — without this, `kvm-create --help`
# creates (and then has to clean up) a zvol literally named "--help".
# --help is an answer; a mistyped flag is an error. Same function, different
# exit code -- they were indistinguishable before.
[[ "$1" == -h || "$1" == --help ]] && usage 0
[[ "$1" == -* ]] && usage
NAME="$1"
shift
# SAFETY: the name becomes a dataset path (rpool/vms/<name>) and a libvirt
# domain. A "/" would create a nested dataset, ".." or a leading dash worse.
if ! [[ "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$ ]]; then
    echo "kvm-create: '${NAME}' is not a plain name (letters, digits, . _ -)" >&2
    usage
fi

RAM=2048
CPUS=2
DISK=20
ISO=""
BRIDGE="br0"
OS_VARIANT="generic"
VOLBLOCK="64K"
VNC_LISTEN="0.0.0.0"

while [[ $# -gt 0 ]]; do
    case "$1" in
    --ram)
        _need_value "$1" "${2:-}"
        RAM="$2"
        shift 2
        ;;
    --cpus)
        _need_value "$1" "${2:-}"
        CPUS="$2"
        shift 2
        ;;
    --disk)
        _need_value "$1" "${2:-}"
        DISK="$2"
        shift 2
        ;;
    --iso)
        _need_value "$1" "${2:-}"
        ISO="$2"
        shift 2
        ;;
    --bridge)
        _need_value "$1" "${2:-}"
        BRIDGE="$2"
        shift 2
        ;;
    --os)
        _need_value "$1" "${2:-}"
        OS_VARIANT="$2"
        shift 2
        ;;
    --volblocksize)
        _need_value "$1" "${2:-}"
        VOLBLOCK="$2"
        shift 2
        ;;
    --vnc-listen)
        _need_value "$1" "${2:-}"
        VNC_LISTEN="$2"
        shift 2
        ;;
    *)
        echo "kvm-create: unknown option: $1" >&2
        usage
        ;;
    esac
done

ZVOL="rpool/vms/${NAME}"

# Every value is checked before anything is created. These are usage errors
# (exit 2, on stderr); they printed to stdout and exited 1, like a create
# that had run and failed.
_bad() {
    echo "kvm-create: $*" >&2
    exit 2
}
[[ "$DISK" =~ ^[0-9]+$ ]] && ((DISK > 0)) || _bad "--disk must be a positive number of GB (got: ${DISK})"
[[ "$RAM" =~ ^[0-9]+$ ]] && ((RAM >= 64)) || _bad "--ram must be a number of MB, 64 or more (got: ${RAM})"
[[ "$CPUS" =~ ^[0-9]+$ ]] && ((CPUS > 0)) || _bad "--cpus must be a positive number (got: ${CPUS})"
# zfs create still enforces the real constraint (a power of two, 512B-1M)
[[ "$VOLBLOCK" =~ ^[0-9]+[kKmM]?$ ]] || _bad "--volblocksize must look like 8K, 16K or 64K (got: ${VOLBLOCK})"
[[ -z "$ISO" || -r "$ISO" ]] || _bad "--iso ${ISO}: no such readable file"
[[ "$VNC_LISTEN" =~ ^[0-9.]+$|^[0-9a-fA-F:]+$ ]] || _bad "--vnc-listen must be an address (got: ${VNC_LISTEN})"

# Check if zvol already exists
if zfs list "${ZVOL}" >/dev/null 2>&1; then
    echo "kvm-create: ${ZVOL} already exists; pick another name or kvm-delete it first" >&2
    exit 1
fi

# A marker of when the VM was created, on the PARENT dataset. It is not
# recursive and holds none of any VM's disk -- it was called a "safety net",
# which it is not (man page review, 2026-09-29).
zfs snapshot "rpool/vms@pre-create-${NAME}" 2>/dev/null ||
    true # a leftover marker of the same name from an earlier VM: nothing lost
# the last ten; one per VM ever created was kept (source audit 2026-09-26)
if [[ -x /usr/local/sbin/snapshot-prune.sh ]]; then
    /usr/local/sbin/snapshot-prune.sh rpool/vms pre-create- 10 >/dev/null 2>&1 ||
        echo "kvm-create: could not prune rpool/vms@pre-create- snapshots" >&2
fi

# Create thin-provisioned zvol. Compression is inherited from rpool/vms
# (lz4) — the old local compression=off contradicted the "compressed" promise
# in the usage text and threw away free space savings on thin volumes.
# 64K volblocksize matches qcow2 cluster size for efficient raw import.
echo "Creating ZFS zvol: ${ZVOL} (${DISK}G, thin provisioned, volblocksize=${VOLBLOCK})..."
zfs create -V "${DISK}G" -s -o volblocksize="${VOLBLOCK}" "${ZVOL}"

# Wait for zvol device node to appear
for _i in $(seq 1 30); do
    [[ -e "/dev/zvol/${ZVOL}" ]] && break
    sleep 0.1
done
if [[ ! -e "/dev/zvol/${ZVOL}" ]]; then
    echo "ERROR: /dev/zvol/${ZVOL} did not appear after 3 seconds"
    exit 1
fi

# Build virt-install command
CMD=(virt-install
    --name "${NAME}"
    --ram "${RAM}"
    --vcpus "${CPUS}"
    --cpu host-model
    --machine q35
    # discard=unmap: guest TRIM punches holes in the thin zvol so deleted
    # guest data returns space to the pool instead of leaking forever
    --disk "source.dev=/dev/zvol/${ZVOL},type=block,bus=virtio,cache=none,discard=unmap"
    --network "bridge=${BRIDGE},model=virtio"
    --graphics "vnc,listen=${VNC_LISTEN}"
    --os-variant "${OS_VARIANT}"
    --noautoconsole
)

if [[ -n "$ISO" ]]; then
    # shellcheck disable=SC2054 # uefi,cdrom,hd is ONE virt-install argument
    CMD+=(--cdrom "${ISO}" --boot uefi,cdrom,hd)
else
    CMD+=(--boot uefi --import)
fi

echo "Creating VM: ${NAME} (${RAM}MB RAM, ${CPUS} vCPUs, ${DISK}GB disk)..."
if ! "${CMD[@]}"; then
    echo "kvm-create: virt-install failed; destroying ${ZVOL}" >&2
    zfs destroy "${ZVOL}" ||
        echo "kvm-create: could not destroy ${ZVOL} -- remove it by hand: zfs destroy ${ZVOL}" >&2
    exit 1
fi

echo ""
echo "VM '${NAME}' created"
echo "  Disk:    /dev/zvol/${ZVOL}"
echo "  Console: virsh console ${NAME}"
echo "  VNC:     virsh vncdisplay ${NAME}"
echo "  Snap:    kvm-snap ${NAME}"
echo "  Clone:   kvm-clone ${NAME} <new-name>"

# Register with kldload state DB so the dynamic Ansible inventory sees it.
# A failed registration must not undo a working VM, but it is said: a VM the
# DB never heard of is missing from the estate and from Ansible.
if command -v kldload-db >/dev/null 2>&1; then
    kldload-db vm-register --name "${NAME}" --cpu "${CPUS}" --ram-gb "$((RAM / 1024))" \
        --disk-gb "${DISK}" --status "defined" >/dev/null ||
        echo "kvm-create: WARNING: ${NAME} is not in the kldload state DB (kldload-db vm-register failed)" >&2
    kldload-db event --type "vm" --subject "${NAME}" \
        --message "kvm-create: ${RAM}MB / ${CPUS}vCPU / ${DISK}GB disk" >/dev/null ||
        echo "kvm-create: WARNING: could not record the create event" >&2
fi
