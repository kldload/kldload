#!/usr/bin/env bash
# kldload-sysdiag-launch — open kldload-sysdiag in a terminal window.
#
# PRIMARY terminal is gnome-terminal: it's GNOME-native, ships on every
# kldload desktop install (and is in the offline darksite mirror), and its
# default profile follows the GTK theme so it tracks GNOME's light/dark
# preference without any extra color-scheme files to install.
#
# WHY NOT konsole anymore: konsole carries the kldload-{dark,light} color
# schemes, but it drags in the entire ~135-package KDE stack and is NOT in
# the Fedora darksite — so on F44 its install flaked three times and left
# the box with no konsole at all (10.100.10.124 2026-06-14). gnome-terminal
# was already present and is the lean, reliable default. konsole is kept
# ONLY as a fallback for boxes that happen to have it, where it still gets
# the matching color scheme.
#
# GNOME's color-scheme key reports:
#   'prefer-dark' → user explicitly wants dark
#   'default'     → light (or system default which is currently light)
#   'prefer-light'→ user explicitly wants light (rare)
set -u

SYSDIAG=/usr/local/bin/kldload-sysdiag

# Resolve GNOME's light/dark preference once — used ONLY by the konsole
# fallback's ColorScheme. gnome-terminal follows the GTK theme itself, so
# it needs no explicit scheme here.
SCHEME=kldload-dark
if command -v gsettings >/dev/null 2>&1; then
    cs="$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d "'")"
    case "$cs" in
    default | prefer-light) SCHEME=kldload-light ;;
    prefer-dark | *) SCHEME=kldload-dark ;;
    esac
fi

# gnome-terminal first. 200x60 chars (~1600x900 px) is the size the tmux
# F-key layout in sysdiag was designed around.
# ── Window size: maximize, do not guess ──────────────────────────────
# --geometry=200x60 was a request, not a guarantee. A Wayland compositor
# may ignore the size hint, and where it is honoured 200 columns is wider
# than many screens so the window manager clamps it — landing two screen
# sizes short of what the cheatsheet needs, which is what the operator
# reported (2026-08-10: "sysdiag also starts 2 resolutions too small").
#
# --maximize asks for the whole screen instead, which is what a cockpit
# wants anyway and cannot be clamped into something too small. It is kept
# alongside --geometry so a compositor that honours neither still gets a
# sensible fallback size rather than 80x24.
#
# _sysdiag-home adapts its layout to whatever width actually arrives, so
# a terminal that ignores both still renders a readable sheet.
if command -v gnome-terminal >/dev/null 2>&1; then
    exec gnome-terminal --maximize --geometry=200x60 -- "$SYSDIAG"
fi

# Fallbacks, in order of preference, so sysdiag ALWAYS opens:
#   ptyxis / gnome-console (kgx) — GNOME's newer terminals; some F44 spins
#     ship ptyxis in place of gnome-terminal.
#   konsole — only if present; still gets the matching kldload color scheme.
#     Opens as a normal window (no --fullscreen, no --hide-menubar): the
#     menubar carries Copy/Paste/Find and --fullscreen stripped the window
#     min/max/close buttons (operator on .142 b644 2026-06-07).
#   xterm — universal last resort.
for _t in ptyxis gnome-console kgx konsole xterm; do
    command -v "$_t" >/dev/null 2>&1 || continue
    case "$_t" in
    ptyxis) exec ptyxis --maximize -- "$SYSDIAG" ;;
    gnome-console | kgx) exec "$_t" --maximize -e "$SYSDIAG" ;;
    konsole) exec konsole -p TerminalColumns=200 -p TerminalRows=60 -p ColorScheme="$SCHEME" -e "$SYSDIAG" ;;
    xterm) exec xterm -maximized -e "$SYSDIAG" ;;
    esac
done
echo "kldload-sysdiag-launch: no terminal emulator found (install gnome-terminal or konsole)" >&2
exit 1
