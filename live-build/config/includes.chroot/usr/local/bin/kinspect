#!/usr/bin/env bash
# kinspect — 3-pane tmux layout for watching communications between two
# endpoints. Resolves libvirt VMs or K8s pods to IPs, SSH's into each for
# a live watch view, and tails the flow stream between them in a third
# pane. The tmux work targets the kldload session (same one used by the
# web UI's terminal drawer) so the layout appears the moment the user
# opens the drawer.
#
# Usage:
#   kinspect <vm1> <vm2>                      # libvirt domains by name
#   kinspect --pod ns/pod1 ns/pod2            # k8s pods
#   kinspect --ip 192.168.122.10 192.168.122.11  # raw IPs (bypass lookup)
#
# Layout (the flows pane is the big one; the watches run ON each endpoint):
#   ┌───────────────────────────┐
#   │ flows between them        │
#   │ (hubble or tcpdump)       │
#   ├─────────────┬─────────────┤
#   │ vm1: watch  │ vm2: watch  │
#   │ ss -tn + io │ ss -tn + io │
#   └─────────────┴─────────────┘

set -Eeuo pipefail
# The system libvirt when a user runs this: plain virsh as a user asks that
# user's session libvirt and sees no VMs (2026-09-30, the class fixed across
# the kvm tools).
export LIBVIRT_DEFAULT_URI="${LIBVIRT_DEFAULT_URI:-qemu:///system}"

# This file's own options line is `set -uo pipefail`, and that is the author's
# intent. The 2026-09-15 strict sweep put `set -Eeuo pipefail` above it, which
# additionally forced errexit here; a LATER set line cannot clear an
# option an earlier one set, so the file ran that way regardless. That is the
# mechanic that killed build 21 on onyx through dracut. The drop has to be
# explicit. See project_strict-sweep-overrode-soft-set-lines.
set +e +E

SESSION="${KLDLOAD_TMUX_SESSION:-kldload}"
WINDOW="inspect"
SSH_KEY="${SSH_KEY:-/root/.ssh/id_ed25519}"
SSH_OPTS=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
    -o LogLevel=ERROR -o ConnectTimeout=5)

die() {
    echo "kinspect: $*" >&2
    exit 1
}

mode="vm"
case "${1:-}" in
--pod)
    mode="pod"
    shift
    ;;
--ip)
    mode="ip"
    shift
    ;;
-h | --help | "")
    # the banner starts on line 2; line 1 is the shebang, which came out as "!/usr/bin/env bash"
    sed -n '2,/^$/{s/^# \{0,1\}//; p}' "$0" | head -30
    exit 0
    ;;
esac
[[ $# -eq 2 ]] || {
    echo "kinspect: need two ${mode}s (got $#)" >&2
    exit 2 # usage error; nothing was started
}
t1="$1"
t2="$2"

# ── Resolve to IPs ─────────────────────────────────────────────────────
resolve_vm_ip() {
    local name="$1" ip=""
    # The one resolver every VM tool uses (guest agent, then lease, on the
    # system libvirt); this carried its own copy of half of it.
    if command -v kldload-vm-ip >/dev/null 2>&1; then
        ip="$(kldload-vm-ip "$name" 2>/dev/null || true)"
    else
        ip="$(virsh domifaddr "$name" 2>/dev/null | awk '/ipv4/ {split($4,a,"/"); print a[1]; exit}')"
    fi
    echo "$ip"
}
resolve_pod_ip() {
    # Two statements: in one `local` every word is expanded before any is
    # assigned, so ns and pod came out empty and --pod never resolved a pod
    # (2026-09-30, SC2318).
    local nspod="$1"
    local ns="${nspod%%/*}" pod="${nspod##*/}"
    kubectl -n "$ns" get pod "$pod" -o jsonpath='{.status.podIP}' 2>/dev/null
}

case "$mode" in
vm)
    ip1="$(resolve_vm_ip "$t1")" || true
    ip2="$(resolve_vm_ip "$t2")" || true
    ;;
pod)
    ip1="$(resolve_pod_ip "$t1")" || true
    ip2="$(resolve_pod_ip "$t2")" || true
    ;;
ip)
    ip1="$t1"
    ip2="$t2"
    ;;
esac
[[ -n "$ip1" ]] || die "could not resolve $t1 to an IP"
[[ -n "$ip2" ]] || die "could not resolve $t2 to an IP"
# SAFETY: both addresses are typed into a shell below. An address is digits,
# dots, colons and hex; anything else is refused rather than quoted around.
for _ip in "$ip1" "$ip2"; do
    [[ "$_ip" =~ ^[0-9A-Fa-f.:]+$ ]] || die "not an IP address: $_ip"
done

echo "kinspect: $t1 ($ip1)  ↔  $t2 ($ip2)"

# ── Build watch + flows commands ───────────────────────────────────────
# Top panes — each runs ON its endpoint: ssh as root for a VM or an address,
# kubectl exec for a pod. A rotating view of established TCP sessions, link
# counters and the top processes, refreshed every second.
# HISTORY: until 2026-09-30 this ran `watch` in the pane itself, on the HOST:
# both panes were labelled with a VM's name and address and showed the
# hypervisor's own sessions and processes. SSH_KEY and SSH_OPTS were defined
# for the ssh the header promised and never used.
# Every value typed into a pane goes through printf %q: a pane is a shell.
_WATCH_REMOTE='echo "=== TCP sessions ==="; ss -tnp 2>/dev/null | head -30; echo ""; echo "=== Link counters ==="; ip -s link show 2>/dev/null | head -12; echo ""; echo "=== Load / Top ==="; uptime; echo ""; ps -eo pid,%cpu,%mem,comm --sort=-%cpu | head -6'
_POD_LOOP='while true; do clear; echo "=== TCP sessions ==="; (ss -tn 2>/dev/null || netstat -tn 2>/dev/null || cat /proc/net/tcp) | head -30; sleep 1; done'
_watch_cmd() {
    local ip="$1" label="$2" banner
    banner="─── ${label} (${ip}) ─────────────────────────────────────"
    printf 'clear; echo %q\n' "$banner"
    if [[ "$mode" == pod ]]; then
        local ns="${label%%/*}" pod="${label##*/}"
        printf 'kubectl -n %q exec -it %q -- sh -c %q || echo %q\n' \
            "$ns" "$pod" "$_POD_LOOP" "kinspect: could not exec into ${label}"
    else
        printf 'ssh -t -i %q' "$SSH_KEY"
        printf ' %q' "${SSH_OPTS[@]}" "root@${ip}" "watch -t -n 1 $(printf '%q' "$_WATCH_REMOTE")"
        printf ' || echo %q\n' "kinspect: could not ssh to root@${ip} with ${SSH_KEY}"
    fi
}

# Bottom pane — prefer hubble (cilium clusters) since it's pod-aware and
# emits both L3/L4 and L7 (HTTP, DNS). Falls back to tcpdump on the host
# bridge (virbr0) when hubble isn't available or the targets aren't pods.
_flows_cmd() {
    cat <<'FLOWS'
clear
if kubectl -n kube-system exec ds/cilium -c cilium-agent -- hubble --help >/dev/null 2>&1; then
    echo "─── Hubble flows ${IP1} ↔ ${IP2} ───────────────────────"
    kubectl -n kube-system exec ds/cilium -c cilium-agent -- \
        hubble observe --follow --output compact \
            --ip "${IP1}" --ip "${IP2}"
else
    echo "─── tcpdump virbr0 ${IP1} ↔ ${IP2} ───────────────────────"
    sudo tcpdump -i virbr0 -nn -l "host ${IP1} and host ${IP2}"
fi
FLOWS
}

# ── Drive tmux ─────────────────────────────────────────────────────────
# Start (or attach to) the kldload session, blow away any previous
# inspect window, create fresh, split into the 3-pane layout, and send
# the commands to each pane.
#
# Panes are addressed by their ids (%N), never by index. kldload's own
# .tmux.conf sets pane-base-index 1, so ".0" named no pane: the flows split
# and the flows command both failed with "can't find pane: 0" and the window
# had two panes, not three (onyx, 2026-09-30; kst-dashboard met the same).
if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux new-session -d -s "$SESSION" -n shell
fi
# absent on the first run: nothing to kill
tmux kill-window -t "${SESSION}:${WINDOW}" 2>/dev/null || true
# The first pane is the flows pane; main-horizontal makes the first pane the
# big one across the top, with the two watches side by side below it.
p_flows="$(tmux new-window -P -F '#{pane_id}' -t "${SESSION}:" -n "$WINDOW")"
p_one="$(tmux split-window -P -F '#{pane_id}' -v -t "$p_flows")"
p_two="$(tmux split-window -P -F '#{pane_id}' -h -t "$p_one")"
# 55%: the flows are the point, but a watch needs more than the one line
# main-horizontal's default left it in an 80x24 window.
tmux set-window-option -t "$p_flows" main-pane-height 55% >/dev/null
tmux select-layout -t "$p_flows" main-horizontal

# Send commands. IP1/IP2 must be exported for the flows heredoc's expansion.
tmux send-keys -t "$p_one" "$(_watch_cmd "$ip1" "$t1")" Enter
tmux send-keys -t "$p_two" "$(_watch_cmd "$ip2" "$t2")" Enter
tmux send-keys -t "$p_flows" \
    "export IP1='$ip1'; export IP2='$ip2'; $(_flows_cmd)" Enter

tmux select-pane -t "$p_flows"
tmux select-window -t "${SESSION}:${WINDOW}"

echo "kinspect: tmux window '${WINDOW}' ready."
echo "  In the drawer: Ctrl+B w (window list) or Ctrl+B n/p."
echo "  Keyboard shortcut: bind one of the F-keys to this window if you like."
