#!/usr/bin/env bash
# kai-index — index documentation for the AI assistant
set -euo pipefail

DOCS_DIR="${1:-/usr/local/share/kldload-ai/html}"
RAG_URL="http://localhost:8400"

echo "Indexing documentation from: ${DOCS_DIR}"

# Check RAG service is running
if ! curl -sf "${RAG_URL}/health" >/dev/null 2>&1; then
    echo "ERROR: RAG service not running on ${RAG_URL}"
    echo "Start it: systemctl start kldload-rag"
    exit 1
fi

# Index local docs
RESULT=$(curl -sf -X POST "${RAG_URL}/index" \
    -H 'Content-Type: application/json' \
    -d "{\"source_dir\": \"${DOCS_DIR}\"}")

echo "$RESULT" | python3 -m json.tool 2>/dev/null || echo "$RESULT"
echo ""
echo "Done. Test with: kai 'what is OpenZFS?'"
