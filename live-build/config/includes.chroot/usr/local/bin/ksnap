#!/usr/bin/env bash
set -Eeuo pipefail
trap 'echo "ksnap: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

# ksnap — simplified ZFS snapshot interface
# Usage:
#   ksnap                     # snapshot all key datasets
#   ksnap /home/admin         # snapshot a specific path
#   ksnap list                # show all snapshots with ages
#   ksnap rollback /path      # roll back a dataset to its last snapshot
#   ksnap destroy <snap>      # destroy a specific snapshot

cmd="${1:-all}"

# usage — the contract. -h/--help prints it on stdout and exits 0 (it used
# to fall into the catch-all: usage on stdout, exit 1, 2026-09-23); an
# unknown verb prints it on stderr and exits 2.
usage() {
    cat <<'EOF'
Usage: ksnap [list|rollback <path>|destroy <snap>|<path>]

  ksnap              Snapshot all key datasets
  ksnap /home/admin  Snapshot a specific path
  ksnap list         Show all snapshots
  ksnap rollback /x  Roll back to last snapshot
  ksnap destroy NAME Destroy a snapshot

A path is resolved to the ZFS dataset holding it; a path that is not on
ZFS is refused. The root filesystem is never rolled back here: use
kldload-rollback, which boots an earlier boot environment instead.

Exit: 0 done, 1 a snapshot or rollback failed, 2 usage error.
See ksnap(8).
EOF
}
case "$cmd" in
-h | --help | help)
    usage
    exit 0
    ;;
esac

_ts() { date +%Y%m%d-%H%M%S; }
_log() { printf '\033[0;32m[ksnap]\033[0m %s\n' "$*"; }
_err() { printf '\033[0;31m[ksnap]\033[0m %s\n' "$*" >&2; }

# _path_to_ds PATH -- the ZFS dataset holding PATH on stdout, or nothing.
# WHY findmnt and the fstype: `df --output=source` answered for any
# filesystem, so a path on tmpfs came back as "tmpfs" and the rollback said
# "No snapshots found for tmpfs" (found writing ksnap(8), 2026-09-29).
_path_to_ds() {
    local src fst
    read -r src fst < <(findmnt -no SOURCE,FSTYPE -T "$1" 2>/dev/null) || return 0
    [[ "$fst" == zfs ]] && printf '%s\n' "$src"
    return 0
}

case "$cmd" in
list)
    echo ""
    printf '  %-50s %-22s %s\n' "SNAPSHOT" "CREATED" "USED"
    printf '  %-50s %-22s %s\n' "--------" "-------" "----"
    zfs list -H -t snapshot -o name,creation,used -S creation 2>/dev/null | while IFS=$'\t' read -r name created used; do
        printf '  %-50s %-22s %s\n' "$name" "$created" "$used"
    done
    echo ""
    total="$(zfs list -H -t snapshot -o name 2>/dev/null | wc -l)"
    printf '  %s snapshots total\n\n' "$total"
    ;;

rollback)
    [[ -n "${2:-}" ]] || {
        _err "rollback needs a path: ksnap rollback /path"
        exit 2
    }
    target="$2"
    ds="$(_path_to_ds "$target")"
    [[ -n "$ds" ]] || {
        _err "$target is not on a ZFS dataset"
        exit 1
    }
    # SAFETY: rolling back the dataset mounted at / rewrites the running
    # system under itself. A boot environment is the way to go back there.
    if [[ "$ds" == "$(findmnt -no SOURCE /)" ]]; then
        _err "$ds is the running root filesystem; roll it back with kldload-rollback (boot environments), not here"
        exit 1
    fi
    # Newest snapshot without `| head`: mapfile reads all of `zfs list` in-
    # process, so the producer never takes SIGPIPE (exit 141 under pipefail) on
    # a dataset with enough snapshots to overflow the pipe buffer. Same crash
    # class as the kst dashboard fix; latent here (max ~20 snaps/dataset) but a
    # rollback path shouldn't have a snapshot-count landmine in it.
    mapfile -t _snaps < <(zfs list -H -t snapshot -o name -S creation -d1 "$ds" 2>/dev/null)
    last_snap="${_snaps[0]:-}"
    [[ -n "$last_snap" ]] || {
        _err "No snapshots found for $ds"
        exit 1
    }
    _log "Rolling back $ds to $last_snap"
    sudo zfs rollback "$last_snap" || {
        _err "zfs refused the rollback (above); $target is unchanged"
        exit 1
    }
    _log "Done. $target is now at: $last_snap"
    ;;

destroy)
    [[ -n "${2:-}" ]] || {
        _err "destroy needs a snapshot: ksnap destroy dataset@name"
        exit 2
    }
    snap="$2"
    if [[ "$snap" != *@* ]]; then
        _err "Error: expected a snapshot (dataset@name), not a dataset. This would destroy the dataset."
        exit 2
    fi
    _log "Destroying snapshot: $snap"
    sudo zfs destroy "$snap" || {
        _err "could not destroy $snap (above)"
        exit 1
    }
    _log "Done."
    ;;

all)
    ts="$(_ts)"
    _log "Snapshotting key datasets (manual-${ts})"
    # WHY counted: each failure was swallowed (2>/dev/null ... || true) and the
    # run said "Done." and exited 0 with nothing taken (found writing ksnap(8),
    # 2026-09-29). A missing dataset is skipped; a failed snapshot is not.
    made=0 failed=0
    for ds in $(zfs list -H -o name -d1 rpool/ROOT 2>/dev/null) \
        $(zfs list -H -o name -d1 rpool/home 2>/dev/null) \
        rpool/srv rpool/var/lib; do
        zfs list "$ds" &>/dev/null || continue # not every install has /srv or a /home dataset
        if _e="$(sudo zfs snapshot "${ds}@manual-${ts}" 2>&1)"; then
            _log "  ${ds}@manual-${ts}"
            made=$((made + 1))
        else
            _err "  ${ds}: ${_e}"
            failed=$((failed + 1))
        fi
    done
    if ((failed || made == 0)); then
        _err "${made} taken, ${failed} failed"
        exit 1
    fi
    _log "Done: ${made} snapshot(s)."
    ;;

/*)
    # Snapshot a specific path
    ts="$(_ts)"
    ds="$(_path_to_ds "$cmd")"
    [[ -n "$ds" ]] || {
        _err "$cmd is not on a ZFS dataset"
        exit 1
    }
    snap="${ds}@manual-${ts}"
    _log "Snapshotting $ds"
    sudo zfs snapshot "$snap" || {
        _err "could not snapshot $ds (above)"
        exit 1
    }
    _log "Done: $snap"
    ;;

*)
    _err "unknown command: $cmd"
    usage >&2
    exit 2
    ;;
esac
