#!/usr/bin/env bash
# _sysdiag-greeting — render fastfetch + _sysdiag-home side-by-side.
#
# Mirrors _kconsole-greeting (klab cockpit's landing view): fastfetch
# on the left (distro ASCII logo + OS / kernel / packages / shell /
# CPU / GPU / mem / disk / IP), _sysdiag-home on the right (the F-key
# cheatsheet). Single pane, no tmux split — sysdiag stays a normal
# bash window after the greeting prints.
#
# Width strategy: measure the widest VISIBLE column of fastfetch (with
# ANSI escapes stripped — `${#var}` counts bytes including \e[...m,
# which is wrong for terminal width) then pad each row to that width
# before appending the cheatsheet row.
#
# Falls back gracefully: if fastfetch isn't installed we render the
# cheatsheet alone (no left column).
set -u

# Erase scrollback + clear visible screen before drawing. SINGLE-quoted
# so bash preserves the backslashes literally, then printf interprets
# \033 as ESC. Earlier inline attempt in kldload-sysdiag with double
# quotes had bash strip the backslashes before printf saw them, so the
# literal text "033[3J033[H033[2J" leaked into the terminal at the top
# of the screen (operator on .142 b646 2026-06-08).
#   \e[3J = erase scrollback buffer
#   \e[H  = move cursor to top-left
#   \e[2J = erase entire visible screen
printf '\033[3J\033[H\033[2J'

# Strip CSI / OSC escape sequences for width calc only — the output
# string keeps its colours intact.
_visible_len() {
    local plain
    plain=$(printf '%s' "$1" | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g; s/\x1b\][^\x07]*\x07//g')
    printf '%d' "${#plain}"
}

# Render the sheet twice-aware: first ask it what it needs at full width so
# we can decide the composition, then re-render it inside whatever budget
# that decision leaves. Without the second pass each block sized itself to
# the whole terminal and the SUM overflowed.
mapfile -t RIGHT < <(/usr/local/bin/_sysdiag-home 2>/dev/null)

# ── Side-by-side, or stacked ─────────────────────────────────────────
# fastfetch is ~54 columns and the cheatsheet ~119, so composing them
# side by side needs ~175 before anything wraps. A 191-column terminal
# fits that only at a font size small enough to be unpleasant, which is
# what the operator hit (2026-08-10: "at this resolution it displays but
# it's small").
#
# Stacking removes the ADDITION: the widest thing on screen becomes
# max(54, 119) = 119 rather than 54+119, so the same content is readable
# at a far larger font. Side-by-side is still used when there is genuinely
# room for it, because it is the denser view when the screen can afford it.
#
# stty is asked before tput: COLUMNS is not exported into a command
# substitution, and terminfo can be stale after a resize.
_cols=$( (stty size 2>/dev/null | awk '{print $2}') || true)
[[ -z "${_cols:-}" || "${_cols}" -lt 20 ]] && _cols=$(tput cols 2>/dev/null || echo 80)

if command -v fastfetch >/dev/null 2>&1; then
    # --logo-position top: SEQUENTIAL line-by-line (default "left"
    #   emits cursor-positioning escapes that trash composition)
    # --pipe false:        force colours ON (auto-detect would strip
    #   them because our mapfile process substitution is a pipe)
    #
    # Logo color per substrate. fastfetch's native logo carries its OWN
    # embedded multi-color SGR; left in place it mixed with our forced color
    # AND threw off the visible-width measurement used for side-by-side
    # padding — that's the "garbled / messed-up lines" seen on BOTH F44 and
    # RHEL. Fix: STRIP the embedded SGR per logo line, then re-apply ONE clean
    # brand color the composition can preserve and _visible_len can measure.
    _lc='1;36' # kldload cyan (default / unknown distro)
    case "$(
        . /etc/os-release 2>/dev/null
        printf '%s' "${ID:-}"
    )" in
    fedora) _lc='1;34' ;;                            # Fedora blue
    rhel | centos | rocky | almalinux) _lc='1;31' ;; # Red Hat red
    debian) _lc='1;31' ;;                            # Debian red
    ubuntu) _lc='1;33' ;;                            # Ubuntu orange
    esac
    mapfile -t LEFT < <(fastfetch --logo-position top --pipe false 2>/dev/null |
        awk -v lc="$_lc" '
            {
                if (/:/) {
                    # Info line — keep fastfetch colors as-is
                    print $0
                } else if (length($0) > 0) {
                    # Logo line — strip embedded SGR, force one clean color
                    gsub(/\x1b\[[0-9;]*m/, "", $0)
                    printf "\x1b[%sm%s\x1b[0m\n", lc, $0
                } else {
                    print ""
                }
            }
        ')

    # Find widest visible column of left
    maxw=0
    for row in "${LEFT[@]}"; do
        w=$(_visible_len "$row")
        ((w > maxw)) && maxw=$w
    done

    # Widest cheatsheet row, so the decision uses real numbers rather than
    # an assumption about either block's size.
    rmax=0
    for row in "${RIGHT[@]}"; do
        w=$(_visible_len "$row")
        ((w > rmax)) && rmax=$w
    done

    if ((_cols >= maxw + rmax + 2)); then
        # Re-render the sheet inside the leftover width so it lays itself
        # out for the space it will actually occupy, not the whole screen.
        mapfile -t RIGHT < <(SYSDIAG_COLS=$((_cols - maxw - 2)) \
            /usr/local/bin/_sysdiag-home 2>/dev/null)
        m=${#RIGHT[@]}
        # Compose side-by-side
        n=${#LEFT[@]}
        m=${#RIGHT[@]}
        ((n > m)) && total=$n || total=$m
        for ((i = 0; i < total; i++)); do
            l="${LEFT[i]:-}"
            r="${RIGHT[i]:-}"
            if [[ -n "$l" ]]; then
                visw=$(_visible_len "$l")
                padding=$((maxw - visw + 2))
            else
                padding=$((maxw + 2))
            fi
            printf '%s%*s%s\n' "$l" "$padding" '' "$r"
        done
    else
        # Stacked: system summary, then the cheatsheet under it.
        printf '%s\n' "${LEFT[@]}"
        printf '\n'
        printf '%s\n' "${RIGHT[@]}"
    fi
else
    # No fastfetch — just print the cheatsheet alone.
    printf '%s\n' "${RIGHT[@]}"
fi
