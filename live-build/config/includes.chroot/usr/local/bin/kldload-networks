#!/usr/bin/env bash
set -Eeuo pipefail
trap 'echo "FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR
# ---------------------------------------------------------------------------
# kldload-networks — define the per-class libvirt networks
#
# What it does, in order:
#   1. Waits for libvirtd to answer (it may still be starting at first boot).
#   2. For each shipped network XML: defines it if absent, marks it autostart,
#      and starts it if it is not already running.
#   3. Reports what exists, so the operator can see the estate in one command.
#
# WHY separate networks at all: every VM used to land on libvirt's `default`
# bridge, so a klab golden, a ZFS-test clone and an operator's scratch VM were
# indistinguishable by address. That matters once Ansible is pointed at them —
# "run this against the lab clones" has to mean something more precise than
# "everything on virbr0", and a destructive playbook that fans out to the wrong
# class is not a mistake you get to undo.
#
# A fixed subnet per class also means the inventory group and the address range
# agree, so a play can select by either.
#
#   kld-klab    192.168.150.0/24   klab goldens and blue/green sites
#   kld-zfslab  192.168.151.0/24   the ZFS test lab
#   kld-vms     192.168.152.0/24   regular operator VMs
#   default     192.168.122.0/24   the Kubernetes cluster — NOT managed here
#
# The cluster is deliberately left on `default`. It works, its real traffic
# rides WireGuard, and re-homing a running control plane to chase tidiness is
# a bad trade.
#
# Inputs:  /usr/local/share/kldload-networks/*.xml
# Outputs: libvirt networks, defined + autostarted. Idempotent — safe to
#          re-run, and re-running is how a host repairs itself after someone
#          removes one by hand.
#
# Notes:
#   - Defining a network does NOT move any existing VM. Guests attach at
#     creation time; this only makes the networks available to attach to.
#   - Subnets were chosen to avoid 192.168.122.0/24 (libvirt default) and the
#     WireGuard planes at 10.250.0.0/24 and 10.251.0.0/24.
# ---------------------------------------------------------------------------

XML_DIR="${KLDLOAD_NETWORK_DIR:-/usr/local/share/kldload-networks}"
LOG=/var/log/kldload/networks.log
mkdir -p "$(dirname "$LOG")"

_ts() { date '+%Y-%m-%dT%H:%M:%S'; }
log() { echo "$(_ts) $*" >>"$LOG"; }
say() { printf '%s\n' "$*"; }
die() {
    log "ERROR: $*"
    printf 'kldload-networks: %s\n' "$*" >&2
    exit 1
}

command -v virsh >/dev/null 2>&1 || die "virsh not installed — libvirt is required"

# _wait_libvirt — libvirtd may still be coming up when this runs at boot.
# Returns 0 once virsh answers, 1 after ~30s. Callers must treat failure as
# fatal: defining networks against a dead daemon silently does nothing.
_wait_libvirt() {
    local i
    for i in $(seq 1 30); do
        virsh net-list --all >/dev/null 2>&1 && return 0
        sleep 1
    done
    return 1
}

cmd_apply() {
    _wait_libvirt || die "libvirtd did not answer after 30s"
    [[ -d "$XML_DIR" ]] || die "no network definitions at $XML_DIR"

    local xml name defined=0 started=0 skipped=0
    for xml in "$XML_DIR"/*.xml; do
        [[ -f "$xml" ]] || continue
        name="$(basename "$xml" .xml)"

        if ! virsh net-info "$name" >/dev/null 2>&1; then
            if virsh net-define "$xml" >>"$LOG" 2>&1; then
                log "defined $name"
                defined=$((defined + 1))
            else
                # Not fatal: one malformed definition must not stop the rest.
                say "  ! failed to define ${name} — see $LOG"
                continue
            fi
        else
            skipped=$((skipped + 1))
        fi

        # Autostart is what makes this survive a reboot without the unit.
        virsh net-autostart "$name" >>"$LOG" 2>&1 || true # already-autostart is not an error

        if ! virsh net-info "$name" 2>/dev/null | grep -qi '^Active:.*yes'; then
            if virsh net-start "$name" >>"$LOG" 2>&1; then
                log "started $name"
                started=$((started + 1))
            else
                say "  ! failed to start ${name} — see $LOG"
            fi
        fi
    done

    log "apply: ${defined} defined, ${started} started, ${skipped} already present"
    say "Networks: ${defined} defined, ${started} started, ${skipped} already present."
    say ""
    cmd_list
}

cmd_list() {
    printf '  %-14s %-8s %-12s %-18s %s\n' "NETWORK" "STATE" "AUTOSTART" "SUBNET" "PURPOSE"
    printf '  %-14s %-8s %-12s %-18s %s\n' "──────────────" "────────" "────────────" "──────────────────" "───────────────"
    local n state auto subnet purpose
    while read -r n; do
        [[ -z "$n" ]] && continue
        state="$(virsh net-info "$n" 2>/dev/null | awk '/^Active:/{print $2}')"
        auto="$(virsh net-info "$n" 2>/dev/null | awk '/^Autostart:/{print $2}')"
        subnet="$(virsh net-dumpxml "$n" 2>/dev/null |
            grep -oE "address='[0-9.]+' netmask='[0-9.]+'" |
            head -1 | sed "s/address='//;s/' netmask='/ \//;s/'//")"
        case "$n" in
        kld-klab) purpose="klab goldens + sites" ;;
        kld-zfslab) purpose="ZFS test lab" ;;
        kld-vms) purpose="operator VMs" ;;
        default) purpose="kubernetes cluster" ;;
        *) purpose="-" ;;
        esac
        printf '  %-14s %-8s %-12s %-18s %s\n' "$n" "${state:-?}" "${auto:-?}" "${subnet:-?}" "$purpose"
    done < <(virsh net-list --all --name 2>/dev/null)
}

# ─── Lease → inventory reconciliation ──────────────────────────────────────
# cmd_sync — teach the state DB what libvirt already knows.
#
# WHY this exists: kvm-clone registers every clone it makes, and the goldens
# register themselves now too — but they all register with an EMPTY ip_addr,
# because at creation time the guest has not asked for a DHCP lease yet.
# kldload-inventory selects VMs `WHERE ip_addr != ''`, quite correctly, since
# a VM with no address cannot be reached by a playbook. The result was an
# inventory whose VM half was permanently empty: 10 VMs registered, 0 with an
# address, none of them targetable (verified on a running host, 2026-08-17).
#
# Nothing was ever going to fill that column in, because the API to do it
# (`kldload-db vm-status --ip`) had no caller. libvirt has known the answer
# the whole time — it issued the leases. This copies them across.
#
# Run it after cloning, or on a timer; it is idempotent and cheap.
# _refresh_wgx_inventory — keep the wgx estate inventory matching the estate.
#
# wgx answers "is this peer supposed to be here?" by scanning every host in
# its inventory and collecting the interface keys those hosts OWN. A peer key
# that matches no scanned host is an orphan, rendered amber as UNDECLARED.
# So the inventory is not decoration: it is the entire basis of the judgement.
#
# It was written ONCE, by kube-cluster bootstrap, listing the k8s nodes that
# existed at that moment -- and with `>`, so anything else was erased. Nothing
# ever updated it. On fiend 2026-09-03 it held 4 hosts while the estate ran
# 16: the two control planes added by a later scale-up and all ten klab VMs
# were invisible, so 30 of 70 live peers were reported UNDECLARED on a mesh
# where every single peer was healthy and handshaking.
#
# The peer ENDPOINTS are the answer, and they are already in the kernel: the
# far end of every tunnel this host carries is, by definition, a host worth
# scanning. Deriving the list means it cannot go stale -- add a VM to a mesh
# and the next sync picks it up; destroy one and it drops out.
_refresh_wgx_inventory() {
    command -v wg >/dev/null 2>&1 || return 0
    local _inv=/root/.config/wgx/hosts _tmp
    _tmp="$(mktemp)" || return 0

    {
        echo "# wgx estate inventory — DERIVED, do not hand-edit."
        echo "# Regenerated by 'kldload-networks sync' from the endpoint of every"
        echo "# WireGuard peer this host carries. Written $(date -Is)."
    } >"$_tmp"

    local _n=0 _ip
    while read -r _ip; do
        [[ -n "$_ip" ]] || continue
        echo "root@${_ip}" >>"$_tmp"
        _n=$((_n + 1))
    done < <(
        for _if in $(wg show interfaces 2>/dev/null); do
            # swallow: an interface with no peers prints nothing and exits
            # non-zero under pipefail; that is an empty mesh, not an error.
            wg show "$_if" endpoints 2>/dev/null | awk '{print $2}' | cut -d: -f1 || true
        done | grep -vE '^\(none\)$|^$' | sort -u
    )

    # An empty sweep must not blank a working inventory. No peers means no
    # meshes are up yet, which is a boot-order state, not an estate change.
    if ((_n == 0)); then
        rm -f "$_tmp"
        return 0
    fi
    mkdir -p /root/.config/wgx
    install -m 0644 "$_tmp" "$_inv"
    rm -f "$_tmp"
    log "wgx inventory refreshed: ${_n} host(s) derived from live peer endpoints"
}

cmd_sync() {
    _wait_libvirt || die "libvirtd did not answer after 30s"
    command -v kldload-db >/dev/null 2>&1 || die "kldload-db not installed"

    # Estate membership changed or not, the wgx inventory is derived from the
    # live meshes, so refreshing it here keeps the console's UNDECLARED
    # judgement honest without anyone maintaining a list.
    _refresh_wgx_inventory

    # _vms_with_ip — how many registered VMs currently carry an address.
    # This is the OUTCOME measure. `kldload-db vm-status` issues a plain SQL
    # UPDATE, and an UPDATE whose WHERE clause matches nothing is a perfectly
    # successful no-op — exit 0, zero rows touched. The first version of this
    # function trusted that exit code and cheerfully reported "11 VMs updated"
    # while the database was completely unchanged, because it was passing the
    # DHCP client-id as the hostname. Counting before and after is the only
    # claim worth making.
    _vms_with_ip() {
        kldload-db dump 2>/dev/null |
            python3 -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: print(0); sys.exit()
print(sum(1 for v in d.get("vms",[]) if v.get("ip_addr")))' 2>/dev/null || echo 0
    }

    local net name ip mac seen=0 attempted=0 stale=0 before after
    before="$(_vms_with_ip)"

    # MAC -> domain, straight from libvirt. Built once: this is the fallback for
    # leases whose guest announced no hostname (see the loop below).
    local -A _mac_owner=()
    local _dom _m
    while read -r _dom; do
        [[ -z "$_dom" ]] && continue
        while read -r _m; do
            [[ -n "$_m" ]] && _mac_owner["${_m,,}"]="$_dom"
        done < <(virsh domiflist "$_dom" 2>/dev/null | awk 'NR>2 && NF {print $5}')
    done < <(virsh list --all --name 2>/dev/null)

    # ── Pass 1: leases give ADDRESSES, nothing else ──────────────────────
    # A lease is a lookup table, not the list of things to reconcile. Driving
    # the loop from leases meant a VM with no current lease was never visited
    # at all, so its address in the DB was never cleared -- and dnsmasq expires
    # leases, so every stale row eventually became permanent.
    # HISTORY: onyx 2026-08-30 -- 25 VMs defined, 0 running, and the inventory
    # still handed Ansible 7 targets. test-cloud (.40) and klab-golden-ubuntu
    # (.60) held no lease, so nothing ever touched them.
    local -A _dom_ip=()
    while read -r net; do
        [[ -z "$net" ]] && continue
        while read -r _ _ mac _ ip name _; do
            [[ -z "${ip:-}" ]] && continue
            ip="${ip%%/*}"
            # A lease with no hostname is still a real lease -- a raw kvm-clone
            # announces nothing, because it carries the golden's identity. The
            # host does not need the guest to identify itself: libvirt assigned
            # the MAC and knows which domain owns it.
            if [[ -z "${name:-}" || "$name" == "-" ]]; then
                name="${_mac_owner[${mac,,}]:-}"
                [[ -z "$name" ]] && continue
            fi
            _dom_ip["$name"]="$ip"
            seen=$((seen + 1))
        done < <(virsh net-dhcp-leases "$net" 2>/dev/null | tail -n +3)
    done < <(virsh net-list --name 2>/dev/null)

    # ── Pass 2: visit EVERY domain libvirt defines ───────────────────────
    # This is the reconcile. Every VM is decided on its OWN state, whether or
    # not it currently holds a lease.
    local _dom _state _ip
    while read -r _dom; do
        [[ -z "$_dom" ]] && continue
        # awk, not head -- see the note on the crash this used to cause.
        _state="$(virsh domstate "$_dom" 2>/dev/null | awk 'NR==1' | tr -d '\r')"
        _ip="${_dom_ip[$_dom]:-}"
        if [[ "$_state" == "running" && -z "$_ip" ]]; then
            # Running, but dnsmasq has no lease for it. That is not an error and
            # not rare: dnsmasq lists only leases it issued AND still holds, so
            # a VM given a static address, or one whose lease aged out while it
            # stayed up, appears nowhere in the lease table. Falling through to
            # the else branch CLEARED the address of a perfectly healthy VM and
            # `_fetch_vms()` (WHERE ip_addr != '') then dropped it from Ansible.
            #
            # The guest agent already has a channel libvirt opened at define
            # time, so ask it. `timeout` because an agent that is installed but
            # not answering must not stall the whole reconcile -- the pass has
            # to finish for the orphan sweeps below to run at all.
            # HISTORY: fiend .117, 2026-09-01. All five klab-blue-* VMs were
            # running with real addresses that `virsh domifaddr --source agent`
            # returned instantly; the only klab leases dnsmasq held were for
            # klab-verify-* VMs destroyed hours earlier. Ansible listed 0 of
            # the 5.
            _ip="$(timeout 5 virsh domifaddr "$_dom" --source agent 2>/dev/null |
                awk '/ipv4/ && $4 !~ /^127\./ {split($4, _a, "/"); print _a[1]; exit}')" || _ip=""
            [[ -n "$_ip" ]] && log "sync: ${_dom} address ${_ip} came from the guest agent (no lease)"
        fi
        if [[ "$_state" == "running" && -n "$_ip" ]]; then
            kldload-db vm-status --name "$_dom" --ip "$_ip" --status running >/dev/null 2>&1 &&
                attempted=$((attempted + 1))
            log "sync: ${_dom} -> ${_ip} (running)"
        else
            # Clear the address so kldload-inventory (`WHERE ip_addr != ''`)
            # drops it. A powered-off VM must not be an Ansible target: worse
            # than failing, DHCP reuses addresses, so a stale entry can resolve
            # to a DIFFERENT machine and the play SUCCEEDS against the wrong
            # host. onyx had kldload-cp and test-xfce both claiming .57.
            kldload-db vm-status --name "$_dom" --ip "" --status "${_state:-shut}" >/dev/null 2>&1 || true
            log "sync: ${_dom} is ${_state:-absent} — address cleared"
            stale=$((stale + 1))
        fi
    done < <(virsh list --all --name 2>/dev/null)

    # ── Pass 4: NODES whose backing VM is not running ────────────────────
    # Nodes are handled by STATUS, not by address: kldload-inventory falls back
    # ip_mgmt -> ip_wg0 -> hostname, so blanking one field just moves the
    # target rather than removing it.
    #
    # The rule is deliberately narrow: a node is marked offline ONLY when
    # libvirt defines a domain of the same name and that domain is not running.
    # A physical node has no libvirt domain and is never touched by this -- a
    # broad "unreachable means retired" rule would drop real hardware from the
    # inventory during a transient outage, which is worse than the bug.
    # Nothing is deleted; deleted_at stays the operator's decision.
    # HISTORY: onyx 2026-08-30 -- kldload-cp and kldload-w-1..3 sat status=ready
    # with addresses while all four domains were shut off, and kldload-cp's
    # .57 had been reassigned to test-xfce.
    local _node _nstate _nstatus _dbvms
    # Names the DB itself records as VMs. This is what tells a destroyed VM
    # apart from a physical machine further down: both have no libvirt domain,
    # but only a VM ever had a row in `vms`.
    _dbvms="$(kldload-db dump 2>/dev/null |
        python3 -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit()
for v in d.get("vms",[]): print(v.get("name",""))' 2>/dev/null | tr '\n' '|')"
    while read -r _node _nstatus; do
        [[ -z "$_node" ]] && continue
        # `|| _nstate=""` -- virsh domstate exits non-zero for a domain that no
        # longer exists, pipefail promotes it, and set -e then kills the whole
        # reconcile mid-sweep. That is exactly the case this pass exists to
        # handle: a node whose VM was destroyed. Without the guard the crash
        # takes the ORPHAN pass down with it, so rows for vanished domains are
        # never cleared and Ansible keeps targeting them.
        # HISTORY: fiend 2026-08-31 -- "FAIL at line 253" on every run after a
        # kube-cluster destroy; six dead nodes stayed in the inventory.
        _nstate="$(virsh domstate "$_node" 2>/dev/null | awk 'NR==1' | tr -d '\r')" || _nstate=""
        if [[ -z "$_nstate" ]]; then
            # No libvirt domain answers to this name. Two very different cases
            # used to be collapsed into "physical, leave alone":
            #   - a real machine, which never had a domain  -> correct to skip
            #   - a VM that was destroyed AND undefined     -> its node row must
            #     go offline, or the inventory keeps targeting a host that does
            #     not exist any more.
            # Pass 3 below clears the VM row's address, and _fetch_vms() filters
            # on `ip_addr != ''`, so the VM side does drop out. The NODE row has
            # no such filter -- kldload-inventory resolves it as
            # ip_wg0 -> ip_wg1 -> ip_mgmt -> hostname, so blanking an address
            # just moves the target. Only `status` takes a node out, via
            # _fetch_nodes()'s "status NOT IN ('offline','deleted')".
            # HISTORY: fiend .117, 2026-09-01. kldload-w-4 was drained, deleted
            # from the cluster, destroyed and undefined; its zvol was gone and
            # the mesh had dropped its peers. `kldload-networks sync` ran and
            # reported it stale. Ansible still listed it in group status_ready
            # with ansible_host 192.168.122.139 -- a live target pointing at a
            # machine that no longer existed.
            if [[ "|${_dbvms}" == *"|${_node}|"* && "$_nstatus" != "offline" ]]; then
                # Swallowed for the same reason as every other node-status
                # write in this pass: the row can vanish between the dump and
                # the update, and the next tick re-derives it.
                kldload-db node-status --hostname "$_node" --status offline >/dev/null 2>&1 || true
                log "sync: node ${_node} is a known VM with no libvirt domain — status offline"
                stale=$((stale + 1))
            fi
            continue
        fi
        if [[ "$_nstate" == "running" ]]; then
            # Only lift a mark this reconcile set, so a richer status written
            # by node-register or the cluster tooling is never clobbered.
            if [[ "$_nstatus" == "offline" ]]; then
                # Swallowed: a node row that vanished between the dump above
                # and this update. Losing the mark is harmless -- the next
                # tick re-derives it from libvirt.
                kldload-db node-status --hostname "$_node" --status ready >/dev/null 2>&1 || true
                log "sync: node ${_node} is back — status ready"
            fi
        elif [[ "$_nstatus" != "offline" ]]; then
            # Swallowed for the same reason as the ready case above: a row
            # deleted mid-sweep. Never a reason to abort the remaining nodes.
            kldload-db node-status --hostname "$_node" --status offline >/dev/null 2>&1 || true
            log "sync: node ${_node} is ${_nstate} — status offline"
            stale=$((stale + 1))
        fi
    done < <(kldload-db dump 2>/dev/null |
        python3 -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit()
for n in d.get("nodes",[]):
    if not n.get("deleted_at"): print(n.get("hostname",""), n.get("status",""))' 2>/dev/null)

    # ── Pass 3: rows for domains libvirt no longer defines at all ────────
    # A VM destroyed AND undefined never appears in pass 2, so its row would
    # keep its address forever. Deleting is not this tool's job -- clearing the
    # address is enough to take it out of the inventory, and the row stays for
    # history.
    #
    # Firecracker microVMs (role firecracker-*) are never libvirt domains, by
    # design, and kfire keeps their rows itself: this pass undefined four
    # running instances and cleared their addresses within minutes of kfire
    # registering them ("they are all unreconciled and don't show IPs",
    # onyx 2026-09-05). Their role is the tell; skip them.
    local _known _dbvm _dbrole
    _known="$(virsh list --all --name 2>/dev/null | tr '\n' '|')"
    while read -r _dbvm _dbrole; do
        [[ -z "$_dbvm" ]] && continue
        [[ "|${_known}" == *"|${_dbvm}|"* ]] && continue
        [[ "$_dbrole" == firecracker-* ]] && continue
        # Swallowed: this row was read from the dump moments ago, so the only
        # way the update fails is that something else removed it first --
        # which is the outcome we wanted anyway.
        kldload-db vm-status --name "$_dbvm" --ip "" --status undefined >/dev/null 2>&1 || true
        log "sync: ${_dbvm} is not defined in libvirt — address cleared"
        stale=$((stale + 1))
    done < <(kldload-db dump 2>/dev/null |
        python3 -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit()
for v in d.get("vms",[]):
    if v.get("ip_addr"): print(v.get("name",""), v.get("role",""))' 2>/dev/null)

    after="$(_vms_with_ip)"
    log "sync: ${seen} lease(s), ${stale} stale, VMs with an address ${before} -> ${after}"
    say "Leases seen: ${seen} (${stale} stale).  VMs with an address: ${before} → ${after}."
    say "Only VMs libvirt reports as running are given an address."

    # Scoped to ADDRESSES on purpose. This used to say "nothing changed", which
    # was untrue whenever the sweep had retired a node or cleared an orphan in
    # the same run -- an operator reading it would go hunting for a lease
    # mismatch that was not there. (fiend .117, 2026-09-01: printed verbatim on
    # the run that correctly took kldload-w-4 out of the inventory.)
    if ((seen > 0)) && [[ "$before" == "$after" ]]; then
        say ""
        say "  NOTE: no VM address changed. Either every VM already had its address,"
        say "  or the lease hostnames do not match any registered VM name."
        say "  Compare:  virsh net-dhcp-leases <net>   against   kldload-db dump"
    fi
}

cmd_help() {
    cat <<'EOF'
kldload-networks — per-class libvirt networks for the VM estate

  kldload-networks apply    Define, autostart and start every shipped network
  kldload-networks sync     Copy libvirt DHCP leases into the state DB, so
                            running VMs appear in the Ansible inventory
  kldload-networks list     Show every libvirt network, state and subnet
  kldload-networks help     This text

WHY
  Every VM used to land on libvirt's default bridge, so a klab golden, a ZFS
  test clone and a scratch VM were indistinguishable by address. Once Ansible
  is pointed at them that distinction matters: "run this against the lab
  clones" must mean something narrower than "everything on virbr0".

NETWORKS
  kld-klab    192.168.150.0/24   klab goldens and blue/green sites
  kld-zfslab  192.168.151.0/24   the ZFS test lab
  kld-vms     192.168.152.0/24   regular operator VMs
  default     192.168.122.0/24   the Kubernetes cluster (not managed here)

NOTES
  Idempotent — re-running repairs a host where a network was removed by hand.
  Defining a network does not move any existing VM; guests attach at creation.

EXAMPLES
  kldload-networks apply
  virsh net-dhcp-leases kld-zfslab        # what is on the lab network
  ansible -i /usr/local/bin/kldload-inventory 'role:clone' -m ping

EXIT STATUS
  0 on success, 1 if libvirt is absent or unreachable.

FILES
  /usr/local/share/kldload-networks/*.xml   the definitions
  /var/log/kldload/networks.log             what this tool did
EOF
}

case "${1:-apply}" in
apply | up) cmd_apply ;;
sync) cmd_sync ;;
list | ls) cmd_list ;;
help | -h | --help) cmd_help ;;
*)
    printf 'kldload-networks: unknown command: %s\n\n' "$1" >&2
    cmd_help >&2
    exit 1
    ;;
esac
