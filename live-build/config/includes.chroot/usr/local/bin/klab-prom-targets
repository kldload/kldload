#!/usr/bin/env bash
# klab-prom-targets — regenerate Prometheus file_sd target JSONs from
# the live state of the system. No IPs in any config file — all targets
# are discovered at runtime from:
#   - virsh net-dhcp-leases (virbr0) → VM IPs
#   - virsh list --all              → VM names + running state
#   - kubectl get nodes -o wide     → K8s node IPs
#   - klab manifest                 → blue/green/kspawn role + distro labels
#
# Drops JSON target files under /etc/prometheus/targets/. Prometheus
# auto-reloads file_sd configs every 30s with no SIGHUP or restart.
#
# Run from a systemd timer (klab-prom-targets.timer) every 30 seconds,
# or once immediately after kube-cluster bootstrap completes.

set -Eeuo pipefail

# This file's own options line is `set -uo pipefail`, and that is the author's
# intent. The 2026-09-15 strict sweep put `set -Eeuo pipefail` above it, which
# additionally forced errexit here; a LATER set line cannot clear an
# option an earlier one set, so the file ran that way regardless. That is the
# mechanic that killed build 21 on onyx through dracut. The drop has to be
# explicit. See project_strict-sweep-overrode-soft-set-lines.
set +e +E

TARGETS_DIR="/etc/prometheus/targets"
mkdir -p "$TARGETS_DIR"

write_json() {
    local file="$1" content="$2"
    # Atomic write — Prometheus' file_sd can read mid-write otherwise.
    printf '%s\n' "$content" >"${file}.tmp"
    mv -f "${file}.tmp" "$file"
}

# Empty-targets JSON — emit even when no targets, so Prometheus doesn't
# warn about missing files. Valid file_sd content: [].
EMPTY='[]'

# ── klab VMs (blue / green / kspawn) ───────────────────────────────────
# klab's run-time identity for a VM is the virsh domain name:
#   klab-{blue,green}-{centos,rocky,fedora,debian,ubuntu,rhel}
#   kspawn-<cluster>-NN
# Each gets labelled with site + distro (klab) or cluster (kspawn).
declare -A DHCP=()
if command -v virsh >/dev/null 2>&1; then
    # MAC -> domain, straight from libvirt.
    #
    # WHY: a lease whose guest announced no hostname is still a real lease. A
    # klab clone carries the golden's cloud-init identity and announces either
    # nothing or the golden's name, so the hostname column is "-" for most of
    # them. The old loop indexed by hostname alone -- its comment said "AND by
    # MAC", but no line ever did it -- so every such lease was dropped and the
    # target file was written EMPTY.
    #
    # HISTORY: fiend, deb-3-kvm, 2026-09-20. Five klab-blue VMs running, four
    # of them in the Ansible inventory with addresses, and klab-blue.json was
    # "[]" -- a Metrics view with nothing behind it, which is the fourth time
    # this shape has shipped. kldload-networks already solved it exactly this
    # way (see its pass-1 loop); this is that fix, not a new invention.
    declare -A _mac_owner=()
    _dom=""
    _m=""
    while read -r _dom; do
        [[ -z "$_dom" ]] && continue
        while read -r _m; do
            [[ -n "$_m" ]] && _mac_owner["${_m,,}"]="$_dom"
        done < <(virsh domiflist "$_dom" 2>/dev/null | awk 'NR>2 && NF {print $5}')
    done < <(virsh list --all --name 2>/dev/null)

    # SIX columns, but the first is "Expiry Time" and it is TWO tokens -- a
    # date and a time. Reading it into one variable shifted every field by
    # one, so $_ip held the literal string "ipv4" and the map was keyed by
    # "192.168.122.101/24". Nothing errored; the lookup below simply never
    # matched a domain name, and klab-blue.json has been "[]" on every machine
    # that ever ran this. kldload-networks reads the same output as
    # `read -r _ _ mac _ ip name _`, which is the layout that is actually true.
    while read -r _date _time _mac _proto _ip _hostname _clientid; do
        [[ -z "$_ip" || "$_ip" == "IP" ]] && continue
        : "${_date:-} ${_time:-} ${_clientid:-}" # columns read only to position the rest
        _hostname="${_hostname%%.}"
        _ip="${_ip%/*}"
        # No hostname, or one that is not a domain we know: ask libvirt which
        # domain owns the MAC it handed the lease to.
        if [[ -z "$_hostname" || "$_hostname" == "-" ]]; then
            _hostname="${_mac_owner[${_mac,,}]:-}"
        fi
        [[ -n "$_hostname" ]] && DHCP["$_hostname"]="$_ip"
        # Index by the owning domain as well, so a guest that announces a name
        # of its own (the golden's) still reaches the right target entry.
        _owner="${_mac_owner[${_mac,,}]:-}"
        [[ -n "$_owner" ]] && DHCP["$_owner"]="$_ip"
        # No leases at all is an ordinary state on a host whose guests are shut
        # off, and virsh exits non-zero when the network is not up.
    done < <(virsh -q net-dhcp-leases default 2>/dev/null || true)
fi

blue_json='['
green_json='['
kspawn_json='['
_first_blue=1
_first_green=1
_first_kspawn=1
add() {
    local var="$1" ip="$2" name="$3" site="$4" distro="$5" cluster="${6:-}"
    local entry
    entry=$(printf '{"targets":["%s:9100"],"labels":{"site":"%s","distro":"%s","vm":"%s"%s}}' \
        "$ip" "$site" "$distro" "$name" \
        "${cluster:+,\"cluster\":\"${cluster}\"}")
    case "$var" in
    blue)
        [[ $_first_blue -eq 1 ]] && _first_blue=0 || blue_json="${blue_json},"
        blue_json="${blue_json}${entry}"
        ;;
    green)
        [[ $_first_green -eq 1 ]] && _first_green=0 || green_json="${green_json},"
        green_json="${green_json}${entry}"
        ;;
    kspawn)
        [[ $_first_kspawn -eq 1 ]] && _first_kspawn=0 || kspawn_json="${kspawn_json},"
        kspawn_json="${kspawn_json}${entry}"
        ;;
    esac
}

if command -v virsh >/dev/null 2>&1; then
    for vm in $(virsh list --name 2>/dev/null); do
        ip="${DHCP[$vm]:-}"
        [[ -z "$ip" ]] && continue
        case "$vm" in
        klab-blue-*) add blue "$ip" "$vm" "blue" "${vm#klab-blue-}" ;;
        klab-green-*) add green "$ip" "$vm" "green" "${vm#klab-green-}" ;;
        kspawn-*)
            # kspawn-<cluster>-NN
            rest="${vm#kspawn-}"
            cluster="${rest%-*}"
            add kspawn "$ip" "$vm" "kspawn" "-" "$cluster"
            ;;
        esac
    done
fi

write_json "${TARGETS_DIR}/klab-blue.json" "${blue_json}]"
write_json "${TARGETS_DIR}/klab-green.json" "${green_json}]"
write_json "${TARGETS_DIR}/klab-kspawn.json" "${kspawn_json}]"

# ── Kubernetes cluster targets (cilium/hubble/tetragon/kubelet) ────────
# Only populated if kubectl works + a cluster exists. Each node gets
# the labels Grafana's upstream cilium/hubble dashboards expect:
#   k8s_app=cilium, pod=cilium-<node>, node=<node>
# (The pod name is synthesized; this is a static hostPort scrape, not
# a ServiceMonitor, so prometheus can't discover the real pod name.)
if command -v kubectl >/dev/null 2>&1 && [[ -r /root/.kube/config || -n "${KUBECONFIG:-}" ]]; then
    export KUBECONFIG="${KUBECONFIG:-/root/.kube/config}"
    # Robust-to-timeout: single get-nodes call, parse locally. Both kubectl
    # calls run under `timeout 5`: the API VIP is on wg-k8s, so with the
    # cluster switched off the connect just hangs, and this unit has
    # TimeoutStartSec=infinity — fiend 2026-09-05, k8s nodes shut down to
    # build appliances, the 30s timer stacked one stuck bash on top of the
    # next for an hour. A file_sd refresh that cannot see the cluster should
    # simply emit no cluster targets and move on.
    _nodes_raw="$(timeout 5 kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{","}{.status.addresses[?(@.type=="InternalIP")].address}{"\n"}{end}' 2>/dev/null)"
    # Resolve the single node where cilium-operator currently runs. The
    # operator is a Deployment with replicas=1; scraping all nodes on 9963
    # leaves 3 of 4 targets permanently DOWN and the Grafana dashboard
    # looks empty on every panel that aggregates across targets.
    _operator_node="$(timeout 5 kubectl -n kube-system get pod -l io.cilium/app=operator -o jsonpath='{.items[0].spec.nodeName}' 2>/dev/null)"
    cilium_agent='['
    _first_ca=1
    cilium_operator='['
    _first_co=1
    hubble='['
    _first_hb=1
    tetragon='['
    _first_tg=1
    kubelet='['
    _first_kl=1
    _append() {
        local varname="$1" first_var="$2" entry="$3"
        local cur
        cur="$(eval "printf '%s' \"\$${varname}\"")"
        local f
        f="$(eval "printf '%s' \"\$${first_var}\"")"
        if [[ "$f" == "1" ]]; then
            eval "${first_var}=0"
            eval "${varname}=\"\${cur}\${entry}\""
        else
            eval "${varname}=\"\${cur},\${entry}\""
        fi
    }
    while IFS=, read -r name ip; do
        [[ -z "$name" || -z "$ip" ]] && continue
        # cilium-agent
        _append cilium_agent _first_ca "$(printf '{"targets":["%s:9962"],"labels":{"k8s_app":"cilium","pod":"cilium-%s","node":"%s"}}' "$ip" "$name" "$name")"
        # cilium-operator — emit only for the node the operator pod is
        # scheduled on. Fall back to every node if kubectl couldn't tell
        # us (early boot) so a freshly bootstrapped cluster still shows
        # something once the scheduler places the operator.
        if [[ -z "$_operator_node" || "$_operator_node" == "$name" ]]; then
            _append cilium_operator _first_co "$(printf '{"targets":["%s:9963"],"labels":{"k8s_app":"cilium-operator","io_cilium_app":"operator","node":"%s"}}' "$ip" "$name")"
        fi
        # hubble metrics
        _append hubble _first_hb "$(printf '{"targets":["%s:9965"],"labels":{"k8s_app":"cilium","pod":"cilium-%s","node":"%s"}}' "$ip" "$name" "$name")"
        # tetragon
        _append tetragon _first_tg "$(printf '{"targets":["%s:2112"],"labels":{"pod":"tetragon-%s","node":"%s"}}' "$ip" "$name" "$name")"
        # kubelet (HTTPS:10250)
        _append kubelet _first_kl "$(printf '{"targets":["%s:10250"],"labels":{"node":"%s"}}' "$ip" "$name")"
    done <<<"$_nodes_raw"
    write_json "${TARGETS_DIR}/cilium-agent.json" "${cilium_agent}]"
    write_json "${TARGETS_DIR}/cilium-operator.json" "${cilium_operator}]"
    write_json "${TARGETS_DIR}/hubble-metrics.json" "${hubble}]"
    write_json "${TARGETS_DIR}/tetragon.json" "${tetragon}]"
    write_json "${TARGETS_DIR}/kubelet.json" "${kubelet}]"
else
    # No cluster yet — empty target sets. Prometheus stops complaining
    # about the missing file_sd files, and starts scraping as soon as
    # this script runs with kubectl available.
    for f in cilium-agent cilium-operator hubble-metrics tetragon kubelet; do
        write_json "${TARGETS_DIR}/${f}.json" "${EMPTY}"
    done
fi
