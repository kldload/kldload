#!/bin/bash
# kldload-zfs-dbgmsg-collector — emit new ZFS dbgmsg entries to a tailable log.
#
# /proc/spl/kstat/zfs/dbgmsg is mode 0600 root:root and is a kstat dump
# (not an append-only log file), so promtail cannot tail it directly.
# This shim runs as root on a 10s timer, diffs the kstat against the last
# seen timestamp, and appends only new lines to a 0644 file that promtail
# can scrape.
#
# Why: the Grafana "ZFS Module Debug Messages (dbgmsg)" panel pulls
# {job="zfs-dbgmsg"} from Loki. Without this shim that query is empty
# because promtail can't read the kstat node, and even if it could, the
# whole-file rewind on every poll would either flood Loki or miss entries.
#
# History: bug surfaced on build #57 when the user noticed the dbgmsg
# panel said "No data" on the ZFS dashboard. Promtail's __path__ was
# pointed straight at the kstat — fixed in the same commit that added
# this script and the matching .timer.

set -uo pipefail

SRC=/proc/spl/kstat/zfs/dbgmsg
OUT=/var/log/kldload/zfs-dbgmsg.log
LAST=/var/lib/kldload/.zfs-dbgmsg.lastts

[ -r "$SRC" ] || exit 0

mkdir -p "$(dirname "$OUT")" "$(dirname "$LAST")"
touch "$OUT"
chmod 0644 "$OUT"

prev=$(cat "$LAST" 2>/dev/null || echo 0)
max="$prev"

# Format of the kstat node:
#   timestamp    message
#   1779849663   spa_history.c:297:spa_history_log_sync(): txg 17368 ...
# First line is the header. Data rows start with a 10-digit unix ts.
# awk, not a bash `while read`: the kstat is ~7 MB / 50k lines, and the bash
# loop cost 89 s of CPU per run on a 10-second timer — the unit never left
# "activating" and ate a core around the clock (onyx, 2026-09-05). awk does
# the same pass in well under a second. Exactly ten digits for the
# timestamp: a continuation line whose first token was another integer
# ("20600870358960 rpool/vms/mesh-3") once became the watermark and every
# real timestamp was "older" from then on — 22 hours of silence.
max=$(awk -v prev="$prev" -v out="$OUT" '
    $1 ~ /^[0-9]{10}$/ && ($1 + 0) > (prev + 0) {
        print >> out
        if (($1 + 0) > (max + 0)) max = $1 + 0
    }
    END { print (max ? max : prev) }' "$SRC")
echo "$max" >"$LAST"
