#!/usr/bin/env bash
# kvm-delete — cleanly remove a VM and its ZFS zvol
set -euo pipefail

# Auto-elevate to root (ZFS + libvirt require it)
# Rule 9: -h/--help answers before this re-exec. These tools already had
# perfectly good usage text -- it just could not be reached without root.
if [[ $EUID -ne 0 && "${1:-}" != -h && "${1:-}" != --help ]]; then exec sudo "$0" "$@"; fi

usage() {
    cat <<EOF
Usage: kvm-delete <vm-name> [--force]

Removes a VM and its ZFS zvol. The VM must be shut down first
unless --force is specified.

Examples:
  kvm-delete myvm
  kvm-delete myvm --force    # force-stop if running

Exit status:
  0  the VM, its zvol and its mesh peer are gone
  1  refused before changing anything (clones depend on it, or it is
     running without --force), OR the domain was removed but the zvol is
     still on disk or the VM is still a WireGuard peer — the warnings say
     which, and the state-DB row is cleared either way
  2  usage error: no name, or a second argument other than --force
EOF
    # asked-for help is 0; a usage error is 2, distinct from a delete that
    # ran and left something behind (1).
    exit "${1:-2}"
}

[[ "${1:-}" == -h || "${1:-}" == --help ]] && usage 0
[[ $# -lt 1 ]] && usage
NAME="$1"
# The only second argument is --force. Anything else used to be accepted and
# silently ignored: `kvm-delete myvm --froce` ran as a plain delete and the
# operator who typed it had no way to know the flag was dropped (found in
# the 2026-09-23 interface review; not a field incident).
case "$#:${2:-}" in
1: | 2:--force) ;;
*)
    echo "kvm-delete: unexpected argument(s): ${*:2}" >&2
    usage
    ;;
esac
FORCE="${2:-}"

ZVOL="rpool/vms/${NAME}"

# ─── Refuse before mutating, not after ──────────────────────────────────────
#
# WHY THIS RUNS FIRST: the order used to be undefine-then-destroy, so a zvol
# that ZFS refuses to destroy left the DOMAIN already gone and the dataset
# orphaned — the operator sees an error, believes the delete failed, and the
# VM is in fact deleted with its storage stranded. Anything that can refuse
# has to refuse before the first irreversible step.
#
# A golden with clones is the normal case for this: ZFS will not destroy a
# snapshot that clones depend on, which is the protection that stops a delete
# from orphaning every machine stamped off it.
if zfs list "${ZVOL}" >/dev/null 2>&1; then
    # Clones anywhere in the pool whose origin is a snapshot of THIS zvol.
    DEPS=$(zfs list -H -o name,origin -t volume,filesystem 2>/dev/null |
        awk -v z="${ZVOL}@" '$2 ~ "^"z {print $1}')
    if [[ -n "$DEPS" ]]; then
        echo "ERROR: ${NAME} still has machines cloned from it:" >&2
        printf '  %s\n' ${DEPS} >&2
        cat >&2 <<EOF

Nothing has been changed. Delete those first, or take one off its origin
with:

  zfs promote <clone>

which makes that clone own the data and leaves the rest working. Deleting
this VM with its clones still attached would strand every one of them.
EOF
        exit 1
    fi
fi

# Check VM exists
if ! virsh dominfo "${NAME}" >/dev/null 2>&1; then
    echo "Warning: VM '${NAME}' not found in libvirt (removing zvol only)"
else
    STATE=$(virsh domstate "${NAME}" 2>/dev/null || echo "unknown")
    if [[ "$STATE" == "running" ]]; then
        if [[ "$FORCE" == "--force" ]]; then
            echo "Force-stopping VM..."
            virsh destroy "${NAME}" 2>/dev/null || true
        else
            echo "ERROR: VM '${NAME}' is running. Stop it first or use --force"
            exit 1
        fi
    fi

    echo "Removing VM definition..."
    virsh undefine "${NAME}" --nvram 2>/dev/null ||
        virsh undefine "${NAME}" 2>/dev/null || true
fi

if zfs list "${ZVOL}" >/dev/null 2>&1; then
    # Check if this clone has a tracked origin snapshot
    ORIGIN=$(zfs get -H -o value com.kldload:clone-origin "${ZVOL}" 2>/dev/null)

    echo "Destroying ZFS zvol: ${ZVOL}"
    # BOUNDED RETRY, and the failure does not abort the rest of this script.
    #
    # `zfs destroy` was unguarded here, so under `set -e` a failure ended
    # kvm-delete on this line -- AFTER libvirt had already released the domain
    # and BEFORE the state-DB soft-delete at the bottom. The result is the worst
    # of both: the machine is gone from libvirt, its zvol is still on disk, and
    # the inventory still advertises it. Three lines up there is a comment about
    # the last bug of exactly this shape; this is the same lesson on the line
    # that actually destroys the data.
    #
    # Retried because the common cause is transient: immediately after
    # `virsh destroy` the zvol can still be held open while qemu and udev tear
    # the device down, and ZFS reports it busy.
    #
    # HISTORY: fiend, 2026-09-21, 4-k8s. estate-lifecycle reported all three
    # symptoms at once -- "kvm-delete returned non-zero", "the zvol survived
    # kvm-delete", and "STILL registered 240s after delete".
    _zvol_left=0
    _zd_err=""
    for _zd_try in 1 2 3 4 5; do
        if _zd_err="$(zfs destroy -r "${ZVOL}" 2>&1)"; then
            _zd_err=""
            break
        fi
        sleep 2
    done
    if [[ -n "$_zd_err" ]]; then
        _zvol_left=1
        echo "WARNING: could not destroy ${ZVOL} after 5 attempts: ${_zd_err}" >&2
        echo "WARNING: clearing the state-DB row anyway so the inventory stops advertising it" >&2
        echo "WARNING: remove the zvol by hand: zfs destroy -r ${ZVOL}" >&2
    fi

    # Clean up orphaned clone snapshots on the source
    # Find all clone-* snapshots on the source that have no remaining clones
    SRC=$(echo "$ORIGIN" | cut -d@ -f1)
    if [[ -n "$SRC" && "$SRC" != "-" ]]; then
        # HISTORY: fiend 2026-09-15. Both greps below return 1 in the ordinary
        # case — no clone- snapshots on the source, or a snapshot still in
        # use — and under `set -e` + pipefail each one ended the script right
        # here, AFTER the zvol was gone: exit 1 on a delete that had worked,
        # "Deleted" never printed, and the state-DB row never soft-deleted, so
        # the inventory kept advertising a machine that no longer existed.
        while IFS= read -r snap; do
            # -x: the snapshot name as a whole line, not a regex ('.' and '@' are in it)
            USED_BY=$(zfs get -H -o value origin -t volume -r rpool/vms 2>/dev/null | grep -x "${snap}" || true) # no match means orphaned, which is the case we want
            if [[ -z "$USED_BY" ]]; then
                echo "Cleaning up orphaned snapshot: ${snap}"
                # A snapshot something else holds is not ours to take, and the zvol is already gone.
                zfs destroy "${snap}" </dev/null 2>/dev/null || true
            fi
            # grep exits 1 when a source has no clone- snapshots, which is the common case.
        done < <(zfs list -t snapshot -H -o name "$SRC" 2>/dev/null | grep '@clone-' || true)
    fi
else
    echo "Warning: ZFS zvol '${ZVOL}' not found"
fi

echo ""
if ((${_zvol_left:-0})); then
    echo "Removed '${NAME}' from libvirt, but its zvol is STILL ON DISK (see the warnings above)"
else
    echo "Deleted '${NAME}'"
fi

# The mesh identity is read from the state DB BEFORE the soft delete below
# hides the row (vm-show returns live rows only). kldload-enroll writes it there
# since 2026-09-26; the file under mesh/enrolled/ is the fallback for machines
# enrolled before that. Both are asked for, so a mismatch is visible.
_db_mesh_id=""
_db_mesh_pub=""
if command -v kldload-db >/dev/null 2>&1; then
    # swallow: an unregistered VM has no row, and that is answered by the file below
    _db_row="$(kldload-db vm-show --name "${NAME}" 2>/dev/null || true)"
    _db_mesh_id="$(sed -n 's/^  "mesh_id": "\([^"]*\)",\{0,1\}$/\1/p' <<<"$_db_row")"
    _db_mesh_pub="$(sed -n 's/^  "wg_pubkey": "\([^"]*\)",\{0,1\}$/\1/p' <<<"$_db_row")"
fi

# Soft-delete from the state DB — history survives, dynamic inventory drops it.
if command -v kldload-db >/dev/null 2>&1; then
    kldload-db vm-delete --name "${NAME}" 2>/dev/null || true
    kldload-db node-delete --hostname "${NAME}" 2>/dev/null || true
    kldload-db event --type "vm" --subject "${NAME}" \
        --message "kvm-delete" 2>/dev/null || true
fi

# ─── Off the mesh ───────────────────────────────────────────────────────────
#
# kldload-enroll records each enrolment as /var/lib/kldload/mesh/enrolled/<vm>
# (node_id, guest_pub). Without this block a deleted VM stayed a peer on both
# planes forever: nothing on the delete path removed peers at all (onyx,
# 2026-09-22, peer 150 left behind by an enrolled clone).
#
# The id is removed only while the host's peer block for it still holds THIS
# VM's key: an id can be reallocated to a newer VM, and remove-peer by id would
# then cut the wrong machine off. A VM enrolled before the record existed has
# no file; say so rather than pretend it was clean.
_mesh_rec="/var/lib/kldload/mesh/enrolled/${NAME}"
_m_id=""
_m_pub=""
_m_src=""
if [[ -n "$_db_mesh_id" && -n "$_db_mesh_pub" ]]; then
    _m_id="$_db_mesh_id"
    _m_pub="$_db_mesh_pub"
    _m_src="state DB"
elif [[ "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && -r "$_mesh_rec" ]]; then
    _m_id="$(sed -n 's/^node_id=//p' "$_mesh_rec")"
    _m_pub="$(sed -n 's/^guest_pub=//p' "$_mesh_rec")"
    _m_src="$_mesh_rec"
fi
if [[ -n "$_m_src" ]]; then
    # swallow: no wg-mgmt.conf, or no block for the id, both mean "nothing to remove"
    _m_have="$(awk -v id="$_m_id" '$0 ~ "^# Node " id "([[:space:]]|$)" {f=1; next} f && /^PublicKey/ {print $3; exit}' \
        /etc/wireguard/wg-mgmt.conf 2>/dev/null || true)"
    if [[ ! "$_m_id" =~ ^[0-9]+$ || -z "$_m_pub" ]]; then
        echo "WARNING: mesh record in ${_m_src} is malformed — check 'wg show' for a leftover peer by hand" >&2
        _mesh_left=1
    elif [[ "$_m_have" == "$_m_pub" ]]; then
        kube-network remove-peer "$_m_id" </dev/null >/dev/null 2>&1 ||
            echo "WARNING: kube-network remove-peer ${_m_id} failed" >&2
        # Outcome, not exit code: the key must be gone from the RUNNING interface.
        if wg show wg-mgmt peers 2>/dev/null | grep -qxF "$_m_pub"; then
            echo "WARNING: ${NAME} is still a mesh peer (id ${_m_id}) — remove it: kube-network remove-peer ${_m_id}" >&2
            _mesh_left=1
        else
            echo "Removed from the mesh (peer ${_m_id}, identity from ${_m_src})"
            rm -f "$_mesh_rec"
        fi
    elif wg show wg-mgmt peers 2>/dev/null | grep -qxF "$_m_pub"; then
        echo "WARNING: ${NAME}'s key is on the mesh but not under id ${_m_id} — left alone, check 'wg show'" >&2
        _mesh_left=1
    else
        echo "Not on the mesh (peer ${_m_id} already gone)"
        rm -f "$_mesh_rec"
    fi
fi

# The DB row is cleared either way -- an inventory advertising a machine that
# is gone from libvirt is worse than a stray zvol -- but the EXIT STATUS tells
# the truth, so a caller that checks it is not told a leak was a clean delete.
if ((${_zvol_left:-0} || ${_mesh_left:-0})); then
    exit 1
fi
