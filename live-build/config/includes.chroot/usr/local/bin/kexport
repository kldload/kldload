#!/usr/bin/env bash
set -Eeuo pipefail
trap 'echo "kexport: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

# kexport — export a disk to qcow2, raw, VHD, VMDK, or OVA
# Usage: kexport /dev/sda qcow2
#        kexport /dev/vda vmdk
#        kexport /dev/sda all
#        kexport /dev/sda qcow2 /home/live/out  --no-seal
#
# By default the output is sealed (kldload-seal: no machine-id / ssh host
# keys / hostid / cloud-init seed carry-over), so it is a portable golden.
# The seal is applied to a COPY -- a ZFS clone for a zvol, a sparse raw
# file in the output directory for anything else -- and the source is
# never written. (Until 2026-09-29 the SOURCE was sealed: exporting a
# shut-off VM stripped that VM's identity and mesh keys for good.) Pass
# --no-seal for a 1:1 image of the source (VM migration).
# See kexport(8) and kldload-seal(8).

# Parse positional args (DISK, FMT, OUTDIR) and a --no-seal flag in any
# order. Defaults: OUTDIR=/root/exports, sealing ON.
DISK=""
FMT=""
OUTDIR="/root/exports"
SEAL=1
HELP=0
for a in "$@"; do
    case "$a" in
    --no-seal) SEAL=0 ;;
    --seal) SEAL=1 ;;
    -h | --help) HELP=1 ;;
    *)
        if [[ -z "$DISK" ]]; then
            DISK="$a"
        elif [[ -z "$FMT" ]]; then
            FMT="$a"
        else OUTDIR="$a"; fi
        ;;
    esac
done
NAME="${KEXPORT_NAME:-kldload-export-$(date -u +%Y%m%d-%H%M)}"

usage() {
    echo "kexport — export a disk image (sealed by default)"
    echo ""
    echo "Usage: kexport <disk> <format> [output-dir] [--seal | --no-seal]"
    echo ""
    echo "VM formats (whole-disk):"
    echo "  qcow2    KVM / Proxmox / OpenStack (compressed)"
    echo "  raw      dd-ready sparse disk image"
    echo "  vhd      Azure / Hyper-V"
    echo "  vmdk     VMware ESXi / vSphere"
    echo "  ova      VMware / VirtualBox portable (OVF + VMDK tar)"
    echo ""
    echo "Container / microVM formats (rootfs extracted):"
    echo "  oci          Docker image tarball (docker load / podman load)"
    echo "  lxc          LXC template tarball (lxc-create -t local)"
    echo "  firecracker  Linux kernel + ext4 rootfs + firecracker config.json"
    echo ""
    echo "  all      Export all VM formats (qcow2+raw+vhd+vmdk+ova)"
    echo ""
    echo "Sealing:"
    echo "  By default the output is sealed with kldload-seal so it is a"
    echo "  portable golden: no machine-id, ssh host keys, hostid or"
    echo "  cloud-init state. The seal is applied to a copy (a ZFS clone of a"
    echo "  zvol, else a sparse raw file in the output directory); the source"
    echo "  is never written. --no-seal exports the source 1:1 (migration)."
    echo ""
    echo "The source may be a block device, a zvol, or an image file in any"
    echo "format qemu-img reads (qcow2, raw, vmdk, ...). Needs root."
    echo ""
    echo "Exit: 0 exported, 1 failed, 2 usage. See kexport(8)."
    echo ""
    echo "Examples:"
    echo "  kexport /dev/sda qcow2                # sealed by default"
    echo "  kexport /dev/vda all /home/live/Desktop"
    echo "  kexport /dev/sda qcow2 --no-seal      # 1:1 clone, no sysprep"
    echo "  kexport /dev/sda oci                  # → docker-loadable tar.gz"
    echo "  kexport /dev/sda firecracker          # → kernel + rootfs.ext4 + json"
    echo "  KEXPORT_NAME=myserver kexport /dev/sda vmdk"
}

die() {
    echo "ERROR: $*" >&2
    exit 1
}
log() { echo "[kexport] $*"; }

# asked-for help is 0; a missing operand is a usage error, 2
((HELP)) && {
    usage
    exit 0
}
[[ -n "$DISK" ]] || {
    usage >&2
    exit 2
}
[[ -n "$FMT" ]] || {
    usage >&2
    exit 2
}
[[ -b "$DISK" || -f "$DISK" ]] || die "$DISK is not a block device or file"
[[ $EUID -eq 0 ]] || die "must run as root (it reads disks, and seals and mounts copies)"
command -v qemu-img >/dev/null || die "qemu-img not found — install qemu-img"

mkdir -p "$OUTDIR"

# ── What is converted: the source, or a sealed copy of it ─────────────
# SRC is what every format below reads; SRC_FMT is its format for qemu-img.
# Asked of qemu-img, not assumed: every conversion said `-f raw`, so a
# qcow2 file given as the source was copied as if its container bytes were
# a disk, and `raw` used dd, which did the same (found 2026-09-29).
SRC="$DISK"
_CLONE="" _SNAP="" _TMPRAW=""
_cleanup_copy() {
    # each one is this run's own, named with its PID; say it if it stays
    # -r: the clone lives under rpool/vms, and sanoid's schedule snapshots it
    # like any machine if it runs mid-export -- then a plain destroy fails and
    # the clone and its origin snapshot stay (onyx, 23:30, 2026-09-29). What
    # is under this run's clone is this run's.
    if [[ -n "$_CLONE" ]]; then zfs destroy -r "$_CLONE" || echo "[kexport][warn] could not remove the clone $_CLONE" >&2; fi
    if [[ -n "$_SNAP" ]]; then zfs destroy "$_SNAP" || echo "[kexport][warn] could not remove the snapshot $_SNAP" >&2; fi
    if [[ -n "$_TMPRAW" ]]; then rm -f -- "$_TMPRAW"; fi
}
trap _cleanup_copy EXIT

# _zvol_of PATH -- the zvol dataset behind a device path, or nothing.
_zvol_of() {
    local real v
    real="$(readlink -f "$1")"
    [[ -b "$real" ]] || return 0
    while read -r v; do
        [[ "$(readlink -f "/dev/zvol/$v" 2>/dev/null)" == "$real" ]] && {
            printf '%s\n' "$v"
            return 0
        }
    done < <(zfs list -H -o name -t volume 2>/dev/null)
    return 0
}

# ── Seal the source first (default behaviour) ─────────────────────────
# Sealing strips per-VM identity (machine-id / ssh host keys / hostid /
# cloud-init seed / journald / login records) so the output is a
# portable golden, not a 1:1 clone of the source. Disabled with
# --no-seal for the case where you genuinely want a 1:1 clone (VM
# migration, forensic capture). See /usr/local/bin/kldload-seal for
# what gets stripped.
# A copy is made when the source would otherwise be written or mounted:
# to seal it, and for the container formats, which mount a filesystem --
# mounting a disk a running VM has mounted (even read-only: ext4 and XFS
# replay their journals) corrupts it. A zvol is cloned, which costs nothing;
# anything else is copied to a sparse raw file when it is to be sealed.
_container=0
case "$FMT" in oci | lxc | firecracker) _container=1 ;; esac
_ds="$(_zvol_of "$DISK")"
if ((SEAL || _container)) && [[ -n "$_ds" ]]; then
    _SNAP="${_ds}@kexport-$$"
    _CLONE="${_ds}-kexport-$$"
    log "Working from a clone of ${_ds}, not the source: ${_CLONE}"
    zfs snapshot "$_SNAP"
    zfs clone "$_SNAP" "$_CLONE"
    udevadm settle
    SRC="/dev/zvol/${_CLONE}"
    [[ -b "$SRC" ]] || die "the clone's device ${SRC} did not appear"
elif ((SEAL)); then
    # kldload-seal reads a file as raw, so the copy is raw whatever the source
    _TMPRAW="${OUTDIR}/.${NAME}.sealing.raw"
    log "Copying ${DISK} to ${_TMPRAW} to seal the copy, not the source"
    qemu-img convert -U -O raw "$DISK" "$_TMPRAW"
    SRC="$_TMPRAW"
fi

if ((SEAL)); then
    if [[ ! -x /usr/local/bin/kldload-seal ]]; then
        die "sealing requested but /usr/local/bin/kldload-seal not found — install kldload >= 1.1.0 or pass --no-seal"
    fi
    log "Sealing ${SRC}"
    /usr/local/bin/kldload-seal "$SRC" || die "kldload-seal failed on the copy of $DISK — refusing to ship an unsealed image. The error is above; --no-seal exports the source unsealed."
    log "Seal complete; proceeding to format conversion"
else
    echo "[kexport][warn] --no-seal: skipping sysprep. Output will carry the source's machine-id, ssh host keys, hostid, and cloud-init seed — DO NOT deploy this image multiple times."
fi
SRC_FMT="$(qemu-img info -U --output=json "$SRC" | python3 -c 'import json,sys; print(json.load(sys.stdin)["format"])')"
[[ "$SRC_FMT" =~ ^[a-z0-9]+$ ]] || die "qemu-img could not say what format $SRC is"
log "Source: ${SRC} (${SRC_FMT})"

do_export() {
    local fmt="$1"
    case "$fmt" in
    qcow2)
        log "Exporting ${DISK} → ${OUTDIR}/${NAME}.qcow2 (compressed)"
        qemu-img convert -U -f "$SRC_FMT" -O qcow2 -c -p "$SRC" "${OUTDIR}/${NAME}.qcow2"
        log "Done: ${OUTDIR}/${NAME}.qcow2 ($(du -sh "${OUTDIR}/${NAME}.qcow2" | cut -f1))"
        ;;
    raw)
        log "Exporting ${DISK} → ${OUTDIR}/${NAME}.raw (sparse)"
        qemu-img convert -U -f "$SRC_FMT" -O raw -p "$SRC" "${OUTDIR}/${NAME}.raw"
        log "Done: ${OUTDIR}/${NAME}.raw ($(du -sh "${OUTDIR}/${NAME}.raw" | cut -f1))"
        ;;
    vhd)
        log "Exporting ${DISK} → ${OUTDIR}/${NAME}.vhd"
        qemu-img convert -U -f "$SRC_FMT" -O vpc -o subformat=fixed,force_size "$SRC" "${OUTDIR}/${NAME}.vhd"
        log "Done: ${OUTDIR}/${NAME}.vhd ($(du -sh "${OUTDIR}/${NAME}.vhd" | cut -f1))"
        ;;
    vmdk)
        log "Exporting ${DISK} → ${OUTDIR}/${NAME}.vmdk"
        qemu-img convert -U -f "$SRC_FMT" -O vmdk -o subformat=streamOptimized "$SRC" "${OUTDIR}/${NAME}.vmdk"
        log "Done: ${OUTDIR}/${NAME}.vmdk ($(du -sh "${OUTDIR}/${NAME}.vmdk" | cut -f1))"
        ;;
    ova)
        log "Exporting ${DISK} → ${OUTDIR}/${NAME}.ova"
        qemu-img convert -U -f "$SRC_FMT" -O vmdk -o subformat=streamOptimized "$SRC" "${OUTDIR}/${NAME}.vmdk"
        local vmdk_size
        vmdk_size=$(stat -c%s "${OUTDIR}/${NAME}.vmdk" 2>/dev/null || echo 0)
        local disk_bytes
        # the disk's virtual size, from qemu-img for any source format (a
        # file's own size is not it for qcow2); no guessed fallback
        disk_bytes="$(qemu-img info -U --output=json "$SRC" | python3 -c 'import json,sys; print(json.load(sys.stdin)["virtual-size"])')"
        # HISTORY: the ovf: prefix was used and never declared, so no importer
        # could parse this file (xmllint: "Namespace prefix ovf ... is not
        # defined", 2026-09-29). Checked by xmllint below when it is present.
        cat >"${OUTDIR}/${NAME}.ovf" <<OVFEOF
<?xml version="1.0" encoding="UTF-8"?>
<Envelope xmlns="http://schemas.dmtf.org/ovf/envelope/1"
          xmlns:ovf="http://schemas.dmtf.org/ovf/envelope/1"
          xmlns:rasd="http://schemas.dmtf.org/wbem/wscim/1/cim-schema/2/CIM_ResourceAllocationSettingData"
          xmlns:vssd="http://schemas.dmtf.org/wbem/wscim/1/cim-schema/2/CIM_VirtualSystemSettingData">
  <References><File ovf:href="${NAME}.vmdk" ovf:id="file1" ovf:size="${vmdk_size}"/></References>
  <DiskSection><Disk ovf:capacity="${disk_bytes}" ovf:diskId="vmdisk1" ovf:fileRef="file1" ovf:format="http://www.vmware.com/interfaces/specifications/vmdk.html#streamOptimized"/></DiskSection>
  <VirtualSystem ovf:id="${NAME}">
    <Name>${NAME}</Name>
    <OperatingSystemSection ovf:id="101"><Description>Linux</Description></OperatingSystemSection>
    <VirtualHardwareSection>
      <System><vssd:VirtualSystemType>vmx-14</vssd:VirtualSystemType></System>
      <Item><rasd:ElementName>4 virtual CPUs</rasd:ElementName><rasd:InstanceID>1</rasd:InstanceID><rasd:ResourceType>3</rasd:ResourceType><rasd:VirtualQuantity>4</rasd:VirtualQuantity></Item>
      <Item><rasd:AllocationUnits>byte * 2^20</rasd:AllocationUnits><rasd:ElementName>4096 MB of memory</rasd:ElementName><rasd:InstanceID>2</rasd:InstanceID><rasd:ResourceType>4</rasd:ResourceType><rasd:VirtualQuantity>4096</rasd:VirtualQuantity></Item>
      <Item><rasd:ElementName>disk1</rasd:ElementName><rasd:HostResource>ovf:/disk/vmdisk1</rasd:HostResource><rasd:InstanceID>3</rasd:InstanceID><rasd:ResourceType>17</rasd:ResourceType></Item>
    </VirtualHardwareSection>
  </VirtualSystem>
</Envelope>
OVFEOF
        if command -v xmllint >/dev/null 2>&1; then
            xmllint --noout "${OUTDIR}/${NAME}.ovf" || die "the OVF written is not valid XML"
        fi
        (cd "${OUTDIR}" && tar cf "${NAME}.ova" "${NAME}.ovf" "${NAME}.vmdk")
        rm -f "${OUTDIR}/${NAME}.vmdk" "${OUTDIR}/${NAME}.ovf"
        log "Done: ${OUTDIR}/${NAME}.ova ($(du -sh "${OUTDIR}/${NAME}.ova" | cut -f1))"
        ;;
    # ── Container / microVM formats ──────────────────────────────────────
    # All three mount the disk's root partition read-only, pull the rootfs,
    # and repackage it for the target runtime. We never modify the source
    # image — the mount is RO and everything happens in a scratch directory.
    oci | lxc | firecracker)
        _export_container "$fmt"
        ;;
    *)
        die "Unknown format: $fmt (use qcow2, raw, vhd, vmdk, ova, oci, lxc, firecracker, or all)"
        ;;
    esac
}

# _mount_source_rootfs -- mount SRC's largest partition on a scratch dir and
# print the dir (the ONLY thing on stdout: log lines here go to stderr, since
# the caller captures this with $( ). They went to stdout, so the "path" was
# a log line and a path, and no container export could work -- 2026-09-29.)
# A clone this run made is mounted read-write, which lets a journal replay
# into the clone; the real source is mounted read-only, and refused while
# any of it is mounted on this host. A loop device it attaches is found again
# by _umount_source_rootfs with losetup -j (this runs in a subshell, so a
# variable set here would not reach the caller).
_mount_source_rootfs() {
    local mp dev="$SRC" part opts=ro
    [[ -n "$_CLONE$_TMPRAW" ]] && opts=rw
    if [[ -f "$SRC" ]]; then
        # a raw file (a sealed copy, or a raw source); anything else cannot be
        # loop-mounted, and qemu-img's formats are for the VM exports
        [[ "$SRC_FMT" == raw ]] || die "a ${SRC_FMT} file cannot be mounted for ${FMT}; export it as qcow2/raw, or give the zvol"
        local lo=(-fP --show)
        [[ $opts == ro ]] && lo+=(-r)
        dev="$(losetup "${lo[@]}" "$SRC")"
        udevadm settle
    elif [[ -z "$_CLONE" ]] && lsblk -nro MOUNTPOINTS "$SRC" | grep -q .; then
        die "$SRC or a partition of it is mounted on this host — refusing to mount it again"
    fi
    part="$(lsblk -nrpbo NAME,SIZE,TYPE "$dev" | awk '$3=="part"{print $2, $1}' | sort -n | tail -1 | awk '{print $2}')"
    [[ -n "$part" ]] || part="$dev"
    mp="$(mktemp -d /var/tmp/kexport-root.XXXXXX)"
    echo "[kexport] Mounting ${part} on ${mp} (${opts})" >&2
    if ! mount -o "$opts" "$part" "$mp" >&2; then
        rmdir "$mp"
        die "could not mount ${part}"
    fi
    echo "$mp"
}

_umount_source_rootfs() {
    local mp="$1"
    [[ -n "$mp" && -d "$mp" ]] || return 0
    umount "$mp" || echo "[kexport][warn] could not unmount $mp" >&2
    rmdir "$mp" || true # still mounted: said just above
    local l
    if [[ -f "$SRC" ]]; then
        for l in $(losetup -nO NAME -j "$SRC"); do
            losetup -d "$l" || echo "[kexport][warn] could not detach $l" >&2
        done
    fi
}

_export_container() {
    local fmt="$1"
    local mp
    mp="$(_mount_source_rootfs)"
    # expanded now on purpose (mp is local); the trap clears itself, or it
    # would fire again on every later function return
    # shellcheck disable=SC2064
    trap "_umount_source_rootfs '$mp'; trap - RETURN" RETURN

    case "$fmt" in
    oci)
        # Docker image tarball. Produces a single tar.gz of the rootfs that
        # `docker import` / `podman import` ingests into an image. Simpler
        # than the full OCI layout spec — and sufficient for every Docker
        # client in the wild.
        local out="${OUTDIR}/${NAME}-oci.tar.gz"
        log "Exporting rootfs → ${out} (Docker importable)"
        # --numeric-owner so users don't need /etc/passwd in the image
        # --exclude boot/vm/run/tmp — those don't belong in a container
        tar -C "$mp" --numeric-owner \
            --exclude=./proc --exclude=./sys --exclude=./dev \
            --exclude=./run --exclude=./tmp --exclude=./var/tmp \
            --exclude=./var/cache/apt --exclude=./var/cache/dnf \
            --exclude=./boot --exclude=./var/log \
            -czf "$out" .
        log "Done: $out ($(du -sh "$out" | cut -f1))"
        log "  Import: docker import $out kldload:$(date +%Y%m%d)"
        log "  Import: podman import $out kldload:$(date +%Y%m%d)"
        ;;

    lxc)
        # LXC template tarball — LXC's "local" template driver accepts this
        # format directly. Ships with a minimal config stub so lxc-create
        # knows architecture and OS flavor without probing.
        local tarball="${OUTDIR}/${NAME}-lxc.tar.xz"
        local meta="${OUTDIR}/${NAME}-lxc-meta.tar.xz"
        log "Exporting rootfs → ${tarball} (LXC template)"
        tar -C "$mp" --numeric-owner \
            --exclude=./proc --exclude=./sys --exclude=./dev \
            --exclude=./run --exclude=./tmp \
            -cJf "$tarball" .
        # LXC metadata tarball — tiny companion file with OS metadata
        local meta_dir
        meta_dir="$(mktemp -d)"
        cat >"${meta_dir}/config" <<LXCCFG
lxc.arch = $(uname -m)
lxc.include = /usr/share/lxc/config/common.conf
lxc.rootfs.path = dir:/var/lib/lxc/%NAME%/rootfs
LXCCFG
        cat >"${meta_dir}/create-message" <<MSG
kldload LXC template — created $(date -u +%Y-%m-%dT%H:%M:%SZ)
Deploy: lxc-create -n mycontainer -t local -- --metadata ${meta##*/} --fstree ${tarball##*/}
MSG
        tar -C "$meta_dir" -cJf "$meta" .
        rm -rf "$meta_dir"
        log "Done: $tarball + $meta"
        log "  Deploy on LXC host:"
        log "    lxc-create -n mycontainer -t local -- \\"
        log "      --metadata $meta --fstree $tarball"
        ;;

    firecracker)
        # Firecracker microVMs need three artifacts: a kernel uncompressed
        # (Firecracker doesn't boot bzImage, wants vmlinux), an ext4 rootfs,
        # and a JSON config describing the VM. Output all three as a bundle
        # so the target host can launch in one firecracker invocation.
        local bundle="${OUTDIR}/${NAME}-firecracker"
        mkdir -p "$bundle"
        log "Building Firecracker bundle → ${bundle}/"

        # 1. Kernel -- the distribution's bzImage, copied as it is. WARN: this
        # comment used to say Firecracker boots a bzImage from v1.1; it does
        # from 1.17.0 (kfire reads the version for exactly this), and nothing
        # here extracted a vmlinux. Nor is there an initrd, which most
        # distribution kernels need to find a virtio root. kfire(8) builds
        # Firecracker machines that boot; this bundle is the raw material,
        # and says so below (corrected 2026-09-29, not boot-tested).
        local src_kern
        src_kern=$(find "$mp/boot" -name 'vmlinuz-*' 2>/dev/null | sort -V | tail -1)
        if [[ -n "$src_kern" ]]; then
            cp "$src_kern" "${bundle}/vmlinuz"
            log "  kernel: $(basename "$src_kern") → vmlinuz"
        else
            # A /boot on its own partition (Rocky's cloud images) is not read:
            # only the largest partition, the root, is mounted.
            log "WARNING: no kernel found in /boot — you'll need to supply one"
        fi

        # 2. Rootfs — ext4 image sized to contents + 25% headroom.
        log "  building rootfs.ext4..."
        local rootfs_size_mb
        rootfs_size_mb=$(du -sm "$mp" | cut -f1)
        rootfs_size_mb=$((rootfs_size_mb * 125 / 100 + 512))
        dd if=/dev/zero of="${bundle}/rootfs.ext4" bs=1M count="$rootfs_size_mb" status=none
        mkfs.ext4 -F -L "${NAME}" "${bundle}/rootfs.ext4" >/dev/null 2>&1
        local fs_mp
        fs_mp="$(mktemp -d)"
        mount -o loop "${bundle}/rootfs.ext4" "$fs_mp"
        # Copy with -aX to preserve attrs, skip pseudo-fs
        (cd "$mp" && tar --exclude=./proc --exclude=./sys --exclude=./dev \
            --exclude=./run --exclude=./tmp -cf - .) |
            (cd "$fs_mp" && tar -xf -)
        umount "$fs_mp"
        rmdir "$fs_mp"
        log "  rootfs: ${rootfs_size_mb}MB"

        # 3. Firecracker config JSON
        cat >"${bundle}/config.json" <<FCJSON
{
  "boot-source": {
    "kernel_image_path": "./vmlinuz",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off ro root=/dev/vda"
  },
  "drives": [
    {"drive_id": "rootfs", "path_on_host": "./rootfs.ext4",
     "is_root_device": true, "is_read_only": false}
  ],
  "machine-config": {"vcpu_count": 2, "mem_size_mib": 2048, "smt": false},
  "network-interfaces": [
    {"iface_id": "eth0", "host_dev_name": "tap0"}
  ]
}
FCJSON

        # 4. Tiny launcher script so the target host can just run ./launch.sh
        cat >"${bundle}/launch.sh" <<'LAUNCH'
#!/bin/sh
# One-shot Firecracker launcher. Requires firecracker binary in PATH and
# a TAP device named tap0 pre-configured (ip tuntap add tap0 mode tap; ...)
set -e
cd "$(dirname "$0")"
firecracker --no-api --config-file config.json
LAUNCH
        chmod +x "${bundle}/launch.sh"

        log "Done: ${bundle}/ ($(du -sh "$bundle" | cut -f1))"
        log "  On target (firecracker installed): ${bundle}/launch.sh"
        if [[ -f "${bundle}/vmlinuz" ]]; then
            log "  NOTE: vmlinuz is a bzImage (Firecracker boots one from 1.17.0) and there"
            log "  is no initrd; for a machine that boots, use kfire. See kexport(8)."
        fi
        ;;
    esac
}

if [[ "$FMT" == "all" ]]; then
    for f in qcow2 raw vhd vmdk ova; do
        do_export "$f"
    done
else
    do_export "$FMT"
fi

log "Export complete → ${OUTDIR}/"
