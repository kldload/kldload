#!/usr/bin/env bash
# kube-network — configure WireGuard backplane for Kubernetes cluster
# Sets up encrypted mesh between K8s nodes with dedicated planes:
#   wg-mgmt (10.250.0.x)  — SSH, management, monitoring
#   wg-k8s  (10.251.0.x)  — kubelet, API server, Cilium, pod-to-pod
#
# Usage:
#   kube-network init <node-id>           — generate keys, create configs (node-id: 1-254)
#   kube-network add-peer <peer-ip> <peer-pubkey> <peer-id>  — add a peer to the mesh
#   kube-network status                   — show WireGuard status
#   kube-network pin-kubelet              — pin kubelet to wg-k8s interface
#   kube-network nft                      — apply K8s-aware nftables rules
set -euo pipefail

if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

MGMT_SUBNET="10.250.0"
K8S_SUBNET="10.251.0"
MGMT_PORT=51820
K8S_PORT=51821

log() { echo -e "\033[1;32m[kube-network]\033[0m $*"; }
warn() { echo -e "\033[1;33m[kube-network]\033[0m $*" >&2; }
die() {
    echo -e "\033[1;31m[kube-network]\033[0m $*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: kube-network <command> [args]

Commands:
  init <node-id>                          Generate keys, create WireGuard configs
  add-peer <endpoint> <pubkey> <peer-id>  Add a peer to the mesh
  remove-peer <peer-id>                   Remove a peer from both planes
  show-keys                               Show this node's public keys
  status                                  WireGuard interface status
  pin-kubelet                             Pin kubelet node-ip to wg-k8s
  nft                                     Apply K8s nftables firewall rules

Node IDs:
  1   = control plane (10.250.0.1, 10.251.0.1)
  2+  = workers       (10.250.0.N, 10.251.0.N)

Example — 3-node cluster:
  # On node 1 (control plane):
  kube-network init 1
  kube-network show-keys    # copy pubkeys

  # On node 2 (worker):
  kube-network init 2
  kube-network add-peer 203.0.113.1 <node1-mgmt-pubkey> 1
  kube-network show-keys    # send back to node 1

  # Back on node 1:
  kube-network add-peer 203.0.113.2 <node2-mgmt-pubkey> 2

  # Then on all nodes:
  kube-network pin-kubelet
  kube-network nft
EOF
    exit 1
}

# ── init ───────────────────────────────────────────────────────────────────
cmd_init() {
    local node_id="${1:?Usage: kube-network init <node-id>}"
    [[ "$node_id" =~ ^[0-9]+$ ]] || die "node-id must be a number (1-254)"
    [[ "$node_id" -ge 1 && "$node_id" -le 254 ]] || die "node-id must be 1-254"

    # REFUSE TO CLOBBER AN INITIALISED NODE.
    #
    # Everything below does `cat >/etc/wireguard/wg-*.conf`, which truncates
    # both files and every [Peer] in them, then bounces the interfaces. On a
    # node that is already meshed that is not a re-init, it is a teardown: the
    # node keeps its keys but loses every peer it had, and the mesh it belonged
    # to loses a member without anything failing or logging.
    #
    # HISTORY: .124, 2026-08-24. kldload-enroll called this unconditionally on
    # every guest, and once the enrollment sweep ran on a ten-minute timer it
    # flattened a healthy 6-node Kubernetes mesh — 6 peers per node down to 1 —
    # on every pass. kubectl exec, cluster DNS and every cross-node workload
    # broke while all six nodes still reported Ready, because a kubelet only
    # needs the single peer that init leaves behind. The caller is fixed, but a
    # destructive default with no guard will find another caller eventually.
    #
    # --force is the escape hatch for a genuine re-key or a node being moved to
    # a new id; it is deliberately explicit, because the cost of doing this by
    # accident is an estate-wide outage that reports success.
    # "Initialised" means the CONFIGS exist, not merely that a marker does.
    #
    # .node-id alone is not evidence. kube-cluster's clean-slate removes
    # /etc/wireguard/wg-mgmt.* and wg-k8s.* and leaves .node-id behind, so the
    # host ends up marked as node N with every config deleted. init then saw the
    # marker, agreed the id matched, and returned 0 WITHOUT DOING ANYTHING --
    # silent success, no output, nothing created.
    #
    # The cost is not obvious from here: the hypervisor never rejoins the mesh,
    # kubectl silently falls back to virbr0, wgxplore has no interface to show,
    # and Prometheus cannot scrape any node. mesh-repair could not fix it either,
    # because its own repair path calls this function.
    # HISTORY: fiend 2026-08-31 -- .node-id said 100, both configs gone,
    # `kube-network init 100` exited 0 and created nothing.
    #
    # The refuse-to-clobber guard below still stands on its own history (a
    # ten-minute enrollment sweep flattening a healthy 6-node mesh); this only
    # narrows WHEN it applies, to the case where there is a real config to
    # protect.
    local _has_cfg=0
    [[ -s /etc/wireguard/wg-mgmt.conf || -s /etc/wireguard/wg-k8s.conf ]] && _has_cfg=1
    if [[ -s /etc/wireguard/.node-id && $_has_cfg -eq 0 && "${2:-}" != "--force" ]]; then
        log "node-id marker says $(tr -cd '0-9' </etc/wireguard/.node-id) but no wg-mgmt/wg-k8s config exists — re-initialising"
        rm -f /etc/wireguard/.node-id
    fi
    if [[ -s /etc/wireguard/.node-id && "${2:-}" != "--force" ]]; then
        local _have_id _peers
        _have_id="$(tr -cd '0-9' </etc/wireguard/.node-id)"
        _peers="$(awk '/^\[Peer\]/ {n++} END {print n+0}' \
            /etc/wireguard/wg-mgmt.conf /etc/wireguard/wg-k8s.conf 2>/dev/null)"
        log "already initialised as node ${_have_id}, holding ${_peers:-0} peer(s) across both planes — refusing to re-init"
        log "  (this would erase every peer; pass --force if you really mean to re-key)"
        [[ "$_have_id" == "$node_id" ]] && return 0
        die "requested id ${node_id} but this node is ${_have_id} — use --force to move it"
    fi

    install -d -m700 /etc/wireguard
    local old_umask
    old_umask="$(umask)"
    umask 077

    # Generate one key pair shared by both planes — simplifies peer exchange
    if [[ ! -f "/etc/wireguard/wg-mgmt.key" ]]; then
        wg genkey | tee "/etc/wireguard/wg-mgmt.key" | wg pubkey >"/etc/wireguard/wg-mgmt.pub"
        log "Generated WireGuard keys"
    fi
    # Both interfaces use the same key pair
    cp /etc/wireguard/wg-mgmt.key /etc/wireguard/wg-k8s.key
    cp /etc/wireguard/wg-mgmt.pub /etc/wireguard/wg-k8s.pub

    # Management plane
    cat >/etc/wireguard/wg-mgmt.conf <<EOF
[Interface]
Address = ${MGMT_SUBNET}.${node_id}/24
PrivateKey = $(cat /etc/wireguard/wg-mgmt.key)
ListenPort = ${MGMT_PORT}
MTU = 1420
EOF

    # Kubernetes plane
    cat >/etc/wireguard/wg-k8s.conf <<EOF
[Interface]
Address = ${K8S_SUBNET}.${node_id}/24
PrivateKey = $(cat /etc/wireguard/wg-k8s.key)
ListenPort = ${K8S_PORT}
MTU = 1420
EOF

    chmod 600 /etc/wireguard/*.conf /etc/wireguard/*.key
    umask "$old_umask"

    # Save node ID for future reference
    echo "$node_id" >/etc/wireguard/.node-id

    # Bring up interfaces
    systemctl enable --now wg-quick@wg-mgmt 2>/dev/null || wg-quick up wg-mgmt 2>/dev/null || true
    systemctl enable --now wg-quick@wg-k8s 2>/dev/null || wg-quick up wg-k8s 2>/dev/null || true

    log "WireGuard initialized for node ${node_id}:"
    log "  Management: ${MGMT_SUBNET}.${node_id}/24 (port ${MGMT_PORT})"
    log "  Kubernetes: ${K8S_SUBNET}.${node_id}/24 (port ${K8S_PORT})"
    echo ""
    log "Public keys:"
    log "  wg-mgmt: $(cat /etc/wireguard/wg-mgmt.pub)"
    log "  wg-k8s:  $(cat /etc/wireguard/wg-k8s.pub)"
    echo ""
    log "Next: share public keys with peers and run:"
    log "  kube-network add-peer <endpoint> <pubkey> <peer-id>"
}

# ── add-peer ───────────────────────────────────────────────────────────────
cmd_add_peer() {
    local endpoint="${1:?Usage: kube-network add-peer <endpoint> <pubkey> <peer-id>}"
    local pubkey="${2:?missing peer public key}"
    local peer_id="${3:?missing peer node-id}"

    [[ -f /etc/wireguard/wg-mgmt.conf ]] || die "Run 'kube-network init' first"

    # Add peer to management plane
    cat >>/etc/wireguard/wg-mgmt.conf <<EOF

[Peer]
# Node ${peer_id}
PublicKey = ${pubkey}
Endpoint = ${endpoint}:${MGMT_PORT}
AllowedIPs = ${MGMT_SUBNET}.${peer_id}/32
PersistentKeepalive = 25
EOF

    # Add peer to K8s plane (same endpoint, different port)
    # Peer needs to share their wg-k8s pubkey separately, but for simplicity
    # we use the same key for both planes (can be changed later)
    cat >>/etc/wireguard/wg-k8s.conf <<EOF

[Peer]
# Node ${peer_id}
PublicKey = ${pubkey}
Endpoint = ${endpoint}:${K8S_PORT}
AllowedIPs = ${K8S_SUBNET}.${peer_id}/32
PersistentKeepalive = 25
EOF

    # Reload
    wg-quick down wg-mgmt 2>/dev/null
    wg-quick up wg-mgmt 2>/dev/null || true
    wg-quick down wg-k8s 2>/dev/null
    wg-quick up wg-k8s 2>/dev/null || true

    log "Peer ${peer_id} added: ${endpoint}"
    log "  Management: ${MGMT_SUBNET}.${peer_id}"
    log "  Kubernetes: ${K8S_SUBNET}.${peer_id}"
}

# ── remove-peer ────────────────────────────────────────────────────────────
# Drop a peer from BOTH planes by node id.
#
# WHY this exists: there was no way to remove a peer at all. add-peer appends a
# [Peer] block and nothing ever took one away, so a node that got destroyed
# stayed in every surviving node's config forever. On a cluster that had seen a
# few add/remove cycles the first control plane carried 17 peers where 8 were
# correct — dead tunnels retrying keepalives against IPs that now belong to
# nothing, and a config no operator could reconcile by reading it
# (fiend, 2026-08-16).
#
# Matches on the "# Node <id>" comment that add-peer writes, which is the only
# stable identifier in the block: the endpoint IP is a DHCP lease that moves,
# and the pubkey is regenerated whenever a node is rebuilt.
#
# Args: peer node id.  Exit: 0 whether or not the peer was present — removing
# something already absent is the desired end state, and callers doing cluster
# cleanup should not have to care which.
cmd_remove_peer() {
    local peer_id="${1:?Usage: kube-network remove-peer <peer-id>}"
    [[ "$peer_id" =~ ^[0-9]+$ ]] || die "peer-id must be a number (got '${peer_id}')"

    local removed=0 conf tmp
    for conf in /etc/wireguard/wg-mgmt.conf /etc/wireguard/wg-k8s.conf; do
        [[ -f "$conf" ]] || continue
        tmp="$(mktemp)"
        # Buffer each [Peer] stanza and emit it only if it is not the one asked
        # for. Everything before the first [Peer] (the [Interface] section)
        # passes through untouched.
        awk -v id="$peer_id" '
            function flush() {
                if (inpeer && !drop) printf "%s", buf
                inpeer = 0; buf = ""; drop = 0
            }
            /^\[Peer\]/ { flush(); inpeer = 1; buf = $0 "\n"; next }
            inpeer {
                buf = buf $0 "\n"
                if ($0 ~ "^# Node " id "$") drop = 1
                next
            }
            { print }
            END { flush() }
        ' "$conf" >"$tmp" || {
            rm -f "$tmp"
            die "failed to rewrite ${conf}"
        }
        if ! cmp -s "$conf" "$tmp"; then
            # Atomic replace: a half-written wg config is a node that cannot
            # rejoin the mesh on the next wg-quick up.
            cat "$tmp" >"$conf"
            removed=1
        fi
        rm -f "$tmp"
    done

    if ((removed)); then
        wg-quick down wg-mgmt 2>/dev/null
        wg-quick up wg-mgmt 2>/dev/null || true
        wg-quick down wg-k8s 2>/dev/null
        wg-quick up wg-k8s 2>/dev/null || true
        log "Peer ${peer_id} removed"
    else
        log "Peer ${peer_id} not present — nothing to do"
    fi
}

# ── show-keys ──────────────────────────────────────────────────────────────
cmd_show_keys() {
    [[ -f /etc/wireguard/wg-mgmt.pub ]] || die "Run 'kube-network init' first"
    echo "Node ID:  $(cat /etc/wireguard/.node-id 2>/dev/null || echo 'unknown')"
    echo "wg-mgmt:  $(cat /etc/wireguard/wg-mgmt.pub)"
    echo "wg-k8s:   $(cat /etc/wireguard/wg-k8s.pub)"
}

# ── status ─────────────────────────────────────────────────────────────────
cmd_status() {
    echo -e "\033[1;33m=== Management Plane (wg-mgmt) ===\033[0m"
    wg show wg-mgmt 2>/dev/null || echo "  Not running"
    echo ""
    echo -e "\033[1;33m=== Kubernetes Plane (wg-k8s) ===\033[0m"
    wg show wg-k8s 2>/dev/null || echo "  Not running"
}

# ── pin-kubelet ────────────────────────────────────────────────────────────
cmd_pin_kubelet() {
    local k8s_ip
    k8s_ip="$(ip -4 addr show wg-k8s 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1)"
    [[ -n "$k8s_ip" ]] || die "wg-k8s interface not found. Run 'kube-network init' first."

    mkdir -p /etc/default
    echo "KUBELET_EXTRA_ARGS=--node-ip=${k8s_ip}" >/etc/default/kubelet

    log "kubelet pinned to wg-k8s: ${k8s_ip}"
    log "Restart kubelet: systemctl restart kubelet"

    # Also update kubeadm config if cluster is running
    if [[ -f /etc/kubernetes/admin.conf ]]; then
        log "Cluster is running — kubelet will use new IP after restart"
        systemctl restart kubelet 2>/dev/null || true
    fi
}

# ── nft ────────────────────────────────────────────────────────────────────
cmd_nft() {
    local lan_if node_cidr pod_cidr
    lan_if="$(ip route show default 2>/dev/null | awk '/default/ {print $5; exit}')" || true
    : "${lan_if:=eth0}"
    # Node subnet — derived from the primary interface. This is the /24 (or
    # whatever) that all K8s nodes share on the same L2. Used to trust
    # kubelet:10250, hubble-peer:4244, cilium/tetragon metrics, etc. between
    # nodes without listing every port. Worker-to-worker east-west would
    # otherwise hit our drop policy and time out silently.
    node_cidr="$(ip -o -f inet addr show "${lan_if}" 2>/dev/null | awk '{print $4; exit}')" || true
    # Pod CIDR — matches the cilium helm install default. Keep in sync with
    # ipam.operator.clusterPoolIPv4PodCIDRList used by kube-init.
    pod_cidr="${K8S_POD_CIDR:-10.244.0.0/16}"

    cat >/etc/nftables.conf <<EOF
#!/usr/sbin/nft -f
flush ruleset

table inet filter {
  chain input {
    type filter hook input priority 0; policy drop;

    ct state established,related accept
    iifname "lo" accept
    ip protocol icmp accept

    # SSH on LAN only
    tcp dport 22 accept

    # WireGuard ports
    udp dport { ${MGMT_PORT}, ${K8S_PORT} } accept

    # Accept all traffic on WireGuard planes
    iifname "wg-mgmt" accept
    iifname "wg-k8s" accept

    # Trust the rest of the cluster — peer K8s nodes sit on this subnet and
    # need kubelet:10250, hubble-peer:4244, cilium metrics:2112/9962, hubble
    # metrics:9965, tetragon metrics:2112, cilium health:4240. Listing every
    # port is fragile; trusting the node subnet is simpler and still drops
    # WAN traffic (policy drop + NAT on the hypervisor).
    ${node_cidr:+ip saddr ${node_cidr} accept}
    # Pod CIDR — hubble-relay lives in a pod and dials hubble-peer from the
    # pod network, not the node network.
    ip saddr ${pod_cidr} accept

    # K8s API server (external access if needed)
    tcp dport 6443 accept

    # NodePort range
    tcp dport 30000-32767 accept
    udp dport 30000-32767 accept
  }

  chain forward {
    type filter hook forward priority 0; policy drop;

    ct state established,related accept

    # Allow forwarding between WireGuard planes
    iifname "wg-k8s" accept
    oifname "wg-k8s" accept
    iifname "wg-mgmt" accept
    oifname "wg-mgmt" accept

    # Allow pod traffic (Cilium manages this via eBPF but nft needs to allow it)
    iifname "cilium_*" accept
    oifname "cilium_*" accept
    iifname "lxc*" accept
    oifname "lxc*" accept

    # Pod CIDR in either direction — native-routing paths and hostPort
    # backhauls go through the primary interface, not cilium_*.
    ip saddr ${pod_cidr} accept
    ip daddr ${pod_cidr} accept
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}

table ip nat {
  chain postrouting {
    type nat hook postrouting priority 100; policy accept;
    oifname "${lan_if}" masquerade
  }
}
EOF

    nft -f /etc/nftables.conf || true
    systemctl enable --now nftables 2>/dev/null || true

    log "nftables configured for Kubernetes + WireGuard"
    log "  WireGuard planes: full access"
    log "  K8s API: port 6443 open"
    log "  NodePorts: 30000-32767 open"
    log "  Cilium: pod forwarding allowed"
}

# ── Dispatch ───────────────────────────────────────────────────────────────
case "${1:-}" in
init)
    shift
    cmd_init "$@"
    ;;
add-peer)
    shift
    cmd_add_peer "$@"
    ;;
remove-peer)
    shift
    cmd_remove_peer "$@"
    ;;
show-keys) cmd_show_keys ;;
status) cmd_status ;;
pin-kubelet) cmd_pin_kubelet ;;
nft) cmd_nft ;;
*) usage ;;
esac
