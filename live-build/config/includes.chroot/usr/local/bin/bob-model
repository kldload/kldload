#!/usr/bin/env bash
# bob-model — interactive model selector with pull capability
# Usage: bob-model              (interactive picker)
#        bob-model 70b          (shortcut)
#        bob-model deepseek     (shortcut)
#        bob-model pull mistral (pull new model)
set -euo pipefail

# ── Colors ───────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# ── Model catalog ────────────────────────────────────────────────────────────
declare -A MODELS
declare -A MODEL_SIZE
declare -A MODEL_RAM
declare -A MODEL_DESC

MODELS[bob]="bob"
MODEL_SIZE[bob]="5GB"
MODEL_RAM[bob]="8GB"
MODEL_DESC[bob]="Default Bob — fast, general purpose"

MODELS[deepseek7b]="deepseek-r1:7b"
MODEL_SIZE[deepseek7b]="4.7GB"
MODEL_RAM[deepseek7b]="8GB"
MODEL_DESC[deepseek7b]="Deep reasoning — better logic and math"

MODELS[deepseek32b]="deepseek-r1:32b"
MODEL_SIZE[deepseek32b]="20GB"
MODEL_RAM[deepseek32b]="32GB"
MODEL_DESC[deepseek32b]="Serious brain — needs 32GB+ RAM"

MODELS[70b]="llama3.1:70b"
MODEL_SIZE[70b]="40GB"
MODEL_RAM[70b]="48GB"
MODEL_DESC[70b]="Maximum power — needs 48GB+ RAM"

MODELS[codellama]="codellama:13b"
MODEL_SIZE[codellama]="7.4GB"
MODEL_RAM[codellama]="16GB"
MODEL_DESC[codellama]="Code specialist"

MODELS[mistral]="mistral:7b"
MODEL_SIZE[mistral]="4.1GB"
MODEL_RAM[mistral]="8GB"
MODEL_DESC[mistral]="Fast and capable"

# System RAM
_ram_gb=$(awk '/MemTotal/{printf "%.0f", $2/1024/1024}' /proc/meminfo 2>/dev/null || echo 0)

# ── Pull command ─────────────────────────────────────────────────────────────
if [[ "${1:-}" == "pull" ]] && [[ -n "${2:-}" ]]; then
  echo -e "${BLUE}Pulling ${2}...${NC}"
  ollama pull "$2"
  echo -e "${GREEN}✔${NC} Done"
  exit 0
fi

# ── Shortcut matching ────────────────────────────────────────────────────────
if [[ -n "${1:-}" ]]; then
  _input=$(echo "$1" | tr '[:upper:]' '[:lower:]')

  # Try exact match first
  for key in "${!MODELS[@]}"; do
    if [[ "$_input" == "$key" ]] || [[ "$_input" == "${MODELS[$key]}" ]]; then
      _selected="${MODELS[$key]}"
      break
    fi
  done

  # Try partial match
  if [[ -z "${_selected:-}" ]]; then
    for key in "${!MODELS[@]}"; do
      if echo "$key" | grep -qi "$_input" || echo "${MODELS[$key]}" | grep -qi "$_input"; then
        _selected="${MODELS[$key]}"
        break
      fi
    done
  fi

  # Direct model name
  if [[ -z "${_selected:-}" ]]; then
    _selected="$1"
  fi

  # Check if model exists locally
  if ! ollama list 2>/dev/null | grep -q "$(echo "$_selected" | cut -d: -f1)"; then
    echo -e "${YELLOW}Model ${_selected} not found locally. Pull it?${NC}"
    read -rp "[y/N] " _pull
    if [[ "$_pull" == "y" ]] || [[ "$_pull" == "Y" ]]; then
      ollama pull "$_selected"
    else
      exit 0
    fi
  fi

  # Set as default. This used to call _set_default, a function that was
  # never defined — swallowed by `2>/dev/null || true`, so the tool
  # printed success while persisting nothing. Write the same profile.d
  # drop-in the interactive path uses.
  if echo "export BOB_MODEL='${_selected}'" | sudo tee /etc/profile.d/bob-model.sh > /dev/null; then
    echo -e "${GREEN}✔${NC} Default model: ${BOLD}${_selected}${NC} (persisted — new shells pick it up)"
  else
    echo -e "${YELLOW}⚠${NC} could not write /etc/profile.d/bob-model.sh — default NOT persisted (need sudo)"
  fi
  exit 0
fi

# ── Interactive picker ───────────────────────────────────────────────────────
echo -e "${BOLD}Bob Model Selector${NC}"
echo -e "${DIM}System RAM: ${_ram_gb}GB${NC}"
echo ""

# List installed models
echo -e "${BOLD}Installed models:${NC}"
_installed=$(ollama list 2>/dev/null | tail -n +2 || true)
if [[ -n "$_installed" ]]; then
  echo "$_installed" | while read -r line; do
    echo -e "  ${GREEN}●${NC} ${line}"
  done
else
  echo -e "  ${DIM}No models installed${NC}"
fi

echo ""
echo -e "${BOLD}Available models:${NC}"
echo ""

_n=1
_options=()
for key in bob deepseek7b deepseek32b 70b codellama mistral; do
  _model="${MODELS[$key]}"
  _size="${MODEL_SIZE[$key]}"
  _ram="${MODEL_RAM[$key]}"
  _desc="${MODEL_DESC[$key]}"
  _ram_num=$(echo "$_ram" | tr -dc '0-9')

  # RAM warning
  _warn=""
  if [[ $_ram_gb -lt $_ram_num ]]; then
    _warn=" ${RED}(needs ${_ram} RAM — you have ${_ram_gb}GB)${NC}"
  fi

  # Installed indicator
  _installed_mark=""
  if ollama list 2>/dev/null | grep -q "$(echo "$_model" | cut -d: -f1)"; then
    _installed_mark="${GREEN}●${NC} "
  else
    _installed_mark="${DIM}○${NC} "
  fi

  echo -e "  ${_installed_mark}${BOLD}${_n})${NC} ${_model} ${DIM}(${_size})${NC}${_warn}"
  echo -e "     ${DIM}${_desc}${NC}"
  _options+=("$_model")
  _n=$((_n + 1))
done

echo ""
echo -e -n "${CYAN}Select model [1-${#_options[@]}]: ${NC}"
read -r _choice

if [[ -z "$_choice" ]] || [[ "$_choice" -lt 1 ]] || [[ "$_choice" -gt ${#_options[@]} ]] 2>/dev/null; then
  echo -e "${DIM}No change.${NC}"
  exit 0
fi

_selected="${_options[$((_choice - 1))]}"

# Pull if needed
if ! ollama list 2>/dev/null | grep -q "$(echo "$_selected" | cut -d: -f1)"; then
  echo -e "${BLUE}Pulling ${_selected}...${NC}"
  ollama pull "$_selected"
fi

# Set as default
echo "export BOB_MODEL='${_selected}'" | sudo tee /etc/profile.d/bob-model.sh > /dev/null 2>&1 || true
export BOB_MODEL="$_selected"

echo ""
echo -e "${GREEN}${BOLD}✔${NC} Default model set to: ${BOLD}${_selected}${NC}"
echo -e "${DIM}This persists across reboots.${NC}"
