#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════════════
# kube-cluster — deploy a Kubernetes cluster on KVM using ZFS instant clones
# ══════════════════════════════════════════════════════════════════════════════
#
# Deploys a production-grade Kubernetes cluster in a single command. The core
# insight is ZFS copy-on-write: a "golden image" zvol is prepared once (cloud
# image + K8s packages), snapshotted, then cloned per-node in ~100ms at near
# zero disk cost. Each clone gets its own cloud-init ISO to establish a unique
# identity (hostname, machine-id, SSH host keys).
#
# Architecture:
#   cloud qcow2 → ZFS zvol → cloud-init boot → kube-setup → seal → snapshot
#                                                        ↓
#   clone CP ─┐  (each clone = ZFS instant clone of golden@golden snapshot)
#   clone W1 ─┤  (each gets a per-node cloud-init ISO for unique identity)
#   clone W2 ─┤
#   clone W3 ─┘→ WireGuard mesh → kubeadm init/join → Cilium eBPF → done
#
# Network topology (dual WireGuard planes):
#   wg-mgmt  (10.251.0.0/24) — management plane: SSH, kubelet, API server
#   wg-k8s   (10.252.0.0/24) — data plane: pod-to-pod traffic, Cilium eBPF
#   Both are full-mesh: every node peers with every other node directly.
#   kubelet is pinned to the wg-mgmt IP so all K8s traffic stays encrypted.
#
# Dependencies:
#   Host:  zfs, qemu-img, virt-install, virsh, genisoimage/mkisofs/xorriso,
#          growpart, sshpass, kvm-clone (kldload tool)
#   VMs:   cloud-init, kubeadm, kubelet, containerd, helm, cilium-cli,
#          wireguard-tools (optional)
#
# Usage:
#   kube-cluster bootstrap [--workers N] [--ram MB] [--cpus N] [--disk GB]
#   kube-cluster destroy
#   kube-cluster status
#   kube-cluster golden   (build golden image only, skip cluster deploy)
# ══════════════════════════════════════════════════════════════════════════════
set -euo pipefail

# Re-exec as root — ZFS, virsh, and virt-install all require it
if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

# ── Defaults ──────────────────────────────────────────────────────────────
# All overridable via environment variables or --flags.
# Auto-scale VM resources based on host hardware. The CP runs etcd + API
# server + Cilium + MetalLB + Hubble and needs more RAM/CPU than workers.
WORKERS="${WORKERS:-3}"
CILIUM_CLI_VERSION="${CILIUM_CLI_VERSION:-0.19.2}"
_host_ram_mb=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 16384)
_host_cpus=$(nproc 2>/dev/null || echo 4)
if [[ $_host_ram_mb -ge 48000 ]]; then
  # 48GB+ host: generous allocation
  CP_RAM="${CP_RAM:-8192}"
  RAM="${RAM:-4096}"
  CP_CPUS="${CP_CPUS:-4}"
  CPUS="${CPUS:-2}"
elif [[ $_host_ram_mb -ge 24000 ]]; then
  # 24-48GB host: moderate
  CP_RAM="${CP_RAM:-6144}"
  RAM="${RAM:-3072}"
  CP_CPUS="${CP_CPUS:-4}"
  CPUS="${CPUS:-2}"
else
  # <24GB host: tight
  CP_RAM="${CP_RAM:-4096}"
  RAM="${RAM:-2048}"
  CP_CPUS="${CP_CPUS:-2}"
  CPUS="${CPUS:-2}"
fi
DISK="${DISK:-40}"
GOLDEN="k8s-golden"
CLUSTER_NAME="${CLUSTER_NAME:-kldload}"
CLOUD_IMAGE="${CLOUD_IMAGE:-}"
SSH_KEY="${SSH_KEY:-/root/.ssh/id_ed25519}"
POOL="rpool"

# ANSI color codes for terminal output
C="\033[1;36m"; G="\033[1;32m"; Y="\033[1;33m"; R="\033[1;31m"
W="\033[1;37m"; D="\033[0;37m"; N="\033[0m"

log()  { echo -e "${G}[kube-cluster]${N} $*"; }
warn() { echo -e "${Y}[kube-cluster]${N} $*" >&2; }
die()  { echo -e "${R}[kube-cluster]${N} $*" >&2; exit 1; }

CP_NAME="${CLUSTER_NAME}-cp"
WORKER_PREFIX="${CLUSTER_NAME}-w"

usage() {
  cat <<'EOF'
Usage: kube-cluster <command> [options]

Commands:
  bootstrap   Build golden image + deploy full cluster (one command)
  golden      Build golden image only (for manual cluster creation)
  destroy     Tear down the cluster (VMs + zvols)
  status      Show cluster status
  scale N     Add N more workers to existing cluster

Options:
  --workers N      Number of worker nodes (default: 3)
  --ram MB         RAM per node in MB (default: 4096)
  --cpus N         vCPUs per node (default: 2)
  --disk GB        Disk per node in GB (default: 40)
  --image PATH     Cloud image (qcow2) — auto-detected if omitted

Flow:
  kube-cluster bootstrap --workers 3
    1. Find/download cloud image (CentOS or Debian qcow2)
    2. Import to ZFS zvol, boot with cloud-init
    3. Run kube-setup inside VM (install kubeadm, containerd, etc.)
    4. Shut down + snapshot = golden image (cached for next time)
    5. Clone golden → control plane + N workers (~100ms each)
    6. Boot all, configure WireGuard mesh
    7. kube-init on CP (Cilium + MetalLB + ZFS CSI + Gateway API + Hubble)
    8. kube-join on workers
    9. Smoke test → done

Subsequent runs skip steps 1-4 (golden image is cached).

Examples:
  kube-cluster bootstrap                  # 1 CP + 3 workers, 4GB RAM each
  kube-cluster bootstrap --workers 5      # 1 CP + 5 workers
  kube-cluster bootstrap --ram 8192       # 8GB RAM per node
  kube-cluster destroy                    # tear down everything
  kube-cluster status                     # cluster health
EOF
  exit 1
}

# ── Parse args ─────────────────────────────────────────────────────────────
CMD="${1:-}"
[[ -n "$CMD" ]] || usage
shift

while [[ $# -gt 0 ]]; do
  case "$1" in
    --workers) WORKERS="$2"; shift 2 ;;
    --ram)     RAM="$2"; shift 2 ;;
    --cpus)    CPUS="$2"; shift 2 ;;
    --disk)    DISK="$2"; shift 2 ;;
    --image)   CLOUD_IMAGE="$2"; shift 2 ;;
    *)         die "Unknown option: $1" ;;
  esac
done

# ── Helpers ────────────────────────────────────────────────────────────────

# Poll SSH until the node is reachable. Default timeout is 5 minutes (150 * 2s).
# CentOS cloud images boot in ~30s; Debian can take 60-90s due to slower
# cloud-init datasource detection. The generous default covers both.
wait_for_ssh() {
  local ip="$1" max="${2:-150}"
  local i=0
  while ! _ssh_cmd "$ip" true 2>/dev/null; do
    ((i++))
    [[ $i -ge $max ]] && return 1
    sleep 2
  done
  return 0
}

# Resolve a VM's IP address with two fallback strategies.
# qemu-guest-agent (method 1) is faster and works even without DHCP, but the
# agent may not be installed in all cloud images. Falling back to DHCP lease
# matching (method 2) works universally on the virbr0 bridge network.
# Retries for up to 3 minutes (90 * 2s) — cloud-init DHCP can be slow.
get_vm_ip() {
  local vm="$1"
  local ip=""
  local mac=""
  for _ in $(seq 1 90); do
    # Method 1: virsh domifaddr (requires qemu-guest-agent)
    ip="$(virsh domifaddr "$vm" 2>/dev/null | awk '/ipv4/ {print $4}' | cut -d/ -f1)"
    [[ -n "$ip" ]] && break
    # Method 2: match MAC from VM definition to DHCP leases on virbr0
    if [[ -z "$mac" ]]; then
      mac="$(virsh domiflist "$vm" 2>/dev/null | awk '/bridge/ {print $5}')"
    fi
    if [[ -n "$mac" ]]; then
      ip="$(virsh net-dhcp-leases default 2>/dev/null | grep "$mac" | awk '{print $5}' | cut -d/ -f1)"
      [[ -n "$ip" ]] && break
    fi
    sleep 2
  done
  echo "$ip"
}

# SSH into a node, trying key-based auth first, then password fallback.
# Key auth works on clones (cloud-init injects the pubkey). Password fallback
# ("kldload") covers the golden image's first boot before keys propagate, and
# any case where the key isn't yet deployed. BatchMode=yes on the first attempt
# prevents interactive password prompts — it either works with the key or fails
# fast, letting sshpass handle the password path.
_ssh_cmd() {
  local ip="$1"; shift
  local attempt
  for attempt in 1 2 3; do
    ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 -o BatchMode=yes \
      -o ServerAliveInterval=5 -i "$SSH_KEY" "root@${ip}" "$@" 2>/dev/null && return 0
    sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 \
      -o ServerAliveInterval=5 "root@${ip}" "$@" 2>/dev/null && return 0
    [[ $attempt -lt 3 ]] && sleep 3
  done
  return 1
}

ensure_ssh_key() {
  if [[ ! -f "$SSH_KEY" ]]; then
    log "Generating SSH key for cluster management..."
    ssh-keygen -t ed25519 -f "$SSH_KEY" -N "" -q
  fi
}

# ── Detect Host Distro ────────────────────────────────────────────────────
# The golden image must match the host distro so kube-setup installs the
# correct package manager repos (dnf for CentOS/RHEL, apt for Debian/Ubuntu).
# Falls back to centos since that's the kldloadOS live environment.
detect_host_distro() {
  local id=""
  [[ -f /etc/os-release ]] && id="$(. /etc/os-release && echo "$ID")"
  echo "${id:-centos}"
}

HOST_DISTRO="$(detect_host_distro)"

# ── Find Cloud Image ──────────────────────────────────────────────────────
# Locates a qcow2 cloud image to use as the base for the golden VM.
# Precedence: --image flag > local file search > auto-download.
# The cloud image is a vendor-provided minimal OS with cloud-init baked in.
# It becomes the base layer that every cluster node inherits via ZFS clone.
find_cloud_image() {
  # Use explicit image if provided
  if [[ -n "$CLOUD_IMAGE" && -f "$CLOUD_IMAGE" ]]; then
    echo "$CLOUD_IMAGE"
    return 0
  fi

  # Search common locations — prefer images matching host distro
  local search_dirs=("/var/lib/libvirt/isos" "/root" "/tmp")
  for dir in "${search_dirs[@]}"; do
    for img in "${dir}"/*-GenericCloud*.qcow2 "${dir}"/*-genericcloud*.qcow2 \
               "${dir}"/*-cloud*.qcow2 "${dir}"/*nocloud*.qcow2; do
      [[ -f "$img" ]] && { echo "$img"; return 0; }
    done
  done

  # Download cloud image matching host distro
  local url dest
  mkdir -p /var/lib/libvirt/isos
  case "$HOST_DISTRO" in
    debian)
      url="https://cloud.debian.org/images/cloud/trixie/daily/latest/debian-13-genericcloud-amd64-daily.qcow2"
      dest="/var/lib/libvirt/isos/debian-13-genericcloud-amd64.qcow2"
      warn "No cloud image found. Downloading Debian 13 (Trixie)..."
      ;;
    ubuntu)
      url="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
      dest="/var/lib/libvirt/isos/ubuntu-24.04-cloudimg-amd64.qcow2"
      warn "No cloud image found. Downloading Ubuntu 24.04..."
      ;;
    *)
      url="https://cloud.centos.org/centos/9-stream/x86_64/images/CentOS-Stream-GenericCloud-9-latest.x86_64.qcow2"
      dest="/var/lib/libvirt/isos/CentOS-Stream-9-GenericCloud.qcow2"
      warn "No cloud image found. Downloading CentOS Stream 9..."
      ;;
  esac
  curl -fSL -o "$dest" "$url" || die "Failed to download cloud image"
  echo "$dest"
}

# ── Build Golden Image ────────────────────────────────────────────────────
# The golden image is the key optimization in this workflow. It is built once:
#   1. Import cloud qcow2 into a ZFS zvol (raw block device for KVM)
#   2. Boot with cloud-init to configure SSH, set root password
#   3. Run kube-setup to pre-install kubeadm, kubelet, containerd, helm, etc.
#   4. Seal: wipe cloud-init state, machine-id, hostname (clone-safe)
#   5. Shut down and snapshot as @golden
#
# After this, every new node is a ZFS clone of @golden — instant (<100ms),
# near-zero disk cost (copy-on-write), and already has all K8s packages.
# Each clone gets a fresh cloud-init ISO to establish unique identity.
build_golden() {
  # Skip rebuild if golden already exists — it's expensive (downloads, installs)
  if zfs list "${POOL}/vms/${GOLDEN}" >/dev/null 2>&1; then
    log "Golden image ${GOLDEN} already exists — skipping build"
    log "  (delete with: kvm-delete ${GOLDEN} to force rebuild)"
    return 0
  fi

  log "Building golden image: ${GOLDEN}"

  local cloud_img
  cloud_img="$(find_cloud_image)"
  log "Using cloud image: ${cloud_img}"

  ensure_ssh_key
  local pubkey
  pubkey="$(cat "${SSH_KEY}.pub")"

  # Create a sparse (-s) ZFS zvol — only consumes space for written blocks.
  # 64k volblocksize matches the qcow2 cluster size for efficient raw import.
  # lz4 compression is nearly free on modern CPUs and saves ~40% on OS images.
  log "Creating ZFS zvol (${DISK}G)..."
  zfs create -V "${DISK}G" -s -o volblocksize=64k \
    -o compression=lz4 "${POOL}/vms/${GOLDEN}" 2>/dev/null || true

  # ZFS creates the zvol asynchronously — the /dev/zvol symlink may not
  # appear immediately. Wait up to 10s for udev to create the block device.
  local zvol="/dev/zvol/${POOL}/vms/${GOLDEN}"
  for _ in $(seq 1 10); do [[ -b "$zvol" ]] && break; sleep 1; done
  [[ -b "$zvol" ]] || die "ZFS zvol device not found: ${zvol}"

  # Convert qcow2 to raw and write directly to the zvol block device.
  # This is the only full-copy in the workflow — all subsequent nodes are
  # ZFS clones that share these blocks via copy-on-write.
  log "Importing cloud image to ZFS zvol..."
  qemu-img convert -f qcow2 -O raw "$cloud_img" "$zvol"

  # Cloud images ship with small partitions (~2GB). Expand partition 1 to
  # fill the entire zvol so the VM has usable disk space.
  growpart "$zvol" 1 2>/dev/null || true

  # Cloud-init drives the golden VM's first-boot configuration. The ISO
  # (labeled "cidata") is attached as a virtual CDROM — cloud-init's NoCloud
  # datasource auto-detects it by volume label and applies the config.
  log "Creating cloud-init configuration..."
  local ci_dir
  ci_dir="$(mktemp -d)"

  cat > "${ci_dir}/meta-data" <<META
instance-id: ${GOLDEN}
local-hostname: ${GOLDEN}
META

  cat > "${ci_dir}/user-data" <<USERDATA
#cloud-config
hostname: ${GOLDEN}
manage_etc_hosts: true
disable_root: false
ssh_pwauth: true
users:
  - default
  - name: root
    lock_passwd: false
    ssh_authorized_keys:
      - ${pubkey}
    shell: /bin/bash
chpasswd:
  expire: false
  users:
    - name: root
      password: kldload
      type: text
ssh_authorized_keys:
  - ${pubkey}
package_update: true
packages:
  - openssh-server
  - sudo
  - curl
runcmd:
  - sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
  - sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
  - systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true
  - touch /var/lib/cloud/instance/kube-golden-ready
USERDATA

  # Network config matches both naming conventions: Debian uses predictable
  # names (en*) while CentOS cloud images use legacy names (eth*). Without
  # both matchers, DHCP would fail on one distro family or the other.
  cat > "${ci_dir}/network-config" <<NETCFG
version: 2
ethernets:
  id0:
    match:
      name: "en*"
    dhcp4: true
  id1:
    match:
      name: "eth*"
    dhcp4: true
NETCFG

  # Build the cloud-init ISO. Three tools can do this — try each in order
  # because different distros ship different ones (genisoimage on RHEL/CentOS,
  # mkisofs on some Debian, xorriso on minimal installs). The "cidata" volume
  # label is what cloud-init's NoCloud datasource keys on.
  local ci_iso="/var/lib/libvirt/isos/${GOLDEN}-cloud-init.iso"
  genisoimage -output "$ci_iso" -volid cidata -joliet -rock \
    "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null \
    || mkisofs -output "$ci_iso" -volid cidata -joliet -rock \
      "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null \
    || xorriso -as mkisofs -o "$ci_iso" -volid cidata -joliet -rock \
      "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null
  rm -rf "$ci_dir"

  # Boot the golden VM. The zvol is the primary disk (virtio for performance),
  # cloud-init ISO is a secondary CDROM. --import skips PXE/install — boot
  # directly from the cloud image's existing OS.
  log "Booting golden VM..."
  virt-install \
    --name "${GOLDEN}" \
    --ram "${RAM}" --vcpus "${CPUS}" \
    --os-variant "$(case $HOST_DISTRO in debian) echo debian12;; ubuntu) echo ubuntu24.04;; *) echo centos-stream9;; esac)" \
    --disk "$(readlink -f "${zvol}"),bus=virtio,cache=none" \
    --disk "${ci_iso},device=cdrom" \
    --network bridge=virbr0,model=virtio \
    --graphics vnc,listen=0.0.0.0 \
    --noautoconsole \
    --import \
    2>&1 || die "Failed to boot golden VM"

  # Wait for VM to boot and get IP
  log "Waiting for golden VM to boot..."
  local golden_ip
  golden_ip="$(get_vm_ip "${GOLDEN}")"
  [[ -n "$golden_ip" ]] || die "Golden VM did not get an IP"
  log "Golden VM IP: ${golden_ip}"

  # Wait for SSH
  log "Waiting for SSH..."
  wait_for_ssh "$golden_ip" 90 || die "SSH not available on golden VM"

  # Wait for cloud-init to finish all runcmd stages. The sentinel file
  # kube-golden-ready is created as the last runcmd step in user-data above.
  # This ensures SSH config changes and package installs have completed
  # before we run kube-setup. Timeout: 5 minutes (60 * 5s).
  log "Waiting for cloud-init..."
  for _ in $(seq 1 60); do
    _ssh_cmd "$golden_ip" "test -f /var/lib/cloud/instance/kube-golden-ready" && break
    sleep 5
  done

  # Copy the kldload K8s toolchain into the golden VM. These scripts handle
  # kubeadm init/join, Cilium install, WireGuard mesh, etc. They're baked
  # into the golden image so every clone inherits them — no SCP at clone time.
  log "Running kube-setup in golden VM..."
  for _tool in kube-setup kube-init kube-join kube-network kube-status kube-reset kube-smoke-test kube-load-images; do
    sshpass -p kldload scp -o StrictHostKeyChecking=no \
      "/usr/local/bin/${_tool}" "root@${golden_ip}:/usr/local/bin/${_tool}" 2>/dev/null || true
  done

  _ssh_cmd "$golden_ip" "chmod +x /usr/local/bin/kube-*"
  # Cloud-init may have DHCP but DNS resolution can lag behind — the 10s
  # pause lets systemd-resolved/NetworkManager finish before kube-setup
  # tries to reach package repos (kubernetes.io, docker.io, etc.)
  _ssh_cmd "$golden_ip" "sleep 10"
  # kube-setup installs kubeadm, kubelet, containerd, helm, cilium-cli, etc.
  # Retry once because CentOS cloud images sometimes have transient dnf
  # mirror failures on first boot when metadata caches are cold.
  _ssh_cmd "$golden_ip" "kube-setup" || {
    warn "kube-setup failed on first attempt — retrying after 30s..."
    sleep 30
    _ssh_cmd "$golden_ip" "kube-setup" || die "kube-setup failed in golden VM"
  }

  # Seal the golden image for cloning. This is critical — without it, every
  # clone would have the same machine-id, hostname, and cloud-init instance-id,
  # causing systemd journal collisions, DHCP conflicts, and cloud-init refusing
  # to re-run (it thinks it already ran for this instance).
  #
  # What we clear:
  #   - cloud-init state: so clones re-run cloud-init with their own ISO
  #   - machine-id: systemd regenerates a unique one on next boot
  #   - hostname: cloud-init sets it from the clone's meta-data
  # What we keep:
  #   - SSH host keys: clones regenerate them via cloud-init runcmd (see
  #     clone_and_boot's user-data which runs dpkg-reconfigure/ssh-keygen -A)
  #   - K8s packages: the whole point — clones inherit them instantly
  log "Sealing golden image for cloning..."
  _ssh_cmd "$golden_ip" "cloud-init clean --logs 2>/dev/null || true"
  _ssh_cmd "$golden_ip" "rm -f /etc/machine-id; touch /etc/machine-id"
  _ssh_cmd "$golden_ip" "truncate -s 0 /etc/hostname"
  # Remove rendered network config so clones get fresh DHCP from their
  # cloud-init ISO. Without this, clones inherit the golden's static
  # network config and never request DHCP on virbr0.
  _ssh_cmd "$golden_ip" "rm -f /etc/netplan/*.yaml /etc/systemd/network/*.network 2>/dev/null || true"
  _ssh_cmd "$golden_ip" "rm -f /var/lib/cloud/seed/nocloud-net/* 2>/dev/null || true"
  # Re-enable cloud-init services so clones re-run cloud-init on next boot.
  _ssh_cmd "$golden_ip" "systemctl enable cloud-init-local cloud-init cloud-config cloud-final 2>/dev/null || true"
  # Write DHCP config for ALL networking backends so clones always get an IP
  # regardless of which network manager the cloud image uses.
  #
  # 1. systemd-networkd (modern Debian/Ubuntu cloud images)
  _ssh_cmd "$golden_ip" "mkdir -p /etc/systemd/network && cat > /etc/systemd/network/10-dhcp.network <<'NETD'
[Match]
Name=en* eth*

[Network]
DHCP=yes

[DHCP]
UseDomains=yes
NETD"
  _ssh_cmd "$golden_ip" "systemctl enable systemd-networkd 2>/dev/null || true"
  #
  # 2. ifupdown (/etc/network/interfaces — traditional Debian)
  _ssh_cmd "$golden_ip" "cat > /etc/network/interfaces <<'IFUP'
auto lo
iface lo inet loopback

# DHCP on first ethernet — kldload clone networking
allow-hotplug enp1s0
iface enp1s0 inet dhcp

allow-hotplug ens3
iface ens3 inet dhcp

allow-hotplug eth0
iface eth0 inet dhcp
IFUP"
  _ssh_cmd "$golden_ip" "systemctl enable networking 2>/dev/null || true"
  #
  # 3. Enable dhclient as a fallback timer — runs 30s after boot if no IP
  _ssh_cmd "$golden_ip" "cat > /etc/systemd/system/dhcp-fallback.service <<'DHCPFB'
[Unit]
Description=DHCP fallback — request IP if no address after boot
After=network.target
ConditionPathExists=!/run/dhcp-fallback-done

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 10
ExecStart=/bin/bash -c 'for iface in /sys/class/net/en* /sys/class/net/eth*; do [ -d \"\$iface\" ] || continue; dev=\$(basename \"\$iface\"); ip addr show \"\$dev\" | grep -q \"inet \" && continue; dhclient -1 -v \"\$dev\" 2>/dev/null || true; done; touch /run/dhcp-fallback-done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
DHCPFB"
  _ssh_cmd "$golden_ip" "systemctl enable dhcp-fallback 2>/dev/null || true"

  # Shut down
  _ssh_cmd "$golden_ip" "shutdown -h now" || true
  log "Waiting for golden VM to shut down..."
  for _ in $(seq 1 30); do
    virsh domstate "${GOLDEN}" 2>/dev/null | grep -q "shut off" && break
    sleep 2
  done

  # Remove ALL CDROMs from the golden VM definition. This is critical because
  # kvm-clone copies the libvirt XML — if the golden's cloud-init ISO were
  # still attached, clones would boot with the golden's identity instead of
  # their own. We try all common CDROM targets (SCSI and IDE naming).
  for target in sda sdb hda hdb; do
    virsh detach-disk "${GOLDEN}" "${target}" --config 2>/dev/null || true
  done
  rm -f "$ci_iso"

  # The @golden snapshot is the clone source. ZFS clones are O(1) metadata
  # operations — they share all data blocks with the snapshot and only
  # allocate new blocks for writes (copy-on-write). This is why cloning
  # a 40GB VM takes <100ms and costs ~0 bytes until the clone diverges.
  zfs snapshot "${POOL}/vms/${GOLDEN}@golden" 2>/dev/null || true

  log "Golden image ready: ${GOLDEN}"
  log "  ZFS zvol: ${POOL}/vms/${GOLDEN}"
  log "  Packages: kubeadm, kubelet, kubectl, helm, cilium-cli, containerd"
  log "  Cached for instant cloning (~100ms per node)"
}

# ── Clone + Boot Nodes ────────────────────────────────────────────────────
# Creates ZFS clones of the golden image and boots each with a unique
# cloud-init ISO. The clone operation is a ZFS metadata-only operation
# (no data copying), so N nodes clone in N * ~100ms regardless of disk size.
#
# Each clone needs its own cloud-init ISO because:
#   - The golden was sealed (machine-id cleared, cloud-init cleaned)
#   - On boot, cloud-init looks for its NoCloud datasource (cidata ISO)
#   - Each ISO has a unique instance-id + hostname, so cloud-init runs
#     fresh: sets hostname, regenerates SSH keys, configures networking
#   - Without this, all clones would be identical (same hostname, same keys)
clone_and_boot() {
  local total=$((1 + WORKERS))
  log "Cloning ${total} nodes from ${GOLDEN} (1 CP + ${WORKERS} workers)"
  echo ""

  ensure_ssh_key
  local pubkey
  pubkey="$(cat "${SSH_KEY}.pub")"

  # Clone control plane — kvm-clone handles ZFS clone + libvirt XML copy
  echo -ne "  ${GOLDEN} → ${CP_NAME} ... "
  local S E
  S=$(date +%s%N)
  kvm-clone "${GOLDEN}" "${CP_NAME}" >/dev/null 2>&1
  E=$(date +%s%N)
  echo -e "${G}done${N} (${C}$(( (E-S)/1000000 ))ms${N})"

  # Clone workers
  for i in $(seq 1 "$WORKERS"); do
    local name="${WORKER_PREFIX}-${i}"
    echo -ne "  ${GOLDEN} → ${name} ... "
    S=$(date +%s%N)
    kvm-clone "${GOLDEN}" "${name}" >/dev/null 2>&1
    E=$(date +%s%N)
    echo -e "${G}done${N} (${C}$(( (E-S)/1000000 ))ms${N})"
  done

  echo ""

  # Write a unique machine-id to each clone BEFORE booting. The golden was
  # sealed with an empty machine-id, which means all clones would generate
  # the same one on first boot (race condition). This causes dnsmasq to hand
  # out the same DHCP lease to all VMs (client-id collision). Writing a unique
  # machine-id to the filesystem fixes DHCP and also gives each VM a unique
  # systemd journal, DBUS identity, etc.
  log "Writing unique machine-ids to clones..."
  for vm in "${CP_NAME}" $(seq -f "${WORKER_PREFIX}-%g" 1 "$WORKERS"); do
    local zvol_dev="/dev/zvol/${POOL}/vms/${vm}"
    # Wait for zvol device
    for _ in $(seq 1 10); do [[ -b "$zvol_dev" ]] && break; sleep 1; done
    if [[ -b "$zvol_dev" ]]; then
      # Mount the clone's root partition, write machine-id, unmount
      local _mnt
      _mnt="$(mktemp -d)"
      # Debian cloud images: p1 is root, p14 is BIOS, p15 is EFI
      local _part="${zvol_dev}-part1"
      [[ -b "$_part" ]] || _part="${zvol_dev}p1"
      for _ in $(seq 1 5); do [[ -b "$_part" ]] && break; sleep 1; done
      if mount "$_part" "$_mnt" 2>/dev/null; then
        # Generate unique machine-id (same format as systemd-machine-id-setup)
        printf '%s\n' "$(cat /proc/sys/kernel/random/uuid | tr -d '-')" > "$_mnt/etc/machine-id"
        umount "$_mnt"
        echo -e "  ${vm}: unique machine-id written"
      else
        echo -e "  ${Y}${vm}: could not mount — machine-id will be auto-generated${N}"
      fi
      rmdir "$_mnt" 2>/dev/null || true
    fi
  done

  log "All ${total} nodes cloned. Starting VMs..."

  # Create per-node cloud-init ISOs. Each clone inherits the golden's disk
  # (with cloud-init cleaned) — attaching a fresh cidata ISO with a unique
  # instance-id triggers cloud-init to re-run and establish node identity.
  for vm in "${CP_NAME}" $(seq -f "${WORKER_PREFIX}-%g" 1 "$WORKERS"); do
    local ci_dir ci_iso
    ci_dir="$(mktemp -d)"
    ci_iso="/var/lib/libvirt/isos/${vm}-ci.iso"

    cat > "${ci_dir}/meta-data" <<META
instance-id: ${vm}
local-hostname: ${vm}
META
    cat > "${ci_dir}/user-data" <<USERDATA
#cloud-config
hostname: ${vm}
manage_etc_hosts: true
disable_root: false
ssh_pwauth: true
ssh_authorized_keys:
  - ${pubkey}
users:
  - default
  - name: root
    lock_passwd: false
    ssh_authorized_keys:
      - ${pubkey}
chpasswd:
  expire: false
  users:
    - name: root
      password: kldload
      type: text
runcmd:
  # Regenerate SSH host keys — clones inherited the golden's keys.
  - rm -f /etc/ssh/ssh_host_*
  - ssh-keygen -A
  - dpkg-reconfigure openssh-server 2>/dev/null || true
  # Harden sshd for cluster use: allow root, password auth, raise MaxStartups
  # so the bootstrap script's parallel SSH connections don't get rate-limited.
  - sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
  - sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
  - sed -i 's/^#*MaxStartups.*/MaxStartups 20:30:60/' /etc/ssh/sshd_config
  - |
    if ! grep -q '^MaxStartups' /etc/ssh/sshd_config; then
      echo 'MaxStartups 20:30:60' >> /etc/ssh/sshd_config
    fi
  - systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true
USERDATA

    cat > "${ci_dir}/network-config" <<NETCFG
version: 2
ethernets:
  id0:
    match:
      name: "en*"
    dhcp4: true
  id1:
    match:
      name: "eth*"
    dhcp4: true
NETCFG

    genisoimage -output "$ci_iso" -volid cidata -joliet -rock \
      "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null \
      || mkisofs -output "$ci_iso" -volid cidata -joliet -rock \
        "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null \
      || xorriso -as mkisofs -o "$ci_iso" -volid cidata -joliet -rock \
        "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null
    rm -rf "$ci_dir"

    # Attach cloud-init ISO and start
    virsh attach-disk "$vm" "$ci_iso" sdb --type cdrom --config 2>/dev/null || true

    # Control plane gets more RAM/CPU — it runs etcd, API server, Cilium,
    # MetalLB, and Hubble. Workers only run kubelet + pods.
    if [[ "$vm" == "${CP_NAME}" ]]; then
      virsh setmaxmem "$vm" "${CP_RAM}M" --config 2>/dev/null || true
      virsh setmem "$vm" "${CP_RAM}M" --config 2>/dev/null || true
      virsh setvcpus "$vm" "${CP_CPUS}" --config --maximum 2>/dev/null || true
      virsh setvcpus "$vm" "${CP_CPUS}" --config 2>/dev/null || true
    fi

    virsh start "$vm" 2>/dev/null && echo -e "  ${G}${vm}${N} started" \
      || echo -e "  ${Y}${vm}${N} already running"
    virsh autostart "$vm" 2>/dev/null || true
    # Stagger VM boots by 3s — prevents DHCP/cloud-init race conditions
    # when multiple clones request IPs simultaneously from dnsmasq
    sleep 3
  done

  # Wait for IPs. The 45s sleep covers the worst-case boot time across distros:
  # CentOS cloud images boot in ~20-30s, but Debian's cloud-init datasource
  # probing (NoCloud vs GCE vs AWS vs ...) adds 15-30s before DHCP even starts.
  # Polling earlier just wastes cycles hitting empty DHCP lease tables.
  echo ""
  log "Waiting for all nodes to get IPs..."
  sleep 45
}

# ── Bootstrap: Full Auto Cluster Deploy ────────────────────────────────────
# Orchestrates the entire cluster lifecycle in 8 steps:
#   1. Golden image (build or reuse)
#   2. ZFS clone + boot all nodes
#   3. WireGuard encrypted mesh (dual-plane: management + kubernetes)
#   4. kubeadm init on control plane (Cilium, MetalLB, ZFS CSI, Hubble)
#   5. kubeadm join on workers
#   6. Verification (kubectl get nodes)
#   7. Smoke test (deploy nginx, verify pod scheduling)
#   8. Hubble eBPF flow dump (show what the kernel captured)
cmd_bootstrap() {
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  kube-cluster bootstrap                                     ${N}"
  echo -e "${W}  1 control plane + ${WORKERS} workers on ZFS instant clones         ${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""

  # Step 0: Clean slate — destroy any existing cluster + golden
  # No half-states, no stale VMs, no orphaned zvols. Every bootstrap
  # starts from zero so the result is always predictable.
  log "Cleaning up any existing cluster..."
  systemctl stop sanoid.timer 2>/dev/null || true
  for vm in $(virsh list --all --name 2>/dev/null | grep -E "^${CLUSTER_NAME}-|^${GOLDEN}" || true); do
    [[ -z "$vm" ]] && continue
    virsh destroy "$vm" 2>/dev/null || true
    virsh undefine "$vm" --nvram 2>/dev/null || virsh undefine "$vm" 2>/dev/null || true
    rm -f "/var/lib/libvirt/isos/${vm}-ci.iso" "/var/lib/libvirt/isos/${vm}-cloud-init.iso" 2>/dev/null
  done
  # Nuke all cluster zvols — -Rf handles snapshots and dependent clones
  for ds in $(zfs list -H -o name -r "${POOL}/vms" 2>/dev/null | grep -vE "^${POOL}/vms$|/isos$" || true); do
    zfs destroy -Rf "$ds" 2>/dev/null || true
  done
  # Clean host state
  ip link del wg-mgmt 2>/dev/null || true
  ip link del wg-k8s 2>/dev/null || true
  rm -f /etc/wireguard/wg-mgmt.* /etc/wireguard/wg-k8s.* 2>/dev/null
  rm -f /root/.kube/config 2>/dev/null
  sed -i '/# kldload-k8s-cluster/,/# end-kldload-k8s-cluster/d' /etc/hosts 2>/dev/null || true
  systemctl start sanoid.timer 2>/dev/null || true
  log "Clean slate"
  echo ""

  # Step 1: Build golden image (always fresh)
  echo -e "${Y}=== Step 1: Golden Image ===${N}"
  build_golden
  echo ""

  # Step 2: Clone + boot
  echo -e "${Y}=== Step 2: Clone + Boot (ZFS instant clone) ===${N}"
  clone_and_boot

  # Collect IPs
  local cp_ip
  cp_ip="$(get_vm_ip "${CP_NAME}")"
  [[ -n "$cp_ip" ]] || die "Cannot get IP for ${CP_NAME}"

  declare -a worker_names=()
  declare -a worker_ips=()
  for i in $(seq 1 "$WORKERS"); do
    local name="${WORKER_PREFIX}-${i}"
    local wip
    wip="$(get_vm_ip "$name")"
    worker_names+=("$name")
    worker_ips+=("$wip")
  done

  echo ""
  log "Node IPs:"
  echo -e "  ${C}${CP_NAME}${N}  ${cp_ip}"
  for i in $(seq 0 $((WORKERS-1))); do
    echo -e "  ${C}${worker_names[$i]}${N}  ${worker_ips[$i]}"
  done

  # Wait for SSH on all nodes
  echo ""
  log "Waiting for SSH on all nodes..."
  wait_for_ssh "$cp_ip" 90 || die "SSH not available on ${CP_NAME}"
  for i in $(seq 0 $((WORKERS-1))); do
    [[ -n "${worker_ips[$i]}" ]] && wait_for_ssh "${worker_ips[$i]}" 60 || warn "No SSH on ${worker_names[$i]}"
  done
  log "All nodes reachable via SSH"

  # Clones inherit the golden's empty hostname. Set unique hostnames now so
  # kubelet registers each node with the correct name. Also regenerate
  # machine-id (systemd uses it for journal dedup, DHCP client-id, etc.)
  # and restart networkd to pick up the new machine-id for DHCP.
  log "Setting unique hostnames..."
  _ssh_cmd "$cp_ip" "hostnamectl set-hostname ${CP_NAME}; systemd-machine-id-setup 2>/dev/null; systemctl restart systemd-networkd 2>/dev/null || true"
  for i in $(seq 0 $((WORKERS-1))); do
    [[ -n "${worker_ips[$i]}" ]] || continue
    _ssh_cmd "${worker_ips[$i]}" "hostnamectl set-hostname ${worker_names[$i]}; systemd-machine-id-setup 2>/dev/null; systemctl restart systemd-networkd 2>/dev/null || true"
  done
  log "Hostnames set"

  # Step 3: WireGuard mesh
  # Two WireGuard interfaces per node form independent encrypted planes:
  #   wg-mgmt (10.251.0.0/24): management traffic — SSH, kubelet<->API, etcd
  #   wg-k8s  (10.252.0.0/24): data plane — pod-to-pod, service mesh, CNI
  #
  # Separating planes prevents a pod traffic flood from starving the API
  # server, and lets you apply different MTU/QoS per interface. The topology
  # is full-mesh (every node peers with every other node) because K8s pods
  # on any node need to reach pods on any other node directly.
  #
  # Node IDs map to WireGuard IPs: node 1 = .1, node 2 = .2, etc.
  # kube-network handles key generation, interface config, and peer setup.
  echo ""
  echo -e "${Y}=== Step 3: WireGuard Encrypted Backplane ===${N}"

  if _ssh_cmd "$cp_ip" "command -v wg >/dev/null 2>&1"; then
    # Init control plane as node 1 (10.251.0.1 on wg-mgmt, 10.252.0.1 on wg-k8s)
    _ssh_cmd "$cp_ip" "kube-network init 1" || true
    local node_id=2
    for i in $(seq 0 $((WORKERS-1))); do
      [[ -n "${worker_ips[$i]}" ]] || continue
      _ssh_cmd "${worker_ips[$i]}" "kube-network init ${node_id}" || true
      ((node_id++))
    done

    # Exchange keys
    local cp_pub
    cp_pub="$(_ssh_cmd "$cp_ip" 'cat /etc/wireguard/wg-mgmt.pub')" || true

    if [[ -n "$cp_pub" ]]; then
      # Collect all pubkeys
      declare -a w_pubs=()
      declare -a w_ids=()
      node_id=2
      for i in $(seq 0 $((WORKERS-1))); do
        local wip="${worker_ips[$i]}"
        [[ -n "$wip" ]] || continue
        local wpub
        wpub="$(_ssh_cmd "$wip" 'cat /etc/wireguard/wg-mgmt.pub')" || true
        w_pubs+=("$wpub")
        w_ids+=("$node_id")
        ((node_id++))
      done

      # CP ↔ Worker peering: each worker needs to reach the API server,
      # and the CP needs to reach each worker for kubectl exec/logs/port-forward
      for i in $(seq 0 $((WORKERS-1))); do
        local wip="${worker_ips[$i]:-}"
        [[ -n "$wip" && -n "${w_pubs[$i]:-}" ]] || continue
        _ssh_cmd "$cp_ip" "kube-network add-peer ${wip} ${w_pubs[$i]} ${w_ids[$i]}" || true
        _ssh_cmd "$wip" "kube-network add-peer ${cp_ip} ${cp_pub} 1" || true
      done

      # Worker ↔ Worker full mesh: pods on W1 must reach pods on W2 directly
      # (Cilium eBPF routes cross-node pod traffic over the WireGuard data plane)
      for i in $(seq 0 $((WORKERS-1))); do
        for j in $(seq 0 $((WORKERS-1))); do
          [[ $i -eq $j ]] && continue
          local wip_i="${worker_ips[$i]:-}"
          local wip_j="${worker_ips[$j]:-}"
          [[ -n "$wip_i" && -n "$wip_j" && -n "${w_pubs[$j]:-}" ]] || continue
          _ssh_cmd "$wip_i" "kube-network add-peer ${wip_j} ${w_pubs[$j]} ${w_ids[$j]}" || true
        done
      done

      # Pin kubelet's --node-ip to the WireGuard management IP (10.251.0.x).
      # Without this, kubelet advertises the virbr0 LAN IP, and all K8s
      # internal traffic (API calls, pod logs, metrics) bypasses WireGuard
      # and travels unencrypted on the bridge network. Pinning ensures the
      # API server, other kubelets, and kube-proxy all communicate over the
      # encrypted wg-mgmt tunnel.
      _ssh_cmd "$cp_ip" "kube-network pin-kubelet" || true
      for i in $(seq 0 $((WORKERS-1))); do
        [[ -n "${worker_ips[$i]}" ]] && _ssh_cmd "${worker_ips[$i]}" "kube-network pin-kubelet" || true
      done
      log "WireGuard full mesh configured (${WORKERS} workers + CP)"
    else
      warn "WireGuard key exchange failed — cluster will use LAN networking"
    fi
  else
    warn "WireGuard not installed in VMs — cluster will use LAN networking (unencrypted)"
    warn "Add wireguard-tools to golden image to enable encrypted backplane"
  fi

  # Step 4: Bootstrap control plane via kube-init, which runs:
  #   - kubeadm init (with control-plane taint removed so pods can schedule
  #     on the CP node — necessary for small clusters and the smoke test)
  #   - Cilium CNI (replaces kube-proxy entirely with eBPF datapath)
  #   - MetalLB (L2 load balancer for bare-metal/KVM — no cloud LB needed)
  #   - OpenEBS ZFS LocalPV (PVCs backed by ZFS datasets with snapshots)
  #   - Cilium Gateway API (ingress controller using eBPF, no nginx)
  #   - Hubble (eBPF-based network observability — flow logs, UI, CLI)
  echo ""
  echo -e "${Y}=== Step 4: Control Plane (Cilium + MetalLB + ZFS CSI + Hubble) ===${N}"
  _ssh_cmd "$cp_ip" "kube-init" || warn "kube-init had errors — some components may still be pulling images"

  # Step 5: Join workers. The join token is a short-lived bootstrap credential
  # that lets workers authenticate to the API server.
  echo ""
  echo -e "${Y}=== Step 5: Join Workers ===${N}"
  local join_token
  join_token="$(_ssh_cmd "$cp_ip" 'kubeadm token create --print-join-command 2>/dev/null')" || true
  if [[ -z "$join_token" ]]; then
    warn "Could not get join token from CP"
  else
    for i in $(seq 0 $((WORKERS-1))); do
      local wip="${worker_ips[$i]:-}"
      [[ -n "$wip" ]] || continue
      log "Joining ${worker_names[$i]}..."
      _ssh_cmd "$wip" "$join_token" || warn "Failed to join ${worker_names[$i]}"
    done
  fi

  # Step 6: Verify
  echo ""
  echo -e "${Y}=== Step 6: Verification ===${N}"
  sleep 10
  _ssh_cmd "$cp_ip" "kubectl get nodes -o wide" || true

  # Apply nftables firewall rules. This locks down each node to only accept
  # K8s traffic on WireGuard interfaces and SSH on the management plane.
  _ssh_cmd "$cp_ip" "kube-network nft" 2>/dev/null || true
  for i in $(seq 0 $((WORKERS-1))); do
    [[ -n "${worker_ips[$i]:-}" ]] && _ssh_cmd "${worker_ips[$i]}" "kube-network nft" 2>/dev/null || true
  done

  # Step 7: Smoke test
  echo ""
  echo -e "${Y}=== Step 7: Smoke Test ===${N}"
  _ssh_cmd "$cp_ip" "kube-smoke-test" || warn "Smoke test had failures — check output above"

  # Step 8: Hubble proof of life — show recent eBPF-captured flows
  echo ""
  echo -e "${Y}=== Step 8: Hubble eBPF — Proof of Life ===${N}"
  echo -e "${D}Recent flows captured by eBPF (zero agents, zero config):${N}"
  echo ""
  _ssh_cmd "$cp_ip" "hubble observe --last 20 2>/dev/null" || true
  echo ""
  echo -e "${G}Run 'hubble observe --follow' on the CP for live streaming.${N}"

  # Final status
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Kubernetes Cluster Deployed                                ${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  echo -e "  ${W}Nodes:${N}"
  echo -e "    ${C}${CP_NAME}${N}  ${cp_ip} → 10.251.0.1 (control plane)"
  for i in $(seq 0 $((WORKERS-1))); do
    echo -e "    ${C}${worker_names[$i]}${N}  ${worker_ips[$i]} → 10.251.0.$((i+2)) (worker)"
  done
  echo ""
  echo -e "  ${W}Stack:${N}"
  echo -e "    CNI:           ${G}Cilium (eBPF, replaces kube-proxy)${N}"
  echo -e "    Ingress:       ${G}Cilium Gateway API${N}"
  echo -e "    Load Balancer: ${G}MetalLB (L2)${N}"
  echo -e "    Storage:       ${G}OpenEBS ZFS LocalPV${N}"
  echo -e "    Observability: ${G}Hubble (relay + UI)${N}"
  echo -e "    Backplane:     ${G}WireGuard (wg-mgmt + wg-k8s)${N}"
  echo -e "    Hypervisor:    ${G}KVM on ZFS zvols${N}"
  echo ""
  echo -e "  ${W}ZFS Superpowers:${N}"
  echo -e "    Clone time:    ${G}<100ms per node${N}"
  echo -e "    Disk cost:     ${G}~0 bytes (copy-on-write)${N}"
  echo -e "    Rebuild:       ${G}kube-cluster destroy && kube-cluster bootstrap${N}"
  echo ""
  # Step 9: Host joins WireGuard mesh + management tools
  # The KVM host is the management plane — it joins the encrypted mesh as
  # node 100 so kubectl, k9s, cilium, hubble all talk to the API over
  # WireGuard. Every hop encrypted, including operator→API.
  echo ""
  echo -e "${Y}=== Step 9: Host Management Plane ===${N}"

  # Join the host to the WireGuard mesh as node 100 (10.250.0.100 / 10.251.0.100)
  if command -v wg >/dev/null 2>&1 && [[ -n "${cp_pub:-}" ]]; then
    log "Joining host to WireGuard mesh as node 100..."
    kube-network init 100 2>/dev/null || true

    local host_pub
    host_pub="$(cat /etc/wireguard/wg-mgmt.pub 2>/dev/null || true)"

    if [[ -n "$host_pub" ]]; then
      # Host ↔ CP peering
      _ssh_cmd "$cp_ip" "kube-network add-peer ${cp_ip} ${host_pub} 100" || true
      kube-network add-peer "$cp_ip" "$cp_pub" 1 2>/dev/null || true

      # Host ↔ Worker peering
      for i in $(seq 0 $((WORKERS-1))); do
        local wip="${worker_ips[$i]:-}"
        [[ -n "$wip" && -n "${w_pubs[$i]:-}" ]] || continue
        _ssh_cmd "$wip" "kube-network add-peer ${cp_ip} ${host_pub} 100" || true
        kube-network add-peer "$wip" "${w_pubs[$i]}" "${w_ids[$i]}" 2>/dev/null || true
      done

      log "Host joined WireGuard mesh: 10.250.0.100 (mgmt), 10.251.0.100 (k8s)"
    else
      warn "Host WireGuard key generation failed — using virbr0 for management"
    fi
  fi

  # /etc/hosts entries — use WireGuard IPs if mesh is up, else virbr0
  log "Adding cluster DNS entries to /etc/hosts..."
  sed -i '/# kldload-k8s-cluster/,/# end-kldload-k8s-cluster/d' /etc/hosts 2>/dev/null || true
  {
    echo "# kldload-k8s-cluster"
    if ip link show wg-mgmt >/dev/null 2>&1; then
      # WireGuard IPs — all management traffic encrypted
      echo "10.250.0.1 ${CP_NAME}"
      for i in $(seq 0 $((WORKERS-1))); do
        echo "10.250.0.$((i+2)) ${worker_names[$i]}"
      done
    else
      echo "${cp_ip} ${CP_NAME}"
      for i in $(seq 0 $((WORKERS-1))); do
        [[ -n "${worker_ips[$i]:-}" ]] && echo "${worker_ips[$i]} ${worker_names[$i]}"
      done
    fi
    echo "# end-kldload-k8s-cluster"
  } >> /etc/hosts

  # Copy kubeconfig from CP to host — retry up to 5 times (SSH may be restarting)
  mkdir -p /root/.kube
  local _kc_ok=0
  for _kc_try in $(seq 1 5); do
    if scp -o StrictHostKeyChecking=no -o ConnectTimeout=10 -i "$SSH_KEY" \
      "root@${cp_ip}:/etc/kubernetes/admin.conf" /root/.kube/config 2>/dev/null \
    || sshpass -p kldload scp -o StrictHostKeyChecking=no -o ConnectTimeout=10 \
      "root@${cp_ip}:/etc/kubernetes/admin.conf" /root/.kube/config 2>/dev/null; then
      _kc_ok=1; break
    fi
    log "  kubeconfig copy attempt ${_kc_try}/5 failed — retrying in 5s..."
    sleep 5
  done
  if [[ $_kc_ok -eq 1 ]]; then
    # Point kubeconfig at the CP's WireGuard IP (encrypted) if mesh is up
    if ip link show wg-k8s >/dev/null 2>&1; then
      sed -i "s|https://.*:6443|https://10.251.0.1:6443|" /root/.kube/config
    else
      sed -i "s|https://.*:6443|https://${cp_ip}:6443|" /root/.kube/config
    fi
    chmod 600 /root/.kube/config
    export KUBECONFIG=/root/.kube/config
    log "kubeconfig installed → /root/.kube/config"
  else
    warn "Could not copy kubeconfig from CP"
  fi

  # Install kubectl, helm, k9s, cilium-cli, hubble-cli on the host
  local arch
  arch="$(uname -m)"
  case "$arch" in
    x86_64)  arch_dl="amd64"; arch_k9s="amd64" ;;
    aarch64) arch_dl="arm64"; arch_k9s="arm64" ;;
    *)       arch_dl="amd64"; arch_k9s="amd64" ;;
  esac

  # kubectl
  if ! command -v kubectl >/dev/null 2>&1; then
    log "Installing kubectl on host..."
    curl -fsSL "https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/${arch_dl}/kubectl" \
      -o /usr/local/bin/kubectl 2>/dev/null && chmod +x /usr/local/bin/kubectl && log "kubectl installed" \
      || warn "kubectl install failed"
  fi

  # helm
  if ! command -v helm >/dev/null 2>&1; then
    log "Installing helm on host..."
    curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | \
      HELM_INSTALL_DIR=/usr/local/bin bash 2>/dev/null && log "helm installed" \
      || warn "helm install failed"
  fi

  # cilium CLI
  if ! command -v cilium >/dev/null 2>&1; then
    log "Installing cilium CLI on host..."
    curl -fsSL "https://github.com/cilium/cilium-cli/releases/download/v${CILIUM_CLI_VERSION}/cilium-linux-${arch_dl}.tar.gz" \
      | tar -xz -C /usr/local/bin cilium 2>/dev/null && log "cilium CLI installed" \
      || warn "cilium CLI install failed"
  fi

  # hubble CLI
  if ! command -v hubble >/dev/null 2>&1; then
    log "Installing hubble CLI on host..."
    local hubble_ver
    hubble_ver="$(curl -fsSL https://raw.githubusercontent.com/cilium/hubble/master/stable.txt 2>/dev/null || echo "v1.17.1")"
    curl -fsSL "https://github.com/cilium/hubble/releases/download/${hubble_ver}/hubble-linux-${arch_dl}.tar.gz" \
      | tar -xz -C /usr/local/bin hubble 2>/dev/null && log "hubble CLI installed" \
      || warn "hubble CLI install failed"
  fi

  # k9s
  if ! command -v k9s >/dev/null 2>&1; then
    log "Installing k9s on host..."
    curl -fsSL "https://github.com/derailed/k9s/releases/latest/download/k9s_Linux_${arch_k9s}.tar.gz" \
      | tar -xz -C /usr/local/bin k9s 2>/dev/null && log "k9s installed" \
      || warn "k9s install failed"
  fi

  # Add KUBECONFIG to root's profile
  if ! grep -q 'KUBECONFIG' /root/.bashrc 2>/dev/null; then
    echo 'export KUBECONFIG=/root/.kube/config' >> /root/.bashrc
  fi

  # Verify
  if command -v kubectl >/dev/null 2>&1 && [[ -f /root/.kube/config ]]; then
    echo ""
    kubectl get nodes 2>/dev/null && log "Host kubectl verified — cluster is accessible" \
      || warn "kubectl installed but cluster not yet reachable (nodes may still be joining)"
  fi

  echo ""
  echo -e "  ${W}Access (from this host):${N}"
  echo -e "    kubectl get nodes"
  echo -e "    k9s"
  echo -e "    cilium status"
  echo -e "    hubble observe --follow"
  echo -e "    kube-demo"
  echo -e "    ssh root@${cp_ip}"
  echo -e "    hubble UI: kubectl port-forward -n kube-system svc/hubble-ui 12000:80"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
}

# ── Destroy ────────────────────────────────────────────────────────────────
# Tears down all cluster VMs and their ZFS zvols, but preserves the golden
# image for instant re-creation. The golden is expensive to build (cloud image
# download + kube-setup) but cheap to keep (one snapshot + the base zvol).
# Destroying and re-bootstrapping takes seconds, not minutes, thanks to this.
cmd_destroy() {
  local destroy_all=0
  [[ "${1:-}" == "--all" ]] && destroy_all=1

  if [[ $destroy_all -eq 1 ]]; then
    echo -e "${R}WARNING: This will destroy EVERYTHING — cluster + golden image${N}"
  else
    echo -e "${R}WARNING: This will destroy the Kubernetes cluster${N}"
    echo "  (Golden image preserved — use 'destroy --all' to remove it too)"
  fi
  echo "  Control plane: ${CP_NAME}"
  echo "  Workers: ${WORKER_PREFIX}-1 through ${WORKER_PREFIX}-${WORKERS}"
  echo ""
  read -r -p "Type 'destroy' to continue: " confirm
  [[ "$confirm" == "destroy" ]] || { echo "Aborted."; exit 0; }

  log "Destroying cluster..."

  # Stop sanoid first — it creates autosnaps that block ZFS destroy
  systemctl stop sanoid.timer 2>/dev/null || true

  # Destroy ALL VMs first (stop + undefine), then ZFS.
  # Must undefine all VMs before ZFS destroy because libvirt holds references.
  local _all_vms=("${CP_NAME}")
  for name in $(virsh list --all --name 2>/dev/null | grep "^${WORKER_PREFIX}-" || true) \
               $(seq -f "${WORKER_PREFIX}-%g" 1 "${WORKERS}"); do
    [[ -n "$name" ]] && _all_vms+=("$name")
  done
  [[ $destroy_all -eq 1 ]] && _all_vms+=("${GOLDEN}")

  for vm in "${_all_vms[@]}"; do
    virsh destroy "$vm" 2>/dev/null || true
    virsh undefine "$vm" --nvram 2>/dev/null || virsh undefine "$vm" 2>/dev/null || true
    rm -f "/var/lib/libvirt/isos/${vm}-ci.iso" "/var/lib/libvirt/isos/${vm}-cloud-init.iso" 2>/dev/null
  done

  # Now destroy ZFS — use -Rf to handle autosnaps and dependent clones
  if [[ $destroy_all -eq 1 ]]; then
    # Nuke the entire vms tree except the isos dataset
    zfs destroy -Rf "${POOL}/vms/${GOLDEN}" 2>/dev/null || true
    log "Golden image destroyed"
  else
    # Destroy clones only (golden preserved)
    zfs destroy -Rf "${POOL}/vms/${CP_NAME}" 2>/dev/null || true
    for name in $(zfs list -H -o name -r "${POOL}/vms" 2>/dev/null | grep "/${WORKER_PREFIX}-" || true); do
      zfs destroy -Rf "$name" 2>/dev/null || true
    done
  fi

  # Clean up orphaned snapshots on golden
  for snap in $(zfs list -H -o name -t snapshot -r "${POOL}/vms/${GOLDEN}" 2>/dev/null | grep "@clone-" || true); do
    zfs destroy "$snap" 2>/dev/null || true
  done

  # Restart sanoid
  systemctl start sanoid.timer 2>/dev/null || true

  # Clean up host WireGuard mesh
  ip link del wg-mgmt 2>/dev/null || true
  ip link del wg-k8s 2>/dev/null || true
  rm -f /etc/wireguard/wg-mgmt.conf /etc/wireguard/wg-k8s.conf 2>/dev/null
  rm -f /etc/wireguard/wg-mgmt.key /etc/wireguard/wg-mgmt.pub 2>/dev/null
  rm -f /etc/wireguard/wg-k8s.key /etc/wireguard/wg-k8s.pub 2>/dev/null

  # Clean up host kubeconfig and /etc/hosts entries
  rm -f /root/.kube/config 2>/dev/null
  sed -i '/# kldload-k8s-cluster/,/# end-kldload-k8s-cluster/d' /etc/hosts 2>/dev/null || true

  if [[ $destroy_all -eq 1 ]]; then
    log "Everything destroyed. Run: kube-cluster bootstrap --workers ${WORKERS}"
  else
    log "Cluster destroyed. Golden image ${GOLDEN} preserved for fast rebuild."
    log "Rebuild: kube-cluster bootstrap --workers ${WORKERS}"
    log "Full wipe: kube-cluster destroy --all"
  fi
}

# ── Status ─────────────────────────────────────────────────────────────────
# Shows cluster health from three perspectives: libvirt VMs, ZFS zvols (disk
# usage — demonstrates copy-on-write savings), and Kubernetes node/pod state.
cmd_status() {
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Kubernetes Cluster Status                                  ${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""

  echo -e "${Y}VMs:${N}"
  kvm-list 2>/dev/null | grep -E "${CLUSTER_NAME}|${GOLDEN}|NAME|----" || echo "  No cluster VMs"
  echo ""

  echo -e "${Y}ZFS:${N}"
  zfs list -o name,used,refer,volsize -r "${POOL}/vms" -t volume 2>/dev/null \
    | grep -E "${CLUSTER_NAME}|${GOLDEN}|NAME" || echo "  No zvols"
  echo ""

  local cp_ip
  cp_ip="$(get_vm_ip "${CP_NAME}" 2>/dev/null)" || true
  if [[ -n "$cp_ip" ]]; then
    echo -e "${Y}Kubernetes (${CP_NAME} @ ${cp_ip}):${N}"
    _ssh_cmd "$cp_ip" "kubectl get nodes -o wide" || echo "  Cannot reach API"
    echo ""
    _ssh_cmd "$cp_ip" "kubectl get pods -A --no-headers" | awk '{print $1"/"$2, $4}' | head -15 || true
  else
    echo -e "${Y}Kubernetes:${N} control plane not running"
  fi
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
}

# ── Golden only ────────────────────────────────────────────────────────────
cmd_golden() {
  build_golden
}

# ── Dispatch ───────────────────────────────────────────────────────────────
case "$CMD" in
  bootstrap) cmd_bootstrap ;;
  golden)    cmd_golden ;;
  destroy)   cmd_destroy "${2:-}" ;;
  status)    cmd_status ;;
  scale)     die "scale not yet implemented — destroy and bootstrap with --workers N" ;;
  *)         usage ;;
esac
