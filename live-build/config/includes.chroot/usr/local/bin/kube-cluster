#!/usr/bin/env bash
# kube-cluster — deploy a Kubernetes cluster on KVM using ZFS clones
# Creates control plane + worker VMs from a golden image, bootstraps with kubeadm + Cilium
#
# Usage:
#   kube-cluster create [--workers N] [--ram MB] [--cpus N] [--golden NAME]
#   kube-cluster destroy
#   kube-cluster status
#
# Requires: KVM profile with kvm-clone, a golden image with kube-setup already run
set -euo pipefail

# Auto-elevate to root
if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

WORKERS="${WORKERS:-3}"
RAM="${RAM:-4096}"
CPUS="${CPUS:-2}"
GOLDEN="${GOLDEN:-k8s-golden}"
CLUSTER_NAME="${CLUSTER_NAME:-kldload}"
POD_CIDR="${POD_CIDR:-10.244.0.0/16}"

C="\033[1;36m"; G="\033[1;32m"; Y="\033[1;33m"; R="\033[1;31m"
W="\033[1;37m"; D="\033[0;37m"; N="\033[0m"

log()  { echo -e "${G}[kube-cluster]${N} $*"; }
warn() { echo -e "${Y}[kube-cluster]${N} $*" >&2; }
die()  { echo -e "${R}[kube-cluster]${N} $*" >&2; exit 1; }

usage() {
  cat <<EOF
Usage: kube-cluster <command> [options]

Commands:
  create    Create a Kubernetes cluster on KVM
  destroy   Tear down the cluster (VMs + zvols)
  status    Show cluster status

Options (create):
  --workers N      Number of worker nodes (default: 3)
  --ram MB         RAM per node in MB (default: 4096)
  --cpus N         vCPUs per node (default: 2)
  --golden NAME    Golden image name (default: k8s-golden)

The golden image must exist as a ZFS zvol at rpool/vms/<golden>.
Build it with: kvm-create k8s-golden && kube-setup (inside the VM)

Examples:
  kube-cluster create
  kube-cluster create --workers 5 --ram 8192 --cpus 4
  kube-cluster destroy
  kube-cluster status
EOF
  exit 1
}

# ── Parse args ─────────────────────────────────────────────────────────────
CMD="${1:-}"
[[ -n "$CMD" ]] || usage
shift

while [[ $# -gt 0 ]]; do
  case "$1" in
    --workers) WORKERS="$2"; shift 2 ;;
    --ram)     RAM="$2"; shift 2 ;;
    --cpus)    CPUS="$2"; shift 2 ;;
    --golden)  GOLDEN="$2"; shift 2 ;;
    *)         die "Unknown option: $1" ;;
  esac
done

CP_NAME="${CLUSTER_NAME}-cp"
WORKER_PREFIX="${CLUSTER_NAME}-worker"

# ── Create ─────────────────────────────────────────────────────────────────
cmd_create() {
  # Verify golden image exists
  if ! zfs list "rpool/vms/${GOLDEN}" >/dev/null 2>&1; then
    die "Golden image rpool/vms/${GOLDEN} not found. Create it first:
  kvm-create ${GOLDEN} --ram ${RAM} --cpus ${CPUS} --disk 40
  (install OS, run kube-setup inside the VM, shut down)
  kvm-snap ${GOLDEN}"
  fi

  log "Creating Kubernetes cluster: 1 control plane + ${WORKERS} workers"
  log "  Golden image: rpool/vms/${GOLDEN}"
  log "  RAM: ${RAM}MB, CPUs: ${CPUS}"
  echo ""

  # ZFS snapshot before cluster creation
  zfs snapshot "rpool/vms@pre-kube-cluster-$(date -u +%Y%m%dT%H%M%SZ)" 2>/dev/null || true

  # Clone control plane
  echo -e "${Y}=== Control Plane ===${N}"
  echo -ne "  Cloning ${GOLDEN} → ${CP_NAME} ... "
  S=$(date +%s%N)
  kvm-clone "${GOLDEN}" "${CP_NAME}" >/dev/null 2>&1
  E=$(date +%s%N)
  echo -e "${G}done${N} (${C}$(( (E-S)/1000000 ))ms${N})"

  # Clone workers
  echo ""
  echo -e "${Y}=== Workers ===${N}"
  for i in $(seq 1 "$WORKERS"); do
    local name="${WORKER_PREFIX}-${i}"
    echo -ne "  Cloning ${GOLDEN} → ${name} ... "
    S=$(date +%s%N)
    kvm-clone "${GOLDEN}" "${name}" >/dev/null 2>&1
    E=$(date +%s%N)
    echo -e "${G}done${N} (${C}$(( (E-S)/1000000 ))ms${N})"
  done

  # Start all VMs
  echo ""
  echo -e "${Y}=== Starting VMs ===${N}"
  virsh start "${CP_NAME}" 2>/dev/null && echo -e "  ${G}${CP_NAME}${N} started" || echo -e "  ${R}${CP_NAME}${N} already running"
  for i in $(seq 1 "$WORKERS"); do
    local name="${WORKER_PREFIX}-${i}"
    virsh start "${name}" 2>/dev/null && echo -e "  ${G}${name}${N} started" || echo -e "  ${R}${name}${N} already running"
  done

  # Wait for VMs to get IPs
  echo ""
  log "Waiting for VMs to boot and get network..."
  sleep 15

  # Show status
  echo ""
  kvm-list

  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Kubernetes Cluster VMs Ready                               ${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Control plane:  ${G}${CP_NAME}${N}"
  echo -e "  Workers:        ${G}${WORKERS}${N} (${WORKER_PREFIX}-1 through ${WORKER_PREFIX}-${WORKERS})"
  echo -e "  Cloned from:    ${GOLDEN}"
  echo -e "  Each clone:     ${G}~100ms, 0 bytes${N} (ZFS copy-on-write)"
  echo ""
  echo -e "  ${W}Next steps:${N}"
  echo -e "  1. SSH into ${CP_NAME} and run: ${C}kube-init${N}"
  echo -e "  2. SSH into each worker and run: ${C}kube-join <cp-ip>${N}"
  echo -e "  3. On the CP, verify: ${C}kube-status${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
}

# ── Destroy ────────────────────────────────────────────────────────────────
cmd_destroy() {
  echo -e "${R}WARNING: This will destroy the entire Kubernetes cluster${N}"
  echo "  Control plane: ${CP_NAME}"
  echo "  Workers: ${WORKER_PREFIX}-1 through ${WORKER_PREFIX}-${WORKERS}"
  echo ""
  read -r -p "Type 'destroy' to continue: " confirm
  [[ "$confirm" == "destroy" ]] || { echo "Aborted."; exit 0; }

  log "Destroying cluster..."

  # Destroy control plane
  kvm-delete "${CP_NAME}" 2>/dev/null || true

  # Destroy workers
  for i in $(seq 1 "$WORKERS"); do
    kvm-delete "${WORKER_PREFIX}-${i}" 2>/dev/null || true
  done

  log "Cluster destroyed"
}

# ── Status ─────────────────────────────────────────────────────────────────
cmd_status() {
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Kubernetes Cluster Status                                  ${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""

  echo -e "${Y}VMs:${N}"
  kvm-list 2>/dev/null | grep -E "${CLUSTER_NAME}|NAME|----" || echo "  No cluster VMs found"
  echo ""

  echo -e "${Y}ZFS Zvols:${N}"
  zfs list -o name,used,refer,volsize -r rpool/vms -t volume 2>/dev/null | grep -E "${CLUSTER_NAME}|NAME" || echo "  None"
  echo ""

  # Try to get K8s status from control plane
  local cp_ip
  cp_ip="$(virsh domifaddr "${CP_NAME}" 2>/dev/null | awk '/ipv4/ {print $4}' | cut -d/ -f1)" || true
  if [[ -n "$cp_ip" ]]; then
    echo -e "${Y}Kubernetes (via ${CP_NAME} @ ${cp_ip}):${N}"
    ssh -o StrictHostKeyChecking=no -o ConnectTimeout=3 "root@${cp_ip}" \
      'kubectl get nodes -o wide 2>/dev/null' 2>/dev/null || echo "  Cannot reach K8s API"
  fi
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
}

# ── Bootstrap — full auto: create VMs + network + init + join ──────────
cmd_bootstrap() {
  log "Full automated Kubernetes deployment"
  log "  1. Clone VMs from golden image"
  log "  2. Set up WireGuard backplane"
  log "  3. Bootstrap control plane + Cilium"
  log "  4. Join workers"
  log "  5. Smoke test"
  echo ""

  # Step 1: Create VMs
  cmd_create

  # Wait for SSH to be available
  echo ""
  log "Waiting for SSH on all nodes..."
  sleep 30

  # Get VM IPs
  local cp_ip
  cp_ip="$(virsh domifaddr "${CP_NAME}" 2>/dev/null | awk '/ipv4/ {print $4}' | cut -d/ -f1)" || true
  [[ -n "$cp_ip" ]] || die "Cannot get IP for ${CP_NAME}. Check VM networking."

  declare -A worker_ips
  for i in $(seq 1 "$WORKERS"); do
    local name="${WORKER_PREFIX}-${i}"
    local wip
    wip="$(virsh domifaddr "${name}" 2>/dev/null | awk '/ipv4/ {print $4}' | cut -d/ -f1)" || true
    worker_ips["$name"]="$wip"
  done

  log "VM IPs:"
  log "  ${CP_NAME}: ${cp_ip}"
  for name in "${!worker_ips[@]}"; do
    log "  ${name}: ${worker_ips[$name]}"
  done

  # Step 2: Set up WireGuard backplane
  echo ""
  echo -e "${Y}=== Setting Up WireGuard Backplane ===${N}"

  # Init WG on control plane (node 1)
  ssh -o StrictHostKeyChecking=no "root@${cp_ip}" \
    "kube-network init 1" 2>/dev/null || warn "WG init failed on CP"

  # Init WG on workers
  local node_id=2
  for i in $(seq 1 "$WORKERS"); do
    local name="${WORKER_PREFIX}-${i}"
    local wip="${worker_ips[$name]}"
    [[ -n "$wip" ]] || { warn "No IP for $name, skipping WG"; continue; }
    ssh -o StrictHostKeyChecking=no "root@${wip}" \
      "kube-network init ${node_id}" 2>/dev/null || warn "WG init failed on $name"
    ((node_id++))
  done

  # Exchange WG keys between all nodes
  local cp_mgmt_pub cp_k8s_pub
  cp_mgmt_pub="$(ssh -o StrictHostKeyChecking=no "root@${cp_ip}" 'cat /etc/wireguard/wg-mgmt.pub' 2>/dev/null)"
  cp_k8s_pub="$(ssh -o StrictHostKeyChecking=no "root@${cp_ip}" 'cat /etc/wireguard/wg-k8s.pub' 2>/dev/null)"

  node_id=2
  for i in $(seq 1 "$WORKERS"); do
    local name="${WORKER_PREFIX}-${i}"
    local wip="${worker_ips[$name]}"
    [[ -n "$wip" ]] || continue

    local w_pub
    w_pub="$(ssh -o StrictHostKeyChecking=no "root@${wip}" 'cat /etc/wireguard/wg-mgmt.pub' 2>/dev/null)"

    # Add worker as peer on CP
    ssh -o StrictHostKeyChecking=no "root@${cp_ip}" \
      "kube-network add-peer ${wip} ${w_pub} ${node_id}" 2>/dev/null || true

    # Add CP as peer on worker
    ssh -o StrictHostKeyChecking=no "root@${wip}" \
      "kube-network add-peer ${cp_ip} ${cp_mgmt_pub} 1" 2>/dev/null || true

    ((node_id++))
  done

  # Pin kubelet on all nodes
  ssh -o StrictHostKeyChecking=no "root@${cp_ip}" "kube-network pin-kubelet" 2>/dev/null || true
  for i in $(seq 1 "$WORKERS"); do
    local name="${WORKER_PREFIX}-${i}"
    local wip="${worker_ips[$name]}"
    [[ -n "$wip" ]] || continue
    ssh -o StrictHostKeyChecking=no "root@${wip}" "kube-network pin-kubelet" 2>/dev/null || true
  done

  log "WireGuard backplane configured"

  # Step 3: Bootstrap control plane
  echo ""
  echo -e "${Y}=== Bootstrapping Control Plane ===${N}"
  ssh -o StrictHostKeyChecking=no "root@${cp_ip}" \
    "kube-init" 2>&1 || die "kube-init failed on control plane"

  # Step 4: Join workers
  echo ""
  echo -e "${Y}=== Joining Workers ===${N}"
  local wg_cp_ip="10.251.0.1"  # CP's wg-k8s IP
  for i in $(seq 1 "$WORKERS"); do
    local name="${WORKER_PREFIX}-${i}"
    local wip="${worker_ips[$name]}"
    [[ -n "$wip" ]] || continue
    log "Joining ${name}..."
    ssh -o StrictHostKeyChecking=no "root@${wip}" \
      "kube-join ${wg_cp_ip}" 2>&1 || warn "Failed to join $name"
  done

  # Step 5: Smoke test
  echo ""
  echo -e "${Y}=== Smoke Test ===${N}"
  sleep 10
  ssh -o StrictHostKeyChecking=no "root@${cp_ip}" \
    "kube-smoke-test" 2>&1 || warn "Smoke test had failures"

  # Final status
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  Kubernetes Cluster Deployed                                ${N}"
  echo -e "${C}──────────────────────────────────────────────────────────────${N}"
  echo -e "  Control plane:  ${G}${CP_NAME}${N} (${cp_ip} / 10.251.0.1)"
  echo -e "  Workers:        ${G}${WORKERS}${N}"
  echo -e "  CNI:            ${G}Cilium (eBPF)${N}"
  echo -e "  Backplane:      ${G}WireGuard (wg-mgmt + wg-k8s)${N}"
  echo -e "  Storage:        ${G}ZFS on root${N}"
  echo -e "  Cloned from:    ${GOLDEN} (each clone: ~100ms, 0 bytes)"
  echo ""
  echo -e "  Access:"
  echo -e "    ssh root@${cp_ip}"
  echo -e "    kubectl get nodes"
  echo -e "    kube-status"
  echo -e "    cilium status"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
}

# ── Dispatch ───────────────────────────────────────────────────────────────
case "$CMD" in
  create)    cmd_create ;;
  bootstrap) cmd_bootstrap ;;
  destroy)   cmd_destroy ;;
  status)    cmd_status ;;
  *)         usage ;;
esac
