#!/usr/bin/env bash
# bob-bash — natural language → complete bash scripts → execute
# THE BIG ONE. Bob writes production-quality bash and runs it.
#
# Usage: bob-bash "make a kubernetes cluster with k3s"
#        bob-bash "set up nginx reverse proxy for port 3000"
#        bob-bash --dry-run "configure wireguard tunnel"
#        bob-bash --yes "install docker"
#        bob-bash --edit "create a backup script"
set -euo pipefail

BOB_MODEL="${BOB_MODEL:-bob}"
BOB_DIR="${HOME}/.bob"
HISTORY_DIR="${BOB_DIR}/bash-history"
SCRIPT_DIR="${BOB_DIR}/scripts"

mkdir -p "$HISTORY_DIR" "$SCRIPT_DIR"

# ── Colors ───────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# ── Parse flags ──────────────────────────────────────────────────────────────
AUTO_YES=false
DRY_RUN=false
VERBOSE=false
EDIT_MODE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --yes|-y) AUTO_YES=true; shift ;;
    --dry-run) DRY_RUN=true; shift ;;
    --verbose|-v) VERBOSE=true; shift ;;
    --edit|-e) EDIT_MODE=true; shift ;;
    --model) BOB_MODEL="$2"; shift 2 ;;
    --help|-h)
      echo "bob-bash — natural language to production bash scripts"
      echo ""
      echo "Usage: bob-bash \"your request\""
      echo "  --yes       Skip confirmation"
      echo "  --dry-run   Show script but don't run"
      echo "  --edit      Open script in editor before running"
      echo "  --verbose   Show Bob's reasoning"
      echo "  --model X   Use a different model"
      exit 0
      ;;
    *) break ;;
  esac
done

if [[ $# -eq 0 ]]; then
  echo -e "${CYAN}bob-bash${NC} — tell Bob what to build"
  echo "Usage: bob-bash \"set up nginx reverse proxy for port 3000\""
  exit 0
fi

REQUEST="$*"

# ── System context ───────────────────────────────────────────────────────────
_os=$(cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d= -f2 | tr -d '"')
_pkg_mgr="dnf"
command -v apt &>/dev/null && _pkg_mgr="apt"
command -v pacman &>/dev/null && _pkg_mgr="pacman"
_ram=$(awk '/MemTotal/{printf "%.0f", $2/1024/1024}' /proc/meminfo 2>/dev/null)
_cores=$(nproc 2>/dev/null || echo "?")
_user=$(whoami)
_installed=$(rpm -qa --qf '%{NAME}\n' 2>/dev/null | sort | head -200 | tr '\n' ' ' || dpkg -l 2>/dev/null | awk '/^ii/{print $2}' | head -200 | tr '\n' ' ' || true)

CTX="OS: ${_os}
Package manager: ${_pkg_mgr}
RAM: ${_ram}GB
CPU cores: ${_cores}
User: ${_user}
Installed (sample): ${_installed:0:500}"

# ── Ask Bob to write the script ──────────────────────────────────────────────
echo -e "${BLUE}Bob is writing a script...${NC}"

SCRIPT_PROMPT="You are a bash script generator. Write a COMPLETE, production-quality bash script for this request.

RULES:
1. Start with #!/usr/bin/env bash
2. Always use: set -euo pipefail
3. Always add: trap 'echo \"Error on line \$LINENO\" >&2' ERR
4. Check all dependencies with command -v before using them
5. Show progress with echo statements (=== Step: ... ===)
6. Make operations idempotent where possible (check before creating)
7. Confirm destructive operations with read -rp
8. Handle errors gracefully
9. End with a clear success message

System context:
${CTX}

Request: ${REQUEST}

Output ONLY the bash script. No explanation before or after. No markdown fences. Just the script."

SCRIPT=$(echo "$SCRIPT_PROMPT" | ollama run "$BOB_MODEL" 2>/dev/null)

# Clean up — remove markdown fences if model added them
SCRIPT=$(echo "$SCRIPT" | sed '/^```/d')

# Ensure it starts with shebang
if ! echo "$SCRIPT" | head -1 | grep -q '^#!/'; then
  SCRIPT="#!/usr/bin/env bash
set -euo pipefail
trap 'echo \"Error on line \$LINENO\" >&2' ERR

${SCRIPT}"
fi

# ── Save script ──────────────────────────────────────────────────────────────
_timestamp=$(date +%Y%m%d-%H%M%S)
_script_file="${SCRIPT_DIR}/${_timestamp}-bob-bash.sh"
echo "$SCRIPT" > "$_script_file"
chmod +x "$_script_file"

# ── Display ──────────────────────────────────────────────────────────────────
echo ""
echo -e "${BOLD}━━━ Script ━━━${NC}"
echo ""

# Syntax highlight (basic — colorize comments, strings, keywords)
echo "$SCRIPT" | while IFS= read -r line; do
  if [[ "$line" =~ ^[[:space:]]*# ]]; then
    echo -e "${DIM}${line}${NC}"
  elif [[ "$line" =~ ^[[:space:]]*(if|then|else|elif|fi|for|do|done|while|case|esac|function) ]]; then
    echo -e "${YELLOW}${line}${NC}"
  elif [[ "$line" =~ ^=== ]]; then
    echo -e "${CYAN}${line}${NC}"
  else
    echo "$line"
  fi
done

echo ""
echo -e "${BOLD}━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "${DIM}Script saved: ${_script_file}${NC}"

# ── Log ──────────────────────────────────────────────────────────────────────
_log="${HISTORY_DIR}/${_timestamp}.log"
echo "# bob-bash: ${REQUEST}" > "$_log"
echo "# date: $(date)" >> "$_log"
echo "# script: ${_script_file}" >> "$_log"

# ── Dry run ──────────────────────────────────────────────────────────────────
if [[ "$DRY_RUN" == true ]]; then
  echo -e "${YELLOW}Dry run — script not executed.${NC}"
  exit 0
fi

# ── Edit mode ────────────────────────────────────────────────────────────────
if [[ "$EDIT_MODE" == true ]]; then
  _editor="${EDITOR:-vi}"
  echo -e "${BLUE}Opening in ${_editor}...${NC}"
  "$_editor" "$_script_file"
  echo ""
  echo -e "${BLUE}Script edited. Run it?${NC}"
fi

# ── Confirm ──────────────────────────────────────────────────────────────────
if [[ "$AUTO_YES" != true ]]; then
  echo -e -n "${BOLD}Run this script?${NC} [y/N] "
  read -r _confirm
  if [[ "$_confirm" != "y" ]] && [[ "$_confirm" != "Y" ]]; then
    echo -e "${DIM}Script saved but not executed: ${_script_file}${NC}"
    exit 0
  fi
fi

# ── Execute ──────────────────────────────────────────────────────────────────
echo ""
echo -e "${GREEN}${BOLD}Executing...${NC}"
echo ""

echo "# EXECUTED: $(date)" >> "$_log"
set +e
bash "$_script_file" 2>&1 | tee -a "$_log"
_exit=$?
set -e

echo "" >> "$_log"
if [[ $_exit -eq 0 ]]; then
  echo "# RESULT: success" >> "$_log"
  echo ""
  echo -e "${GREEN}${BOLD}✔ Done.${NC}"
else
  echo "# RESULT: failed (exit ${_exit})" >> "$_log"
  echo ""
  echo -e "${RED}Script failed (exit ${_exit}).${NC}"
fi

# ── Follow-up loop ───────────────────────────────────────────────────────────
echo ""
echo -e "${DIM}Follow-up? (empty to quit)${NC}"
while true; do
  echo -e -n "${CYAN}bob-bash> ${NC}"
  read -r _followup
  [[ -z "$_followup" ]] && break

  # Include previous context
  PREV_CONTEXT="Previous script that just ran:
$(cat "$_script_file")

Previous result: $(tail -1 "$_log")

Follow-up request: ${_followup}"

  echo -e "${BLUE}Bob is writing...${NC}"
  SCRIPT=$(echo "You are a bash script generator. Write a follow-up script.

System context:
${CTX}

${PREV_CONTEXT}

Output ONLY the bash script. No explanation. No markdown fences." | ollama run "$BOB_MODEL" 2>/dev/null | sed '/^```/d')

  _timestamp=$(date +%Y%m%d-%H%M%S)
  _script_file="${SCRIPT_DIR}/${_timestamp}-bob-bash.sh"
  echo "$SCRIPT" > "$_script_file"
  chmod +x "$_script_file"

  echo ""
  echo "$SCRIPT"
  echo ""

  if [[ "$AUTO_YES" != true ]]; then
    echo -e -n "${BOLD}Run?${NC} [y/N] "
    read -r _confirm
    [[ "$_confirm" != "y" ]] && [[ "$_confirm" != "Y" ]] && continue
  fi

  set +e
  bash "$_script_file" 2>&1 | tee -a "$_log"
  set -e
done
