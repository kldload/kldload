#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════════
# kzfs-lab — ZFS Development Lab on KVM with Blue-Green Deployment
# ══════════════════════════════════════════════════════════════════════════
#
# Deploys 6 Linux distros as KVM virtual machines on a ZFS-backed hypervisor,
# each provisioned with the full OpenZFS source tree, zfs-tests.sh test suite,
# eBPF tracing tools, and C/kernel dev toolchains.
#
# The 6 distros are chosen to cover all three Linux package manager families:
#   - dnf family:    CentOS Stream 9, Rocky Linux 9, Fedora 41
#   - apt family:    Debian 13 (Trixie), Ubuntu 24.04 (Noble)
#   - pacman family: Arch Linux (rolling)
# This ensures OpenZFS is tested against every major packaging ecosystem —
# the same kernel module, different userlands, different DKMS integrations.
#
# Blue-Green Deployment Concept:
#   Golden images are base templates built once (download cloud image, install
#   ZFS + dev tools, seal for cloning). From goldens, two identical "sites"
#   can be deployed:
#     - Blue  = production baseline (known-good state)
#     - Green = staging environment (test changes here)
#   Promoting green makes it the new blue via ZFS clone (instant, zero-copy).
#   Rollback reverts blue to its previous snapshot (also instant — ZFS COW).
#   This pattern lets you test OpenZFS patches across all 6 distros in green,
#   then atomically swap to blue once validated.
#
# Observability VM:
#   A 7th VM (always CentOS Stream 9 — chosen for stability as infra) runs
#   Prometheus, Grafana, Loki, and Alertmanager. Every lab VM auto-reports
#   metrics (node_exporter :9100) and logs (promtail -> Loki) to this VM.
#   The obs VM is deployed from the CentOS golden image, so it requires
#   "kzfs-lab build centos" before deploying a site.
#
# Usage:
#   kzfs-lab build [distro|all]       Build golden images
#   kzfs-lab deploy blue|green        Clone goldens to blue or green site
#   kzfs-lab promote green            Green becomes new blue
#   kzfs-lab rollback                 Revert blue to previous snapshot
#   kzfs-lab test [distro|all]        Run zfs-tests.sh in VMs
#   kzfs-lab status                   Show all VMs, sites, snapshots
#   kzfs-lab destroy blue|green|all   Tear down
#   kzfs-lab demo                     Interactive menu
set -uo pipefail

if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

# ── Configuration ─────────────────────────────────────────────────────────
POOL="${POOL:-rpool}"             # ZFS pool where golden images and clones live
LAB_PREFIX="zfslab"              # Naming prefix for all VMs and zvols
RAM="${RAM:-4096}"                # Per-VM RAM in MB — 4G is enough for ZFS DKMS builds
CPUS="${CPUS:-2}"                # Per-VM vCPUs
DISK="${DISK:-40}"               # Golden zvol size in GB — must fit cloud image + ZFS source + tests
SSH_KEY="${SSH_KEY:-/root/.ssh/id_ed25519}"
ISO_DIR="/var/lib/libvirt/isos"  # Where cloud images and cloud-init ISOs are stored

DISTROS=(centos rocky fedora debian ubuntu arch)
# shellcheck disable=SC2034  # OBS_VM used in deploy_site
OBS_VM="obs"  # observability VM name suffix

# Cloud image URLs — official GenericCloud/cloudimg qcow2 images from each distro.
# These are minimal cloud-init-enabled images (~500MB-2GB) designed for VM deployment.
# Each vendor publishes at a stable "latest" URL so rebuilds pick up security patches.
declare -A CLOUD_IMAGES=(
  [centos]="https://cloud.centos.org/centos/9-stream/x86_64/images/CentOS-Stream-GenericCloud-9-latest.x86_64.qcow2"
  [rocky]="https://dl.rockylinux.org/pub/rocky/9/images/x86_64/Rocky-9-GenericCloud-Base.latest.x86_64.qcow2"
  [fedora]="https://download.fedoraproject.org/pub/fedora/linux/releases/41/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-41-1.4.x86_64.qcow2"
  [debian]="https://cloud.debian.org/images/cloud/trixie/daily/latest/debian-13-genericcloud-amd64-daily.qcow2"
  [ubuntu]="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
  [arch]="https://geo.mirror.pkgbuild.com/images/latest/Arch-Linux-x86_64-cloudimg.qcow2"
)

# virt-install --os-variant values for libvirt optimization hints.
# Rocky uses centos-stream9 because libvirt has no rocky9 variant.
# Fedora uses fedora-unknown because the exact release variant may not be installed.
declare -A OS_VARIANTS=(
  [centos]="centos-stream9"
  [rocky]="centos-stream9"
  [fedora]="fedora-unknown"
  [debian]="debian12"
  [ubuntu]="ubuntu24.04"
  [arch]="archlinux"
)

# Maps each distro to its package manager family, used to dispatch
# per-distro install logic in setup_zfs_dev_vm (dnf vs apt vs pacman).
declare -A DISTRO_FAMILY=(
  [centos]="dnf"
  [rocky]="dnf"
  [fedora]="dnf"
  [debian]="apt"
  [ubuntu]="apt"
  [arch]="pacman"
)

# ── Colors ────────────────────────────────────────────────────────────────
C="\033[1;36m"; G="\033[1;32m"; Y="\033[1;33m"; R="\033[1;31m"
W="\033[1;37m"; D="\033[0;37m"; N="\033[0m"; B="\033[1;34m"

log()  { echo -e "${G}[kzfs-lab]${N} $*"; }
warn() { echo -e "${Y}[kzfs-lab]${N} $*" >&2; }
die()  { echo -e "${R}[kzfs-lab]${N} $*" >&2; exit 1; }

# ── Helpers ───────────────────────────────────────────────────────────────

# SSH with key-based auth, falling back to password auth (kldload).
# The fallback handles freshly-booted VMs where cloud-init may not have
# finished injecting the SSH key yet.
_ssh_cmd() {
  local ip="$1"; shift
  ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 -o BatchMode=yes \
    -i "$SSH_KEY" "root@${ip}" "$@" 2>/dev/null \
  || sshpass -p kldload ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 \
    "root@${ip}" "$@" 2>/dev/null
}

# Resolve a VM's IP address, polling up to 90 seconds. Tries two methods:
# 1. virsh domifaddr (QEMU guest agent) — preferred, instant when available
# 2. virsh net-dhcp-leases (dnsmasq leases) — fallback for VMs without guest agent
# The MAC lookup is cached after first discovery to avoid repeated virsh calls.
get_vm_ip() {
  local vm="$1"
  local ip="" mac=""
  for _ in $(seq 1 45); do
    ip="$(virsh domifaddr "$vm" 2>/dev/null | awk '/ipv4/ {print $4}' | cut -d/ -f1)"
    [[ -n "$ip" ]] && break
    if [[ -z "$mac" ]]; then
      mac="$(virsh domiflist "$vm" 2>/dev/null | awk '/bridge/ {print $5}')"
    fi
    if [[ -n "$mac" ]]; then
      ip="$(virsh net-dhcp-leases default 2>/dev/null | grep "$mac" | awk '{print $5}' | cut -d/ -f1)"
      [[ -n "$ip" ]] && break
    fi
    sleep 2
  done
  echo "$ip"
}

wait_for_ssh() {
  local ip="$1" max="${2:-150}"
  local i=0
  while ! _ssh_cmd "$ip" true 2>/dev/null; do
    ((i++))
    [[ $i -ge $max ]] && return 1
    sleep 2
  done
  return 0
}

ensure_ssh_key() {
  if [[ ! -f "$SSH_KEY" ]]; then
    log "Generating SSH key for lab management..."
    ssh-keygen -t ed25519 -f "$SSH_KEY" -N "" -q
  fi
}

# Nanosecond-precision timer pair for measuring ZFS clone speeds and build times.
# ZFS clones are near-instant (typically <100ms) so millisecond resolution matters
# to demonstrate the performance advantage of COW cloning over full copies.
timer_start() { date +%s%N; }
timer_elapsed_ms() {
  local start="$1"
  local now
  now=$(date +%s%N)
  echo $(( (now - start) / 1000000 ))
}

# VM naming helpers — enforce consistent naming across golden images, site VMs,
# ZFS datasets, and /dev/zvol block device paths.
# Examples: zfslab-golden-centos, zfslab-blue-centos, rpool/vms/zfslab-blue-centos
golden_name()  { echo "${LAB_PREFIX}-golden-${1}"; }
site_name()    { echo "${LAB_PREFIX}-${1}-${2}"; }   # site_name blue centos
zvol_path()    { echo "${POOL}/vms/${1}"; }
zvol_dev()     { echo "/dev/zvol/${POOL}/vms/${1}"; }

validate_distro() {
  local d="$1"
  for valid in "${DISTROS[@]}"; do
    [[ "$d" == "$valid" ]] && return 0
  done
  die "Unknown distro: ${d}. Valid: ${DISTROS[*]}"
}

validate_site() {
  local s="$1"
  [[ "$s" == "blue" || "$s" == "green" ]] || die "Invalid site: ${s}. Must be blue or green."
}

# List VMs matching a pattern
list_site_vms() {
  local site="$1"
  for d in "${DISTROS[@]}"; do
    echo "$(site_name "$site" "$d")"
  done
}

# Check if golden exists for distro
golden_exists() {
  zfs list "$(zvol_path "$(golden_name "$1")")" >/dev/null 2>&1
}

# Generate a cloud-init NoCloud ISO for a VM.
# Cloud-init requires three separate files on a "cidata"-labeled ISO:
#   - meta-data:       instance identity (used by cloud-init to detect first boot)
#   - user-data:       #cloud-config YAML (users, packages, SSH keys, runcmd)
#   - network-config:  v2 netplan-style config (DHCP on first ethernet interface)
# The ISO is attached as a virtual CDROM — cloud-init auto-detects the "cidata"
# volume label and consumes the config on first boot. This avoids needing an
# external metadata service (IMDS) which would require network infrastructure.
make_cloud_init_iso() {
  local name="$1" hostname="$2" ready_marker="${3:-}"
  local ci_dir ci_iso

  ensure_ssh_key
  local pubkey
  pubkey="$(cat "${SSH_KEY}.pub")"

  ci_dir="$(mktemp -d)"
  ci_iso="${ISO_DIR}/${name}-cloud-init.iso"

  # meta-data: unique instance-id prevents cloud-init from re-running on reboot.
  # Changing instance-id triggers a fresh cloud-init cycle (used when re-cloning).
  cat > "${ci_dir}/meta-data" <<META
instance-id: ${name}
local-hostname: ${hostname}
META

  # Optional ready marker: golden builds use this to signal that cloud-init
  # is finished before we start installing ZFS dev tools over SSH.
  local runcmd_extra=""
  if [[ -n "$ready_marker" ]]; then
    runcmd_extra="  - touch ${ready_marker}"
  fi

  # user-data: root access with both SSH key and password auth, plus runcmd
  # to ensure sshd is configured for root login (some cloud images disable it).
  # sshd restart uses both names because Debian/Ubuntu call it "ssh", RHEL calls it "sshd".
  cat > "${ci_dir}/user-data" <<USERDATA
#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
disable_root: false
ssh_pwauth: true
users:
  - default
  - name: root
    lock_passwd: false
    ssh_authorized_keys:
      - ${pubkey}
    shell: /bin/bash
chpasswd:
  expire: false
  users:
    - name: root
      password: kldload
      type: text
ssh_authorized_keys:
  - ${pubkey}
package_update: true
packages:
  - openssh-server
  - sudo
  - curl
runcmd:
  - sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
  - sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
  - rm -f /etc/ssh/ssh_host_*
  - ssh-keygen -A
  - dpkg-reconfigure openssh-server 2>/dev/null || true
  - systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true
${runcmd_extra}
USERDATA

  # network-config: match "en*" to handle both ens3 (KVM virtio) and enp1s0
  # naming schemes across different distro udev rules. DHCP from virbr0.
  cat > "${ci_dir}/network-config" <<NETCFG
version: 2
ethernets:
  id0:
    match:
      name: "en*"
    dhcp4: true
  id1:
    match:
      name: "eth*"
    dhcp4: true
NETCFG

  # Build the ISO with whichever tool is available. The "cidata" volume label
  # is mandatory — cloud-init's NoCloud datasource identifies config ISOs by it.
  # Try genisoimage (common on RHEL), then mkisofs (legacy), then xorriso (modern).
  genisoimage -output "$ci_iso" -volid cidata -joliet -rock \
    "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null \
    || mkisofs -output "$ci_iso" -volid cidata -joliet -rock \
      "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null \
    || xorriso -as mkisofs -o "$ci_iso" -volid cidata -joliet -rock \
      "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null

  rm -rf "$ci_dir"
  echo "$ci_iso"
}

# ── Per-distro ZFS Dev Setup ─────────────────────────────────────────────
# Installs the full ZFS development environment on a VM over SSH.
# Dispatches on package manager family because the three families have
# completely different package names for the same tools:
#   - dnf (CentOS/Rocky/Fedora): kernel-devel, libuuid-devel, epel-release for extras
#   - apt (Debian/Ubuntu): linux-headers-$(uname -r), uuid-dev, bpfcc-tools (not bcc-tools)
#   - pacman (Arch): base-devel meta-package, linux-headers, no ZFS in repos (AUR only)
# Each family also installs node_exporter from binary — every VM must export
# metrics on :9100 so the observability VM can auto-discover them via Prometheus.
setup_zfs_dev_vm() {
  local ip="$1" distro="$2"
  local family="${DISTRO_FAMILY[$distro]}"

  log "  Installing ZFS dev environment on ${distro}..."

  case "$family" in
    dnf)
      # dnf family: CentOS, Rocky, Fedora
      # epel-release provides extra packages (bpftrace, bcc-tools) on RHEL clones.
      # ZFS is installed from the official zfsonlinux.org repo (not in base repos).
      _ssh_cmd "$ip" bash -s <<'DNFSETUP'
set -e
dnf install -y epel-release 2>/dev/null || true

# C toolchain + kernel dev
dnf install -y \
  gcc gcc-c++ clang make cmake autoconf automake libtool git \
  kernel-devel kernel-headers dkms \
  gdb strace perf valgrind \
  libuuid-devel libblkid-devel libtirpc-devel \
  openssl-devel zlib-devel libaio-devel \
  python3 python3-devel python3-cffi || true

# eBPF
dnf install -y bpftrace bcc-tools bpftool perf || true

# System tools
dnf install -y sysstat htop nftables wireguard-tools curl jq tmux || true

# ZFS
if ! command -v zfs >/dev/null 2>&1; then
  dnf install -y https://zfsonlinux.org/epel/zfs-release-2-3$(rpm --eval "%{dist}").noarch.rpm 2>/dev/null || true
  dnf install -y zfs zfs-dkms 2>/dev/null || true
fi

# node_exporter for metrics
if ! command -v node_exporter >/dev/null 2>&1; then
  curl -fsSL https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-amd64.tar.gz \
    | tar -xz -C /tmp 2>/dev/null && install -m 755 /tmp/node_exporter-*/node_exporter /usr/local/bin/ && rm -rf /tmp/node_exporter-* || true
fi

echo "DNF setup complete"
DNFSETUP
      ;;
    apt)
      # apt family: Debian, Ubuntu
      # Package names differ from dnf: uuid-dev (not libuuid-devel), bpfcc-tools
      # (not bcc-tools), linux-perf (not perf). ZFS is in the main repos for both
      # Debian and Ubuntu as zfsutils-linux + zfs-dkms.
      _ssh_cmd "$ip" bash -s <<'APTSETUP'
set -e
export DEBIAN_FRONTEND=noninteractive
apt-get update -y

# C toolchain + kernel dev
apt-get install -y \
  build-essential clang make cmake autoconf automake libtool git \
  linux-headers-$(uname -r) dkms \
  gdb strace valgrind \
  uuid-dev libblkid-dev libtirpc-dev \
  libssl-dev zlib1g-dev libaio-dev \
  python3 python3-dev python3-cffi || true

# eBPF
apt-get install -y bpftrace bpfcc-tools linux-perf bpftool 2>/dev/null || true

# System tools
apt-get install -y sysstat htop nftables wireguard-tools curl jq tmux 2>/dev/null || true

# ZFS
if ! command -v zfs >/dev/null 2>&1; then
  apt-get install -y zfsutils-linux zfs-dkms 2>/dev/null || true
fi

# node_exporter
if ! command -v node_exporter >/dev/null 2>&1; then
  curl -fsSL https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-amd64.tar.gz \
    | tar -xz -C /tmp 2>/dev/null && install -m 755 /tmp/node_exporter-*/node_exporter /usr/local/bin/ && rm -rf /tmp/node_exporter-* || true
fi

echo "APT setup complete"
APTSETUP
      ;;
    pacman)
      # pacman family: Arch Linux only.
      # ZFS is NOT in the official Arch repos — it requires the AUR (zfs-dkms).
      # We skip automatic ZFS install here; users can build from /usr/src/zfs
      # or use an AUR helper. Everything else (eBPF, dev tools) is in [extra].
      _ssh_cmd "$ip" bash -s <<'PACSETUP'
set -e
pacman -Syu --noconfirm
pacman -S --noconfirm \
  base-devel clang cmake git \
  linux-headers dkms \
  gdb strace perf valgrind \
  python python-cffi \
  bpftrace bcc-tools bpftool \
  sysstat htop nftables wireguard-tools curl jq tmux 2>/dev/null || true

echo "NOTE: ZFS on Arch requires AUR (zfs-dkms). Skipping."
echo "Pacman setup complete"
PACSETUP
      ;;
  esac

  # Common setup for all distros regardless of package manager:
  # 1. Clone the upstream OpenZFS source tree for building/testing
  # 2. Pre-install bpftrace scripts for ZFS-specific observability
  # 3. Set a MOTD so users know what tools are available when they SSH in
  _ssh_cmd "$ip" bash -s <<'COMMON'
git clone https://github.com/openzfs/zfs.git /usr/src/zfs 2>/dev/null || true
modprobe zfs 2>/dev/null || true
zfs version 2>/dev/null || echo "ZFS not loaded — DKMS may need rebuild after first boot"

# Pre-built bpftrace scripts for ZFS debugging
mkdir -p /usr/local/share/bpftrace
cat > /usr/local/share/bpftrace/zfs-latency.bt <<'BT'
tracepoint:zfs:zfs_read_done,tracepoint:zfs:zfs_write_done { @us = hist((nsecs - args->start) / 1000); }
BT
cat > /usr/local/share/bpftrace/zfs-arc.bt <<'BT'
kprobe:arc_read { @hits = count(); }
kprobe:arc_read_done { @misses = count(); }
interval:s:5 { print(@); clear(@); }
BT
cat > /usr/local/share/bpftrace/syscall-top.bt <<'BT'
tracepoint:raw_syscalls:sys_enter { @[comm, args->id] = count(); }
interval:s:5 { print(@); clear(@); }
BT

cat > /etc/motd <<'MOTD'

  kldload ZFS Dev Lab
  C toolchain • ZFS source + tests • eBPF tracing • 6 distros
  Blue-green deployment • Instant rollback

  Source:  /usr/src/zfs (OpenZFS)
  Tests:   cd /usr/src/zfs && ./autogen.sh && ./configure && make
  Traces:  /usr/local/share/bpftrace/*.bt
  Run:     bpftrace /usr/local/share/bpftrace/zfs-latency.bt

MOTD

echo "Common setup complete"
COMMON

  log "  ZFS dev environment installed on ${distro}"
}

# ── Setup: Observability VM (CentOS Stream 9) ────────────────────────────
# Installs the full observability stack on the dedicated obs VM:
#   - Prometheus (metrics collection, scrapes node_exporter on all lab VMs)
#   - Grafana (dashboards, pre-provisioned with Prometheus + Loki datasources)
#   - Loki (log aggregation, receives from promtail on all lab VMs)
#   - Alertmanager (alerts for node down, high CPU/mem/disk)
#
# Always CentOS Stream 9 because it is the most stable RHEL-family distro
# for long-running infrastructure services — no rolling updates, no EOL surprises.
# The obs VM is cloned from the CentOS golden image like any other site VM.
#
# The stack uses static Prometheus targets on the WireGuard mesh IPs (not
# service discovery) because the lab has a fixed, known set of VMs.
setup_obs_vm() {
  local ip="$1" site="$2"
  # Blue and green sites use separate WireGuard subnets so they can coexist
  # without IP conflicts (blue = 10.252.0.0/24, green = 10.253.0.0/24)
  local wg_base
  [[ "$site" == "blue" ]] && wg_base="10.252.0" || wg_base="10.253.0"

  log "  Installing observability stack on obs VM..."

  _ssh_cmd "$ip" bash -s <<OBSSETUP
set -e

# ── Grafana repo ──
cat > /etc/yum.repos.d/grafana.repo <<'REPO'
[grafana]
name=Grafana OSS
baseurl=https://rpm.grafana.com
gpgcheck=1
gpgkey=https://rpm.grafana.com/gpg.key
enabled=1
REPO

dnf install -y epel-release 2>/dev/null || true
dnf install -y \
  prometheus2 grafana loki promtail alertmanager \
  node_exporter \
  nftables wireguard-tools curl jq htop btop \
  2>/dev/null || true

# Fallback: install from binary if RPM not available
if ! command -v prometheus >/dev/null 2>&1; then
  echo "Installing Prometheus from binary..."
  curl -fsSL https://github.com/prometheus/prometheus/releases/download/v2.54.1/prometheus-2.54.1.linux-amd64.tar.gz \
    | tar -xz -C /tmp 2>/dev/null
  install -m 755 /tmp/prometheus-*/prometheus /usr/local/bin/
  install -m 755 /tmp/prometheus-*/promtool /usr/local/bin/
  mkdir -p /etc/prometheus /var/lib/prometheus
  cp /tmp/prometheus-*/prometheus.yml /etc/prometheus/ 2>/dev/null || true
  rm -rf /tmp/prometheus-*

  # Systemd unit
  cat > /etc/systemd/system/prometheus.service <<'SVC'
[Unit]
Description=Prometheus
After=network-online.target
[Service]
Type=simple
ExecStart=/usr/local/bin/prometheus --config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/var/lib/prometheus --web.listen-address=0.0.0.0:9090
Restart=always
[Install]
WantedBy=multi-user.target
SVC
fi

if ! command -v grafana-server >/dev/null 2>&1; then
  echo "Installing Grafana from binary..."
  dnf install -y https://dl.grafana.com/oss/release/grafana-11.4.0-1.x86_64.rpm 2>/dev/null || true
fi

if ! command -v loki >/dev/null 2>&1; then
  echo "Installing Loki from binary..."
  curl -fsSL https://github.com/grafana/loki/releases/download/v3.3.2/loki-linux-amd64.zip \
    -o /tmp/loki.zip 2>/dev/null && unzip -o /tmp/loki.zip -d /usr/local/bin/ 2>/dev/null || true
  chmod +x /usr/local/bin/loki 2>/dev/null || true
  mkdir -p /etc/loki /var/lib/loki

  cat > /etc/loki/loki.yaml <<'LOKICFG'
auth_enabled: false
server:
  http_listen_port: 3100
common:
  path_prefix: /var/lib/loki
  storage:
    filesystem:
      chunks_directory: /var/lib/loki/chunks
      rules_directory: /var/lib/loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory
schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h
LOKICFG

  cat > /etc/systemd/system/loki.service <<'SVC'
[Unit]
Description=Loki
After=network-online.target
[Service]
Type=simple
ExecStart=/usr/local/bin/loki -config.file=/etc/loki/loki.yaml
Restart=always
[Install]
WantedBy=multi-user.target
SVC
fi

if ! command -v alertmanager >/dev/null 2>&1; then
  echo "Installing Alertmanager from binary..."
  curl -fsSL https://github.com/prometheus/alertmanager/releases/download/v0.27.0/alertmanager-0.27.0.linux-amd64.tar.gz \
    | tar -xz -C /tmp 2>/dev/null
  install -m 755 /tmp/alertmanager-*/alertmanager /usr/local/bin/
  mkdir -p /etc/alertmanager
  cp /tmp/alertmanager-*/alertmanager.yml /etc/alertmanager/ 2>/dev/null || true
  rm -rf /tmp/alertmanager-*

  cat > /etc/systemd/system/alertmanager.service <<'SVC'
[Unit]
Description=Alertmanager
After=network-online.target
[Service]
Type=simple
ExecStart=/usr/local/bin/alertmanager --config.file=/etc/alertmanager/alertmanager.yml --storage.path=/var/lib/alertmanager
Restart=always
[Install]
WantedBy=multi-user.target
SVC
fi

echo "Observability packages installed"
OBSSETUP

  # ── Prometheus config — static targets for all lab VMs ──
  # Each VM gets a deterministic WireGuard IP based on its index in DISTROS[],
  # so Prometheus targets are generated at deploy time without needing DNS or
  # service discovery. node_exporter listens on :9100 on every VM.
  log "  Configuring Prometheus to scrape all ${site} VMs..."
  local prom_targets=""
  local node_id=1
  for distro in "${DISTROS[@]}"; do
    prom_targets+="      - '${wg_base}.${node_id}:9100'\n"
    ((node_id++))
  done
  # The obs VM itself also runs node_exporter for self-monitoring
  prom_targets+="      - '${wg_base}.${node_id}:9100'\n"

  _ssh_cmd "$ip" bash -s <<PROMCFG
cat > /etc/prometheus/prometheus.yml <<PROM
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:9093']

scrape_configs:
  - job_name: 'kzfs-lab-nodes'
    static_configs:
      - targets:
$(echo -e "$prom_targets")
    relabel_configs:
      - source_labels: [__address__]
        regex: '(.*):\\d+'
        target_label: instance
PROM

# ── Alert rules ──
cat > /etc/prometheus/alerts.yml <<'ALERTS'
groups:
  - name: kzfs-lab
    rules:
      - alert: NodeDown
        expr: up == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Node {{ \\\$labels.instance }} is down"

      - alert: DiskSpaceHigh
        expr: (node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"}) < 0.1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Disk >90% on {{ \\\$labels.instance }}"

      - alert: HighMemory
        expr: (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) > 0.9
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Memory >90% on {{ \\\$labels.instance }}"

      - alert: HighCPU
        expr: 100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 90
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "CPU >90% on {{ \\\$labels.instance }}"
ALERTS

echo "Prometheus configured"
PROMCFG

  # ── Grafana: auto-provision Prometheus datasource + dashboard ──
  log "  Configuring Grafana..."
  _ssh_cmd "$ip" bash -s <<'GRAFCFG'
mkdir -p /etc/grafana/provisioning/datasources /etc/grafana/provisioning/dashboards /var/lib/grafana/dashboards

cat > /etc/grafana/provisioning/datasources/prometheus.yaml <<'DS'
apiVersion: 1
datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://localhost:9090
    isDefault: true
  - name: Loki
    type: loki
    access: proxy
    url: http://localhost:3100
DS

cat > /etc/grafana/provisioning/dashboards/default.yaml <<'DASH'
apiVersion: 1
providers:
  - name: default
    folder: kzfs-lab
    type: file
    options:
      path: /var/lib/grafana/dashboards
DASH

# Pre-built node overview dashboard (Grafana ID 1860 — Node Exporter Full)
curl -fsSL https://grafana.com/api/dashboards/1860/revisions/latest/download \
  -o /var/lib/grafana/dashboards/node-exporter-full.json 2>/dev/null || true

# Fix datasource in downloaded dashboard
sed -i 's/"datasource":.*"prometheus"/"datasource": {"type": "prometheus", "uid": "prometheus"}/gi' \
  /var/lib/grafana/dashboards/node-exporter-full.json 2>/dev/null || true

echo "Grafana configured"
GRAFCFG

  # ── Start all services ──
  log "  Starting observability services..."
  _ssh_cmd "$ip" bash -s <<'STARTSVC'
systemctl daemon-reload
for svc in prometheus grafana-server loki alertmanager node_exporter; do
  systemctl enable "$svc" 2>/dev/null || true
  systemctl start "$svc" 2>/dev/null || true
  if systemctl is-active "$svc" >/dev/null 2>&1; then
    echo "  RUNNING: $svc"
  else
    echo "  FAILED:  $svc"
  fi
done
STARTSVC

  local obs_wg_ip="${wg_base}.$((${#DISTROS[@]} + 1))"
  log "  Observability stack running:"
  echo -e "    Prometheus:   ${G}http://${ip}:9090${N}  (${obs_wg_ip}:9090)"
  echo -e "    Grafana:      ${G}http://${ip}:3000${N}  (${obs_wg_ip}:3000)  admin/admin"
  echo -e "    Loki:         ${G}http://${ip}:3100${N}  (${obs_wg_ip}:3100)"
  echo -e "    Alertmanager: ${G}http://${ip}:9093${N}  (${obs_wg_ip}:9093)"
}

# ── Setup: promtail + node_exporter on every lab VM ──────────────────────
# Every lab VM (all 6 distros) gets two telemetry agents:
#   - node_exporter (:9100) — system metrics (CPU, memory, disk, network)
#     scraped by Prometheus on the obs VM every 15 seconds
#   - promtail — ships syslog + journald logs to Loki on the obs VM
# This gives centralized observability across all distros without any
# per-distro configuration differences. Both agents are installed as
# static binaries with systemd units, avoiding package manager differences.
setup_vm_telemetry() {
  local ip="$1" obs_ip="$2"

  _ssh_cmd "$ip" bash -s <<TELEMETRY
# node_exporter systemd (may already be installed)
if ! systemctl is-active node_exporter >/dev/null 2>&1; then
  if command -v node_exporter >/dev/null 2>&1; then
    cat > /etc/systemd/system/node_exporter.service <<'SVC'
[Unit]
Description=Node Exporter
After=network-online.target
[Service]
Type=simple
ExecStart=/usr/local/bin/node_exporter
Restart=always
[Install]
WantedBy=multi-user.target
SVC
    systemctl daemon-reload
    systemctl enable --now node_exporter
  fi
fi

# Install promtail for centralized logging
if ! command -v promtail >/dev/null 2>&1; then
  curl -fsSL https://github.com/grafana/loki/releases/download/v3.3.2/promtail-linux-amd64.zip \
    -o /tmp/promtail.zip 2>/dev/null && unzip -o /tmp/promtail.zip -d /usr/local/bin/ 2>/dev/null || true
  chmod +x /usr/local/bin/promtail 2>/dev/null || true
fi

mkdir -p /etc/promtail
cat > /etc/promtail/promtail.yaml <<PTCFG
server:
  http_listen_port: 9080
  grpc_listen_port: 0
positions:
  filename: /var/lib/promtail/positions.yaml
clients:
  - url: http://${obs_ip}:3100/loki/api/v1/push
scrape_configs:
  - job_name: system
    static_configs:
      - targets: [localhost]
        labels:
          job: syslog
          host: \$(hostname)
          __path__: /var/log/{syslog,messages,*.log}
  - job_name: journal
    journal:
      labels:
        job: journal
        host: \$(hostname)
    relabel_configs:
      - source_labels: [__journal__systemd_unit]
        target_label: unit
PTCFG

mkdir -p /var/lib/promtail
cat > /etc/systemd/system/promtail.service <<'SVC'
[Unit]
Description=Promtail
After=network-online.target
[Service]
Type=simple
ExecStart=/usr/local/bin/promtail -config.file=/etc/promtail/promtail.yaml
Restart=always
[Install]
WantedBy=multi-user.target
SVC

systemctl daemon-reload
systemctl enable --now promtail 2>/dev/null || true
systemctl enable --now node_exporter 2>/dev/null || true
echo "Telemetry configured → ${obs_ip}"
TELEMETRY
}

# ── Build Golden Image ───────────────────────────────────────────────────
# Builds a single golden image for one distro. The process:
#   1. Download the official cloud image (qcow2) if not cached
#   2. Create a thin-provisioned ZFS zvol with 64k volblocksize
#   3. Import the cloud image into the zvol (qemu-img convert qcow2 -> raw)
#   4. Boot the VM with a cloud-init ISO for initial configuration
#   5. Install the full ZFS dev environment over SSH (setup_zfs_dev_vm)
#   6. Seal for cloning (clear machine-id, clean cloud-init state)
#   7. Shutdown and snapshot as @golden
#
# The @golden snapshot is the immutable base for all site clones.
# ZFS clones from this snapshot are instant (COW) and initially consume
# zero additional disk space — only modified blocks are stored.
build_golden_single() {
  local distro="$1"
  validate_distro "$distro"

  local name
  name="$(golden_name "$distro")"
  local zpath
  zpath="$(zvol_path "$name")"
  local zdev
  zdev="$(zvol_dev "$name")"

  # Check if golden already exists with snapshot
  if zfs list "${zpath}@golden" >/dev/null 2>&1; then
    log "Golden image ${name} already exists -- skipping"
    log "  (destroy with: zfs destroy -Rf ${zpath} to force rebuild)"
    return 0
  fi

  local t_start
  t_start="$(timer_start)"

  log "Building golden image: ${C}${name}${N}"

  # Download cloud image
  mkdir -p "$ISO_DIR"
  local url="${CLOUD_IMAGES[$distro]}"
  local img_file="${ISO_DIR}/${distro}-cloud.qcow2"

  if [[ ! -f "$img_file" ]]; then
    log "  Downloading ${distro} cloud image..."
    curl -fSL -o "$img_file" "$url" || die "Failed to download ${distro} cloud image"
    log "  Download complete"
  else
    log "  Using cached cloud image: ${img_file}"
  fi

  # Create ZFS zvol (destroy partial if exists without snapshot)
  if zfs list "$zpath" >/dev/null 2>&1; then
    log "  Destroying partial golden zvol..."
    virsh destroy "$name" 2>/dev/null || true
    virsh undefine "$name" --nvram 2>/dev/null || virsh undefine "$name" 2>/dev/null || true
    zfs destroy -Rf "$zpath" 2>/dev/null || true
  fi

  # Create a sparse (thin-provisioned) ZFS zvol. Key parameters:
  #   -s          sparse allocation — zvol does not reserve its full size upfront,
  #               so 6 x 40GB goldens do not consume 240GB on creation
  #   volblocksize=64k  matches the typical VM I/O size and qcow2 cluster size,
  #               giving good performance without excessive metadata overhead.
  #               Smaller (8k) wastes space on metadata; larger (128k+) wastes
  #               space on partial-block writes.
  #   compression=lz4  transparent compression — cloud images compress well,
  #               reducing actual disk usage by ~40-60%
  log "  Creating ZFS zvol (${DISK}G, sparse, lz4)..."
  zfs create -V "${DISK}G" -s -o volblocksize=64k \
    -o compression=lz4 "$zpath"

  # Wait for zvol device
  for _ in $(seq 1 15); do [[ -b "$zdev" ]] && break; sleep 1; done
  [[ -b "$zdev" ]] || die "ZFS zvol device not found: ${zdev}"

  # Convert the cloud image from qcow2 to raw and write directly to the zvol.
  # The zvol appears as /dev/zvol/... block device, so qemu-img writes raw
  # sectors that ZFS compresses and checksums transparently.
  log "  Importing cloud image to ZFS zvol..."
  qemu-img convert -f qcow2 -O raw "$img_file" "$zdev"

  # Cloud images ship with a small root partition (~2GB). Grow it to fill
  # the zvol so there is room for ZFS source, build artifacts, and tests.
  growpart "$zdev" 1 2>/dev/null || true

  # Cloud-init ISO
  log "  Creating cloud-init configuration..."
  local ci_iso
  ci_iso="$(make_cloud_init_iso "$name" "$name" "/var/lib/cloud/instance/zfslab-golden-ready")"

  # Boot golden VM
  log "  Booting golden VM..."
  virt-install \
    --name "$name" \
    --ram "$RAM" --vcpus "$CPUS" \
    --os-variant "${OS_VARIANTS[$distro]}" \
    --disk "path=${zdev},bus=virtio" \
    --disk "path=${ci_iso},device=cdrom" \
    --network bridge=virbr0,model=virtio \
    --graphics vnc,listen=0.0.0.0 \
    --noautoconsole \
    --import \
    2>&1 || die "Failed to boot golden VM for ${distro}"

  # Wait for IP
  log "  Waiting for VM to get IP..."
  local golden_ip
  golden_ip="$(get_vm_ip "$name")"
  [[ -n "$golden_ip" ]] || die "Golden VM ${name} did not get an IP"
  log "  Golden VM IP: ${golden_ip}"

  # Wait for SSH
  log "  Waiting for SSH..."
  wait_for_ssh "$golden_ip" 120 || die "SSH not available on ${name}"

  # Wait for cloud-init ready marker
  log "  Waiting for cloud-init to finish..."
  for _ in $(seq 1 90); do
    _ssh_cmd "$golden_ip" "test -f /var/lib/cloud/instance/zfslab-golden-ready" 2>/dev/null && break
    sleep 5
  done

  # Install ZFS dev environment
  setup_zfs_dev_vm "$golden_ip" "$distro"

  # Seal the golden image so clones behave as fresh machines.
  # - cloud-init clean: removes instance data so cloud-init re-runs on next boot
  #   (picks up new hostname, instance-id from the clone's cloud-init ISO)
  # - empty machine-id: systemd regenerates a unique ID on next boot
  # - empty hostname: set per-clone via cloud-init or hostnamectl after boot
  log "  Sealing golden image for cloning..."
  _ssh_cmd "$golden_ip" "cloud-init clean --logs 2>/dev/null || true"
  _ssh_cmd "$golden_ip" "rm -f /etc/machine-id; touch /etc/machine-id"
  _ssh_cmd "$golden_ip" "truncate -s 0 /etc/hostname"
  # Remove rendered network config so clones get fresh DHCP from their
  # cloud-init ISO. Without this, clones inherit the golden's static
  # network config and never request DHCP on virbr0.
  _ssh_cmd "$golden_ip" "rm -f /etc/netplan/*.yaml /etc/systemd/network/*.network 2>/dev/null || true"
  _ssh_cmd "$golden_ip" "rm -f /var/lib/cloud/seed/nocloud-net/* 2>/dev/null || true"
  # Re-enable cloud-init services so clones re-run cloud-init on next boot.
  _ssh_cmd "$golden_ip" "systemctl enable cloud-init-local cloud-init cloud-config cloud-final 2>/dev/null || true"

  # Shutdown
  _ssh_cmd "$golden_ip" "shutdown -h now" || true
  log "  Waiting for shutdown..."
  for _ in $(seq 1 30); do
    virsh domstate "$name" 2>/dev/null | grep -q "shut off" && break
    sleep 2
  done

  # Remove cloud-init ISO
  virsh detach-disk "$name" "$ci_iso" --config 2>/dev/null || true
  rm -f "$ci_iso"

  # The @golden snapshot is the immutable base for all future clones.
  # "zfs clone golden@golden -> site-vm" is O(1) — no data is copied.
  zfs snapshot "${zpath}@golden"

  local elapsed
  elapsed="$(timer_elapsed_ms "$t_start")"
  log "Golden image ready: ${C}${name}${N} (${elapsed}ms)"
}

build_all_goldens() {
  local built=0 failed=0
  local total_start
  total_start="$(timer_start)"

  for distro in "${DISTROS[@]}"; do
    if build_golden_single "$distro"; then
      ((built++))
    else
      warn "Failed to build golden for ${distro}"
      ((failed++))
    fi
  done

  local total_elapsed
  total_elapsed="$(timer_elapsed_ms "$total_start")"
  echo ""
  log "Build complete: ${G}${built} succeeded${N}, ${R}${failed} failed${N} (${total_elapsed}ms total)"
}

# ── Deploy Site ──────────────────────────────────────────────────────────
# Deploys a full site (blue or green) by cloning all golden images.
# Each clone is a ZFS instant clone — the timer_elapsed_ms output shows
# the actual clone time (typically <100ms per VM, vs minutes for a full copy).
# After cloning, the function:
#   1. Boots all VMs with per-clone cloud-init ISOs
#   2. Configures a WireGuard full-mesh VPN across all VMs
#   3. Deploys an observability VM (Prometheus + Grafana + Loki)
#   4. Configures telemetry (node_exporter + promtail) on every VM
deploy_site() {
  local site="$1"
  validate_site "$site"

  echo -e "${C}======================================================================${N}"
  echo -e "${W}  kzfs-lab deploy ${site}                                              ${N}"
  echo -e "${C}======================================================================${N}"
  echo ""

  ensure_ssh_key
  local pubkey
  pubkey="$(cat "${SSH_KEY}.pub")"

  local deployed=0 skipped=0
  local total_start
  total_start="$(timer_start)"

  for distro in "${DISTROS[@]}"; do
    local gname
    gname="$(golden_name "$distro")"
    local gpath
    gpath="$(zvol_path "$gname")"
    local sname
    sname="$(site_name "$site" "$distro")"
    local spath
    spath="$(zvol_path "$sname")"
    local sdev
    sdev="$(zvol_dev "$sname")"

    # Check golden exists
    if ! zfs list "${gpath}@golden" >/dev/null 2>&1; then
      warn "No golden image for ${distro} -- skipping (run: kzfs-lab build ${distro})"
      ((skipped++))
      continue
    fi

    # Check if site VM already exists
    if zfs list "$spath" >/dev/null 2>&1; then
      warn "${sname} already exists -- skipping (destroy first to redeploy)"
      ((skipped++))
      continue
    fi

    # Clone golden — this is the key ZFS operation. "zfs clone" creates a
    # writable copy that shares all blocks with the golden snapshot via COW.
    # The timer proves this is near-instant regardless of image size.
    echo -ne "  ${gname}@golden -> ${sname} ... "
    local cs
    cs="$(timer_start)"
    zfs clone "${gpath}@golden" "$spath"
    local ce
    ce="$(timer_elapsed_ms "$cs")"
    echo -e "${G}done${N} (${C}${ce}ms${N})"

    # Wait for zvol device
    for _ in $(seq 1 10); do [[ -b "$sdev" ]] && break; sleep 1; done
    if [[ ! -b "$sdev" ]]; then
      warn "zvol device not found for ${sname}"
      continue
    fi

    # Create per-VM cloud-init ISO
    local ci_iso
    ci_iso="$(make_cloud_init_iso "$sname" "${site}-${distro}" "")"

    # Define and boot VM
    virt-install \
      --name "$sname" \
      --ram "$RAM" --vcpus "$CPUS" \
      --os-variant "${OS_VARIANTS[$distro]}" \
      --disk "path=${sdev},bus=virtio" \
      --disk "path=${ci_iso},device=cdrom" \
      --network bridge=virbr0,model=virtio \
      --graphics vnc,listen=0.0.0.0 \
      --noautoconsole \
      --import \
      2>&1 || { warn "Failed to boot ${sname}"; continue; }

    echo -e "  ${G}${sname}${N} started"
    ((deployed++))
  done

  echo ""
  log "Waiting for VMs to get IPs..."
  sleep 15

  # Collect IPs and verify SSH
  echo ""
  echo -e "${W}  Site ${site} VMs:${N}"
  echo -e "  ${D}%-25s %-16s %s${N}" "VM" "IP" "SSH"
  printf "  %-25s %-16s %s\n" "-------------------------" "----------------" "---"

  for distro in "${DISTROS[@]}"; do
    local sname
    sname="$(site_name "$site" "$distro")"
    if ! virsh domstate "$sname" >/dev/null 2>&1; then
      continue
    fi

    local ip
    ip="$(get_vm_ip "$sname")"
    local ssh_ok="no"
    if [[ -n "$ip" ]]; then
      if wait_for_ssh "$ip" 30; then
        ssh_ok="yes"
        # Set hostname
        _ssh_cmd "$ip" "hostnamectl set-hostname ${site}-${distro}; systemd-machine-id-setup 2>/dev/null" || true
        # Verify ZFS
        local zfs_ver
        zfs_ver="$(_ssh_cmd "$ip" "zfs version 2>/dev/null | head -1" || echo "not loaded")"
        printf "  ${G}%-25s${N} %-16s ${G}%-5s${N} %s\n" "$sname" "$ip" "$ssh_ok" "$zfs_ver"
      else
        printf "  ${Y}%-25s${N} %-16s ${R}%-5s${N}\n" "$sname" "$ip" "$ssh_ok"
      fi
    else
      printf "  ${R}%-25s${N} %-16s ${R}%-5s${N}\n" "$sname" "no IP" "no"
    fi
  done

  # ── WireGuard mesh ──────────────────────────────────────────────────────
  # Build a full-mesh WireGuard VPN so every VM can reach every other VM
  # over encrypted tunnels, independent of the libvirt bridge network.
  # Blue and green use separate subnets (10.252.0.0/24 vs 10.253.0.0/24)
  # so both sites can run simultaneously without IP conflicts.
  # Each VM gets a deterministic IP: 10.25{2,3}.0.{1..N} based on DISTROS[] index.
  echo ""
  log "Configuring WireGuard mesh..."
  local wg_base
  [[ "$site" == "blue" ]] && wg_base="10.252.0" || wg_base="10.253.0"

  # Phase 1: Generate WireGuard keypairs and collect public keys from all VMs
  declare -A wg_ips=()
  declare -A wg_pubs=()
  local node_id=1
  for distro in "${DISTROS[@]}"; do
    local sname
    sname="$(site_name "$site" "$distro")"
    virsh domstate "$sname" 2>/dev/null | grep -q running || continue
    local ip
    ip="$(get_vm_ip "$sname")"
    [[ -z "$ip" ]] && continue

    # Check if WireGuard is available
    _ssh_cmd "$ip" "command -v wg >/dev/null 2>&1" 2>/dev/null || continue

    # Generate WireGuard config
    _ssh_cmd "$ip" bash -s <<WGINIT 2>/dev/null || true
mkdir -p /etc/wireguard
wg genkey > /etc/wireguard/lab.key 2>/dev/null
chmod 600 /etc/wireguard/lab.key
wg pubkey < /etc/wireguard/lab.key > /etc/wireguard/lab.pub 2>/dev/null

cat > /etc/wireguard/wg-lab.conf <<WG
[Interface]
PrivateKey = \$(cat /etc/wireguard/lab.key)
Address = ${wg_base}.${node_id}/24
ListenPort = 51830
WG
WGINIT

    local pub
    pub="$(_ssh_cmd "$ip" 'cat /etc/wireguard/lab.pub 2>/dev/null')"
    if [[ -n "$pub" ]]; then
      wg_ips[$distro]="$ip"
      wg_pubs[$distro]="$pub"
      echo -e "  ${G}${sname}${N} → ${wg_base}.${node_id} (wg-lab)"
    fi
    ((node_id++))
  done

  # Phase 2: Peer all VMs with each other (full mesh topology).
  # Every VM gets a peer entry for every other VM. This is O(n^2) but with
  # only 6 VMs it is 30 peer entries total — trivial. Full mesh means any
  # VM can directly reach any other VM without routing through a hub.
  node_id=1
  for distro_a in "${DISTROS[@]}"; do
    [[ -z "${wg_ips[$distro_a]:-}" ]] && { ((node_id++)); continue; }
    local peer_id=1
    for distro_b in "${DISTROS[@]}"; do
      [[ -z "${wg_ips[$distro_b]:-}" ]] && { ((peer_id++)); continue; }
      [[ "$distro_a" == "$distro_b" ]] && { ((peer_id++)); continue; }
      _ssh_cmd "${wg_ips[$distro_a]}" bash -s <<WGPEER 2>/dev/null || true
wg set wg-lab peer ${wg_pubs[$distro_b]} \
  allowed-ips ${wg_base}.${peer_id}/32 \
  endpoint ${wg_ips[$distro_b]}:51830 \
  persistent-keepalive 25
WGPEER
      ((peer_id++))
    done

    # Bring up interface
    _ssh_cmd "${wg_ips[$distro_a]}" "ip link add dev wg-lab type wireguard 2>/dev/null; wg setconf wg-lab /etc/wireguard/wg-lab.conf 2>/dev/null; ip addr add ${wg_base}.${node_id}/24 dev wg-lab 2>/dev/null; ip link set wg-lab up 2>/dev/null" || true
    ((node_id++))
  done

  # Allow WireGuard traffic (UDP 51830) and all wg-lab interface traffic
  # through nftables. Without this, distros with default-deny policies
  # (like Fedora) would block the WireGuard mesh.
  for distro in "${DISTROS[@]}"; do
    [[ -z "${wg_ips[$distro]:-}" ]] && continue
    _ssh_cmd "${wg_ips[$distro]}" bash -s <<'NFTRULES' 2>/dev/null || true
nft add table inet filter 2>/dev/null || true
nft add chain inet filter input '{ type filter hook input priority 0; policy accept; }' 2>/dev/null || true
nft add rule inet filter input iifname "wg-lab" accept 2>/dev/null || true
nft add rule inet filter input udp dport 51830 accept 2>/dev/null || true
NFTRULES
  done

  log "WireGuard mesh configured for ${site} site (${wg_base}.0/24)"

  # ── Deploy observability VM ────────────────────────────────────────────
  # The obs VM is always cloned from the CentOS golden image. CentOS was
  # chosen because it is the most stable platform for long-running infra
  # services — same base as RHEL, no rolling updates that could break
  # Prometheus/Grafana during a multi-day test run.
  echo ""
  log "Deploying observability VM..."
  local obs_sname="${LAB_PREFIX}-${site}-obs"
  local obs_gname="${LAB_PREFIX}-golden-centos"
  local obs_gpath="${POOL}/vms/${obs_gname}"
  local obs_spath="${POOL}/vms/${obs_sname}"
  local obs_sdev="/dev/zvol/${obs_spath}"
  local obs_ip=""

  if zfs list "${obs_gpath}@golden" >/dev/null 2>&1 && ! zfs list "${obs_spath}" >/dev/null 2>&1; then
    zfs clone "${obs_gpath}@golden" "${obs_spath}"
    for _ in $(seq 1 10); do [[ -b "$obs_sdev" ]] && break; sleep 1; done

    local obs_ci
    obs_ci="$(make_cloud_init_iso "${obs_sname}" "${site}-obs" "")"

    virt-install \
      --name "${obs_sname}" \
      --ram "$RAM" --vcpus "$CPUS" \
      --os-variant centos-stream9 \
      --disk "source.dev=${obs_sdev},type=block,bus=virtio,cache=none" \
      --disk "path=${obs_ci},device=cdrom" \
      --network bridge=virbr0,model=virtio \
      --graphics vnc,listen=0.0.0.0 \
      --noautoconsole \
      --import 2>&1 || warn "Failed to boot obs VM"

    echo -e "  ${G}${obs_sname}${N} started"
    sleep 20

    obs_ip="$(get_vm_ip "${obs_sname}")"
    if [[ -n "$obs_ip" ]] && wait_for_ssh "$obs_ip" 30; then
      _ssh_cmd "$obs_ip" "hostnamectl set-hostname ${site}-obs; systemd-machine-id-setup 2>/dev/null" || true

      # WireGuard on obs VM
      local obs_node_id=$(( ${#DISTROS[@]} + 1 ))
      _ssh_cmd "$obs_ip" bash -s <<OBSWG 2>/dev/null || true
mkdir -p /etc/wireguard
wg genkey > /etc/wireguard/lab.key 2>/dev/null
chmod 600 /etc/wireguard/lab.key
wg pubkey < /etc/wireguard/lab.key > /etc/wireguard/lab.pub 2>/dev/null
cat > /etc/wireguard/wg-lab.conf <<WG
[Interface]
PrivateKey = \$(cat /etc/wireguard/lab.key)
Address = ${wg_base}.${obs_node_id}/24
ListenPort = 51830
WG
ip link add dev wg-lab type wireguard 2>/dev/null
wg setconf wg-lab /etc/wireguard/wg-lab.conf 2>/dev/null
ip addr add ${wg_base}.${obs_node_id}/24 dev wg-lab 2>/dev/null
ip link set wg-lab up 2>/dev/null
OBSWG

      # Setup observability stack
      setup_obs_vm "$obs_ip" "$site"

      # Point all VMs' telemetry at the obs VM. This runs in parallel (&)
      # because each VM's setup is independent — cuts total time from ~6x to ~1x.
      log "Configuring telemetry on all VMs → obs (${obs_ip})..."
      for distro in "${DISTROS[@]}"; do
        local sname
        sname="$(site_name "$site" "$distro")"
        local vm_ip
        vm_ip="$(get_vm_ip "$sname" 2>/dev/null)"
        [[ -z "$vm_ip" ]] && continue
        setup_vm_telemetry "$vm_ip" "$obs_ip" 2>/dev/null &
      done
      wait  # parallel telemetry setup
      log "All VMs reporting to observability stack"
    else
      warn "Obs VM not reachable — observability stack skipped"
    fi
  elif ! zfs list "${obs_gpath}@golden" >/dev/null 2>&1; then
    warn "No CentOS golden image — build centos first for observability VM"
  else
    warn "Obs VM ${obs_sname} already exists"
  fi

  local total_elapsed
  total_elapsed="$(timer_elapsed_ms "$total_start")"
  echo ""
  log "Deploy complete: ${G}${deployed} deployed${N}, ${Y}${skipped} skipped${N} (${total_elapsed}ms)"
  echo ""
  echo -e "  ${W}WireGuard:${N}    ${wg_base}.0/24 (wg-lab interface)"
  echo -e "  ${W}SSH:${N}          ssh root@<vm-ip> (password: kldload)"
  echo -e "  ${W}Mesh:${N}         every VM can reach every other VM encrypted"
  if [[ -n "$obs_ip" ]]; then
    echo -e "  ${W}Grafana:${N}      ${G}http://${obs_ip}:3000${N}  (admin/admin)"
    echo -e "  ${W}Prometheus:${N}   ${G}http://${obs_ip}:9090${N}"
    echo -e "  ${W}Loki:${N}         ${G}http://${obs_ip}:3100${N}"
    echo -e "  ${W}Alertmanager:${N} ${G}http://${obs_ip}:9093${N}"
  fi
}

# ── Promote Green to Blue ────────────────────────────────────────────────
# The blue-green promotion workflow:
#   1. Snapshot the current blue site (safety net for rollback)
#   2. Destroy the blue VMs (but the pre-promote snapshot preserves the data)
#   3. Snapshot green, clone green -> new blue (instant ZFS clone)
#   4. Destroy green (its data lives on in the blue clone)
#   5. Boot the new blue site
# The entire swap is near-instant because ZFS clones are metadata-only
# operations — no data is physically copied.
cmd_promote() {
  local site="${1:-green}"
  [[ "$site" == "green" ]] || die "Can only promote green to blue"

  log "Promoting green -> blue"

  # Snapshot current blue before destroying — this is the rollback point.
  # If the promoted green turns out to be broken, cmd_rollback can revert
  # blue to this pre-promote snapshot.
  local ts
  ts="$(date +%Y%m%d-%H%M%S)"
  local had_blue=false

  for distro in "${DISTROS[@]}"; do
    local bname
    bname="$(site_name blue "$distro")"
    local bpath
    bpath="$(zvol_path "$bname")"
    if zfs list "$bpath" >/dev/null 2>&1; then
      had_blue=true
      log "  Snapshotting ${bname}@pre-promote-${ts}"
      zfs snapshot "${bpath}@pre-promote-${ts}" 2>/dev/null || true
    fi
  done

  # Destroy blue VMs
  if $had_blue; then
    log "  Tearing down blue site..."
    destroy_site "blue" quiet
  fi

  # Snapshot green, clone to blue, destroy green
  for distro in "${DISTROS[@]}"; do
    local gname
    gname="$(site_name green "$distro")"
    local gpath
    gpath="$(zvol_path "$gname")"
    local bname
    bname="$(site_name blue "$distro")"
    local bpath
    bpath="$(zvol_path "$bname")"

    if ! zfs list "$gpath" >/dev/null 2>&1; then
      continue
    fi

    # Shutdown green VM
    virsh destroy "$gname" 2>/dev/null || true
    virsh undefine "$gname" --nvram 2>/dev/null || virsh undefine "$gname" 2>/dev/null || true

    # Snapshot green, clone to blue
    zfs snapshot "${gpath}@promoted-${ts}" 2>/dev/null || true
    echo -ne "  ${gname} -> ${bname} ... "
    local cs
    cs="$(timer_start)"
    zfs clone "${gpath}@promoted-${ts}" "$bpath"
    local ce
    ce="$(timer_elapsed_ms "$cs")"
    echo -e "${G}done${N} (${C}${ce}ms${N})"

    # Destroy green
    zfs destroy -Rf "$gpath" 2>/dev/null || true
    rm -f "${ISO_DIR}/${gname}-cloud-init.iso" 2>/dev/null
  done

  # Boot new blue site
  log "Booting new blue site..."
  deploy_site "blue"
}

# ── Rollback Blue ────────────────────────────────────────────────────────
# Reverts the blue site to its most recent snapshot (typically the pre-promote
# snapshot from cmd_promote). ZFS rollback is instant — it discards all
# changes since the snapshot by rewinding the block pointer tree.
# After rollback, the site is redeployed (VMs booted from the reverted zvols).
cmd_rollback() {
  log "Rolling back blue site to previous snapshot..."

  for distro in "${DISTROS[@]}"; do
    local bname
    bname="$(site_name blue "$distro")"
    local bpath
    bpath="$(zvol_path "$bname")"

    if ! zfs list "$bpath" >/dev/null 2>&1; then
      continue
    fi

    # Find latest snapshot
    local snap
    snap="$(zfs list -t snapshot -o name -s creation -r "$bpath" 2>/dev/null | tail -1)"
    if [[ -z "$snap" || "$snap" == "NAME" ]]; then
      warn "No snapshots for ${bname}"
      continue
    fi

    # Shutdown and destroy VM
    virsh destroy "$bname" 2>/dev/null || true
    virsh undefine "$bname" --nvram 2>/dev/null || virsh undefine "$bname" 2>/dev/null || true

    # Rollback
    log "  Rolling back ${bname} to ${snap}"
    zfs rollback -r "$snap"
  done

  # Redeploy blue
  log "Redeploying blue site from rolled-back snapshots..."
  deploy_site "blue"
}

# ── Test ─────────────────────────────────────────────────────────────────
# Quick ZFS smoke test that verifies the core ZFS operations work on a VM:
# pool creation, dataset I/O, snapshots, clones, COW semantics, and compression.
# Uses a loopback file pool (truncate -s 1G) so it does not need extra disks.
# This is the fast validation path (~10 seconds); run_zfs_test_suite runs the
# full OpenZFS test suite which can take hours.
run_test_single() {
  local distro="$1" site="${2:-blue}"

  # Find running VM
  local sname
  sname="$(site_name "$site" "$distro")"
  local ip
  ip="$(get_vm_ip "$sname" 2>/dev/null)"
  [[ -n "$ip" ]] || { warn "Cannot get IP for ${sname} -- is it running?"; return 1; }

  log "Running ZFS tests on ${C}${sname}${N} (${ip})..."
  local t_start
  t_start="$(timer_start)"

  _ssh_cmd "$ip" bash -s <<'TESTSCRIPT'
set -e
echo "=== ZFS Quick Test ==="

# Check ZFS module
if ! lsmod | grep -q zfs; then
  modprobe zfs 2>/dev/null || { echo "FAIL: Cannot load ZFS module"; exit 1; }
fi
echo "PASS: ZFS module loaded"
zfs version

# Create test pool
TESTPOOL="testpool-$$"
TESTFILE="/tmp/zfs-test-$$.img"
truncate -s 1G "$TESTFILE"
zpool create "$TESTPOOL" "$TESTFILE" || { echo "FAIL: Cannot create pool"; exit 1; }
echo "PASS: Pool created"

# Create dataset
zfs create "${TESTPOOL}/data"
echo "test data" > "/${TESTPOOL}/data/test.txt"
echo "PASS: Dataset created and writable"

# Snapshot
zfs snapshot "${TESTPOOL}/data@snap1"
echo "PASS: Snapshot created"

# Clone
zfs clone "${TESTPOOL}/data@snap1" "${TESTPOOL}/clone1"
cat "/${TESTPOOL}/clone1/test.txt" | grep -q "test data"
echo "PASS: Clone readable"

# Modify clone (COW test)
echo "modified" > "/${TESTPOOL}/clone1/test.txt"
cat "/${TESTPOOL}/data/test.txt" | grep -q "test data"
echo "PASS: COW works (original unchanged)"

# Compression check
zfs get compression "${TESTPOOL}/data" | grep -q "lz4\|on"
echo "PASS: Compression enabled"

# Cleanup
zpool destroy "$TESTPOOL"
rm -f "$TESTFILE"
echo ""
echo "=== All quick tests passed ==="
TESTSCRIPT

  local elapsed
  elapsed="$(timer_elapsed_ms "$t_start")"
  log "Tests complete on ${sname} (${elapsed}ms)"
}

# Run the full OpenZFS test suite (zfs-tests.sh) from /usr/src/zfs.
# This builds OpenZFS from source if not already built, then runs the
# official test suite. Can take 1-4 hours depending on hardware.
# The test suite exercises thousands of edge cases across all ZFS subsystems.
run_zfs_test_suite() {
  local distro="$1" site="${2:-blue}"

  local sname
  sname="$(site_name "$site" "$distro")"
  local ip
  ip="$(get_vm_ip "$sname" 2>/dev/null)"
  [[ -n "$ip" ]] || { warn "Cannot get IP for ${sname}"; return 1; }

  log "Running zfs-tests.sh on ${C}${sname}${N} (${ip}) -- this takes a while..."

  _ssh_cmd "$ip" bash -s <<'FULLTEST'
cd /usr/src/zfs 2>/dev/null || { echo "OpenZFS source not found at /usr/src/zfs"; exit 1; }

# Build if not already built
if [[ ! -f ./configure ]]; then
  echo "Building OpenZFS from source..."
  sh autogen.sh
  ./configure --with-config=user
  make -j$(nproc)
fi

# Run the test suite
echo "Running ZFS test suite..."
scripts/zfs-tests.sh -vx 2>&1 | tail -50
FULLTEST
}

# Run quick tests across all distros in a site, producing a matrix showing
# pass/fail status and elapsed time per distro. This is the primary
# cross-distro validation tool — it shows whether ZFS works identically
# on all 6 distros in a single view.
run_test_all() {
  local site="${1:-blue}"
  local passed=0 failed=0

  echo -e "${C}======================================================================${N}"
  echo -e "${W}  ZFS Test Matrix -- ${site} site                                      ${N}"
  echo -e "${C}======================================================================${N}"
  echo ""

  printf "  ${W}%-15s %-12s %-10s %s${N}\n" "Distro" "Status" "Time" "Details"
  printf "  %-15s %-12s %-10s %s\n" "---------------" "------------" "----------" "--------"

  for distro in "${DISTROS[@]}"; do
    local sname
    sname="$(site_name "$site" "$distro")"
    if ! virsh domstate "$sname" 2>/dev/null | grep -q "running"; then
      printf "  %-15s ${Y}%-12s${N}\n" "$distro" "not running"
      continue
    fi

    local t_start
    t_start="$(timer_start)"
    local output
    if output="$(run_test_single "$distro" "$site" 2>&1)"; then
      local elapsed
      elapsed="$(timer_elapsed_ms "$t_start")"
      printf "  %-15s ${G}%-12s${N} %-10s %s\n" "$distro" "PASS" "${elapsed}ms" ""
      ((passed++))
    else
      local elapsed
      elapsed="$(timer_elapsed_ms "$t_start")"
      printf "  %-15s ${R}%-12s${N} %-10s %s\n" "$distro" "FAIL" "${elapsed}ms" ""
      ((failed++))
    fi
  done

  echo ""
  log "Test results: ${G}${passed} passed${N}, ${R}${failed} failed${N}"
}

# ── Destroy ──────────────────────────────────────────────────────────────
# Tear down all VMs in a site. Uses zfs destroy -Rf to recursively destroy
# the zvol and all its snapshots/clones. The golden images are intentionally
# preserved — they are expensive to rebuild (download + install + seal).
destroy_site() {
  local site="$1"
  local quiet="${2:-}"

  for distro in "${DISTROS[@]}"; do
    local sname
    sname="$(site_name "$site" "$distro")"
    local spath
    spath="$(zvol_path "$sname")"

    virsh destroy "$sname" 2>/dev/null || true
    virsh undefine "$sname" --nvram 2>/dev/null || virsh undefine "$sname" 2>/dev/null || true
    zfs destroy -Rf "$spath" 2>/dev/null || true
    rm -f "${ISO_DIR}/${sname}-cloud-init.iso" 2>/dev/null
  done

  [[ -n "$quiet" ]] || log "Site ${site} destroyed"
}

destroy_goldens() {
  for distro in "${DISTROS[@]}"; do
    local gname
    gname="$(golden_name "$distro")"
    local gpath
    gpath="$(zvol_path "$gname")"

    virsh destroy "$gname" 2>/dev/null || true
    virsh undefine "$gname" --nvram 2>/dev/null || virsh undefine "$gname" 2>/dev/null || true
    zfs destroy -Rf "$gpath" 2>/dev/null || true
    rm -f "${ISO_DIR}/${gname}-cloud-init.iso" 2>/dev/null
    rm -f "${ISO_DIR}/${distro}-cloud.qcow2" 2>/dev/null
  done
  log "All golden images destroyed"
}

cmd_destroy() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "Usage: kzfs-lab destroy blue|green|all"

  case "$target" in
    blue|green)
      echo -e "${R}WARNING: This will destroy the ${target} site (all ${#DISTROS[@]} VMs)${N}"
      read -r -p "Type 'destroy' to continue: " confirm
      [[ "$confirm" == "destroy" ]] || { echo "Aborted."; exit 0; }
      destroy_site "$target"
      ;;
    all)
      echo -e "${R}WARNING: This will destroy ALL lab VMs (blue + green sites)${N}"
      echo -e "${R}Golden images will be preserved.${N}"
      read -r -p "Type 'destroy' to continue: " confirm
      [[ "$confirm" == "destroy" ]] || { echo "Aborted."; exit 0; }
      destroy_site "blue"
      destroy_site "green"
      log "All sites destroyed. Goldens preserved."
      log "To also destroy goldens: zfs destroy -Rf ${POOL}/vms/${LAB_PREFIX}-golden-*"
      ;;
    goldens)
      echo -e "${R}WARNING: This will destroy ALL golden images and site VMs${N}"
      read -r -p "Type 'destroy' to continue: " confirm
      [[ "$confirm" == "destroy" ]] || { echo "Aborted."; exit 0; }
      destroy_site "blue"
      destroy_site "green"
      destroy_goldens
      ;;
    *)
      die "Unknown target: ${target}. Use blue, green, all, or goldens."
      ;;
  esac
}

# ── Status ───────────────────────────────────────────────────────────────
cmd_status() {
  echo -e "${C}======================================================================${N}"
  echo -e "${W}  kzfs-lab Status                                                      ${N}"
  echo -e "${C}======================================================================${N}"
  echo ""

  # Golden images
  echo -e "${Y}Golden Images:${N}"
  printf "  ${W}%-15s %-10s %-12s %s${N}\n" "Distro" "Status" "Size" "Snapshots"
  printf "  %-15s %-10s %-12s %s\n" "---------------" "----------" "------------" "---------"

  for distro in "${DISTROS[@]}"; do
    local gname
    gname="$(golden_name "$distro")"
    local gpath
    gpath="$(zvol_path "$gname")"

    if zfs list "$gpath" >/dev/null 2>&1; then
      local used
      used="$(zfs get -H -o value used "$gpath")"
      local snaps
      snaps="$(zfs list -t snapshot -o name -r "$gpath" 2>/dev/null | grep -v NAME | wc -l)"
      printf "  %-15s ${G}%-10s${N} %-12s %s\n" "$distro" "ready" "$used" "${snaps} snap(s)"
    else
      printf "  %-15s ${D}%-10s${N}\n" "$distro" "not built"
    fi
  done

  # Blue site
  echo ""
  echo -e "${Y}Blue Site:${N}"
  print_site_status "blue"

  # Green site
  echo ""
  echo -e "${Y}Green Site:${N}"
  print_site_status "green"

  # ZFS pool summary
  echo ""
  echo -e "${Y}ZFS Summary:${N}"
  zfs list -o name,used,refer,volsize -r "${POOL}/vms" -t volume 2>/dev/null \
    | grep -E "${LAB_PREFIX}|NAME" || echo "  No lab zvols"

  echo ""
  echo -e "${C}======================================================================${N}"
}

print_site_status() {
  local site="$1"
  local count=0

  printf "  ${W}%-25s %-16s %-10s %-10s %s${N}\n" "VM" "IP" "State" "SSH" "ZFS"
  printf "  %-25s %-16s %-10s %-10s %s\n" "-------------------------" "----------------" "----------" "----------" "---"

  for distro in "${DISTROS[@]}"; do
    local sname
    sname="$(site_name "$site" "$distro")"
    local spath
    spath="$(zvol_path "$sname")"

    if ! zfs list "$spath" >/dev/null 2>&1; then
      continue
    fi

    ((count++))
    local state
    state="$(virsh domstate "$sname" 2>/dev/null | head -1)" || state="undefined"

    if [[ "$state" == "running" ]]; then
      local ip
      ip="$(get_vm_ip "$sname" 2>/dev/null)" || ip=""
      local ssh_ok="--"
      local zfs_ver="--"
      if [[ -n "$ip" ]]; then
        if _ssh_cmd "$ip" true 2>/dev/null; then
          ssh_ok="ok"
          zfs_ver="$(_ssh_cmd "$ip" "zfs version 2>/dev/null | head -1" 2>/dev/null || echo "n/a")"
        fi
      fi
      printf "  ${G}%-25s${N} %-16s ${G}%-10s${N} %-10s %s\n" "$sname" "${ip:-no IP}" "$state" "$ssh_ok" "$zfs_ver"
    else
      printf "  ${D}%-25s${N} %-16s ${Y}%-10s${N}\n" "$sname" "--" "$state"
    fi
  done

  if [[ $count -eq 0 ]]; then
    echo "  (not deployed)"
  fi
}

# ── Snapshot All ─────────────────────────────────────────────────────────
# Create a tagged, timestamped snapshot on every lab VM across both sites.
# Useful as a checkpoint before making changes — ZFS snapshots are instant
# and consume no space until data diverges from the snapshot point.
cmd_snapshot_all() {
  local tag="${1:-checkpoint}"
  local ts
  ts="$(date +%Y%m%d-%H%M%S)"
  local snap_name="${tag}-${ts}"

  log "Creating snapshot @${snap_name} on all lab VMs..."

  local count=0
  for site in blue green; do
    for distro in "${DISTROS[@]}"; do
      local sname
      sname="$(site_name "$site" "$distro")"
      local spath
      spath="$(zvol_path "$sname")"

      if zfs list "$spath" >/dev/null 2>&1; then
        zfs snapshot "${spath}@${snap_name}"
        echo -e "  ${G}${spath}@${snap_name}${N}"
        ((count++))
      fi
    done
  done

  log "Created ${count} snapshots tagged @${snap_name}"
}

# ── eBPF Observability ───────────────────────────────────────────────────
# eBPF-based ZFS tracing — runs bpftrace one-liners on each VM to collect
# kernel-level I/O statistics without modifying ZFS or adding overhead.
# These complement the Prometheus metrics (which are userspace) with
# kernel-level tracepoint data.
cmd_ebpf_latency() {
  local site="${1:-blue}"
  log "ZFS I/O latency heatmap across ${site} site (Ctrl+C to stop)..."
  echo ""

  for distro in "${DISTROS[@]}"; do
    local sname
    sname="$(site_name "$site" "$distro")"
    local ip
    ip="$(get_vm_ip "$sname" 2>/dev/null)" || continue
    [[ -n "$ip" ]] || continue

    echo -e "${C}--- ${sname} (${ip}) ---${N}"
    _ssh_cmd "$ip" "timeout 5 bpftrace -e 'tracepoint:block:block_rq_complete { @usecs = hist(args->nr_sector); }' 2>/dev/null" || \
      echo "  bpftrace not available or ZFS tracepoints not loaded"
    echo ""
  done
}

# Read ZFS ARC (Adaptive Replacement Cache) statistics from /proc/spl/kstat.
# ARC hit ratio is the single most important ZFS performance metric — a high
# ratio means most reads are served from RAM, avoiding disk I/O entirely.
cmd_ebpf_arc() {
  local site="${1:-blue}"
  log "ARC hit/miss ratios across ${site} site..."
  echo ""

  for distro in "${DISTROS[@]}"; do
    local sname
    sname="$(site_name "$site" "$distro")"
    local ip
    ip="$(get_vm_ip "$sname" 2>/dev/null)" || continue
    [[ -n "$ip" ]] || continue

    echo -e "${C}--- ${sname} (${ip}) ---${N}"
    _ssh_cmd "$ip" bash -s <<'ARCSTATS'
if [[ -f /proc/spl/kstat/zfs/arcstats ]]; then
  hits=$(awk '/^hits/ {print $3}' /proc/spl/kstat/zfs/arcstats)
  misses=$(awk '/^misses/ {print $3}' /proc/spl/kstat/zfs/arcstats)
  total=$((hits + misses))
  if [[ $total -gt 0 ]]; then
    ratio=$(echo "scale=2; $hits * 100 / $total" | bc 2>/dev/null || echo "N/A")
    echo "  Hits: $hits  Misses: $misses  Hit ratio: ${ratio}%"
  else
    echo "  No ARC activity yet"
  fi
  arc_size=$(awk '/^size/ {print $3}' /proc/spl/kstat/zfs/arcstats)
  echo "  ARC size: $(echo "scale=2; $arc_size / 1048576" | bc 2>/dev/null || echo "N/A") MB"
else
  echo "  ZFS ARC stats not available"
fi
ARCSTATS
    echo ""
  done
}

# ── Health Dashboard ─────────────────────────────────────────────────────
# CLI health overview — SSH into each VM and collect CPU, memory, load,
# disk usage, ZFS module status, and uptime. Provides a quick terminal-based
# alternative to the Grafana dashboard when you just need a glance.
cmd_health() {
  local site="${1:-blue}"

  echo -e "${C}======================================================================${N}"
  echo -e "${W}  System Health Dashboard -- ${site} site                               ${N}"
  echo -e "${C}======================================================================${N}"
  echo ""

  printf "  ${W}%-15s %-8s %-8s %-8s %-10s %-10s %s${N}\n" \
    "Distro" "CPU%" "Mem%" "Load" "Disk" "ZFS" "Uptime"
  printf "  %-15s %-8s %-8s %-8s %-10s %-10s %s\n" \
    "---------------" "--------" "--------" "--------" "----------" "----------" "------"

  for distro in "${DISTROS[@]}"; do
    local sname
    sname="$(site_name "$site" "$distro")"
    local ip
    ip="$(get_vm_ip "$sname" 2>/dev/null)" || continue
    [[ -n "$ip" ]] || continue

    if ! _ssh_cmd "$ip" true 2>/dev/null; then
      printf "  %-15s ${R}unreachable${N}\n" "$distro"
      continue
    fi

    local stats
    stats="$(_ssh_cmd "$ip" bash -s <<'STATS'
cpu=$(top -bn1 2>/dev/null | grep "Cpu(s)" | awk '{printf "%.0f", $2+$4}' || echo "?")
mem=$(free 2>/dev/null | awk '/Mem:/ {printf "%.0f", $3/$2*100}' || echo "?")
load=$(cat /proc/loadavg 2>/dev/null | awk '{print $1}' || echo "?")
disk=$(df / 2>/dev/null | awk 'NR==2 {print $5}' || echo "?")
zfs_ok="no"
lsmod 2>/dev/null | grep -q zfs && zfs_ok="yes"
uptime=$(uptime -p 2>/dev/null | sed 's/up //' || echo "?")
echo "${cpu}|${mem}|${load}|${disk}|${zfs_ok}|${uptime}"
STATS
    )"

    IFS='|' read -r cpu mem load disk zfs_ok uptime <<< "$stats"
    local zfs_color="${G}"
    [[ "$zfs_ok" == "yes" ]] || zfs_color="${R}"

    printf "  %-15s %-8s %-8s %-8s %-10s ${zfs_color}%-10s${N} %s\n" \
      "$distro" "${cpu}%" "${mem}%" "$load" "$disk" "$zfs_ok" "$uptime"
  done
  echo ""
}

# ── SSH into VM ──────────────────────────────────────────────────────────
cmd_ssh_select() {
  echo -e "${W}Select a VM to SSH into:${N}"
  echo ""

  local vms=()
  local ips=()
  local idx=1

  for site in blue green; do
    for distro in "${DISTROS[@]}"; do
      local sname
      sname="$(site_name "$site" "$distro")"
      if virsh domstate "$sname" 2>/dev/null | grep -q "running"; then
        local ip
        ip="$(get_vm_ip "$sname" 2>/dev/null)" || ip=""
        if [[ -n "$ip" ]]; then
          vms+=("$sname")
          ips+=("$ip")
          printf "  ${G}%2d${N}  %-30s %s\n" "$idx" "$sname" "$ip"
          ((idx++))
        fi
      fi
    done
  done

  if [[ ${#vms[@]} -eq 0 ]]; then
    warn "No running VMs found"
    return 1
  fi

  echo ""
  read -r -p "Enter number (or q to quit): " choice
  [[ "$choice" == "q" ]] && return 0

  local sel=$((choice - 1))
  if [[ $sel -ge 0 && $sel -lt ${#vms[@]} ]]; then
    log "Connecting to ${vms[$sel]} (${ips[$sel]})..."
    ssh -o StrictHostKeyChecking=no -i "$SSH_KEY" "root@${ips[$sel]}" \
      || sshpass -p kldload ssh -o StrictHostKeyChecking=no "root@${ips[$sel]}"
  else
    warn "Invalid selection"
  fi
}

# ── Interactive Demo Menu ────────────────────────────────────────────────
# TUI menu for the full blue-green ZFS lab workflow. Designed for live demos
# where you walk through: build goldens -> deploy blue -> test -> deploy green
# -> test green -> promote -> rollback. Each step shows timing to demonstrate
# ZFS clone performance.
cmd_demo() {
  while true; do
    # Count available goldens and running VMs
    local golden_count=0 blue_count=0 green_count=0
    for distro in "${DISTROS[@]}"; do
      golden_exists "$distro" && ((golden_count++))
      virsh domstate "$(site_name blue "$distro")" 2>/dev/null | grep -q "running" && ((blue_count++))
      virsh domstate "$(site_name green "$distro")" 2>/dev/null | grep -q "running" && ((green_count++))
    done

    echo ""
    echo -e "${C}======================================================================${N}"
    echo -e "${W}   kldload -- ZFS Dev Lab                                              ${N}"
    echo -e "${W}   ${#DISTROS[@]} distros | eBPF | dev tools | blue-green | instant rollback     ${N}"
    echo -e "${C}======================================================================${N}"
    echo ""
    echo -e "   Goldens: ${G}${golden_count}/${#DISTROS[@]}${N}  Blue: ${G}${blue_count}${N}  Green: ${G}${green_count}${N}"
    echo ""
    echo -e "  ${Y}-- Build -------------------------------------------------------${N}"
    echo -e "   ${W} 1${N}  Build all golden images (downloads + installs)"
    echo -e "   ${W} 2${N}  Build single golden (select distro)"
    echo ""
    echo -e "  ${Y}-- Deploy ------------------------------------------------------${N}"
    echo -e "   ${W} 3${N}  Deploy blue site (production baseline)"
    echo -e "   ${W} 4${N}  Deploy green site (staging)"
    echo -e "   ${W} 5${N}  Status -- all VMs, sites, snapshots"
    echo ""
    echo -e "  ${Y}-- Test --------------------------------------------------------${N}"
    echo -e "   ${W} 6${N}  Run ZFS test suite -- all distros (matrix output)"
    echo -e "   ${W} 7${N}  Run ZFS test suite -- single distro"
    echo -e "   ${W} 8${N}  Run quick test (pool create/destroy/snap/clone)"
    echo ""
    echo -e "  ${Y}-- Operations --------------------------------------------------${N}"
    echo -e "   ${W} 9${N}  Promote green -> blue"
    echo -e "   ${W}10${N}  Rollback blue to previous"
    echo -e "   ${W}11${N}  Snapshot all VMs (tagged checkpoint)"
    echo -e "   ${W}12${N}  SSH into a VM (select distro + site)"
    echo ""
    echo -e "  ${Y}-- Observability -----------------------------------------------${N}"
    echo -e "   ${W}13${N}  eBPF: ZFS I/O latency (all VMs)"
    echo -e "   ${W}14${N}  eBPF: ARC hit/miss ratios"
    echo -e "   ${W}15${N}  System health dashboard"
    echo ""
    echo -e "  ${Y}-- Cleanup -----------------------------------------------------${N}"
    echo -e "   ${W} 0${N}  Destroy everything (goldens preserved)"
    echo -e "   ${W} q${N}  Quit"
    echo ""
    read -r -p "  Select: " choice

    case "$choice" in
      1)
        build_all_goldens
        ;;
      2)
        echo ""
        echo -e "  Available distros: ${DISTROS[*]}"
        read -r -p "  Distro: " d
        build_golden_single "$d"
        ;;
      3)
        deploy_site "blue"
        ;;
      4)
        deploy_site "green"
        ;;
      5)
        cmd_status
        ;;
      6)
        echo ""
        read -r -p "  Site (blue/green) [blue]: " s
        run_test_all "${s:-blue}"
        ;;
      7)
        echo ""
        echo -e "  Available distros: ${DISTROS[*]}"
        read -r -p "  Distro: " d
        read -r -p "  Site (blue/green) [blue]: " s
        run_zfs_test_suite "$d" "${s:-blue}"
        ;;
      8)
        echo ""
        echo -e "  Available distros: ${DISTROS[*]}"
        read -r -p "  Distro (or 'all'): " d
        read -r -p "  Site (blue/green) [blue]: " s
        if [[ "$d" == "all" ]]; then
          run_test_all "${s:-blue}"
        else
          run_test_single "$d" "${s:-blue}"
        fi
        ;;
      9)
        cmd_promote "green"
        ;;
      10)
        cmd_rollback
        ;;
      11)
        echo ""
        read -r -p "  Tag name [checkpoint]: " tag
        cmd_snapshot_all "${tag:-checkpoint}"
        ;;
      12)
        cmd_ssh_select
        ;;
      13)
        echo ""
        read -r -p "  Site (blue/green) [blue]: " s
        cmd_ebpf_latency "${s:-blue}"
        ;;
      14)
        echo ""
        read -r -p "  Site (blue/green) [blue]: " s
        cmd_ebpf_arc "${s:-blue}"
        ;;
      15)
        echo ""
        read -r -p "  Site (blue/green) [blue]: " s
        cmd_health "${s:-blue}"
        ;;
      0)
        cmd_destroy "all"
        ;;
      q|Q)
        echo "Goodbye."
        exit 0
        ;;
      *)
        warn "Invalid selection"
        ;;
    esac
  done
}

# ── Usage ────────────────────────────────────────────────────────────────
usage() {
  cat <<'EOF'
Usage: kzfs-lab <command> [options]

Commands:
  build [distro|all]       Build golden images (downloads cloud images + installs ZFS dev tools)
  deploy blue|green        Clone goldens to blue or green site
  promote green            Promote green to blue (snapshots blue first)
  rollback                 Revert blue site to previous snapshot
  test [distro|all]        Run ZFS tests in VMs
  test-full [distro]       Run full zfs-tests.sh suite (slow)
  status                   Show all VMs, sites, snapshots
  destroy blue|green|all   Tear down VMs (goldens preserved unless 'goldens' target)
  snapshot [tag]           Snapshot all VMs with a tag
  ssh                      SSH into a VM (interactive selection)
  health [site]            System health dashboard
  ebpf-latency [site]      eBPF I/O latency across VMs
  ebpf-arc [site]          eBPF ARC hit/miss ratios
  demo                     Interactive menu

Distros: centos rocky fedora debian ubuntu arch

Examples:
  kzfs-lab build all                  # Build all 6 golden images
  kzfs-lab build centos               # Build just CentOS golden
  kzfs-lab deploy blue                # Clone goldens -> blue site
  kzfs-lab deploy green               # Clone goldens -> green site (staging)
  kzfs-lab test all                   # Quick ZFS test on all blue VMs
  kzfs-lab promote green              # Green becomes new blue
  kzfs-lab rollback                   # Revert blue to last snapshot
  kzfs-lab demo                       # Interactive menu
  kzfs-lab destroy all                # Tear down all sites

Blue-Green Workflow:
  1. kzfs-lab build all               # Build golden images (once)
  2. kzfs-lab deploy blue             # Production baseline
  3. kzfs-lab test all                # Verify blue
  4. kzfs-lab deploy green            # Staging for new changes
  5. kzfs-lab test all                # Test green
  6. kzfs-lab promote green           # Green -> blue (instant ZFS clone)
  7. kzfs-lab rollback                # Revert if needed (instant)
EOF
  exit 1
}

# ── Dispatch ─────────────────────────────────────────────────────────────
# Route subcommands to their handler functions.
CMD="${1:-}"
[[ -n "$CMD" ]] || usage
shift

case "$CMD" in
  build)
    target="${1:-all}"
    if [[ "$target" == "all" ]]; then
      build_all_goldens
    else
      build_golden_single "$target"
    fi
    ;;
  deploy)
    site="${1:-}"
    [[ -n "$site" ]] || die "Usage: kzfs-lab deploy blue|green"
    deploy_site "$site"
    ;;
  promote)
    cmd_promote "${1:-green}"
    ;;
  rollback)
    cmd_rollback
    ;;
  test)
    target="${1:-all}"
    site="${2:-blue}"
    if [[ "$target" == "all" ]]; then
      run_test_all "$site"
    else
      run_test_single "$target" "$site"
    fi
    ;;
  test-full)
    target="${1:-}"
    [[ -n "$target" ]] || die "Usage: kzfs-lab test-full <distro>"
    run_zfs_test_suite "$target" "${2:-blue}"
    ;;
  status)
    cmd_status
    ;;
  destroy)
    cmd_destroy "${1:-}"
    ;;
  snapshot)
    cmd_snapshot_all "${1:-checkpoint}"
    ;;
  ssh)
    cmd_ssh_select
    ;;
  health)
    cmd_health "${1:-blue}"
    ;;
  ebpf-latency)
    cmd_ebpf_latency "${1:-blue}"
    ;;
  ebpf-arc)
    cmd_ebpf_arc "${1:-blue}"
    ;;
  demo)
    cmd_demo
    ;;
  *)
    usage
    ;;
esac
