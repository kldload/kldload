#!/usr/bin/env bash
# bob-remote — SSH to remote host, gather context, ask Bob about it
# Usage: bob-remote root@db-server "check disk health"
#        bob-remote user@web-server "why is nginx slow"
#        bob-remote 192.168.1.50 "list running services"
set -euo pipefail

# ── Colors ───────────────────────────────────────────────────────────────────
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

if [[ $# -lt 2 ]]; then
    echo "bob-remote — ask Bob about a remote system"
    echo ""
    echo "Usage: bob-remote HOST \"your question\""
    echo ""
    echo "Examples:"
    echo "  bob-remote root@db-server \"check disk health\""
    echo "  bob-remote user@web-server \"why is nginx slow\""
    echo "  bob-remote 192.168.1.50 \"list running services\""
    exit 0
fi

HOST="$1"
shift
QUESTION="$*"

echo -e "${BLUE}Connecting to ${HOST}...${NC}"

# ── Gather remote context ────────────────────────────────────────────────────
REMOTE_CTX=$(
    ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new "$HOST" bash <<'REMOTESCRIPT'
echo "=== HOSTNAME ==="
hostname 2>/dev/null
echo "=== OS ==="
cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d= -f2 | tr -d '"'
echo "=== CPU ==="
grep 'model name' /proc/cpuinfo 2>/dev/null | head -1 | sed 's/.*: //'
echo "cores: $(nproc 2>/dev/null)"
echo "=== RAM ==="
free -h 2>/dev/null | head -2
echo "=== DISK ==="
df -h 2>/dev/null | grep -v tmpfs | grep -v overlay
echo "=== LOAD ==="
cat /proc/loadavg 2>/dev/null
echo "=== UPTIME ==="
uptime -p 2>/dev/null
echo "=== NETWORK ==="
ip -br addr 2>/dev/null | grep -v '^lo'
echo "=== FAILED SERVICES ==="
systemctl --failed --no-legend 2>/dev/null | head -10
echo "=== TOP PROCESSES ==="
ps aux --sort=-%cpu 2>/dev/null | head -8
echo "=== LISTENING PORTS ==="
ss -tlnp 2>/dev/null | head -15
REMOTESCRIPT
) 2>/dev/null

if [[ -z "$REMOTE_CTX" ]]; then
    echo -e "${YELLOW}Couldn't connect or gather info from ${HOST}${NC}"
    echo -e "${DIM}Check SSH access and try again.${NC}"
    exit 1
fi

echo -e "${GREEN}✔${NC} Connected. Gathered system context."
echo ""

# ── Ask Bob ──────────────────────────────────────────────────────────────────
echo -e "${DIM}Asking Bob...${NC}"
echo ""

PROMPT="You are analyzing a REMOTE system (${HOST}).

Remote system context:
${REMOTE_CTX}

Question: ${QUESTION}

Give a clear, actionable answer based on the remote system's actual state."

echo "$PROMPT" | ollama run "${BOB_MODEL:-bob}"
