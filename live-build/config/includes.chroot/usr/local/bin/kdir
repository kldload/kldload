#!/usr/bin/env bash
set -Eeuo pipefail
trap 'echo "kdir: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

# kdir — create a ZFS dataset instead of a plain directory
# Usage: kdir [-p] [-o property=value] ... <mountpoint> [<mountpoint> ...]
#
# Examples:
#   kdir /home/alice               → zfs create rpool/home/alice
#   kdir /srv/myapp/data           → zfs create rpool/srv/myapp/data
#   kdir -p /srv/a/b/c             → create intermediate datasets as needed
#   kdir -o compression=zstd /data → set extra ZFS properties

usage() {
    cat >&2 <<'EOF'
Usage: kdir [-p] [-o property=value] ... <mountpoint> [<mountpoint> ...]

Creates a ZFS dataset mounted at each given path.
The parent path must already be where a ZFS dataset is mounted (or use -p).
A path that already exists as a plain directory cannot be made a dataset
here: its files would be hidden under the new mount.

Exit: 0 created; 1 refused or failed; 2 usage. Needs root. See kdir(8).

Options:
  -p              Create parent datasets as needed
  -o prop=value   Set a ZFS property (can be repeated)
  -h              Show this help

Examples:
  kdir /home/alice
  kdir /srv/myapp
  kdir -p /srv/apps/backend/data
  kdir -o compression=zstd -o quota=50G /srv/bigdata
EOF
    # asked-for help is 0; a usage error is 2, like the other tools (it was 1)
    exit "${1:-2}"
}

die() {
    echo "kdir: error: $*" >&2
    exit 1
}
info() { echo "kdir: $*"; }

# ── Resolve the ZFS dataset name for a given absolute path ───────────────────
# Walks up the path to find the ZFS dataset that owns it, then appends the
# relative suffix to form the new dataset name.
#
# e.g.  /srv/apps  →  rpool/srv/apps  (if /srv is rpool/srv)
# _ds_at PATH -- the ZFS dataset mounted exactly AT path, or nothing.
# WHY not `zfs list PATH`: that answers for ANY existing path with the
# dataset containing it. A plain directory as the parent then gave the
# containing dataset, the new one was named after IT, and so mounted
# somewhere else -- `kdir /x/plain/data` said "-> /x/plain/data", exit 0, and
# mounted at /x/data (onyx, 2026-09-29).
_ds_at() {
    local src="" fst="" tgt=""
    read -r src fst tgt < <(findmnt -no SOURCE,FSTYPE,TARGET -T "$1" 2>/dev/null) || return 0
    [[ "$fst" == zfs && "$tgt" == "$1" ]] && printf '%s\n' "$src"
    return 0
}

dataset_for_path() {
    local path="$1"
    path="$(realpath -m "$path")" # normalise without requiring existence

    local parent="${path%/*}"
    [[ -n "$parent" ]] || parent="/"

    local parent_ds
    parent_ds="$(_ds_at "$parent")"
    [[ -n "$parent_ds" ]] ||
        die "parent '$parent' is not where a ZFS dataset is mounted (a plain directory, or not ZFS); use -p to create it"

    local basename="${path##*/}"
    [[ -n "$basename" ]] || die "cannot create dataset at filesystem root"

    echo "${parent_ds}/${basename}"
}

# _create DS PATH -- zfs create, then check it mounted at PATH
_create() {
    info "creating dataset: $1  →  $2"
    zfs create "${ZFS_OPTS[@]+"${ZFS_OPTS[@]}"}" "$1"
    local got
    got="$(zfs get -H -o value mountpoint "$1")"
    [[ "$got" == "$2" ]] || die "created $1, but it is mounted at $got, not $2 (a -o mountpoint= overrides the path)"
}

# ── Parse arguments ──────────────────────────────────────────────────────────
PARENTS=0
ZFS_OPTS=()

# getopts only knows single letters; --help is what people type
[[ "${1:-}" == "--help" ]] && usage 0
while getopts ":po:h" opt; do
    case "$opt" in
    p) PARENTS=1 ;;
    o) ZFS_OPTS+=(-o "$OPTARG") ;;
    h) usage 0 ;;
    :) die "option -$OPTARG requires an argument" ;;
    \?) die "unknown option: -$OPTARG" ;;
    esac
done
shift $((OPTIND - 1))

[[ $# -gt 0 ]] || usage
((EUID == 0)) || die "must run as root (zfs create)"

# ── Create each requested dataset ───────────────────────────────────────────
for mountpoint in "$@"; do
    # Require absolute path
    [[ "$mountpoint" == /* ]] || die "'$mountpoint' must be an absolute path"

    abs="$(realpath -m "$mountpoint")"

    if [[ "$PARENTS" -eq 1 ]]; then
        # Build a list of ancestor paths that don't exist yet as datasets,
        # then create them from shallowest to deepest.
        declare -a to_create=()
        check="$abs"
        while [[ "$check" != "/" ]]; do
            [[ -n "$(_ds_at "$check")" ]] && break # a dataset is mounted here — stop walking up
            [[ -e "$check" ]] &&
                die "$check exists as a plain directory; kdir cannot make it a dataset (its files would be hidden)"
            to_create=("$check" "${to_create[@]+"${to_create[@]}"}")
            check="${check%/*}"
            [[ -n "$check" ]] || check="/"
        done

        ((${#to_create[@]})) || die "$abs is already where a dataset is mounted"
        for path in "${to_create[@]+"${to_create[@]}"}"; do
            ds="$(dataset_for_path "$path")" || exit 1 # it said why; die in $( ) ends only the subshell
            _create "$ds" "$path"
        done
    else
        [[ -e "$abs" && -z "$(_ds_at "$abs")" && -n "$(ls -A "$abs" 2>/dev/null)" ]] &&
            die "$abs exists with files in it; a dataset mounted there would hide them"
        [[ -n "$(_ds_at "$abs")" ]] && die "$abs is already where a dataset is mounted"
        ds="$(dataset_for_path "$abs")" || exit 1 # it said why; die in $( ) ends only the subshell
        _create "$ds" "$abs"
    fi
done
