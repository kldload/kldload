#!/usr/bin/env bash
# kldload-trust-cert — import kldload's CA ROOT into Chrome NSS DB(s)
# so https://localhost:8443 is trusted automatically. No certificate
# warning, no --ignore-certificate-errors flag needed.
#
# Imports the CA ROOT, NOT the webui leaf. kldload-tls-cert REGENERATES the
# leaf whenever the box gains an IP / the SAN drifts (e.g. the first
# post-DHCP boot), so a trusted *leaf* goes stale on that regen and Chrome
# shows the warning again (observed .145 2026-07-28). Trusting the root
# means every leaf the CA signs — including regenerated ones — validates.
#
# Two modes:
#   kldload-trust-cert            — per-user; imports into $HOME/.pki/nssdb
#   kldload-trust-cert --system   — root only; seeds /etc/skel + every
#                                   existing user's NSS DB. This is the mode
#                                   wired into kldload-tls-cert.service's
#                                   ExecStartPost so trust is established
#                                   BEFORE any user session starts and
#                                   re-applied on every cert rotation.
#
# Chrome on Linux reads ~/.pki/nssdb/ — NOT the /etc/pki/ca-trust system
# bundle. So even with update-ca-trust populated, Chrome rejects the cert
# until it's mirrored into NSS DB. The script is the bridge.
#
# Idempotent: compares cert fingerprints; only re-imports on rotation.
set -Eeuo pipefail

# The CA root: canonical /etc/kldload/ca location, falling back to the
# ca-trust anchor kldload-ca installs.
CERT=/etc/kldload/ca/root/ca.crt
[[ -r "$CERT" ]] || CERT=/etc/pki/ca-trust/source/anchors/kldload-ca.crt
NICKNAME=kldload-ca
OLD_NICKNAME=kldload-webui # stale leaf entry seeded by pre-fix installs

# ── per-DB import (used by both modes) ─────────────────────────────
# Trust flag MUST be "CT,C,T" — this is the only combination that makes
# Chrome on Linux silently accept the cert.
#
# Why not "C,,":  the obvious choice ("trusted CA for SSL") makes Chrome
# STILL reject the leaf with NET::ERR_CERT_AUTHORITY_INVALID. The cert is
# both CA and leaf (self-signed with CA:TRUE pathlen:0). NSS's chain
# builder needs explicit "trusted to issue *for this purpose*" flags on
# all three slots (SSL, email, code-signing) or chain validation flips
# to "Certificate type not approved for application." Verified on b643
# .142 — went from cert warning banner to silent trust the moment the
# trust flag flipped from C,, → CT,C,T. The lowercase 'c' that NSS
# writes back ("CT,C,c") is normal — it can't promote the code-signing
# slot beyond "valid CA," and that's fine for our purpose.
TRUST_FLAGS="CT,C,T"

# _import_into DB -- make sure DB trusts the root. Returns 1 and says why when
# it could not.
#
# WARN: every step checks its own status. Callers once ran this as
# `_import_into ... || true`, and bash ignores set -e for the whole of a
# function called from a || list, so a certutil -A that failed (read-only
# database) was followed by "imported" and exit 0, and the user kept trusting
# the old root after a rotation (found in a container, 2026-09-30).
_import_into() {
    local db="$1"
    mkdir -p "$db" || return 1
    if [[ ! -f "$db/cert9.db" ]]; then
        certutil -d "sql:$db" -N --empty-password >/dev/null || {
            echo "kldload-trust-cert: could not create the NSS database $db" >&2
            return 1
        }
    fi
    local cur ins existing_flags
    cur="$(openssl x509 -in "$CERT" -noout -fingerprint -sha256 2>/dev/null |
        cut -d= -f2 | tr -d ':' | tr 'a-f' 'A-F' || true)"
    ins="$(certutil -L -d "sql:$db" -n "$NICKNAME" 2>/dev/null |
        awk '/Fingerprint \(SHA-256\)/{getline; print; exit}' |
        tr -d ' :' | tr 'a-f' 'A-F' || true)"
    # Trust-flag check: an existing entry with the wrong flags must be
    # re-trusted even if the fingerprint matches (this is how we recover
    # NSS DBs poisoned by older b643 versions that used "C,,").
    existing_flags="$(certutil -L -d "sql:$db" 2>/dev/null |
        awk -v n="$NICKNAME" '$0 ~ "^"n" "{
                for (i=NF; i>=1; i--) if ($i ~ /^[CTPpcuw,]+$/) {print $i; exit}}' || true)"
    # Accept both "CT,C,c" (what NSS writes for the old self-signed leaf) and
    # "CT,C," (what it writes for the CA root) — both mean "trusted CA". Only a
    # genuinely wrong entry (e.g. the "C,," poison) fails this and re-imports.
    if [[ -n "$ins" && "$ins" == "$cur" && "$existing_flags" == CT,C,* ]]; then
        return 0
    fi
    # Purge the stale leaf entry pre-fix installs seeded (harmless if absent).
    certutil -D -d "sql:$db" -n "${OLD_NICKNAME:-kldload-webui}" >/dev/null 2>&1 || true
    certutil -D -d "sql:$db" -n "$NICKNAME" >/dev/null 2>&1 || true
    if ! certutil -A -d "sql:$db" -n "$NICKNAME" -t "$TRUST_FLAGS" -i "$CERT"; then
        echo "kldload-trust-cert: FAILED to import $NICKNAME into $db" >&2
        return 1
    fi
    echo "kldload-trust-cert: imported $NICKNAME (${cur:0:16}...) into $db"
}

# ── prerequisites ─────────────────────────────────────────────────
if [[ ! -r "$CERT" ]]; then
    # Not an error: a machine with no authority yet has nothing to trust. But
    # say so -- this exited 0 in silence.
    echo "kldload-trust-cert: no kldload CA root at /etc/kldload/ca/root/ca.crt; nothing to trust" >&2
    exit 0
fi
command -v certutil >/dev/null 2>&1 || {
    echo "kldload-trust-cert: certutil missing (need nss-tools)" >&2
    exit 0
}

# ── system mode: seed skel + every existing user ──────────────────
if [[ "${1:-}" == "--system" ]]; then
    if [[ "$(id -u)" != "0" ]]; then
        echo "kldload-trust-cert: --system requires root" >&2
        exit 1
    fi

    _failed=0
    # /etc/skel — every future-created user starts with the cert trusted
    _import_into /etc/skel/.pki/nssdb || _failed=$((_failed + 1))
    chmod -R go-rwx /etc/skel/.pki || _failed=$((_failed + 1))

    # Existing users: /root + every /home/*
    for user_home in /root /home/*; do
        [[ -d "$user_home" ]] || continue
        local_owner="$(stat -c '%U' "$user_home" 2>/dev/null || echo root)"
        nssdb="$user_home/.pki/nssdb"
        if [[ "$local_owner" == "root" ]]; then
            _import_into "$nssdb" || _failed=$((_failed + 1))
        else
            # Run as the owning user so file ownership lands correctly.
            # MUST pass TRUST_FLAGS through the env prefix — _import_into reads
            # it from the calling shell, but the su subshell sees only what's
            # exported or set on the command line. Omitting it (b649 .139
            # 2026-06-09 incident) caused certutil -t '' → empty trust flags
            # (',,'), Chrome rejected the cert, every kldload --app launcher
            # showed the cert-warning interstitial on every open.
            # SAFETY: the paths go in as arguments, not pasted into the -c
            # string, where a quote in a directory name would end the string.
            if ! mkdir -p "$nssdb" || ! chown -R "$local_owner:$local_owner" "$user_home/.pki"; then
                echo "kldload-trust-cert: could not prepare $nssdb for $local_owner" >&2
                _failed=$((_failed + 1))
                continue
            fi
            # shellcheck disable=SC2016 # expanded by the user's shell, not here
            su -s /bin/bash -c "$(declare -f _import_into)"'; CERT=$2 NICKNAME=$3 TRUST_FLAGS=$4 _import_into "$1"' \
                "$local_owner" -- _ "$nssdb" "$CERT" "$NICKNAME" "$TRUST_FLAGS" ||
                _failed=$((_failed + 1))
        fi
    done
    if ((_failed)); then
        echo "kldload-trust-cert: $_failed database(s) NOT updated; see above" >&2
        exit 1
    fi
    exit 0
fi

# ── per-user mode (default) ───────────────────────────────────────
_import_into "$HOME/.pki/nssdb"
