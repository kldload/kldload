#!/bin/bash
# Read /proc/spl/kstat/zfs/arcstats and emit Prometheus textfile.
# node_exporter's bundled zfs collector fails on newer kernels (format drift),
# so we parse the kstat file directly — it's just key/value lines:
#   name                type  data
#   memory_available    4     12345
# Only emit ints so malformed rows don't break the scrape.
OUT=/var/lib/node_exporter/textfile_collector/arcstats.prom
TMP=${OUT}.tmp
mkdir -p "$(dirname "$OUT")"
{
  echo "# HELP zfs_arcstat ZFS ARC kstat value from /proc/spl/kstat/zfs/arcstats"
  echo "# TYPE zfs_arcstat gauge"
  awk 'NR>2 && $3 ~ /^-?[0-9]+$/ {printf "zfs_arcstat{metric=\"%s\"} %s\n", $1, $3}' \
    /proc/spl/kstat/zfs/arcstats
} > "$TMP"
mv -f "$TMP" "$OUT"
