#!/usr/bin/env bash
# kldload-term — open whatever terminal emulator this distro actually ships,
# with kldload tools in PATH + a one-line greeting. RHEL 10 / Fedora 41+ dropped
# gnome-terminal for ptyxis; gnome-console (kgx) is the GNOME 47 console; konsole
# is KDE. Pick the first that exists. The greeting runs in an interactive login
# shell so kst/ksnap/kclone/etc. are on PATH (secure_path drop-in handles sudo).
#
# Optional: a command to run inside the terminal before dropping to a shell
# (e.g. `kldload-term kldload-help` for the docs launcher). With no args it
# opens an interactive shell with the kldload greeting.
set -eu
if [ "$#" -gt 0 ]; then
  INNER="$*; echo; exec bash"
else
  INNER='echo "kldload tools: kst ksnap kclone kdf kdir kpkg kexport"; echo "Type kldload-help for the full command reference."; echo; exec bash'
fi
# konsole first — it's the preferred terminal on the kldload workstation
# (richer than ptyxis: profiles, split views, proper scrollback). Falls back
# to ptyxis/gnome-console/etc on systems where konsole isn't installed.
for t in konsole ptyxis gnome-console kgx gnome-terminal xterm; do
  if command -v "$t" >/dev/null 2>&1; then
    case "$t" in
      ptyxis)             exec ptyxis -- bash -lc "$INNER" ;;
      gnome-console|kgx)  exec "$t" -- bash -lc "$INNER" ;;
      gnome-terminal)     exec gnome-terminal -- bash -lc "$INNER" ;;
      konsole|xterm)      exec "$t" -e bash -lc "$INNER" ;;
    esac
  fi
done
exec bash -lc "$INNER"
