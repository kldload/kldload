#!/usr/bin/env bash
# bob-models — download + load/unload/manage Bob's Ollama model catalog.
#
# This is Bob's model-management surface. `bob models …` delegates here, and
# the Bob app (bob-agent / webui Bob tab) calls `bob-models load|unload` to
# swap the resident model in and out of memory without restarting ollama.
#
# Usage:
#   bob-models [list]                catalog + installed + resident status
#   bob-models pull <name|all> [--fit|--force]
#                                    download model(s); idempotent (skips present)
#                                    all  → every catalog model
#                                    --fit  with `all`: skip models bigger than RAM
#                                    --force re-pull even if already installed
#   bob-models load <name>           warm a model resident in memory (keep_alive=-1)
#   bob-models unload <name|all>     evict from memory (keep_alive=0)
#   bob-models loaded                show resident models (ollama ps)
#   bob-models default <name>        set BOB_MODEL default (persists)
#   bob-models rm <name>             delete a local model
#   bob-models --self-test           validate catalog + ollama reachability (no pulls)
#
# Names may be a catalog key (e.g. 70b, deepseek7b), a full ollama tag
# (mistral:7b), or — for the custom assistant — "bob" (built from the Modelfile).
set -euo pipefail

OLLAMA_API="${OLLAMA_HOST:-http://localhost:11434}"
# OLLAMA_HOST may be a host:port or a URL; normalise to a URL for curl.
case "$OLLAMA_API" in
  http://*|https://*) : ;;
  *)                  OLLAMA_API="http://${OLLAMA_API}" ;;
esac
BOB_MODELFILE="${BOB_MODELFILE:-/etc/bob/Modelfile.bob}"
PROFILE_DROPIN=/etc/profile.d/bob-model.sh

# ── Colors (disabled when not a TTY) ─────────────────────────────────────────
if [[ -t 1 ]]; then
  RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
  BLUE=$'\033[0;34m'; CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; DIM=$'\033[2m'; NC=$'\033[0m'
else
  RED=""; GREEN=""; YELLOW=""; BLUE=""; CYAN=""; BOLD=""; DIM=""; NC=""
fi

# ── Catalog (kept in sync with bob-model) ────────────────────────────────────
# ORDER drives `pull all` and the listing; smallest → largest.
ORDER=(bob mistral deepseek7b codellama deepseek32b 70b)
declare -A TAG SIZE RAM DESC
TAG[bob]="bob";                 SIZE[bob]="5GB";        RAM[bob]=8;   DESC[bob]="Default Bob — fast, general purpose (built from Modelfile)"
TAG[mistral]="mistral:7b";      SIZE[mistral]="4.1GB";  RAM[mistral]=8;   DESC[mistral]="Fast and capable"
TAG[deepseek7b]="deepseek-r1:7b"; SIZE[deepseek7b]="4.7GB"; RAM[deepseek7b]=8; DESC[deepseek7b]="Deep reasoning — better logic and math"
TAG[codellama]="codellama:13b"; SIZE[codellama]="7.4GB"; RAM[codellama]=16; DESC[codellama]="Code specialist"
TAG[deepseek32b]="deepseek-r1:32b"; SIZE[deepseek32b]="20GB"; RAM[deepseek32b]=32; DESC[deepseek32b]="Serious brain — needs 32GB+ RAM"
TAG[70b]="llama3.1:70b";        SIZE[70b]="40GB";       RAM[70b]=48;  DESC[70b]="Maximum power — needs 48GB+ RAM"

_ram_gb=$(awk '/MemTotal/{printf "%.0f", $2/1024/1024}' /proc/meminfo 2>/dev/null || echo 0)

# ── Helpers ──────────────────────────────────────────────────────────────────
_die() { echo "${RED}error:${NC} $*" >&2; exit 1; }

_need_ollama() {
  command -v ollama >/dev/null 2>&1 || _die "ollama is not installed (expected on the Bob appliance)."
}

_daemon_up() { curl -sf --max-time 3 "${OLLAMA_API}/api/tags" >/dev/null 2>&1; }

_need_daemon() {
  _daemon_up && return 0
  _die "ollama daemon not reachable at ${OLLAMA_API} — start it with: systemctl start ollama"
}

# Resolve a user-supplied name to an ollama tag. Catalog key → its tag; raw tag
# (anything else) passes through unchanged so users can pull off-catalog models.
_resolve() {
  local n="$1"
  if [[ -n "${TAG[$n]:-}" ]]; then printf '%s' "${TAG[$n]}"; else printf '%s' "$n"; fi
}

# Is a tag installed locally? Match on the repo:tag column of `ollama list`.
_installed() {
  local tag="$1"
  ollama list 2>/dev/null | awk 'NR>1{print $1}' | grep -qxF "$tag"
}

# ── Commands ─────────────────────────────────────────────────────────────────
cmd_list() {
  _need_ollama
  echo "${BOLD}Bob model catalog${NC}  ${DIM}(system RAM: ${_ram_gb}GB)${NC}"
  echo ""
  local resident=""
  _daemon_up && resident=$(ollama ps 2>/dev/null | awk 'NR>1{print $1}')
  local key tag mark ramwarn res
  for key in "${ORDER[@]}"; do
    tag="${TAG[$key]}"
    if _installed "$tag"; then mark="${GREEN}●${NC}"; else mark="${DIM}○${NC}"; fi
    res=""
    printf '%s\n' "$resident" | grep -qxF "$tag" && res=" ${CYAN}[loaded]${NC}"
    ramwarn=""
    [[ "${_ram_gb:-0}" -lt "${RAM[$key]}" ]] 2>/dev/null && ramwarn=" ${YELLOW}(needs ${RAM[$key]}GB)${NC}"
    printf '  %b %b%-18s%b %b(%s, key: %s)%b%b%b\n' \
      "$mark" "$BOLD" "$tag" "$NC" "$DIM" "${SIZE[$key]}" "$key" "$NC" "$ramwarn" "$res"
    printf '       %b%s%b\n' "$DIM" "${DESC[$key]}" "$NC"
  done
  echo ""
  echo "${DIM}●=installed ○=not installed.  bob-models pull all  ·  bob-models load <name>${NC}"
}

# Pull (or build) one tag. Idempotent: skips an already-present model unless
# --force. Returns non-zero on failure (callers decide whether to continue).
pull_one() {
  local tag="$1" force="${2:-}"
  if [[ "$force" != "--force" ]] && _installed "$tag"; then
    echo "  ${GREEN}✔${NC} ${tag} ${DIM}(already installed)${NC}"
    return 0
  fi
  if [[ "$tag" == "bob" ]]; then
    [[ -f "$BOB_MODELFILE" ]] || { echo "  ${YELLOW}skip${NC} bob — Modelfile not found at ${BOB_MODELFILE}"; return 1; }
    echo "${BLUE}Building bob from ${BOB_MODELFILE}…${NC}"
    ollama create bob -f "$BOB_MODELFILE"
  else
    echo "${BLUE}Pulling ${tag}…${NC}"
    ollama pull "$tag"
  fi
}

cmd_pull() {
  _need_ollama; _need_daemon
  local target="${1:-}"; shift || true
  [[ -n "$target" ]] || _die "usage: bob-models pull <name|all> [--fit|--force]"
  local fit="" force=""
  for a in "$@"; do
    case "$a" in
      --fit) fit=1 ;;
      --force) force="--force" ;;
      *) _die "unknown option: $a" ;;
    esac
  done

  if [[ "$target" != "all" ]]; then
    local tag; tag=$(_resolve "$target")
    pull_one "$tag" "$force" && echo "${GREEN}✔ done${NC}" || _die "pull failed: $tag"
    return 0
  fi

  # pull all — continue past individual failures, report a summary
  local key tag ok=0 skipped=0 failed=0 failed_list=""
  for key in "${ORDER[@]}"; do
    tag="${TAG[$key]}"
    if [[ -n "$fit" && "${_ram_gb:-0}" -lt "${RAM[$key]}" ]] 2>/dev/null; then
      echo "  ${YELLOW}skip${NC} ${tag} ${DIM}(needs ${RAM[$key]}GB, have ${_ram_gb}GB)${NC}"
      skipped=$((skipped+1)); continue
    fi
    if pull_one "$tag" "$force"; then ok=$((ok+1)); else failed=$((failed+1)); failed_list+=" ${tag}"; fi
  done
  echo ""
  echo "${BOLD}pull all:${NC} ${GREEN}${ok} ok${NC}, ${YELLOW}${skipped} skipped${NC}, ${RED}${failed} failed${NC}${failed_list:+ →${failed_list}}"
  [[ "$failed" -eq 0 ]]
}

# Load / unload via the API keep_alive knob — works without `ollama stop` and
# is exactly what the app needs to swap the resident model.
_keepalive() {
  local tag="$1" ka="$2"
  curl -sf --max-time 120 "${OLLAMA_API}/api/generate" \
    -d "{\"model\":\"${tag}\",\"prompt\":\"\",\"keep_alive\":${ka}}" >/dev/null
}

cmd_load() {
  _need_ollama; _need_daemon
  local name="${1:-}"; [[ -n "$name" ]] || _die "usage: bob-models load <name>"
  local tag; tag=$(_resolve "$name")
  _installed "$tag" || { echo "${YELLOW}${tag} not installed — pulling first…${NC}"; pull_one "$tag" || _die "could not obtain $tag"; }
  echo "${BLUE}Loading ${tag} into memory…${NC}"
  _keepalive "$tag" "-1" || _die "load failed for $tag"
  echo "${GREEN}✔${NC} ${tag} resident"
  ollama ps 2>/dev/null
}

cmd_unload() {
  _need_ollama; _need_daemon
  local name="${1:-}"; [[ -n "$name" ]] || _die "usage: bob-models unload <name|all>"
  if [[ "$name" == "all" ]]; then
    local tag any=0
    while read -r tag; do
      [[ -n "$tag" ]] || continue
      echo "${BLUE}Unloading ${tag}…${NC}"; _keepalive "$tag" "0" || true; any=1
    done < <(ollama ps 2>/dev/null | awk 'NR>1{print $1}')
    [[ "$any" -eq 1 ]] && echo "${GREEN}✔${NC} all models evicted" || echo "${DIM}nothing resident${NC}"
    return 0
  fi
  local tag; tag=$(_resolve "$name")
  echo "${BLUE}Unloading ${tag}…${NC}"
  _keepalive "$tag" "0" || _die "unload failed for $tag"
  echo "${GREEN}✔${NC} ${tag} evicted"
}

cmd_loaded() { _need_ollama; _need_daemon; ollama ps; }

cmd_default() {
  _need_ollama
  local name="${1:-}"; [[ -n "$name" ]] || _die "usage: bob-models default <name>"
  local tag; tag=$(_resolve "$name")
  if printf 'export BOB_MODEL=%q\n' "$tag" | sudo tee "$PROFILE_DROPIN" >/dev/null 2>&1; then
    echo "${GREEN}✔${NC} default model set to ${BOLD}${tag}${NC} ${DIM}(persists via ${PROFILE_DROPIN})${NC}"
  else
    echo "${YELLOW}could not write ${PROFILE_DROPIN} (need sudo). For this shell only:${NC}"
    echo "  export BOB_MODEL='${tag}'"
  fi
}

cmd_rm() {
  _need_ollama; _need_daemon
  local name="${1:-}"; [[ -n "$name" ]] || _die "usage: bob-models rm <name>"
  local tag; tag=$(_resolve "$name")
  ollama rm "$tag" && echo "${GREEN}✔${NC} removed ${tag}"
}

# Structural smoke test — no network, no pulls. Verifies the catalog is
# internally consistent and reports ollama availability.
cmd_selftest() {
  local rc=0 key
  for key in "${ORDER[@]}"; do
    [[ -n "${TAG[$key]:-}"  ]] || { echo "FAIL: $key missing TAG";  rc=1; }
    [[ -n "${SIZE[$key]:-}" ]] || { echo "FAIL: $key missing SIZE"; rc=1; }
    [[ -n "${RAM[$key]:-}"  ]] || { echo "FAIL: $key missing RAM";  rc=1; }
    [[ -n "${DESC[$key]:-}" ]] || { echo "FAIL: $key missing DESC"; rc=1; }
    [[ "${RAM[$key]}" =~ ^[0-9]+$ ]] || { echo "FAIL: $key RAM not numeric"; rc=1; }
  done
  if command -v ollama >/dev/null 2>&1; then echo "ok: ollama present"; else echo "warn: ollama not installed"; fi
  if _daemon_up; then echo "ok: daemon up at ${OLLAMA_API}"; else echo "warn: daemon not reachable at ${OLLAMA_API}"; fi
  [[ "$rc" -eq 0 ]] && echo "self-test: PASS (${#ORDER[@]} models)" || echo "self-test: FAIL"
  return "$rc"
}

usage() {
  sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
}

# ── Dispatch ─────────────────────────────────────────────────────────────────
case "${1:-list}" in
  list|"")        cmd_list ;;
  pull|download)  shift; cmd_pull "$@" ;;
  load|warm)      shift; cmd_load "$@" ;;
  unload|stop)    shift; cmd_unload "$@" ;;
  loaded|ps)      shift; cmd_loaded ;;
  default|set)    shift; cmd_default "$@" ;;
  rm|remove|del)  shift; cmd_rm "$@" ;;
  --self-test|selftest) cmd_selftest ;;
  -h|--help|help) usage ;;
  *) _die "unknown command: $1  (try: bob-models --help)" ;;
esac
