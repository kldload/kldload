# eBPF + essentials (always)
apt-get install -y bpftrace bpfcc-tools wireguard-tools curl jq qemu-guest-agent 2>/dev/null || true
# See the dnf branch for why the guest agent matters on a cloned image.
systemctl enable --now qemu-guest-agent 2>/dev/null || true

# Test suite deps + dev tools (only when KLAB_ZFS_DEV=1).
# See the dnf branch for the rationale — full OpenZFS test suite
# prerequisites. apt package names differ slightly from rpm.
#
# Per-package install: a single `apt-get install A B C…` aborts the
# whole transaction if even one pkg name isn't in the indexes
# (xxhash, linux-perf, etc. vary by Ubuntu/Debian release) and
# leaves the rest uninstalled. Loop each one so a missing pkg is
# a single-line skip instead of a silent blanket failure.
if [ "$KLAB_ZFS_DEV" = "1" ]; then
  # Full OpenZFS test-suite dependency set on Debian/Ubuntu — mirrors
  # the dnf loop so every quick + full suite tag actually executes
  # instead of SKIPping on a missing binary. Per-pkg install so one
  # name mismatch doesn't cascade.
  #
  # linux-modules-extra-$(uname -r) ships scsi_debug + dm-flakey +
  # dm-delay + nbd — the kernel modules the functional/fault suite
  # depends on. Without them, fault/setup fails and 14+ disk-failure
  # tests cascade-SKIP. Match against the running kernel so the
  # module tree lines up. Falls back to -generic if the exact version
  # isn't in the APT index (rolling HWE kernels sometimes lag).
  for _p in \
      "linux-modules-extra-$(uname -r)" \
      linux-modules-extra-generic \
      ksh \
      fio \
      parted \
      attr acl bc sysstat \
      gdb strace \
      linux-perf linux-tools-common linux-tools-generic \
      pax bsdextrautils \
      openssl libssl-dev zlib1g-dev \
      psmisc lsof \
      stress-ng \
      rng-tools \
      man-db \
      uuid-dev libblkid-dev libtirpc-dev \
      net-tools ncat \
      nfs-kernel-server rpcbind \
      cryptsetup \
      bzip2 xxhash \
      python3 \
      util-linux pax \
      pamtester \
      e2fsprogs xfsprogs dosfstools \
      rsync \
      samba samba-common-bin smbclient \
      open-iscsi targetcli-fb \
      lsscsi sg3-utils \
      kpartx mdadm \
      procps debianutils \
      make gcc autoconf automake libtool \
      git \
      locales \
      python3-pyzfs \
      ; do
    apt-get install -y "$_p" 2>/dev/null || true
  done
  # Generate en_US.UTF-8 locale — casenorm tests need it for the iconv
  # formd normalisation tables. Debian/Ubuntu ship with C.UTF-8 only by
  # default; casenorm's formd_lookup reads from en_US.UTF-8 specifically.
  sed -i 's/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen 2>/dev/null || true
  locale-gen en_US.UTF-8 2>/dev/null || true
  update-locale LANG=en_US.UTF-8 2>/dev/null || true
  # nfs-kernel-server for cli_root/zfs_share/* tests
  systemctl enable --now nfs-kernel-server 2>/dev/null || true
  systemctl enable --now rpcbind            2>/dev/null || true
fi

modprobe zfs 2>/dev/null || true

# node_exporter
if ! command -v node_exporter >/dev/null 2>&1; then
  curl -fsSL https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-amd64.tar.gz \
    | tar -xz -C /tmp 2>/dev/null && install -m 755 /tmp/node_exporter-*/node_exporter /usr/local/bin/ && rm -rf /tmp/node_exporter-* || true
