#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════════
# klab — Multi-Distro Test Platform
# ══════════════════════════════════════════════════════════════════════════
#
# Turns any hardware into a one-click multi-distro test bay. Golden images
# for 5 Linux distros (DISTROS=), ZFS instant clones (~75ms per VM), blue-green
# deployment, pluggable payloads (ZFS tests, Kubernetes, custom playbooks),
# full observability stack (Prometheus/Grafana/Loki), eBPF tracing, and
# NVIDIA GPU support when detected.
#
# Architecture:
#   Golden images → ZFS clones → Blue/Green sites → Payloads → Results
#   Each golden is built once (cloud image + ZFS + eBPF + dev tools),
#   then cloned instantly for every test run. Blue-green lets you test
#   changes in green while blue stays as the known-good baseline.
#
# Distros:  CentOS Stream 9, Rocky 9, Fedora 44, Debian 13, Ubuntu 24.04,
#           Arch Linux (+RHEL 9 via CentOS clone + subscription)
#
# Usage:
#   klab                                    Interactive menu
#   klab golden [distro|all]                Build golden images
#   klab golden-desktop [distro...]         Build GNOME desktop goldens (default: all)
#   klab deploy blue|green                  Clone goldens to site
#   klab promote green                      Green becomes new blue
#   klab rollback                           Revert blue to previous
#   klab test [--quick|--full] [--distro d] Run OpenZFS test suite
#   klab kubernetes [--workers N]           Deploy K8s cluster from clones
#   klab run-playbook /path/to/script.sh    Run custom payload on all VMs
#   klab verify [distro|all]                Smoke test goldens
#   klab status                             Full status display
#   klab destroy blue|green|all|goldens     Tear down
set -uo pipefail

# ── SIGHUP / SIGPIPE immunity ────────────────────────────────────────────
# Long-running klab subcommands (test --full, golden, destroy) take
# 2-6 hours. They're usually started from a SSH session or the webui's
# ttyd terminal; when the operator disconnects, closes the browser, or
# the webui service restarts for any reason, the default SIGHUP cascades
# down and kills klab mid-run — orphaning test VMs and leaving no
# summary. Observed on pass-22 install: klab was killed after cloning
# centos, leaving klab-test-centos running for an hour with no progress.
#
# Ignore SIGHUP + SIGPIPE at the top level so terminal/pipe changes
# don't abort the run. Output continues to tee to
# /var/log/kldload/klab.log and /root/klab/<run>/full.log — both
# file sinks are stable even after stdout/stderr's original reader
# disappears.
#
# Only apply to the long-running subcommands (test/golden/destroy/deploy).
# Keep default behaviour for interactive commands (status, list, verify)
# so Ctrl+C at the prompt still works cleanly.
case "${1:-}" in
test | golden | golden-ztest | deploy | destroy | promote | rollback | build | demo)
    trap '' HUP PIPE
    ;;
esac

if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

# ── Section 1: Configuration ─────────────────────────────────────────────
POOL="${POOL:-rpool}"
PREFIX="klab"
SSH_KEY="${SSH_KEY:-/root/.ssh/id_ed25519}"
# Cloud-init seed ISOs live in the cloud-init libvirt pool (fixed
# UUID, target /var/lib/kldload/cloud-init). Moved off /var/lib/libvirt/
# isos/ in build #16 — the shared pool caused virt-install auto-define
# races when kube-cluster and klab built VMs concurrently.
ISO_DIR="/var/lib/kldload/cloud-init"
RESULTS_DIR="/root/klab"
MASTER_LOG="${RESULTS_DIR}/klab.log"

# ZFS source mode: "repo" (default), "version:X.Y.Z", "git:owner/repo@ref", "tarball:/path"
ZFS_SOURCE="${ZFS_SOURCE:-repo}"

# 5-distro test matrix. RHEL is excluded by default because it requires
# subscription-manager credentials at runtime (see RHEL_USERNAME/PASSWORD
# below) — opt-in via `klab golden rhel` if you have an active sub.
DISTROS=(centos rocky fedora debian ubuntu)

# RHEL credentials — prompted at runtime, never logged or stored on disk
RHEL_USERNAME="${RHEL_USERNAME:-}"
RHEL_PASSWORD="${RHEL_PASSWORD:-}"
RHEL_CREDS_FILE="/root/.klab-rhel-creds"

declare -A CLOUD_IMAGES=(
    [centos]="https://cloud.centos.org/centos/9-stream/x86_64/images/CentOS-Stream-GenericCloud-9-latest.x86_64.qcow2"
    [rocky]="https://dl.rockylinux.org/pub/rocky/9/images/x86_64/Rocky-9-GenericCloud-Base.latest.x86_64.qcow2"
    # Fedora 44 — current stable as of 2026-04-28 GA. Kernel 6.19, glibc
    # 2.42+. Change this URL + the os-variant below when moving to F45.
    [fedora]="https://download.fedoraproject.org/pub/fedora/linux/releases/44/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-44-1.7.x86_64.qcow2"
    [debian]="https://cloud.debian.org/images/cloud/trixie/daily/latest/debian-13-genericcloud-amd64-daily.qcow2"
    [ubuntu]="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
    [arch]="https://geo.mirror.pkgbuild.com/images/latest/Arch-Linux-x86_64-cloudimg.qcow2"
    # RHEL 10 KVM Guest Image: Red Hat doesn't publish an anonymous URL —
    # the user provides one of (in precedence order):
    #   1. KLAB_RHEL_IMAGE=/path/to/qcow2   (local file)
    #   2. /var/lib/klab/images/rhel-10-cloud.qcow2   (canonical drop-in)
    #   3. KLAB_RHEL_IMAGE_URL=<one-shot Customer Portal URL>   (we curl it)
    # See build_golden_single() rhel branch. Sentinel kept for any caller
    # iterating CLOUD_IMAGES.
    [rhel]="REQUIRES_USER_PROVIDED_IMAGE"
)

declare -A OS_VARIANTS=(
    [centos]="centos-stream9"
    [rocky]="centos-stream9"
    [fedora]="fedora44"
    # debian13, matching the trixie image actually fetched above. This said
    # debian12 while installing Debian 13, so libvirt was given hints for the
    # wrong release; harmless in practice but wrong, and the kind of drift that
    # bites when a version bump changes a default. Verified accepted by
    # virt-install on fiend, 2026-08-15.
    [debian]="debian13"
    [ubuntu]="ubuntu24.04"
    [arch]="archlinux"
    # RHEL 10 first; older osinfo-dbs (CentOS 9 host, Fedora <43) won't know
    # rhel10.0 — the resolver below picks the closest available alternative.
    [rhel]="rhel10.0"
)

# _resolve_os_variants: replace any OS_VARIANTS entry that this host's
# osinfo-db doesn't know with the closest supported fallback. Prevents
# virt-install from exiting non-zero when we bump to a distro version
# newer than the host's osinfo-db package (e.g. klab targets fedora43
# on a CentOS 9 host whose osinfo-db tops out at fedora42).
# _osvariant_known: is this --os-variant value usable on THIS host?
#
# Two oracles, in order of cost. osinfo-query is exact and fast but is a
# separate package that is frequently absent -- and its absence used to make
# the whole resolver give up (`command -v osinfo-query || return 0`), leaving
# an unknown variant in place for virt-install to choke on. virt-install itself
# is always present, since we are about to run it, so it is the reliable
# fallback: --print-xml resolves the variant and builds no VM.
#
# HISTORY: 2026-08-15, fiend. osinfo-query was not installed, the resolver
# returned immediately, and `--os-variant fedora44` reached virt-install on a
# host whose newest known Fedora was 42. It exited "Unknown OS name
# 'fedora44'", the golden never booted, and a 601 MB zvol was left behind with
# no domain and no @golden -- which vmxplore then showed as an orphan. The
# phase still reported "ztest goldens complete (5/5)".
#
# Args:    $1 — an os-variant short id
# Returns: 0 when virt-install will accept it.
# _register_golden — record a sealed golden in the kldload state DB.
# Args:    $1 — the golden's VM name.
# Returns: 0 always; failure is reported, never propagated.
#
# WHY: kldload-inventory builds the Ansible inventory from the vms table, so a
# golden that was never registered is invisible to every playbook — you cannot
# target what the inventory has not heard of. Clones made by kvm-clone have
# registered themselves for a long time; the goldens they are cloned FROM did
# not, which is why "run this against the lab" saw the clones and not their
# source.
#
# Non-fatal on purpose: a golden that built and sealed correctly must not be
# failed by a bookkeeping error. But the miss IS logged, because a silent one
# is exactly how the estate drifts out of step with the inventory.
_register_golden() {
    local _name="$1"
    command -v kldload-db >/dev/null 2>&1 || return 0
    kldload-db vm-register --name "$_name" --role klab-golden --status sealed >/dev/null 2>&1 ||
        warn "could not register ${_name} in the state DB — it will not appear in the Ansible inventory"
    return 0
}

_osvariant_known() {
    local _v="$1"
    if [[ -n "${_OSINFO_KNOWN:-}" ]]; then
        grep -qxF "$_v" <<<"$_OSINFO_KNOWN" && return 0
        return 1
    fi
    virt-install --osinfo "$_v" --print-xml --name _klabprobe \
        --memory 512 --disk none --boot hd >/dev/null 2>&1
}

_resolve_os_variants() {
    # Cache the exact list when the tool exists; otherwise _osvariant_known
    # probes virt-install per candidate, which is slower but always works.
    if command -v osinfo-query >/dev/null 2>&1; then
        _OSINFO_KNOWN="$(osinfo-query -f short-id os 2>/dev/null | awk 'NR>2 {print $1}')"
    fi
    command -v virt-install >/dev/null 2>&1 || return 0
    local _d _want _try _fallback _n
    for _d in "${!OS_VARIANTS[@]}"; do
        _want="${OS_VARIANTS[$_d]}"
        _osvariant_known "$_want" && continue
        _fallback=""
        case "$_want" in
        fedora*)
            # 44 is the target; osinfo-db lags it by a release or two.
            for _n in 44 43 42 41 40 39 38; do
                _try="fedora$_n"
                _osvariant_known "$_try" && {
                    _fallback="$_try"
                    break
                }
            done
            ;;
        ubuntu*)
            for _try in ubuntu24.04 ubuntu22.04 ubuntu20.04; do
                _osvariant_known "$_try" && {
                    _fallback="$_try"
                    break
                }
            done
            ;;
        debian*)
            for _try in debian13 debian12 debian11; do
                _osvariant_known "$_try" && {
                    _fallback="$_try"
                    break
                }
            done
            ;;
        centos-stream*)
            for _try in centos-stream9 centos-stream8 centos9; do
                _osvariant_known "$_try" && {
                    _fallback="$_try"
                    break
                }
            done
            ;;
        rhel*)
            # RHEL 10 → 9.4 → CentOS Stream 10 → CentOS Stream 9 — close enough
            # for virtio/UEFI hints. The guest still self-identifies correctly
            # via /etc/redhat-release; os-variant only affects libvirt defaults.
            for _try in rhel10.0 rhel9.4 rhel9.0 centos-stream10 centos-stream9; do
                _osvariant_known "$_try" && {
                    _fallback="$_try"
                    break
                }
            done
            ;;
        esac
        [[ -z "$_fallback" ]] && _osvariant_known "linux2022" && _fallback="linux2022"
        [[ -z "$_fallback" ]] && _fallback="linux"
        echo "[klab] os-variant '$_want' unknown to osinfo-db; using '$_fallback' for ${_d}" >&2
        OS_VARIANTS[$_d]="$_fallback"
    done
}
_resolve_os_variants

declare -A DISTRO_FAMILY=(
    [centos]="dnf"
    [rocky]="dnf"
    [fedora]="dnf"
    [rhel]="dnf"
    [debian]="apt"
    [ubuntu]="apt"
    [arch]="pacman"
)

# Auto-scale resources based on host hardware
_host_ram_mb=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 32768)
_host_cpus=$(nproc 2>/dev/null || echo 8)
_max_vms=${#DISTROS[@]}
# Sane fixed defaults for klab VMs. Goldens just install ZFS once and
# shut down — they don't need 8 GB. Test VMs running zfs-tests.sh
# don't use much memory either; the test suite is mostly disk + small
# in-kernel ZFS structures. Bug seen 2026-05-05: auto-scale was
# allocating up to 8 GB / 4 vCPU per golden which wasted host budget
# without any benefit. Override with RAM=8192 CPUS=4 klab golden ...
# if your test load actually needs it.
RAM="${RAM:-4096}"
CPUS="${CPUS:-2}"
# Auto-scale DOWN on tight hosts so we still boot. Reserve 8 GB for
# the host + N×RAM for the VMs we plan to run.
if [[ $((_host_ram_mb - 8000)) -lt $((_max_vms * RAM)) ]]; then
    RAM=2048
    CPUS=2
fi
DISK="${DISK:-40}"

# Hardware detection
NVIDIA_DETECTED=0
lspci 2>/dev/null | grep -qi nvidia && NVIDIA_DETECTED=1

# Secure Boot: detect OVMF with Secure Boot support + swtpm availability
SECBOOT_AVAILABLE=0
SWTPM_AVAILABLE=0
OVMF_SECBOOT=""
for f in /usr/share/OVMF/OVMF_CODE.secboot.fd \
    /usr/share/edk2/ovmf/OVMF_CODE.secboot.fd \
    /usr/share/OVMF/OVMF_CODE_4M.secboot.fd; do
    [[ -f "$f" ]] && {
        OVMF_SECBOOT="$f"
        SECBOOT_AVAILABLE=1
        break
    }
done
command -v swtpm >/dev/null 2>&1 && SWTPM_AVAILABLE=1

# Golden builds: BIOS boot (cloud images are MBR, no EFI partition).
# After golden is sealed with signed modules + MOK keys, clones also use BIOS
# since they inherit the same partition table. Secure Boot requires UEFI which
# requires EFI-capable images — a future enhancement for custom-built goldens.
VIRT_GOLDEN_BOOT_ARGS=()

# Clone/site boot args: Cloud images are MBR/BIOS, so clones use BIOS too.
# Secure Boot + UEFI is for the HOST (installed via kldload), not for klab VMs.
# klab VMs get security via MOK-signed modules + network isolation instead.
VIRT_BOOT_ARGS=()
VIRT_TPM_ARGS=()
if [[ $SWTPM_AVAILABLE -eq 1 ]]; then
    VIRT_TPM_ARGS+=(--tpm backend.type=emulator,backend.version=2.0,model=tpm-crb)
    echo "[klab] TPM 2.0: enabled (swtpm)"
fi

# inject_mok_into_nvram — Pre-enroll MOK key into a VM's UEFI NVRAM so Secure Boot
# works without interactive MokManager prompt. Called after clone, before first boot.
inject_mok_into_nvram() {
    local vm_name="$1" golden_name="$2"
    [[ $SECBOOT_AVAILABLE -eq 0 ]] && return 0

    # Get the golden VM's IP to fetch its MOK DER key
    local golden_ip
    golden_ip="$(get_vm_ip "$golden_name" 2>/dev/null || echo "")"

    # If golden is shut down, extract MOK key from the zvol directly
    local mok_der="/tmp/klab-mok-${golden_name}.der"
    if [[ -n "$golden_ip" ]] && _ssh_cmd "$golden_ip" "test -f /var/lib/dkms/mok.der" 2>/dev/null; then
        scp -o StrictHostKeyChecking=no "root@${golden_ip}:/var/lib/dkms/mok.der" "$mok_der" 2>/dev/null
    else
        # Try to get it from the sealed golden's zvol via guestfish/virt-cat
        local _distro="${golden_name##*-}"
        local gpath
        gpath="$(zvol_path "$(golden_name "$_distro")")"
        local gdev
        gdev="$(zvol_dev "$(golden_name "$_distro")")"
        if command -v virt-cat >/dev/null 2>&1 && [[ -b "$gdev" ]]; then
            virt-cat -a "$gdev" /var/lib/dkms/mok.der >"$mok_der" 2>/dev/null || true
        fi
    fi

    # If we got the MOK DER key, try to inject it into the clone VM's NVRAM
    if [[ -f "$mok_der" && -s "$mok_der" ]]; then
        # Use virt-fw-vars (python3-virt-firmware) to add MOK to UEFI NVRAM
        local nvram_path
        nvram_path="$(virsh dumpxml "$vm_name" 2>/dev/null | grep -oP '(?<=<nvram>)[^<]+' || true)"
        if [[ -n "$nvram_path" && -f "$nvram_path" ]] && command -v virt-fw-vars >/dev/null 2>&1; then
            virt-fw-vars --input "$nvram_path" --output "$nvram_path" \
                --enroll-cert "$mok_der" --no-microsoft --secure-boot 2>/dev/null &&
                log "    MOK auto-enrolled into NVRAM for ${vm_name}" ||
                log "    MOK NVRAM injection not available — MokManager will prompt (password: kldload)"
        else
            log "    virt-fw-vars not available — MOK enrollment via MokManager (password: kldload)"
        fi
        rm -f "$mok_der"
    else
        log "    No MOK key found for ${golden_name} — Secure Boot modules may not load"
    fi
}

# ── Colors ────────────────────────────────────────────────────────────────
C="\033[1;36m"
G="\033[1;32m"
Y="\033[1;33m"
R="\033[1;31m"
W="\033[1;37m"
D="\033[0;37m"
N="\033[0m"
B="\033[1;34m"

_ensure_log_dir() { mkdir -p "$RESULTS_DIR" 2>/dev/null; }
_ts() { date '+%Y-%m-%d %H:%M:%S'; }
# log() writes to stderr — NOT stdout — because helper functions
# (ensure_ssh_key, make_cloud_init_iso, …) call log() and are themselves
# captured via $(...) at call sites. With log to stdout the captured
# variable contained "[klab] Generating SSH key.../var/lib/libvirt/isos/…"
# which leaked into virt-install's --disk path= argument. libvirt's XML
# parser then choked on the embedded ANSI codes and reported a misleading
# "Could not define storage pool: missing storage pool target path".
# Bug seen 2026-05-04 on .109 fiend klab golden centos build. warn() and
# die() already write to stderr — log() now matches.
log() {
    _ensure_log_dir
    echo -e "${G}[klab]${N} $*" >&2
    echo "[${$}] $(_ts) [INFO] $*" >>"$MASTER_LOG" 2>/dev/null
}
warn() {
    _ensure_log_dir
    echo -e "${Y}[klab]${N} $*" >&2
    echo "[${$}] $(_ts) [WARN] $*" >>"$MASTER_LOG" 2>/dev/null
}
die() {
    _ensure_log_dir
    echo -e "${R}[klab]${N} $*" >&2
    echo "[${$}] $(_ts) [FATAL] $*" >>"$MASTER_LOG" 2>/dev/null
    exit 1
}
pause() {
    echo ""
    echo -ne "${D}  Press Enter to continue...${N}"
    read -r
}

# ── Section 2: Helpers ───────────────────────────────────────────────────

_ssh_cmd() {
    local ip="$1"
    shift
    # SSH options shared by both auth paths.
    #   StrictHostKeyChecking=no — allow first connection
    #   UserKnownHostsFile=/dev/null — IPs get reused across test runs and
    #     each new VM has a fresh host key; without this, the second run
    #     hits "WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED" and the
    #     SSH command is refused outright.
    #   LogLevel=ERROR — suppress the "Permanently added" warning that
    #     would otherwise pollute every test stream line.
    local _opts=(
        -o StrictHostKeyChecking=no
        -o UserKnownHostsFile=/dev/null
        -o LogLevel=ERROR
        -o ServerAliveInterval=30
        -o ServerAliveCountMax=120
    )
    # Try key auth first — probe stdin must be /dev/null so it never consumes
    # the caller's heredoc stdin (the bug that broke Fedora/Debian/Ubuntu goldens)
    if ssh "${_opts[@]}" -o ConnectTimeout=5 -o BatchMode=yes \
        -i "$SSH_KEY" "root@${ip}" true </dev/null 2>/dev/null; then
        ssh "${_opts[@]}" -o ConnectTimeout=10 -i "$SSH_KEY" "root@${ip}" "$@"
    else
        sshpass -p kldload ssh "${_opts[@]}" -o ConnectTimeout=10 "root@${ip}" "$@"
    fi
}

get_vm_ip() {
    local vm="$1" ip="" mac=""
    # Get MAC of the running VM — needed to filter DHCP leases + ARP so
    # we don't pick up ghost IPs from destroyed VMs that shared the same
    # hostname (libvirt's DHCP leases persist forever on `virsh destroy`;
    # `net-dhcp-leases default | grep klab-test-fedora` returns every IP
    # fedora has ever been given, plus the current one, sometimes with
    # the ghost sorted first). Filtering by the VM's CURRENT MAC is the
    # only reliable disambiguator.
    mac="$(virsh domiflist "$vm" 2>/dev/null | awk '/bridge|network/ {print $5}' | head -1)"
    for _ in $(seq 1 90); do
        # Method 1: QEMU guest agent — authoritative (asks the running VM
        # directly, ignoring any stale lease). Filter:
        #   - loopback (lo) → returns 127.0.0.1 from the VM's own /
        #   - non-ethernet interfaces
        # Only take the FIRST global-scope v4 on a non-loopback iface.
        ip="$(virsh domifaddr "$vm" --source agent 2>/dev/null |
            awk '$1 ~ /^(en|eth|ens|eno|enp)/ && /ipv4/ {print $4; exit}' |
            cut -d/ -f1)"
        if [[ -n "$ip" && "$ip" != "127.0.0.1" ]]; then break; fi
        # Method 2: lease — but filter by THIS VM's MAC so we don't pick a
        # ghost row that matches only on the `klab-test-<distro>` hostname.
        if [[ -n "$mac" ]]; then
            ip="$(virsh net-dhcp-leases default 2>/dev/null |
                awk -v m="${mac,,}" 'tolower($0) ~ m {print $5; exit}' |
                cut -d/ -f1)"
            if [[ -n "$ip" && "$ip" != "127.0.0.1" ]]; then
                # Verify the IP is actually live — a ghost lease on a destroyed
                # VM may still match the MAC if the VM was re-created with the
                # same MAC (not normally, but cloned libvirt XML can do it).
                if ping -c1 -W1 "$ip" >/dev/null 2>&1; then break; fi
                ip=""
            fi
        fi
        # Method 3: ARP table (populated by recent traffic from the VM).
        if [[ -n "$mac" ]]; then
            ip="$(ip neigh 2>/dev/null | awk -v m="${mac,,}" 'tolower($0) ~ m && /REACHABLE|STALE/ {print $1; exit}')"
            [[ -z "$ip" ]] &&
                ip="$(arp -n 2>/dev/null | awk -v m="${mac,,}" 'tolower($0) ~ m {print $1; exit}')"
            if [[ -n "$ip" && "$ip" != "127.0.0.1" ]]; then break; fi
        fi
        # Method 4: nmap ping sweep of virbr0 subnet to populate ARP, then
        # re-look. Swallow stderr so the log doesn't fill with nmap banner.
        if [[ -z "$ip" && -n "$mac" ]]; then
            nmap -sn 192.168.122.0/24 >/dev/null 2>&1 ||
                ping -c1 -b 192.168.122.255 >/dev/null 2>&1 || true
            ip="$(arp -n 2>/dev/null | awk -v m="${mac,,}" 'tolower($0) ~ m {print $1; exit}')"
            if [[ -n "$ip" && "$ip" != "127.0.0.1" ]]; then break; fi
        fi
        sleep 2
    done
    echo "$ip"
}

wait_for_ssh() {
    local ip="$1" max="${2:-150}"
    local i=0
    while ! _ssh_cmd "$ip" true 2>/dev/null; do
        ((i++))
        [[ $i -ge $max ]] && return 1
        sleep 2
    done
    return 0
}

ensure_ssh_key() {
    if [[ ! -f "$SSH_KEY" ]]; then
        log "Generating SSH key..."
        ssh-keygen -t ed25519 -f "$SSH_KEY" -N "" -q
    fi
}

timer_start() { date +%s%N; }
timer_elapsed_ms() {
    local start="$1" now
    now=$(date +%s%N)
    echo $(((now - start) / 1000000))
}

# Golden naming honors KLAB_GOLDEN_KIND env:
#   unset / "regular" → klab-golden-<distro>   (lean, blue-green)
#   "ztest"           → klab-ztest-<distro>    (full ZFS test deps)
# Each distro has exactly one version at a time (CentOS 9 Stream,
# Fedora 44, Debian 13, Ubuntu 24.04, Rocky 9) — no versioned slug.
golden_name() {
    case "${KLAB_GOLDEN_KIND:-regular}" in
    ztest) echo "${PREFIX}-ztest-${1}" ;;
    desktop) echo "${PREFIX}-desktop-${1}" ;;
    *) echo "${PREFIX}-golden-${1}" ;;
    esac
}

# set_guest_arc_cap — stop the guest caching what the host already cached.
#
# THE PROBLEM, which is specific to ZFS-on-ZFS and easy to miss: every golden
# installs zfs-dkms, so every clone runs its own ARC. The guest's disk is a
# zvol whose blocks are ALREADY in the host's ARC (rpool/vms is
# primarycache=all). So the same data is held twice — once by the host for the
# zvol, once by the guest for its filesystem — and the second copy is bought
# with the guest's own memory. OpenZFS defaults zfs_arc_max to HALF of RAM, so
# a 2 GB desktop VM hands 1 GB of its 2 GB to a cache that is duplicating the
# hypervisor's.
#
# HISTORY: the host-side version of this cost a working desktop already —
# 2026-08-13, zfs.conf said 31.3G on a 61.7G box, ARC took 21.6 GB, free
# memory fell to 6 GB and the machine was reported frozen. Inside a 2 GB guest
# the same mistake is proportionally far worse.
#
# WHY THE HOST KEEPS primarycache=all AND THE GUEST SHRINKS, not the reverse:
# clones share the golden's blocks. One cached copy on the host serves five
# clones; five guest ARCs cache five private copies of the same thing. The
# host cache is the one with leverage.
#
# WHY modprobe.d IS ENOUGH HERE, when kldload's own bootloader.sh insists on a
# kernel command-line parameter instead: on a kldload host the ROOT is ZFS, so
# zfs.ko loads from the initramfs before /etc/modprobe.d on the real root is
# readable, and an initramfs built at the wrong moment silently drops the
# setting. These guests boot ext4/xfs roots on a zvol and load zfs.ko normally
# afterwards, so modprobe.d is read every time.
#
# Args:    $1 — guest IP, $2 — distro
# Returns: 0 always. A cache setting is never worth failing a golden over.
set_guest_arc_cap() {
    local ip="$1" distro="$2"
    local mb="${KLAB_GUEST_ARC_MB:-256}"
    log "  Capping guest ARC at ${mb}MB on ${distro} (host ARC already caches the zvol)..."
    _ssh_cmd "$ip" bash -s -- "$mb" <<'ARCCAP'
set -uo pipefail
MB="${1:-256}"
BYTES=$((MB * 1024 * 1024))
mkdir -p /etc/modprobe.d
printf '# klab: the host ARC already caches this zvol; a second copy here is\n# pure duplication paid for with this guest RAM. Override: KLAB_GUEST_ARC_MB.\noptions zfs zfs_arc_max=%s\n' \
    "$BYTES" >/etc/modprobe.d/zfs-arc.conf
# Apply to the running module too, so a golden sealed without a reboot is
# already correct rather than correct-on-next-boot.
if [ -w /sys/module/zfs/parameters/zfs_arc_max ]; then
    echo "$BYTES" >/sys/module/zfs/parameters/zfs_arc_max 2>/dev/null || true
fi
echo "klab: guest zfs_arc_max=${BYTES} (${MB}MB)"
ARCCAP
    return 0
}

# setup_vm_desktop — put a GNOME desktop on a golden that is otherwise built.
#
# WHY A SEPARATE GOLDEN LINEAGE: a desktop is ~6 GB of packages and about five
# minutes of install. Paying that once per distro and then cloning is the whole
# point — a clone off a golden costs 17-460 MB and 0.2s (measured on this host,
# 2026-08-15), so the second desktop VM and the fiftieth are both instant.
#
# Args:    $1 — guest IP, $2 — distro
# Returns: 0 even when the desktop fails. The golden is still a working server
#          and the caller's own failure handling is about the base build.
#
# NOTES — two rules learned the hard way on 2026-08-15, VM "fed":
#
#   1. NEVER name the display manager when the packages already chose one.
#      Fedora 44's KDE ships plasmalogin, not sddm, and `systemctl enable sddm`
#      on top of it EXITS NON-ZERO. Under `set -e` that killed the script
#      before `set-default graphical.target` ever ran, and the guest booted to
#      a text login with a complete desktop installed. Read
#      display-manager.service and respect what is already there.
#
#   2. NOTHING here may abort the rest. Every step tolerates its own failure,
#      because the step after it is the one that matters.
setup_vm_desktop() {
    local ip="$1" distro="$2"
    local family="${DISTRO_FAMILY[$distro]}"

    # NOTE: wireguard-tools, node_exporter and the eBPF tools are NOT installed
    # here — setup_vm_golden already installs them for every golden, so a
    # desktop is joined to the estate exactly like the rest of the fleet.
    # qemu-guest-agent is in that same common list (added 2026-08-15).
    #
    # NOT the NVIDIA driver. These guests have <video model='virtio'> and no
    # NVIDIA device: the host card does not reach a VM without VFIO
    # passthrough (exclusive to one guest) or vGPU (datacenter cards only,
    # which an RTX 3080 is not). Installing the kmod with no device to bind is
    # a black-screen risk for exactly the reason `systemctl enable sddm` was —
    # configuring something that does not apply, and breaking the login on the
    # way. Accelerated graphics here is mesa + virtio-gpu, which GNOME pulls.
    log "  Installing GNOME on ${distro} (~5 min, ~6GB)..."
    case "$family" in
    dnf)
        # workstation-product-environment, NOT workstation-product: the latter
        # is "Workstation product CORE" — a shell and nothing else. A guest
        # built from it came up with no terminal, no file manager and no
        # browser. Verified id on Fedora and EL10 alike.
        _ssh_cmd "$ip" bash -s <<'DESKTOPDNF'
set -uo pipefail
dnf group install -y workstation-product-environment ||
    echo "klab: GNOME group install FAILED — this golden stays a server" >&2
DESKTOPDNF
        ;;
    apt)
        # task-gnome-desktop pulls gdm3 itself. noninteractive or tasksel stops
        # to ask about keyboard layout and waits forever with nobody at the
        # console.
        _ssh_cmd "$ip" bash -s <<'DESKTOPAPT'
set -uo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq || true

# THE GENERIC KERNEL FIRST — a desktop cannot render on the cloud kernel.
#
# Debian's genericcloud base image ships linux-image-cloud-amd64, and that
# flavour is built WITHOUT the DRM subsystem: no drm.ko, no drm_kms_helper,
# no virtio_gpu, no bochs. That is deliberate — cloud images are headless —
# but it means no /dev/dri, no framebuffer, and X exits immediately no
# matter how complete the GNOME install on top of it is.
#
# Measured on a klab-desktop-debian clone (.107, 2026-08-22): GNOME fully
# installed with gnome.desktop and gnome-xorg.desktop present,
# graphical.target active, gdm3 active — and zero GUI processes, because
#   Xorg: "Server terminated with error (1)"
#   gdm3: "GdmLocalDisplayFactory: maximum number of X display failures"
# The vmxplore Screen console for those clones was a black rectangle. The
# desktop goldens had never once rendered a desktop.
#
# linux-image-amd64 is the generic flavour and carries the DRM stack. It is
# installed BEFORE the desktop task so the reboot at the end of provisioning
# comes up on a kernel that can actually drive a display.
apt-get install -y linux-image-amd64 ||
    echo "klab: generic kernel install FAILED — desktop will not render" >&2

apt-get install -y task-gnome-desktop ||
    echo "klab: GNOME task install FAILED — this golden stays a server" >&2

# VERIFY THE OUTCOME, not the exit code. apt returns 0 for plenty of states
# that leave no usable kernel, and a silently headless desktop golden is the
# exact defect this block exists to prevent.
_kver="$(dpkg -l 'linux-image-[0-9]*' 2>/dev/null | awk '/^ii/{print $2}' |
    grep -v cloud | sed 's/^linux-image-//' | sort -V | tail -1)"
if [ -n "$_kver" ] && [ -e "/lib/modules/${_kver}/kernel/drivers/gpu/drm" ]; then
    echo "klab: DRM present in ${_kver} — desktop can render"
else
    echo "klab: WARNING no DRM modules in any installed kernel — desktop will be a black screen" >&2
fi
DESKTOPAPT
        ;;
    *)
        warn "  no GNOME recipe for family ${family} — ${distro} golden stays a server"
        return 0
        ;;
    esac

    # Enable it. Distro-agnostic on purpose: this is pure systemd and works
    # the same on every family, so there is one copy of the tricky part.
    _ssh_cmd "$ip" bash -s <<'DESKTOPENABLE'
set -uo pipefail
if [ -e /etc/systemd/system/display-manager.service ]; then
    dm=$(basename "$(readlink -f /etc/systemd/system/display-manager.service)")
    echo "klab: display manager already enabled by the packages: ${dm}"
else
    dm=""
    for c in gdm gdm3 sddm lightdm; do
        if systemctl list-unit-files "${c}.service" >/dev/null 2>&1 &&
            systemctl enable "$c" >/dev/null 2>&1; then
            dm="${c}.service"
            echo "klab: enabled ${c}"
            break
        fi
    done
    [ -n "$dm" ] || echo "klab: no display manager found — the desktop will not start" >&2
fi
systemctl set-default graphical.target ||
    echo "klab: could not set graphical.target" >&2
DESKTOPENABLE
    return 0
}
site_name() { echo "${PREFIX}-${1}-${2}"; } # site_name blue centos
test_vm_name() { echo "${PREFIX}-test-${1}"; }
zvol_path() { echo "${POOL}/vms/${1}"; }
zvol_dev() { echo "/dev/zvol/${POOL}/vms/${1}"; }

validate_distro() {
    local d="$1"
    for valid in "${DISTROS[@]}"; do
        [[ "$d" == "$valid" ]] && return 0
    done
    die "Unknown distro: ${d}. Valid: ${DISTROS[*]}"
}

validate_site() {
    local s="$1"
    [[ "$s" == "blue" || "$s" == "green" ]] || die "Invalid site: ${s}. Must be blue or green."
}

golden_exists() {
    zfs list "$(zvol_path "$(golden_name "$1")")@golden" >/dev/null 2>&1
}

make_cloud_init_iso() {
    local name="$1" hostname="$2" ready_marker="${3:-}" static_ip="${4:-}"

    ensure_ssh_key
    local pubkey
    pubkey="$(cat "${SSH_KEY}.pub")"

    local ci_dir ci_iso
    ci_dir="$(mktemp -d)"
    ci_iso="${ISO_DIR}/${name}-cloud-init.iso"

    cat >"${ci_dir}/meta-data" <<META
instance-id: ${name}-$(date +%s)
local-hostname: ${hostname}
META

    local runcmd_extra=""
    [[ -n "$ready_marker" ]] && runcmd_extra="  - touch ${ready_marker}"
    # Static IP fallback via nmcli (cloud-init network-config often ignored on CentOS)
    local bootcmd_net=""
    if [[ -n "$static_ip" ]]; then
        bootcmd_net="  - nmcli con mod 'cloud-init eth0' ipv4.method manual ipv4.addresses ${static_ip}/24 ipv4.gateway 192.168.122.1 ipv4.dns 192.168.122.1 2>/dev/null || nmcli con mod 'System eth0' ipv4.method manual ipv4.addresses ${static_ip}/24 ipv4.gateway 192.168.122.1 ipv4.dns 192.168.122.1 2>/dev/null || ip addr add ${static_ip}/24 dev eth0 2>/dev/null || ip addr add ${static_ip}/24 dev enp1s0 2>/dev/null || true
  - nmcli con up 'cloud-init eth0' 2>/dev/null || nmcli con up 'System eth0' 2>/dev/null || true"
    fi

    cat >"${ci_dir}/user-data" <<USERDATA
#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
disable_root: false
ssh_pwauth: true
package_update: false
# CRITICAL ORDERING NOTE:
#   bootcmd runs BEFORE sshd.service fully comes up. firewalld (CentOS/Rocky/
#   Fedora) and ufw (Debian/Ubuntu) block port 22 by default on cloud images;
#   if we wait until runcmd to kill them, klab's wait_for_ssh times out.
#   So: firewall kill + sshd config BOTH go in bootcmd. sshd will pick up
#   the drop-in config when cloud-init finishes bootcmd and sshd starts.
chpasswd:
  expire: false
  list: |
    root:kldload
bootcmd:
  # Open the door BEFORE sshd gets a chance to sit behind a closed firewall
  - [ sh, -c, "systemctl stop firewalld 2>/dev/null; systemctl disable firewalld 2>/dev/null; systemctl mask firewalld 2>/dev/null; true" ]
  - [ sh, -c, "systemctl stop ufw 2>/dev/null; systemctl disable ufw 2>/dev/null; ufw --force disable 2>/dev/null; true" ]
  # Unlock root + write sshd drop-in. No restart needed — sshd reads
  # sshd_config.d/*.conf on its first start after cloud-init.
  - [ sh, -c, "passwd -uf root 2>/dev/null; true" ]
  - [ sh, -c, "mkdir -p /etc/ssh/sshd_config.d && printf 'PermitRootLogin yes\\nPasswordAuthentication yes\\n' > /etc/ssh/sshd_config.d/99-klab.conf" ]
${bootcmd_net}
${runcmd_extra}
ssh_authorized_keys:
  - ${pubkey}
runcmd:
  # Belt-and-suspenders — if bootcmd failed somehow, fire these late too.
  - [ sh, -c, "systemctl stop firewalld 2>/dev/null; systemctl mask firewalld 2>/dev/null; true" ]
  - [ sh, -c, "systemctl restart sshd 2>/dev/null || systemctl restart ssh 2>/dev/null || true" ]
USERDATA

    if [[ -n "$static_ip" ]]; then
        cat >"${ci_dir}/network-config" <<NETCFG
version: 2
ethernets:
  id0:
    match:
      name: "en*"
    addresses:
      - ${static_ip}/24
    routes:
      - to: default
        via: 192.168.122.1
    nameservers:
      addresses: [192.168.122.1, 8.8.8.8]
  id1:
    match:
      name: "eth*"
    addresses:
      - ${static_ip}/24
    routes:
      - to: default
        via: 192.168.122.1
    nameservers:
      addresses: [192.168.122.1, 8.8.8.8]
NETCFG
    else
        cat >"${ci_dir}/network-config" <<NETCFG
version: 2
ethernets:
  id0:
    match:
      name: "en*"
    dhcp4: true
  id1:
    match:
      name: "eth*"
    dhcp4: true
  id2:
    match:
      driver: "virtio*"
    dhcp4: true
NETCFG
    fi

    genisoimage -output "$ci_iso" -volid cidata -joliet -rock \
        "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null ||
        xorriso -as mkisofs -o "$ci_iso" -volid cidata -joliet -rock \
            "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null

    rm -rf "$ci_dir"
    echo "$ci_iso"
}

# ── Section 3: RHEL Credentials ──────────────────────────────────────────

_fetch_rhel_cloud_image_via_api() {
    # NOTE (build #50): This function is DEFUNCT but kept for reference.
    # Red Hat disabled `grant_type=password` for the rhsm-api SSO client
    # (returns: `unauthorized_client / Client not allowed for direct
    # access grants`). The only way to programmatically download a pre-
    # built RHEL Cloud Image via the API is now via an offline token
    # (user generates at access.redhat.com/management/api), which is a
    # poor UX. kldload pivoted to osbuild-composer instead -- see
    # kldload-rhel-composer-build, which uses the host's entitlement
    # certs to assemble a custom qcow2 from cdn.redhat.com content.
    #
    # The function below will still attempt the password-grant flow and
    # log the actual error to /var/log/klab/rhel-image-fetch.log if
    # invoked. Useful for: (a) confirming the API is still dead, (b)
    # future revival if RH ever re-enables the password grant.
    #
    # Use the saved RHEL_USERNAME/PASSWORD to download the latest RHEL 10
    # KVM Guest Image qcow2 via the Customer Portal Images API.
    #
    # Three-step flow:
    #   1. POST to sso.redhat.com to exchange username+password for a
    #      ~15-min bearer (grant_type=password, client_id=rhsm-api)
    #   2. GET api.access.redhat.com/management/v1/images filtered for
    #      RHEL 10 + imageType=qcow2 -- pick the newest by version
    #   3. GET .../images/<checksum>/download -- follows redirect to the
    #      actual blob, streams to disk
    #
    # Output path: default /var/lib/klab/images/rhel-10-cloud.qcow2,
    # overridable by setting $1.
    #
    # Logs to /var/log/klab/rhel-image-fetch.log. Tokens + creds are
    # never logged or echoed to stdout (sed-scrubbed on any line that
    # might quote them back).
    #
    # Returns: 0 = qcow2 landed at the output path
    #          1 = any failure (caller logs warn + skips). Currently
    #              always returns 1 because of the upstream API change.
    local out_path="${1:-/var/lib/klab/images/rhel-10-cloud.qcow2}"
    local out_dir
    out_dir="$(dirname "$out_path")"
    local log_file=/var/log/klab/rhel-image-fetch.log
    mkdir -p /var/log/klab "$out_dir"
    : >"$log_file"

    if ! command -v jq >/dev/null 2>&1; then
        echo "ERROR: jq not installed -- cannot parse API responses" >>"$log_file"
        return 1
    fi

    local sso=https://sso.redhat.com/auth/realms/redhat-external/protocol/openid-connect/token
    local api=https://api.access.redhat.com/management/v1

    echo "[$(date -u +%FT%TZ)] requesting bearer token from RH SSO" >>"$log_file"
    local token
    token=$(curl -s -X POST "$sso" \
        -d grant_type=password \
        -d client_id=rhsm-api \
        --data-urlencode "username=${RHEL_USERNAME}" \
        --data-urlencode "password=${RHEL_PASSWORD}" |
        jq -r '.access_token // empty')
    if [[ -z "$token" || "$token" == "null" ]]; then
        echo "ERROR: SSO token exchange failed (bad creds or SSO unreachable)" >>"$log_file"
        return 1
    fi
    echo "[$(date -u +%FT%TZ)] bearer acquired" >>"$log_file"

    # Page through images filtered to RHEL 10 + qcow2 + latest version.
    # The API returns a JSON array; we pick the one with the highest
    # version string that matches /^10\./. Using `sort -V` for proper
    # semver-style comparison so 10.10 > 10.9.
    echo "[$(date -u +%FT%TZ)] querying Image API for RHEL 10 qcow2" >>"$log_file"
    local images_json
    images_json=$(curl -s -H "Authorization: Bearer $token" \
        "${api}/images?filter=arch==x86_64;contentType==Image;imageType==qcow2;productCode==RHEL;version==10*&limit=50")
    if ! echo "$images_json" | jq -e '.body | length > 0' >/dev/null 2>&1; then
        echo "ERROR: Image API returned no matches; raw body:" >>"$log_file"
        echo "$images_json" | head -c 2000 >>"$log_file"
        return 1
    fi

    local checksum filename version
    read -r checksum filename version < <(
        echo "$images_json" | jq -r '
      .body
      | map(select(.imageType=="qcow2" and (.version|startswith("10."))))
      | sort_by(.version)
      | reverse
      | .[0]
      | "\(.checksum) \(.filename) \(.version)"'
    )
    if [[ -z "$checksum" || "$checksum" == "null" ]]; then
        echo "ERROR: could not pick an image from API response" >>"$log_file"
        return 1
    fi
    echo "[$(date -u +%FT%TZ)] selected RHEL ${version} qcow2: ${filename} (checksum=${checksum:0:12}...)" >>"$log_file"

    # Resolve the download URL (API returns a signed redirect). Use
    # -L to follow; redirect target may be on CDN host.
    local partial="${out_path}.partial"
    echo "[$(date -u +%FT%TZ)] downloading qcow2 to ${out_path} (several minutes)" >>"$log_file"
    if curl -fSL --retry 5 --retry-delay 10 --retry-all-errors \
        -H "Authorization: Bearer $token" \
        -C - -o "$partial" \
        "${api}/images/${checksum}/download" >>"$log_file" 2>&1; then
        mv -f "$partial" "$out_path"
        echo "[$(date -u +%FT%TZ)] download complete: $(du -h "$out_path" | cut -f1)" >>"$log_file"
        return 0
    else
        rm -f "$partial"
        echo "ERROR: download failed" >>"$log_file"
        return 1
    fi
}

cmd_fetch_rhel_image() {
    # CLI subcommand: pull the RHEL 10 KVM Guest Image qcow2 to a target
    # path using saved/env RHEL credentials. Designed for the kldload
    # installer to invoke during install (writes the qcow2 onto the
    # target before reboot, so first-boot has the 6th klab golden ready
    # without ever re-asking for creds).
    #
    # Usage:
    #   klab fetch-rhel-image --output /abs/path/to/rhel-10-cloud.qcow2
    #   RHEL_USERNAME=... RHEL_PASSWORD=... klab fetch-rhel-image
    local out=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --output | -o)
            out="$2"
            shift 2
            ;;
        -h | --help)
            cat <<'HELP'
klab fetch-rhel-image --output <PATH>

Downloads the latest RHEL 10 KVM Guest Image qcow2 via the RH Customer
Portal Images API using credentials from the environment or the saved
secrets store. Logs to /var/log/klab/rhel-image-fetch.log.

Required (via env or RHEL_CREDS_FILE / /var/lib/kldload/secrets):
  RHEL_USERNAME, RHEL_PASSWORD     (RH portal login)

Activation-key flows are NOT supported -- the RH API doesn't accept
activation keys, those are for subscription-manager only.

Exit codes:
  0  qcow2 written to --output path
  1  any failure (see log file)
HELP
            return 0
            ;;
        *) die "unknown arg to fetch-rhel-image: $1" ;;
        esac
    done
    _rhel_prompt_creds || die "RHEL credentials not available (set RHEL_USERNAME + RHEL_PASSWORD)"
    [[ -n "$RHEL_USERNAME" && -n "$RHEL_PASSWORD" ]] ||
        die "fetch-rhel-image requires username+password (not activation key)"
    _fetch_rhel_cloud_image_via_api "$out"
}

_rhel_creds_shred() {
    # Pass-through-and-shred. Called after a successful RHEL golden
    # build. Removes the four secret-store files + the legacy
    # .klab-rhel-creds env file. `shred -u` overwrites then unlinks
    # (defence against fs-level recovery on the secrets ZFS dataset).
    # Errors are logged but never fatal -- if a file's already gone
    # because the operator already cleaned up, that's fine.
    local sec=/var/lib/kldload/secrets
    for f in rhel-username rhel-password rhel-activation-key rhel-organization; do
        if [[ -f "${sec}/${f}" ]]; then
            shred -u "${sec}/${f}" 2>/dev/null || rm -f "${sec}/${f}"
        fi
    done
    if [[ -f /root/.klab-rhel-creds ]]; then
        shred -u /root/.klab-rhel-creds 2>/dev/null || rm -f /root/.klab-rhel-creds
    fi
    log "  RHEL creds shredded (pass-through model: needed only for golden build)"
}

_rhel_prompt_creds() {
    # Credential source priority (all non-interactive — firstboot-safe):
    #   1. Env vars set by caller
    #   2. Legacy RHEL_CREDS_FILE on disk
    #   3. ZFS-encrypted secrets dataset via `kldload-db` (the dashboard UI
    #      writes there — "rhel-username" / "rhel-password" / "rhel-activation-key")
    #   4. Nothing → skip RHEL gracefully (exit 0 so klab golden all keeps going)
    # Interactive prompting was removed — it broke unattended firstboot.
    if [[ -n "$RHEL_USERNAME" && -n "$RHEL_PASSWORD" ]]; then
        log "  Using RHEL credentials from environment"
        return 0
    fi
    if [[ -f "$RHEL_CREDS_FILE" ]]; then
        source "$RHEL_CREDS_FILE"
        if [[ -n "$RHEL_USERNAME" && -n "$RHEL_PASSWORD" ]]; then
            log "  Using cached RHEL credentials"
            return 0
        fi
    fi
    # Try the encrypted secrets dataset (set from the web UI dashboard panel)
    local _sec_dir="/var/lib/kldload/secrets"
    if [[ -r "${_sec_dir}/rhel-username" && -r "${_sec_dir}/rhel-password" ]]; then
        RHEL_USERNAME="$(cat "${_sec_dir}/rhel-username")"
        RHEL_PASSWORD="$(cat "${_sec_dir}/rhel-password")"
        log "  Using RHEL credentials from encrypted secrets store"
        return 0
    fi
    # Activation key variant — still counts as "have creds"
    if [[ -r "${_sec_dir}/rhel-activation-key" ]]; then
        RHEL_USERNAME=""
        RHEL_PASSWORD=""
        RHEL_ACTIVATION_KEY="$(cat "${_sec_dir}/rhel-activation-key")"
        log "  Using RHEL activation key from encrypted secrets store"
        return 0
    fi
    warn "  No RHEL credentials — skipping RHEL golden (add creds via Dashboard → RHEL Subscription)"
    return 2 # non-zero but distinct from hard failure; caller should skip not abort
    log "  Credentials cached at ${RHEL_CREDS_FILE} (0600)"
    return 0
}

# ── Section 4: Per-Distro Setup ──────────────────────────────────────────
# Installs ZFS + test suite + eBPF + dev tools + node_exporter on golden VMs.
# Unified from kzfs-test (ZFS-focused) and kzfs-lab (dev-focused).

setup_vm_golden() {
    local ip="$1" distro="$2"
    local family="${DISTRO_FAMILY[$distro]}"
    # KLAB_ZFS_DEV: "1" = include full dev/test tools (ksh, zfs-tests,
    # fio, pamtester, pax, cryptsetup, loopback vdevs, …). Default is "0"
    # so regular klab goldens stay small. The ZFS Test Suite has its own
    # `klab golden-ztest` command that sets this to "1" and produces
    # klab-ztest-<distro> images separate from klab-golden-<distro>.
    local dev_tools="${KLAB_ZFS_DEV:-0}"
    # want_zfs: 0 builds this golden WITHOUT ZFS in the guest.
    #
    # The desktop lineage turns it off. Those guests boot ext4/xfs on a zvol
    # and never mount a ZFS filesystem, so zfs-dkms buys them nothing and
    # costs three things that all matter for an image meant to be cloned:
    # a DKMS rebuild on every kernel update (the largest single failure
    # surface in a golden build), ~1-2 GB of toolchain and kernel-devel, and
    # a second ARC caching blocks the host already has (see
    # set_guest_arc_cap). Operator, 2026-08-15: "if we're gonna do the
    # desktops no zfs".
    #
    # KLAB_DESKTOP_ZFS=1 puts it back, for a desktop meant to demo zxplore
    # against real pools.
    local want_zfs=1
    if [[ "${KLAB_DESKTOP:-0}" == "1" && "${KLAB_DESKTOP_ZFS:-0}" != "1" ]]; then
        want_zfs=0
    fi

    # RHEL: register subscription before installing packages
    if [[ "$distro" == "rhel" && -n "$RHEL_USERNAME" && -n "$RHEL_PASSWORD" ]]; then
        log "  Registering RHEL subscription (credentials redacted)..."
        _ssh_cmd "$ip" bash -c "subscription-manager register --username='${RHEL_USERNAME}' --password='${RHEL_PASSWORD}' --auto-attach 2>&1 | sed 's/password=.*/password=REDACTED/g'" 2>&1 | sed "s/${RHEL_PASSWORD}/REDACTED/g"
    fi

    log "  Setting up environment on ${distro} (source: ${ZFS_SOURCE}, dev_tools: ${dev_tools})..."

    case "$family" in
    dnf)
        _ssh_cmd "$ip" bash -s -- "$dev_tools" "$want_zfs" <<'DNFSETUP'
set -e
KLAB_ZFS_DEV="${1:-1}"
# 0 = build this golden WITHOUT ZFS (the desktop lineage).
WANT_ZFS="${2:-1}"
# Disable ALL firewalling
systemctl stop firewalld 2>/dev/null || true
systemctl disable firewalld 2>/dev/null || true
systemctl mask firewalld 2>/dev/null || true
iptables -F 2>/dev/null || true
nft flush ruleset 2>/dev/null || true

# Ensure sshd stays accessible
mkdir -p /etc/ssh/sshd_config.d
echo -e 'PermitRootLogin yes\nPasswordAuthentication yes' > /etc/ssh/sshd_config.d/99-klab.conf 2>/dev/null || true
# ENABLE, not just restart, and under BOTH unit names.
#
# `restart` affects the session that is building the golden and nothing else:
# if the unit is not enabled, the clone boots with sshd down and is
# unreachable. Measured 2026-08-22 on .120 — klab-desktop-debian and
# klab-desktop-ubuntu clones both took a DHCP lease and refused port 22, with
# three host keys present, so it was never the host-key path.
#
# The name differs by family: Debian/Ubuntu ship ssh.service, RPM families
# sshd.service. This line only ever named sshd, so the Debian arm was a no-op
# even as a restart. Enabling both and tolerating the absent one covers the
# matrix without a distro case.
systemctl enable --now ssh 2>/dev/null || true
systemctl enable --now sshd 2>/dev/null || true

dnf install -y epel-release 2>/dev/null || true

# kernel-devel MUST match running kernel for DKMS
KVER=$(uname -r)
dnf install -y kernel-devel-${KVER} dkms gcc gcc-c++ make autoconf automake libtool git 2>/dev/null || \
  dnf install -y kernel-devel dkms gcc gcc-c++ make autoconf automake libtool git 2>/dev/null || true

# ZFS
DISTRO_ID=$(. /etc/os-release && echo "$ID")
# WANT_ZFS=0 skips ZFS entirely. The desktop lineage sets it: those guests
# boot ext4/xfs on a zvol and never mount a ZFS filesystem, so zfs-dkms
# there is a kernel module compiled on every kernel update, for nothing —
# and DKMS is the largest single failure surface in a golden build.
if [ "$WANT_ZFS" = "1" ] && ! command -v zfs >/dev/null 2>&1; then
  if [ "$DISTRO_ID" = "fedora" ]; then
    FEDORA_VER=$(rpm --eval "%{fedora}")
    # zfsonlinux.org/fedora publishes one zfs-release rpm per supported
    # Fedora version with its own pkg revision, and the revision number
    # is not stable across releases (e.g. fc42 is still on 2-8 while
    # fc43 jumped to 3-0). Try the known good revisions newest first so
    # we don't silently ship a Fedora golden with no ZFS installed.
    _ok=0
    for _rev in 3-0 2-10 2-9 2-8 2-7 2-6; do
      if dnf install -y "https://zfsonlinux.org/fedora/zfs-release-${_rev}.fc${FEDORA_VER}.noarch.rpm" 2>/dev/null; then
        _ok=1; break
      fi
    done
    # zfsonlinux.org typically lags Fedora releases by ~6 months —
    # fc44 (released April 2026) has no zfs-release rpm yet, only
    # fc43/fc42. Fall back to fc(N-1) → fc(N-2), then pin the .repo
    # file to that releasever so dnf doesn't expand $releasever to
    # the running fcN and 404 on missing-repo. Bug seen 2026-05-04
    # on fiend's klab golden fedora build: tried fc44 across all 6
    # revisions, all 404'd, golden built without ZFS — exact same
    # reason the kldload installer hardcodes the repo to fedora/43.
    if [ $_ok -eq 0 ]; then
      for _fb in $((FEDORA_VER - 1)) $((FEDORA_VER - 2)); do
        for _rev in 3-0 2-10 2-9 2-8; do
          if dnf install -y "https://zfsonlinux.org/fedora/zfs-release-${_rev}.fc${_fb}.noarch.rpm" 2>/dev/null; then
            sed -i "s|\$releasever|${_fb}|g" /etc/yum.repos.d/zfs.repo 2>/dev/null
            echo "klab: zfs-release pinned to fc${_fb} (no zfs-release rpm exists for fc${FEDORA_VER} yet)"
            _ok=1; break 2
          fi
        done
      done
    fi
    [ $_ok -eq 1 ] || echo "WARNING: no zfs-release rpm found — ZFS will not install"
  else
    dnf install -y "https://zfsonlinux.org/epel/zfs-release-2-3$(rpm --eval "%{dist}").noarch.rpm" 2>/dev/null || true
  fi
  if [ "$KLAB_ZFS_DEV" = "1" ]; then
    dnf install -y zfs zfs-dkms zfs-test 2>/dev/null || true
  else
    dnf install -y zfs zfs-dkms 2>/dev/null || true
  fi
fi
if [ "$KLAB_ZFS_DEV" = "1" ] && ! test -f /usr/share/zfs/zfs-tests.sh; then
  dnf install -y zfs-test 2>/dev/null || true
fi

# eBPF + essentials (always)
dnf install -y bpftrace bcc-tools wireguard-tools curl jq qemu-guest-agent 2>/dev/null || true
# qemu-guest-agent: IP reporting, a graceful shutdown the hypervisor can
# actually wait on, and fs-freeze — fs-freeze is what makes a snapshot of a
# RUNNING guest consistent rather than crash-consistent, which matters for an
# image whose whole purpose is being cloned. Verified missing on 2026-08-15:
# VM "fed" had no org.qemu.guest_agent channel, so `virsh domifaddr --source
# agent` returned nothing.
systemctl enable --now qemu-guest-agent 2>/dev/null || true

# Test suite deps + dev tools (only when KLAB_ZFS_DEV=1).
# The full OpenZFS test suite needs: ksh (run), fio/parted/attr/bc/acl
# (zpool ops), sysstat (mpstat for perf tests), net-tools (the `net`
# cmd tests reference), cryptsetup (native-encryption tests),
# nfs-utils (exportfs/nfs tests), bzip2 (bunzip2/bzcat used in log
# compression tests), xxhash (xxh128sum checksum tests), util-linux
# (pax equivalents). pamtester is rarely packaged; optional.
#
# Install per-package. Batching everything in one `dnf install` caused
# the whole transaction to abort (leaving ~everything uninstalled) the
# moment a single pkg was missing from the enabled repos — e.g. xxhash
# isn't in CentOS 9 base, so gdb/strace/net-tools etc. all vanished
# silently under the `|| true`. perf comes from kernel-tools on the
# rpm-based distros.
if [ "$KLAB_ZFS_DEV" = "1" ]; then
  # Enable EPEL up front on EL so xxhash / sg3_utils / pamtester / lsscsi
  # etc. all resolve in a single transaction below instead of silently
  # skipping. On Fedora epel-release is a no-op (no matching pkg) and
  # |true handles it.
  dnf install -y epel-release 2>/dev/null || true
  # CRB (CodeReady Builder) repo is where `pax` actually lives on
  # CentOS Stream 9 / Rocky / RHEL 9 — EPEL builds against it but
  # doesn't carry pax itself. Without this, the per-pkg loop below
  # silently fails on pax (|| true), the ZFS test runner reports
  # "Missing util(s): pax", and any test that tar-round-trips data
  # (50+ tests in the common+linux runfiles) gets SKIP.
  dnf config-manager --set-enabled crb 2>/dev/null || \
    dnf config-manager --set-enabled powertools 2>/dev/null || \
    dnf config-manager --set-enabled codeready-builder-for-rhel-9-$(uname -m)-rpms 2>/dev/null || true
  # Force a cache refresh so the per-pkg install loop below sees the
  # newly-enabled repos. Without this the first installs race on
  # stale metadata and pax (from CRB) fails to resolve.
  dnf makecache --timer 2>/dev/null || dnf makecache 2>/dev/null || true

  # Full OpenZFS test-suite dependency set — auditable, no SKIP-on-
  # missing-binary. Every pkg is installed individually so one missing
  # name on one distro never kills the rest. Per openzfs/zfs
  # tests/README.md + scripts/zfs-tests.sh runtime probes.
  #
  # kernel-modules-extra ships scsi_debug (+ dm-flakey, dm-delay, nbd).
  # Without it the entire functional/fault test suite marks setup FAIL
  # and cascade-SKIPs 14+ disk-failure tests. This turns those into
  # real PASS/FAIL signal. Match against running kernel so DKMS and
  # module tree are consistent.
  for _p in \
      "kernel-modules-extra-$(uname -r)" \
      ksh \
      fio \
      parted \
      attr acl bc sysstat \
      gdb strace \
      kernel-tools perf \
      pax util-linux-script \
      openssl openssl-devel zlib-devel \
      libuuid-devel libblkid-devel libtirpc-devel \
      net-tools nmap-ncat \
      nfs-utils rpcbind \
      psmisc lsof \
      stress-ng \
      rng-tools \
      man-db \
      cryptsetup \
      bzip2 xxhash \
      python3 \
      util-linux \
      pamtester \
      e2fsprogs xfsprogs dosfstools \
      rsync \
      samba samba-common samba-client \
      iscsi-initiator-utils targetcli \
      lsscsi sg3_utils \
      kpartx mdadm \
      procps-ng which \
      make gcc autoconf automake libtool \
      git \
      glibc-langpack-en glibc-all-langpacks \
      python3-pyzfs \
      ; do
    dnf install -y "$_p" 2>/dev/null || true
  done
  # Enable + start nfs-server (exportfs) so cli_root/zfs_share/* tests
  # can actually publish their shares. nfs-utils is installed above,
  # but the service needs to be running for exportfs -a to work.
  systemctl enable --now nfs-server 2>/dev/null || true
  systemctl enable --now rpcbind    2>/dev/null || true
  # Ensure en_US.UTF-8 is generated — casenorm/formd_* tests read the
  # iconv formd normalisation tables, which require a UTF-8 locale.
  localectl set-locale LANG=en_US.UTF-8 2>/dev/null || true
fi

# Load ZFS module
modprobe zfs || {
  ZFS_VER=$(rpm -q --qf '%{VERSION}' zfs-dkms 2>/dev/null || echo "")
  if [ -n "$ZFS_VER" ]; then
    dkms build -m zfs -v "$ZFS_VER" -k "$KVER" 2>&1 || true
    dkms install -m zfs -v "$ZFS_VER" -k "$KVER" 2>&1 || true
    depmod -a "$KVER" 2>/dev/null || true
    modprobe zfs 2>/dev/null || true
  fi
}

