#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════════
# klab — Multi-Distro Test Platform
# ══════════════════════════════════════════════════════════════════════════
#
# Turns any hardware into a one-click multi-distro test bay. Golden images
# for 7 Linux distros, ZFS instant clones (~75ms per VM), blue-green
# deployment, pluggable payloads (ZFS tests, Kubernetes, custom playbooks),
# full observability stack (Prometheus/Grafana/Loki), eBPF tracing, and
# NVIDIA GPU support when detected.
#
# Architecture:
#   Golden images → ZFS clones → Blue/Green sites → Payloads → Results
#   Each golden is built once (cloud image + ZFS + eBPF + dev tools),
#   then cloned instantly for every test run. Blue-green lets you test
#   changes in green while blue stays as the known-good baseline.
#
# Distros:  CentOS Stream 9, Rocky 9, Fedora 43, Debian 13, Ubuntu 24.04,
#           Arch Linux (+RHEL 9 via CentOS clone + subscription)
#
# Usage:
#   klab                                    Interactive menu
#   klab golden [distro|all]                Build golden images
#   klab deploy blue|green                  Clone goldens to site
#   klab promote green                      Green becomes new blue
#   klab rollback                           Revert blue to previous
#   klab test [--quick|--full] [--distro d] Run OpenZFS test suite
#   klab kubernetes [--workers N]           Deploy K8s cluster from clones
#   klab run-playbook /path/to/script.sh    Run custom payload on all VMs
#   klab verify [distro|all]                Smoke test goldens
#   klab status                             Full status display
#   klab destroy blue|green|all|goldens     Tear down
set -uo pipefail

if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi

# ── Section 1: Configuration ─────────────────────────────────────────────
POOL="${POOL:-rpool}"
PREFIX="klab"
SSH_KEY="${SSH_KEY:-/root/.ssh/id_ed25519}"
ISO_DIR="/var/lib/libvirt/isos"
RESULTS_DIR="/root/klab"
MASTER_LOG="${RESULTS_DIR}/klab.log"

# ZFS source mode: "repo" (default), "version:X.Y.Z", "git:owner/repo@ref", "tarball:/path"
ZFS_SOURCE="${ZFS_SOURCE:-repo}"

DISTROS=(centos rocky fedora debian ubuntu rhel)

# RHEL credentials — prompted at runtime, never logged or stored on disk
RHEL_USERNAME="${RHEL_USERNAME:-}"
RHEL_PASSWORD="${RHEL_PASSWORD:-}"
RHEL_CREDS_FILE="/root/.klab-rhel-creds"

declare -A CLOUD_IMAGES=(
  [centos]="https://cloud.centos.org/centos/9-stream/x86_64/images/CentOS-Stream-GenericCloud-9-latest.x86_64.qcow2"
  [rocky]="https://dl.rockylinux.org/pub/rocky/9/images/x86_64/Rocky-9-GenericCloud-Base.latest.x86_64.qcow2"
  # Fedora 43 — bumped from 41. F43 released Oct 2025 is the current
  # stable; kernel 6.14+, glibc 2.40+. Change this URL + the os-variant
  # below when moving to F44/F45.
  [fedora]="https://download.fedoraproject.org/pub/fedora/linux/releases/43/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-43-1.6.x86_64.qcow2"
  [debian]="https://cloud.debian.org/images/cloud/trixie/daily/latest/debian-13-genericcloud-amd64-daily.qcow2"
  [ubuntu]="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
  [arch]="https://geo.mirror.pkgbuild.com/images/latest/Arch-Linux-x86_64-cloudimg.qcow2"
  [rhel]="REQUIRES_MANUAL_DOWNLOAD"
)

declare -A OS_VARIANTS=(
  [centos]="centos-stream9"
  [rocky]="centos-stream9"
  [fedora]="fedora43"
  [debian]="debian12"
  [ubuntu]="ubuntu24.04"
  [arch]="archlinux"
  [rhel]="centos-stream9"
)

# _resolve_os_variants: replace any OS_VARIANTS entry that this host's
# osinfo-db doesn't know with the closest supported fallback. Prevents
# virt-install from exiting non-zero when we bump to a distro version
# newer than the host's osinfo-db package (e.g. klab targets fedora43
# on a CentOS 9 host whose osinfo-db tops out at fedora42).
_resolve_os_variants() {
  command -v osinfo-query >/dev/null 2>&1 || return 0
  local _known
  _known="$(osinfo-query -f short-id os 2>/dev/null | awk 'NR>2 {print $1}')"
  [[ -z "$_known" ]] && return 0
  local _d _want _try _fallback _n
  for _d in "${!OS_VARIANTS[@]}"; do
    _want="${OS_VARIANTS[$_d]}"
    grep -qxF "$_want" <<<"$_known" && continue
    _fallback=""
    case "$_want" in
      fedora*)
        for _n in 43 42 41 40 39 38; do
          _try="fedora$_n"
          grep -qxF "$_try" <<<"$_known" && { _fallback="$_try"; break; }
        done ;;
      ubuntu*)
        for _try in ubuntu24.04 ubuntu22.04 ubuntu20.04; do
          grep -qxF "$_try" <<<"$_known" && { _fallback="$_try"; break; }
        done ;;
      debian*)
        for _try in debian13 debian12 debian11; do
          grep -qxF "$_try" <<<"$_known" && { _fallback="$_try"; break; }
        done ;;
      centos-stream*)
        for _try in centos-stream9 centos-stream8 centos9; do
          grep -qxF "$_try" <<<"$_known" && { _fallback="$_try"; break; }
        done ;;
    esac
    [[ -z "$_fallback" ]] && grep -qxF "linux2022" <<<"$_known" && _fallback="linux2022"
    [[ -z "$_fallback" ]] && _fallback="linux"
    echo "[klab] os-variant '$_want' unknown to osinfo-db; using '$_fallback' for ${_d}" >&2
    OS_VARIANTS[$_d]="$_fallback"
  done
}
_resolve_os_variants

declare -A DISTRO_FAMILY=(
  [centos]="dnf"
  [rocky]="dnf"
  [fedora]="dnf"
  [rhel]="dnf"
  [debian]="apt"
  [ubuntu]="apt"
  [arch]="pacman"
)

# Auto-scale resources based on host hardware
_host_ram_mb=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 32768)
_host_cpus=$(nproc 2>/dev/null || echo 8)
_max_vms=${#DISTROS[@]}
RAM="${RAM:-$(( (_host_ram_mb - 12000) / _max_vms ))}"
[[ $RAM -lt 2048 ]] && RAM=2048
[[ $RAM -gt 8192 ]] && RAM=8192
CPUS="${CPUS:-$(( _host_cpus / _max_vms > 2 ? _host_cpus / _max_vms : 2 ))}"
DISK="${DISK:-40}"

# Hardware detection
NVIDIA_DETECTED=0
lspci 2>/dev/null | grep -qi nvidia && NVIDIA_DETECTED=1

# Secure Boot: detect OVMF with Secure Boot support + swtpm availability
SECBOOT_AVAILABLE=0
SWTPM_AVAILABLE=0
OVMF_SECBOOT=""
for f in /usr/share/OVMF/OVMF_CODE.secboot.fd \
         /usr/share/edk2/ovmf/OVMF_CODE.secboot.fd \
         /usr/share/OVMF/OVMF_CODE_4M.secboot.fd; do
  [[ -f "$f" ]] && { OVMF_SECBOOT="$f"; SECBOOT_AVAILABLE=1; break; }
done
command -v swtpm >/dev/null 2>&1 && SWTPM_AVAILABLE=1

# Golden builds: BIOS boot (cloud images are MBR, no EFI partition).
# After golden is sealed with signed modules + MOK keys, clones also use BIOS
# since they inherit the same partition table. Secure Boot requires UEFI which
# requires EFI-capable images — a future enhancement for custom-built goldens.
VIRT_GOLDEN_BOOT_ARGS=()

# Clone/site boot args: Cloud images are MBR/BIOS, so clones use BIOS too.
# Secure Boot + UEFI is for the HOST (installed via kldload), not for klab VMs.
# klab VMs get security via MOK-signed modules + network isolation instead.
VIRT_BOOT_ARGS=()
VIRT_TPM_ARGS=()
if [[ $SWTPM_AVAILABLE -eq 1 ]]; then
  VIRT_TPM_ARGS+=(--tpm backend.type=emulator,backend.version=2.0,model=tpm-crb)
  echo "[klab] TPM 2.0: enabled (swtpm)"
fi

# inject_mok_into_nvram — Pre-enroll MOK key into a VM's UEFI NVRAM so Secure Boot
# works without interactive MokManager prompt. Called after clone, before first boot.
inject_mok_into_nvram() {
  local vm_name="$1" golden_name="$2"
  [[ $SECBOOT_AVAILABLE -eq 0 ]] && return 0

  # Get the golden VM's IP to fetch its MOK DER key
  local golden_ip
  golden_ip="$(get_vm_ip "$golden_name" 2>/dev/null || echo "")"

  # If golden is shut down, extract MOK key from the zvol directly
  local mok_der="/tmp/klab-mok-${golden_name}.der"
  if [[ -n "$golden_ip" ]] && _ssh_cmd "$golden_ip" "test -f /var/lib/dkms/mok.der" 2>/dev/null; then
    scp -o StrictHostKeyChecking=no "root@${golden_ip}:/var/lib/dkms/mok.der" "$mok_der" 2>/dev/null
  else
    # Try to get it from the sealed golden's zvol via guestfish/virt-cat
    local _distro="${golden_name##*-}"
    local gpath; gpath="$(zvol_path "$(golden_name "$_distro")")"
    local gdev; gdev="$(zvol_dev "$(golden_name "$_distro")")"
    if command -v virt-cat >/dev/null 2>&1 && [[ -b "$gdev" ]]; then
      virt-cat -a "$gdev" /var/lib/dkms/mok.der > "$mok_der" 2>/dev/null || true
    fi
  fi

  # If we got the MOK DER key, try to inject it into the clone VM's NVRAM
  if [[ -f "$mok_der" && -s "$mok_der" ]]; then
    # Use virt-fw-vars (python3-virt-firmware) to add MOK to UEFI NVRAM
    local nvram_path
    nvram_path="$(virsh dumpxml "$vm_name" 2>/dev/null | grep -oP '(?<=<nvram>)[^<]+' || true)"
    if [[ -n "$nvram_path" && -f "$nvram_path" ]] && command -v virt-fw-vars >/dev/null 2>&1; then
      virt-fw-vars --input "$nvram_path" --output "$nvram_path" \
        --enroll-cert "$mok_der" --no-microsoft --secure-boot 2>/dev/null && \
        log "    MOK auto-enrolled into NVRAM for ${vm_name}" || \
        log "    MOK NVRAM injection not available — MokManager will prompt (password: kldload)"
    else
      log "    virt-fw-vars not available — MOK enrollment via MokManager (password: kldload)"
    fi
    rm -f "$mok_der"
  else
    log "    No MOK key found for ${golden_name} — Secure Boot modules may not load"
  fi
}

# ── Colors ────────────────────────────────────────────────────────────────
C="\033[1;36m"; G="\033[1;32m"; Y="\033[1;33m"; R="\033[1;31m"
W="\033[1;37m"; D="\033[0;37m"; N="\033[0m"; B="\033[1;34m"

_ensure_log_dir() { mkdir -p "$RESULTS_DIR" 2>/dev/null; }
_ts() { date '+%Y-%m-%d %H:%M:%S'; }
log()  { _ensure_log_dir; echo -e "${G}[klab]${N} $*"; echo "[${$}] $(_ts) [INFO] $*" >> "$MASTER_LOG" 2>/dev/null; }
warn() { _ensure_log_dir; echo -e "${Y}[klab]${N} $*" >&2; echo "[${$}] $(_ts) [WARN] $*" >> "$MASTER_LOG" 2>/dev/null; }
die()  { _ensure_log_dir; echo -e "${R}[klab]${N} $*" >&2; echo "[${$}] $(_ts) [FATAL] $*" >> "$MASTER_LOG" 2>/dev/null; exit 1; }
pause() { echo ""; echo -ne "${D}  Press Enter to continue...${N}"; read -r; }

# ── Section 2: Helpers ───────────────────────────────────────────────────

_ssh_cmd() {
  local ip="$1"; shift
  # SSH options shared by both auth paths.
  #   StrictHostKeyChecking=no — allow first connection
  #   UserKnownHostsFile=/dev/null — IPs get reused across test runs and
  #     each new VM has a fresh host key; without this, the second run
  #     hits "WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED" and the
  #     SSH command is refused outright.
  #   LogLevel=ERROR — suppress the "Permanently added" warning that
  #     would otherwise pollute every test stream line.
  local _opts=(
    -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null
    -o LogLevel=ERROR
    -o ServerAliveInterval=30
    -o ServerAliveCountMax=120
  )
  # Try key auth first — probe stdin must be /dev/null so it never consumes
  # the caller's heredoc stdin (the bug that broke Fedora/Debian/Ubuntu goldens)
  if ssh "${_opts[@]}" -o ConnectTimeout=5 -o BatchMode=yes \
    -i "$SSH_KEY" "root@${ip}" true </dev/null 2>/dev/null; then
    ssh "${_opts[@]}" -o ConnectTimeout=10 -i "$SSH_KEY" "root@${ip}" "$@"
  else
    sshpass -p kldload ssh "${_opts[@]}" -o ConnectTimeout=10 "root@${ip}" "$@"
  fi
}

get_vm_ip() {
  local vm="$1" ip="" mac=""
  # Get MAC address first — needed for ARP + DHCP lease fallbacks
  mac="$(virsh domiflist "$vm" 2>/dev/null | awk '/bridge|network/ {print $5}' | head -1)"
  for _ in $(seq 1 90); do
    # Method 1: QEMU guest agent (requires qemu-guest-agent installed in VM)
    ip="$(virsh domifaddr "$vm" 2>/dev/null | awk '/ipv4/ {print $4}' | cut -d/ -f1)"
    [[ -n "$ip" ]] && break
    # Method 2: DHCP leases from libvirt
    if [[ -n "$mac" ]]; then
      ip="$(virsh net-dhcp-leases default 2>/dev/null | grep "$mac" | awk '{print $5}' | cut -d/ -f1)"
      [[ -n "$ip" ]] && break
    fi
    # Method 3: ARP table (most reliable for cloud images without guest agent)
    if [[ -n "$mac" ]]; then
      ip="$(arp -n 2>/dev/null | grep -i "$mac" | awk '{print $1}')"
      [[ -n "$ip" ]] && break
    fi
    # Method 4: nmap ping sweep of virbr0 subnet to populate ARP
    if [[ -z "$ip" && -n "$mac" ]]; then
      nmap -sn 192.168.122.0/24 >/dev/null 2>&1 || ping -c1 -b 192.168.122.255 >/dev/null 2>&1 || true
      ip="$(arp -n 2>/dev/null | grep -i "$mac" | awk '{print $1}')"
      [[ -n "$ip" ]] && break
    fi
    sleep 2
  done
  echo "$ip"
}

wait_for_ssh() {
  local ip="$1" max="${2:-150}"
  local i=0
  while ! _ssh_cmd "$ip" true 2>/dev/null; do
    ((i++))
    [[ $i -ge $max ]] && return 1
    sleep 2
  done
  return 0
}

ensure_ssh_key() {
  if [[ ! -f "$SSH_KEY" ]]; then
    log "Generating SSH key..."
    ssh-keygen -t ed25519 -f "$SSH_KEY" -N "" -q
  fi
}

timer_start() { date +%s%N; }
timer_elapsed_ms() {
  local start="$1" now
  now=$(date +%s%N)
  echo $(( (now - start) / 1000000 ))
}

# Golden naming honors KLAB_GOLDEN_KIND env:
#   unset / "regular" → klab-golden-<distro>   (lean, blue-green)
#   "ztest"           → klab-ztest-<distro>    (full ZFS test deps)
# Each distro has exactly one version at a time (CentOS 9 Stream,
# Fedora 43, Debian 13, Ubuntu 24.04, Rocky 9) — no versioned slug.
golden_name() {
  if [[ "${KLAB_GOLDEN_KIND:-regular}" == "ztest" ]]; then
    echo "${PREFIX}-ztest-${1}"
  else
    echo "${PREFIX}-golden-${1}"
  fi
}
site_name()    { echo "${PREFIX}-${1}-${2}"; }  # site_name blue centos
test_vm_name() { echo "${PREFIX}-test-${1}"; }
zvol_path()    { echo "${POOL}/vms/${1}"; }
zvol_dev()     { echo "/dev/zvol/${POOL}/vms/${1}"; }

validate_distro() {
  local d="$1"
  for valid in "${DISTROS[@]}"; do
    [[ "$d" == "$valid" ]] && return 0
  done
  die "Unknown distro: ${d}. Valid: ${DISTROS[*]}"
}

validate_site() {
  local s="$1"
  [[ "$s" == "blue" || "$s" == "green" ]] || die "Invalid site: ${s}. Must be blue or green."
}

golden_exists() {
  zfs list "$(zvol_path "$(golden_name "$1")")@golden" >/dev/null 2>&1
}

make_cloud_init_iso() {
  local name="$1" hostname="$2" ready_marker="${3:-}" static_ip="${4:-}"

  ensure_ssh_key
  local pubkey
  pubkey="$(cat "${SSH_KEY}.pub")"

  local ci_dir ci_iso
  ci_dir="$(mktemp -d)"
  ci_iso="${ISO_DIR}/${name}-cloud-init.iso"

  cat > "${ci_dir}/meta-data" <<META
instance-id: ${name}-$(date +%s)
local-hostname: ${hostname}
META

  local runcmd_extra=""
  [[ -n "$ready_marker" ]] && runcmd_extra="  - touch ${ready_marker}"
  # Static IP fallback via nmcli (cloud-init network-config often ignored on CentOS)
  local bootcmd_net=""
  if [[ -n "$static_ip" ]]; then
    bootcmd_net="  - nmcli con mod 'cloud-init eth0' ipv4.method manual ipv4.addresses ${static_ip}/24 ipv4.gateway 192.168.122.1 ipv4.dns 192.168.122.1 2>/dev/null || nmcli con mod 'System eth0' ipv4.method manual ipv4.addresses ${static_ip}/24 ipv4.gateway 192.168.122.1 ipv4.dns 192.168.122.1 2>/dev/null || ip addr add ${static_ip}/24 dev eth0 2>/dev/null || ip addr add ${static_ip}/24 dev enp1s0 2>/dev/null || true
  - nmcli con up 'cloud-init eth0' 2>/dev/null || nmcli con up 'System eth0' 2>/dev/null || true"
  fi

  cat > "${ci_dir}/user-data" <<USERDATA
#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
disable_root: false
ssh_pwauth: true
package_update: false
# CRITICAL ORDERING NOTE:
#   bootcmd runs BEFORE sshd.service fully comes up. firewalld (CentOS/Rocky/
#   Fedora) and ufw (Debian/Ubuntu) block port 22 by default on cloud images;
#   if we wait until runcmd to kill them, klab's wait_for_ssh times out.
#   So: firewall kill + sshd config BOTH go in bootcmd. sshd will pick up
#   the drop-in config when cloud-init finishes bootcmd and sshd starts.
chpasswd:
  expire: false
  list: |
    root:kldload
bootcmd:
  # Open the door BEFORE sshd gets a chance to sit behind a closed firewall
  - [ sh, -c, "systemctl stop firewalld 2>/dev/null; systemctl disable firewalld 2>/dev/null; systemctl mask firewalld 2>/dev/null; true" ]
  - [ sh, -c, "systemctl stop ufw 2>/dev/null; systemctl disable ufw 2>/dev/null; ufw --force disable 2>/dev/null; true" ]
  # Unlock root + write sshd drop-in. No restart needed — sshd reads
  # sshd_config.d/*.conf on its first start after cloud-init.
  - [ sh, -c, "passwd -uf root 2>/dev/null; true" ]
  - [ sh, -c, "mkdir -p /etc/ssh/sshd_config.d && printf 'PermitRootLogin yes\\nPasswordAuthentication yes\\n' > /etc/ssh/sshd_config.d/99-klab.conf" ]
${bootcmd_net}
${runcmd_extra}
ssh_authorized_keys:
  - ${pubkey}
runcmd:
  # Belt-and-suspenders — if bootcmd failed somehow, fire these late too.
  - [ sh, -c, "systemctl stop firewalld 2>/dev/null; systemctl mask firewalld 2>/dev/null; true" ]
  - [ sh, -c, "systemctl restart sshd 2>/dev/null || systemctl restart ssh 2>/dev/null || true" ]
USERDATA

  if [[ -n "$static_ip" ]]; then
    cat > "${ci_dir}/network-config" <<NETCFG
version: 2
ethernets:
  id0:
    match:
      name: "en*"
    addresses:
      - ${static_ip}/24
    routes:
      - to: default
        via: 192.168.122.1
    nameservers:
      addresses: [192.168.122.1, 8.8.8.8]
  id1:
    match:
      name: "eth*"
    addresses:
      - ${static_ip}/24
    routes:
      - to: default
        via: 192.168.122.1
    nameservers:
      addresses: [192.168.122.1, 8.8.8.8]
NETCFG
  else
    cat > "${ci_dir}/network-config" <<NETCFG
version: 2
ethernets:
  id0:
    match:
      name: "en*"
    dhcp4: true
  id1:
    match:
      name: "eth*"
    dhcp4: true
  id2:
    match:
      driver: "virtio*"
    dhcp4: true
NETCFG
  fi

  genisoimage -output "$ci_iso" -volid cidata -joliet -rock \
    "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null \
    || xorriso -as mkisofs -o "$ci_iso" -volid cidata -joliet -rock \
      "${ci_dir}/user-data" "${ci_dir}/meta-data" "${ci_dir}/network-config" 2>/dev/null

  rm -rf "$ci_dir"
  echo "$ci_iso"
}

# ── Section 3: RHEL Credentials ──────────────────────────────────────────

_rhel_prompt_creds() {
  # Credential source priority (all non-interactive — firstboot-safe):
  #   1. Env vars set by caller
  #   2. Legacy RHEL_CREDS_FILE on disk
  #   3. ZFS-encrypted secrets dataset via `kldload-db` (the dashboard UI
  #      writes there — "rhel-username" / "rhel-password" / "rhel-activation-key")
  #   4. Nothing → skip RHEL gracefully (exit 0 so klab golden all keeps going)
  # Interactive prompting was removed — it broke unattended firstboot.
  if [[ -n "$RHEL_USERNAME" && -n "$RHEL_PASSWORD" ]]; then
    log "  Using RHEL credentials from environment"
    return 0
  fi
  if [[ -f "$RHEL_CREDS_FILE" ]]; then
    source "$RHEL_CREDS_FILE"
    if [[ -n "$RHEL_USERNAME" && -n "$RHEL_PASSWORD" ]]; then
      log "  Using cached RHEL credentials"
      return 0
    fi
  fi
  # Try the encrypted secrets dataset (set from the web UI dashboard panel)
  local _sec_dir="/var/lib/kldload/secrets"
  if [[ -r "${_sec_dir}/rhel-username" && -r "${_sec_dir}/rhel-password" ]]; then
    RHEL_USERNAME="$(cat "${_sec_dir}/rhel-username")"
    RHEL_PASSWORD="$(cat "${_sec_dir}/rhel-password")"
    log "  Using RHEL credentials from encrypted secrets store"
    return 0
  fi
  # Activation key variant — still counts as "have creds"
  if [[ -r "${_sec_dir}/rhel-activation-key" ]]; then
    RHEL_USERNAME=""
    RHEL_PASSWORD=""
    RHEL_ACTIVATION_KEY="$(cat "${_sec_dir}/rhel-activation-key")"
    log "  Using RHEL activation key from encrypted secrets store"
    return 0
  fi
  warn "  No RHEL credentials — skipping RHEL golden (add creds via Dashboard → RHEL Subscription)"
  return 2   # non-zero but distinct from hard failure; caller should skip not abort
  log "  Credentials cached at ${RHEL_CREDS_FILE} (0600)"
  return 0
}

# ── Section 4: Per-Distro Setup ──────────────────────────────────────────
# Installs ZFS + test suite + eBPF + dev tools + node_exporter on golden VMs.
# Unified from kzfs-test (ZFS-focused) and kzfs-lab (dev-focused).

setup_vm_golden() {
  local ip="$1" distro="$2"
  local family="${DISTRO_FAMILY[$distro]}"
  # KLAB_ZFS_DEV: "1" = include full dev/test tools (ksh, zfs-tests,
  # fio, pamtester, pax, cryptsetup, loopback vdevs, …). Default is "0"
  # so regular klab goldens stay small. The ZFS Test Suite has its own
  # `klab golden-ztest` command that sets this to "1" and produces
  # klab-ztest-<distro> images separate from klab-golden-<distro>.
  local dev_tools="${KLAB_ZFS_DEV:-0}"

  # RHEL: register subscription before installing packages
  if [[ "$distro" == "rhel" && -n "$RHEL_USERNAME" && -n "$RHEL_PASSWORD" ]]; then
    log "  Registering RHEL subscription (credentials redacted)..."
    _ssh_cmd "$ip" bash -c "subscription-manager register --username='${RHEL_USERNAME}' --password='${RHEL_PASSWORD}' --auto-attach 2>&1 | sed 's/password=.*/password=REDACTED/g'" 2>&1 | sed "s/${RHEL_PASSWORD}/REDACTED/g"
  fi

  log "  Setting up environment on ${distro} (source: ${ZFS_SOURCE}, dev_tools: ${dev_tools})..."

  case "$family" in
    dnf)
      _ssh_cmd "$ip" bash -s -- "$dev_tools" <<'DNFSETUP'
set -e
KLAB_ZFS_DEV="${1:-1}"
# Disable ALL firewalling
systemctl stop firewalld 2>/dev/null || true
systemctl disable firewalld 2>/dev/null || true
systemctl mask firewalld 2>/dev/null || true
iptables -F 2>/dev/null || true
nft flush ruleset 2>/dev/null || true

# Ensure sshd stays accessible
mkdir -p /etc/ssh/sshd_config.d
echo -e 'PermitRootLogin yes\nPasswordAuthentication yes' > /etc/ssh/sshd_config.d/99-klab.conf 2>/dev/null || true
systemctl restart sshd 2>/dev/null || true

dnf install -y epel-release 2>/dev/null || true

# kernel-devel MUST match running kernel for DKMS
KVER=$(uname -r)
dnf install -y kernel-devel-${KVER} dkms gcc gcc-c++ make autoconf automake libtool git 2>/dev/null || \
  dnf install -y kernel-devel dkms gcc gcc-c++ make autoconf automake libtool git 2>/dev/null || true

# ZFS
DISTRO_ID=$(. /etc/os-release && echo "$ID")
if ! command -v zfs >/dev/null 2>&1; then
  if [ "$DISTRO_ID" = "fedora" ]; then
    FEDORA_VER=$(rpm --eval "%{fedora}")
    # zfsonlinux.org/fedora publishes one zfs-release rpm per supported
    # Fedora version with its own pkg revision, and the revision number
    # is not stable across releases (e.g. fc42 is still on 2-8 while
    # fc43 jumped to 3-0). Try the known good revisions newest first so
    # we don't silently ship a Fedora golden with no ZFS installed.
    _ok=0
    for _rev in 3-0 2-10 2-9 2-8 2-7 2-6; do
      if dnf install -y "https://zfsonlinux.org/fedora/zfs-release-${_rev}.fc${FEDORA_VER}.noarch.rpm" 2>/dev/null; then
        _ok=1; break
      fi
    done
    [ $_ok -eq 1 ] || echo "WARNING: no zfs-release rpm found for fc${FEDORA_VER} — ZFS will not install"
  else
    dnf install -y "https://zfsonlinux.org/epel/zfs-release-2-3$(rpm --eval "%{dist}").noarch.rpm" 2>/dev/null || true
  fi
  if [ "$KLAB_ZFS_DEV" = "1" ]; then
    dnf install -y zfs zfs-dkms zfs-test 2>/dev/null || true
  else
    dnf install -y zfs zfs-dkms 2>/dev/null || true
  fi
fi
if [ "$KLAB_ZFS_DEV" = "1" ] && ! test -f /usr/share/zfs/zfs-tests.sh; then
  dnf install -y zfs-test 2>/dev/null || true
fi

# eBPF + essentials (always)
dnf install -y bpftrace bcc-tools wireguard-tools curl jq 2>/dev/null || true

# Test suite deps + dev tools (only when KLAB_ZFS_DEV=1).
# The full OpenZFS test suite needs: ksh (run), fio/parted/attr/bc/acl
# (zpool ops), sysstat (mpstat for perf tests), net-tools (the `net`
# cmd tests reference), cryptsetup (native-encryption tests),
# nfs-utils (exportfs/nfs tests), bzip2 (bunzip2/bzcat used in log
# compression tests), xxhash (xxh128sum checksum tests), util-linux
# (pax equivalents). pamtester is rarely packaged; optional.
#
# Install per-package. Batching everything in one `dnf install` caused
# the whole transaction to abort (leaving ~everything uninstalled) the
# moment a single pkg was missing from the enabled repos — e.g. xxhash
# isn't in CentOS 9 base, so gdb/strace/net-tools etc. all vanished
# silently under the `|| true`. perf comes from kernel-tools on the
# rpm-based distros.
if [ "$KLAB_ZFS_DEV" = "1" ]; then
  # perf actually lives in kernel-tools on RHEL/CentOS/Rocky/Fedora
  for _p in ksh fio parted attr bc acl sysstat \
            gdb strace kernel-tools openssl-devel zlib-devel \
            libuuid-devel libblkid-devel libtirpc-devel \
            net-tools nfs-utils cryptsetup bzip2 xxhash python3 \
            util-linux pamtester; do
    dnf install -y "$_p" 2>/dev/null || true
  done
  # xxhash may require EPEL — enable and retry if still missing on EL9
  if ! command -v xxh128sum >/dev/null 2>&1 && ! rpm -q xxhash >/dev/null 2>&1; then
    dnf install -y epel-release 2>/dev/null || true
    dnf install -y xxhash 2>/dev/null || true
  fi
fi

# Load ZFS module
modprobe zfs || {
  ZFS_VER=$(rpm -q --qf '%{VERSION}' zfs-dkms 2>/dev/null || echo "")
  if [ -n "$ZFS_VER" ]; then
    dkms build -m zfs -v "$ZFS_VER" -k "$KVER" 2>&1 || true
    dkms install -m zfs -v "$ZFS_VER" -k "$KVER" 2>&1 || true
    depmod -a "$KVER" 2>/dev/null || true
    modprobe zfs 2>/dev/null || true
  fi
}

# node_exporter for observability
if ! command -v node_exporter >/dev/null 2>&1; then
  curl -fsSL https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-amd64.tar.gz \
    | tar -xz -C /tmp 2>/dev/null && install -m 755 /tmp/node_exporter-*/node_exporter /usr/local/bin/ && rm -rf /tmp/node_exporter-* || true
fi

# Create loopback devices for zfs-tests.sh (dev tools only)
if [ "$KLAB_ZFS_DEV" = "1" ]; then
  for i in 0 1 2 3; do
    truncate -s 4G /var/tmp/zfs-vdev${i}.img 2>/dev/null || true
  done
fi

# Ensure network stays alive after all package installs
systemctl restart NetworkManager 2>/dev/null || systemctl restart systemd-networkd 2>/dev/null || true
systemctl stop firewalld 2>/dev/null || true
systemctl mask firewalld 2>/dev/null || true
iptables -F 2>/dev/null || true
nft flush ruleset 2>/dev/null || true
sleep 3

echo "=== DNF Setup Validation ==="
echo "zfs binary: $(command -v zfs 2>/dev/null || echo MISSING)"
echo "zfs module: $(lsmod | grep -c '^zfs ' 2>/dev/null | tr -d '[:space:]' || echo 0)"
echo "zfs-tests:  $(test -f /usr/share/zfs/zfs-tests.sh && echo OK || echo MISSING)"
echo "ksh:        $(command -v ksh 2>/dev/null || echo MISSING)"
echo "vdevs:      $(ls /var/tmp/zfs-vdev*.img 2>/dev/null | wc -l)/4"
echo "network:    $(ip -4 addr show | grep -c 'inet.*scope global' || echo 0) interfaces"
echo "DNF setup complete"
DNFSETUP
      ;;
    apt)
      _ssh_cmd "$ip" bash -s -- "$dev_tools" <<'APTSETUP'
set -e
KLAB_ZFS_DEV="${1:-1}"
export DEBIAN_FRONTEND=noninteractive

# Enable contrib + universe repos (ZFS packages live there)
if [ -f /etc/apt/sources.list ]; then
  sed -i 's/^\(deb.*\) main$/\1 main contrib/' /etc/apt/sources.list
  sed -i '/^deb.*main contrib$/ s/$/ non-free/' /etc/apt/sources.list
fi
if [ -f /etc/apt/sources.list.d/debian.sources ]; then
  sed -i 's/^Components: main$/Components: main contrib non-free/' /etc/apt/sources.list.d/debian.sources
fi
if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then
  sed -i 's/^Components: main restricted$/Components: main restricted universe/' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
fi

apt-get update -y

# Headers for DKMS
KVER=$(uname -r)
if [ "$KLAB_ZFS_DEV" = "1" ]; then
  apt-get install -y linux-headers-${KVER} dkms gcc make build-essential git \
    autoconf automake libtool 2>/dev/null || \
    apt-get install -y linux-headers-generic dkms gcc make build-essential git 2>/dev/null || true
else
  apt-get install -y linux-headers-${KVER} dkms 2>/dev/null || \
    apt-get install -y linux-headers-generic dkms 2>/dev/null || true
fi

# ZFS
if ! command -v zfs >/dev/null 2>&1; then
  if [ "$KLAB_ZFS_DEV" = "1" ]; then
    apt-get install -y zfsutils-linux zfs-dkms zfs-test 2>/dev/null || true
  else
    apt-get install -y zfsutils-linux zfs-dkms 2>/dev/null || true
  fi
fi

# eBPF + essentials (always)
apt-get install -y bpftrace bpfcc-tools wireguard-tools curl jq 2>/dev/null || true

# Test suite deps + dev tools (only when KLAB_ZFS_DEV=1).
# See the dnf branch for the rationale — full OpenZFS test suite
# prerequisites. apt package names differ slightly from rpm.
#
# Per-package install: a single `apt-get install A B C…` aborts the
# whole transaction if even one pkg name isn't in the indexes
# (xxhash, linux-perf, etc. vary by Ubuntu/Debian release) and
# leaves the rest uninstalled. Loop each one so a missing pkg is
# a single-line skip instead of a silent blanket failure.
if [ "$KLAB_ZFS_DEV" = "1" ]; then
  for _p in ksh fio parted attr acl bc sysstat \
            gdb strace linux-perf linux-tools-common linux-tools-generic \
            uuid-dev libblkid-dev libssl-dev libtirpc-dev zlib1g-dev \
            net-tools nfs-kernel-server cryptsetup bzip2 xxhash \
            python3 util-linux pax pamtester; do
    apt-get install -y "$_p" 2>/dev/null || true
  done
fi

modprobe zfs 2>/dev/null || true

# node_exporter
if ! command -v node_exporter >/dev/null 2>&1; then
  curl -fsSL https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-amd64.tar.gz \
    | tar -xz -C /tmp 2>/dev/null && install -m 755 /tmp/node_exporter-*/node_exporter /usr/local/bin/ && rm -rf /tmp/node_exporter-* || true
fi

# Loopback vdevs for zfs-tests.sh (dev tools only)
if [ "$KLAB_ZFS_DEV" = "1" ]; then
  for i in 0 1 2 3; do
    truncate -s 4G /var/tmp/zfs-vdev${i}.img 2>/dev/null || true
  done
fi

echo "=== APT Setup Validation ==="
echo "zfs binary: $(command -v zfs 2>/dev/null || echo MISSING)"
echo "zfs module: $(lsmod | grep -c '^zfs ' 2>/dev/null | tr -d '[:space:]' || echo 0)"
echo "zfs-tests:  $(test -f /usr/share/zfs/zfs-tests.sh && echo OK || echo MISSING)"
echo "ksh:        $(command -v ksh 2>/dev/null || echo MISSING)"
echo "vdevs:      $(ls /var/tmp/zfs-vdev*.img 2>/dev/null | wc -l)/4"
echo "APT setup complete"
APTSETUP
      ;;
    pacman)
      _ssh_cmd "$ip" bash -s -- "$dev_tools" <<'PACSETUP'
set -e
KLAB_ZFS_DEV="${1:-1}"
pacman -Syu --noconfirm 2>/dev/null || true

# Always: headers, dkms, eBPF, essentials
pacman -S --noconfirm linux-headers dkms bpftrace bcc-tools wireguard-tools curl jq 2>/dev/null || true

# Dev tools (only when KLAB_ZFS_DEV=1)
if [ "$KLAB_ZFS_DEV" = "1" ]; then
  pacman -S --noconfirm gcc make git fio parted attr bc acl sysstat 2>/dev/null || true
fi

if ! command -v zfs >/dev/null 2>&1; then
  curl -fsSL https://archzfs.com/archzfs.gpg | pacman-key -a - 2>/dev/null || true
  pacman-key --lsign-key DDF7DB817396A49B2A2723F7403BD972F75D9D76 2>/dev/null || true
  echo -e '\n[archzfs]\nServer = https://archzfs.com/$repo/$arch' >> /etc/pacman.conf
  pacman -Sy --noconfirm zfs-dkms zfs-utils 2>/dev/null || true
fi

modprobe zfs 2>/dev/null || true

# Loopback vdevs (dev tools only)
if [ "$KLAB_ZFS_DEV" = "1" ]; then
  for i in 0 1 2 3; do
    truncate -s 4G /var/tmp/zfs-vdev${i}.img 2>/dev/null || true
  done
fi

echo "=== Pacman Setup Validation ==="
echo "zfs binary: $(command -v zfs 2>/dev/null || echo MISSING)"
echo "zfs module: $(lsmod | grep -c '^zfs ' 2>/dev/null | tr -d '[:space:]' || echo 0)"
echo "zfs-tests:  $(test -f /usr/share/zfs/zfs-tests.sh && echo OK || echo MISSING)"
echo "ksh:        $(command -v ksh 2>/dev/null || echo MISSING)"
echo "vdevs:      $(ls /var/tmp/zfs-vdev*.img 2>/dev/null | wc -l)/4"
echo "Pacman setup complete"
PACSETUP
      ;;
    apk)
      _ssh_cmd "$ip" sh -s -- "$dev_tools" <<'APKSETUP'
set -e
KLAB_ZFS_DEV="${1:-1}"
apk update
if ! grep -q 'community' /etc/apk/repositories 2>/dev/null; then
  sed -i 's|^#\(.*community\)|\1|' /etc/apk/repositories
fi
apk update

# Always: essentials + eBPF
apk add bash coreutils util-linux findutils grep sed wireguard-tools curl jq 2>/dev/null || true

# Dev tools (only when KLAB_ZFS_DEV=1)
if [ "$KLAB_ZFS_DEV" = "1" ]; then
  apk add attr acl bc fio linux-lts-dev gcc make autoconf automake libtool git 2>/dev/null || true
fi

apk add zfs zfs-lts zfs-utils 2>/dev/null || true
if [ "$KLAB_ZFS_DEV" = "1" ]; then
  apk add zfs-test 2>/dev/null || true
  apk add mksh 2>/dev/null || true
  ln -sf /usr/bin/mksh /usr/bin/ksh 2>/dev/null || true
fi

modprobe zfs 2>/dev/null || true

# Loopback vdevs (dev tools only)
if [ "$KLAB_ZFS_DEV" = "1" ]; then
  for i in 0 1 2 3; do
    truncate -s 4G /var/tmp/zfs-vdev${i}.img 2>/dev/null || true
  done
fi

echo "=== APK Setup Validation ==="
echo "zfs binary: $(command -v zfs 2>/dev/null || echo MISSING)"
echo "zfs module: $(lsmod | grep -c '^zfs ' 2>/dev/null | tr -d '[:space:]' || echo 0)"
echo "zfs-tests:  $(test -f /usr/share/zfs/zfs-tests.sh && echo OK || echo MISSING)"
echo "ksh:        $(command -v ksh 2>/dev/null || echo MISSING)"
echo "vdevs:      $(ls /var/tmp/zfs-vdev*.img 2>/dev/null | wc -l)/4"
echo "APK setup complete"
APKSETUP
      ;;
  esac

  # Common: clone OpenZFS source + bpftrace scripts + MOTD
  _ssh_cmd "$ip" bash -s <<'COMMON'
git clone --depth 1 https://github.com/openzfs/zfs.git /usr/src/zfs 2>/dev/null || true

# Pre-built bpftrace scripts for ZFS debugging
mkdir -p /usr/local/share/bpftrace
cat > /usr/local/share/bpftrace/zfs-latency.bt <<'BT'
tracepoint:zfs:zfs_read_done,tracepoint:zfs:zfs_write_done { @us = hist((nsecs - args->start) / 1000); }
BT
cat > /usr/local/share/bpftrace/zfs-arc.bt <<'BT'
kprobe:arc_read { @hits = count(); }
kprobe:arc_read_done { @misses = count(); }
interval:s:5 { print(@); clear(@); }
BT

# node_exporter systemd unit
if command -v node_exporter >/dev/null 2>&1 && ! systemctl is-active node_exporter >/dev/null 2>&1; then
  cat > /etc/systemd/system/node_exporter.service <<'SVC'
[Unit]
Description=Node Exporter
After=network-online.target
[Service]
Type=simple
ExecStart=/usr/local/bin/node_exporter
Restart=always
[Install]
WantedBy=multi-user.target
SVC
  systemctl daemon-reload
  systemctl enable --now node_exporter 2>/dev/null || true
fi

cat > /etc/motd <<'MOTD'

  klab — Multi-Distro Test Platform
  ZFS + eBPF + dev tools | blue-green deploy | instant clones

  ZFS source: /usr/src/zfs
  Traces:     /usr/local/share/bpftrace/*.bt
  Password:   kldload

MOTD
echo "Common setup complete"
COMMON

  # NVIDIA driver install if GPU detected on host
  if [[ "$NVIDIA_DETECTED" -eq 1 ]]; then
    log "  Installing NVIDIA drivers (GPU detected on host)..."
    case "$family" in
      dnf)
        _ssh_cmd "$ip" bash -c 'dnf install -y nvidia-driver nvidia-driver-cuda-libs 2>/dev/null || \
          dnf install -y kmod-nvidia-open-dkms 2>/dev/null || true' 2>/dev/null
        ;;
      apt)
        _ssh_cmd "$ip" bash -c 'DEBIAN_FRONTEND=noninteractive apt-get install -y nvidia-driver-535 2>/dev/null || true' 2>/dev/null
        ;;
      pacman)
        _ssh_cmd "$ip" bash -c 'pacman -S --noconfirm nvidia-dkms 2>/dev/null || true' 2>/dev/null
        ;;
    esac
  fi

  # ── DKMS signing (optional — only if UEFI golden images are used in future) ─
  # Cloud images are BIOS/MBR — no Secure Boot needed. Skip MOK setup entirely.
  # When klab switches to installer-based UEFI goldens, re-enable this block.
  if false; then
  log "  Configuring Secure Boot MOK signing on ${distro}..."
  _ssh_cmd "$ip" bash -s <<'MOKSETUP'
set -e

# Generate MOK keypair (2048-bit RSA, 10-year, no passphrase)
mkdir -p /var/lib/dkms
if [ ! -f /var/lib/dkms/mok.key ]; then
  openssl req -new -x509 -newkey rsa:2048 \
    -keyout /var/lib/dkms/mok.key \
    -out    /var/lib/dkms/mok.pub \
    -days 3650 -nodes \
    -subj "/CN=klab Secure Boot MOK/" 2>/dev/null
  openssl x509 -in /var/lib/dkms/mok.pub -out /var/lib/dkms/mok.der -outform DER 2>/dev/null
  chmod 0600 /var/lib/dkms/mok.key
  chmod 0644 /var/lib/dkms/mok.pub /var/lib/dkms/mok.der
  echo "MOK keypair generated"
else
  echo "MOK keypair already exists"
fi

# Create DKMS sign helper script
mkdir -p /etc/dkms
cat > /etc/dkms/sign_helper.sh <<'SIGNEOF'
#!/bin/bash
set -euo pipefail
KVER="${1:?}" MOD="${2:?}"
KEY=/var/lib/dkms/mok.key
CERT=/var/lib/dkms/mok.pub
SIGN_FILE=$(find /usr/src/kernels/"${KVER}" \
                 /usr/src/linux-headers-"${KVER}" \
                 /usr/lib/linux-kbuild-"${KVER%%.*}"* \
                 -name sign-file -type f 2>/dev/null | head -1 || true)
[[ -x "${SIGN_FILE}" ]] || { echo "sign-file not found for ${KVER}" >&2; exit 0; }
exec "${SIGN_FILE}" sha256 "${KEY}" "${CERT}" "${MOD}"
SIGNEOF
chmod 0755 /etc/dkms/sign_helper.sh

# Configure DKMS to use MOK keys
mkdir -p /etc/dkms/framework.conf.d
cat > /etc/dkms/framework.conf.d/klab-mok.conf <<MOKCONF
mok_signing_key=/var/lib/dkms/mok.key
mok_certificate=/var/lib/dkms/mok.pub
sign_tool=/etc/dkms/sign_helper.sh
try_sign_modules=true
MOKCONF

# Re-sign existing ZFS modules with MOK key
KVER=$(uname -r)
SIGN_FILE=$(find /usr/src/kernels/"${KVER}" \
                 /usr/src/linux-headers-"${KVER}" \
                 /usr/lib/linux-kbuild-"${KVER%%.*}"* \
                 -name sign-file -type f 2>/dev/null | head -1 || true)
if [ -x "${SIGN_FILE}" ] && [ -f /var/lib/dkms/mok.key ]; then
  SIGNED=0
  for mod in $(find /lib/modules/"${KVER}" -name '*.ko' -o -name '*.ko.xz' -o -name '*.ko.zst' 2>/dev/null | grep -i zfs); do
    case "$mod" in
      *.ko.xz) xz -d "$mod" 2>/dev/null; mod="${mod%.xz}" ;;
      *.ko.zst) zstd -d "$mod" 2>/dev/null; mod="${mod%.zst}" ;;
    esac
    "${SIGN_FILE}" sha256 /var/lib/dkms/mok.key /var/lib/dkms/mok.pub "$mod" 2>/dev/null || true
    case "$mod" in
      *.ko) # Re-compress if original was compressed
        [ -f "${mod}.xz.bak" ] && xz --check=crc32 "$mod" 2>/dev/null
        [ -f "${mod}.zst.bak" ] && zstd -q "$mod" 2>/dev/null
        ;;
    esac
    SIGNED=$((SIGNED + 1))
  done
  echo "Signed ${SIGNED} ZFS module(s) with MOK key"
  depmod -a "${KVER}" 2>/dev/null || true
else
  echo "WARN: sign-file not found — modules unsigned (Secure Boot will reject them)"
fi

# Queue MOK enrollment (password: kldload)
# This queues the enrollment; on next boot with Secure Boot, MokManager prompts
if command -v mokutil >/dev/null 2>&1; then
  echo -e "kldload\nkldload" | mokutil --import /var/lib/dkms/mok.der 2>/dev/null && \
    echo "MOK enrollment queued (password: kldload)" || \
    echo "MOK enrollment skipped (may already be enrolled or mokutil unavailable)"
else
  echo "mokutil not installed — installing..."
  dnf install -y mokutil 2>/dev/null || \
    apt-get install -y mokutil 2>/dev/null || \
    pacman -S --noconfirm mokutil 2>/dev/null || true
  if command -v mokutil >/dev/null 2>&1; then
    echo -e "kldload\nkldload" | mokutil --import /var/lib/dkms/mok.der 2>/dev/null && \
      echo "MOK enrollment queued (password: kldload)" || true
  fi
fi

echo "Secure Boot MOK setup complete"
MOKSETUP
  fi  # end disabled MOK block

  log "  Test environment ready on ${distro}"
}

# ── ZFS Build-from-Source ─────────────────────────────────────────────────
_install_zfs_from_source() {
  local ip="$1" source="$2"
  local mode="${source%%:*}"
  local ref="${source#*:}"

  log "  Building ZFS from source (${source})..."

  _ssh_cmd "$ip" bash -s -- "$mode" "$ref" <<'BUILDZFS'
set -e
MODE="$1"; REF="$2"; NCPU=$(nproc)
BUILD_DIR="/tmp/zfs-build"; rm -rf "$BUILD_DIR"; mkdir -p "$BUILD_DIR"; cd "$BUILD_DIR"
case "$MODE" in
  version) curl -fSL -o "zfs-${REF}.tar.gz" "https://github.com/openzfs/zfs/releases/download/zfs-${REF}/zfs-${REF}.tar.gz"; tar xzf "zfs-${REF}.tar.gz"; cd "zfs-${REF}" ;;
  git) REPO="${REF%%@*}"; BRANCH="${REF#*@}"; [[ "$REPO" == "$BRANCH" ]] && BRANCH="master"; [[ "$REPO" == @* ]] && REPO="openzfs/zfs" && BRANCH="${REF#@}"; git clone --depth 1 --branch "$BRANCH" "https://github.com/${REPO}.git" zfs-src; cd zfs-src ;;
  tarball) tar xzf "$REF"; cd zfs-*/ 2>/dev/null || cd "$(basename "$REF" .tar.gz)" ;;
  *) echo "ERROR: Unknown mode: $MODE"; exit 1 ;;
esac
[ -f autogen.sh ] && sh autogen.sh
./configure --with-linux="$(ls -d /usr/src/kernels/$(uname -r) 2>/dev/null || ls -d /usr/lib/modules/$(uname -r)/build 2>/dev/null)" --enable-debug 2>&1 || ./configure --enable-debug 2>&1
make -j${NCPU} 2>&1; make install 2>&1
depmod -a 2>/dev/null || true; modprobe -r zfs 2>/dev/null || true; modprobe zfs 2>/dev/null || true
echo "ZFS from-source build complete: $(zfs version 2>/dev/null || echo unknown)"
BUILDZFS
}

# ── Section 5: Golden Image Build ────────────────────────────────────────

build_golden_single() {
  local distro="$1"
  validate_distro "$distro"

  local name zpath zdev
  name="$(golden_name "$distro")"
  zpath="$(zvol_path "$name")"
  zdev="$(zvol_dev "$name")"

  if zfs list "${zpath}@golden" >/dev/null 2>&1; then
    local _existing_log="${RESULTS_DIR}/goldens/${distro}-latest.log"
    local _existing_result=""
    [[ -f "$_existing_log" ]] && _existing_result="$(grep '  Result:' "$_existing_log" 2>/dev/null | tail -1 || echo "")"
    if [[ "$_existing_result" == *"FAIL"* || "$_existing_result" == *"PARTIAL"* ]]; then
      warn "Golden ${name} exists but validation was: ${_existing_result} — rebuilding"
    else
      log "Golden ${name} exists — skipping (destroy with: zfs destroy -Rf ${zpath})"
      return 0
    fi
  fi

  # Clean up everything
  log "  Cleaning up previous state..."
  virsh destroy "$name" 2>/dev/null || true
  virsh undefine "$name" --nvram 2>/dev/null || virsh undefine "$name" 2>/dev/null || true
  zfs destroy -Rf "$zpath" 2>/dev/null || true
  rm -f "${ISO_DIR}/${name}-cloud-init.iso" 2>/dev/null || true

  local t_start
  t_start="$(timer_start)"

  local golden_log_dir="${RESULTS_DIR}/goldens"
  mkdir -p "$golden_log_dir"
  local golden_log="${golden_log_dir}/${distro}-$(date +%Y%m%d-%H%M%S).log"
  log "Building golden: ${C}${name}${N}"
  log "  Log: ${golden_log}"

  {
    echo "═══════════════════════════════════════════════════════════"
    echo "  klab — Golden Build: ${distro}"
    echo "  Started: $(date)"
    echo "  Host: $(uname -n) ($(nproc) cores, $(awk '/MemTotal/ {printf "%.0fGB", $2/1048576}' /proc/meminfo) RAM)"
    echo "  ZFS Source: ${ZFS_SOURCE}"
    echo "  NVIDIA: $([[ $NVIDIA_DETECTED -eq 1 ]] && echo "detected" || echo "none")"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
  } | tee "$golden_log"

  mkdir -p "$ISO_DIR"
  local url="${CLOUD_IMAGES[$distro]}"
  local img_file="${ISO_DIR}/${distro}-cloud.qcow2"

  # RHEL: clone from CentOS golden instead of downloading
  if [[ "$distro" == "rhel" ]]; then
    # Return code 2 from _rhel_prompt_creds = "no creds, skip gracefully".
    # Return 0 = success. Anything else = hard error. "klab golden all"
    # must treat a missing-creds RHEL as skip (rc=0), not fail (rc=1),
    # so the rest of the distros still build.
    _rhel_prompt_creds
    local _rc=$?
    if [[ $_rc -eq 2 ]]; then
      log "  Skipping RHEL — no credentials (set them in the web UI Dashboard)"
      return 0
    elif [[ $_rc -ne 0 ]]; then
      return 1
    fi
    local centos_golden_zpath
    centos_golden_zpath="$(zvol_path "$(golden_name centos)")"
    if ! zfs list "${centos_golden_zpath}@golden" >/dev/null 2>&1; then
      warn "RHEL requires CentOS golden — building CentOS first..."
      build_golden_single centos || { warn "CentOS build failed"; return 1; }
    fi

    log "  RHEL: cloning from CentOS golden (same EL9 kernel)..."
    zfs clone "${centos_golden_zpath}@golden" "$zpath" 2>/dev/null || die "Failed to clone CentOS golden for RHEL"

    local ci_iso
    ci_iso="$(make_cloud_init_iso "$name" "$name" "/var/lib/cloud/instance/klab-ready")"

    log "  Booting RHEL golden VM (Secure Boot: OFF during build, ON for clones)..."
    virt-install --name "$name" --ram "$RAM" --vcpus "$CPUS" \
      --os-variant "${OS_VARIANTS[$distro]}" \
      --disk "path=${zdev},bus=virtio" --disk "path=${ci_iso},device=cdrom" \
      --network bridge=virbr0,model=virtio --graphics none --noautoconsole --import \
      "${VIRT_GOLDEN_BOOT_ARGS[@]}" \
      2>&1 || die "Failed to boot RHEL golden VM"

    local golden_ip
    log "  Waiting for IP..."
    golden_ip="$(get_vm_ip "$name")"
    [[ -n "$golden_ip" ]] || die "No IP for ${name}"
    log "  IP: ${golden_ip}"
    log "  Waiting for SSH..."
    wait_for_ssh "$golden_ip" 300 || die "SSH timeout on ${name}"

    log "  Installing subscription-manager..."
    _ssh_cmd "$golden_ip" "dnf install -y subscription-manager 2>&1 | tail -5" 2>&1 | tee -a "$golden_log"

    log "  Registering RHEL subscription (credentials redacted)..."
    _ssh_cmd "$golden_ip" bash -c "
      subscription-manager register --username='${RHEL_USERNAME}' --password='${RHEL_PASSWORD}' --auto-attach 2>&1 | sed 's/password=.*/password=REDACTED/g'
      subscription-manager repos --enable codeready-builder-for-rhel-9-x86_64-rpms 2>/dev/null || true
      subscription-manager identity 2>/dev/null | head -3
      echo 'RHEL registration complete'
    " 2>&1 | sed "s/${RHEL_PASSWORD}/REDACTED/g" | tee -a "$golden_log"

    log "  Verifying ZFS on RHEL..."
    _ssh_cmd "$golden_ip" "modprobe zfs 2>/dev/null; zfs version 2>/dev/null; test -f /usr/share/zfs/zfs-tests.sh && echo 'zfs-tests: OK' || echo 'zfs-tests: MISSING'"

    # Validate + seal + snapshot (inline for RHEL)
    log "  Validating golden ${distro}..."
    local _v_zfs _v_mod _v_ver _v_tests _v_vdevs _v_ksh _v_kernel _v_dkms _v_rhel_id
    _v_mod="$(_ssh_cmd "$golden_ip" "lsmod | grep -c '^zfs ' 2>/dev/null | tr -d '[:space:]' || echo 0")"
    _v_zfs="$(_ssh_cmd "$golden_ip" "command -v zfs >/dev/null 2>&1 && echo OK || echo MISSING")"
    _v_ver="$(_ssh_cmd "$golden_ip" "zfs version 2>/dev/null | head -1 || echo unknown")"
    _v_tests="$(_ssh_cmd "$golden_ip" "test -f /usr/share/zfs/zfs-tests.sh && echo OK || echo MISSING")"
    _v_vdevs="$(_ssh_cmd "$golden_ip" "ls /var/tmp/zfs-vdev*.img 2>/dev/null | wc -l")"
    _v_ksh="$(_ssh_cmd "$golden_ip" "command -v ksh >/dev/null 2>&1 && echo OK || echo MISSING")"
    _v_kernel="$(_ssh_cmd "$golden_ip" "uname -r" || echo "unknown")"
    _v_dkms="$(_ssh_cmd "$golden_ip" "dkms status 2>/dev/null | head -5" || echo "n/a")"
    _v_rhel_id="$(_ssh_cmd "$golden_ip" "subscription-manager identity 2>/dev/null | head -1" || echo "not registered")"

    {
      echo ""; echo "═══════════════════════════════════════════════════════════"
      echo "  Golden Validation Report: ${distro}"
      echo "═══════════════════════════════════════════════════════════"
      echo "  Kernel:         ${_v_kernel}"; echo "  ZFS binary:     ${_v_zfs}"
      echo "  ZFS module:     $([[ $_v_mod -ge 1 ]] && echo "LOADED" || echo "NOT LOADED")"
      echo "  ZFS version:    ${_v_ver}"; echo "  DKMS status:    ${_v_dkms}"
      echo "  zfs-tests.sh:   ${_v_tests}"; echo "  vdev images:    ${_v_vdevs}/4"
      echo "  ksh:            ${_v_ksh}"; echo "  RHEL sub:       ${_v_rhel_id}"
      local _result="PASS"
      [[ "$_v_zfs" != "OK" || "$_v_mod" -lt 1 ]] && _result="FAIL"
      [[ "$_v_tests" != "OK" ]] && _result="PARTIAL (no tests)"
      echo "  Result:         ${_result}"
      echo "═══════════════════════════════════════════════════════════"; echo ""
    } | tee -a "$golden_log"

    _ssh_cmd "$golden_ip" "echo zfs > /etc/modules-load.d/zfs.conf; depmod -a 2>/dev/null || true"
    _ssh_cmd "$golden_ip" "cloud-init clean --logs 2>/dev/null || true; rm -f /etc/machine-id; touch /etc/machine-id; truncate -s 0 /etc/hostname"
    _ssh_cmd "$golden_ip" "systemctl enable cloud-init-local cloud-init cloud-config cloud-final 2>/dev/null || true"
    _ssh_cmd "$golden_ip" "shutdown -h now" || true

    for _ in $(seq 1 30); do virsh domstate "$name" 2>/dev/null | grep -q "shut off" && break; sleep 2; done
    virsh detach-disk "$name" "$ci_iso" --config 2>/dev/null || true; rm -f "$ci_iso"
    zfs snapshot "${zpath}@golden"

    local elapsed; elapsed="$(timer_elapsed_ms "$t_start")"
    { echo "Golden build complete: ${name}"; echo "  Time: $((elapsed / 1000))s"; echo "  Size: $(zfs get -Hp -o value used "$zpath" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo "?")"; echo "  Method: CentOS clone + subscription-manager"; } | tee -a "$golden_log"
    ln -sfn "$golden_log" "${golden_log_dir}/${distro}-latest.log"
    log "Golden ready: ${C}${name}${N} ($((elapsed / 1000))s) — log: ${golden_log}"
    return 0
  fi

  # Normal distros: download cloud image.
  # Atomic rename: curl writes to .partial and we mv on success. Without this,
  # a concurrent reader (e.g. kube-cluster picking up the first *-cloud.qcow2
  # it finds) sees the in-flight file and qemu-img fails with "Input/output
  # error" on sectors past the current download head.
  if [[ ! -f "$img_file" ]]; then
    log "  Downloading ${distro} cloud image..."
    curl -fSL -o "${img_file}.partial" "$url" \
      || { rm -f "${img_file}.partial"; die "Download failed for ${distro}"; }
    mv -f "${img_file}.partial" "$img_file"
  else
    log "  Using cached: ${img_file}"
  fi

  log "  Creating zvol (${DISK}G, sparse, lz4)..."
  zfs create -V "${DISK}G" -s -o volblocksize=64k -o compression=lz4 "$zpath"
  for _ in $(seq 1 15); do [[ -b "$zdev" ]] && break; sleep 1; done
  [[ -b "$zdev" ]] || die "zvol device not found: ${zdev}"

  log "  Importing cloud image..."
  qemu-img convert -f qcow2 -O raw "$img_file" "$zdev"
  growpart "$zdev" 1 2>/dev/null || true

  local ci_iso
  ci_iso="$(make_cloud_init_iso "$name" "$name" "/var/lib/cloud/instance/klab-ready")"

  log "  Booting golden VM (Secure Boot: OFF during build, ON for clones)..."
  virt-install --name "$name" --ram "$RAM" --vcpus "$CPUS" \
    --os-variant "${OS_VARIANTS[$distro]}" \
    --disk "path=${zdev},bus=virtio" --disk "path=${ci_iso},device=cdrom" \
    --network bridge=virbr0,model=virtio --graphics none --noautoconsole --import \
    "${VIRT_GOLDEN_BOOT_ARGS[@]}" \
    2>&1 || die "Failed to boot golden VM for ${distro}"

  local golden_ip
  log "  Waiting for IP..."
  golden_ip="$(get_vm_ip "$name")"
  [[ -n "$golden_ip" ]] || die "No IP for ${name}"
  log "  IP: ${golden_ip}"
  log "  Waiting for SSH..."
  wait_for_ssh "$golden_ip" 300 || die "SSH timeout on ${name}"

  log "  Waiting for cloud-init..."
  for _ in $(seq 1 90); do
    _ssh_cmd "$golden_ip" "test -f /var/lib/cloud/instance/klab-ready" 2>/dev/null && break
    sleep 5
  done

  # Install test environment. setup_vm_golden can run 5-15 minutes silently
  # (package install + zfs-dkms compile). Run it in the background and
  # heartbeat the last log line every 15s so the user isn't staring at a
  # frozen terminal. Output still lands in $_setup_log verbatim — we just
  # surface it periodically rather than all-or-nothing at the end.
  # NOTE: piping kills the heredoc stdin inside setup_vm_golden, which is
  # why we redirect to a file instead of `| tee`.
  local _setup_log="/tmp/klab-setup-${distro}.log"
  : > "$_setup_log"
  setup_vm_golden "$golden_ip" "$distro" > "$_setup_log" 2>&1 &
  local _setup_pid=$!
  local _tick=0
  while kill -0 "$_setup_pid" 2>/dev/null; do
    sleep 15; _tick=$((_tick + 1))
    local _last; _last="$(tail -1 "$_setup_log" 2>/dev/null | tr -cd '[:print:]' | cut -c1-100)"
    log "  setup [${distro} t+$((_tick*15))s] ${_last:-<no output yet>}"
  done
  wait "$_setup_pid"
  if [[ -n "$RHEL_PASSWORD" ]]; then
    sed "s/${RHEL_PASSWORD}/REDACTED/g" "$_setup_log" >> "$golden_log"
  else
    cat "$_setup_log" >> "$golden_log"
  fi
  rm -f "$_setup_log"

  # Handle from-source builds
  if [[ "$ZFS_SOURCE" != "repo" ]]; then
    log "  Installing build dependencies for from-source ZFS..."
    case "${DISTRO_FAMILY[$distro]}" in
      dnf) _ssh_cmd "$ip" bash -c 'dnf install -y git libuuid-devel libblkid-devel openssl-devel libtirpc-devel python3-devel python3-cffi libaio-devel libattr-devel elfutils-libelf-devel zlib-devel 2>/dev/null || true' ;;
      apt) _ssh_cmd "$ip" bash -c 'DEBIAN_FRONTEND=noninteractive apt-get install -y git uuid-dev libblkid-dev libssl-dev libtirpc-dev python3-dev python3-cffi libaio-dev libattr1-dev libelf-dev zlib1g-dev 2>/dev/null || true' ;;
    esac
    _install_zfs_from_source "$golden_ip" "$ZFS_SOURCE"
  fi

  # Validate + seal in single SSH call
  log "  Validating golden ${distro}..."
  local _val_tmp="/tmp/klab-validate-${distro}.txt"
  _ssh_cmd "$golden_ip" bash -s <<'VALIDATE' > "$_val_tmp" 2>/dev/null || true
echo "V_KERNEL=$(uname -r 2>/dev/null || echo unknown)"
echo "V_ZFS=$(command -v zfs >/dev/null 2>&1 && echo OK || echo MISSING)"
echo "V_MOD=$(lsmod | grep -c '^zfs ' 2>/dev/null | tr -d '[:space:]' || echo 0)"
echo "V_VER=$(zfs version 2>/dev/null | head -1 || echo unknown)"
echo "V_DKMS=$(dkms status 2>/dev/null | head -1 || echo n/a)"
echo "V_TESTS=$(test -f /usr/share/zfs/zfs-tests.sh && echo OK || (command -v zfs-tests.sh >/dev/null 2>&1 && echo OK || echo MISSING))"
echo "V_VDEVS=$(ls /var/tmp/zfs-vdev*.img 2>/dev/null | wc -l)"
echo "V_KSH=$(command -v ksh >/dev/null 2>&1 && echo OK || echo MISSING)"
echo zfs > /etc/modules-load.d/zfs.conf 2>/dev/null || true
depmod -a 2>/dev/null || true
cloud-init clean --logs 2>/dev/null || true
rm -f /etc/machine-id; touch /etc/machine-id
truncate -s 0 /etc/hostname
rm -f /etc/netplan/*.yaml /etc/systemd/network/*.network 2>/dev/null || true
systemctl enable cloud-init-local cloud-init cloud-config cloud-final 2>/dev/null || true
mkdir -p /etc/systemd/network && cat > /etc/systemd/network/10-dhcp.network <<'NETD'
[Match]
Name=en* eth*

[Network]
DHCP=yes
NETD
echo "V_SEALED=OK"
shutdown -h now 2>/dev/null || true
VALIDATE

  local _v_kernel _v_zfs _v_mod _v_ver _v_dkms _v_tests _v_vdevs _v_ksh
  _v_kernel="$(grep '^V_KERNEL=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "unknown")"
  _v_zfs="$(grep '^V_ZFS=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "MISSING")"
  _v_mod="$(grep '^V_MOD=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "0")"
  _v_ver="$(grep '^V_VER=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "unknown")"
  _v_dkms="$(grep '^V_DKMS=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "n/a")"
  _v_tests="$(grep '^V_TESTS=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "MISSING")"
  _v_vdevs="$(grep '^V_VDEVS=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "0")"
  _v_ksh="$(grep '^V_KSH=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "MISSING")"
  rm -f "$_val_tmp"
  [[ -z "$_v_kernel" ]] && _v_kernel="unknown"
  [[ -z "$_v_mod" ]] && _v_mod="0"

  {
    echo ""; echo "═══════════════════════════════════════════════════════════"
    echo "  Golden Validation Report: ${distro}"
    echo "═══════════════════════════════════════════════════════════"
    echo "  Kernel:         ${_v_kernel}"; echo "  ZFS binary:     ${_v_zfs}"
    echo "  ZFS module:     $([[ $_v_mod -ge 1 ]] && echo "LOADED" || echo "NOT LOADED")"
    echo "  ZFS version:    ${_v_ver}"; echo "  DKMS status:    ${_v_dkms}"
    echo "  zfs-tests.sh:   ${_v_tests}"; echo "  vdev images:    ${_v_vdevs}/4"
    echo "  ksh:            ${_v_ksh}"; echo "  ZFS source:     ${ZFS_SOURCE}"
    echo "  NVIDIA:         $([[ $NVIDIA_DETECTED -eq 1 ]] && echo "installed" || echo "n/a")"
    local _result="PASS"
    [[ "$_v_zfs" != "OK" || "$_v_mod" -lt 1 ]] && _result="FAIL"
    [[ "$_v_tests" != "OK" ]] && _result="PARTIAL (no tests)"
    echo "  Result:         ${_result}"
    echo "═══════════════════════════════════════════════════════════"; echo ""
  } | tee -a "$golden_log"

  log "    ZFS binary:     ${_v_zfs}"
  log "    ZFS module:     $([[ $_v_mod -ge 1 ]] && echo "loaded" || echo "NOT LOADED")"
  log "    ZFS version:    ${_v_ver}"
  log "    Kernel:         ${_v_kernel}"
  log "    DKMS:           ${_v_dkms}"
  log "    zfs-tests.sh:   ${_v_tests}"
  log "    vdev images:    ${_v_vdevs}/4"
  log "    ksh:            ${_v_ksh}"
  log "  Sealed + shutdown initiated in validation pass"

  for _ in $(seq 1 30); do virsh domstate "$name" 2>/dev/null | grep -q "shut off" && break; sleep 2; done
  virsh detach-disk "$name" "$ci_iso" --config 2>/dev/null || true; rm -f "$ci_iso"
  zfs snapshot "${zpath}@golden"

  local elapsed; elapsed="$(timer_elapsed_ms "$t_start")"
  { echo "Golden build complete: ${name}"; echo "  Time: $((elapsed / 1000))s"; echo "  Snapshot: ${zpath}@golden"; echo "  Size: $(zfs get -Hp -o value used "$zpath" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo "?")"; echo "  Finished: $(date)"; } | tee -a "$golden_log"
  ln -sfn "$golden_log" "${golden_log_dir}/${distro}-latest.log"
  log "Golden ready: ${C}${name}${N} ($((elapsed / 1000))s) — log: ${golden_log}"
}

cmd_golden() {
  local target="${1:-all}"
  if [[ "$target" == "all" ]]; then
    for distro in "${DISTROS[@]}"; do
      build_golden_single "$distro" || warn "Failed to build golden for ${distro}"
    done
  else
    build_golden_single "$target"
  fi
}

# Build the ZFS-test-dedicated golden lineage. Exports:
#   KLAB_GOLDEN_KIND=ztest   → golden_name() returns klab-ztest-<distro>
#   KLAB_ZFS_DEV=1           → setup_vm_golden() installs full test deps
# Produces klab-ztest-<distro> images independently of the blue-green
# klab-golden-<distro> set. Idempotent — if the ztest golden already
# exists, build_golden_single skips it (same as regular).
cmd_golden_ztest() {
  local target="${1:-all}"
  export KLAB_GOLDEN_KIND=ztest
  export KLAB_ZFS_DEV=1
  log "Building ZFS test goldens (target=${target}) — these are separate from blue-green goldens."
  if [[ "$target" == "all" ]]; then
    for distro in "${DISTROS[@]}"; do
      build_golden_single "$distro" || warn "Failed to build ZTEST golden for ${distro}"
    done
  else
    build_golden_single "$target"
  fi
  log "ZFS test goldens ready. Names: klab-ztest-<distro>"
}

# ── Section 6: Site Deploy (Blue-Green) ──────────────────────────────────

deploy_site() {
  local site="$1"
  validate_site "$site"

  ensure_ssh_key
  local deployed=0 skipped=0
  local total_start; total_start="$(timer_start)"

  # Static IP scheme: blue=192.168.122.101-106, green=192.168.122.201-206
  # First 100 IPs reserved for infrastructure (gateway, DHCP, goldens)
  local ip_base
  [[ "$site" == "blue" ]] && ip_base=100 || ip_base=200

  log "Deploying ${site} site (${#DISTROS[@]} distros)..."

  local node_idx=0
  for distro in "${DISTROS[@]}"; do
    ((node_idx++))
    local gname gpath sname spath sdev
    gname="$(golden_name "$distro")"
    gpath="$(zvol_path "$gname")"
    sname="$(site_name "$site" "$distro")"
    spath="$(zvol_path "$sname")"
    sdev="$(zvol_dev "$sname")"
    local vm_ip="192.168.122.$((ip_base + node_idx))"

    if ! zfs list "${gpath}@golden" >/dev/null 2>&1; then
      warn "No golden for ${distro} — skipping"
      ((skipped++)); continue
    fi
    if zfs list "$spath" >/dev/null 2>&1; then
      warn "${sname} already exists — skipping"
      ((skipped++)); continue
    fi

    echo -ne "  ${gname}@golden -> ${sname} (${vm_ip}) ... "
    local cs; cs="$(timer_start)"
    zfs clone "${gpath}@golden" "$spath"
    local ce; ce="$(timer_elapsed_ms "$cs")"
    echo -e "${G}done${N} (${C}${ce}ms${N})"

    for _ in $(seq 1 10); do [[ -b "$sdev" ]] && break; sleep 1; done
    [[ -b "$sdev" ]] || { warn "zvol device not found for ${sname}"; continue; }

    local ci_iso; ci_iso="$(make_cloud_init_iso "$sname" "${site}-${distro}" "" "$vm_ip")"
    virt-install --name "$sname" --ram "$RAM" --vcpus "$CPUS" \
      --os-variant "${OS_VARIANTS[$distro]}" \
      --disk "path=${sdev},bus=virtio" --disk "path=${ci_iso},device=cdrom" \
      --network bridge=virbr0,model=virtio --graphics vnc,listen=0.0.0.0 \
      "${VIRT_BOOT_ARGS[@]}" "${VIRT_TPM_ARGS[@]}" \
      --noautoconsole --import 2>&1 || { warn "Failed to boot ${sname}"; continue; }

    echo -e "  ${G}${sname}${N} started"
    ((deployed++))
  done

  log "Waiting for VMs to boot (static IPs: 192.168.122.$((ip_base+1))-$((ip_base+node_idx)))..."
  sleep 20

  echo ""
  echo -e "${W}  Site ${site} VMs:${N}"
  printf "  %-25s %-18s %s\n" "VM" "IP" "ZFS"
  printf "  %-25s %-18s %s\n" "-------------------------" "------------------" "---"

  local vm_idx=0
  for distro in "${DISTROS[@]}"; do
    ((vm_idx++))
    local sname; sname="$(site_name "$site" "$distro")"
    virsh domstate "$sname" >/dev/null 2>&1 || continue
    local ip="192.168.122.$((ip_base + vm_idx))"
    if wait_for_ssh "$ip" 60; then
      _ssh_cmd "$ip" "hostnamectl set-hostname ${site}-${distro}; systemd-machine-id-setup 2>/dev/null" || true
      local zfs_ver; zfs_ver="$(_ssh_cmd "$ip" "zfs version 2>/dev/null | head -1" || echo "n/a")"
      printf "  ${G}%-25s${N} %-18s %s\n" "$sname" "$ip" "$zfs_ver"
    else
      printf "  ${R}%-25s${N} %-18s %s\n" "$sname" "$ip" "no SSH"
    fi
  done

  # ── WireGuard mesh ──────────────────────────────────────────────────
  echo ""
  log "Configuring WireGuard mesh..."
  local wg_base
  [[ "$site" == "blue" ]] && wg_base="10.252.0" || wg_base="10.253.0"

  # Phase 1: Generate WireGuard keypairs on all VMs
  declare -A wg_ips=() wg_pubs=()
  local node_id=1
  for distro in "${DISTROS[@]}"; do
    local sname; sname="$(site_name "$site" "$distro")"
    virsh domstate "$sname" 2>/dev/null | grep -q running || { ((node_id++)); continue; }
    local ip; ip="$(get_vm_ip "$sname")"; [[ -z "$ip" ]] && { ((node_id++)); continue; }
    _ssh_cmd "$ip" "command -v wg >/dev/null 2>&1" 2>/dev/null || { ((node_id++)); continue; }

    _ssh_cmd "$ip" bash -s <<WGINIT 2>/dev/null || true
mkdir -p /etc/wireguard
wg genkey > /etc/wireguard/lab.key 2>/dev/null
chmod 600 /etc/wireguard/lab.key
wg pubkey < /etc/wireguard/lab.key > /etc/wireguard/lab.pub 2>/dev/null
cat > /etc/wireguard/wg-lab.conf <<WG
[Interface]
PrivateKey = \$(cat /etc/wireguard/lab.key)
Address = ${wg_base}.${node_id}/24
ListenPort = 51830
WG
WGINIT

    local pub; pub="$(_ssh_cmd "$ip" 'cat /etc/wireguard/lab.pub 2>/dev/null')"
    if [[ -n "$pub" ]]; then
      wg_ips[$distro]="$ip"; wg_pubs[$distro]="$pub"
      echo -e "  ${G}${sname}${N} -> ${wg_base}.${node_id}"
    fi
    ((node_id++))
  done

  # Phase 2: Full mesh — peer every VM with every other VM
  node_id=1
  for distro_a in "${DISTROS[@]}"; do
    [[ -z "${wg_ips[$distro_a]:-}" ]] && { ((node_id++)); continue; }
    local peer_id=1
    for distro_b in "${DISTROS[@]}"; do
      [[ -z "${wg_ips[$distro_b]:-}" ]] && { ((peer_id++)); continue; }
      [[ "$distro_a" == "$distro_b" ]] && { ((peer_id++)); continue; }
      _ssh_cmd "${wg_ips[$distro_a]}" "wg set wg-lab peer ${wg_pubs[$distro_b]} allowed-ips ${wg_base}.${peer_id}/32 endpoint ${wg_ips[$distro_b]}:51830 persistent-keepalive 25" 2>/dev/null || true
      ((peer_id++))
    done
    _ssh_cmd "${wg_ips[$distro_a]}" "ip link add dev wg-lab type wireguard 2>/dev/null; wg setconf wg-lab /etc/wireguard/wg-lab.conf 2>/dev/null; ip addr add ${wg_base}.${node_id}/24 dev wg-lab 2>/dev/null; ip link set wg-lab up 2>/dev/null" || true
    # Allow WireGuard traffic through firewall
    _ssh_cmd "${wg_ips[$distro_a]}" "nft add table inet filter 2>/dev/null; nft add chain inet filter input '{ type filter hook input priority 0; policy accept; }' 2>/dev/null; nft add rule inet filter input iifname wg-lab accept 2>/dev/null; nft add rule inet filter input udp dport 51830 accept 2>/dev/null" || true
    ((node_id++))
  done

  # Host joins the mesh as .254 so Prometheus can scrape over WireGuard
  if command -v wg >/dev/null 2>&1; then
    local host_wg_ip="${wg_base}.254"
    mkdir -p /etc/wireguard
    if [[ ! -f /etc/wireguard/klab-${site}.key ]]; then
      wg genkey > "/etc/wireguard/klab-${site}.key" 2>/dev/null
      chmod 600 "/etc/wireguard/klab-${site}.key"
      wg pubkey < "/etc/wireguard/klab-${site}.key" > "/etc/wireguard/klab-${site}.pub" 2>/dev/null
    fi
    local host_pub; host_pub="$(cat "/etc/wireguard/klab-${site}.pub" 2>/dev/null)"
    local host_priv; host_priv="$(cat "/etc/wireguard/klab-${site}.key" 2>/dev/null)"

    cat > "/etc/wireguard/klab-${site}.conf" <<WG
[Interface]
PrivateKey = ${host_priv}
Address = ${host_wg_ip}/24
ListenPort = $([[ "$site" == "blue" ]] && echo 51831 || echo 51832)
WG

    # Add all VM peers to host config
    node_id=1
    for distro in "${DISTROS[@]}"; do
      [[ -z "${wg_ips[$distro]:-}" ]] && { ((node_id++)); continue; }
      cat >> "/etc/wireguard/klab-${site}.conf" <<PEER

[Peer]
PublicKey = ${wg_pubs[$distro]}
AllowedIPs = ${wg_base}.${node_id}/32
Endpoint = ${wg_ips[$distro]}:51830
PersistentKeepalive = 25
PEER
      # Add host as peer on the VM
      _ssh_cmd "${wg_ips[$distro]}" "wg set wg-lab peer ${host_pub} allowed-ips ${host_wg_ip}/32 endpoint $(ip route get 1.1.1.1 2>/dev/null | awk '/src/{print $7}' | head -1):$([[ "$site" == "blue" ]] && echo 51831 || echo 51832) persistent-keepalive 25" 2>/dev/null || true
      ((node_id++))
    done

    # Bring up host WireGuard interface
    ip link del "klab-${site}" 2>/dev/null || true
    ip link add dev "klab-${site}" type wireguard 2>/dev/null
    wg setconf "klab-${site}" "/etc/wireguard/klab-${site}.conf" 2>/dev/null
    ip addr add "${host_wg_ip}/24" dev "klab-${site}" 2>/dev/null
    ip link set "klab-${site}" up 2>/dev/null
    log "Host joined ${site} mesh as ${host_wg_ip} (klab-${site})"
  fi

  log "WireGuard mesh configured (${wg_base}.0/24)"

  # Reload Prometheus if running (picks up new targets)
  systemctl reload prometheus 2>/dev/null || true

  local total_elapsed; total_elapsed="$(timer_elapsed_ms "$total_start")"
  echo ""
  log "Deploy complete: ${G}${deployed} deployed${N}, ${Y}${skipped} skipped${N} ($((total_elapsed / 1000))s)"
  echo -e "  ${W}WireGuard:${N}  ${wg_base}.0/24 (all traffic encrypted)"
  echo -e "  ${W}SSH:${N}        ssh root@<vm-ip> (password: kldload)"
  echo -e "  ${W}Grafana:${N}    http://localhost:3000 (admin/admin)"
}

# ── Section 7: Blue-Green Operations ─────────────────────────────────────

destroy_site() {
  local site="$1" quiet="${2:-}"
  for distro in "${DISTROS[@]}"; do
    local sname; sname="$(site_name "$site" "$distro")"
    local spath; spath="$(zvol_path "$sname")"
    virsh destroy "$sname" 2>/dev/null || true
    virsh undefine "$sname" --nvram 2>/dev/null || virsh undefine "$sname" 2>/dev/null || true
    zfs destroy -Rf "$spath" 2>/dev/null || true
    rm -f "${ISO_DIR}/${sname}-cloud-init.iso" 2>/dev/null
  done
  # Obs VM
  local obs_sname="${PREFIX}-${site}-obs"
  virsh destroy "$obs_sname" 2>/dev/null || true
  virsh undefine "$obs_sname" --nvram 2>/dev/null || virsh undefine "$obs_sname" 2>/dev/null || true
  zfs destroy -Rf "${POOL}/vms/${obs_sname}" 2>/dev/null || true
  [[ -n "$quiet" ]] || log "Site ${site} destroyed"
}

cmd_promote() {
  local site="${1:-green}"
  [[ "$site" == "green" ]] || die "Can only promote green to blue"
  log "Promoting green -> blue"

  local ts; ts="$(date +%Y%m%d-%H%M%S)"
  local had_blue=false
  for distro in "${DISTROS[@]}"; do
    local bpath; bpath="$(zvol_path "$(site_name blue "$distro")")"
    if zfs list "$bpath" >/dev/null 2>&1; then
      had_blue=true
      zfs snapshot "${bpath}@pre-promote-${ts}" 2>/dev/null || true
    fi
  done
  $had_blue && destroy_site "blue" quiet

  for distro in "${DISTROS[@]}"; do
    local gname bname gpath bpath
    gname="$(site_name green "$distro")"; bname="$(site_name blue "$distro")"
    gpath="$(zvol_path "$gname")"; bpath="$(zvol_path "$bname")"
    zfs list "$gpath" >/dev/null 2>&1 || continue
    virsh destroy "$gname" 2>/dev/null || true
    virsh undefine "$gname" --nvram 2>/dev/null || virsh undefine "$gname" 2>/dev/null || true
    zfs snapshot "${gpath}@promoted-${ts}" 2>/dev/null || true
    echo -ne "  ${gname} -> ${bname} ... "
    local cs; cs="$(timer_start)"
    zfs clone "${gpath}@promoted-${ts}" "$bpath"
    echo -e "${G}done${N} (${C}$(timer_elapsed_ms "$cs")ms${N})"
    zfs destroy -Rf "$gpath" 2>/dev/null || true
  done

  log "Booting new blue site..."
  deploy_site "blue"
}

cmd_rollback() {
  log "Rolling back blue site to previous snapshot..."
  for distro in "${DISTROS[@]}"; do
    local bname bpath
    bname="$(site_name blue "$distro")"; bpath="$(zvol_path "$bname")"
    zfs list "$bpath" >/dev/null 2>&1 || continue
    local snap; snap="$(zfs list -t snapshot -o name -s creation -r "$bpath" 2>/dev/null | tail -1)"
    [[ -z "$snap" || "$snap" == "NAME" ]] && { warn "No snapshots for ${bname}"; continue; }
    virsh destroy "$bname" 2>/dev/null || true
    virsh undefine "$bname" --nvram 2>/dev/null || virsh undefine "$bname" 2>/dev/null || true
    log "  Rolling back ${bname} to ${snap}"
    zfs rollback -r "$snap"
  done
  deploy_site "blue"
}

# ── Section 8: Payloads ──────────────────────────────────────────────────

# Payload: OpenZFS Test Suite
run_tests_on_vm() {
  local distro="$1" mode="$2" run_dir="$3" ip="$4"
  local log_file="${run_dir}/${distro}.log"
  local progress_file="${run_dir}/${distro}.status"
  echo "running" > "$progress_file"
  log "  [${distro}] Starting ${mode} tests on ${ip}..."

  # zfs-tests.sh args. Quick mode runs a small tag set that finishes in
  # ~3-5 min per distro. Full mode runs the entire functional suite (~2h).
  # The previous "-c" was wrong — it expects a config file and consumed
  # the next arg, silently exiting before any test ran. Tags are
  # comma-separated; "fault,zpool" gives broad cli + fault coverage in
  # under 5 min and produces real PASS/FAIL output.
  local _test_args=""
  if [[ "$mode" == "quick" ]]; then
    _test_args="-vx -T fault,zpool"
  else
    _test_args="-vx"
  fi

  local tests_path
  tests_path="$(_ssh_cmd "$ip" "command -v zfs-tests.sh 2>/dev/null || echo /usr/share/zfs/zfs-tests.sh")"
  if ! _ssh_cmd "$ip" "test -f ${tests_path}" 2>/dev/null; then
    echo "SKIP: zfs-tests.sh not found" > "$log_file"
    echo "skip" > "$progress_file"
    return 0
  fi

  # ── Per-VM attestation ────────────────────────────────────────────
  # Capture the exact environment this test ran in — kernel, ZFS
  # binary+module versions, loaded DKMS modules, full package list,
  # pool config. Written to <distro>.env / .packages / .zpool in the
  # run dir so an auditor can reconstruct (or re-run) the exact
  # environment from the bundle. No guessing about "which version
  # of zfs was this?"
  _ssh_cmd "$ip" "
    echo '=== uname ==='; uname -a
    echo ''; echo '=== zfs binary ==='; zfs version 2>&1 | head -10
    echo ''; echo '=== zfs module ==='; modinfo zfs 2>&1 | grep -E '^(version|vermagic|srcversion)'
    echo ''; echo '=== dkms status ==='; dkms status 2>&1
    echo ''; echo '=== test-tools checksum ==='
    sha256sum ${tests_path} 2>&1
    sha256sum /usr/share/zfs/test-runner/bin/test-runner.py 2>&1 || true
  " > "${run_dir}/${distro}.env" 2>&1 || true
  _ssh_cmd "$ip" "rpm -qa 2>/dev/null | sort || dpkg -l 2>/dev/null | grep '^ii' | awk '{print \$2\"=\"\$3}' | sort" \
    > "${run_dir}/${distro}.packages" 2>&1 || true
  _ssh_cmd "$ip" "zpool status; echo; zfs list -t all" \
    > "${run_dir}/${distro}.zpool" 2>&1 || true

  # Stream test output AND capture it. Without tee the test runner's
  # PASS/FAIL/SKIP lines disappear into the log file and the UI's stream
  # panel only sees "Starting" and "Done" — making it impossible to verify
  # the test is actually running. stdbuf -oL keeps lines flushing instead
  # of buffering until the test ends. Prefix every line with [distro] so
  # parallel runs interleave readably.
  #
  # zfs-tests.sh refuses to run as root by design (it has to create test
  # pools as a normal user that escalates with sudo). We create a
  # 'zfstest' user with passwordless sudo on the test VM, then su to it.
  _ssh_cmd "$ip" "
    echo '=== ZFS Test Run ==='
    echo \"Kernel: \$(uname -r)\"
    if ! modprobe zfs 2>/dev/null; then
      echo 'Rebuilding DKMS...'
      dkms autoinstall 2>&1 | tail -5
      depmod -a 2>/dev/null; modprobe zfs 2>&1
    fi
    echo \"ZFS: \$(zfs version 2>/dev/null | head -1)\"
    if ! lsmod | grep -q '^zfs '; then echo 'FATAL: ZFS module not loaded'; exit 1; fi
    # Create the test user if missing — same pattern as upstream's
    # ./scripts/zfs-tests.sh in CI. Passwordless sudo so the test runner
    # can escalate for zpool create / mount / etc.
    if ! id zfstest >/dev/null 2>&1; then
      useradd -m -s /bin/bash zfstest 2>&1 || true
      echo 'zfstest ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/zfstest
      chmod 440 /etc/sudoers.d/zfstest
    fi
    # Some loop devices may need creating before tests run.
    modprobe loop 2>/dev/null || true
    su - zfstest -c \"stdbuf -oL /usr/share/zfs/zfs-tests.sh ${_test_args}\" 2>&1
    echo \"Finished: \$(date)\"
  " 2>&1 | stdbuf -oL sed -u "s/^/[${distro}] /" | tee "$log_file" || true

  local total_pass total_fail total_skip
  total_pass="$(grep -c '\[PASS\]' "$log_file" 2>/dev/null)" || total_pass=0
  total_fail="$(grep -c '\[FAIL\]' "$log_file" 2>/dev/null)" || total_fail=0
  total_skip="$(grep -c '\[SKIP\]' "$log_file" 2>/dev/null)" || total_skip=0
  [[ "$total_pass" =~ ^[0-9]+$ ]] || total_pass=0
  [[ "$total_fail" =~ ^[0-9]+$ ]] || total_fail=0
  [[ "$total_skip" =~ ^[0-9]+$ ]] || total_skip=0

  cat > "${run_dir}/${distro}.summary" <<SUMMARY
distro=${distro}
pass=${total_pass}
fail=${total_fail}
skip=${total_skip}
total=$((total_pass + total_fail + total_skip))
SUMMARY
  # Status sidecar: "pass" only if tests actually ran AND none failed.
  # "empty" when nothing was recorded (early exit, bad args, etc.) —
  # previously reported "pass" which masked broken runs in the UI.
  local _total=$((total_pass + total_fail + total_skip))
  if [[ "$total_fail" -gt 0 ]]; then
    echo "fail" > "$progress_file"
  elif [[ "$_total" -eq 0 ]]; then
    echo "empty" > "$progress_file"
  else
    echo "pass" > "$progress_file"
  fi
  log "  [${distro}] Done: ${total_pass} pass, ${total_fail} fail, ${total_skip} skip ($(cat "$progress_file"))"
}

cmd_test() {
  local mode="quick" distro_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --quick) mode="quick"; shift ;;
      --full)  mode="full"; shift ;;
      --distro) distro_filter="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  local selected_distros=()
  if [[ -n "$distro_filter" ]]; then
    IFS=',' read -ra selected_distros <<< "$distro_filter"
  else
    selected_distros=("${DISTROS[@]}")
  fi

  # Use the dedicated ZFS test goldens — these carry all the required
  # zfs-tests.sh prerequisites (ksh, fio, pamtester, pax, etc.). Regular
  # blue-green goldens are lean by design and WOULD skip 46+ tests.
  export KLAB_GOLDEN_KIND=ztest
  local _missing=()
  for _d in "${selected_distros[@]}"; do
    local _g; _g="$(golden_name "$_d")"
    zfs list "$(zvol_path "${_g}")@golden" >/dev/null 2>&1 || _missing+=("$_d")
  done
  if (( ${#_missing[@]} > 0 )); then
    warn "ZFS test goldens missing for: ${_missing[*]}"
    warn "  Build them first:  klab golden-ztest all"
    warn "  Or pick existing:  klab test --full --distro centos"
    [[ "${#_missing[@]}" == "${#selected_distros[@]}" ]] && die "No ZFS test goldens exist."
    log "Proceeding with only the distros that have ztest goldens."
    selected_distros=()
    for _d in "${DISTROS[@]}"; do
      local _g; _g="$(golden_name "$_d")"
      zfs list "$(zvol_path "${_g}")@golden" >/dev/null 2>&1 && selected_distros+=("$_d")
    done
  fi

  ensure_ssh_key
  local run_id; run_id="$(date +%Y%m%d-%H%M%S)"
  local run_dir="${RESULTS_DIR}/${run_id}"
  mkdir -p "$run_dir"
  # Point the `latest` symlink at the run dir BEFORE we do any work,
  # so `kztest-tail` and external watchers can follow full.log as it
  # streams. The symlink is re-pointed again at end-of-run (same dir,
  # idempotent) to keep the historical "latest completed run" semantic.
  ln -sfn "$run_dir" "${RESULTS_DIR}/latest"

  # Consolidated run log — the single file the OpenZFS team can grep or
  # attach to a bug report. Every line streamed to the user during this
  # test also lands here, interleaved with [distro] prefixes.
  exec > >(tee -a "${run_dir}/full.log") 2>&1

  # ── Audit manifest (part 1 of 2: pre-run provenance) ─────────────
  # The OpenZFS team (or any auditor) must be able to prove, from this
  # directory alone, exactly what code ran on exactly what images on
  # exactly what host. Captured here BEFORE any VMs boot so a hung/
  # killed run still has the full setup recorded. A second block is
  # appended at end-of-run (see below) with the completion metrics.
  local _kldload_ver; _kldload_ver="$(cat /etc/kldload/version 2>/dev/null || echo '?')"
  local _kldload_git; _kldload_git="$(cd / && git -C /usr/share/kldload rev-parse HEAD 2>/dev/null || echo 'not-a-git-install')"
  local _host_id; _host_id="$(cat /etc/machine-id 2>/dev/null || echo '?')"
  local _host_cpu; _host_cpu="$(awk -F: '/model name/ {print $2; exit}' /proc/cpuinfo | sed 's/^ *//')"
  local _host_ram; _host_ram="$(awk '/MemTotal/ {printf "%d MB", $2/1024}' /proc/meminfo)"
  {
    echo "# kldload ZFS-test audit manifest"
    echo "# This file, together with full.log and the per-distro artifacts,"
    echo "# constitutes the complete audit record of the run."
    echo ""
    echo "[run]"
    echo "run_id         = ${run_id}"
    echo "mode           = ${mode}"
    echo "distros        = ${selected_distros[*]}"
    echo "serial         = ${KLAB_SERIAL:-0}"
    echo "concurrency    = ${KLAB_MAX_CONCURRENT:-auto}"
    echo "invocation     = ${0} ${*}"
    echo "invoker_uid    = ${EUID}"
    echo "invoker_pid    = $$"
    echo "date_start     = $(date -Iseconds)"
    echo "date_start_ns  = $(date +%s%N)"
    echo ""
    echo "[kldload]"
    echo "version        = ${_kldload_ver}"
    echo "codename       = Proving Ground"
    echo "git_sha        = ${_kldload_git}"
    echo "klab_sha256    = $(sha256sum /usr/local/bin/klab 2>/dev/null | awk '{print $1}')"
    echo ""
    echo "[host]"
    echo "hostname       = $(hostname 2>/dev/null || cat /etc/hostname)"
    echo "machine_id     = ${_host_id}"
    echo "kernel         = $(uname -r)"
    echo "os             = $(. /etc/os-release 2>/dev/null; echo ${PRETTY_NAME:-?})"
    echo "cpu            = ${_host_cpu}"
    echo "cpus           = $(nproc)"
    echo "ram            = ${_host_ram}"
    echo "zfs            = $(zfs version 2>/dev/null | head -1)"
    echo "zpool_health   = $(zpool list -H -o health 2>/dev/null | head -1)"
    echo ""
    echo "[goldens]"
    for _d in "${selected_distros[@]}"; do
      local _g="$(golden_name "$_d")"
      local _gsnap="rpool/vms/${_g}@golden"
      local _guid _csum _created _size
      _guid="$(zfs get -Hp -o value guid "$_gsnap" 2>/dev/null || echo '-')"
      _created="$(zfs get -Hp -o value creation "$_gsnap" 2>/dev/null | awk '{if($1 ~ /^[0-9]+$/) print strftime("%Y-%m-%dT%H:%M:%S", $1); else print $0}')"
      _size="$(zfs get -Hp -o value referenced "$_gsnap" 2>/dev/null || echo '-')"
      echo "${_d}.name     = ${_g}"
      echo "${_d}.snapshot = ${_gsnap}"
      echo "${_d}.guid     = ${_guid}"
      echo "${_d}.created  = ${_created}"
      echo "${_d}.size     = ${_size}"
    done
  } > "${run_dir}/manifest.txt"

  # Reference the ISO install attestation so the auditor can walk the
  # chain: ISO SHA256 → installed host → this run.
  [[ -f /etc/kldload/install.attest ]] && \
    cat /etc/kldload/install.attest >> "${run_dir}/manifest.txt"

  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  klab test — ${mode} mode${N}"
  echo -e "${D}  Distros: ${selected_distros[*]}${N}"
  echo -e "${D}  Run ID:  ${run_id}${N}"
  echo -e "${D}  Full log: ${run_dir}/full.log${N}"
  echo -e "${D}  Manifest: ${run_dir}/manifest.txt  (audit provenance)${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"

  local t_start; t_start="$(timer_start)"
  declare -A vm_ips=()

  log "Cloning and booting test VMs..."
  for distro in "${selected_distros[@]}"; do
    local name zpath golden_zpath
    name="$(test_vm_name "$distro")"; zpath="$(zvol_path "$name")"
    golden_zpath="$(zvol_path "$(golden_name "$distro")")"
    zfs list "${golden_zpath}@golden" >/dev/null 2>&1 || { warn "No golden for ${distro}"; continue; }
    virsh destroy "$name" 2>/dev/null || true; virsh undefine "$name" 2>/dev/null || true
    # Wait for libvirt to release the zvol before destroying the dataset.
    # virsh destroy returns synchronously but the qemu process may still
    # have the zvol open for a beat — without this, zfs destroy fails
    # silently and the next zfs clone hits "dataset already exists".
    for _i in 1 2 3 4 5; do
      zfs destroy -Rf "$zpath" 2>/dev/null && break
      sleep 1
    done
    if zfs list "$zpath" >/dev/null 2>&1; then
      warn "  ${distro}: could not free old zvol ${zpath} — skipping"
      continue
    fi
    local ct; ct="$(timer_start)"
    if ! zfs clone "${golden_zpath}@golden" "$zpath" 2>&1; then
      warn "  ${distro}: clone failed — skipping"
      continue
    fi
    log "  Cloned ${distro} in $(timer_elapsed_ms "$ct")ms"
    local ci_iso zdev; zdev="$(zvol_dev "$name")"
    ci_iso="$(make_cloud_init_iso "$name" "${PREFIX}-test-${distro}")"
    virt-install --name "$name" --ram "$RAM" --vcpus "$CPUS" \
      --os-variant "${OS_VARIANTS[$distro]}" \
      --disk "path=${zdev},bus=virtio" --disk "path=${ci_iso},device=cdrom" \
      --network bridge=virbr0,model=virtio --graphics none --noautoconsole --import \
      "${VIRT_BOOT_ARGS[@]}" "${VIRT_TPM_ARGS[@]}" \
      >/dev/null 2>&1 || { warn "Failed to boot ${distro}"; continue; }
  done

  log "Waiting for SSH (parallel)..."
  # Wait for each VM's SSH in parallel — was sequential, where one slow
  # cold-boot (e.g. fedora) made every later distro queue behind it.
  # Each background task writes its result to a tmp file the parent then
  # collects. wait_for_ssh polls every 2s up to 300s.
  local _ssh_tmp; _ssh_tmp="$(mktemp -d)"
  for distro in "${selected_distros[@]}"; do
    local name; name="$(test_vm_name "$distro")"
    virsh domstate "$name" 2>/dev/null | grep -q running || continue
    (
      local _ip; _ip="$(get_vm_ip "$name")"
      if [[ -n "$_ip" ]] && wait_for_ssh "$_ip" 300; then
        echo "$_ip" > "${_ssh_tmp}/${distro}"
        log "  ${distro}: ${_ip} (SSH OK)"
      else
        log "  ${distro}: SSH timeout"
      fi
    ) &
  done
  wait
  for distro in "${selected_distros[@]}"; do
    [[ -s "${_ssh_tmp}/${distro}" ]] && vm_ips[$distro]="$(cat "${_ssh_tmp}/${distro}")"
  done
  rm -rf "$_ssh_tmp"

  local serial="${KLAB_SERIAL:-0}"
  if [[ "$serial" == "1" ]]; then
    log "Running ${mode} tests in series (one distro at a time)..."
    for distro in "${!vm_ips[@]}"; do
      log "  Testing ${distro}..."
      run_tests_on_vm "$distro" "$mode" "$run_dir" "${vm_ips[$distro]}"
    done
  else
    # Parallel execution with an 80%-cores concurrency cap. Previous
    # "smart" gate with kill-0 bookkeeping deadlocked when subshells
    # exited faster than the bookkeeper tracked them. Keep it simple:
    # if we're at or under the cap, fire all at once; otherwise batch.
    local _host_cores _max _n=${#vm_ips[@]}
    _host_cores="$(nproc 2>/dev/null || echo 4)"
    if [[ -n "${KLAB_MAX_CONCURRENT:-}" ]]; then
      _max="${KLAB_MAX_CONCURRENT}"
    else
      _max=$(( (_host_cores * 8 / 10) / CPUS ))
      (( _max < 1 )) && _max=1
    fi

    if (( _n <= _max )); then
      log "Running ${mode} tests in parallel (${_n} VMs, cap ${_max})..."
      for distro in "${!vm_ips[@]}"; do
        run_tests_on_vm "$distro" "$mode" "$run_dir" "${vm_ips[$distro]}" &
      done
      wait   # waits for all backgrounded jobs in this shell
    else
      # Rare case: more VMs than cap — run in batches of _max.
      log "Running ${mode} tests in batches of ${_max} (${_n} VMs total)..."
      local _distros=("${!vm_ips[@]}")
      local _i=0
      while (( _i < _n )); do
        local _end=$(( _i + _max )); (( _end > _n )) && _end=$_n
        for (( j=_i; j<_end; j++ )); do
          local _d="${_distros[$j]}"
          run_tests_on_vm "$_d" "$mode" "$run_dir" "${vm_ips[$_d]}" &
        done
        wait
        _i=$_end
      done
    fi
  fi

  local elapsed; elapsed="$(timer_elapsed_ms "$t_start")"
  cmd_results "$run_id"
  log "Total time: $((elapsed / 1000))s"
  ln -sfn "$run_dir" "${RESULTS_DIR}/latest"

  # ── End-of-run audit closure ─────────────────────────────────────
  # Appends to manifest.txt: result totals, exact zfs-tests.sh
  # invocation (proves we used stock upstream runner), per-distro env
  # references, and the SHA-256 of every artifact in the run dir so
  # the auditor can detect tampering post-facto.
  local _total_pass=0 _total_fail=0 _total_skip=0 _distro_lines=()
  for _d in "${selected_distros[@]}"; do
    [[ -f "${run_dir}/${_d}.summary" ]] || continue
    local _p _f _s
    _p="$(awk -F= '/^pass=/ {print $2}' "${run_dir}/${_d}.summary")"
    _f="$(awk -F= '/^fail=/ {print $2}' "${run_dir}/${_d}.summary")"
    _s="$(awk -F= '/^skip=/ {print $2}' "${run_dir}/${_d}.summary")"
    _total_pass=$((_total_pass + ${_p:-0}))
    _total_fail=$((_total_fail + ${_f:-0}))
    _total_skip=$((_total_skip + ${_s:-0}))
    _distro_lines+=("${_d}: pass=${_p:-0} fail=${_f:-0} skip=${_s:-0}")
  done

  local _test_args_for_manifest
  if [[ "$mode" == "quick" ]]; then _test_args_for_manifest="-vx -T fault,zpool"
  else _test_args_for_manifest="-vx"; fi

  {
    echo ""
    echo "[reproducibility]"
    echo "# To re-run these tests on any stock upstream OpenZFS install,"
    echo "# duplicate the distro+kernel+zfs combo listed above and run:"
    echo "#   sudo -u zfstest /usr/share/zfs/zfs-tests.sh ${_test_args_for_manifest}"
    echo "# klab invokes the test runner with NO patches, NO overlays,"
    echo "# and NO custom wrapping. The sha256 of zfs-tests.sh +"
    echo "# test-runner.py on each VM is recorded in <distro>.env —"
    echo "# compare against the upstream release tarball to verify."
    echo "zfs_tests_args = ${_test_args_for_manifest}"
    echo "runner         = /usr/share/zfs/zfs-tests.sh"
    echo "runner_as_user = zfstest (passwordless sudo — upstream pattern)"
    echo "no_patches     = true"
    echo ""
    echo "[results]"
    echo "date_end       = $(date -Iseconds)"
    echo "date_end_ns    = $(date +%s%N)"
    echo "elapsed_sec    = $((elapsed / 1000))"
    echo "total_pass     = ${_total_pass}"
    echo "total_fail     = ${_total_fail}"
    echo "total_skip     = ${_total_skip}"
    echo "total_tests    = $((_total_pass + _total_fail + _total_skip))"
    echo "overall_status = $([[ "$_total_fail" -eq 0 && "$_total_pass" -gt 0 ]] && echo PASS || ([[ "$_total_fail" -gt 0 ]] && echo FAIL || echo EMPTY))"
    echo ""
    echo "[per_distro]"
    for _l in "${_distro_lines[@]}"; do echo "$_l"; done
    echo ""
    echo "[artifacts]"
    echo "# SHA-256 of every file in this run directory — sign with GPG"
    echo "# or verify against an out-of-band copy to detect tampering."
  } >> "${run_dir}/manifest.txt"

  # Write SHA-256 sums of all artifacts (except the manifest itself
  # and the sums file) so post-hoc tampering is detectable.
  ( cd "${run_dir}" && find . -type f ! -name manifest.txt ! -name sha256sums.txt -print0 \
    | sort -z \
    | xargs -0 sha256sum 2>/dev/null > sha256sums.txt ) || true
  # Include the sums in the manifest for single-file attestation.
  cat "${run_dir}/sha256sums.txt" >> "${run_dir}/manifest.txt"

  # JUnit XML for CI pipeline attachment. Parses the checklist lines
  # from each per-distro log and emits the canonical JUnit format so
  # GitHub Actions / GitLab / Jenkins can display the matrix natively.
  {
    echo '<?xml version="1.0" encoding="UTF-8"?>'
    echo "<testsuites name=\"kldload-klab\" tests=\"$((_total_pass+_total_fail+_total_skip))\" failures=\"${_total_fail}\" skipped=\"${_total_skip}\" time=\"$((elapsed / 1000))\">"
    for _d in "${selected_distros[@]}"; do
      [[ -f "${run_dir}/${_d}.log" ]] || continue
      local _dp _df _ds
      _dp="$(grep -c '\[PASS\]' "${run_dir}/${_d}.log" 2>/dev/null || echo 0)"
      _df="$(grep -c '\[FAIL\]' "${run_dir}/${_d}.log" 2>/dev/null || echo 0)"
      _ds="$(grep -c '\[SKIP\]' "${run_dir}/${_d}.log" 2>/dev/null || echo 0)"
      echo "  <testsuite name=\"${_d}\" tests=\"$((_dp+_df+_ds))\" failures=\"${_df}\" skipped=\"${_ds}\">"
      grep -aE 'Test(\(Linux\))?: .+\[(PASS|FAIL|SKIP|KILLED)\]' "${run_dir}/${_d}.log" 2>/dev/null | while IFS= read -r line; do
        local _tname _tstatus
        _tname="$(echo "$line" | sed -n 's|.*Test[^:]*: \([^ ]*\) .*|\1|p' | sed 's|/usr/share/zfs/zfs-tests/tests/functional/||')"
        _tstatus="$(echo "$line" | sed -n 's|.*\[\(PASS\|FAIL\|SKIP\|KILLED\)\].*|\1|p')"
        [[ -z "$_tname" || -z "$_tstatus" ]] && continue
        # XML-escape the name minimally
        _tname="${_tname//&/&amp;}"; _tname="${_tname//</&lt;}"; _tname="${_tname//>/&gt;}"
        case "$_tstatus" in
          PASS)        echo "    <testcase name=\"${_tname}\"/>" ;;
          FAIL|KILLED) echo "    <testcase name=\"${_tname}\"><failure type=\"${_tstatus}\"/></testcase>" ;;
          SKIP)        echo "    <testcase name=\"${_tname}\"><skipped/></testcase>" ;;
        esac
      done
      echo "  </testsuite>"
    done
    echo "</testsuites>"
  } > "${run_dir}/results.junit.xml" 2>/dev/null || true

  log "Run complete: ${_total_pass} pass · ${_total_fail} fail · ${_total_skip} skip"
  log "Audit bundle: ${run_dir}/"
  log "  manifest.txt      — full provenance (kldload + host + goldens + results + sums)"
  log "  full.log          — every line streamed during the run"
  log "  <distro>.log      — per-distro test output"
  log "  <distro>.env      — kernel + zfs versions + tool checksums"
  log "  <distro>.packages — full rpm/dpkg package list"
  log "  <distro>.zpool    — zpool status + zfs list at test time"
  log "  results.junit.xml — CI-importable result matrix"
  log "  sha256sums.txt    — integrity hashes"

  log "Cleaning up test VMs..."
  for distro in "${selected_distros[@]}"; do
    local name; name="$(test_vm_name "$distro")"
    virsh destroy "$name" 2>/dev/null || true; virsh undefine "$name" 2>/dev/null || true
    zfs destroy -Rf "$(zvol_path "$name")" 2>/dev/null || true
    rm -f "${ISO_DIR}/${name}-cloud-init.iso" 2>/dev/null || true
  done
}

# Payload: Custom Playbook
cmd_run_playbook() {
  local playbook="$1" site="${2:-blue}"
  [[ -f "$playbook" ]] || die "Playbook not found: ${playbook}"

  log "Running playbook ${playbook} on ${site} site..."
  local results_dir="${RESULTS_DIR}/playbook-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$results_dir"
  local pass=0 fail=0

  for distro in "${DISTROS[@]}"; do
    local sname; sname="$(site_name "$site" "$distro")"
    virsh domstate "$sname" 2>/dev/null | grep -q running || continue
    local ip; ip="$(get_vm_ip "$sname" 2>/dev/null)"
    [[ -n "$ip" ]] || continue

    log "  [${distro}] Running on ${ip}..."
    scp -o StrictHostKeyChecking=no -i "$SSH_KEY" "$playbook" "root@${ip}:/tmp/klab-playbook" 2>/dev/null || \
      sshpass -p kldload scp -o StrictHostKeyChecking=no "$playbook" "root@${ip}:/tmp/klab-playbook" 2>/dev/null
    _ssh_cmd "$ip" "chmod +x /tmp/klab-playbook && /tmp/klab-playbook" > "${results_dir}/${distro}.log" 2>&1
    local rc=$?
    if [[ $rc -eq 0 ]]; then
      echo -e "  ${G}${distro}${N}: PASS"
      ((pass++))
    else
      echo -e "  ${R}${distro}${N}: FAIL (exit ${rc})"
      ((fail++))
    fi
  done

  echo ""
  log "Playbook results: ${G}${pass} passed${N}, ${R}${fail} failed${N}"
  log "Logs: ${results_dir}/"
}

# Payload: Kubernetes (calls existing kube-cluster tools)
cmd_kubernetes() {
  local workers="${1:-3}" distro="${2:-centos}"
  log "Deploying K8s cluster from ${distro} golden (1 CP + ${workers} workers)..."
  if command -v kube-cluster >/dev/null 2>&1; then
    kube-cluster bootstrap --workers "$workers" "$@"
  else
    die "kube-cluster not found — K8s payload requires KVM profile install"
  fi
}

# ── Section 9: Results Display ───────────────────────────────────────────

cmd_results() {
  local run_id="${1:-}"
  local run_dir
  if [[ -n "$run_id" ]]; then
    run_dir="${RESULTS_DIR}/${run_id}"
  elif [[ -L "${RESULTS_DIR}/latest" ]]; then
    run_dir="$(readlink -f "${RESULTS_DIR}/latest")"
    run_id="$(basename "$run_dir")"
  else
    die "No results found. Run: klab test"
  fi
  [[ -d "$run_dir" ]] || die "Results not found: ${run_dir}"

  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  klab — Test Run ${run_id}${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""
  printf "  ${W}%-12s %8s %8s %8s %8s %8s${N}\n" "DISTRO" "PASS" "FAIL" "SKIP" "TOTAL" "STATUS"
  echo "  ─────────── ──────── ──────── ──────── ──────── ────────"

  local grand_pass=0 grand_fail=0 grand_skip=0
  for summary in "${run_dir}"/*.summary; do
    [[ -f "$summary" ]] || continue
    local distro pass fail skip total
    source "$summary"
    local status_color="$G" status_text="PASS"
    [[ "$fail" -gt 0 ]] && { status_color="$R"; status_text="FAIL"; }
    printf "  %-12s ${G}%8s${N} ${R}%8s${N} ${Y}%8s${N} %8s ${status_color}%8s${N}\n" "$distro" "$pass" "$fail" "$skip" "$total" "$status_text"
    grand_pass=$((grand_pass + pass)); grand_fail=$((grand_fail + fail)); grand_skip=$((grand_skip + skip))
  done

  echo "  ─────────── ──────── ──────── ──────── ──────── ────────"
  printf "  ${W}%-12s %8s %8s %8s %8s${N}\n" "TOTAL" "$grand_pass" "$grand_fail" "$grand_skip" "$((grand_pass + grand_fail + grand_skip))"
  echo ""
  if [[ $grand_fail -eq 0 && $((grand_pass + grand_fail + grand_skip)) -gt 0 ]]; then
    echo -e "  ${G}ALL TESTS PASSED${N}"
  elif [[ $((grand_pass + grand_fail + grand_skip)) -eq 0 ]]; then
    echo -e "  ${Y}No results yet${N}"
  else
    echo -e "  ${R}${grand_fail} FAILURES${N} — logs: ${run_dir}/"
  fi
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
}

# ── Section 10: Status / Verify / Destroy ────────────────────────────────

cmd_status() {
  echo -e "${C}══════════════════════════════════════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  klab — Multi-Distro Test Platform${N}"
  echo -e "${D}  Host: $(uname -n) • $(nproc) cores • $(awk '/MemTotal/ {printf "%.0fGB", $2/1048576}' /proc/meminfo) RAM • NVIDIA: $([[ $NVIDIA_DETECTED -eq 1 ]] && echo "YES" || echo "no") • ZFS: ${ZFS_SOURCE}${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════════════════════════════════════${N}"
  echo ""

  echo -e "  ${W}Golden Images:${N}"
  echo ""
  printf "  ${W}%-10s %-8s %-10s %-28s %-16s %-8s %-6s %-6s${N}\n" "DISTRO" "STATUS" "SIZE" "KERNEL" "ZFS" "DKMS" "TESTS" "KSH"
  echo "  ────────── ──────── ────────── ──────────────────────────── ──────────────── ──────── ────── ──────"

  local total_ready=0 total_fail=0 total_skip=0
  for distro in "${DISTROS[@]}"; do
    local name zpath; name="$(golden_name "$distro")"; zpath="$(zvol_path "$name")"
    if zfs list "${zpath}@golden" >/dev/null 2>&1; then
      local used _kernel _zfs_ver _dkms _tests _ksh
      used="$(zfs get -Hp -o value used "$zpath" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo "?")"
      local _log="${RESULTS_DIR}/goldens/${distro}-latest.log"
      if [[ -f "$_log" ]]; then
        _kernel="$(grep '  Kernel:' "$_log" 2>/dev/null | tail -1 | sed 's/.*Kernel: *//' | head -c 28)"
        _zfs_ver="$(grep '  ZFS version:' "$_log" 2>/dev/null | tail -1 | sed 's/.*ZFS version: *//' | head -c 16)"
        _dkms="$(grep '  Result:' "$_log" 2>/dev/null | tail -1 | sed 's/.*Result: *//')"
        _tests="$(grep '  zfs-tests.sh:' "$_log" 2>/dev/null | tail -1 | sed 's/.*zfs-tests.sh: *//')"
        _ksh="$(grep '  ksh:' "$_log" 2>/dev/null | tail -1 | sed 's/.*ksh: *//')"
      else _kernel="-"; _zfs_ver="-"; _dkms="-"; _tests="-"; _ksh="-"; fi
      [[ -z "$_kernel" ]] && _kernel="-"; [[ -z "$_zfs_ver" ]] && _zfs_ver="-"
      [[ -z "$_tests" ]] && _tests="-"; [[ -z "$_ksh" ]] && _ksh="-"

      local _sc="$G" _st="READY"
      if [[ "$_dkms" == *"FAIL"* ]]; then _sc="$R"; _st="FAIL"; ((total_fail++))
      elif [[ "$_dkms" == *"PARTIAL"* ]]; then _sc="$Y"; _st="PARTIAL"; ((total_fail++))
      else ((total_ready++)); fi

      printf "  %-10s ${_sc}%-8s${N} %-10s %-28s %-16s ${G}%-8s${N} %-6s %-6s\n" \
        "$distro" "$_st" "$used" "$_kernel" "$_zfs_ver" "OK" "$_tests" "$_ksh"
    else
      printf "  %-10s ${D}%-8s${N}\n" "$distro" "—"
      ((total_skip++))
    fi
  done

  echo "  ────────── ──────── ────────── ──────────────────────────── ──────────────── ──────── ────── ──────"
  echo -e "  ${G}Ready: ${total_ready}${N}  ${R}Failed: ${total_fail}${N}  ${D}Not built: ${total_skip}${N}  Total: ${#DISTROS[@]}"

  local _used _avail
  _used="$(zfs get -Hp -o value used "${POOL}/vms" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo "?")"
  _avail="$(zfs get -Hp -o value available "${POOL}/vms" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo "?")"
  echo ""
  echo -e "  ${W}Storage:${N} ${_used} used / ${_avail} available on ${POOL}/vms"

  # Blue/green sites
  for site in blue green; do
    echo ""
    echo -e "  ${W}Site ${site}:${N}"
    local count=0
    for distro in "${DISTROS[@]}"; do
      local sname spath; sname="$(site_name "$site" "$distro")"; spath="$(zvol_path "$sname")"
      zfs list "$spath" >/dev/null 2>&1 || continue
      ((count++))
      local state; state="$(virsh domstate "$sname" 2>/dev/null | head -1)" || state="undefined"
      if [[ "$state" == "running" ]]; then
        local ip; ip="$(get_vm_ip "$sname" 2>/dev/null)" || ip=""
        printf "    ${G}%-25s${N} %-16s %s\n" "$sname" "${ip:-no IP}" "$state"
      else
        printf "    ${D}%-25s${N} %-16s %s\n" "$sname" "--" "$state"
      fi
    done
    [[ $count -eq 0 ]] && echo "    (not deployed)"
  done

  echo ""
  echo -e "  ${W}Results:${N}"
  if [[ -L "${RESULTS_DIR}/latest" ]]; then
    echo -e "    Latest: $(basename "$(readlink -f "${RESULTS_DIR}/latest")")"
  else
    echo -e "    ${D}No test runs yet${N}"
  fi

  echo ""
  echo -e "  ${W}Logs:${N} ${RESULTS_DIR}/"
  [[ -f "$MASTER_LOG" ]] && echo -e "    Master log: ${MASTER_LOG} ($(wc -l < "$MASTER_LOG" 2>/dev/null || echo 0) lines)"
  echo -e "${C}══════════════════════════════════════════════════════════════════════════════════════════════${N}"
}

cmd_verify() {
  local target="${1:-all}"
  local distros_to_check=()
  if [[ "$target" == "all" ]]; then distros_to_check=("${DISTROS[@]}")
  else validate_distro "$target"; distros_to_check=("$target"); fi

  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  klab verify — smoke test golden images${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo ""

  local pass=0 fail=0 skip=0
  printf "  ${W}%-12s %-10s %-10s %-12s %-10s${N}\n" "DISTRO" "GOLDEN" "BOOT" "ZFS" "TESTS"
  echo "  ─────────── ────────── ────────── ──────────── ──────────"

  for distro in "${distros_to_check[@]}"; do
    local name zpath; name="$(golden_name "$distro")"; zpath="$(zvol_path "$name")"
    if ! zfs list "${zpath}@golden" >/dev/null 2>&1; then
      printf "  %-12s ${Y}%-10s${N}\n" "$distro" "MISSING"
      ((skip++)); continue
    fi

    local vm_name vm_zpath vm_zdev
    vm_name="${PREFIX}-verify-${distro}"
    vm_zpath="$(zvol_path "$vm_name")"; vm_zdev="$(zvol_dev "$vm_name")"
    virsh destroy "$vm_name" 2>/dev/null || true; virsh undefine "$vm_name" 2>/dev/null || true
    zfs destroy -Rf "$vm_zpath" 2>/dev/null || true

    zfs clone "${zpath}@golden" "$vm_zpath" 2>/dev/null || { printf "  %-12s ${G}%-10s${N} ${R}%-10s${N}\n" "$distro" "OK" "CLONE FAIL"; ((fail++)); continue; }
    local ci_iso; ci_iso="$(make_cloud_init_iso "$vm_name" "$vm_name")"
    virt-install --name "$vm_name" --ram 2048 --vcpus 2 \
      --os-variant "${OS_VARIANTS[$distro]}" \
      --disk "path=${vm_zdev},bus=virtio" --disk "path=${ci_iso},device=cdrom" \
      --network bridge=virbr0,model=virtio --graphics none --noautoconsole --import \
      "${VIRT_BOOT_ARGS[@]}" "${VIRT_TPM_ARGS[@]}" \
      >/dev/null 2>&1

    local vm_ip; vm_ip="$(get_vm_ip "$vm_name")"
    if [[ -z "$vm_ip" ]] || ! wait_for_ssh "$vm_ip" 300; then
      printf "  %-12s ${G}%-10s${N} ${R}%-10s${N}\n" "$distro" "OK" "${vm_ip:-NO IP}"
      ((fail++))
      virsh destroy "$vm_name" 2>/dev/null || true; virsh undefine "$vm_name" 2>/dev/null || true
      zfs destroy -Rf "$vm_zpath" 2>/dev/null || true; rm -f "$ci_iso"; continue
    fi

    _ssh_cmd "$vm_ip" "modprobe zfs 2>/dev/null || true"
    local zfs_loaded; zfs_loaded="$(_ssh_cmd "$vm_ip" "lsmod | grep -q '^zfs ' && echo YES || echo NO")"
    local zfs_ver; zfs_ver="$(_ssh_cmd "$vm_ip" "zfs version 2>/dev/null | head -1 | awk '{print \$NF}'" || echo "?")"
    local tests_found; tests_found="$(_ssh_cmd "$vm_ip" "test -f /usr/share/zfs/zfs-tests.sh && echo YES || echo NO")"

    local zc="$G" tc="$G"
    [[ "$zfs_loaded" != "YES" ]] && zc="$R"
    [[ "$tests_found" != "YES" ]] && tc="$Y"
    printf "  %-12s ${G}%-10s${N} ${G}%-10s${N} ${zc}%-12s${N} ${tc}%-10s${N}\n" "$distro" "OK" "$vm_ip" "$zfs_loaded" "$tests_found"
    [[ "$zfs_loaded" == "YES" ]] && ((pass++)) || ((fail++))

    virsh destroy "$vm_name" 2>/dev/null || true; virsh undefine "$vm_name" 2>/dev/null || true
    zfs destroy -Rf "$vm_zpath" 2>/dev/null || true; rm -f "$ci_iso"
  done

  echo ""
  echo -e "  ${G}Pass: ${pass}${N}  ${R}Fail: ${fail}${N}  ${Y}Skip: ${skip}${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
}

cmd_destroy() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "Usage: klab destroy blue|green|all|goldens"
  case "$target" in
    blue|green)
      echo -e "${R}Destroying ${target} site${N}"
      read -r -p "  Type 'destroy' to confirm: " confirm
      [[ "$confirm" == "destroy" ]] || { echo "Aborted."; return 0; }
      destroy_site "$target"
      ;;
    all)
      echo -e "${R}Destroying ALL sites (goldens preserved)${N}"
      read -r -p "  Type 'destroy' to confirm: " confirm
      [[ "$confirm" == "destroy" ]] || { echo "Aborted."; return 0; }
      destroy_site "blue"; destroy_site "green"
      # Also clean test VMs
      for distro in "${DISTROS[@]}"; do
        local name; name="$(test_vm_name "$distro")"
        virsh destroy "$name" 2>/dev/null || true; virsh undefine "$name" 2>/dev/null || true
        zfs destroy -Rf "$(zvol_path "$name")" 2>/dev/null || true
      done
      log "All sites destroyed. Goldens preserved."
      ;;
    goldens)
      echo -e "${R}Destroying EVERYTHING (sites + goldens)${N}"
      read -r -p "  Type 'destroy' to confirm: " confirm
      [[ "$confirm" == "destroy" ]] || { echo "Aborted."; return 0; }
      destroy_site "blue"; destroy_site "green"
      for distro in "${DISTROS[@]}"; do
        local name; name="$(golden_name "$distro")"
        virsh destroy "$name" 2>/dev/null || true
        virsh undefine "$name" --nvram 2>/dev/null || virsh undefine "$name" 2>/dev/null || true
        zfs destroy -Rf "$(zvol_path "$name")" 2>/dev/null || true
        rm -f "${ISO_DIR}/${name}-cloud-init.iso" 2>/dev/null
        local tname; tname="$(test_vm_name "$distro")"
        virsh destroy "$tname" 2>/dev/null || true; virsh undefine "$tname" 2>/dev/null || true
        zfs destroy -Rf "$(zvol_path "$tname")" 2>/dev/null || true
      done
      [[ -f "$RHEL_CREDS_FILE" ]] && rm -f "$RHEL_CREDS_FILE"
      log "Everything destroyed."
      ;;
    *) die "Unknown target: ${target}" ;;
  esac
}

# ── Section 11: Interactive Menu ─────────────────────────────────────────

menu_header() {
  clear 2>/dev/null || true
  local gc=0 bc=0 gc2=0
  for d in "${DISTROS[@]}"; do
    golden_exists "$d" && ((gc++))
    virsh domstate "$(site_name blue "$d")" 2>/dev/null | grep -q running && ((bc++))
    virsh domstate "$(site_name green "$d")" 2>/dev/null | grep -q running && ((gc2++))
  done
  echo ""
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "${W}  klab — Multi-Distro Test Platform${N}"
  echo -e "${D}  ${#DISTROS[@]} distros • ZFS clones • blue-green • eBPF • payloads${N}"
  echo -e "${C}══════════════════════════════════════════════════════════════${N}"
  echo -e "  Goldens: ${G}${gc}/${#DISTROS[@]}${N}  Blue: ${G}${bc}${N}  Green: ${G}${gc2}${N}  GPU: $([[ $NVIDIA_DETECTED -eq 1 ]] && echo "${G}YES${N}" || echo "${D}no${N}")"
  echo ""
}

menu_pick_distro() {
  echo -e "  ${C}── Pick a distro ──${N}"
  local i=1
  for d in "${DISTROS[@]}"; do
    local status=""
    golden_exists "$d" && status="${G}[golden]${N}"
    printf "  ${G}%d${N}  %-12s %b\n" "$i" "$d" "$status"
    ((i++))
  done
  echo -ne "${W}  Select (1-${#DISTROS[@]}): ${N}"
  local choice; read -r choice
  if [[ "$choice" =~ ^[0-9]+$ ]] && [[ "$choice" -ge 1 ]] && [[ "$choice" -le ${#DISTROS[@]} ]]; then
    PICKED_DISTRO="${DISTROS[$((choice-1))]}"
    return 0
  fi
  echo -e "${R}  Invalid${N}"; return 1
}

interactive_menu() {
  local PICKED_DISTRO=""
  while true; do
    menu_header
    echo -e "  ${Y}── Build ──────────────────────────────────────────────────${N}"
    echo -e "  ${G} 1${N}  Build golden — single distro"
    echo -e "  ${G} 2${N}  Build golden — ALL distros"
    echo -e "  ${G} 3${N}  Status"
    echo ""
    echo -e "  ${Y}── Deploy ─────────────────────────────────────────────────${N}"
    echo -e "  ${G} 4${N}  Deploy blue site"
    echo -e "  ${G} 5${N}  Deploy green site"
    echo -e "  ${G} 6${N}  Promote green -> blue"
    echo -e "  ${G} 7${N}  Rollback blue"
    echo ""
    echo -e "  ${Y}── Payloads ───────────────────────────────────────────────${N}"
    echo -e "  ${G} 8${N}  OpenZFS test suite (quick)"
    echo -e "  ${G} 9${N}  OpenZFS test suite (full)"
    echo -e "  ${G}10${N}  Kubernetes cluster"
    echo -e "  ${G}11${N}  Custom playbook"
    echo -e "  ${G}12${N}  Results matrix"
    echo ""
    echo -e "  ${Y}── Observe ────────────────────────────────────────────────${N}"
    echo -e "  ${G}13${N}  Verify goldens (smoke test)"
    echo -e "  ${G}14${N}  View golden build log"
    echo -e "  ${G}15${N}  View master log"
    echo ""
    echo -e "  ${Y}── Cleanup ────────────────────────────────────────────────${N}"
    echo -e "  ${R} 0${N}  Destroy sites (keep goldens)"
    echo -e "  ${R}00${N}  Destroy EVERYTHING"
    echo -e "  ${R} q${N}  Quit"
    echo ""
    echo -ne "${W}  Select: ${N}"

    local choice; read -r choice
    case "$choice" in
      1)  menu_header; menu_pick_distro && { cmd_golden "$PICKED_DISTRO"; pause; } ;;
      2)  menu_header; cmd_golden all; pause ;;
      3)  menu_header; cmd_status; pause ;;
      4)  menu_header; deploy_site blue; pause ;;
      5)  menu_header; deploy_site green; pause ;;
      6)  menu_header; cmd_promote green; pause ;;
      7)  menu_header; cmd_rollback; pause ;;
      8)  menu_header; cmd_test --quick; pause ;;
      9)  menu_header; cmd_test --full; pause ;;
      10) menu_header; cmd_kubernetes; pause ;;
      11) menu_header
          echo -ne "  ${W}Path to playbook: ${N}"; local pb; read -r pb
          [[ -n "$pb" ]] && cmd_run_playbook "$pb"
          pause ;;
      12) menu_header; cmd_results ""; pause ;;
      13) menu_header; cmd_verify all; pause ;;
      14) menu_header
          menu_pick_distro && {
            local _glog="${RESULTS_DIR}/goldens/${PICKED_DISTRO}-latest.log"
            [[ -f "$_glog" ]] && cat "$_glog" || echo -e "  ${Y}No log for ${PICKED_DISTRO}${N}"
            pause
          } ;;
      15) menu_header; tail -50 "$MASTER_LOG" 2>/dev/null || echo "  No log yet"; pause ;;
      0)  menu_header; cmd_destroy all; pause ;;
      00) menu_header; cmd_destroy goldens; pause ;;
      q|Q) exit 0 ;;
      *)  echo -e "${R}  Invalid${N}"; sleep 1 ;;
    esac
  done
}

# ── Section 12: CLI Dispatch ─────────────────────────────────────────────

usage() {
  cat <<'USAGE'
klab — Multi-Distro Test Platform

Usage:
  klab                                    Interactive menu
  klab golden [distro|all]                Build golden images
  klab deploy blue|green                  Deploy site from goldens
  klab promote green                      Promote green to blue
  klab rollback                           Revert blue to previous snapshot
  klab test [--quick|--full] [--distro d] Run OpenZFS test suite
  klab kubernetes [--workers N]           Deploy K8s cluster
  klab run-playbook /path/to/script.sh    Run custom payload on site VMs
  klab verify [distro|all]                Smoke test goldens
  klab status                             Show everything
  klab results [run-id]                   Display test matrix
  klab destroy blue|green|all|goldens     Tear down

Distros: centos rocky fedora debian ubuntu arch rhel

ZFS Version Flags:
  --zfs-version 2.3.0               Build from release tarball
  --zfs-git openzfs/zfs@master       Build from git branch
  --zfs-tarball /path/to/zfs.tar.gz  Build from local tarball

Examples:
  klab golden all                         Build all golden images
  klab deploy blue                        Clone goldens to blue site
  klab test --quick --distro centos,debian Quick ZFS tests on 2 distros
  klab run-playbook ./my-test.sh          Run custom script on all blue VMs
  klab promote green                      Swap green to blue
  klab destroy all                        Tear down sites, keep goldens
USAGE
  exit 0
}

CMD="${1:-}"
[[ -z "$CMD" ]] && { interactive_menu; exit 0; }
shift

# Parse global flags
_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --zfs-version) ZFS_SOURCE="version:$2"; shift 2 ;;
    --zfs-git)     ZFS_SOURCE="git:$2"; shift 2 ;;
    --zfs-tarball) ZFS_SOURCE="tarball:$2"; shift 2 ;;
    *)             _args+=("$1"); shift ;;
  esac
done
set -- "${_args[@]+"${_args[@]}"}"

case "$CMD" in
  golden)       cmd_golden "${1:-all}" ;;
  golden-ztest) cmd_golden_ztest "${1:-all}" ;;
  deploy)       deploy_site "${1:-blue}" ;;
  promote)      cmd_promote "${1:-green}" ;;
  rollback)     cmd_rollback ;;
  test)         cmd_test "$@" ;;
  kubernetes)   cmd_kubernetes "$@" ;;
  run-playbook) cmd_run_playbook "${1:?Usage: klab run-playbook /path/to/script.sh}" "${2:-blue}" ;;
  verify)       cmd_verify "${1:-all}" ;;
  status)       cmd_status ;;
  results)      cmd_results "${1:-}" ;;
  destroy)      cmd_destroy "${1:-}" ;;
  menu)         interactive_menu ;;
  help|-h|--help) usage ;;
  *)            usage ;;
esac
