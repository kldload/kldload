APTSETUP
        ;;
    pacman)
        _ssh_cmd "$ip" bash -s -- "$dev_tools" "$want_zfs" <<'PACSETUP'
set -e
KLAB_ZFS_DEV="${1:-1}"
# 0 = build this golden WITHOUT ZFS (the desktop lineage).
WANT_ZFS="${2:-1}"
pacman -Syu --noconfirm 2>/dev/null || true

# Always: headers, dkms, eBPF, essentials
pacman -S --noconfirm linux-headers dkms bpftrace bcc-tools wireguard-tools curl jq 2>/dev/null || true

# Dev tools (only when KLAB_ZFS_DEV=1)
if [ "$KLAB_ZFS_DEV" = "1" ]; then
  pacman -S --noconfirm gcc make git fio parted attr bc acl sysstat 2>/dev/null || true
fi

# WANT_ZFS=0 skips ZFS entirely. The desktop lineage sets it: those guests
# boot ext4/xfs on a zvol and never mount a ZFS filesystem, so zfs-dkms
# there is a kernel module compiled on every kernel update, for nothing —
# and DKMS is the largest single failure surface in a golden build.
if [ "$WANT_ZFS" = "1" ] && ! command -v zfs >/dev/null 2>&1; then
  curl -fsSL https://archzfs.com/archzfs.gpg | pacman-key -a - 2>/dev/null || true
  pacman-key --lsign-key DDF7DB817396A49B2A2723F7403BD972F75D9D76 2>/dev/null || true
  echo -e '\n[archzfs]\nServer = https://archzfs.com/$repo/$arch' >> /etc/pacman.conf
  pacman -Sy --noconfirm zfs-dkms zfs-utils 2>/dev/null || true
