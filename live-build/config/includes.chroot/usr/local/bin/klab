# Pre-built bpftrace scripts for ZFS debugging
mkdir -p /usr/local/share/bpftrace
cat > /usr/local/share/bpftrace/zfs-latency.bt <<'BT'
tracepoint:zfs:zfs_read_done,tracepoint:zfs:zfs_write_done { @us = hist((nsecs - args->start) / 1000); }
BT
cat > /usr/local/share/bpftrace/zfs-arc.bt <<'BT'
kprobe:arc_read { @hits = count(); }
kprobe:arc_read_done { @misses = count(); }
interval:s:5 { print(@); clear(@); }
BT

# node_exporter systemd unit
if command -v node_exporter >/dev/null 2>&1 && ! systemctl is-active node_exporter >/dev/null 2>&1; then
  cat > /etc/systemd/system/node_exporter.service <<'SVC'
[Unit]
Description=Node Exporter
After=network-online.target
[Service]
Type=simple
ExecStart=/usr/local/bin/node_exporter
Restart=always
[Install]
WantedBy=multi-user.target
SVC
  systemctl daemon-reload
  systemctl enable --now node_exporter 2>/dev/null || true
fi

cat > /etc/motd <<'MOTD'

  klab — Multi-Distro Test Platform
  ZFS + eBPF + dev tools | blue-green deploy | instant clones

  ZFS source: /usr/src/zfs
  Traces:     /usr/local/share/bpftrace/*.bt
  Password:   kldload

MOTD
echo "Common setup complete"
COMMON

    # NVIDIA driver install if GPU detected on host
    if [[ "$NVIDIA_DETECTED" -eq 1 ]]; then
        log "  Installing NVIDIA drivers (GPU detected on host)..."
        case "$family" in
        dnf)
            _ssh_cmd "$ip" bash -c 'dnf install -y nvidia-driver nvidia-driver-cuda-libs 2>/dev/null || \
          dnf install -y kmod-nvidia-open-dkms 2>/dev/null || true' 2>/dev/null
            ;;
        apt)
            _ssh_cmd "$ip" bash -c 'DEBIAN_FRONTEND=noninteractive apt-get install -y nvidia-driver-535 2>/dev/null || true' 2>/dev/null
            ;;
        pacman)
            _ssh_cmd "$ip" bash -c 'pacman -S --noconfirm nvidia-dkms 2>/dev/null || true' 2>/dev/null
            ;;
        esac
    fi

    # ── DKMS signing (optional — only if UEFI golden images are used in future) ─
    # Cloud images are BIOS/MBR — no Secure Boot needed. Skip MOK setup entirely.
    # When klab switches to installer-based UEFI goldens, re-enable this block.
    if false; then
        log "  Configuring Secure Boot MOK signing on ${distro}..."
        _ssh_cmd "$ip" bash -s <<'MOKSETUP'
set -e

# Generate MOK keypair (2048-bit RSA, 10-year, no passphrase)
mkdir -p /var/lib/dkms
if [ ! -f /var/lib/dkms/mok.key ]; then
  openssl req -new -x509 -newkey rsa:2048 \
    -keyout /var/lib/dkms/mok.key \
    -out    /var/lib/dkms/mok.pub \
    -days 3650 -nodes \
    -subj "/CN=klab Secure Boot MOK/" 2>/dev/null
  openssl x509 -in /var/lib/dkms/mok.pub -out /var/lib/dkms/mok.der -outform DER 2>/dev/null
  chmod 0600 /var/lib/dkms/mok.key
  chmod 0644 /var/lib/dkms/mok.pub /var/lib/dkms/mok.der
  echo "MOK keypair generated"
else
  echo "MOK keypair already exists"
fi

# Create DKMS sign helper script
mkdir -p /etc/dkms
cat > /etc/dkms/sign_helper.sh <<'SIGNEOF'
#!/bin/bash
set -euo pipefail
KVER="${1:?}" MOD="${2:?}"
KEY=/var/lib/dkms/mok.key
CERT=/var/lib/dkms/mok.pub
SIGN_FILE=$(find /usr/src/kernels/"${KVER}" \
                 /usr/src/linux-headers-"${KVER}" \
                 /usr/lib/linux-kbuild-"${KVER%%.*}"* \
                 -name sign-file -type f 2>/dev/null | head -1 || true)
[[ -x "${SIGN_FILE}" ]] || { echo "sign-file not found for ${KVER}" >&2; exit 0; }
exec "${SIGN_FILE}" sha256 "${KEY}" "${CERT}" "${MOD}"
SIGNEOF
chmod 0755 /etc/dkms/sign_helper.sh

# Configure DKMS to use MOK keys
mkdir -p /etc/dkms/framework.conf.d
cat > /etc/dkms/framework.conf.d/klab-mok.conf <<MOKCONF
mok_signing_key=/var/lib/dkms/mok.key
mok_certificate=/var/lib/dkms/mok.pub
sign_tool=/etc/dkms/sign_helper.sh
try_sign_modules=true
MOKCONF

# Re-sign existing ZFS modules with MOK key
KVER=$(uname -r)
SIGN_FILE=$(find /usr/src/kernels/"${KVER}" \
                 /usr/src/linux-headers-"${KVER}" \
                 /usr/lib/linux-kbuild-"${KVER%%.*}"* \
                 -name sign-file -type f 2>/dev/null | head -1 || true)
if [ -x "${SIGN_FILE}" ] && [ -f /var/lib/dkms/mok.key ]; then
  SIGNED=0
  for mod in $(find /lib/modules/"${KVER}" -name '*.ko' -o -name '*.ko.xz' -o -name '*.ko.zst' 2>/dev/null | grep -i zfs); do
    case "$mod" in
      *.ko.xz) xz -d "$mod" 2>/dev/null; mod="${mod%.xz}" ;;
      *.ko.zst) zstd -d "$mod" 2>/dev/null; mod="${mod%.zst}" ;;
    esac
    "${SIGN_FILE}" sha256 /var/lib/dkms/mok.key /var/lib/dkms/mok.pub "$mod" 2>/dev/null || true
    case "$mod" in
      *.ko) # Re-compress if original was compressed
        [ -f "${mod}.xz.bak" ] && xz --check=crc32 "$mod" 2>/dev/null
        [ -f "${mod}.zst.bak" ] && zstd -q "$mod" 2>/dev/null
        ;;
    esac
    SIGNED=$((SIGNED + 1))
  done
  echo "Signed ${SIGNED} ZFS module(s) with MOK key"
  depmod -a "${KVER}" 2>/dev/null || true
else
  echo "WARN: sign-file not found — modules unsigned (Secure Boot will reject them)"
fi

# Queue MOK enrollment (password: kldload)
# This queues the enrollment; on next boot with Secure Boot, MokManager prompts
if command -v mokutil >/dev/null 2>&1; then
  echo -e "kldload\nkldload" | mokutil --import /var/lib/dkms/mok.der 2>/dev/null && \
    echo "MOK enrollment queued (password: kldload)" || \
    echo "MOK enrollment skipped (may already be enrolled or mokutil unavailable)"
else
  echo "mokutil not installed — installing..."
  dnf install -y mokutil 2>/dev/null || \
    apt-get install -y mokutil 2>/dev/null || \
    pacman -S --noconfirm mokutil 2>/dev/null || true
  if command -v mokutil >/dev/null 2>&1; then
    echo -e "kldload\nkldload" | mokutil --import /var/lib/dkms/mok.der 2>/dev/null && \
      echo "MOK enrollment queued (password: kldload)" || true
  fi
fi

echo "Secure Boot MOK setup complete"
MOKSETUP
    fi # end disabled MOK block

    log "  Test environment ready on ${distro}"

    # Cap the guest ARC — only where ZFS actually got installed, and EXCEPT on
    # the ztest lineage, whose whole job is exercising ZFS. Those images want a
    # realistic cache; shrinking it would change the behaviour the suite exists
    # to measure. Every other lineage is a workload VM whose blocks the host is
    # already caching.
    if [[ "$want_zfs" == "1" && "${KLAB_GOLDEN_KIND:-regular}" != "ztest" ]]; then
        set_guest_arc_cap "$ip" "$distro"
    fi

    # Desktop last, and only for the desktop lineage. It runs here rather than
    # in its own pass so it inherits build_golden_single's heartbeat and
    # watchdog — a five-minute silent package install is exactly what that
    # machinery exists for.
    if [[ "${KLAB_DESKTOP:-0}" == "1" ]]; then
        setup_vm_desktop "$ip" "$distro"
    fi
}

# ── ZFS Build-from-Source ─────────────────────────────────────────────────
_install_zfs_from_source() {
    local ip="$1" source="$2"
    local mode="${source%%:*}"
    local ref="${source#*:}"

    log "  Building ZFS from source (${source})..."

    _ssh_cmd "$ip" bash -s -- "$mode" "$ref" <<'BUILDZFS'
set -e
MODE="$1"; REF="$2"; NCPU=$(nproc)
BUILD_DIR="/tmp/zfs-build"; rm -rf "$BUILD_DIR"; mkdir -p "$BUILD_DIR"; cd "$BUILD_DIR"
case "$MODE" in
  version) curl -fSL -o "zfs-${REF}.tar.gz" "https://github.com/openzfs/zfs/releases/download/zfs-${REF}/zfs-${REF}.tar.gz"; tar xzf "zfs-${REF}.tar.gz"; cd "zfs-${REF}" ;;
  git) REPO="${REF%%@*}"; BRANCH="${REF#*@}"; [[ "$REPO" == "$BRANCH" ]] && BRANCH="master"; [[ "$REPO" == @* ]] && REPO="openzfs/zfs" && BRANCH="${REF#@}"; git clone --depth 1 --branch "$BRANCH" "https://github.com/${REPO}.git" zfs-src; cd zfs-src ;;
  tarball) tar xzf "$REF"; cd zfs-*/ 2>/dev/null || cd "$(basename "$REF" .tar.gz)" ;;
  *) echo "ERROR: Unknown mode: $MODE"; exit 1 ;;
esac
[ -f autogen.sh ] && sh autogen.sh
./configure --with-linux="$(ls -d /usr/src/kernels/$(uname -r) 2>/dev/null || ls -d /usr/lib/modules/$(uname -r)/build 2>/dev/null)" --enable-debug 2>&1 || ./configure --enable-debug 2>&1
make -j${NCPU} 2>&1; make install 2>&1
depmod -a 2>/dev/null || true; modprobe -r zfs 2>/dev/null || true; modprobe zfs 2>/dev/null || true
echo "ZFS from-source build complete: $(zfs version 2>/dev/null || echo unknown)"
BUILDZFS
}

# ── Section 5: Golden Image Build ────────────────────────────────────────

build_golden_single() {
    local distro="$1"
    validate_distro "$distro"

    local name zpath zdev
    name="$(golden_name "$distro")"
    zpath="$(zvol_path "$name")"
    zdev="$(zvol_dev "$name")"

    if zfs list "${zpath}@golden" >/dev/null 2>&1; then
        local _existing_log="${RESULTS_DIR}/goldens/${distro}-latest.log"
        local _existing_result=""
        [[ -f "$_existing_log" ]] && _existing_result="$(grep '  Result:' "$_existing_log" 2>/dev/null | tail -1 || echo "")"
        if [[ "$_existing_result" == *"FAIL"* || "$_existing_result" == *"PARTIAL"* ]]; then
            warn "Golden ${name} exists but validation was: ${_existing_result} — rebuilding"
        else
            log "Golden ${name} exists — skipping (destroy with: zfs destroy -Rf ${zpath})"
            return 0
        fi
    fi

    # Clean up everything
    log "  Cleaning up previous state..."
    virsh destroy "$name" 2>/dev/null || true
    virsh undefine "$name" --nvram 2>/dev/null || virsh undefine "$name" 2>/dev/null || true
    zfs destroy -Rf "$zpath" 2>/dev/null || true
    rm -f "${ISO_DIR}/${name}-cloud-init.iso" 2>/dev/null || true

    local t_start
    t_start="$(timer_start)"

    local golden_log_dir="${RESULTS_DIR}/goldens"
    mkdir -p "$golden_log_dir"
    local golden_log="${golden_log_dir}/${distro}-$(date +%Y%m%d-%H%M%S).log"
    log "Building golden: ${C}${name}${N}"
    log "  Log: ${golden_log}"

    {
        echo "═══════════════════════════════════════════════════════════"
        echo "  klab — Golden Build: ${distro}"
        echo "  Started: $(date)"
        echo "  Host: $(uname -n) ($(nproc) cores, $(awk '/MemTotal/ {printf "%.0fGB", $2/1048576}' /proc/meminfo) RAM)"
        echo "  ZFS Source: ${ZFS_SOURCE}"
        echo "  NVIDIA: $([[ $NVIDIA_DETECTED -eq 1 ]] && echo "detected" || echo "none")"
        echo "═══════════════════════════════════════════════════════════"
        echo ""
    } | tee "$golden_log"

    mkdir -p "$ISO_DIR"
    local url="${CLOUD_IMAGES[$distro]}"

    # Fedora cloud images bump their build number in the filename every
    # ~2-3 weeks (Fedora-Cloud-Base-Generic-44-1.6 → 1.7 → 1.8 …) and
    # there's no `.latest.` symlink on dl.fedoraproject.org. Hardcoding
    # one specific build number means every Fedora cloud bump silently
    # 404s the next golden build until someone notices and patches the
    # script. Resolve dynamically: parse the directory listing, take the
    # highest version-sorted filename. Falls back to the hardcoded URL
    # if the listing fetch fails (offline / DNS down). If the F44 dir
    # itself goes empty (e.g. mid-F45-transition), drops to F43.
    if [[ "$distro" == "fedora" ]] && command -v curl >/dev/null 2>&1; then
        local _ver _latest _base="https://download.fedoraproject.org/pub/fedora/linux/releases"
        for _ver in 44 43 42; do
            _latest=$(curl -sfL --max-time 10 "${_base}/${_ver}/Cloud/x86_64/images/" 2>/dev/null |
                grep -oE "Fedora-Cloud-Base-Generic-${_ver}-[0-9.]+\.x86_64\.qcow2" |
                sort -V -u | tail -1)
            if [[ -n "$_latest" ]]; then
                url="${_base}/${_ver}/Cloud/x86_64/images/${_latest}"
                log "  Resolved fedora cloud image: ${_latest}"
                break
            fi
        done
    fi

    local img_file="${ISO_DIR}/${distro}-cloud.qcow2"

    # RHEL 10: boot a user-provided RHEL 10 KVM Guest Image, then register
    # against the customer's subscription. We can't clone-from-CentOS like
    # the pre-1.2 path used to — RHEL is on 10 (kernel 6.12) while CentOS
    # Stream stays on 9, so the "clone + subscription-manager overlay"
    # trick now produces a semantically broken golden (registered as RHEL
    # but running EL9 binaries underneath).
    #
    # Red Hat doesn't publish an anonymous cloud-image URL. The user
    # supplies one of (in precedence order):
    #   1. KLAB_RHEL_IMAGE=/abs/path/to/your.qcow2  (local file)
    #   2. /var/lib/klab/images/rhel-10-cloud.qcow2  (canonical drop-in)
    #   3. KLAB_RHEL_IMAGE_URL=<one-shot Customer Portal URL>  (we curl it)
    # If none are present, we skip gracefully (rc=0) so `klab golden all`
    # still finishes the other distros — same contract as the missing-creds
    # case.
    if [[ "$distro" == "rhel" ]]; then
        _rhel_prompt_creds
        local _rc=$?
        if [[ $_rc -eq 2 ]]; then
            log "  Skipping RHEL — no credentials (set them in the web UI Dashboard)"
            return 0
        elif [[ $_rc -ne 0 ]]; then
            return 1
        fi

        local rhel_img=""
        mkdir -p /var/lib/klab/images
        if [[ -n "${KLAB_RHEL_IMAGE:-}" && -f "${KLAB_RHEL_IMAGE}" ]]; then
            rhel_img="${KLAB_RHEL_IMAGE}"
            log "  Using KLAB_RHEL_IMAGE: ${rhel_img}"
        elif [[ -f /var/lib/klab/images/rhel-10-cloud.qcow2 ]]; then
            rhel_img=/var/lib/klab/images/rhel-10-cloud.qcow2
            log "  Using cached: ${rhel_img}"
        elif [[ -n "${KLAB_RHEL_IMAGE_URL:-}" ]]; then
            log "  Downloading RHEL 10 cloud image from KLAB_RHEL_IMAGE_URL..."
            # URL may contain a one-shot auth token; do NOT log it.
            if curl -fSL --retry 5 --retry-delay 10 --retry-all-errors \
                -C - -o /var/lib/klab/images/rhel-10-cloud.qcow2.partial \
                "${KLAB_RHEL_IMAGE_URL}" >/dev/null 2>&1; then
                mv -f /var/lib/klab/images/rhel-10-cloud.qcow2.partial \
                    /var/lib/klab/images/rhel-10-cloud.qcow2
                rhel_img=/var/lib/klab/images/rhel-10-cloud.qcow2
            else
                rm -f /var/lib/klab/images/rhel-10-cloud.qcow2.partial
                warn "RHEL 10 image download failed (KLAB_RHEL_IMAGE_URL); skipping"
                return 0
            fi
        fi

        # ─── RH Customer Portal API fetch ───────────────────────────────
        # Final automatic path: use the saved RHEL_USERNAME/PASSWORD to
        # exchange for a short-lived bearer token via RH SSO, then call
        # api.access.redhat.com to download the latest RHEL 10 KVM Guest
        # Image qcow2. RH supports `grant_type=password` against the
        # `rhsm-api` client for exactly this use case -- no extra "offline
        # token" workflow required, the saved subscription-manager creds
        # double as the API creds. Bearer is ~15min, plenty for download.
        #
        # Falls through to skip if:
        #   - no username/password creds in scope (activation-key only --
        #     RH's API doesn't accept activation keys, those are for
        #     subscription-manager only; operator must use one of the
        #     manual paths above for activation-key-only environments)
        #   - SSO token exchange returns 401 (bad creds)
        #   - Image API returns no matching image or download fails
        if [[ -z "$rhel_img" && -n "$RHEL_USERNAME" && -n "$RHEL_PASSWORD" ]]; then
            log "  No pre-staged image — pulling from access.redhat.com via Customer Portal API..."
            if _fetch_rhel_cloud_image_via_api; then
                rhel_img=/var/lib/klab/images/rhel-10-cloud.qcow2
                log "  API-fetched image ready: ${rhel_img}"
            else
                warn "RH API fetch failed (see /var/log/klab/rhel-image-fetch.log)"
            fi
        fi

        if [[ -z "$rhel_img" ]]; then
            log "  Skipping RHEL — no image. Provide one of:"
            log "    1. Drop qcow2 at /var/lib/klab/images/rhel-10-cloud.qcow2"
            log "    2. Set KLAB_RHEL_IMAGE=/abs/path/to/your.qcow2"
            log "    3. Set KLAB_RHEL_IMAGE_URL=<one-shot Customer Portal URL>"
            log "    4. Set RH username + password creds (Dashboard → RHEL Subscription)"
            log "  Get the RHEL 10 KVM Guest Image from access.redhat.com"
            return 0
        fi

        log "  Creating zvol (${DISK}G, sparse, lz4)..."
        zfs create -V "${DISK}G" -s -o volblocksize=64k -o compression=lz4 "$zpath"
        for _ in $(seq 1 15); do
            [[ -b "$zdev" ]] && break
            sleep 1
        done
        [[ -b "$zdev" ]] || die "zvol device not found: ${zdev}"

        log "  Importing RHEL 10 image into zvol..."
        qemu-img convert -O raw "$rhel_img" "$zdev" || die "qemu-img convert failed"
        growpart "$zdev" 1 2>/dev/null || true

        local ci_iso
        ci_iso="$(make_cloud_init_iso "$name" "$name" "/var/lib/cloud/instance/klab-ready")"

        local _console_log="/var/log/klab/${name}-console.log"
        mkdir -p /var/log/klab
        : >"$_console_log"

        log "  Booting RHEL 10 golden VM (Secure Boot: OFF during build)..."
        log "  Console log: tail -f ${_console_log}"
        virt-install --name "$name" --ram "$RAM" --vcpus "$CPUS" \
            --os-variant "${OS_VARIANTS[$distro]}" \
            --disk "path=${zdev},bus=virtio" --disk "path=${ci_iso},device=cdrom" \
            --network bridge=virbr0,model=virtio --graphics vnc,listen=0.0.0.0 --video virtio --noautoconsole \
            --channel "unix,target.type=virtio,target.name=org.qemu.guest_agent.0" --import \
            --serial "pty,log.file=${_console_log},log.append=on" \
            "${VIRT_GOLDEN_BOOT_ARGS[@]}" \
            2>&1 || die "Failed to boot RHEL golden VM"

        local golden_ip
        log "  Waiting for IP..."
        golden_ip="$(get_vm_ip "$name")"
        [[ -n "$golden_ip" ]] || die "No IP for ${name}"
        log "  IP: ${golden_ip}"
        log "  Waiting for SSH..."
        wait_for_ssh "$golden_ip" 300 || die "SSH timeout on ${name}"

        log "  Registering RHEL 10 subscription (credentials redacted)..."
        # subscription-manager is part of the RHEL 10 KVM Guest Image base —
        # no need to install it like the old CentOS-clone path did.
        # `release --set=10` pins the content set so dnf only sees RHEL 10
        # repos (defensive against the guest auto-following a release move).
        _ssh_cmd "$golden_ip" bash -c "
      subscription-manager register --username='${RHEL_USERNAME}' --password='${RHEL_PASSWORD}' --auto-attach 2>&1 | sed 's/password=.*/password=REDACTED/g'
      subscription-manager release --set=10 2>/dev/null || true
      subscription-manager repos --enable codeready-builder-for-rhel-10-x86_64-rpms 2>/dev/null || true
      subscription-manager identity 2>/dev/null | head -3
      echo 'RHEL registration complete'
    " 2>&1 | sed "s/${RHEL_PASSWORD}/REDACTED/g" | tee -a "$golden_log"

        # Validate + seal + snapshot. Note: the RHEL 10 golden does NOT carry
        # ZFS (no anonymous OpenZFS-on-RHEL10 install path that doesn't go
        # through DKMS + matched kernel-devel). Users who want ZFS inside the
        # RHEL guest can layer it after the clone — for klab's primary
        # purpose (have a RHEL 10 env available), an unmodified RHEL guest
        # registered against the customer's subscription is what's expected.
        log "  Validating golden ${distro}..."
        local _v_kernel _v_redhat _v_rhel_id _v_dnf_repos
        _v_kernel="$(_ssh_cmd "$golden_ip" "uname -r" || echo "unknown")"
        _v_redhat="$(_ssh_cmd "$golden_ip" "cat /etc/redhat-release 2>/dev/null || echo unknown")"
        _v_rhel_id="$(_ssh_cmd "$golden_ip" "subscription-manager identity 2>/dev/null | head -1" || echo "not registered")"
        _v_dnf_repos="$(_ssh_cmd "$golden_ip" "dnf -q repolist 2>/dev/null | grep -c '^rhel-10-' || echo 0")"

        {
            echo ""
            echo "═══════════════════════════════════════════════════════════"
            echo "  Golden Validation Report: ${distro}"
            echo "═══════════════════════════════════════════════════════════"
            echo "  Kernel:         ${_v_kernel}"
            echo "  Release:        ${_v_redhat}"
            echo "  RHEL sub:       ${_v_rhel_id}"
            echo "  RHEL 10 repos:  ${_v_dnf_repos} enabled"
            echo "  ZFS:            not installed (RHEL 10 golden — bring-your-own DKMS)"
            local _result="PASS"
            [[ "${_v_redhat}" != *"Red Hat"* ]] && _result="FAIL (not RHEL?)"
            [[ "${_v_rhel_id}" == *"not registered"* ]] && _result="FAIL (no subscription)"
            echo "  Result:         ${_result}"
            echo "═══════════════════════════════════════════════════════════"
            echo ""
        } | tee -a "$golden_log"

        _ssh_cmd "$golden_ip" "cloud-init clean --logs 2>/dev/null || true; rm -f /etc/machine-id; touch /etc/machine-id; truncate -s 0 /etc/hostname"
        _ssh_cmd "$golden_ip" "systemctl enable cloud-init-local cloud-init cloud-config cloud-final 2>/dev/null || true"
        _ssh_cmd "$golden_ip" "shutdown -h now" || true

        for _ in $(seq 1 30); do
            virsh domstate "$name" 2>/dev/null | grep -q "shut off" && break
            sleep 2
        done
        virsh detach-disk "$name" "$ci_iso" --config 2>/dev/null || true
        rm -f "$ci_iso"
        zfs snapshot "${zpath}@golden"

        local elapsed
        elapsed="$(timer_elapsed_ms "$t_start")"
        {
            echo "Golden build complete: ${name}"
            echo "  Time: $((elapsed / 1000))s"
            echo "  Size: $(zfs get -Hp -o value used "$zpath" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo "?")"
            echo "  Method: RHEL 10 KVM Guest Image + subscription-manager"
        } | tee -a "$golden_log"
        ln -sfn "$golden_log" "${golden_log_dir}/${distro}-latest.log"
        log "Golden ready: ${C}${name}${N} ($((elapsed / 1000))s) — log: ${golden_log}"
        _register_golden "$name"
        return 0
    fi

    # Normal distros: download cloud image.
    # Atomic rename: curl writes to .partial and we mv on success. Without this,
    # a concurrent reader (e.g. kube-cluster picking up the first *-cloud.qcow2
    # it finds) sees the in-flight file and qemu-img fails with "Input/output
    # error" on sectors past the current download head.
    if [[ ! -f "$img_file" ]]; then
        log "  Downloading ${distro} cloud image..."
        # --retry + --retry-all-errors + -C - lets curl auto-resume from the
        # last byte it wrote whenever the connection drops mid-stream, which
        # was killing the whole blue-green phase on a single transient CDN
        # hiccup (e.g. Fedora mirror closes connection with 500MB remaining).
        curl -fSL --retry 5 --retry-delay 10 --retry-all-errors \
            -C - -o "${img_file}.partial" "$url" ||
            {
                rm -f "${img_file}.partial"
                die "Download failed for ${distro}"
            }
        mv -f "${img_file}.partial" "$img_file"
    else
        log "  Using cached: ${img_file}"
    fi

    log "  Creating zvol (${DISK}G, sparse, lz4)..."
    zfs create -V "${DISK}G" -s -o volblocksize=64k -o compression=lz4 "$zpath"
    for _ in $(seq 1 15); do
        [[ -b "$zdev" ]] && break
        sleep 1
    done
    [[ -b "$zdev" ]] || die "zvol device not found: ${zdev}"

    log "  Importing cloud image..."
    qemu-img convert -f qcow2 -O raw "$img_file" "$zdev"
    growpart "$zdev" 1 2>/dev/null || true

    local ci_iso
    ci_iso="$(make_cloud_init_iso "$name" "$name" "/var/lib/cloud/instance/klab-ready")"

    # Capture serial console to a file so the user (and the wait loops
    # below) can see exactly what the VM is doing — kernel boot messages,
    # cloud-init output, dnf transactions, the actual reason it's stuck.
    # Without this, klab just sees timeouts and prints `<no output yet>`
    # while the VM might be deep in a dnf retry loop or waiting on a 404.
    # User-side equivalent: `sudo virsh console ${name}` (Esc+] to detach).
    local _console_log="/var/log/klab/${name}-console.log"
    mkdir -p /var/log/klab
    : >"$_console_log"

    log "  Booting golden VM (Secure Boot: OFF during build, ON for clones)..."
    log "  Console log: tail -f ${_console_log}"
    virt-install --name "$name" --ram "$RAM" --vcpus "$CPUS" \
        --os-variant "${OS_VARIANTS[$distro]}" \
        --disk "path=${zdev},bus=virtio" --disk "path=${ci_iso},device=cdrom" \
        --network bridge=virbr0,model=virtio --graphics vnc,listen=0.0.0.0 --video virtio --noautoconsole \
        --channel "unix,target.type=virtio,target.name=org.qemu.guest_agent.0" --import \
        --serial "pty,log.file=${_console_log},log.append=on" \
        "${VIRT_GOLDEN_BOOT_ARGS[@]}" \
        2>&1 || die "Failed to boot golden VM for ${distro}"

    local golden_ip
    log "  Waiting for IP..."
    golden_ip="$(get_vm_ip "$name")"
    [[ -n "$golden_ip" ]] || die "No IP for ${name}"
    log "  IP: ${golden_ip}"
    log "  Waiting for SSH..."
    wait_for_ssh "$golden_ip" 300 || die "SSH timeout on ${name}"

    log "  Waiting for cloud-init..."
    local _ci_seen=0 _i
    for _i in $(seq 1 90); do
        _ssh_cmd "$golden_ip" "test -f /var/lib/cloud/instance/klab-ready" 2>/dev/null && break
        # every 30s (6 sleeps of 5s) show the new lines from the console log
        # so the operator sees what the VM is actually doing (dnf retries,
        # kernel oopses, etc.) instead of staring at silence.
        if ((_i % 6 == 0)) && [[ -r "$_console_log" ]]; then
            local _sz
            _sz=$(wc -l <"$_console_log" 2>/dev/null || echo 0)
            if ((_sz > _ci_seen)); then
                tail -n $((_sz - _ci_seen)) "$_console_log" 2>/dev/null |
                    tr -cd '[:print:]\n' | tail -4 |
                    while IFS= read -r _ln; do echo -e "  ${C}[console]${N}  ${_ln}" >&2; done
                _ci_seen=$_sz
            fi
        fi
        sleep 5
    done

    # Install test environment. setup_vm_golden can run 5-15 minutes silently
    # (package install + zfs-dkms compile). Run it in the background and
    # heartbeat the last log line every 15s so the user isn't staring at a
    # frozen terminal. Output still lands in $_setup_log verbatim — we just
    # surface it periodically rather than all-or-nothing at the end.
    # NOTE: piping kills the heredoc stdin inside setup_vm_golden, which is
    # why we redirect to a file instead of `| tee`.
    local _setup_log="/tmp/klab-setup-${distro}.log"
    : >"$_setup_log"
    setup_vm_golden "$golden_ip" "$distro" >"$_setup_log" 2>&1 &
    local _setup_pid=$!
    local _tick=0
    # Per-distro timeout. Normal golden builds finish in 3-8 min (package
    # install + DKMS compile). A broken cloud-init / DHCP / mirror can
    # block the VM forever; previously the parent would poll "no output
    # yet" indefinitely and one bad distro silently held up the whole
    # queue. 20 min is generous for slow mirrors; anything beyond that is
    # a real failure — kill the setup, log it, let the outer loop move on.
    # Override with KLAB_GOLDEN_MAX_SECS for CI / constrained boxes.
    local _max_ticks=$((${KLAB_GOLDEN_MAX_SECS:-1200} / 15))
    local _timed_out=0
    while kill -0 "$_setup_pid" 2>/dev/null; do
        sleep 15
        _tick=$((_tick + 1))
        local _last
        _last="$(tail -1 "$_setup_log" 2>/dev/null | tr -cd '[:print:]' | cut -c1-100)"
        log "  setup [${distro} t+$((_tick * 15))s] ${_last:-<no output yet>}"
        if [[ "$_tick" -ge "$_max_ticks" ]]; then
            warn "  setup [${distro}] TIMEOUT after $((_tick * 15))s — killing setup, marking distro failed"
            kill -TERM "$_setup_pid" 2>/dev/null || true
            sleep 3
            kill -KILL "$_setup_pid" 2>/dev/null || true
            # Also destroy the stuck VM so its zvol can be freed for the next
            # run. Without this, a subsequent golden attempt on the same
            # distro hits "zvol busy" errors.
            virsh destroy "$name" 2>/dev/null || true
            _timed_out=1
            break
        fi
    done
    wait "$_setup_pid" 2>/dev/null || true
    if [[ "$_timed_out" -eq 1 ]]; then
        warn "  ${distro}: golden build timed out — skipping. Fix cause, re-run \`klab golden-ztest ${distro}\`."
        # Leave the setup log in place for post-mortem; caller's
        # `build_golden_single "$d" || warn "Failed to build..."` pattern
        # treats the non-zero return as "skip, move on" — exactly what we
        # want. `continue` would error here because build_golden_single
        # is a function, not a loop body.
        mv "$_setup_log" "${_setup_log}.timeout" 2>/dev/null || true
        return 1
    fi
    if [[ -n "$RHEL_PASSWORD" ]]; then
        sed "s/${RHEL_PASSWORD}/REDACTED/g" "$_setup_log" >>"$golden_log"
    else
        cat "$_setup_log" >>"$golden_log"
    fi
    rm -f "$_setup_log"

    # Handle from-source builds
    if [[ "$ZFS_SOURCE" != "repo" ]]; then
        log "  Installing build dependencies for from-source ZFS..."
        case "${DISTRO_FAMILY[$distro]}" in
        dnf) _ssh_cmd "$ip" bash -c 'dnf install -y git libuuid-devel libblkid-devel openssl-devel libtirpc-devel python3-devel python3-cffi libaio-devel libattr-devel elfutils-libelf-devel zlib-devel 2>/dev/null || true' ;;
        apt) _ssh_cmd "$ip" bash -c 'DEBIAN_FRONTEND=noninteractive apt-get install -y git uuid-dev libblkid-dev libssl-dev libtirpc-dev python3-dev python3-cffi libaio-dev libattr1-dev libelf-dev zlib1g-dev 2>/dev/null || true' ;;
        esac
        _install_zfs_from_source "$golden_ip" "$ZFS_SOURCE"
    fi

    # Validate + seal in single SSH call
    log "  Validating golden ${distro}..."
    local _val_tmp="/tmp/klab-validate-${distro}.txt"
    _ssh_cmd "$golden_ip" bash -s <<'VALIDATE' >"$_val_tmp" 2>/dev/null || true
echo "V_KERNEL=$(uname -r 2>/dev/null || echo unknown)"
echo "V_ZFS=$(command -v zfs >/dev/null 2>&1 && echo OK || echo MISSING)"
echo "V_MOD=$(lsmod | grep -c '^zfs ' 2>/dev/null | tr -d '[:space:]' || echo 0)"
echo "V_VER=$(zfs version 2>/dev/null | head -1 || echo unknown)"
echo "V_DKMS=$(dkms status 2>/dev/null | head -1 || echo n/a)"
echo "V_TESTS=$(test -f /usr/share/zfs/zfs-tests.sh && echo OK || (command -v zfs-tests.sh >/dev/null 2>&1 && echo OK || echo MISSING))"
echo "V_VDEVS=$(ls /var/tmp/zfs-vdev*.img 2>/dev/null | wc -l)"
echo "V_KSH=$(command -v ksh >/dev/null 2>&1 && echo OK || echo MISSING)"
echo zfs > /etc/modules-load.d/zfs.conf 2>/dev/null || true
depmod -a 2>/dev/null || true
cloud-init clean --logs 2>/dev/null || true
rm -f /etc/machine-id; touch /etc/machine-id
truncate -s 0 /etc/hostname
rm -f /etc/netplan/*.yaml /etc/systemd/network/*.network 2>/dev/null || true
systemctl enable cloud-init-local cloud-init cloud-config cloud-final 2>/dev/null || true
mkdir -p /etc/systemd/network && cat > /etc/systemd/network/10-dhcp.network <<'NETD'
[Match]
Name=en* eth*

[Network]
DHCP=yes
NETD
echo "V_SEALED=OK"
shutdown -h now 2>/dev/null || true
VALIDATE

    local _v_kernel _v_zfs _v_mod _v_ver _v_dkms _v_tests _v_vdevs _v_ksh
    _v_kernel="$(grep '^V_KERNEL=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "unknown")"
    _v_zfs="$(grep '^V_ZFS=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "MISSING")"
    _v_mod="$(grep '^V_MOD=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "0")"
    _v_ver="$(grep '^V_VER=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "unknown")"
    _v_dkms="$(grep '^V_DKMS=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "n/a")"
    _v_tests="$(grep '^V_TESTS=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "MISSING")"
    _v_vdevs="$(grep '^V_VDEVS=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "0")"
    _v_ksh="$(grep '^V_KSH=' "$_val_tmp" 2>/dev/null | cut -d= -f2- || echo "MISSING")"
    rm -f "$_val_tmp"
    [[ -z "$_v_kernel" ]] && _v_kernel="unknown"
    [[ -z "$_v_mod" ]] && _v_mod="0"

    {
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        echo "  Golden Validation Report: ${distro}"
        echo "═══════════════════════════════════════════════════════════"
        echo "  Kernel:         ${_v_kernel}"
        echo "  ZFS binary:     ${_v_zfs}"
        echo "  ZFS module:     $([[ $_v_mod -ge 1 ]] && echo "LOADED" || echo "NOT LOADED")"
        echo "  ZFS version:    ${_v_ver}"
        echo "  DKMS status:    ${_v_dkms}"
        echo "  zfs-tests.sh:   ${_v_tests}"
        echo "  vdev images:    ${_v_vdevs}/4"
        echo "  ksh:            ${_v_ksh}"
        echo "  ZFS source:     ${ZFS_SOURCE}"
        echo "  NVIDIA:         $([[ $NVIDIA_DETECTED -eq 1 ]] && echo "installed" || echo "n/a")"
        local _result="PASS"
        [[ "$_v_zfs" != "OK" || "$_v_mod" -lt 1 ]] && _result="FAIL"
        [[ "$_v_tests" != "OK" ]] && _result="PARTIAL (no tests)"
        echo "  Result:         ${_result}"
        echo "═══════════════════════════════════════════════════════════"
        echo ""
    } | tee -a "$golden_log"

    log "    ZFS binary:     ${_v_zfs}"
    log "    ZFS module:     $([[ $_v_mod -ge 1 ]] && echo "loaded" || echo "NOT LOADED")"
    log "    ZFS version:    ${_v_ver}"
    log "    Kernel:         ${_v_kernel}"
    log "    DKMS:           ${_v_dkms}"
    log "    zfs-tests.sh:   ${_v_tests}"
    log "    vdev images:    ${_v_vdevs}/4"
    log "    ksh:            ${_v_ksh}"
    log "  Sealed + shutdown initiated in validation pass"

    for _ in $(seq 1 30); do
        virsh domstate "$name" 2>/dev/null | grep -q "shut off" && break
        sleep 2
    done
    virsh detach-disk "$name" "$ci_iso" --config 2>/dev/null || true
    rm -f "$ci_iso"
    zfs snapshot "${zpath}@golden"

    local elapsed
    elapsed="$(timer_elapsed_ms "$t_start")"
    {
        echo "Golden build complete: ${name}"
        echo "  Time: $((elapsed / 1000))s"
        echo "  Snapshot: ${zpath}@golden"
        echo "  Size: $(zfs get -Hp -o value used "$zpath" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo "?")"
        echo "  Finished: $(date)"
    } | tee -a "$golden_log"
    ln -sfn "$golden_log" "${golden_log_dir}/${distro}-latest.log"
    log "Golden ready: ${C}${name}${N} ($((elapsed / 1000))s) — log: ${golden_log}"
    _register_golden "$name"
}

cmd_golden() {
    # Accept multiple distros: `klab golden centos debian ubuntu` iterates
    # instead of silently dropping args. Single "all" expands to the full
    # DISTROS list. Mix is allowed.
    [[ $# -eq 0 ]] && set -- all
    local _distros=()
    for _arg in "$@"; do
        if [[ "$_arg" == "all" ]]; then
            _distros+=("${DISTROS[@]}")
        else
            _distros+=("$_arg")
        fi
    done
    # Subshell each call so a `die` inside build_golden_single (which is
    # `exit 1`, not `return 1`) doesn't kill the whole `golden all` run.
    # Before this change, a single failed distro #2 left distros 3..N
    # un-attempted because the script exited mid-loop — `|| warn` never
    # got the chance to neutralize it.
    for distro in "${_distros[@]}"; do
        (build_golden_single "$distro") || warn "Failed to build golden for ${distro} (continuing)"
    done
}

cmd_build_all() {
    # One-click bring-everything-up: build all 6 goldens, then deploy
    # blue site, then deploy green site. Result: full klab fleet ready
    # for cloning (any future klab spawn = instant ZFS clone).
    #
    # Sequential by design -- previously, clicking "Build all goldens"
    # then "Deploy blue" before the goldens finished was racing with
    # build_golden_single's "zfs destroy @golden && zfs snapshot @golden"
    # window. Deploy_site iterates distros in order; whichever distro
    # was mid-rebuild at the moment of iteration logged "No golden for
    # X -- skipping" and never came back. Caught on .101 (centos blue
    # missing, golden snapshot existed but @golden creation epoch was
    # AFTER deploy started).
    #
    # Idempotent: cmd_golden skips distros whose @golden snapshot
    # already exists; deploy_site skips distros whose <site>-<distro>
    # zvol already exists. Re-runs after partial failure pick up where
    # the last run stopped.
    #
    # Single-flight lock: caught on .135 build #49 -- operator clicked
    # "Build Everything" twice ~8 min apart, two concurrent klab build-
    # all jobs fought for libvirt resources and undef/redef'd each
    # other's golden VMs mid-build. flock -n on a /run/ lockfile
    # prevents the second invocation. fd 200 is the convention for
    # bash flock; -n returns immediately instead of blocking if locked.
    exec 200>/run/klab-build-all.lock || die "could not open lockfile /run/klab-build-all.lock"
    if ! flock -n 200; then
        warn "klab build-all already in progress (lock held by another process)"
        warn "if you are sure no other run is active: rm -f /run/klab-build-all.lock"
        exit 0
    fi
    trap 'rm -f /run/klab-build-all.lock' EXIT
    log "${C}klab build-all${N}: building 6 goldens, then deploying blue + green sites"
    log "  Total expected time: ~45-60 min (golden build dominates)"
    log "  Result: rpool/vms/klab-{golden,blue,green}-<distro> + WireGuard mesh"

    log ""
    log "${C}Phase 1/3:${N} klab golden all"
    cmd_golden all

    log ""
    log "${C}Phase 2/3:${N} klab deploy blue"
    deploy_site blue

    log ""
    log "${C}Phase 3/3:${N} klab deploy green"
    deploy_site green

    log ""
    log "${G}klab build-all complete.${N}"
    log "  Goldens:  rpool/vms/klab-golden-<distro>@golden"
    log "  Blue:     rpool/vms/klab-blue-<distro>   (IPs 192.168.122.101-106)"
    log "  Green:    rpool/vms/klab-green-<distro>  (IPs 192.168.122.201-206)"
    log "  Any further spawn = instant ZFS clone from goldens."
}

# Build the ZFS-test-dedicated golden lineage. Exports:
#   KLAB_GOLDEN_KIND=ztest   → golden_name() returns klab-ztest-<distro>
#   KLAB_ZFS_DEV=1           → setup_vm_golden() installs full test deps
# Produces klab-ztest-<distro> images independently of the blue-green
# klab-golden-<distro> set. Idempotent — if the ztest golden already
# exists, build_golden_single skips it (same as regular).
cmd_golden_ztest() {
    [[ $# -eq 0 ]] && set -- all
    export KLAB_GOLDEN_KIND=ztest
    export KLAB_ZFS_DEV=1
    local _distros=()
    for _arg in "$@"; do
        if [[ "$_arg" == "all" ]]; then
            _distros+=("${DISTROS[@]}")
        else
            _distros+=("$_arg")
        fi
    done
    log "Building ZFS test goldens (target=$*) — these are separate from blue-green goldens."
    # Subshell-isolated: see cmd_golden for the why. The ztest lineage is
    # especially prone to triggering this because the from-source ZFS build
    # adds 30+ minutes per distro of additional surface for a transient
    # network hiccup, kernel-headers mismatch, or SSH timeout to fire `die`
    # and tear down the rest of the run.
    for distro in "${_distros[@]}"; do
        (build_golden_single "$distro") || warn "Failed to build ZTEST golden for ${distro} (continuing)"
    done
    log "ZFS test goldens ready. Names: klab-ztest-<distro>"
}

# Build the DESKTOP golden lineage — a GNOME image per distro, sealed and
# ready to clone. Exports:
#   KLAB_GOLDEN_KIND=desktop → golden_name() returns klab-desktop-<distro>
#   KLAB_DESKTOP=1           → setup_vm_golden() also installs GNOME
#
# ONE desktop, GNOME, on EVERY distro. Anyone who wants KDE or XFCE builds
# their own from the base golden — offering four desktops across five distros
# is twenty images nobody asked for, and the second desktop is the one people
# have opinions about anyway.
#
# EVERY RECIPE BELOW IS VERIFIED AGAINST A REAL REPOSITORY, 2026-08-15,
# because "the group probably exists" is how this lineage would ship a golden
# that is 1100 packages of desktop with no way to log in:
#
#   centos/rocky  workstation-product-environment  1109 pkgs, 1.3 GB, HAS gdm
#                 (checked in quay.io/centos/centos:stream10. The container
#                 also reports a coreutils-single conflict — that is a
#                 CONTAINER artifact: container bases ship coreutils-single
#                 where a cloud image ships full coreutils, so the real guest
#                 has nothing to remove.)
#   fedora        workstation-product-environment  the id a real Workstation
#                 install uses; workstation-product alone is "product CORE",
#                 a shell with no terminal, file manager or browser.
#   debian        task-gnome-desktop               3.81   on trixie
#   ubuntu        task-gnome-desktop               3.75ubuntu1 on 24.04
#                 (the same name works on both, so apt gets ONE code path)
#
# Cost, measured on this host 2026-08-15: ~8.5 GB per desktop golden and
# roughly 6-8 minutes each. Every clone taken afterwards is 17-460 MB and
# 0.2s, which is the entire reason this lineage exists.
cmd_golden_desktop() {
    [[ $# -eq 0 ]] && set -- all
    export KLAB_GOLDEN_KIND=desktop
    export KLAB_DESKTOP=1
    # A desktop adds ~5 min of package install on top of the base build, and
    # the default per-distro watchdog is 20 min. Raise it so a slow mirror
    # cannot make a normal desktop build look like a hang — the operator can
    # still override.
    export KLAB_GOLDEN_MAX_SECS="${KLAB_GOLDEN_MAX_SECS:-2400}"
    local _distros=()
    for _arg in "$@"; do
        if [[ "$_arg" == "all" ]]; then
            _distros+=("${DISTROS[@]}")
        else
            _distros+=("$_arg")
        fi
    done
    log "Building GNOME desktop goldens (target=$*) — separate from blue-green and ztest goldens."
    # Subshell-isolated: see cmd_golden for the why.
    for distro in "${_distros[@]}"; do
        (build_golden_single "$distro") || warn "Failed to build DESKTOP golden for ${distro} (continuing)"
    done
    log "Desktop goldens ready. Names: klab-desktop-<distro> — clone them for instant desktops."
}

# ── Section 6: Site Deploy (Blue-Green) ──────────────────────────────────

deploy_site() {
    local site="$1"
    validate_site "$site"

    ensure_ssh_key
    local deployed=0 skipped=0
    local total_start
    total_start="$(timer_start)"

    # Static IP scheme: blue=192.168.122.101-106, green=192.168.122.201-206
    # First 100 IPs reserved for infrastructure (gateway, DHCP, goldens)
    local ip_base
    [[ "$site" == "blue" ]] && ip_base=100 || ip_base=200

    log "Deploying ${site} site (${#DISTROS[@]} distros)..."

    local node_idx=0
    for distro in "${DISTROS[@]}"; do
        ((node_idx++))
        local gname gpath sname spath sdev
        gname="$(golden_name "$distro")"
        gpath="$(zvol_path "$gname")"
        sname="$(site_name "$site" "$distro")"
        spath="$(zvol_path "$sname")"
        sdev="$(zvol_dev "$sname")"
        local vm_ip="192.168.122.$((ip_base + node_idx))"

        if ! zfs list "${gpath}@golden" >/dev/null 2>&1; then
            warn "No golden for ${distro} — skipping"
            ((skipped++))
            continue
        fi
        # If a zvol exists but no matching libvirt domain (orphan from a
        # reboot or aborted destroy), wipe it and recreate. Skipping silently
        # leaves the user with disks but no running VMs, which is worse
        # than spending 50ms to clone again. Detected 2026-05-26 when a
        # host reboot dropped libvirt definitions for blue/green VMs but
        # the zvols persisted, and `klab deploy blue` silently no-op'd.
        if zfs list "$spath" >/dev/null 2>&1; then
            if virsh dominfo "$sname" >/dev/null 2>&1; then
                warn "${sname} already exists and has a libvirt domain — skipping"
                ((skipped++))
                continue
            fi
            warn "${sname} zvol exists but no libvirt domain — clobbering and redeploying"
            virsh destroy "$sname" 2>/dev/null || true
            virsh undefine "$sname" --nvram 2>/dev/null ||
                virsh undefine "$sname" 2>/dev/null || true
            zfs destroy -Rf "$spath" 2>/dev/null || {
                warn "failed to destroy orphan zvol ${spath}; skipping ${sname}"
                ((skipped++))
                continue
            }
        fi

        echo -ne "  ${gname}@golden -> ${sname} (${vm_ip}) ... "
        local cs
        cs="$(timer_start)"
        zfs clone "${gpath}@golden" "$spath"
        local ce
        ce="$(timer_elapsed_ms "$cs")"
        echo -e "${G}done${N} (${C}${ce}ms${N})"

        for _ in $(seq 1 10); do
            [[ -b "$sdev" ]] && break
            sleep 1
        done
        [[ -b "$sdev" ]] || {
            warn "zvol device not found for ${sname}"
            continue
        }

        local ci_iso
        ci_iso="$(make_cloud_init_iso "$sname" "${site}-${distro}" "" "$vm_ip")"
        virt-install --name "$sname" --ram "$RAM" --vcpus "$CPUS" \
            --os-variant "${OS_VARIANTS[$distro]}" \
            --disk "path=${sdev},bus=virtio" --disk "path=${ci_iso},device=cdrom" \
            --network bridge=virbr0,model=virtio --graphics vnc,listen=0.0.0.0 \
            --channel "unix,target.type=virtio,target.name=org.qemu.guest_agent.0" \
            "${VIRT_BOOT_ARGS[@]}" "${VIRT_TPM_ARGS[@]}" \
            --noautoconsole --import 2>&1 || {
            warn "Failed to boot ${sname}"
            continue
        }

        echo -e "  ${G}${sname}${N} started"
        ((deployed++))
    done

    log "Waiting for VMs to boot (static IPs: 192.168.122.$((ip_base + 1))-$((ip_base + node_idx)))..."
    sleep 20

    echo ""
    echo -e "${W}  Site ${site} VMs:${N}"
    printf "  %-25s %-18s %s\n" "VM" "IP" "ZFS"
    printf "  %-25s %-18s %s\n" "-------------------------" "------------------" "---"

    local vm_idx=0
    for distro in "${DISTROS[@]}"; do
        ((vm_idx++))
        local sname
        sname="$(site_name "$site" "$distro")"
        virsh domstate "$sname" >/dev/null 2>&1 || continue
        local ip="192.168.122.$((ip_base + vm_idx))"
        if wait_for_ssh "$ip" 60; then
            _ssh_cmd "$ip" "hostnamectl set-hostname ${site}-${distro}; systemd-machine-id-setup 2>/dev/null" || true
            local zfs_ver
            zfs_ver="$(_ssh_cmd "$ip" "zfs version 2>/dev/null | head -1" || echo "n/a")"
            printf "  ${G}%-25s${N} %-18s %s\n" "$sname" "$ip" "$zfs_ver"
        else
            printf "  ${R}%-25s${N} %-18s %s\n" "$sname" "$ip" "no SSH"
        fi
    done

    # ── WireGuard mesh ──────────────────────────────────────────────────
    echo ""
    log "Configuring WireGuard mesh..."
    local wg_base
    [[ "$site" == "blue" ]] && wg_base="10.252.0" || wg_base="10.253.0"

    # Phase 1: Generate WireGuard keypairs on all VMs
    declare -A wg_ips=() wg_pubs=()
    local node_id=1
    for distro in "${DISTROS[@]}"; do
        local sname
        sname="$(site_name "$site" "$distro")"
        virsh domstate "$sname" 2>/dev/null | grep -q running || {
            ((node_id++))
            continue
        }
        local ip
        ip="$(get_vm_ip "$sname")"
        [[ -z "$ip" ]] && {
            ((node_id++))
            continue
        }
        _ssh_cmd "$ip" "command -v wg >/dev/null 2>&1" 2>/dev/null || {
            ((node_id++))
            continue
        }

        _ssh_cmd "$ip" bash -s <<WGINIT 2>/dev/null || true
mkdir -p /etc/wireguard
wg genkey > /etc/wireguard/lab.key 2>/dev/null
chmod 600 /etc/wireguard/lab.key
wg pubkey < /etc/wireguard/lab.key > /etc/wireguard/lab.pub 2>/dev/null
cat > /etc/wireguard/wg-lab.conf <<WG
[Interface]
PrivateKey = \$(cat /etc/wireguard/lab.key)
Address = ${wg_base}.${node_id}/24
ListenPort = 51830
WG
WGINIT

        local pub
        pub="$(_ssh_cmd "$ip" 'cat /etc/wireguard/lab.pub 2>/dev/null')"
        if [[ -n "$pub" ]]; then
            wg_ips[$distro]="$ip"
            wg_pubs[$distro]="$pub"
            echo -e "  ${G}${sname}${N} -> ${wg_base}.${node_id}"
        fi
        ((node_id++))
    done

    # Phase 2: Full mesh — peer every VM with every other VM
    node_id=1
    for distro_a in "${DISTROS[@]}"; do
        [[ -z "${wg_ips[$distro_a]:-}" ]] && {
            ((node_id++))
            continue
        }
        local peer_id=1
        for distro_b in "${DISTROS[@]}"; do
            [[ -z "${wg_ips[$distro_b]:-}" ]] && {
                ((peer_id++))
                continue
            }
            [[ "$distro_a" == "$distro_b" ]] && {
                ((peer_id++))
                continue
            }
            _ssh_cmd "${wg_ips[$distro_a]}" "wg set wg-lab peer ${wg_pubs[$distro_b]} allowed-ips ${wg_base}.${peer_id}/32 endpoint ${wg_ips[$distro_b]}:51830 persistent-keepalive 25" 2>/dev/null || true
            ((peer_id++))
        done
        _ssh_cmd "${wg_ips[$distro_a]}" "ip link add dev wg-lab type wireguard 2>/dev/null; wg setconf wg-lab /etc/wireguard/wg-lab.conf 2>/dev/null; ip addr add ${wg_base}.${node_id}/24 dev wg-lab 2>/dev/null; ip link set wg-lab up 2>/dev/null" || true
        # Allow WireGuard traffic through firewall
        _ssh_cmd "${wg_ips[$distro_a]}" "nft add table inet filter 2>/dev/null; nft add chain inet filter input '{ type filter hook input priority 0; policy accept; }' 2>/dev/null; nft add rule inet filter input iifname wg-lab accept 2>/dev/null; nft add rule inet filter input udp dport 51830 accept 2>/dev/null" || true
        ((node_id++))
    done

    # Host joins the mesh as .254 so Prometheus can scrape over WireGuard
    if command -v wg >/dev/null 2>&1; then
        local host_wg_ip="${wg_base}.254"
        mkdir -p /etc/wireguard
        if [[ ! -f /etc/wireguard/klab-${site}.key ]]; then
            wg genkey >"/etc/wireguard/klab-${site}.key" 2>/dev/null
            chmod 600 "/etc/wireguard/klab-${site}.key"
            wg pubkey <"/etc/wireguard/klab-${site}.key" >"/etc/wireguard/klab-${site}.pub" 2>/dev/null
        fi
        local host_pub
        host_pub="$(cat "/etc/wireguard/klab-${site}.pub" 2>/dev/null)"
        local host_priv
        host_priv="$(cat "/etc/wireguard/klab-${site}.key" 2>/dev/null)"

        cat >"/etc/wireguard/klab-${site}.conf" <<WG
[Interface]
PrivateKey = ${host_priv}
Address = ${host_wg_ip}/24
ListenPort = $([[ "$site" == "blue" ]] && echo 51831 || echo 51832)
WG

        # Add all VM peers to host config
        node_id=1
        for distro in "${DISTROS[@]}"; do
            [[ -z "${wg_ips[$distro]:-}" ]] && {
                ((node_id++))
                continue
            }
            cat >>"/etc/wireguard/klab-${site}.conf" <<PEER

[Peer]
PublicKey = ${wg_pubs[$distro]}
AllowedIPs = ${wg_base}.${node_id}/32
Endpoint = ${wg_ips[$distro]}:51830
PersistentKeepalive = 25
PEER
            # Add host as peer on the VM
            _ssh_cmd "${wg_ips[$distro]}" "wg set wg-lab peer ${host_pub} allowed-ips ${host_wg_ip}/32 endpoint $(ip route get 1.1.1.1 2>/dev/null | awk '/src/{print $7}' | head -1):$([[ "$site" == "blue" ]] && echo 51831 || echo 51832) persistent-keepalive 25" 2>/dev/null || true
            ((node_id++))
        done

        # Bring up host WireGuard interface
        ip link del "klab-${site}" 2>/dev/null || true
        ip link add dev "klab-${site}" type wireguard 2>/dev/null
        wg setconf "klab-${site}" "/etc/wireguard/klab-${site}.conf" 2>/dev/null
        ip addr add "${host_wg_ip}/24" dev "klab-${site}" 2>/dev/null
        ip link set "klab-${site}" up 2>/dev/null
        log "Host joined ${site} mesh as ${host_wg_ip} (klab-${site})"
    fi

    log "WireGuard mesh configured (${wg_base}.0/24)"

    # Reload Prometheus if running (picks up new targets)
    systemctl reload prometheus 2>/dev/null || true

    local total_elapsed
    total_elapsed="$(timer_elapsed_ms "$total_start")"
    echo ""
    log "Deploy complete: ${G}${deployed} deployed${N}, ${Y}${skipped} skipped${N} ($((total_elapsed / 1000))s)"
    echo -e "  ${W}WireGuard:${N}  ${wg_base}.0/24 (all traffic encrypted)"
    echo -e "  ${W}SSH:${N}        ssh root@<vm-ip> (password: kldload)"
    echo -e "  ${W}Grafana:${N}    http://localhost:3000 (admin/admin)"
}

# ── Section 7: Blue-Green Operations ─────────────────────────────────────

destroy_site() {
    local site="$1" quiet="${2:-}"
    for distro in "${DISTROS[@]}"; do
        local sname
        sname="$(site_name "$site" "$distro")"
        local spath
        spath="$(zvol_path "$sname")"
        virsh destroy "$sname" 2>/dev/null || true
        virsh undefine "$sname" --nvram 2>/dev/null || virsh undefine "$sname" 2>/dev/null || true
        zfs destroy -Rf "$spath" 2>/dev/null || true
        rm -f "${ISO_DIR}/${sname}-cloud-init.iso" 2>/dev/null
    done
    # Obs VM
    local obs_sname="${PREFIX}-${site}-obs"
    virsh destroy "$obs_sname" 2>/dev/null || true
    virsh undefine "$obs_sname" --nvram 2>/dev/null || virsh undefine "$obs_sname" 2>/dev/null || true
    zfs destroy -Rf "${POOL}/vms/${obs_sname}" 2>/dev/null || true
    [[ -n "$quiet" ]] || log "Site ${site} destroyed"
}

cmd_promote() {
    local site="${1:-green}"
    [[ "$site" == "green" ]] || die "Can only promote green to blue"
    log "Promoting green -> blue"

    local ts
    ts="$(date +%Y%m%d-%H%M%S)"
    local had_blue=false
    for distro in "${DISTROS[@]}"; do
        local bpath
        bpath="$(zvol_path "$(site_name blue "$distro")")"
        if zfs list "$bpath" >/dev/null 2>&1; then
            had_blue=true
            zfs snapshot "${bpath}@pre-promote-${ts}" 2>/dev/null || true
        fi
    done
    $had_blue && destroy_site "blue" quiet

    for distro in "${DISTROS[@]}"; do
        local gname bname gpath bpath
        gname="$(site_name green "$distro")"
        bname="$(site_name blue "$distro")"
        gpath="$(zvol_path "$gname")"
        bpath="$(zvol_path "$bname")"
        zfs list "$gpath" >/dev/null 2>&1 || continue
        virsh destroy "$gname" 2>/dev/null || true
        virsh undefine "$gname" --nvram 2>/dev/null || virsh undefine "$gname" 2>/dev/null || true
        zfs snapshot "${gpath}@promoted-${ts}" 2>/dev/null || true
        echo -ne "  ${gname} -> ${bname} ... "
        local cs
        cs="$(timer_start)"
        zfs clone "${gpath}@promoted-${ts}" "$bpath"
        echo -e "${G}done${N} (${C}$(timer_elapsed_ms "$cs")ms${N})"
        zfs destroy -Rf "$gpath" 2>/dev/null || true
    done

    log "Booting new blue site..."
    deploy_site "blue"
}

cmd_rollback() {
    log "Rolling back blue site to previous snapshot..."
    for distro in "${DISTROS[@]}"; do
        local bname bpath
        bname="$(site_name blue "$distro")"
        bpath="$(zvol_path "$bname")"
        zfs list "$bpath" >/dev/null 2>&1 || continue
        local snap
        snap="$(zfs list -t snapshot -o name -s creation -r "$bpath" 2>/dev/null | tail -1)"
        [[ -z "$snap" || "$snap" == "NAME" ]] && {
            warn "No snapshots for ${bname}"
            continue
        }
        virsh destroy "$bname" 2>/dev/null || true
        virsh undefine "$bname" --nvram 2>/dev/null || virsh undefine "$bname" 2>/dev/null || true
        log "  Rolling back ${bname} to ${snap}"
        zfs rollback -r "$snap"
    done
    deploy_site "blue"
}

# ── Section 8: Payloads ──────────────────────────────────────────────────

# Payload: OpenZFS Test Suite
# _klab_abort_finalize — signal-safe finalizer. Called from run_tests_on_vm's
# EXIT/INT/TERM/HUP trap. If the distro is still marked "running" when the
# trap fires (parent died / signal received mid-run), read whatever PASS/FAIL
# /SKIP lines landed in the log and write an "aborted" summary + status. Safe
# to run multiple times; idempotent once status has already flipped to
# pass/fail/skip/empty (normal-exit path updates status BEFORE returning).
_klab_abort_finalize() {
    local progress_file="$1" log_file="$2" run_dir="$3" distro="$4"
    local cur
    cur="$(cat "$progress_file" 2>/dev/null || echo '')"
    [[ "$cur" != "running" ]] && return 0 # normal-exit path already finalized
    local p f s t
    p="$(grep -ac '\[PASS\]' "$log_file" 2>/dev/null)"
    [[ "$p" =~ ^[0-9]+$ ]] || p=0
    f="$(grep -ac '\[FAIL\]' "$log_file" 2>/dev/null)"
    [[ "$f" =~ ^[0-9]+$ ]] || f=0
    s="$(grep -ac '\[SKIP\]' "$log_file" 2>/dev/null)"
    [[ "$s" =~ ^[0-9]+$ ]] || s=0
    t=$((p + f + s))
    cat >"${run_dir}/${distro}.summary" <<ABORT
distro=${distro}
pass=${p}
fail=${f}
skip=${s}
total=${t}
status=aborted
ABORT
    echo "aborted" >"$progress_file"
}

run_tests_on_vm() {
    local distro="$1" mode="$2" run_dir="$3" ip="$4"
    local log_file="${run_dir}/${distro}.log"
    local progress_file="${run_dir}/${distro}.status"
    echo "running" >"$progress_file"

    # Survive parent death — if the klab orchestrator (or its systemd
    # scope) dies mid-run, bash sends SIGHUP/SIGTERM to every subshell.
    # Without this trap, the subshell exits leaving status="running" and
    # no summary file, so the run dir looks mid-flight forever. The trap
    # writes an "aborted" summary with whatever PASS/FAIL/SKIP lines made
    # it to the log before the signal, so the audit bundle is always
    # complete — no ghost "running" states. Observed on .113 when the
    # parent klab-full.service went inactive mid-run and all four distros
    # stayed frozen at status="running" with no final summary.
    #
    # The trap is a single-quoted string so $log_file / $run_dir / $distro
    # / $progress_file bind at DEFINE time (function args), not at FIRE
    # time (when vars may be unset).
    # shellcheck disable=SC2064
    trap "_klab_abort_finalize '${progress_file}' '${log_file}' '${run_dir}' '${distro}'" EXIT INT TERM HUP

    log "  [${distro}] Starting ${mode} tests on ${ip}..."

    # zfs-tests.sh args. Quick mode runs a small tag set that finishes in
    # ~3-5 min per distro. Full mode runs the entire functional suite (~2h).
    # The previous "-c" was wrong — it expects a config file and consumed
    # the next arg, silently exiting before any test ran. Tags are
    # comma-separated; "fault,zpool" gives broad cli + fault coverage in
    # under 5 min and produces real PASS/FAIL output.
    local _test_args=""
    if [[ "$mode" == "quick" ]]; then
        _test_args="-vx -T fault,zpool"
    else
        _test_args="-vx"
    fi

    local tests_path
    tests_path="$(_ssh_cmd "$ip" "command -v zfs-tests.sh 2>/dev/null || echo /usr/share/zfs/zfs-tests.sh")"
    if ! _ssh_cmd "$ip" "test -f ${tests_path}" 2>/dev/null; then
        echo "SKIP: zfs-tests.sh not found" >"$log_file"
        echo "skip" >"$progress_file"
        return 0
    fi

    # ── Per-VM attestation ────────────────────────────────────────────
    # Capture the exact environment this test ran in — kernel, ZFS
    # binary+module versions, loaded DKMS modules, full package list,
    # pool config. Written to <distro>.env / .packages / .zpool in the
    # run dir so an auditor can reconstruct (or re-run) the exact
    # environment from the bundle. No guessing about "which version
    # of zfs was this?"
    _ssh_cmd "$ip" "
    echo '=== uname ==='; uname -a
    echo ''; echo '=== zfs binary ==='; zfs version 2>&1 | head -10
    echo ''; echo '=== zfs module ==='; modinfo zfs 2>&1 | grep -E '^(version|vermagic|srcversion)'
    echo ''; echo '=== dkms status ==='; dkms status 2>&1
    echo ''; echo '=== test-tools checksum ==='
    sha256sum ${tests_path} 2>&1
    sha256sum /usr/share/zfs/test-runner/bin/test-runner.py 2>&1 || true
  " >"${run_dir}/${distro}.env" 2>&1 || true
    # Installed packages — pick the right tool explicitly. The previous
    # `rpm ... || dpkg ...` form ALWAYS fell through to the rpm branch
    # because `sort` exits 0 on empty input, making the `||` never fire.
    # Result: empty .packages file on Debian/Ubuntu for every ztest run.
    _ssh_cmd "$ip" "if command -v rpm >/dev/null 2>&1; then rpm -qa | sort; else dpkg-query -W -f='\${Package}=\${Version}\n' 2>/dev/null | sort; fi" \
        >"${run_dir}/${distro}.packages" 2>&1 || true
    _ssh_cmd "$ip" "zpool status; echo; zfs list -t all" \
        >"${run_dir}/${distro}.zpool" 2>&1 || true

    # ── Observability instrumentation ─────────────────────────────────
    # Before the test runs, push promtail to the VM and start it with
    # labels keyed to this specific test run. The host Loki (reachable at
    # 192.168.122.1:3100 via the libvirt NAT bridge) then gets:
    #   * VM's systemd journal (including kernel ring, hung_task, Call Trace)
    #   * ZFS module dbgmsg (/proc/spl/kstat/zfs/dbgmsg) — internal ZFS traces
    # Everything is labeled {vm=<distro>, test_run=<run_id>, host=klab-test-*,
    # case=<what-was-happening>} so the klab Test Debug dashboard can
    # correlate per-run per-distro kernel events with PASS/FAIL lines.
    # No changes to the golden image required — promtail is installed fresh
    # per test run from the host's /usr/local/bin/promtail (baked into kldload).
    local _run_id
    _run_id="$(basename "$run_dir")"
    if [[ -x /usr/local/bin/promtail ]]; then
        log "  [${distro}] Installing promtail for log shipping..."
        # ship binary (scp), write config, start via systemd — best-effort,
        # test still runs if this fails.
        scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
            -o LogLevel=ERROR \
            /usr/local/bin/promtail "${SSH_USER:-root}@${ip}:/usr/local/bin/promtail" \
            >/dev/null 2>&1 || true
        _ssh_cmd "$ip" "
      chmod +x /usr/local/bin/promtail 2>/dev/null
      mkdir -p /var/lib/promtail /var/log/journal /etc/systemd/journald.conf.d
      printf '[Journal]\nStorage=persistent\n' > /etc/systemd/journald.conf.d/persistent.conf
      systemd-tmpfiles --create --prefix /var/log/journal 2>/dev/null || true
      systemctl restart systemd-journald 2>/dev/null || true
      cat > /etc/promtail.yaml <<'PROMCFG'
server:
  http_listen_port: 9080
  grpc_listen_port: 0
  log_level: warn
positions:
  filename: /var/lib/promtail/positions.yaml
clients:
  - url: http://192.168.122.1:3100/loki/api/v1/push
scrape_configs:
  - job_name: journal
    journal:
      max_age: 12h
      labels:
        job: systemd-journal
        vm: ${distro}
        host: klab-test-${distro}
        test_run: ${_run_id}
    relabel_configs:
      - source_labels: [__journal__systemd_unit]
        target_label: unit
      - source_labels: [__journal__transport]
        target_label: transport
      - source_labels: [__journal_priority_keyword]
        target_label: severity
  - job_name: zfs-dbgmsg
    static_configs:
      - targets: [localhost]
        labels:
          job: zfs-dbgmsg
          vm: ${distro}
          host: klab-test-${distro}
          test_run: ${_run_id}
          __path__: /proc/spl/kstat/zfs/dbgmsg
PROMCFG
      cat > /etc/systemd/system/promtail.service <<'PROMUNIT'
[Unit]
Description=Promtail → host Loki
After=network-online.target
[Service]
Type=simple
ExecStart=/usr/local/bin/promtail -config.file=/etc/promtail.yaml
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
PROMUNIT
      systemctl daemon-reload 2>/dev/null
      systemctl enable --now promtail 2>/dev/null
    " >/dev/null 2>&1 || true
    fi

    # Stream test output AND capture it. Without tee the test runner's
    # PASS/FAIL/SKIP lines disappear into the log file and the UI's stream
    # panel only sees "Starting" and "Done" — making it impossible to verify
    # the test is actually running. stdbuf -oL keeps lines flushing instead
    # of buffering until the test ends. Prefix every line with [distro] so
    # parallel runs interleave readably.
    #
    # zfs-tests.sh refuses to run as root by design (it has to create test
    # pools as a normal user that escalates with sudo). We create a
    # 'zfstest' user with passwordless sudo on the test VM, then su to it.
    _ssh_cmd "$ip" "
    echo '=== ZFS Test Run ==='
    echo \"Kernel: \$(uname -r)\"
    if ! modprobe zfs 2>/dev/null; then
      echo 'Rebuilding DKMS...'
      dkms autoinstall 2>&1 | tail -5
      depmod -a 2>/dev/null; modprobe zfs 2>&1
    fi
    echo \"ZFS: \$(zfs version 2>/dev/null | head -1)\"
    if ! lsmod | grep -q '^zfs '; then echo 'FATAL: ZFS module not loaded'; exit 1; fi
    # Create the test user if missing — same pattern as upstream's
    # ./scripts/zfs-tests.sh in CI. Passwordless sudo so the test runner
    # can escalate for zpool create / mount / etc.
    if ! id zfstest >/dev/null 2>&1; then
      useradd -m -s /bin/bash zfstest 2>&1 || true
      echo 'zfstest ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/zfstest
      chmod 440 /etc/sudoers.d/zfstest
    fi
    # Some loop devices may need creating before tests run.
    modprobe loop 2>/dev/null || true
    su - zfstest -c \"stdbuf -oL /usr/share/zfs/zfs-tests.sh ${_test_args}\" 2>&1
    echo \"Finished: \$(date)\"
  " 2>&1 | stdbuf -oL sed -u "s/^/[${distro}] /" | tee "$log_file" &
    local _test_pid=$!

    # ── Per-distro watchdog ─────────────────────────────────────────────
    # Kill the test SSH pipe if the log file stops growing for > KLAB_IDLE_MAX
    # seconds (default 4h). Prevents a kernel-hung test VM from blocking the
    # whole matrix for hours — the other distros finish, this one gets marked
    # `timeout`, the run completes and gets summarized. Opt in via KLAB_IDLE_MAX
    # env var. Set to 0 to disable (legacy "wait forever" behaviour).
    local _idle_max="${KLAB_IDLE_MAX:-14400}" # 4h
    if [[ "$_idle_max" -gt 0 ]]; then
        (
            _prev_size=0
            _last_growth=$(date +%s)
            while kill -0 "$_test_pid" 2>/dev/null; do
                sleep 60
                _cur_size=$(stat -c%s "$log_file" 2>/dev/null || echo 0)
                if [[ "$_cur_size" != "$_prev_size" ]]; then
                    _prev_size=$_cur_size
                    _last_growth=$(date +%s)
                fi
                _idle=$(($(date +%s) - _last_growth))
                if [[ "$_idle" -gt "$_idle_max" ]]; then
                    log "  [${distro}] WATCHDOG: log idle ${_idle}s > ${_idle_max}s — killing stuck test"
                    echo "[klab] WATCHDOG: no log growth for ${_idle}s — marking timeout" >>"$log_file"
                    echo "timeout" >"$progress_file"
                    # Capture the debug bundle BEFORE we kill anything — the VM's
                    # kernel state is the evidence we need for the OpenZFS bug report.
                    # SSH into the VM still works even when zfs-tests is deadlocked
                    # (hung_task is kernel-level, but userspace + ssh stay alive).
                    if command -v klab-vm-debug-bundle >/dev/null 2>&1; then
                        log "  [${distro}] WATCHDOG: capturing debug bundle…"
                        klab-vm-debug-bundle "$distro" "$(basename "$run_dir")" "$ip" \
                            >>"$log_file" 2>&1 || true
                    fi
                    kill -TERM "$_test_pid" 2>/dev/null
                    sleep 5
                    kill -KILL "$_test_pid" 2>/dev/null
                    break
                fi
            done
        ) &
        local _watchdog_pid=$!
    fi

    wait "$_test_pid" 2>/dev/null || true
    [[ -n "${_watchdog_pid:-}" ]] && kill "$_watchdog_pid" 2>/dev/null || true

    local total_pass total_fail total_skip
    total_pass="$(grep -c '\[PASS\]' "$log_file" 2>/dev/null)" || total_pass=0
    total_fail="$(grep -c '\[FAIL\]' "$log_file" 2>/dev/null)" || total_fail=0
    total_skip="$(grep -c '\[SKIP\]' "$log_file" 2>/dev/null)" || total_skip=0
    [[ "$total_pass" =~ ^[0-9]+$ ]] || total_pass=0
    [[ "$total_fail" =~ ^[0-9]+$ ]] || total_fail=0
    [[ "$total_skip" =~ ^[0-9]+$ ]] || total_skip=0

    cat >"${run_dir}/${distro}.summary" <<SUMMARY
distro=${distro}
pass=${total_pass}
fail=${total_fail}
skip=${total_skip}
total=$((total_pass + total_fail + total_skip))
SUMMARY
    # Status sidecar: "pass" only if tests actually ran AND none failed.
    # "empty" when nothing was recorded (early exit, bad args, etc.) —
    # previously reported "pass" which masked broken runs in the UI.
    local _total=$((total_pass + total_fail + total_skip))
    if [[ "$total_fail" -gt 0 ]]; then
        echo "fail" >"$progress_file"
        # Auto-capture debug bundle when tests failed. This is what you
        # attach to an OpenZFS issue report — kernel stacks + dmesg +
        # zpool events + arcstats + dbgmsg + test log, all labeled with
        # the exact run+distro+kernel+ZFS version.
        if command -v klab-vm-debug-bundle >/dev/null 2>&1; then
            log "  [${distro}] ${total_fail} fail(s) — capturing debug bundle…"
            klab-vm-debug-bundle "$distro" "$(basename "$run_dir")" "$ip" \
                >>"$log_file" 2>&1 || true
        fi
    elif [[ "$_total" -eq 0 ]]; then
        echo "empty" >"$progress_file"
    else
        echo "pass" >"$progress_file"
    fi
    log "  [${distro}] Done: ${total_pass} pass, ${total_fail} fail, ${total_skip} skip ($(cat "$progress_file"))"
}

cmd_test() {
    local mode="quick" distro_filter=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --quick)
            mode="quick"
            shift
            ;;
        --full)
            mode="full"
            shift
            ;;
        --distro)
            distro_filter="$2"
            shift 2
            ;;
        *) shift ;;
        esac
    done

    local selected_distros=()
    if [[ -n "$distro_filter" ]]; then
        IFS=',' read -ra selected_distros <<<"$distro_filter"
    else
        selected_distros=("${DISTROS[@]}")
    fi

    # Use the dedicated ZFS test goldens — these carry all the required
    # zfs-tests.sh prerequisites (ksh, fio, pamtester, pax, etc.). Regular
    # blue-green goldens are lean by design and WOULD skip 46+ tests.
    export KLAB_GOLDEN_KIND=ztest
    local _missing=()
    for _d in "${selected_distros[@]}"; do
        local _g
        _g="$(golden_name "$_d")"
        zfs list "$(zvol_path "${_g}")@golden" >/dev/null 2>&1 || _missing+=("$_d")
    done
    if ((${#_missing[@]} > 0)); then
        warn "ZFS test goldens missing for: ${_missing[*]}"
        warn "  Build them first:  klab golden-ztest all"
        warn "  Or pick existing:  klab test --full --distro centos"
        [[ "${#_missing[@]}" == "${#selected_distros[@]}" ]] && die "No ZFS test goldens exist."
        log "Proceeding with only the distros that have ztest goldens."
        selected_distros=()
        for _d in "${DISTROS[@]}"; do
            local _g
            _g="$(golden_name "$_d")"
            zfs list "$(zvol_path "${_g}")@golden" >/dev/null 2>&1 && selected_distros+=("$_d")
        done
    fi

    ensure_ssh_key
    local run_id
    run_id="$(date +%Y%m%d-%H%M%S)"
    local run_dir="${RESULTS_DIR}/${run_id}"
    mkdir -p "$run_dir"
    # Point the `latest` symlink at the run dir BEFORE we do any work,
    # so `kztest-tail` and external watchers can follow full.log as it
    # streams. The symlink is re-pointed again at end-of-run (same dir,
    # idempotent) to keep the historical "latest completed run" semantic.
    ln -sfn "$run_dir" "${RESULTS_DIR}/latest"

    # Consolidated run log — the single file the OpenZFS team can grep or
    # attach to a bug report. Every line streamed to the user during this
    # test also lands here, interleaved with [distro] prefixes.
    #
    # DEADLOCK FIX: the naive `exec > >(tee -a file) 2>&1` pattern hangs
    # forever at script exit. Bash waits for its process-substitution tee
    # child, but tee blocks in pipe_read because the shell still holds the
    # write end of the pipe on fd 1/2. Classic circular wait — the shell
    # deadlocked on EXIT, leaving all the per-distro children never running
    # past their own setup. The run dir ended up with only full.log (up to
    # "SSH OK"), no per-distro logs, and "0 pass / 0 fail" in the UI.
    #
    # Capture the tee's PID via $!, then install an EXIT trap that closes
    # fd 1 + fd 2 (letting tee see EOF and drain), then `wait` for tee.
    # Safe to re-run on any script exit path — traps only fire once.
    exec > >(tee -a "${run_dir}/full.log") 2>&1
    _klab_tee_pid=$!
    # shellcheck disable=SC2064
    trap "exec 1>&- 2>&-; wait '${_klab_tee_pid}' 2>/dev/null; true" EXIT

    # ── Audit manifest (part 1 of 2: pre-run provenance) ─────────────
    # The OpenZFS team (or any auditor) must be able to prove, from this
    # directory alone, exactly what code ran on exactly what images on
    # exactly what host. Captured here BEFORE any VMs boot so a hung/
    # killed run still has the full setup recorded. A second block is
    # appended at end-of-run (see below) with the completion metrics.
    local _kldload_ver
    _kldload_ver="$(cat /etc/kldload/version 2>/dev/null || echo '?')"
    local _kldload_git
    _kldload_git="$(cd / && git -C /usr/share/kldload rev-parse HEAD 2>/dev/null || echo 'not-a-git-install')"
    local _host_id
    _host_id="$(cat /etc/machine-id 2>/dev/null || echo '?')"
    local _host_cpu
    _host_cpu="$(awk -F: '/model name/ {print $2; exit}' /proc/cpuinfo | sed 's/^ *//')"
    local _host_ram
    _host_ram="$(awk '/MemTotal/ {printf "%d MB", $2/1024}' /proc/meminfo)"
    {
        echo "# kldload ZFS-test audit manifest"
        echo "# This file, together with full.log and the per-distro artifacts,"
        echo "# constitutes the complete audit record of the run."
        echo ""
        echo "[run]"
        echo "run_id         = ${run_id}"
        echo "mode           = ${mode}"
        echo "distros        = ${selected_distros[*]}"
        echo "serial         = ${KLAB_SERIAL:-0}"
        echo "concurrency    = ${KLAB_MAX_CONCURRENT:-auto}"
        echo "invocation     = ${0} ${*}"
        echo "invoker_uid    = ${EUID}"
        echo "invoker_pid    = $$"
        echo "date_start     = $(date -Iseconds)"
        echo "date_start_ns  = $(date +%s%N)"
        echo ""
        echo "[kldload]"
        echo "version        = ${_kldload_ver}"
        echo "codename       = Proving Ground"
        echo "git_sha        = ${_kldload_git}"
        echo "klab_sha256    = $(sha256sum /usr/local/bin/klab 2>/dev/null | awk '{print $1}')"
        echo ""
        echo "[host]"
        echo "hostname       = $(hostname 2>/dev/null || cat /etc/hostname)"
        echo "machine_id     = ${_host_id}"
        echo "kernel         = $(uname -r)"
        echo "os             = $(
            . /etc/os-release 2>/dev/null
            echo ${PRETTY_NAME:-?}
        )"
        echo "cpu            = ${_host_cpu}"
        echo "cpus           = $(nproc)"
        echo "ram            = ${_host_ram}"
        echo "zfs            = $(zfs version 2>/dev/null | head -1)"
        echo "zpool_health   = $(zpool list -H -o health 2>/dev/null | head -1)"
        echo ""
        echo "[goldens]"
        for _d in "${selected_distros[@]}"; do
            local _g="$(golden_name "$_d")"
            local _gsnap="rpool/vms/${_g}@golden"
            local _guid _csum _created _size
            _guid="$(zfs get -Hp -o value guid "$_gsnap" 2>/dev/null || echo '-')"
            _created="$(zfs get -Hp -o value creation "$_gsnap" 2>/dev/null | awk '{if($1 ~ /^[0-9]+$/) print strftime("%Y-%m-%dT%H:%M:%S", $1); else print $0}')"
            _size="$(zfs get -Hp -o value referenced "$_gsnap" 2>/dev/null || echo '-')"
            echo "${_d}.name     = ${_g}"
            echo "${_d}.snapshot = ${_gsnap}"
            echo "${_d}.guid     = ${_guid}"
            echo "${_d}.created  = ${_created}"
            echo "${_d}.size     = ${_size}"
        done
    } >"${run_dir}/manifest.txt"

    # Reference the ISO install attestation so the auditor can walk the
    # chain: ISO SHA256 → installed host → this run.
    [[ -f /etc/kldload/install.attest ]] &&
        cat /etc/kldload/install.attest >>"${run_dir}/manifest.txt"

    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
    echo -e "${W}  klab test — ${mode} mode${N}"
    echo -e "${D}  Distros: ${selected_distros[*]}${N}"
    echo -e "${D}  Run ID:  ${run_id}${N}"
    echo -e "${D}  Full log: ${run_dir}/full.log${N}"
    echo -e "${D}  Manifest: ${run_dir}/manifest.txt  (audit provenance)${N}"
    echo -e "${C}══════════════════════════════════════════════════════════════${N}"

    local t_start
    t_start="$(timer_start)"
    declare -A vm_ips=()

    log "Cloning and booting test VMs..."
    for distro in "${selected_distros[@]}"; do
        local name zpath golden_zpath
        name="$(test_vm_name "$distro")"
        zpath="$(zvol_path "$name")"
        golden_zpath="$(zvol_path "$(golden_name "$distro")")"
        zfs list "${golden_zpath}@golden" >/dev/null 2>&1 || {
            warn "No golden for ${distro}"
            continue
        }
        # --nvram is mandatory for UEFI+TPM VMs. Without it, undefine leaves
        # the domain half-defined and `virt-install --name X` later races with
        # the leftover definition, causing "Failed to boot" for that distro.
        virsh destroy "$name" 2>/dev/null || true
        virsh undefine "$name" --nvram 2>/dev/null || virsh undefine "$name" 2>/dev/null || true
        # Only enter the 15s destroy-retry loop if the zvol actually exists.
        # Previously we tried `zfs destroy` unconditionally 15x1s even on fresh
        # boxes where klab-test-$distro had never been created, burning ~75s
        # of sequential dead wait across all 5 distros and making users believe
        # "only centos started" when they were actually mid-cleanup. Times out
        # only when a prior VM's qemu is still holding the zvol open.
        if zfs list "$zpath" >/dev/null 2>&1; then
            for _i in $(seq 1 15); do
                zfs destroy -Rf "$zpath" 2>/dev/null && break
                sleep 1
            done
        fi
        if zfs list "$zpath" >/dev/null 2>&1; then
            warn "  ${distro}: could not free old zvol ${zpath} — force-killing qemu holder"
            # Last resort: SIGKILL any qemu still holding this name, then retry.
            pgrep -af "qemu.*${name}" | awk '{print $1}' | xargs -r kill -9 2>/dev/null
            sleep 2
            zfs destroy -Rf "$zpath" 2>/dev/null
            if zfs list "$zpath" >/dev/null 2>&1; then
                warn "  ${distro}: zvol ${zpath} still busy after force-kill — skipping"
                continue
            fi
        fi
        # Clean up stale @klab-test-* snapshots on the SOURCE golden. Each
        # test run used to leave a named snapshot on the ztest source that
        # never got cleaned, so after 4-5 runs the source had 5+ accumulated
        # @klab-test-* snapshots (clutter + small confusion in zfs list).
        zfs list -H -t snapshot -o name "$golden_zpath" 2>/dev/null |
            grep -E '@(klab-test|clone)-' |
            xargs -r -n1 zfs destroy 2>/dev/null || true
        local ct
        ct="$(timer_start)"
        if ! zfs clone "${golden_zpath}@golden" "$zpath" 2>&1; then
            warn "  ${distro}: clone failed — skipping"
            continue
        fi
        log "  Cloned ${distro} in $(timer_elapsed_ms "$ct")ms"
        local ci_iso zdev
        zdev="$(zvol_dev "$name")"
        ci_iso="$(make_cloud_init_iso "$name" "${PREFIX}-test-${distro}")"
        virt-install --name "$name" --ram "$RAM" --vcpus "$CPUS" \
            --os-variant "${OS_VARIANTS[$distro]}" \
            --disk "path=${zdev},bus=virtio" --disk "path=${ci_iso},device=cdrom" \
            --network bridge=virbr0,model=virtio --graphics vnc,listen=0.0.0.0 --video virtio --noautoconsole \
            --channel "unix,target.type=virtio,target.name=org.qemu.guest_agent.0" --import \
            "${VIRT_BOOT_ARGS[@]}" "${VIRT_TPM_ARGS[@]}" \
            >/dev/null 2>&1 || {
            warn "Failed to boot ${distro}"
            continue
        }
    done

    log "Waiting for SSH (parallel)..."
    # Wait for each VM's SSH in parallel — was sequential, where one slow
    # cold-boot (e.g. fedora) made every later distro queue behind it.
    # Each background task writes its result to a tmp file the parent then
    # collects. wait_for_ssh polls every 2s up to 300s.
    #
    # Must wait on EXPLICIT pids, not bare `wait`. Bare `wait` also waits
    # for bash's hidden process-substitution subshell (the tee child from
    # `exec > >(tee …)` above) which never exits until the main script's
    # fd 1 closes — and the main script's fd 1 won't close until cmd_test
    # returns. Circular wait. Symptom was the test hanging forever right
    # after "SSH OK" with nothing else landing in full.log.
    local _ssh_tmp
    _ssh_tmp="$(mktemp -d)"
    local -a _ssh_pids=()
    for distro in "${selected_distros[@]}"; do
        local name
        name="$(test_vm_name "$distro")"
        virsh domstate "$name" 2>/dev/null | grep -q running || continue
        (
            local _ip
            _ip="$(get_vm_ip "$name")"
            if [[ -n "$_ip" ]] && wait_for_ssh "$_ip" 300; then
                echo "$_ip" >"${_ssh_tmp}/${distro}"
                log "  ${distro}: ${_ip} (SSH OK)"
            else
                log "  ${distro}: SSH timeout"
            fi
        ) &
        _ssh_pids+=($!)
    done
    # Wait only on the SSH-probe PIDs; ignore the tee subshell.
    [[ ${#_ssh_pids[@]} -gt 0 ]] && wait "${_ssh_pids[@]}" 2>/dev/null || true
    # Force kernel flush so any just-written result files are durable
    # before the parent reads them. Without this, on very loaded hosts a
    # subshell's `echo > file` can be still-dirty in page cache when the
    # parent `[[ -s file ]]` fires, silently dropping the distro from
    # vm_ips. Observed on .113: centos wrote "SSH OK" to the log then
    # never got a run_tests_on_vm call because its result file read as
    # empty.
    sync
    for distro in "${selected_distros[@]}"; do
        if [[ -s "${_ssh_tmp}/${distro}" ]]; then
            vm_ips[$distro]="$(cat "${_ssh_tmp}/${distro}")"
            continue
        fi
        # Fallback: SSH probe didn't produce a result file, but the VM may
        # actually be reachable. Do a direct probe before dropping it —
        # this handles the race described above plus any edge cases where
        # the subshell exited before flushing the file. Use the same IP
        # resolution path (agent → MAC-filtered DHCP → ARP).
        local _name
        _name="$(test_vm_name "$distro")"
        local _retry_ip
        _retry_ip="$(get_vm_ip "$_name" 2>/dev/null)"
        if [[ -n "$_retry_ip" ]] && wait_for_ssh "$_retry_ip" 30; then
            vm_ips[$distro]="$_retry_ip"
            log "  ${distro}: ${_retry_ip} (SSH OK — retry after probe-file miss)"
        else
            warn "  ${distro}: dropped — SSH probe file empty and retry failed"
        fi
    done
    rm -rf "$_ssh_tmp"
    # Loud audit line so a dropped distro is obvious in the log. If we
    # expected 5 distros and vm_ips ended with 4, the user (and grep)
    # notice immediately instead of hunting for a silent 0-byte log.
    # Use [@] not [*] — bash mis-parses `${!array[*]}` on some versions as
    # indirect-expand-then-keys, which tries to read IPs as variable names
    # and errors "invalid variable name". [@] is the canonical keys syntax.
    _vm_ip_keys="${!vm_ips[@]}"
    log "  SSH probe complete — vm_ips: ${_vm_ip_keys:-none} (${#vm_ips[@]} of ${#selected_distros[@]})"

    local serial="${KLAB_SERIAL:-0}"
    if [[ "$serial" == "1" ]]; then
        log "Running ${mode} tests in series (one distro at a time)..."
        for distro in "${!vm_ips[@]}"; do
            log "  Testing ${distro}..."
            run_tests_on_vm "$distro" "$mode" "$run_dir" "${vm_ips[$distro]}"
        done
    else
        # Parallel execution via a running process pool.
        #
        # Old design: batches of _max, with `wait` between batches. On a host
        # with _max=4 and 5 distros, centos would queue as the "5th" and not
        # start until ALL 4 of rocky/fedora/debian/ubuntu finished their
        # ~2-3 hour zfs-tests runs. Wall clock doubled for one queued distro.
        #
        # New design: keep _max distros running at all times. `wait -n` blocks
        # until ANY child exits, then we immediately start the next queued
        # distro. Centos slots in as soon as the first of the other 4 finishes.
        # Total wall clock = max(per-distro runtime, N/_max × mean-runtime).
        #
        # Also: bare `wait` was dangerous — it waits for the tee subshell too
        # (from `exec > >(tee …)` at the top), causing the circular-wait
        # deadlock we fixed in the SSH probe loop. `wait -n` only returns when
        # a child actually exits, and we prune tracked PIDs so the tee
        # subshell (which never exits mid-run) doesn't confuse accounting.
        #
        # Default pool size = N (run everything in parallel) capped at 8 so
        # a freak 20-distro request doesn't crush the kernel. zfs-tests is
        # IO-bound more than CPU-bound — mild CPU oversubscription is fine.
        # Override via KLAB_MAX_CONCURRENT.
        local _n=${#vm_ips[@]} _max
        if [[ -n "${KLAB_MAX_CONCURRENT:-}" ]]; then
            _max="${KLAB_MAX_CONCURRENT}"
        else
            _max=$_n
            ((_max > 8)) && _max=8
        fi
        log "Running ${mode} tests in process pool of ${_max} (${_n} VMs total)..."
        local -a _pool_pids=()
        local _distros_arr=("${!vm_ips[@]}")
        local _next=0

        # Fill the pool to capacity.
        while ((_next < _n && ${#_pool_pids[@]} < _max)); do
            local _d="${_distros_arr[$_next]}"
            run_tests_on_vm "$_d" "$mode" "$run_dir" "${vm_ips[$_d]}" &
            _pool_pids+=($!)
            _next=$((_next + 1))
        done
        # Drain + refill: as each test exits, start the next queued distro.
        while ((${#_pool_pids[@]} > 0)); do
            wait -n 2>/dev/null || true
            # Prune any PIDs that have exited. Keep the ones still running.
            local -a _still_alive=()
            local _p
            for _p in "${_pool_pids[@]}"; do
                kill -0 "$_p" 2>/dev/null && _still_alive+=("$_p")
            done
            _pool_pids=("${_still_alive[@]}")
            # Start the next queued distro, if any.
            if ((_next < _n)); then
                local _d="${_distros_arr[$_next]}"
                run_tests_on_vm "$_d" "$mode" "$run_dir" "${vm_ips[$_d]}" &
                _pool_pids+=($!)
                _next=$((_next + 1))
            fi
        done
    fi

    local elapsed
    elapsed="$(timer_elapsed_ms "$t_start")"
    cmd_results "$run_id"
    log "Total time: $((elapsed / 1000))s"
    ln -sfn "$run_dir" "${RESULTS_DIR}/latest"

    # ── End-of-run audit closure ─────────────────────────────────────
    # Appends to manifest.txt: result totals, exact zfs-tests.sh
    # invocation (proves we used stock upstream runner), per-distro env
    # references, and the SHA-256 of every artifact in the run dir so
    # the auditor can detect tampering post-facto.
    local _total_pass=0 _total_fail=0 _total_skip=0 _distro_lines=()
    for _d in "${selected_distros[@]}"; do
        [[ -f "${run_dir}/${_d}.summary" ]] || continue
        local _p _f _s
        _p="$(awk -F= '/^pass=/ {print $2}' "${run_dir}/${_d}.summary")"
        _f="$(awk -F= '/^fail=/ {print $2}' "${run_dir}/${_d}.summary")"
        _s="$(awk -F= '/^skip=/ {print $2}' "${run_dir}/${_d}.summary")"
        _total_pass=$((_total_pass + ${_p:-0}))
        _total_fail=$((_total_fail + ${_f:-0}))
        _total_skip=$((_total_skip + ${_s:-0}))
        _distro_lines+=("${_d}: pass=${_p:-0} fail=${_f:-0} skip=${_s:-0}")
    done

    local _test_args_for_manifest
    if [[ "$mode" == "quick" ]]; then
        _test_args_for_manifest="-vx -T fault,zpool"
    else _test_args_for_manifest="-vx"; fi

    {
        echo ""
        echo "[reproducibility]"
        echo "# To re-run these tests on any stock upstream OpenZFS install,"
        echo "# duplicate the distro+kernel+zfs combo listed above and run:"
        echo "#   sudo -u zfstest /usr/share/zfs/zfs-tests.sh ${_test_args_for_manifest}"
        echo "# klab invokes the test runner with NO patches, NO overlays,"
        echo "# and NO custom wrapping. The sha256 of zfs-tests.sh +"
        echo "# test-runner.py on each VM is recorded in <distro>.env —"
        echo "# compare against the upstream release tarball to verify."
        echo "zfs_tests_args = ${_test_args_for_manifest}"
        echo "runner         = /usr/share/zfs/zfs-tests.sh"
        echo "runner_as_user = zfstest (passwordless sudo — upstream pattern)"
        echo "no_patches     = true"
        echo ""
        echo "[results]"
        echo "date_end       = $(date -Iseconds)"
        echo "date_end_ns    = $(date +%s%N)"
        echo "elapsed_sec    = $((elapsed / 1000))"
        echo "total_pass     = ${_total_pass}"
        echo "total_fail     = ${_total_fail}"
        echo "total_skip     = ${_total_skip}"
        echo "total_tests    = $((_total_pass + _total_fail + _total_skip))"
        echo "overall_status = $([[ "$_total_fail" -eq 0 && "$_total_pass" -gt 0 ]] && echo PASS || ([[ "$_total_fail" -gt 0 ]] && echo FAIL || echo EMPTY))"
        echo ""
        echo "[per_distro]"
        for _l in "${_distro_lines[@]}"; do echo "$_l"; done
        echo ""
        echo "[artifacts]"
        echo "# SHA-256 of every file in this run directory — sign with GPG"
        echo "# or verify against an out-of-band copy to detect tampering."
    } >>"${run_dir}/manifest.txt"

    # Write SHA-256 sums of all artifacts (except the manifest itself
    # and the sums file) so post-hoc tampering is detectable.
    (cd "${run_dir}" && find . -type f ! -name manifest.txt ! -name sha256sums.txt -print0 |
        sort -z |
        xargs -0 sha256sum 2>/dev/null >sha256sums.txt) || true
    # Include the sums in the manifest for single-file attestation.
    cat "${run_dir}/sha256sums.txt" >>"${run_dir}/manifest.txt"

    # JUnit XML for CI pipeline attachment. Parses the checklist lines
    # from each per-distro log and emits the canonical JUnit format so
    # GitHub Actions / GitLab / Jenkins can display the matrix natively.
    {
        echo '<?xml version="1.0" encoding="UTF-8"?>'
        echo "<testsuites name=\"kldload-klab\" tests=\"$((_total_pass + _total_fail + _total_skip))\" failures=\"${_total_fail}\" skipped=\"${_total_skip}\" time=\"$((elapsed / 1000))\">"
        for _d in "${selected_distros[@]}"; do
            [[ -f "${run_dir}/${_d}.log" ]] || continue
            local _dp _df _ds
            _dp="$(grep -c '\[PASS\]' "${run_dir}/${_d}.log" 2>/dev/null || echo 0)"
            _df="$(grep -c '\[FAIL\]' "${run_dir}/${_d}.log" 2>/dev/null || echo 0)"
            _ds="$(grep -c '\[SKIP\]' "${run_dir}/${_d}.log" 2>/dev/null || echo 0)"
            echo "  <testsuite name=\"${_d}\" tests=\"$((_dp + _df + _ds))\" failures=\"${_df}\" skipped=\"${_ds}\">"
            grep -aE 'Test(\(Linux\))?: .+\[(PASS|FAIL|SKIP|KILLED)\]' "${run_dir}/${_d}.log" 2>/dev/null | while IFS= read -r line; do
                local _tname _tstatus
                _tname="$(echo "$line" | sed -n 's|.*Test[^:]*: \([^ ]*\) .*|\1|p' | sed 's|/usr/share/zfs/zfs-tests/tests/functional/||')"
                _tstatus="$(echo "$line" | sed -n 's|.*\[\(PASS\|FAIL\|SKIP\|KILLED\)\].*|\1|p')"
                [[ -z "$_tname" || -z "$_tstatus" ]] && continue
                # XML-escape the name minimally
                _tname="${_tname//&/&amp;}"
                _tname="${_tname//</&lt;}"
                _tname="${_tname//>/&gt;}"
                case "$_tstatus" in
                PASS) echo "    <testcase name=\"${_tname}\"/>" ;;
                FAIL | KILLED) echo "    <testcase name=\"${_tname}\"><failure type=\"${_tstatus}\"/></testcase>" ;;
                SKIP) echo "    <testcase name=\"${_tname}\"><skipped/></testcase>" ;;
                esac
            done
            echo "  </testsuite>"
        done
        echo "</testsuites>"
    } >"${run_dir}/results.junit.xml" 2>/dev/null || true

    log "Run complete: ${_total_pass} pass · ${_total_fail} fail · ${_total_skip} skip"
    log "Audit bundle: ${run_dir}/"
    log "  manifest.txt      — full provenance (kldload + host + goldens + results + sums)"
    log "  full.log          — every line streamed during the run"
    log "  <distro>.log      — per-distro test output"
    log "  <distro>.env      — kernel + zfs versions + tool checksums"
    log "  <distro>.packages — full rpm/dpkg package list"
    log "  <distro>.zpool    — zpool status + zfs list at test time"
    log "  results.junit.xml — CI-importable result matrix"
    log "  sha256sums.txt    — integrity hashes"

    log "Cleaning up test VMs..."
    for distro in "${selected_distros[@]}"; do
        local name
        name="$(test_vm_name "$distro")"
        virsh destroy "$name" 2>/dev/null || true
        # UEFI test VMs carry nvram (swtpm/boot-order state). Plain
        # `undefine` refuses them without --nvram, leaving the domain
        # defined-but-offline and the zvol busy. Keep the plain form as
        # a last-resort fallback for non-UEFI distros.
        virsh undefine "$name" --nvram --remove-all-storage 2>/dev/null ||
            virsh undefine "$name" --nvram 2>/dev/null ||
            virsh undefine "$name" 2>/dev/null || true
        zfs destroy -Rf "$(zvol_path "$name")" 2>/dev/null || true
        rm -f "${ISO_DIR}/${name}-cloud-init.iso" 2>/dev/null || true
    done
    log "Cleanup done."
}

# Payload: Custom Playbook
cmd_run_playbook() {
    local playbook="$1" site="${2:-blue}"
    [[ -f "$playbook" ]] || die "Playbook not found: ${playbook}"

    log "Running playbook ${playbook} on ${site} site..."
    local results_dir="${RESULTS_DIR}/playbook-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$results_dir"
    local pass=0 fail=0

    for distro in "${DISTROS[@]}"; do
        local sname
        sname="$(site_name "$site" "$distro")"
        virsh domstate "$sname" 2>/dev/null | grep -q running || continue
        local ip
        ip="$(get_vm_ip "$sname" 2>/dev/null)"
        [[ -n "$ip" ]] || continue

        log "  [${distro}] Running on ${ip}..."
        scp -o StrictHostKeyChecking=no -i "$SSH_KEY" "$playbook" "root@${ip}:/tmp/klab-playbook" 2>/dev/null ||
            sshpass -p kldload scp -o StrictHostKeyChecking=no "$playbook" "root@${ip}:/tmp/klab-playbook" 2>/dev/null
        _ssh_cmd "$ip" "chmod +x /tmp/klab-playbook && /tmp/klab-playbook" >"${results_dir}/${distro}.log" 2>&1
        local rc=$?
        if [[ $rc -eq 0 ]]; then
            echo -e "  ${G}${distro}${N}: PASS"
            ((pass++))
        else
            echo -e "  ${R}${distro}${N}: FAIL (exit ${rc})"
            ((fail++))
        fi
    done

    echo ""
    log "Playbook results: ${G}${pass} passed${N}, ${R}${fail} failed${N}"
    log "Logs: ${results_dir}/"
}

# Payload: Kubernetes (calls existing kube-cluster tools)
cmd_kubernetes() {
    local workers="${1:-3}" distro="${2:-centos}"
    log "Deploying K8s cluster from ${distro} golden (1 CP + ${workers} workers)..."
    if command -v kube-cluster >/dev/null 2>&1; then
        kube-cluster bootstrap --workers "$workers" "$@"
    else
        die "kube-cluster not found — K8s payload requires KVM profile install"
    fi
}

# ── Section 9: Results Display ───────────────────────────────────────────

cmd_results() {
    local run_id="${1:-}"
    local run_dir
    if [[ -n "$run_id" ]]; then
        run_dir="${RESULTS_DIR}/${run_id}"
    elif [[ -L "${RESULTS_DIR}/latest" ]]; then
        run_dir="$(readlink -f "${RESULTS_DIR}/latest")"
        run_id="$(basename "$run_dir")"
    else
        die "No results found. Run: klab test"
    fi
    [[ -d "$run_dir" ]] || die "Results not found: ${run_dir}"

    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
    echo -e "${W}  klab — Test Run ${run_id}${N}"
    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
    echo ""
    printf "  ${W}%-12s %8s %8s %8s %8s %8s${N}\n" "DISTRO" "PASS" "FAIL" "SKIP" "TOTAL" "STATUS"
    echo "  ─────────── ──────── ──────── ──────── ──────── ────────"

    local grand_pass=0 grand_fail=0 grand_skip=0
    for summary in "${run_dir}"/*.summary; do
        [[ -f "$summary" ]] || continue
        local distro pass fail skip total
        source "$summary"
        local status_color="$G" status_text="PASS"
        [[ "$fail" -gt 0 ]] && {
            status_color="$R"
            status_text="FAIL"
        }
        printf "  %-12s ${G}%8s${N} ${R}%8s${N} ${Y}%8s${N} %8s ${status_color}%8s${N}\n" "$distro" "$pass" "$fail" "$skip" "$total" "$status_text"
        grand_pass=$((grand_pass + pass))
        grand_fail=$((grand_fail + fail))
        grand_skip=$((grand_skip + skip))
    done

    echo "  ─────────── ──────── ──────── ──────── ──────── ────────"
    printf "  ${W}%-12s %8s %8s %8s %8s${N}\n" "TOTAL" "$grand_pass" "$grand_fail" "$grand_skip" "$((grand_pass + grand_fail + grand_skip))"
    echo ""
    if [[ $grand_fail -eq 0 && $((grand_pass + grand_fail + grand_skip)) -gt 0 ]]; then
        echo -e "  ${G}ALL TESTS PASSED${N}"
    elif [[ $((grand_pass + grand_fail + grand_skip)) -eq 0 ]]; then
        echo -e "  ${Y}No results yet${N}"
    else
        echo -e "  ${R}${grand_fail} FAILURES${N} — logs: ${run_dir}/"
    fi
    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
}

# ── Section 10: Status / Verify / Destroy ────────────────────────────────

cmd_status() {
    echo -e "${C}══════════════════════════════════════════════════════════════════════════════════════════════${N}"
    echo -e "${W}  klab — Multi-Distro Test Platform${N}"
    echo -e "${D}  Host: $(uname -n) • $(nproc) cores • $(awk '/MemTotal/ {printf "%.0fGB", $2/1048576}' /proc/meminfo) RAM • NVIDIA: $([[ $NVIDIA_DETECTED -eq 1 ]] && echo "YES" || echo "no") • ZFS: ${ZFS_SOURCE}${N}"
    echo -e "${C}══════════════════════════════════════════════════════════════════════════════════════════════${N}"
    echo ""

    echo -e "  ${W}Golden Images:${N}"
    echo ""
    printf "  ${W}%-10s %-8s %-10s %-28s %-16s %-8s %-6s %-6s${N}\n" "DISTRO" "STATUS" "SIZE" "KERNEL" "ZFS" "DKMS" "TESTS" "KSH"
    echo "  ────────── ──────── ────────── ──────────────────────────── ──────────────── ──────── ────── ──────"

    local total_ready=0 total_fail=0 total_skip=0
    for distro in "${DISTROS[@]}"; do
        local name zpath
        name="$(golden_name "$distro")"
        zpath="$(zvol_path "$name")"
        if zfs list "${zpath}@golden" >/dev/null 2>&1; then
            local used _kernel _zfs_ver _dkms _tests _ksh
            used="$(zfs get -Hp -o value used "$zpath" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo "?")"
            local _log="${RESULTS_DIR}/goldens/${distro}-latest.log"
            if [[ -f "$_log" ]]; then
                _kernel="$(grep '  Kernel:' "$_log" 2>/dev/null | tail -1 | sed 's/.*Kernel: *//' | head -c 28)"
                _zfs_ver="$(grep '  ZFS version:' "$_log" 2>/dev/null | tail -1 | sed 's/.*ZFS version: *//' | head -c 16)"
                _dkms="$(grep '  Result:' "$_log" 2>/dev/null | tail -1 | sed 's/.*Result: *//')"
                _tests="$(grep '  zfs-tests.sh:' "$_log" 2>/dev/null | tail -1 | sed 's/.*zfs-tests.sh: *//')"
                _ksh="$(grep '  ksh:' "$_log" 2>/dev/null | tail -1 | sed 's/.*ksh: *//')"
            else
                _kernel="-"
                _zfs_ver="-"
                _dkms="-"
                _tests="-"
                _ksh="-"
            fi
            [[ -z "$_kernel" ]] && _kernel="-"
            [[ -z "$_zfs_ver" ]] && _zfs_ver="-"
            [[ -z "$_tests" ]] && _tests="-"
            [[ -z "$_ksh" ]] && _ksh="-"

            local _sc="$G" _st="READY"
            if [[ "$_dkms" == *"FAIL"* ]]; then
                _sc="$R"
                _st="FAIL"
                ((total_fail++))
            elif [[ "$_dkms" == *"PARTIAL"* ]]; then
                _sc="$Y"
                _st="PARTIAL"
                ((total_fail++))
            else ((total_ready++)); fi

            printf "  %-10s ${_sc}%-8s${N} %-10s %-28s %-16s ${G}%-8s${N} %-6s %-6s\n" \
                "$distro" "$_st" "$used" "$_kernel" "$_zfs_ver" "OK" "$_tests" "$_ksh"
        else
            printf "  %-10s ${D}%-8s${N}\n" "$distro" "—"
            ((total_skip++))
        fi
    done

    echo "  ────────── ──────── ────────── ──────────────────────────── ──────────────── ──────── ────── ──────"
    echo -e "  ${G}Ready: ${total_ready}${N}  ${R}Failed: ${total_fail}${N}  ${D}Not built: ${total_skip}${N}  Total: ${#DISTROS[@]}"

    local _used _avail
    _used="$(zfs get -Hp -o value used "${POOL}/vms" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo "?")"
    _avail="$(zfs get -Hp -o value available "${POOL}/vms" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo "?")"
    echo ""
    echo -e "  ${W}Storage:${N} ${_used} used / ${_avail} available on ${POOL}/vms"

    # Blue/green sites
    for site in blue green; do
        echo ""
        echo -e "  ${W}Site ${site}:${N}"
        local count=0
        for distro in "${DISTROS[@]}"; do
            local sname spath
            sname="$(site_name "$site" "$distro")"
            spath="$(zvol_path "$sname")"
            zfs list "$spath" >/dev/null 2>&1 || continue
            ((count++))
            local state
            state="$(virsh domstate "$sname" 2>/dev/null | head -1)" || state="undefined"
            if [[ "$state" == "running" ]]; then
                local ip
                ip="$(get_vm_ip "$sname" 2>/dev/null)" || ip=""
                printf "    ${G}%-25s${N} %-16s %s\n" "$sname" "${ip:-no IP}" "$state"
            else
                printf "    ${D}%-25s${N} %-16s %s\n" "$sname" "--" "$state"
            fi
        done
        [[ $count -eq 0 ]] && echo "    (not deployed)"
    done

    echo ""
    echo -e "  ${W}Results:${N}"
    if [[ -L "${RESULTS_DIR}/latest" ]]; then
        echo -e "    Latest: $(basename "$(readlink -f "${RESULTS_DIR}/latest")")"
    else
        echo -e "    ${D}No test runs yet${N}"
    fi

    echo ""
    echo -e "  ${W}Logs:${N} ${RESULTS_DIR}/"
    [[ -f "$MASTER_LOG" ]] && echo -e "    Master log: ${MASTER_LOG} ($(wc -l <"$MASTER_LOG" 2>/dev/null || echo 0) lines)"
    echo -e "${C}══════════════════════════════════════════════════════════════════════════════════════════════${N}"
}

cmd_verify() {
    local target="${1:-all}"
    local distros_to_check=()
    if [[ "$target" == "all" ]]; then
        distros_to_check=("${DISTROS[@]}")
    else
        validate_distro "$target"
        distros_to_check=("$target")
    fi

    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
    echo -e "${W}  klab verify — smoke test golden images${N}"
    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
    echo ""

    local pass=0 fail=0 skip=0
    printf "  ${W}%-12s %-10s %-10s %-12s %-10s${N}\n" "DISTRO" "GOLDEN" "BOOT" "ZFS" "TESTS"
    echo "  ─────────── ────────── ────────── ──────────── ──────────"

    for distro in "${distros_to_check[@]}"; do
        local name zpath
        name="$(golden_name "$distro")"
        zpath="$(zvol_path "$name")"
        if ! zfs list "${zpath}@golden" >/dev/null 2>&1; then
            printf "  %-12s ${Y}%-10s${N}\n" "$distro" "MISSING"
            ((skip++))
            continue
        fi

        local vm_name vm_zpath vm_zdev
        vm_name="${PREFIX}-verify-${distro}"
        vm_zpath="$(zvol_path "$vm_name")"
        vm_zdev="$(zvol_dev "$vm_name")"
        virsh destroy "$vm_name" 2>/dev/null || true
        virsh undefine "$vm_name" 2>/dev/null || true
        zfs destroy -Rf "$vm_zpath" 2>/dev/null || true

        zfs clone "${zpath}@golden" "$vm_zpath" 2>/dev/null || {
            printf "  %-12s ${G}%-10s${N} ${R}%-10s${N}\n" "$distro" "OK" "CLONE FAIL"
            ((fail++))
            continue
        }
        local ci_iso
        ci_iso="$(make_cloud_init_iso "$vm_name" "$vm_name")"
        virt-install --name "$vm_name" --ram 2048 --vcpus 2 \
            --os-variant "${OS_VARIANTS[$distro]}" \
            --disk "path=${vm_zdev},bus=virtio" --disk "path=${ci_iso},device=cdrom" \
            --network bridge=virbr0,model=virtio --graphics vnc,listen=0.0.0.0 --video virtio --noautoconsole \
            --channel "unix,target.type=virtio,target.name=org.qemu.guest_agent.0" --import \
            "${VIRT_BOOT_ARGS[@]}" "${VIRT_TPM_ARGS[@]}" \
            >/dev/null 2>&1

        local vm_ip
        vm_ip="$(get_vm_ip "$vm_name")"
        if [[ -z "$vm_ip" ]] || ! wait_for_ssh "$vm_ip" 300; then
            printf "  %-12s ${G}%-10s${N} ${R}%-10s${N}\n" "$distro" "OK" "${vm_ip:-NO IP}"
            ((fail++))
            virsh destroy "$vm_name" 2>/dev/null || true
            virsh undefine "$vm_name" 2>/dev/null || true
            zfs destroy -Rf "$vm_zpath" 2>/dev/null || true
            rm -f "$ci_iso"
            continue
        fi

        _ssh_cmd "$vm_ip" "modprobe zfs 2>/dev/null || true"
        local zfs_loaded
        zfs_loaded="$(_ssh_cmd "$vm_ip" "lsmod | grep -q '^zfs ' && echo YES || echo NO")"
        local zfs_ver
        zfs_ver="$(_ssh_cmd "$vm_ip" "zfs version 2>/dev/null | head -1 | awk '{print \$NF}'" || echo "?")"
        local tests_found
        tests_found="$(_ssh_cmd "$vm_ip" "test -f /usr/share/zfs/zfs-tests.sh && echo YES || echo NO")"

        local zc="$G" tc="$G"
        [[ "$zfs_loaded" != "YES" ]] && zc="$R"
        [[ "$tests_found" != "YES" ]] && tc="$Y"
        printf "  %-12s ${G}%-10s${N} ${G}%-10s${N} ${zc}%-12s${N} ${tc}%-10s${N}\n" "$distro" "OK" "$vm_ip" "$zfs_loaded" "$tests_found"
        [[ "$zfs_loaded" == "YES" ]] && ((pass++)) || ((fail++))

        virsh destroy "$vm_name" 2>/dev/null || true
        virsh undefine "$vm_name" 2>/dev/null || true
        zfs destroy -Rf "$vm_zpath" 2>/dev/null || true
        rm -f "$ci_iso"
    done

    echo ""
    echo -e "  ${G}Pass: ${pass}${N}  ${R}Fail: ${fail}${N}  ${Y}Skip: ${skip}${N}"
    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
}

cmd_destroy() {
    local target="${1:-}"
    local force="${2:-}"
    [[ -n "$target" ]] || die "Usage: klab destroy blue|green|all|goldens [--force]"
    [[ "$target" == "--force" ]] && {
        force="--force"
        target=""
    }
    for a in "$@"; do [[ "$a" == "--force" ]] && force="--force"; done

    # Confirm helper: skip the interactive prompt when stdin isn't a TTY
    # (cron, ssh -T, systemd, `echo | klab destroy ...`) or when --force
    # is passed. Previously this prompt always fired and silently aborted
    # in non-TTY contexts — meaning automation just no-op'd with no error.
    # Detected 2026-05-26 when a destroy-then-redeploy recovery sequence
    # over SSH ran `klab destroy blue` and the script aborted on the
    # missing TTY input, leaving orphan zvols and a broken state.
    _destroy_confirm() {
        local what="$1"
        if [[ "$force" == "--force" ]] || [[ ! -t 0 ]]; then
            echo -e "${R}Destroying ${what}${N} (non-interactive — auto-confirmed)"
            return 0
        fi
        echo -e "${R}Destroying ${what}${N}"
        local confirm
        read -r -p "  Type 'destroy' to confirm: " confirm
        [[ "$confirm" == "destroy" ]] || {
            echo "Aborted."
            return 1
        }
        return 0
    }

    case "$target" in
    blue | green)
        _destroy_confirm "${target} site" || return 0
        destroy_site "$target"
        ;;
    all)
        _destroy_confirm "ALL sites (goldens preserved)" || return 0
        destroy_site "blue"
        destroy_site "green"
        # Also clean test VMs
        for distro in "${DISTROS[@]}"; do
            local name
            name="$(test_vm_name "$distro")"
            virsh destroy "$name" 2>/dev/null || true
            virsh undefine "$name" 2>/dev/null || true
            zfs destroy -Rf "$(zvol_path "$name")" 2>/dev/null || true
        done
        log "All sites destroyed. Goldens preserved."
        ;;
    goldens)
        _destroy_confirm "EVERYTHING (sites + goldens)" || return 0
        destroy_site "blue"
        destroy_site "green"
        for distro in "${DISTROS[@]}"; do
            local name
            name="$(golden_name "$distro")"
            virsh destroy "$name" 2>/dev/null || true
            virsh undefine "$name" --nvram 2>/dev/null || virsh undefine "$name" 2>/dev/null || true
            zfs destroy -Rf "$(zvol_path "$name")" 2>/dev/null || true
            rm -f "${ISO_DIR}/${name}-cloud-init.iso" 2>/dev/null
            local tname
            tname="$(test_vm_name "$distro")"
            virsh destroy "$tname" 2>/dev/null || true
            virsh undefine "$tname" 2>/dev/null || true
            zfs destroy -Rf "$(zvol_path "$tname")" 2>/dev/null || true
        done
        [[ -f "$RHEL_CREDS_FILE" ]] && rm -f "$RHEL_CREDS_FILE"
        log "Everything destroyed."
        ;;
    *) die "Unknown target: ${target}" ;;
    esac
}

# ── Section 11: Interactive Menu ─────────────────────────────────────────

menu_header() {
    clear 2>/dev/null || true
    local gc=0 bc=0 gc2=0
    for d in "${DISTROS[@]}"; do
        golden_exists "$d" && ((gc++))
        virsh domstate "$(site_name blue "$d")" 2>/dev/null | grep -q running && ((bc++))
        virsh domstate "$(site_name green "$d")" 2>/dev/null | grep -q running && ((gc2++))
    done
    echo ""
    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
    echo -e "${W}  klab — Multi-Distro Test Platform${N}"
    echo -e "${D}  ${#DISTROS[@]} distros • ZFS clones • blue-green • eBPF • payloads${N}"
    echo -e "${C}══════════════════════════════════════════════════════════════${N}"
    echo -e "  Goldens: ${G}${gc}/${#DISTROS[@]}${N}  Blue: ${G}${bc}${N}  Green: ${G}${gc2}${N}  GPU: $([[ $NVIDIA_DETECTED -eq 1 ]] && echo "${G}YES${N}" || echo "${D}no${N}")"
    echo ""
}

menu_pick_distro() {
    echo -e "  ${C}── Pick a distro ──${N}"
    local i=1
    for d in "${DISTROS[@]}"; do
        local status=""
        golden_exists "$d" && status="${G}[golden]${N}"
        printf "  ${G}%d${N}  %-12s %b\n" "$i" "$d" "$status"
        ((i++))
    done
    echo -ne "${W}  Select (1-${#DISTROS[@]}): ${N}"
    local choice
    read -r choice
    if [[ "$choice" =~ ^[0-9]+$ ]] && [[ "$choice" -ge 1 ]] && [[ "$choice" -le ${#DISTROS[@]} ]]; then
        PICKED_DISTRO="${DISTROS[$((choice - 1))]}"
        return 0
    fi
    echo -e "${R}  Invalid${N}"
    return 1
}

interactive_menu() {
    local PICKED_DISTRO=""
    while true; do
        menu_header
        echo -e "  ${Y}── Build ──────────────────────────────────────────────────${N}"
        echo -e "  ${G} 1${N}  Build golden — single distro"
        echo -e "  ${G} 2${N}  Build golden — ALL distros"
        echo -e "  ${G} 3${N}  Status"
        echo ""
        echo -e "  ${Y}── Deploy ─────────────────────────────────────────────────${N}"
        echo -e "  ${G} 4${N}  Deploy blue site"
        echo -e "  ${G} 5${N}  Deploy green site"
        echo -e "  ${G} 6${N}  Promote green -> blue"
        echo -e "  ${G} 7${N}  Rollback blue"
        echo ""
        echo -e "  ${Y}── Payloads ───────────────────────────────────────────────${N}"
        echo -e "  ${G} 8${N}  OpenZFS test suite (quick)"
        echo -e "  ${G} 9${N}  OpenZFS test suite (full)"
        echo -e "  ${G}10${N}  Kubernetes cluster"
        echo -e "  ${G}11${N}  Custom playbook"
        echo -e "  ${G}12${N}  Results matrix"
        echo ""
        echo -e "  ${Y}── Observe ────────────────────────────────────────────────${N}"
        echo -e "  ${G}13${N}  Verify goldens (smoke test)"
        echo -e "  ${G}14${N}  View golden build log"
        echo -e "  ${G}15${N}  View master log"
        echo ""
        echo -e "  ${Y}── Cleanup ────────────────────────────────────────────────${N}"
        echo -e "  ${R} 0${N}  Destroy sites (keep goldens)"
        echo -e "  ${R}00${N}  Destroy EVERYTHING"
        echo -e "  ${R} q${N}  Quit"
        echo ""
        echo -ne "${W}  Select: ${N}"

        local choice
        read -r choice
        case "$choice" in
        1)
            menu_header
            menu_pick_distro && {
                cmd_golden "$PICKED_DISTRO"
                pause
            }
            ;;
        2)
            menu_header
            cmd_golden all
            pause
            ;;
        3)
            menu_header
            cmd_status
            pause
            ;;
        4)
            menu_header
            deploy_site blue
            pause
            ;;
        5)
            menu_header
            deploy_site green
            pause
            ;;
        6)
            menu_header
            cmd_promote green
            pause
            ;;
        7)
            menu_header
            cmd_rollback
            pause
            ;;
        8)
            menu_header
            cmd_test --quick
            pause
            ;;
        9)
            menu_header
            cmd_test --full
            pause
            ;;
        10)
            menu_header
            cmd_kubernetes
            pause
            ;;
        11)
            menu_header
            echo -ne "  ${W}Path to playbook: ${N}"
            local pb
            read -r pb
            [[ -n "$pb" ]] && cmd_run_playbook "$pb"
            pause
            ;;
        12)
            menu_header
            cmd_results ""
            pause
            ;;
        13)
            menu_header
            cmd_verify all
            pause
            ;;
        14)
            menu_header
            menu_pick_distro && {
                local _glog="${RESULTS_DIR}/goldens/${PICKED_DISTRO}-latest.log"
                [[ -f "$_glog" ]] && cat "$_glog" || echo -e "  ${Y}No log for ${PICKED_DISTRO}${N}"
                pause
            }
            ;;
        15)
            menu_header
            tail -50 "$MASTER_LOG" 2>/dev/null || echo "  No log yet"
            pause
            ;;
        0)
            menu_header
            cmd_destroy all
            pause
            ;;
        00)
            menu_header
            cmd_destroy goldens
            pause
            ;;
        q | Q) exit 0 ;;
        *)
            echo -e "${R}  Invalid${N}"
            sleep 1
            ;;
        esac
    done
}

# ── Section 12: CLI Dispatch ─────────────────────────────────────────────

usage() {
    cat <<'USAGE'
klab — Multi-Distro Test Platform

Usage:
  klab                                    Interactive menu
  klab golden [distro|all]                Build golden images
  klab golden-desktop [distro...]         GNOME desktop goldens for instant clones
                                          (default: all — one GNOME image per distro)
  klab deploy blue|green                  Deploy site from goldens
  klab promote green                      Promote green to blue
  klab rollback                           Revert blue to previous snapshot
  klab test [--quick|--full] [--distro d] Run OpenZFS test suite
  klab kubernetes [--workers N]           Deploy K8s cluster
  klab run-playbook /path/to/script.sh    Run custom payload on site VMs
  klab verify [distro|all]                Smoke test goldens
  klab status                             Show everything
  klab results [run-id]                   Display test matrix
  klab destroy blue|green|all|goldens     Tear down

Distros: centos rocky fedora debian ubuntu arch rhel

ZFS Version Flags:
  --zfs-version 2.3.0               Build from release tarball
  --zfs-git openzfs/zfs@master       Build from git branch
  --zfs-tarball /path/to/zfs.tar.gz  Build from local tarball

Examples:
  klab golden all                         Build all golden images
  klab deploy blue                        Clone goldens to blue site
  klab test --quick --distro centos,debian Quick ZFS tests on 2 distros
  klab run-playbook ./my-test.sh          Run custom script on all blue VMs
  klab promote green                      Swap green to blue
  klab destroy all                        Tear down sites, keep goldens
USAGE
    exit 0
}

CMD="${1:-}"
[[ -z "$CMD" ]] && {
    interactive_menu
    exit 0
}
shift

# Parse global flags
_args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
    --zfs-version)
        ZFS_SOURCE="version:$2"
        shift 2
        ;;
    --zfs-git)
        ZFS_SOURCE="git:$2"
        shift 2
        ;;
    --zfs-tarball)
        ZFS_SOURCE="tarball:$2"
        shift 2
        ;;
    *)
        _args+=("$1")
        shift
        ;;
    esac
done
set -- "${_args[@]+"${_args[@]}"}"

case "$CMD" in
golden) cmd_golden "${1:-all}" ;;
golden-ztest) cmd_golden_ztest "${1:-all}" ;;
golden-desktop) cmd_golden_desktop "$@" ;;
build-all) cmd_build_all ;;
fetch-rhel-image) cmd_fetch_rhel_image "$@" ;;
deploy) deploy_site "${1:-blue}" ;;
promote) cmd_promote "${1:-green}" ;;
rollback) cmd_rollback ;;
test) cmd_test "$@" ;;
kubernetes) cmd_kubernetes "$@" ;;
run-playbook) cmd_run_playbook "${1:?Usage: klab run-playbook /path/to/script.sh}" "${2:-blue}" ;;
verify) cmd_verify "${1:-all}" ;;
status) cmd_status ;;
results) cmd_results "${1:-}" ;;
destroy) cmd_destroy "${1:-}" ;;
menu) interactive_menu ;;
help | -h | --help) usage ;;
*) usage ;;
esac
