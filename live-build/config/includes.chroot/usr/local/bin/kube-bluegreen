#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# kube-bluegreen — drive the demo's blue/green cutover from one command.
#
# What it does, in order:
#   status    reports which track is live, and whether each track is healthy.
#   preview   sends real traffic to the IDLE track's private address and shows
#             what it returns, without touching production traffic.
#   cutover   gates on the target track being fully Ready, smoke-tests it, then
#             moves the public Service's selector to it and verifies the move.
#   rollback  the same operation aimed at the previously-live track.
#
# Why it exists: blue/green has a reputation for being hard, and the reason is
# almost never the switch itself — it is that the switch is usually a bespoke
# pile of scripts nobody trusts. Here the switch is one label on one Service.
# Everything below it is verification, which is the part that actually earns
# the trust: refusing to cut over to a track that is not Ready, and confirming
# afterwards that the endpoints really moved.
#
# Inputs:  $1 = status|preview|cutover|rollback, $2 = blue|green (where taken)
#          RELEASE (default javaapi-fullstack), NS (default demo),
#          CHART (default /usr/local/share/kldload/demo/charts/javaapi-fullstack)
#          KUBECONFIG (default /root/.kube/config)
# Outputs: human-readable status on stdout. Exit 0 only when the requested
#          transition is verified to have happened.
#
# Notes:
#   - A cutover is refused unless every replica of the target is Ready. The
#     whole value of blue/green is that you look before you leap; a switch that
#     will flip to a broken track is a rolling update with extra steps.
#   - The verification after the flip reads ENDPOINTS, not the Service spec.
#     The spec says what was asked for; the endpoints say what traffic will
#     actually reach, and those disagree exactly when something is wrong.
# ---------------------------------------------------------------------------
set -Eeuo pipefail
trap 'echo "FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

RELEASE="${RELEASE:-javaapi-fullstack}"
NS="${NS:-demo}"
CHART="${CHART:-/usr/local/share/kldload/demo/charts/javaapi-fullstack}"
export KUBECONFIG="${KUBECONFIG:-/root/.kube/config}"

G=$'\033[1;32m' Y=$'\033[1;33m' R=$'\033[1;31m' W=$'\033[1;37m' D=$'\033[2m' N=$'\033[0m'
_say() { printf '%s\n' "$*"; }
_die() {
    printf '%sFATAL:%s %s\n' "$R" "$N" "$*" >&2
    exit 1
}

command -v kubectl >/dev/null || _die "kubectl not found"
command -v helm >/dev/null || _die "helm not found"

# `|| true`: no Service means the demo is not deployed, which the caller reports
# in words; without it the ERR trap fired three times for `status` on a cluster
# that simply had no demo on it (fiend, 2026-09-15).
_active() { kubectl -n "$NS" get svc shop -o jsonpath='{.spec.selector.track}' 2>/dev/null || true; }
_other() { [[ "$1" == "blue" ]] && echo green || echo blue; }

# Ready/desired for one track. Prints "ready/desired"; callers compare them
# rather than trusting a rollout command's exit code.
_track_ready() {
    local t="$1" ready desired
    desired=$(kubectl -n "$NS" get deploy "app-$t" -o jsonpath='{.spec.replicas}' 2>/dev/null || echo 0)
    ready=$(kubectl -n "$NS" get deploy "app-$t" -o jsonpath='{.status.readyReplicas}' 2>/dev/null || echo 0)
    printf '%s/%s' "${ready:-0}" "${desired:-0}"
}

# Count of addresses actually behind a Service. Zero here means traffic is
# black-holing regardless of what the selector claims.
_endpoints() {
    # swallow: grep -c exits 1 when the count is ZERO, which is a real and
    # important answer here (a Service with no endpoints black-holes traffic).
    # Without this the function would abort instead of reporting 0.
    kubectl -n "$NS" get endpointslice -l "kubernetes.io/service-name=$1" \
        -o jsonpath='{range .items[*]}{range .endpoints[*]}{.addresses[0]}{"\n"}{end}{end}' 2>/dev/null |
        grep -c . || true
}

# Curl from inside the cluster: the preview services are ClusterIP, and the
# point of a preview is to exercise the real network path a user would take.
_incluster_get() {
    local url="$1"
    kubectl -n "$NS" run "bg-probe-$RANDOM" --rm -i --restart=Never --quiet \
        --image=busybox:1.36 --command -- wget -q -T8 -O- "$url" 2>/dev/null
}

_status() {
    local live idle
    live="$(_active)"
    [[ -n "$live" ]] || _die "release $RELEASE not found in namespace $NS — deploy it first"
    idle="$(_other "$live")"
    _say ""
    _say "${W}  Blue/green status — ${RELEASE} in ${NS}${N}"
    _say "${D}  ────────────────────────────────────────────────${N}"
    printf '   %sLIVE%s   %-6s  replicas %-8s endpoints %s\n' \
        "$G" "$N" "$live" "$(_track_ready "$live")" "$(_endpoints shop)"
    printf '   %sidle%s   %-6s  replicas %-8s endpoints %s\n' \
        "$Y" "$N" "$idle" "$(_track_ready "$idle")" "$(_endpoints "shop-$idle")"
    local vip
    # swallow: the LoadBalancer has no address until MetalLB assigns one. That
    # is a normal transient state, reported below as <pending>, not an error.
    vip=$(kubectl -n "$NS" get svc web -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null || true)
    _say ""
    _say "   public VIP:  ${W}http://${vip:-<pending>}/${N}"
    _say "   preview:     ${D}kube-bluegreen preview ${idle}${N}"
    _say ""
}

_preview() {
    local t="${1:-}"
    [[ "$t" == blue || "$t" == green ]] || _die "usage: kube-bluegreen preview blue|green"
    local ready
    ready="$(_track_ready "$t")"
    _say "${W}→${N} previewing ${t} (replicas ${ready}) via its private address"
    local out
    # swallow: an unreachable track is the thing being reported, and the
    # empty result is checked on the next line.
    out="$(_incluster_get "http://shop-${t}/api/stats" || true)"
    [[ -n "$out" ]] || _die "${t} returned nothing — it is not serving"
    _say "$out"
}

_cutover() {
    local target="${1:-}"
    [[ "$target" == blue || "$target" == green ]] || _die "usage: kube-bluegreen cutover blue|green"
    local live
    live="$(_active)"
    [[ -n "$live" ]] || _die "release $RELEASE not found in namespace $NS"
    if [[ "$live" == "$target" ]]; then
        _say "${Y}!${N} ${target} is already live — nothing to do"
        return 0
    fi

    # ── Gate ────────────────────────────────────────────────────────────────
    # Refuse to move traffic onto a track that cannot serve it. This is the
    # single most valuable line in the script.
    local rd
    rd="$(_track_ready "$target")"
    local ready="${rd%%/*}" desired="${rd##*/}"
    _say "${W}→${N} pre-flight: ${target} has ${rd} replicas Ready"
    [[ "$desired" != "0" && "$ready" == "$desired" ]] ||
        _die "refusing to cut over: ${target} is ${rd} Ready. Fix it, then retry."

    # ── Smoke-test the target on the real network path ──────────────────────
    _say "${W}→${N} smoke-testing ${target} before sending it production traffic"
    local probe
    # swallow: a failed probe is exactly what must block the cutover, and it
    # is checked immediately below. Aborting here would skip that message.
    probe="$(_incluster_get "http://shop-${target}/readyz" || true)"
    [[ "$probe" == *ready* ]] || _die "refusing to cut over: ${target}/readyz returned '${probe:-nothing}'"
    _say "   ${G}ok${N}  ${target} is Ready and serving"

    # ── Flip ────────────────────────────────────────────────────────────────
    # One value. The entire cutover is this line; everything else is proof.
    _say "${W}→${N} moving the public VIP: ${live} → ${G}${target}${N}"
    local t0 t1
    t0=$(date +%s%N)
    helm upgrade "$RELEASE" "$CHART" -n "$NS" --reuse-values \
        --set "activeTrack=${target}" --wait --timeout 2m >/dev/null ||
        _die "helm upgrade failed — traffic is still on ${live}"
    t1=$(date +%s%N)

    # ── Verify the OUTCOME ──────────────────────────────────────────────────
    # Read what the Service now selects AND how many endpoints back it. helm
    # exiting 0 says the manifest applied, not that traffic moved.
    local now eps
    now="$(_active)"
    eps="$(_endpoints shop)"
    [[ "$now" == "$target" ]] || _die "selector still reads '${now}' after upgrade"
    [[ "${eps:-0}" -gt 0 ]] || _die "public VIP has ZERO endpoints after cutover — traffic is black-holed"
    _say "   ${G}ok${N}  selector=${now}, ${eps} endpoint(s) behind the VIP"
    _say ""
    _say "${G}  Cutover complete in $(((t1 - t0) / 1000000))ms — ${live} → ${target}${N}"
    _say "${D}  Roll back with: kube-bluegreen rollback${N}"
    _say ""
}

_usage() {
    cat <<'HELPTEXT'
kube-bluegreen — blue/green at two levels: one workload, or two whole clusters

USAGE — the workload (two deployment tracks behind one Service)
    kube-bluegreen status              show which track is live and both tracks' health
    kube-bluegreen preview <track>     send real traffic to the idle track, privately
    kube-bluegreen cutover <track>     health-gate, smoke-test, then move the public VIP
    kube-bluegreen rollback            cut back to the previously-live track

USAGE — the cluster (two whole clusters, for a stack change)
    kube-bluegreen cluster status              which cluster is live, health of both
    kube-bluegreen cluster deploy <track> ...  build that track (extra args go to kube-cluster)
    kube-bluegreen cluster promote <track>     point /root/.kube/config at it; refuses unless Ready
    kube-bluegreen cluster destroy <track>     tear it down; refuses if it is the active track

    A CNI cannot be blue/greened — one datapath per cluster — so a Cilium or
    Kubernetes version change is made reversible by running two clusters and
    moving the workload. Each track keeps its own MetalLB pool, so the idle
    one is reachable before promotion; service addresses therefore differ
    between tracks.

ARGUMENTS
    <track>    blue | green

ENVIRONMENT
    RELEASE    helm release name          (default: javaapi-fullstack)
    NS         namespace                  (default: demo)
    CHART      chart path                 (default: /usr/local/share/kldload/demo/charts/javaapi-fullstack)
    KUBECONFIG cluster credentials        (default: /root/.kube/config)

ENVIRONMENT — the cluster tier
    KLDLOAD_BG_BLUE_VIP / KLDLOAD_BG_GREEN_VIP    API server VIP per track
    KLDLOAD_BG_BLUE_POOL / KLDLOAD_BG_GREEN_POOL  MetalLB range per track

    Both tracks share one virbr0, so neither the VIP nor the MetalLB range may
    overlap. Blue defaults to kube-cluster's own addresses (VIP .240, pool
    .200-.220 auto-detected), so a blue track is an ordinary cluster. Green
    moves out of the way: VIP .241, pool .221-.239, on whatever subnet virbr0
    is actually on. Override either only if that slice is already spoken for.

    Both tracks clone the SAME golden image (k8s-golden). Deploying green does
    not rebuild it and does not build klab's five per-distro goldens — those
    belong to klab, not to a cluster cutover. Green costs a clone per node.

EXAMPLES
    kube-bluegreen status
    kube-bluegreen preview green       # check green privately, production untouched
    kube-bluegreen cutover green       # promote green; refused unless it is fully Ready
    kube-bluegreen rollback            # instantly back to blue

EXIT STATUS
    0  the requested transition was verified to have happened
    1  the transition was refused or could not be verified
HELPTEXT
}

# ═══════════════════════════════════════════════════════════════════════════
# CLUSTER TIER -- two whole clusters, not two deployments
# ═══════════════════════════════════════════════════════════════════════════
#
# Everything above this line moves a Service selector between two deployment
# tracks. Everything below moves between two CLUSTERS.
#
# Why the cluster is the right granularity for a stack change: you cannot
# blue/green a CNI. There is one datapath per cluster, Cilium's eBPF programs
# attach to the same hooks and own the same CRDs, and upstream's answer to a
# version change is a rolling in-place upgrade. So the way to make a Cilium
# 1.16 -> 1.20 jump reversible is not two Ciliums, it is two clusters and a
# workload that moves -- which on this substrate costs seconds per node,
# because every node is a ZFS clone of a golden.
#
# Nothing in kube-cluster or kube-init changed to allow this: CLUSTER_NAME,
# KUBE_VIP_ADDRESS, METALLB_POOL and METALLB_POOL_NAME were already variables.
# Two clusters need distinct values, a kubeconfig each, and a record of which
# is live.
#
# Pool mode is SPLIT (operator, 2026-09-20): each track keeps its own MetalLB
# range, so the idle track is reachable and testable before promotion. Service
# addresses therefore differ between tracks -- a client pinned to blue's IP is
# not moved by a promote. Handover, where green takes blue's range at promote
# so the public address survives, is the truer blue/green and is NOT built:
# there is a window where neither track owns the range and that needs a real
# cluster to test.
#
# The helpers here are _cl_ prefixed because the workload tier above already
# owns _active, _other and friends, and a collision would silently give one
# tier the other's answer.
_CL_STATE_DIR=/var/lib/kldload
_CL_TRACK_FILE="${_CL_STATE_DIR}/cluster-track"
_CL_KUBE_DIR=/root/.kube
_CL_TRACKS=(blue green)

# _cl_valid_track <name> — refuse anything that is not a known track. The names
# reach CLUSTER_NAME, which reaches `virsh destroy` and a ZFS dataset regex, so
# this is a safety check and not a nicety (a VM once got created named --help).
_cl_valid_track() {
    local t
    for t in "${_CL_TRACKS[@]}"; do [[ "$1" == "$t" ]] && return 0; done
    return 1
}

_cl_name() { printf 'kldload-%s' "$1"; }
_cl_kubeconfig() { printf '%s/config-%s' "$_CL_KUBE_DIR" "$1"; }

# _cl_active — the live track, or empty when nothing has been promoted yet.
_cl_active() { [[ -r "$_CL_TRACK_FILE" ]] && tr -d '[:space:]' <"$_CL_TRACK_FILE" || true; }

# _cl_exists <track> — does this track have any VMs defined?
_cl_exists() {
    virsh list --all --name 2>/dev/null | grep -q "^$(_cl_name "$1")-" || return 1
}

# _cl_ready <track> — does its API answer, and are all nodes Ready?
#
# Outcome, not exit code: `kubectl get nodes` succeeding says the API is up,
# which is not the same as the cluster being usable. Count NotReady explicitly.
_cl_ready() {
    local kc
    kc="$(_cl_kubeconfig "$1")"
    [[ -r "$kc" ]] || return 1
    local out
    out="$(timeout 30 kubectl --kubeconfig "$kc" get nodes --no-headers 2>/dev/null || true)"
    [[ -n "$out" ]] || return 1
    local total notready
    total="$(printf '%s\n' "$out" | grep -c . || true)"
    notready="$(printf '%s\n' "$out" | awk '$2 != "Ready" {n++} END {print n+0}')"
    ((total > 0 && notready == 0))
}

# ── status ──────────────────────────────────────────────────────────────────
_cl_status_cmd() {
    local act
    act="$(_cl_active)"
    printf '\n  %-8s %-10s %-9s %-7s %s\n' TRACK EXISTS READY ACTIVE KUBECONFIG
    local t
    for t in "${_CL_TRACKS[@]}"; do
        local ex=no rd=no ac=' '
        _cl_exists "$t" && ex=yes
        _cl_ready "$t" && rd=yes
        [[ "$act" == "$t" ]] && ac='<<<'
        printf '  %-8s %-10s %-9s %-7s %s\n' "$t" "$ex" "$rd" "$ac" "$(_cl_kubeconfig "$t")"
    done
    echo
    [[ -n "$act" ]] || _say "no track is active yet — promote one to point /root/.kube/config at it"
}

# ── deploy ──────────────────────────────────────────────────────────────────
#
# Builds a cluster under this track's name. Every value that must differ
# between tracks is passed here; kube-cluster and kube-init already read all of
# them, so nothing in those tools changes.
# _cl_subnet — the first three octets of the libvirt bridge green will live on.
#
# Green's addresses have to be disjoint from blue's, and blue's are DERIVED:
# kube-init auto-detects ${subnet}.200-220 from the control plane's own address.
# Hardcoding 192.168.122 for green would put the two tracks on different
# subnets the moment someone's virbr0 is not the libvirt default — green would
# advertise a range no client on that LAN can reach, and it would look like a
# MetalLB bug rather than a wrong constant.
#
# virbr0 by name because that is the bridge kube-cluster itself arpings against
# when it reserves the VIP; if that assumption is ever wrong it is wrong in both
# tools at once, which is the failure I can actually find. Falls back to the
# libvirt default only when the bridge has no address to read.
# stdout: three octets, no trailing dot (e.g. "192.168.122").
_cl_subnet() {
    local _a
    # The swallow covers exactly one case: virbr0 is absent, where ip(1) writes
    # "Device does not exist" and exits 1. That is this function's FALLBACK
    # path, not an error — but under `set -e` + pipefail it is still a failed
    # pipeline, so without the `|| true` it aborts the caller mid-deploy and
    # fires the ERR trap into the operator's console first. Verified by
    # stubbing ip(1) to exit 1: the trap fired twice before this line existed.
    _a="$(ip -4 -o addr show virbr0 2>/dev/null | awk '{split($4, a, "/"); print a[1]; exit}' || true)"
    if [[ "$_a" =~ ^([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})\.[0-9]{1,3}$ ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
    else
        printf '192.168.122'
    fi
}

_cl_deploy() {
    local track="$1"
    shift
    _cl_valid_track "$track" || _die "unknown track '${track}' (expected: ${_CL_TRACKS[*]})"
    _cl_exists "$track" && _die "${track} already has VMs — destroy it first, or deploy the other track"

    local act
    act="$(_cl_active)"
    [[ "$act" == "$track" ]] && _die "${track} is recorded as ACTIVE but has no VMs — state is inconsistent, fix ${_CL_TRACK_FILE} first"

    # Addresses. Two clusters share one virbr0, so they cannot share one API
    # VIP or one MetalLB range — and neither collision is loud. The VIP is
    # (kube-cluster arpings it and dies), but the MetalLB range is not: both
    # clusters would answer ARP for the same LoadBalancer address and the
    # winner would be whichever replied last.
    #
    # BLUE therefore keeps kube-cluster's own defaults — empty, meaning VIP
    # .240 and the auto-detected ${subnet}.200-220 — so a blue track behaves
    # exactly like any ordinary cluster and nothing about the normal path
    # changes. GREEN is the one that moves out of the way, into a slice that
    # is disjoint from both of blue's. Green is the disposable track; making
    # it carry the deviation keeps the surprise on the side that expects one.
    local vip pool
    case "$track" in
    blue)
        vip="${KLDLOAD_BG_BLUE_VIP:-}"
        pool="${KLDLOAD_BG_BLUE_POOL:-}"
        ;;
    green)
        local _net
        _net="$(_cl_subnet)"
        vip="${KLDLOAD_BG_GREEN_VIP:-${_net}.241}"
        pool="${KLDLOAD_BG_GREEN_POOL:-${_net}.221-${_net}.239}"
        ;;
    esac

    _say "deploying ${track} as $(_cl_name "$track")"
    [[ -n "$vip" ]] && _say "  API VIP:      ${vip}"
    [[ -n "$pool" ]] && _say "  MetalLB pool: ${pool}"

    # kube-cluster does the work. It is the shipped verb and it owns cluster
    # lifecycle; re-implementing any of it here is how a harness ends up
    # reproducing a bug that was fixed in the real tool.
    CLUSTER_NAME="$(_cl_name "$track")" \
    KUBE_VIP_ADDRESS="$vip" \
    METALLB_POOL="$pool" \
    METALLB_POOL_NAME="kldload-${track}-pool" \
        kube-cluster bootstrap "$@" || _die "kube-cluster bootstrap failed for ${track}"

    # kube-cluster writes /root/.kube/config for whichever cluster it just
    # built. Move it to this track's file so the next deploy cannot overwrite
    # the other track's credentials.
    if [[ -r "${_CL_KUBE_DIR}/config" && ! -L "${_CL_KUBE_DIR}/config" ]]; then
        install -m 0600 "${_CL_KUBE_DIR}/config" "$(_cl_kubeconfig "$track")"
        _say "kubeconfig saved: $(_cl_kubeconfig "$track")"
    fi

    _cl_ready "$track" && _say "${track} is Ready" || _say "WARNING: ${track} deployed but not all nodes are Ready yet"
}

# ── promote ─────────────────────────────────────────────────────────────────
_cl_promote() {
    local track="$1"
    _cl_valid_track "$track" || _die "unknown track '${track}'"
    _cl_exists "$track" || _die "${track} has no VMs — deploy it first"

    # Gate on health, not on existence. Promoting a cluster whose nodes are not
    # Ready is how a cutover becomes an outage.
    _cl_ready "$track" || _die "${track} is not Ready — refusing to promote. Check: kubectl --kubeconfig $(_cl_kubeconfig "$track") get nodes"

    local prev
    prev="$(_cl_active)"
    mkdir -p "$_CL_STATE_DIR" "$_CL_KUBE_DIR"
    ln -sfn "$(_cl_kubeconfig "$track")" "${_CL_KUBE_DIR}/config"
    printf '%s\n' "$track" >"$_CL_TRACK_FILE"

    # Outcome, not exit code: the symlink must resolve AND the API it points at
    # must answer, or the operator has a kubeconfig that lies.
    timeout 30 kubectl get nodes >/dev/null 2>&1 ||
        _die "promoted ${track} but the default kubeconfig does not reach it — check ${_CL_KUBE_DIR}/config"

    _say "active track: ${prev:-none} -> ${track}"
    _say "/root/.kube/config now points at $(_cl_kubeconfig "$track")"
    [[ -n "$prev" && "$prev" != "$track" ]] &&
        _say "${prev} is still running and untouched — destroy it when you are happy: kube-bluegreen cluster destroy ${prev}"
    # TODO(handover mode): release the previous track's IPAddressPool and give
    # its range to this one, so the public address survives the cutover. Not
    # implemented: there is a window where neither track owns the range, and
    # that needs testing on a real cluster before it is offered.
}

# ── destroy ─────────────────────────────────────────────────────────────────
_cl_destroy() {
    local track="$1"
    _cl_valid_track "$track" || _die "unknown track '${track}'"
    # Never destroy what is serving. The whole point of the idle track is that
    # it is the thing you are allowed to break.
    [[ "$(_cl_active)" == "$track" ]] &&
        _die "${track} is the ACTIVE track — promote the other one first"
    _cl_exists "$track" || {
        _say "${track} has no VMs; nothing to destroy"
        return 0
    }

    _say "destroying ${track} ($(_cl_name "$track"))"
    # KUBE_CLUSTER_YES=1 because the guard above is the real safety and it is a
    # stronger one than a prompt: kube-cluster asks "are you sure" about a name
    # it cannot reason about, while this refuses outright to touch the track
    # that is serving. Without it kube-cluster exits 2 from any non-interactive
    # caller — the webui button, ssh -c, the sweep — and reports it as
    # "destroy failed", which is a lie about what happened. The golden is kept
    # either way: only DESTROY_ALL=1 removes it, and green clones from it.
    CLUSTER_NAME="$(_cl_name "$track")" KUBE_CLUSTER_YES=1 kube-cluster destroy ||
        _die "kube-cluster destroy failed for ${track}"
    rm -f "$(_cl_kubeconfig "$track")"
    # By exact name, never a pattern: a destroy driven by a wildcard once took
    # six unrelated clones.
    _cl_exists "$track" && _die "${track} still has VMs after destroy — look before re-running"
    _say "${track} destroyed"
}

case "${1:-status}" in
status) _status ;;
preview) _preview "${2:-}" ;;
cutover) _cutover "${2:-}" ;;
cluster)
    # The cluster tier. Its own verbs, so `kube-bluegreen status` keeps
    # meaning the workload and nobody has to guess which tier they are in.
    case "${2:-status}" in
    status) _cl_status_cmd ;;
    deploy)
        [[ -n "${3:-}" ]] || _die "usage: kube-bluegreen cluster deploy <blue|green> [kube-cluster options]"
        _cl_deploy "${@:3}"
        ;;
    promote)
        [[ -n "${3:-}" ]] || _die "usage: kube-bluegreen cluster promote <blue|green>"
        _cl_promote "$3"
        ;;
    destroy)
        [[ -n "${3:-}" ]] || _die "usage: kube-bluegreen cluster destroy <blue|green>"
        _cl_destroy "$3"
        ;;
    *) _die "unknown cluster verb '${2}' (status|deploy|promote|destroy)" ;;
    esac
    ;;
rollback)
    _live="$(_active)"
    [[ -n "$_live" ]] || _die "release $RELEASE not found in namespace $NS"
    _cutover "$(_other "$_live")"
    ;;
-h | --help | help) _usage ;;
*)
    _usage >&2
    exit 1
    ;;
esac
