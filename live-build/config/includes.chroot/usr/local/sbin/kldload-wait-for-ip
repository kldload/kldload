#!/bin/bash
# Block until at least one non-loopback IPv4 is bound, up to 30s.
# Exits 0 whether or not an IP appeared — the caller decides what to do
# (kldload-tls-cert itself is idempotent and runs either way).

set -Eeuo pipefail
trap 'echo "kldload-wait-for-ip: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

# --help answers first, before anything is started or waited on (rule 9;
# found by the sandboxed --help capture, 2026-09-30: this ran instead).
case "${1:-}" in
-h | --help)
    awk 'NR > 1 && /^#/ { p = 1 } p && !/^#/ { exit } p { sub(/^# ?/, ""); print }' "$0"
    exit 0
    ;;
esac

# The addresses are read into a variable and tested there: `... | cut |
# grep -qv` under pipefail can take a SIGPIPE in cut when grep stops early,
# and a 141 reads as "no address" -- thirty seconds of waiting with one bound.
for _ in $(seq 30); do
    addrs="$(ip -4 -o addr show 2>/dev/null | awk '{sub(/\/.*/, "", $4); print $4}')" || addrs=""
    if grep -qv '^127\.' <<<"$addrs"; then
        exit 0
    fi
    sleep 1
done
# Still 0, as the header says, but not in silence: the certificate made next
# will name no LAN address, and this line is where that is explained.
echo "kldload-wait-for-ip: no IPv4 address after 30 s; going on without one" >&2
exit 0
