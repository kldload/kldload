#!/bin/bash
# Block until at least one non-loopback IPv4 is bound, up to 30s.
# Exits 0 whether or not an IP appeared — the caller decides what to do
# (kldload-tls-cert itself is idempotent and runs either way).
for i in $(seq 30); do
    if ip -4 -o addr show 2>/dev/null | awk '{print $4}' | cut -d/ -f1 \
       | grep -qv '^127\.'; then
        exit 0
    fi
    sleep 1
done
exit 0
