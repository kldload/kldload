#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# kldload-netboot-server — turn an installed kldload machine into the netboot
# server for the rest of a rack, entirely offline. Installs AND clones.
#
# WHAT IT DOES (subcommand `serve`, run by kldload-netboot.service):
#   1. finds the retained payload in /var/lib/kldload-netboot — the kernel,
#      initrd and squashfs this machine was installed FROM, kept there by
#      KLDLOAD_KEEP_NETBOOT=1 at install time;
#   2. lays out an HTTP tree (armed/, answers/, golden/, ipxe/, boot.ipxe);
#   3. writes an nginx config (byte ranges on, listing OFF) and a dnsmasq
#      proxyDHCP+TFTP config bound to the LAN interface;
#   4. runs nginx and dnsmasq under systemd.
#
# TWO WAYS TO ARM A TARGET, both writing armed/<mac>.ipxe (the consent token):
#   arm-install <mac> <answers>            — netboot INSTALLS from the mirror.
#   arm-deploy  <mac> --golden <name> --disk D — netboot RECEIVES a golden
#                                            ("clone into existence") over HTTP.
# Both take --netdev <mac2>: <mac> starts the boot, <mac2> carries the root
# image (BOOTIF=01-<mac2>); see _netdev_arg for why fiend needs it.
#
# THE MENU: an armed token is a menu, shown before the kernel or root image is
# fetched. arm-install lists every profile (core server desktop kvm k8s storage
# ai), then -- with more than one NETBOOT_DISTROS -- a distro screen, then a
# security screen (standard, encrypted, Secure Boot, both); the armed choice on
# each is the default after NETBOOT_MENU_TIMEOUT s. Plus a live
# desktop, the local disk and an iPXE shell. See _write_armed_install;
# arm-deploy's menu is _write_armed.
#
# THE ARMING MECHANISM: boot.ipxe probes net0..net3 and CHAINS the first
# armed/<mac>.ipxe it finds. That per-MAC snippet is where install and deploy
# diverge — install carries kldload.seed=, deploy carries kldload.action=deploy
# + kldload.archive-url=. Snippets use ${base}, which boot.ipxe sets, so arming
# does not need to know the serve-time IP. An unarmed NIC 404s and the chain
# falls through to the next, then to the local boot order. That 404 IS the
# consent model: no token, no touch.
#
# HTTP ALL THE WAY, NO KEYS: a clone pulls its golden as a `zfs send` stream
# over the same nginx (kldload-restore-machine --archive-url), so a netbooted
# target needs no ssh identity and the server needs no delegation. That is the
# whole reason the golden transport is HTTP and not ssh.
#
# SUBCOMMANDS: serve | arm-install <mac> <answers> [--netdev M] | arm-all <dir> [--dry-run]
#              | arm-deploy <mac> --golden N --disk D [--hostname H] [--netdev M]
#              | golden <dataset> [as <name>] | disarm <mac> | disarm-all | status
#
# Inputs : /var/lib/kldload-netboot/{vmlinuz,initrd.img,squashfs.img}
#          iPXE images: /usr/share/ipxe (Fedora, ipxe-bootimgs-x86) or
#          /usr/lib/ipxe (Debian/Ubuntu, ipxe) — staged as ipxe.efi/undionly.kpxe
# Outputs: an HTTP+TFTP+proxyDHCP service on the LAN interface. proxyDHCP, so it
#          answers PXE beside the network's DHCP and never hands out addresses.
# Exit   : 0 ok · 1 a step failed · 2 usage.
#
# Notes:
#   - The NIC that netboots is not always net0 (fiend, 2026-09-11): boot.ipxe
#     probes every interface rather than assuming net0.
#   - answers/ holds KLDLOAD_PASSWORD in clear and is served unauth to the LAN;
#     autoindex is off so it cannot be listed, and arm-install warns.
# ─────────────────────────────────────────────────────────────────────────────
set -Eeuo pipefail
trap 'echo "FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

# PAYLOAD is where the kernel, initrd and squashfs this box was installed FROM
# were retained. Overridable because the BUILD host has the same three files
# already, sitting in its own output tree, and the long-term provisioning server
# is more likely to be the always-on machine that builds the ISOs than a test
# box that is meant to be reinstalled repeatedly. One tool, one code path, two
# sources.
#
# NOT /var/lib/kldload/netboot: rpool/kldload/state mounts at /var/lib/kldload
# and would shadow the payload written during the install (fiend, 2026-09-11 --
# 5.1G written, invisible after reboot).
# The unit reads /etc/kldload/netboot.env through EnvironmentFile=; a command run
# by hand did not, so `kldload-netboot-server status` on onyx reported the default
# payload (built 09-06) while the service was serving the one the file names
# (2026-09-13). Loaded here with the unit's precedence: a variable already in the
# environment wins. Parsed, never sourced — only NETBOOT_* KEY=VALUE lines.
if [[ -r /etc/kldload/netboot.env ]]; then
    while IFS= read -r _nl || [[ -n "$_nl" ]]; do
        [[ "$_nl" =~ ^[[:space:]]*(NETBOOT_[A-Z_]+)=(.*)$ ]] || continue
        _nk="${BASH_REMATCH[1]}" _nv="${BASH_REMATCH[2]}"
        [[ "$_nv" =~ ^\"(.*)\"$ || "$_nv" =~ ^\'(.*)\'$ ]] && _nv="${BASH_REMATCH[1]}"
        [[ -n "${!_nk+set}" ]] || export "$_nk=$_nv"
    done </etc/kldload/netboot.env
fi
PAYLOAD="${NETBOOT_PAYLOAD:-/var/lib/kldload-netboot}"
ROOT="${NETBOOT_ROOT:-/var/lib/kldload/netboot-serve}"

# Overridable, because the defaults encode a guess about somebody else's
# network. The unit reads /etc/kldload/netboot.env, so these persist without
# editing a shipped script.
#
#   NETBOOT_PORT   the HTTP port. 8080 collides more often than it looks: an
#                  Open WebUI on the same box already owns 127.0.0.1:8080 here,
#                  and nginx only escapes it by binding the LAN address.
#   NETBOOT_IFACE  the interface to serve on. WITHOUT this, the server follows
#                  the DEFAULT ROUTE, which is wrong for the layout most people
#                  actually want: a dedicated provisioning NIC on an isolated
#                  segment has no default route, so the server would bind the
#                  production side instead and answer PXE where nobody asked.
PORT="${NETBOOT_PORT:-8080}"
IFACE="${NETBOOT_IFACE:-}"

#   NETBOOT_DHCP   proxy (default) or standalone.
#
#     proxy      answers PXE beside an existing DHCP server and hands out NO
#                addresses. Right on an office LAN where pfSense or similar
#                already owns addressing.
#     standalone BE the DHCP server: hand out addresses AND boot options, so a
#                kldload box provisions a rack with nothing else on the wire.
#                This is the air-gapped case the whole darksite payload exists
#                for -- a proxy that needs somebody else's DHCP is not
#                self-contained, it is a plugin for their network.
#
#   NETBOOT_DHCP_RANGE  dnsmasq dhcp-range for standalone, e.g.
#                       10.99.0.100,10.99.0.200,255.255.255.0,12h. Derived from
#                       the interface's own /24 when unset; any other prefix
#                       must be stated, because guessing a pool on somebody's
#                       network is how you hand an address to a machine that
#                       already had one.
DHCP_MODE="${NETBOOT_DHCP:-proxy}"
# Seconds the armed menu waits before taking the armed action. 0 = no menu:
# straight to the action, as before the menu existed. NOT passed to iPXE as 0,
# because iPXE reads `choose --timeout 0` as "wait forever", and an unattended
# matrix run would sit at the menu until someone noticed.
MENU_TIMEOUT="${NETBOOT_MENU_TIMEOUT:-10}"
# Distros the install menu offers. VERIFIED ONLY (operator, 2026-09-18): a
# distro goes in when its matrix edition has passed on this payload, not
# because the ISO happens to carry a mirror for it. One entry = no distro
# screen; the armed distro is always offered even if it is not listed.
NB_DISTROS="${NETBOOT_DISTROS:-fedora}"
DHCP_RANGE="${NETBOOT_DHCP_RANGE:-}"

# Kernel args every entry shares — the ISO's own hard-won line (selinux=0 or
# the live system dies with "Failed to allocate manager object", plus the USB
# blacklists and overlay size), followed by the netboot additions.
#
# fbcon=nodefer: the initramfs install show (dracut module 95kldload-show) draws
# on tty1 while the root image downloads. Fedora's kernel defers the framebuffer
# console's takeover until the KERNEL prints something, and under `quiet` it never
# does, so tty1 stays bound to the dummy console and nothing written to it reaches
# the screen. Found in a UEFI qemu on 2026-09-13: the show ran, painted every
# second, and the screen kept the firmware logo for the whole download. nodefer
# only changes WHEN fbcon takes the screen, never whether.
ISO_ARGS='rd.live.image rd.live.overlay.size=10240 lockdown=none module.sig_enforce=0 selinux=0 rootdelay=30 rd.retry=120 modprobe.blacklist=uas usbcore.autosuspend=-1 ip=dhcp rd.neednet=1 console=tty0 fbcon=nodefer'

# Args for an UNATTENDED install specifically: no desktop, just the show.
#
# systemd.unit=multi-user.target so GDM and GNOME are never started in the
# first place, and kldload.kiosk=1 so kldload-install-kiosk.service takes tty1
# with cage and one full-screen Chrome on the install show. The kiosk unit also
# infers itself from kldload.seed= being present, so the flag here is
# belt-and-braces — but it is the line an operator reads when they want to know
# why this boot has no desktop, so it is spelled out rather than implied.
#
# WHY: gnome-shell was 530 MB and 326-407% CPU on fiend during an install
# (2026-09-12) to host a page with nothing to click on. Escape hatch:
# kldload.kiosk=0 anywhere on the line wins and gives back the full desktop.
#
# Install only, not deploy: a golden restore would benefit the same way, but it
# drives a different tool and publishes no progress, so it keeps the desktop
# until that is wired up.
#
# quiet loglevel=3 systemd.show_status=false rd.udev.log_level=3: an unattended
# install has nobody reading boot messages, and every one printed lands on top of
# the initramfs show. The messages still reach the journal; kldload.kiosk=0 or
# removing these from the armed snippet gives a verbose boot back.
KIOSK_ARGS='kldload.kiosk=1 systemd.unit=multi-user.target quiet loglevel=3 systemd.show_status=false rd.udev.log_level=3'

log() { printf '[kldload-netboot] %s\n' "$*" >&2; }
die() {
    printf '[kldload-netboot] FATAL: %s\n' "$*" >&2
    exit 1
}

# _lan_ip — the address to serve on. With NETBOOT_IFACE set it is that
# interface's first global IPv4; otherwise it follows the default route, which
# is only right when the provisioning LAN and the default route are the same
# wire. Empty output means the caller must die: cmd_serve does.
_lan_ip() {
    if [[ -n "$IFACE" ]]; then
        ip -o -4 addr show dev "$IFACE" scope global 2>/dev/null |
            awk '{sub(/\/.*/, "", $4); print $4; exit}'
        return 0
    fi
    ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1
}

_lan_iface() {
    if [[ -n "$IFACE" ]]; then
        printf '%s' "$IFACE"
        return 0
    fi
    local ip
    ip="$(_lan_ip)"
    ip -o -4 addr show 2>/dev/null | awk -v i="$ip" '$4 ~ "^"i"/" {print $2; exit}'
}

# _mac_norm <mac> — the aa-bb-… form iPXE emits with ${mac:hexhyp}, no suffix.
_mac_norm() {
    local m="${1//:/-}"
    m="${m,,}"
    [[ "$m" =~ ^([0-9a-f]{2}-){5}[0-9a-f]{2}$ ]] || die "not a MAC address: $1"
    printf '%s' "$m"
}

# _netdev_arg <mac> — the kernel argument that pins the initrd's network to ONE
# NIC: " BOOTIF=01-aa-bb-…" (leading space, so it appends to a boot line), or
# nothing for an empty argument.
#
# WHY: the NIC that PXE-boots and the NIC that should carry the 15 GB root image
# are not always the same. fiend's X540 10G card has only a legacy-BIOS PXE ROM
# (Intel Boot Agent XE 2.3.46, no UEFI image), so under UEFI only the onboard 1G
# Realtek can start the boot (2026-09-18). ISO_ARGS says ip=dhcp, which
# NetworkManager's initrd generator turns into ONE connection with
# multi-connect=3 on every ethernet: both NICs lease on the same /24 and the
# root image rides whichever route wins. BOOTIF binds that connection to one
# MAC (mac-address= in the generated profile; checked by running the payload
# initrd's own nm-initrd-generator, 2026-09-18). ifname=<name>:<mac> was the
# alternative and was rejected: it RENAMES the NIC, and the live system and the
# installer then see an interface name nothing else expects.
#
# Callers validate the MAC with _mac_norm BEFORE writing anything; this checks
# again and fails rather than print, because a substitution inside printf's
# arguments is masked by printf's own success -- a bad --netdev printed FATAL
# and still armed the machine, exit 0 (caught under test, 2026-09-18).
_netdev_arg() {
    [[ -n "${1:-}" ]] || return 0
    local m
    m="$(_mac_norm "$1")" || return 1
    printf ' BOOTIF=01-%s' "$m"
}

# _answers_netdev <answers-file> — KLDLOAD_NETBOOT_NETDEV from an answers file,
# quotes stripped, last one wins; empty when unset. This is how arm-all and the
# CI runner, which arm from files alone, pin a machine's download NIC.
_answers_netdev() {
    sed -n 's/^KLDLOAD_NETBOOT_NETDEV=//p' "$1" | tail -1 | tr -d "\"'"
}

# _derive_range <ip> <iface> — a pool in the interface's own subnet, upper half
# so a statically addressed server or gateway at the bottom is never handed out.
# /24 ONLY. Anything else returns empty and the caller demands an explicit
# range: a wrong pool on a live network is worse than a refusal to start.
_derive_range() {
    local ip="$1" iface="$2" prefix
    prefix="$(ip -o -4 addr show dev "$iface" scope global 2>/dev/null |
        awk '{split($4, a, "/"); print a[2]; exit}')"
    [[ "$prefix" == "24" ]] || return 0
    printf '%s.100,%s.200,255.255.255.0,12h' "${ip%.*}" "${ip%.*}"
}

# _has_default_route <iface> — is this the production side? Standing up a DHCP
# server on the interface that carries the default route is how a lab takes an
# office offline, so standalone refuses it unless it is forced.
_has_default_route() {
    ip -4 route show default 2>/dev/null | grep -qw "dev $1"
}

# ── serve ────────────────────────────────────────────────────────────────────
cmd_serve() {
    [[ -s "$PAYLOAD/vmlinuz" && -s "$PAYLOAD/initrd.img" && -s "$PAYLOAD/squashfs.img" ]] ||
        die "no retained payload in $PAYLOAD — install with KLDLOAD_KEEP_NETBOOT=1 first"
    [[ "$(head -c 4 "$PAYLOAD/squashfs.img")" == "hsqs" ]] ||
        die "$PAYLOAD/squashfs.img is not a squashfs (bad magic) — refusing to serve a brick"

    # Can this initrd actually netboot? The snippets say root=live:http://...,
    # which only dracut's "livenet" module understands. An initrd without it
    # loads, has no way to fetch a rootfs, brings up no network, and sits there
    # -- so nothing reaches this server and the target is indistinguishable
    # from one that never booted.
    #
    # deploy.sh's pxe-serve has refused this since 2026-09-09. THIS server did
    # not, because they were two implementations of one idea, and the lesson
    # only landed in one of them. onyx, 2026-09-12: a payload lifted off a USB
    # key built six days before the livenet fix was staged here and fiend hung
    # on it twice while three different theories about the Realtek NIC got
    # chased. The check is one grep.
    #
    # grep -c, not grep -q, and the count captured rather than tested inside the
    # pipeline: grep -q exits on first match, lsinitrd dies of SIGPIPE with 141,
    # and under pipefail the pipeline reports THAT -- which rejected an initrd
    # that genuinely had livenet. A gate with a false positive is worse than no
    # gate, because it blocks the good case and teaches you to bypass it.
    # command -v, not a have() helper: this tool has never defined one. I
    # borrowed it from kldload-hba, where it exists, and the check silently took
    # the else branch (2026-09-12).
    if command -v lsinitrd >/dev/null 2>&1; then
        local _livenet
        _livenet="$(lsinitrd "$PAYLOAD/initrd.img" 2>/dev/null | grep -c 'livenet' || true)"
        [[ "${_livenet:-0}" -gt 0 ]] ||
            die "$PAYLOAD/initrd.img has no dracut 'livenet' module, so it CANNOT fetch root=live:http://... . A target would load the kernel and then hang with no network and no message. Rebuild the ISO, or point NETBOOT_PAYLOAD at an initrd that has it."
        log "initrd   livenet present (${_livenet} entries): it can fetch the rootfs over HTTP"
    else
        log "WARN: lsinitrd is missing, so this initrd's netboot capability WAS NOT CHECKED"
    fi

    local ip iface
    # A named interface that does not exist is an operator typo, and the
    # failure it causes further down (nginx binding nothing, dnsmasq silent) is
    # miles from the cause. Name it here.
    if [[ -n "$IFACE" ]]; then
        [[ -e "/sys/class/net/$IFACE" ]] ||
            die "NETBOOT_IFACE=$IFACE is not an interface on this host"
    fi
    ip="$(_lan_ip)" || true
    [[ -n "$ip" ]] || die "could not determine an address to serve on${IFACE:+ for NETBOOT_IFACE=$IFACE}"
    iface="$(_lan_iface)"
    [[ -n "$iface" ]] || die "could not match $ip to an interface"

    case "$DHCP_MODE" in
    proxy) ;;
    standalone)
        # Never guessed. In standalone the server decides who gets an address,
        # and picking that interface by default route is exactly wrong.
        [[ -n "$IFACE" ]] ||
            die "NETBOOT_DHCP=standalone requires NETBOOT_IFACE — it hands out addresses, so it will not guess which wire"
        if _has_default_route "$iface" && [[ "${NETBOOT_DHCP_FORCE:-0}" != 1 ]]; then
            die "refusing to run a DHCP server on $iface: it carries the default route, so it is almost certainly the site LAN. Use a provisioning NIC, or set NETBOOT_DHCP_FORCE=1 if you mean it"
        fi
        [[ -n "$DHCP_RANGE" ]] || DHCP_RANGE="$(_derive_range "$ip" "$iface")"
        [[ -n "$DHCP_RANGE" ]] ||
            die "could not derive a pool for $ip on $iface (only a /24 is derived) — set NETBOOT_DHCP_RANGE"
        ;;
    *) die "NETBOOT_DHCP must be proxy or standalone, not '$DHCP_MODE'" ;;
    esac
    local base="http://${ip}:${PORT}"

    log "payload  $PAYLOAD ($(numfmt --to=iec "$(stat -c%s "$PAYLOAD/squashfs.img")") rootfs, version $(cat "$PAYLOAD/VERSION" 2>/dev/null || echo '?'))"
    log "serving  $base on $iface${IFACE:+ (NETBOOT_IFACE)}"
    if [[ "$DHCP_MODE" == standalone ]]; then
        log "dhcp     STANDALONE — this server hands out addresses: $DHCP_RANGE"
    else
        log "dhcp     proxy — hands out no addresses; the site DHCP server still does that"
    fi
    # Said every time, because the failure it causes looks like a dead network:
    # the target gets an address, fetches nothing, and reports a security
    # violation or just falls through to the next boot device.
    log "WARN: ipxe.efi is UNSIGNED — a target with Secure Boot ENABLED will refuse it."
    log "      Turn Secure Boot off on the target, or enrol iPXE's key, before blaming the network."
    log "NOTE: x86 only (BIOS + UEFI). arm64 targets are not offered a boot file."
    # proxyDHCP shares the wire with whatever already runs DHCP, and two
    # sources of boot options is a coin flip, not a configuration.
    log "NOTE: proxyDHCP hands out NO addresses. If the site DHCP server also sets"
    log "      next-server/bootfile, disable those there or the target gets two answers."

    install -d -m 0755 "$ROOT/kldload" "$ROOT/answers" "$ROOT/armed" "$ROOT/golden" "$ROOT/ipxe" "$ROOT/tmp"
    local f _mode
    for f in vmlinuz initrd.img squashfs.img; do
        ln -f "$PAYLOAD/$f" "$ROOT/kldload/$f" 2>/dev/null ||
            ln -sf "$PAYLOAD/$f" "$ROOT/kldload/$f"
        # nginx runs UNPRIVILEGED. A payload file root can read and the worker
        # cannot is an HTTP 403, and iPXE prints that as "Operation not
        # permitted" with no mention of permissions -- which reads exactly like
        # a network fault and sends you hunting NIC drivers.
        #
        # onyx, 2026-09-12: a payload taken off the ISO arrived with vmlinuz
        # 0755 and initrd.img 0600, so the kernel loaded and the initrd 403'd.
        # The installer happens to write 0644, which is why this never showed
        # up serving a retained payload.
        chmod a+r "$PAYLOAD/$f" 2>/dev/null || true # read-only source is fine if it is already a+r
        _mode="$(stat -Lc%a "$ROOT/kldload/$f" 2>/dev/null || echo 000)"
        (((8#$_mode & 8#004) != 0)) ||
            die "$ROOT/kldload/$f is mode $_mode — the web server runs unprivileged and cannot read it; iPXE would report the 403 as 'Operation not permitted'"
    done

    _stage_ipxe

    _write_boot_ipxe "$base"
    _write_nginx "$ip"
    _write_dnsmasq "$iface" "$ip" "$base"

    log "starting nginx + dnsmasq"
    nginx -c "$ROOT/nginx.conf"
    trap 'nginx -c "$ROOT/nginx.conf" -s quit 2>/dev/null || true' EXIT
    exec dnsmasq --conf-file="$ROOT/dnsmasq.conf" --no-daemon
}

# _stage_ipxe — put the iPXE boot images the TFTP root hands out under
# $ROOT/ipxe with FIXED names, whatever the distro called them. Fedora ships
# ipxe-x86_64.efi under /usr/share/ipxe (ipxe-bootimgs-x86); Debian ships
# ipxe.efi under /usr/lib/ipxe (ipxe). dnsmasq.conf below names ipxe.efi and
# undionly.kpxe, so the copy normalises rather than the config guessing.
# UEFI is mandatory (every board on the rack); BIOS is a warning, because a
# missing undionly.kpxe costs only legacy boxes and says so.
#
# /usr/share/kldload-netboot comes FIRST: build-iso.sh compiles an upstream
# ipxe.efi there because Fedora's has no console/colour commands, and the menu
# drawn by _write_armed needs them. menu.png, the picture it draws on, ships in
# the same directory. Either one missing still serves -- the armed script
# falls back to plain text -- but says so, because an unstyled menu is the
# thing that was called "terrible" on fiend (2026-09-18).
# IPXE_DIRS is overridable so the function can be exercised on a fake tree.
_stage_ipxe() {
    local d uefi="" bios="" png=""
    for d in ${IPXE_DIRS:-/usr/share/kldload-netboot /usr/share/ipxe /usr/lib/ipxe}; do
        [[ -z "$png" && -s "$d/menu.png" ]] && png="$d/menu.png"
        [[ -z "$uefi" && -f "$d/ipxe-x86_64.efi" ]] && uefi="$d/ipxe-x86_64.efi"
        [[ -z "$uefi" && -f "$d/ipxe.efi" ]] && uefi="$d/ipxe.efi"
        [[ -z "$bios" && -f "$d/undionly.kpxe" ]] && bios="$d/undionly.kpxe"
    done
    [[ -n "$uefi" ]] || die "no UEFI iPXE image in ${IPXE_DIRS:-/usr/share/ipxe /usr/lib/ipxe} — install ipxe-bootimgs-x86 (Fedora) / ipxe (Debian)"
    cp -f "$uefi" "$ROOT/ipxe/ipxe.efi"
    [[ -s "$ROOT/ipxe/ipxe.efi" ]] || die "ipxe.efi did not land in $ROOT/ipxe"
    if [[ -n "$bios" ]]; then
        cp -f "$bios" "$ROOT/ipxe/undionly.kpxe"
    else
        log "WARN: no undionly.kpxe found — legacy-BIOS machines cannot netboot from here (UEFI is fine)"
    fi
    log "ipxe     UEFI $(basename "$uefi") from $(dirname "$uefi")${bios:+, BIOS undionly.kpxe}"
    [[ "$uefi" == */kldload-netboot/* ]] ||
        log "WARN: serving the distro's iPXE, which has no colour support — armed machines get a plain-text menu"
    if [[ -n "$png" ]]; then
        cp -f "$png" "$ROOT/ipxe/menu.png"
        [[ -s "$ROOT/ipxe/menu.png" ]] || die "menu.png did not land in $ROOT/ipxe"
    else
        rm -f "$ROOT/ipxe/menu.png"
        log "WARN: no menu.png found — armed machines get a plain-text menu"
    fi
}

# boot.ipxe: probe every NIC and CHAIN the first armed/<mac>.ipxe; an armed
# script that returns (the menu's local-disk choice) ends the probe. The chained
# snippet inherits ${base} set here, so arming needs no serve-time IP. net0 is
# not always the boot NIC (fiend 2026-09-11), which is why every interface is
# tried.
#
# EXPLICIT LABELS, not a chain of && / ||: iPXE does not short-circuit those
# across lines the way a shell does. The first cut of this chained them and on
# fiend it probed interfaces that do not exist -- ${net2/mac:hexhyp} expands
# EMPTY, giving /armed/.ipxe, a 404, and an ipxe.org error at the console.
# Each failure is routed by goto and nothing depends on operator precedence.
_write_boot_ipxe() {
    local base="$1"
    cat >"$ROOT/boot.ipxe" <<IPXE
#!ipxe
# Generated by kldload-netboot-server. Edit the tree, not this file.
set base ${base}
isset \${net0/mac} || goto try1
chain \${base}/armed/\${net0/mac:hexhyp}.ipxe && goto chosen || goto try1
:try1
isset \${net1/mac} || goto try2
chain \${base}/armed/\${net1/mac:hexhyp}.ipxe && goto chosen || goto try2
:try2
isset \${net2/mac} || goto try3
chain \${base}/armed/\${net2/mac:hexhyp}.ipxe && goto chosen || goto try3
:try3
isset \${net3/mac} || goto notarmed
chain \${base}/armed/\${net3/mac:hexhyp}.ipxe && goto chosen || goto notarmed
goto notarmed

:notarmed
echo kldload: no interface of this machine is armed — continuing boot order
exit

# An armed menu returns here only when "Boot from local disk" was chosen (or
# Esc): its script exited 0. Without this the chain fell through to the next
# NIC, printed "no interface of this machine is armed" under the menu's own
# message, and would have shown a second armed NIC's menu (qemu, 2026-09-18).
:chosen
exit
IPXE
    [[ -s "$ROOT/boot.ipxe" ]] || die "boot.ipxe did not land"
}

_write_nginx() {
    local ip="$1"
    cat >"$ROOT/nginx.conf" <<NGINX
# kldload netboot tree — generated by kldload-netboot-server.
worker_processes 1;
error_log $ROOT/nginx-error.log warn;
pid $ROOT/nginx.pid;
events { worker_connections 256; }
http {
    default_type application/octet-stream;
    access_log $ROOT/nginx-access.log;
    sendfile on;
    send_timeout 300s;
    # Pin runtime dirs into the tree; /var/lib/nginx is not writable for a
    # non-package instance.
    client_body_temp_path $ROOT/tmp/body;
    proxy_temp_path $ROOT/tmp/proxy;
    fastcgi_temp_path $ROOT/tmp/fastcgi;
    uwsgi_temp_path $ROOT/tmp/uwsgi;
    scgi_temp_path $ROOT/tmp/scgi;
    server {
        listen ${ip}:${PORT};
        root $ROOT;
        autoindex off;
    }
}
NGINX
    nginx -t -c "$ROOT/nginx.conf" >/dev/null 2>&1 ||
        die "generated nginx.conf failed nginx -t"
}

_write_dnsmasq() {
    local iface="$1" ip="$2" base="$3" range_line
    if [[ "$DHCP_MODE" == standalone ]]; then
        # A real pool. No router and no DNS option on purpose: a provisioning
        # segment has no gateway, the installer needs nothing but this server,
        # and advertising a route that does not exist is how an install hangs
        # reaching for a mirror it was never going to find.
        range_line="dhcp-range=${DHCP_RANGE}
dhcp-authoritative"
    else
        range_line="dhcp-range=${ip},proxy"
    fi
    cat >"$ROOT/dnsmasq.conf" <<DNS
# kldload netboot — ${DHCP_MODE}. proxy hands out NO addresses; standalone IS
# the DHCP server for this wire.
port=0
log-facility=$ROOT/dnsmasq.log
interface=${iface}
bind-interfaces
enable-tftp
tftp-root=$ROOT/ipxe
${range_line}
dhcp-match=set:ipxe,175
pxe-service=tag:!ipxe,x86PC,"kldload netboot (BIOS)",undionly.kpxe
pxe-service=tag:!ipxe,x86-64_EFI,"kldload netboot (UEFI)",ipxe.efi
pxe-service=tag:!ipxe,BC_EFI,"kldload netboot (UEFI)",ipxe.efi
dhcp-boot=tag:ipxe,${base}/boot.ipxe
DNS
    dnsmasq --test --conf-file="$ROOT/dnsmasq.conf" >/dev/null 2>&1 ||
        die "generated dnsmasq.conf failed dnsmasq --test"
}

# k_audit <text...> — a durable record of who armed or disarmed what.
#
# Arming a MAC authorises a destructive reinstall of that machine, and until
# 2026-09-12 it left no trace anywhere: the tool runs as a separate process, so
# its output goes to whichever terminal invoked it and never to the journal.
# fiend was found armed an hour after a disarm that had reported success, and
# there was nothing to audit -- no record of the arm, no record of who or what
# did it. A consent token nobody can account for is not consent.
#
# logger, so it lands in the journal alongside the service's own output and
# survives the terminal that ran it.
k_audit() {
    logger -t kldload-netboot -p daemon.notice -- "$*" 2>/dev/null || true # no journald in a container
}

# ── arm-install ──────────────────────────────────────────────────────────────
# Writes the seed the installer fetches AND a snippet whose kernel line points
# at it. Same install as before, expressed as a per-MAC snippet.
# _check_answers <file> — the refusals an answers file must pass before it is
# served to a machine that will wipe its disk on it. Prints the reason and
# returns 1; never exits, so arm-all can report every bad file in one pass
# instead of stopping at the first. arm-install and arm-all share it: one list
# of refusals, not two that drift.
# _answers_lib — path of the installer's own answers loader, or nothing.
# The installed tool looks where a kldload system keeps it; a repo checkout finds
# it beside itself (usr/local/sbin -> usr/lib/kldload-installer/lib).
_answers_lib() {
    local here c
    here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
    for c in "${KLDLOAD_ANSWERS_LIB:-}" /usr/lib/kldload-installer/lib/answers.sh \
        "${here}/../../lib/kldload-installer/lib/answers.sh"; do
        [[ -n "$c" && -r "$c" ]] && {
            printf '%s\n' "$c"
            return 0
        }
    done
    return 1
}

# _check_answers <file> — refuse a file the installer would refuse or misread.
#
# Loads it with the INSTALLER'S loader (k_answers_load_env_file) in a subshell and
# checks the values that loader produces, instead of `bash -n`. HISTORY 2026-09-13:
# `bash -n` passed the shipped TEMPLATE.env, which the loader rejects at its first
# indented comment, so arm-install armed a machine that could not install; and the
# CHANGE-ME test was a grep for the unquoted spelling, so "CHANGE-ME" in quotes got
# through while the loader strips the quotes and installs with it.
_check_answers() {
    local answers="$1" lib out
    [[ -f "$answers" ]] || {
        log "no such answers file: $answers"
        return 1
    }
    if ! lib="$(_answers_lib)"; then
        log "WARN: the installer's answers loader (answers.sh) is not on this host —"
        log "      $answers was NOT checked the way the installer will read it."
        log "      Install it at /usr/lib/kldload-installer/lib/answers.sh or set KLDLOAD_ANSWERS_LIB."
        bash -n "$answers" 2>/dev/null || {
            log "$answers is not valid shell"
            return 1
        }
        grep -qE '^KLDLOAD_DISTRO=.' "$answers" || {
            log "$answers sets no KLDLOAD_DISTRO"
            return 1
        }
        return 0
    fi
    # stdout of the subshell is the verdict; the loader's k_die message comes back on it.
    out="$(
        k_die() {
            printf 'REFUSED: %s\n' "$*"
            exit 1
        }
        # shellcheck source=/dev/null
        source "$lib"
        k_answers_load_env_file "$answers"
        [[ -n "${KLDLOAD_DISTRO:-}" ]] || {
            echo "REFUSED: sets no KLDLOAD_DISTRO"
            exit 1
        }
        [[ -n "${KLDLOAD_PROFILE:-}" ]] || {
            echo "REFUSED: sets no KLDLOAD_PROFILE"
            exit 1
        }
        for v in KLDLOAD_PASSWORD KLDLOAD_ZFS_PASSPHRASE KLDLOAD_DISK; do
            [[ "${!v:-}" == *CHANGE-ME* ]] && {
                echo "REFUSED: ${v} still holds the CHANGE-ME placeholder"
                exit 1
            }
        done
        if [[ "${KLDLOAD_ZFS_ENCRYPT:-0}" == 1 && -z "${KLDLOAD_ZFS_PASSPHRASE:-}" ]]; then
            echo "REFUSED: KLDLOAD_ZFS_ENCRYPT=1 needs KLDLOAD_ZFS_PASSPHRASE"
            exit 1
        fi
        echo "OK ${KLDLOAD_DISTRO}/${KLDLOAD_PROFILE}"
    )" || {
        log "$answers: ${out#REFUSED: }"
        return 1
    }
    return 0
}

# _write_armed <m> <mac> <action> <hint> <kernel-args> <netarg> <netdev> <host>
#
# The per-MAC token: an iPXE menu with the armed action as its default, a live
# desktop, the local disk and an iPXE shell. It runs BEFORE anything large is
# fetched -- iPXE has pulled only its own 1 MB here; the kernel and initrd come
# after a choice, and the root image after the kernel boots -- so a machine
# netbooted by mistake can be sent to its disk without costing 15 GB.
#
# WHY each piece:
#   - the default is the ARMED action and the timeout always fires, so the
#     matrix and CI runs, which nobody is watching, still install unattended;
#   - Esc (choose fails) goes to the local disk, never to the install: a human
#     who cancelled did not consent to a wipe;
#   - the menu exists only on armed MACs. An unarmed machine still 404s and
#     boots locally -- the token is the consent model, and a menu that offered
#     "install" to anything that netbooted would throw that away;
#   - "live desktop" boots the same kernel and root image with no seed, which
#     is what the USB does: kldload-autoinstall finds no kldload.seed= and
#     installs nothing (unless a KLDLOADSEED disk is plugged in, exactly as
#     from the USB). It carries <netarg> too, so it also downloads over the
#     fast NIC.
#
# THE LOOK: a 1024x768 console over ipxe/menu.png, text confined to the panel
# drawn in it (NB_CONSOLE must match tools/netboot/gen_menu_bg.py), colours
# from the web UI. Every styling command ends `|| goto plain`: the distro's
# iPXE has no `console`, and without the guard the first unknown command
# would end the script and the machine would boot locally -- an armed install
# silently not happening. iPXE splits words on whitespace with no quoting, so
# the second column's padding is a run of spaces smuggled in as a hex setting
# (${pN:string}), which expands AFTER the split.
#
# The text area is 704 x 342 px. iPXE's framebuffer console draws each cell
# 9 x 19 px here, NOT the 8 x 16 of its font -- measured from a qemu
# screenshot on 2026-09-18, where a panel sized for 8 x 16 showed 10 item rows
# and "..." instead of 13 -- so the area is 78 x 18 cells. iPXE gives a menu
# LINES - 5 item rows (menu_ui.c: MENU_ROWS = LINES - 2 - MENU_ROW), so 13:
# the install menu's twelve items plus an armed profile outside the usual
# seven. It always CENTRES the title (menu_ui.c:302), so a title padded to
# NB_TITLE_W = 78 - 6 columns starts in column 3, where the item labels start.
# Writes $ROOT/armed/<m>.ipxe and dies if it did not land.
NB_CONSOLE="--x 1024 --y 768 --left 160 --right 160 --top 236 --bottom 190"

# _ipxe_text <string> — strip anything iPXE would interpret (${, ||, #) from
# text that came from an answers file.
_ipxe_text() { printf '%s' "$1" | tr -cd 'A-Za-z0-9 ._:/()-'; }

# _ipxe_pad <n> — n spaces as an iPXE hex setting value: 20:20:...; n >= 1.
_ipxe_pad() {
    local n=$1 out="20" i
    for ((i = 1; i < n; i++)); do out+=":20"; done
    printf '%s' "$out"
}

# _answer_val <answers-file> <KEY> — the last KEY= value, quotes stripped.
_answer_val() { sed -n "s/^${2}=//p" "$1" | tail -1 | tr -d "\"'"; }

NB_TITLE_W=72

# _nb_title_pad <visible-length> [setting] — the `set <setting>:hex ...` line
# that pads a title to NB_TITLE_W, or clears it when already that long.
# Setting defaults to tp; a second menu in the same script needs its own, or
# it re-pads the first menu's title when Back redraws it.
_nb_title_pad() {
    local name="${2:-tp}"
    if (($1 < NB_TITLE_W)); then
        printf 'set %s:hex %s\n' "$name" "$(_ipxe_pad $((NB_TITLE_W - $1)))"
    else
        printf 'clear %s\n' "$name"
    fi
}

_write_armed() {
    local m="$1" mac="$2" action tip args="$5" netarg="$6" netdev="$7" host tok="$ROOT/armed/$1.ipxe"
    action="$(_ipxe_text "$3")"
    tip="$(_ipxe_text "$4")"
    host="$(_ipxe_text "${8:-}")"
    [[ "$MENU_TIMEOUT" =~ ^[0-9]+$ ]] || die "NETBOOT_MENU_TIMEOUT must be whole seconds, got '$MENU_TIMEOUT'"
    local live="Live desktop" w
    w=$((${#action} > ${#live} ? ${#action} : ${#live}))
    w=$((w + 4))
    local skip="" tlen
    ((MENU_TIMEOUT > 0)) || skip="goto armed"
    tlen=${#mac}
    [[ -z "$host" ]] || tlen=$((tlen + 2 + ${#host}))
    cat >"$tok" <<IPXE
#!ipxe
# kldload armed ${mac}: ${action}. \${base} comes from boot.ipxe.
${skip}
console ${NB_CONSOLE} --picture \${base}/ipxe/menu.png || goto plain
colour --rgb 0xd0d8e8 7 || goto plain
colour --rgb 0xf0f4fa 3 || goto plain
colour --rgb 0x326ce5 4 || goto plain
colour --rgb 0x5a6a85 6 || goto plain
cpair --foreground 7 --background 9 0 || goto plain
cpair --foreground 7 --background 9 1 || goto plain
cpair --foreground 3 --background 4 2 || goto plain
cpair --foreground 6 --background 9 3 || goto plain
:plain
set p0:hex 20:20
set p1:hex $(_ipxe_pad $((w - ${#action})))
set p2:hex $(_ipxe_pad $((w - ${#live})))
$(_nb_title_pad "$tlen")
menu ${host:+${host}\${p0:string}}${mac}\${tp:string}
item --gap ${netdev:+downloads over ${netdev}}
item --gap
item armed ${action}\${p1:string}${tip}
item live ${live}\${p2:string}installs nothing
item local Boot from local disk
item shell iPXE shell
choose --timeout $((MENU_TIMEOUT * 1000)) --default armed target || goto local
goto \${target}

:armed
kernel \${base}/kldload/vmlinuz initrd=initrd.img root=live:\${base}/kldload/squashfs.img ${args}${netarg}
initrd \${base}/kldload/initrd.img
boot

:live
kernel \${base}/kldload/vmlinuz initrd=initrd.img root=live:\${base}/kldload/squashfs.img ${ISO_ARGS}${netarg}
initrd \${base}/kldload/initrd.img
boot

:local
echo kldload: booting from local disk
exit

:shell
shell
IPXE
    [[ -s "$tok" ]] || die "$tok did not land"
}

# ── The install menu: any profile, then any verified distro ────────────────
# Operator, 2026-09-18: "list all 7 profiles and allow the user to simply
# boot/install whatever they like", then a distro screen, netboot.xyz-style.
#
# WHY per-profile answers files and not cmdline keys: kldload.distro= already
# overrides the seed from the cmdline, but a profile is a BUNDLE -- kvm is
# ENABLE_KVM + BUILD_IMAGES + TEMPLATE, k8s adds ENABLE_K8S and the node
# counts, ai adds ENABLE_AI -- and most of those have no cmdline key. So
# arming writes answers/<m>-<profile>.env for every other profile: the armed
# file with each NB_PRESET_KEYS line removed and that profile's preset
# appended. The ARMED profile keeps the original <m>.env untouched, so the
# timeout (the matrix, CI, anyone not watching) fetches exactly what was armed.
#
# The presets are the matrix editions' own values (live-build/pxe/matrix/
# N-<edition>, read 2026-09-18) minus anything machine-specific, so each item
# installs what its edition verified. Change an edition, change it here.
NB_PROFILES=(core server desktop kvm k8s storage ai)
NB_PRESET_KEYS="PROFILE TEMPLATE ENABLE_KVM ENABLE_K8S K8S_BOOTSTRAP K8S_CONTROL_PLANES K8S_WORKERS BUILD_IMAGES ENABLE_AI ENABLE_DEVOPS ENABLE_EBPF ENABLE_WEBUI WIREGUARD"

# _nb_preset <profile> — "description|KEY=VAL ..." on stdout (keys without the
# KLDLOAD_ prefix); exit 1 for a profile with no preset.
_nb_preset() {
    case "$1" in
    core) echo "minimal ZFS-on-root base|PROFILE=core ENABLE_DEVOPS=0 ENABLE_AI=0 K8S_BOOTSTRAP=0 BUILD_IMAGES=0" ;;
    server) echo "headless, web UI and devops tools|PROFILE=server ENABLE_DEVOPS=1 ENABLE_EBPF=1 ENABLE_WEBUI=1 WIREGUARD=1 ENABLE_AI=0 K8S_BOOTSTRAP=0 BUILD_IMAGES=0" ;;
    desktop) echo "GNOME workstation|PROFILE=desktop ENABLE_DEVOPS=1 WIREGUARD=1 ENABLE_AI=0 K8S_BOOTSTRAP=0 BUILD_IMAGES=0" ;;
    kvm) echo "hypervisor, VMs on ZFS, golden images|PROFILE=kvm TEMPLATE=kvm ENABLE_KVM=1 BUILD_IMAGES=1 ENABLE_DEVOPS=1 ENABLE_EBPF=1 WIREGUARD=1 ENABLE_AI=0 K8S_BOOTSTRAP=0" ;;
    k8s) echo "kvm plus a 3+3 HA Kubernetes cluster|PROFILE=kvm TEMPLATE=k8s ENABLE_KVM=1 ENABLE_K8S=1 K8S_BOOTSTRAP=1 K8S_CONTROL_PLANES=3 K8S_WORKERS=3 BUILD_IMAGES=1 ENABLE_DEVOPS=1 ENABLE_EBPF=1 WIREGUARD=1 ENABLE_AI=0" ;;
    storage) echo "NFS, SMB and iSCSI file server|PROFILE=storage ENABLE_WEBUI=1 ENABLE_EBPF=1 WIREGUARD=1 ENABLE_DEVOPS=0 ENABLE_AI=0 K8S_BOOTSTRAP=0 BUILD_IMAGES=0" ;;
    ai) echo "local models behind the web UI|PROFILE=ai ENABLE_AI=1 ENABLE_WEBUI=1 ENABLE_DEVOPS=1 ENABLE_EBPF=1 WIREGUARD=1 K8S_BOOTSTRAP=0 BUILD_IMAGES=0" ;;
    *) return 1 ;;
    esac
}

# _nb_check_distros — die unless every NETBOOT_DISTROS entry is a distro the
# installer accepts (kldload-autoinstall's own list). Called BEFORE arming
# writes anything: the first version checked while drawing the menu, after the
# profile answers files -- password and all -- were already being served.
_nb_check_distros() {
    local d
    for d in $NB_DISTROS; do
        [[ "$d" =~ ^(arch|centos|debian|fedora|rhel|rocky|ubuntu)$ ]] ||
            die "NETBOOT_DISTROS: '$d' is not a distro the installer knows"
    done
}

# _nb_menu_key <answers> — which menu item an answers file IS. k8s is not a
# profile: the web installer sends it as profile kvm + template k8s.
_nb_menu_key() {
    local p t
    p="$(_answer_val "$1" KLDLOAD_PROFILE)"
    t="$(_answer_val "$1" KLDLOAD_TEMPLATE)"
    [[ "$p" == kvm && "$t" == k8s ]] && p=k8s
    printf '%s\n' "${p:-server}"
}

# _nb_write_profile_answers <m> <answers> <armed-key>
# Writes $ROOT/answers/<m>-<profile>.env for every NB_PROFILES entry except the
# armed one, after removing any left by an earlier arm of this MAC. Each file
# is built in a private temp dir (it carries the password), installed 0644
# like the armed file (nginx serves it), and put through _check_answers.
# Dies unless the number written is the number expected.
_nb_write_profile_answers() {
    local m="$1" answers="$2" key="$3" p pre kv td re n=0 want=0
    re="^KLDLOAD_(${NB_PRESET_KEYS// /|})="
    rm -f "$ROOT/answers/${m}"-*.env
    td="$(mktemp -d)"
    for p in "${NB_PROFILES[@]}"; do
        [[ "$p" == "$key" ]] && continue
        want=$((want + 1))
        pre="$(_nb_preset "$p")"
        {
            awk -v re="$re" '$0 !~ re' "$answers"
            for kv in ${pre#*|}; do printf 'KLDLOAD_%s\n' "$kv"; done
        } >"$td/$p.env"
        install -m 0644 "$td/$p.env" "$ROOT/answers/${m}-${p}.env"
        [[ "$(_nb_menu_key "$ROOT/answers/${m}-${p}.env")" == "$p" ]] ||
            die "answers/${m}-${p}.env did not land as profile $p"
        _check_answers "$ROOT/answers/${m}-${p}.env" >/dev/null ||
            die "the generated $p answers failed their own check"
        n=$((n + 1))
    done
    rm -rf "$td"
    ((n == want)) || die "wrote ${n} of ${want} profile answers files for $m"
    log "  menu: ${n} other profiles armed beside $key (answers/${m}-*.env)"
}

# _write_armed_install <m> <mac> <answers> <key> <prefix-args> <netarg> <netdev>
#
# The install token: every profile, then (with more than one verified distro)
# a distro screen, then a security screen, then the kernel.
#
# SECURITY SCREEN (operator, 2026-09-18: "we also have to include encryption
# and secure boot"): standard, encrypted, Secure Boot, or both, as
# kldload.encrypt= / kldload.secureboot=, which the installer already takes
# from the cmdline. The passphrase never goes there -- /proc/cmdline is world-
# readable on the installed system and kldload-autoinstall refuses it -- so the
# encrypted choices exist only when the answers file carries
# KLDLOAD_ZFS_PASSPHRASE. Both need someone at the console afterwards: the
# passphrase at every boot, and MokManager's enrollment on the first reboot. <prefix-args> is ISO_ARGS + KIOSK_ARGS;
# the seed and kldload.distro= are added per choice. Timeout, Esc and the
# `|| goto plain` styling rules are _write_armed's, for the same reasons.
_write_armed_install() {
    local m="$1" mac="$2" answers="$3" key prefix="$5" netarg="$6" netdev="$7"
    local tok="$ROOT/armed/$1.ipxe" host distro disk title tlen p desc seed i=0 d
    key="$(_ipxe_text "$4")"
    host="$(_ipxe_text "$(_answer_val "$answers" KLDLOAD_HOSTNAME)")"
    distro="$(_ipxe_text "$(_answer_val "$answers" KLDLOAD_DISTRO)")"
    disk="$(_ipxe_text "$(_answer_val "$answers" KLDLOAD_DISK)")"
    disk="${disk##*/}"
    [[ "$MENU_TIMEOUT" =~ ^[0-9]+$ ]] || die "NETBOOT_MENU_TIMEOUT must be whole seconds, got '$MENU_TIMEOUT'"

    local -a profs=() dists=()
    _nb_preset "$key" >/dev/null || profs=("$key")
    profs+=("${NB_PROFILES[@]}")
    read -r -a dists <<<"$NB_DISTROS"
    [[ " ${dists[*]} " == *" ${distro} "* ]] || dists=("$distro" "${dists[@]}")
    local multi=0
    ((${#dists[@]} > 1)) && multi=1

    # Title pieces are joined by ${s3:string}: iPXE collapses literal runs of
    # spaces when it splits the line, so they cannot be typed.
    title="${host:+${host}\${s3:string}}${mac}"
    tlen=$((${#mac} + ${host:+3} + ${#host}))
    if ((!multi)); then
        title+="\${s3:string}${distro}"
        tlen=$((tlen + 3 + ${#distro}))
    fi
    if [[ -n "$netdev" ]]; then
        title+="\${s3:string}via ${netdev}"
        tlen=$((tlen + 7 + ${#netdev}))
    fi

    local skip=""
    ((MENU_TIMEOUT > 0)) || skip="goto armed"
    local ms=$((MENU_TIMEOUT * 1000))
    # The armed security combination, as s_<encrypt><secureboot>, and whether
    # the encrypted ones can be offered at all.
    local enc sb have_pp=0 sec
    enc="$(_answer_val "$answers" KLDLOAD_ZFS_ENCRYPT)"
    sb="$(_answer_val "$answers" KLDLOAD_ENABLE_SECURE_BOOT)"
    [[ "$enc" == 1 ]] || enc=0
    [[ "$sb" == 1 ]] || sb=0
    grep -qE '^KLDLOAD_ZFS_PASSPHRASE=.+' "$answers" && have_pp=1
    {
        printf '#!ipxe\n'
        printf '# kldload armed %s: install menu, default %s/%s. ${base} comes from boot.ipxe.\n' "$mac" "$distro" "$key"
        printf '%s\n' "$skip"
        printf '%s\n' "console ${NB_CONSOLE} --picture \${base}/ipxe/menu.png || goto plain" \
            'colour --rgb 0xd0d8e8 7 || goto plain' 'colour --rgb 0xf0f4fa 3 || goto plain' \
            'colour --rgb 0x326ce5 4 || goto plain' 'colour --rgb 0x5a6a85 6 || goto plain' \
            'cpair --foreground 7 --background 9 0 || goto plain' 'cpair --foreground 7 --background 9 1 || goto plain' \
            'cpair --foreground 3 --background 4 2 || goto plain' 'cpair --foreground 6 --background 9 3 || goto plain' \
            ':plain'
        printf 'set s2:hex %s\nset s3:hex %s\n' "$(_ipxe_pad 2)" "$(_ipxe_pad 3)"
        _nb_title_pad "$tlen"
        for p in "${profs[@]}" "Live desktop"; do
            printf 'set q%d:hex %s\n' "$i" "$(_ipxe_pad $((15 - ${#p})))"
            i=$((i + 1))
        done
        # The security screen's columns, as fixed names q9..q12 (at most eight
        # profiles plus Live desktop come first, so q0..q8 are theirs).
        printf 'set q9:hex %s\nset q10:hex %s\nset q11:hex %s\nset q12:hex %s\n' \
            "$(_ipxe_pad 7)" "$(_ipxe_pad 6)" "$(_ipxe_pad 4)" "$(_ipxe_pad 11)"

        printf '\n:top\nmenu %s${tp:string}\n' "$title"
        printf 'item --gap BASE${s3:string}erases %s\n' "${disk:-the disk it picks}"
        i=0
        for p in "${profs[@]}"; do
            desc="$(_nb_preset "$p")" || desc="as armed|"
            desc="${desc%%|*}"
            [[ "$p" == "$key" ]] && desc+="\${s2:string}[armed]"
            printf 'item m_%s %s${q%d:string}%s\n' "$p" "$p" "$i" "$desc"
            i=$((i + 1))
        done
        printf 'item --gap\n'
        printf 'item live Live desktop${q%d:string}installs nothing\n' "$i"
        printf 'item local Boot from local disk\nitem shell iPXE shell\n'
        printf 'choose --timeout %d --default m_%s target || goto local\ngoto ${target}\n' "$ms" "$key"

        for p in "${profs[@]}"; do
            seed="${m}-${p}.env"
            [[ "$p" == "$key" ]] && seed="${m}.env"
            printf '\n:m_%s\nset pf %s\nset sf %s\ngoto distro\n' "$p" "$p" "$seed"
        done

        printf '\n:armed\nset sf %s.env\nclear dargs\nclear sargs\ngoto install\n' "$m"
        printf '\n:distro\n'
        if ((multi)); then
            # Its own pad setting: sharing tp shifted the main title two
            # columns left after Back (qemu, 2026-09-18).
            _nb_title_pad 6 td
            printf 'menu distro${td:string}\n'
            printf 'item --gap assemble ${pf} on\n'
            for d in "${dists[@]}"; do
                if [[ "$d" == "$distro" ]]; then
                    printf 'item d_%s %s${s3:string}[armed]\n' "$d" "$d"
                else
                    printf 'item d_%s %s\n' "$d" "$d"
                fi
            done
            printf 'item --gap\nitem top Back\n'
            printf 'choose --timeout %d --default d_%s dsel || goto top\ngoto ${dsel}\n' "$ms" "$distro"
            for d in "${dists[@]}"; do
                if [[ "$d" == "$distro" ]]; then
                    printf '\n:d_%s\nclear dargs\ngoto security\n' "$d"
                else
                    printf '\n:d_%s\nset dargs kldload.distro=%s\ngoto security\n' "$d" "$d"
                fi
            done
        else
            printf 'clear dargs\ngoto security\n'
        fi

        # s_<encrypt><secureboot>. The armed one clears sargs, so the timeout
        # boots exactly the armed file; the others state both values.
        printf '\n:security\n'
        _nb_title_pad 8 ts
        printf 'menu security${ts:string}\n'
        printf 'item --gap assemble ${pf} with\n'
        for sec in 00 10 01 11; do
            [[ "$sec" == 1? && $have_pp == 0 ]] && continue
            case "$sec" in
            00) desc='standard${q9:string}no encryption, Secure Boot off' ;;
            10) desc='encrypted${q10:string}ZFS native encryption, passphrase at every boot' ;;
            01) desc='Secure Boot${q11:string}signed boot chain, enroll the key on first boot' ;;
            11) desc='both${q12:string}encrypted and Secure Boot' ;;
            esac
            [[ "$sec" == "${enc}${sb}" ]] && desc+='${s2:string}[armed]'
            printf 'item s_%s %s\n' "$sec" "$desc"
        done
        ((have_pp)) || printf 'item --gap encryption needs KLDLOAD_ZFS_PASSPHRASE in the answers file\n'
        printf 'item --gap\nitem top Back\n'
        printf 'choose --timeout %d --default s_%s ssel || goto top\ngoto ${ssel}\n' "$ms" "${enc}${sb}"
        for sec in 00 10 01 11; do
            if [[ "$sec" == "${enc}${sb}" ]]; then
                printf '\n:s_%s\nclear sargs\ngoto install\n' "$sec"
            else
                printf '\n:s_%s\nset sargs kldload.encrypt=%s kldload.secureboot=%s\ngoto install\n' "$sec" "${sec:0:1}" "${sec:1:1}"
            fi
        done

        printf '\n:install\n'
        printf 'kernel ${base}/kldload/vmlinuz initrd=initrd.img root=live:${base}/kldload/squashfs.img %s kldload.seed=${base}/answers/${sf} ${dargs} ${sargs}%s\n' "$prefix" "$netarg"
        printf 'initrd ${base}/kldload/initrd.img\nboot\n'
        printf '\n:live\n'
        printf 'kernel ${base}/kldload/vmlinuz initrd=initrd.img root=live:${base}/kldload/squashfs.img %s%s\n' "$ISO_ARGS" "$netarg"
        printf 'initrd ${base}/kldload/initrd.img\nboot\n'
        printf '\n:local\necho kldload: booting from local disk\nexit\n\n:shell\nshell\n'
    } >"$tok"
    [[ -s "$tok" ]] || die "$tok did not land"
    grep -q "^:m_${key}\$" "$tok" || die "$tok has no entry for the armed profile $key"
}

cmd_arm_install() {
    local usage="usage: arm-install <mac> <answers-file> [--netdev <mac2>]"
    local mac="${1:?$usage}" answers="${2:?$usage}"
    shift 2
    local netdev="" netdev_from="--netdev"
    while (($#)); do
        case "$1" in
        --netdev)
            netdev="${2:?--netdev needs a MAC}"
            shift 2
            ;;
        *) die "arm-install: unknown argument: $1" ;;
        esac
    done
    _check_answers "$answers" || die "refusing to arm $mac"
    _nb_check_distros
    # The flag wins over the file, so a one-off arm can override an estate file.
    if [[ -z "$netdev" ]]; then
        netdev="$(_answers_netdev "$answers")"
        netdev_from="KLDLOAD_NETBOOT_NETDEV"
    fi
    [[ -z "$netdev" ]] || _mac_norm "$netdev" >/dev/null
    local netarg
    netarg="$(_netdev_arg "$netdev")"
    install -d -m 0755 "$ROOT/answers" "$ROOT/armed"
    local m
    m="$(_mac_norm "$mac")"
    install -m 0644 "$answers" "$ROOT/answers/${m}.env"
    [[ -s "$ROOT/answers/${m}.env" ]] || die "$ROOT/answers/${m}.env did not land"
    local key
    key="$(_nb_menu_key "$answers")"
    _nb_write_profile_answers "$m" "$answers" "$key"
    _write_armed_install "$m" "$mac" "$answers" "$key" "${ISO_ARGS} ${KIOSK_ARGS}" "$netarg" "$netdev"
    log "ARMED-INSTALL $mac — next netboot shows the install menu; default $(_answer_val "$answers" KLDLOAD_DISTRO)/${key}"
    [[ -n "$netdev" ]] && log "  root image and seed download over ${netdev} (${netdev_from}); ${mac} only starts the boot"
    k_audit "ARMED-INSTALL $mac by uid=$(id -u) ($(logname 2>/dev/null || echo "?")) from $answers${netdev:+ netdev=$netdev}"
    if grep -qE '^KLDLOAD_(PASSWORD|ZFS_PASSPHRASE)=.+' "$answers"; then
        log "  WARN: this file carries a password, served unauthenticated to the LAN"
        log "        until you disarm: kldload-netboot-server disarm $mac"
    fi
}

# ── arm-deploy ─────────────────────────────────────────────────────────────
# Clone a prepared golden onto the target. No answers file, no secrets: the
# parameters ride the kernel cmdline the installer's deploy verb already parses,
# and the golden streams over HTTP (no keys). --disk is REQUIRED because the
# deploy verb repartitions it and refuses to guess; identical rack boxes can
# all take the same kernel name (/dev/nvme0n1), a mixed rack takes by-id.
cmd_arm_deploy() {
    local mac="${1:?usage: arm-deploy <mac> --golden <name> --disk D [--hostname H] [--netdev <mac>]}" golden="" disk="" host="" netdev=""
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --golden)
            golden="${2:?--golden needs a name}"
            shift 2
            ;;
        --disk)
            disk="${2:?--disk needs a value}"
            shift 2
            ;;
        --hostname)
            host="${2:?--hostname needs a value}"
            shift 2
            ;;
        --netdev)
            netdev="${2:?--netdev needs a MAC}"
            shift 2
            ;;
        *) die "arm-deploy: unknown argument: $1" ;;
        esac
    done
    [[ -n "$golden" ]] || die "arm-deploy: --golden <name> is required"
    [[ -n "$disk" ]] || die "arm-deploy: --disk /dev/... is required (the deploy verb repartitions it and will not guess)"
    [[ -f "$ROOT/golden/${golden}.zfs" ]] ||
        die "no golden stream at $ROOT/golden/${golden}.zfs — run: kldload-netboot-server golden <dataset> as ${golden}"
    [[ "$disk" =~ ^/dev/[a-zA-Z0-9/_-]+$ ]] ||
        die "arm-deploy: --disk must be /dev/... (got '$disk')"
    [[ -z "$host" || "$host" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]] ||
        die "arm-deploy: --hostname '$host' is not a valid hostname"
    [[ -z "$netdev" ]] || _mac_norm "$netdev" >/dev/null
    install -d -m 0755 "$ROOT/armed"
    local m
    m="$(_mac_norm "$mac")"
    local diskarg=" kldload.disk=${disk}"
    local hostarg=""
    [[ -n "$host" ]] && hostarg=" kldload.hostname=${host}"
    local netarg
    netarg="$(_netdev_arg "$netdev")"
    _write_armed "$m" "$mac" "Deploy golden ${golden}" "wipes ${disk##*/}" \
        "${ISO_ARGS} kldload.action=deploy kldload.archive-url=\${base}/golden/${golden}.zfs${diskarg}${hostarg}" "$netarg" "$netdev" "$host"
    log "ARMED-DEPLOY $mac — next netboot RECEIVES golden '${golden}' onto ${disk}${host:+ as $host}${netdev:+, over $netdev}"
    k_audit "ARMED-DEPLOY $mac by uid=$(id -u) ($(logname 2>/dev/null || echo "?")) golden=$golden disk=$disk${netdev:+ netdev=$netdev}"
}

# ── golden ───────────────────────────────────────────────────────────────────
# Turn a prepared dataset into a servable stream: `zfs send -R` of a fresh
# recursive snapshot into golden/<name>.zfs; the target does curl | zfs receive
# -F -d -u (kldload-restore-machine --archive-url). v1 is a static stream, so it
# costs its size on disk; a send-on-connect endpoint is a later refinement.
# The dataset must be UNENCRYPTED: -R on an encrypted dataset is refused by ZFS
# unless raw, and a raw stream would make the clone depend on this server's
# key. A golden is sealed and unencrypted by construction; the target applies
# its own encryption policy on receive. zfs send fails loudly otherwise.
cmd_golden() {
    local dataset="${1:?usage: golden <dataset> [as <name>]}" name
    shift || true
    if [[ "${1:-}" == as ]]; then name="${2:?'as' needs a name}"; else name="${dataset##*/}"; fi
    [[ "$name" =~ ^[a-zA-Z0-9._-]+$ ]] || die "golden: bad name '$name'"
    zfs list -H -o name "$dataset" >/dev/null 2>&1 || die "no such dataset: $dataset"
    install -d -m 0755 "$ROOT/golden"
    local snap="${dataset}@golden-$(date +%Y%m%d%H%M%S)" out="$ROOT/golden/${name}.zfs"
    log "snapshotting ${snap}"
    zfs snapshot -r "$snap" || die "could not snapshot $dataset"
    log "streaming to ${out} (this is the full golden; it takes a while)"
    # Raw send: portable across the wire and self-contained. -R carries the
    # whole tree under the dataset.
    if zfs send -R "$snap" >"$out"; then
        # Outcome, not exit code: a truncated stream fails a receive halfway.
        [[ -s "$out" ]] || die "golden stream came out empty"
        log "golden '${name}' ready: $(numfmt --to=iec "$(stat -c%s "$out")") at $out"
        log "  arm a target with: kldload-netboot-server arm-deploy <mac> --golden ${name}"
    else
        rm -f "$out"
        die "zfs send failed — no golden written"
    fi
    zfs destroy -r "$snap" 2>/dev/null || log "  note: leftover snapshot $snap (destroy it manually)"
}

# ── disarm / status ──────────────────────────────────────────────────────────
cmd_disarm() {
    local mac="${1:?usage: disarm <mac>}" m
    m="$(_mac_norm "$mac")"
    local gone=0
    [[ -f "$ROOT/armed/${m}.ipxe" ]] && {
        rm -f "$ROOT/armed/${m}.ipxe"
        gone=1
    }
    [[ -f "$ROOT/answers/${m}.env" ]] && {
        rm -f "$ROOT/answers/${m}.env"
        gone=1
    }
    # The install menu's other profiles: the same password, one file each.
    local extra
    for extra in "$ROOT/answers/${m}"-*.env; do
        [[ -f "$extra" ]] || continue
        rm -f "$extra"
        gone=1
    done
    if ((gone)); then
        log "disarmed $mac"
        k_audit "DISARMED $mac by uid=$(id -u) ($(logname 2>/dev/null || echo "?"))"
    else
        log "$mac was not armed"
        k_audit "DISARM $mac — was not armed"
    fi
}

# ── arm-all / disarm-all ─────────────────────────────────────────────────────
# arm-all <dir> [--dry-run] — arm every machine that has an answers file.
#
# The directory is the estate: one <mac>.env per machine, kept in git, and
# re-arming it is how a rack is rebuilt. Files are selected by NAME — a MAC in
# either spelling (f0-2f-74-cd-27-50.env or f0:2f:74:cd:27:50.env) — so
# TEMPLATE.env, notes and backups sitting beside them are skipped, and each skip
# is said out loud rather than silently ignored.
#
# Refused as a WHOLE batch, before anything is armed:
#   - two files naming the same MAC under different spellings: which one would
#     win depends on glob order, and the loser is a machine installed wrong;
#   - two machines with the same KLDLOAD_HOSTNAME: they install fine and then
#     collide in DNS, the estate inventory and the Ansible host list.
# Per machine, a file that fails _check_answers is reported and NOT armed; the
# rest still are. Each machine is armed through cmd_arm_install itself, in a
# subshell so its die() ends only that machine.
#
# Output: one line per file on stderr and a closing count that is checked
# against the number of files given. Exit 0 only when every MAC-named file was
# armed; 1 if any failed, if the batch was refused, or if there was nothing to
# arm — "0 armed, 0 failed" from an empty or mistyped directory is not success.
cmd_arm_all() {
    local dir="" dry=0
    while (($#)); do
        case "$1" in
        --dry-run) dry=1 ;;
        -*)
            log "arm-all: unknown option $1 (usage: arm-all <dir> [--dry-run])"
            exit 2
            ;;
        *)
            [[ -z "$dir" ]] || {
                log "arm-all: one directory only (usage: arm-all <dir> [--dry-run])"
                exit 2
            }
            dir="$1"
            ;;
        esac
        shift
    done
    [[ -n "$dir" ]] || {
        log "usage: arm-all <answers-dir> [--dry-run]"
        exit 2
    }
    [[ -d "$dir" ]] || die "arm-all: no such directory: $dir"

    local -a macs=() files=()
    local -A seen_mac=() seen_host=()
    local f base m host skipped=0 batch_bad=0
    shopt -s nullglob
    for f in "$dir"/*.env; do
        base="$(basename "$f" .env)"
        if ! m="$(_mac_norm "$base" 2>/dev/null)"; then
            log "  skip   $(basename "$f") — not named for a MAC address"
            skipped=$((skipped + 1))
            continue
        fi
        if [[ -n "${seen_mac[$m]:-}" ]]; then
            log "  REFUSE $(basename "$f") and $(basename "${seen_mac[$m]}") name the same machine ($m)"
            batch_bad=1
            continue
        fi
        seen_mac[$m]="$f"
        host="$(sed -n 's/^KLDLOAD_HOSTNAME=//p' "$f" | tail -1 | tr -d "\"'")"
        if [[ -n "$host" ]]; then
            if [[ -n "${seen_host[$host]:-}" ]]; then
                log "  REFUSE $(basename "$f") and $(basename "${seen_host[$host]}") both use hostname '$host'"
                batch_bad=1
            else
                seen_host[$host]="$f"
            fi
        fi
        macs+=("$m")
        files+=("$f")
    done
    shopt -u nullglob

    if ((batch_bad)); then
        die "arm-all: batch refused — nothing was armed. Fix the duplicates above and run it again."
    fi
    if ((${#files[@]} == 0)); then
        die "arm-all: no <mac>.env files in $dir (${skipped} other file(s) skipped) — nothing to arm"
    fi

    local i armed=0 failed=0
    local -a failed_list=()
    for i in "${!files[@]}"; do
        if ((dry)); then
            if _check_answers "${files[$i]}"; then
                log "  ok     ${macs[$i]}  $(basename "${files[$i]}") (dry run — not armed)"
                armed=$((armed + 1))
            else
                log "  FAIL   ${macs[$i]}  $(basename "${files[$i]}")"
                failed=$((failed + 1))
                failed_list+=("${macs[$i]}")
            fi
            continue
        fi
        # </dev/null: nothing inside may eat the loop's input (the 2026-08-22
        # while-read lesson), even though this loop does not read stdin today.
        if (cmd_arm_install "${macs[$i]}" "${files[$i]}") </dev/null; then
            armed=$((armed + 1))
        else
            log "  FAIL   ${macs[$i]}  $(basename "${files[$i]}") — not armed (reason above)"
            failed=$((failed + 1))
            failed_list+=("${macs[$i]}")
        fi
    done

    local given=${#files[@]}
    ((armed + failed == given)) ||
        die "arm-all: accounted for $((armed + failed)) of ${given} machines — refusing to report success"
    if ((dry)); then
        log "arm-all (dry run): ${armed} of ${given} would arm, ${failed} would fail, ${skipped} file(s) skipped"
    else
        log "arm-all: ${armed} of ${given} armed, ${failed} failed, ${skipped} file(s) skipped"
        k_audit "ARM-ALL $dir: ${armed}/${given} armed, ${failed} failed, by uid=$(id -u)"
    fi
    # exit, not return: under set -E a function returning 1 fires the ERR trap,
    # which printed "FAIL at line N: return 1" beneath a report that had already
    # said exactly what failed (caught under test, 2026-09-13).
    if ((failed > 0)); then
        log "failed: ${failed_list[*]}"
        exit 1
    fi
}

# disarm-all — remove every consent token and served answers file.
cmd_disarm_all() {
    local a n=0 total=0
    shopt -s nullglob
    local -a tokens=("$ROOT"/armed/*.ipxe)
    shopt -u nullglob
    total=${#tokens[@]}
    for a in "${tokens[@]}"; do
        cmd_disarm "$(basename "$a" .ipxe)"
        n=$((n + 1))
    done
    shopt -s nullglob
    local -a left=("$ROOT"/armed/*.ipxe "$ROOT"/answers/*.env)
    shopt -u nullglob
    log "disarm-all: ${n} of ${total} disarmed"
    ((${#left[@]} == 0)) || die "disarm-all: ${#left[@]} armed or answers file(s) still present: ${left[*]}"
}

cmd_status() {
    # The tree may not exist before `serve` has run: a bare `find` on a missing
    # dir exits non-zero and trips set -e, so every listing is guarded on the
    # directory existing first. "no tree yet" is the normal pre-serve state.
    printf 'payload : %s\n' "$([[ -s "$PAYLOAD/squashfs.img" ]] && echo "$PAYLOAD ($(cat "$PAYLOAD/VERSION" 2>/dev/null || echo '?'))" || echo 'ABSENT — install with KLDLOAD_KEEP_NETBOOT=1')"
    local svc
    svc="$(systemctl is-active kldload-netboot.service 2>/dev/null)" || svc="inactive"
    printf 'service : %s\n' "$svc"
    if [[ -d "$ROOT/golden" ]]; then
        printf 'goldens : %s\n' "$(find "$ROOT/golden" -maxdepth 1 -name '*.zfs' | wc -l)"
        find "$ROOT/golden" -maxdepth 1 -name '*.zfs' |
            while read -r g; do printf '          %s (%s)\n' "$(basename "$g" .zfs)" "$(numfmt --to=iec "$(stat -c%s "$g")")"; done
    else
        printf 'goldens : 0 (no tree yet — serve has not run)\n'
    fi
    if [[ -d "$ROOT/armed" ]]; then
        printf 'armed   : %s machine(s)\n' "$(find "$ROOT/armed" -maxdepth 1 -name '*.ipxe' | wc -l)"
        find "$ROOT/armed" -maxdepth 1 -name '*.ipxe' |
            while read -r a; do
                m="$(basename "$a" .ipxe)"
                if grep -q 'kldload.action=deploy' "$a"; then mode="deploy ($(sed -nE 's#.*golden/([^ ]*)\.zfs.*#\1#p' "$a" | head -1))"; else mode="install"; fi
                nd="$(sed -nE 's/.* BOOTIF=01-([0-9a-f-]+).*/\1/p' "$a" | head -1)"
                printf '          %s -> %s%s\n' "$m" "$mode" "${nd:+, download over $nd}"
            done
    else
        printf 'armed   : 0 machine(s)\n'
    fi
}

case "${1:-}" in
serve) cmd_serve ;;
arm-install)
    shift
    cmd_arm_install "$@"
    ;;
arm-deploy)
    shift
    cmd_arm_deploy "$@"
    ;;
golden)
    shift
    cmd_golden "$@"
    ;;
disarm)
    shift
    cmd_disarm "$@"
    ;;
arm-all)
    shift
    cmd_arm_all "$@"
    ;;
disarm-all) cmd_disarm_all ;;
status) cmd_status ;;
*)
    cat >&2 <<'USAGE'
usage: kldload-netboot-server <command>

  serve                      run the PXE server (HTTP + TFTP + proxyDHCP)
  arm-install <mac> <answers> [--netdev <mac2>]
                             next netboot of <mac> INSTALLS from the mirror
  arm-all <dir> [--dry-run]  arm every <mac>.env in <dir>; refuses duplicate
                             MACs or hostnames; exit 1 unless all armed
  arm-deploy <mac> --golden <name> --disk <d> [--hostname <h>] [--netdev <mac2>]
                             next netboot of <mac> CLONES a golden over HTTP

  --netdev <mac2>  <mac> starts the boot, <mac2> carries the download: the
                   initrd brings up ONLY <mac2> (BOOTIF=01-<mac2>). For a fast
                   NIC whose card cannot UEFI-PXE. arm-install also reads
                   KLDLOAD_NETBOOT_NETDEV=<mac2> from the answers file, so
                   arm-all pins it per machine; the flag wins over the file.
  golden <dataset> [as <name>]  stage a dataset as a golden stream
  disarm <mac>               remove the consent token; that MAC boots locally
  disarm-all                 disarm every armed machine
  status                     payload, service, goldens, armed machines

environment (read from /etc/kldload/netboot.env by the unit AND by every command
run by hand; a variable already set in the environment wins):
  NETBOOT_PORT   HTTP port (default 8080)
  NETBOOT_IFACE  interface to serve on (default: the one holding the default
                 route). Set this when provisioning runs on its own NIC, which
                 has no default route and would otherwise not be chosen.
  NETBOOT_MENU_TIMEOUT  seconds an armed machine shows its menu before taking
                 the armed action. arm-install's menu lists every profile
                 (core server desktop kvm k8s storage ai; each one the armed
                 answers file with that profile's matrix settings), then a live
                 desktop, the local disk and an iPXE shell. A profile leads to a
                 security screen: standard, Secure Boot, and -- only when the
                 answers file has KLDLOAD_ZFS_PASSPHRASE -- encrypted and both.
                 Esc goes back, then to the local disk. Default 10; 0 = no menu.
                 Read when arming: re-arm to change an armed machine.
  NETBOOT_DISTROS  distros the install menu offers, space-separated; only ones
                 the matrix has verified belong here. Default "fedora". With
                 more than one, each profile opens a distro screen (default:
                 the armed distro). Read when arming.

notes:
  ipxe.efi is UNSIGNED: a target with Secure Boot enabled will refuse it.
  x86 only; arm64 targets are not offered a boot file.
  proxyDHCP hands out no addresses, but the site DHCP server must not also
  set next-server/bootfile.
USAGE
    exit 2
    ;;
esac
