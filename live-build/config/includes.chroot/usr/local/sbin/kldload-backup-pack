#!/usr/bin/env bash
# kldload-backup-pack — snapshot the system root and ship it to a remote
# host as a single zstd-compressed ZFS send stream.
#
# What "the system root" means here:
#   The ZFS dataset mounted at / -- the running boot environment,
#   rpool/ROOT/<name> -- sent with -R: its children, if it has any, and
#   every snapshot in its history travel with it. That is the operating
#   system and its configuration.
#
# What is NOT included:
#   Everything outside that dataset: /home (rpool/home), /srv, /var/lib
#   when it is its own dataset, the VMs under rpool/vms, container storage.
#   They are siblings of rpool/ROOT, not children. (This banner used to say
#   /home travelled with the root; on a kldload install it never did --
#   rpool/ROOT/<name> has no children. Corrected 2026-09-29.) Send another
#   dataset with --dataset, or everything with --full.
#
# Output, on the remote host:
#   <dir>/<hostname>-<utc-timestamp>.zfs.zst   the stream
#   <dir>/<hostname>-<utc-timestamp>.meta      sidecar metadata
#
# Usage:
#   sudo kldload-backup-pack --host HOST            the system root
#   sudo kldload-backup-pack --host HOST --full     the whole pool
#   sudo kldload-backup-pack --host HOST --dataset rpool/home
#   sudo kldload-backup-pack --host HOST --dest-dir /backups
#   sudo kldload-backup-pack --host HOST --keep-snapshot
#
# Environment:
#   BACKUP_REMOTE_HOST   the host when --host is not given (no default: it
#                        was "fiend", one machine's name, until 2026-09-29)
#   BACKUP_REMOTE_DIR    default: /var/lib/kldload-backups
#   BACKUP_SSH_OPTS      default: -o BatchMode=yes -o StrictHostKeyChecking=accept-new
#
# Exit: 0 sent and the remote file is there; 1 a step failed (the local
#       snapshot is removed unless --keep-snapshot); 2 usage.
# See kldload-backup-pack(8).

set -Eeuo pipefail
trap 'echo "kldload-backup-pack: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

REMOTE_HOST="${BACKUP_REMOTE_HOST:-}"
REMOTE_DIR="${BACKUP_REMOTE_DIR:-/var/lib/kldload-backups}"
SSH_OPTS="${BACKUP_SSH_OPTS:--o BatchMode=yes -o StrictHostKeyChecking=accept-new}"
SOURCE_DATASET=""
FULL_POOL=0
KEEP_SNAP=0

usage() {
    local rc="${1:-2}"
    sed -n '2,${/^#/!q; s/^# \{0,1\}//; p}' "$0" >&$((rc == 0 ? 1 : 2))
    exit "$rc"
}
_bad() {
    echo "kldload-backup-pack: $*" >&2
    exit 2
}
_val() { [[ $# -ge 2 && -n "$2" ]] || _bad "$1 needs a value"; }

while [[ $# -gt 0 ]]; do
    case "$1" in
    --full) FULL_POOL=1 ;;
    --host)
        _val "$@"
        REMOTE_HOST="$2"
        shift
        ;;
    --dest-dir)
        _val "$@"
        REMOTE_DIR="$2"
        shift
        ;;
    --dataset)
        _val "$@"
        SOURCE_DATASET="$2"
        shift
        ;;
    --keep-snapshot) KEEP_SNAP=1 ;;
    -h | --help) usage 0 ;;
    *) _bad "unknown argument: $1" ;;
    esac
    shift
done

# SAFETY: the host lands in ssh's argv and the directory inside a remote
# shell command, quoted with ''. A host starting with - is an ssh option
# (-oProxyCommand=...), and a directory with a quote in it ends the quoting.
[[ -n "$REMOTE_HOST" ]] || _bad "no destination: give --host HOST (or BACKUP_REMOTE_HOST)"
[[ "$REMOTE_HOST" =~ ^[A-Za-z0-9_][A-Za-z0-9_.@-]*$ ]] || _bad "'$REMOTE_HOST' is not a host name"
[[ "$REMOTE_DIR" =~ ^/[A-Za-z0-9_./+-]*$ ]] || _bad "--dest-dir must be an absolute path of plain characters: '$REMOTE_DIR'"

# Root first: the log below lives in /var/log, and as a user its mkdir failed
# before the "must run as root" message could be printed.
[[ "$(id -u)" -eq 0 ]] || {
    echo "kldload-backup-pack: must run as root (zfs send)" >&2
    exit 1
}

LOG=/var/log/kldload/backup-pack.log
mkdir -p /var/log/kldload
TTY=0
[[ -t 2 ]] && TTY=1
exec > >(tee -a "$LOG") 2>&1
log() { printf '[%(%F %T)T] [pack] %s\n' -1 "$*"; }

command -v zfs >/dev/null || {
    log "FATAL: zfs not installed"
    exit 1
}
command -v zstd >/dev/null || {
    log "FATAL: zstd not installed"
    exit 1
}
command -v ssh >/dev/null || {
    log "FATAL: ssh not installed"
    exit 1
}

# Auto-detect source dataset: take the dataset mounted at /.
if [[ -z "$SOURCE_DATASET" ]]; then
    if ((FULL_POOL)); then
        SOURCE_DATASET="$(findmnt -no SOURCE / | cut -d/ -f1)"
        [[ -n "$SOURCE_DATASET" ]] || {
            log "FATAL: could not detect root pool"
            exit 1
        }
    else
        SOURCE_DATASET="$(findmnt -no SOURCE /)"
        [[ -n "$SOURCE_DATASET" ]] || {
            log "FATAL: could not detect root dataset"
            exit 1
        }
    fi
fi
log "source dataset: ${SOURCE_DATASET}"

zfs list -H -o name "$SOURCE_DATASET" >/dev/null 2>&1 ||
    {
        log "FATAL: ${SOURCE_DATASET} is not a ZFS dataset"
        exit 1
    }

# Reachability + dir bootstrap on remote.
log "verifying ssh access to ${REMOTE_HOST}..."
# shellcheck disable=SC2086
ssh $SSH_OPTS "$REMOTE_HOST" "mkdir -p '$REMOTE_DIR' && [ -w '$REMOTE_DIR' ]" ||
    {
        log "FATAL: cannot reach ${REMOTE_HOST} or write to ${REMOTE_DIR}"
        exit 1
    }
log "remote ready: ${REMOTE_HOST}:${REMOTE_DIR}"

HOSTNAME_SHORT="$(hostname -s)"
TS="$(date -u +%Y%m%dT%H%M%SZ)"
SNAP="${SOURCE_DATASET}@backup-${TS}"
REMOTE_NAME="${HOSTNAME_SHORT}-${TS}.zfs.zst"
REMOTE_META="${HOSTNAME_SHORT}-${TS}.meta"

# Atomic snapshot. -r includes children so the send stream is consistent.
log "taking recursive snapshot: ${SNAP}"
zfs snapshot -r "$SNAP"

cleanup() {
    if ((KEEP_SNAP == 0)); then
        log "removing local backup snapshot: ${SNAP}"
        # a failure here must not replace the run's own exit status; say it
        zfs destroy -r "$SNAP" || log "WARNING: could not remove ${SNAP}; remove it by hand"
    else
        log "keeping local backup snapshot (--keep-snapshot): ${SNAP}"
    fi
}
trap cleanup EXIT

# WHY raw when anything is encrypted: ZFS refuses `send -R` of an encrypted
# dataset without -w ("may not be sent with properties without the raw
# flag"), and every encrypted kldload install is one -- this tool could not
# back up onyx at all (2026-09-29). Raw keeps the stream encrypted: the backup
# host stores ciphertext and never needs the key, and a restore needs the
# dataset's passphrase or key to mount it.
SEND_FLAGS=(-R)
RAW=0
if zfs get -H -r -o value encryption "$SOURCE_DATASET" | grep -qvx off; then
    SEND_FLAGS=(-R -w)
    RAW=1
    log "encrypted datasets in ${SOURCE_DATASET}: sending raw -- the stream stays encrypted, and a restore needs the key"
fi

# Size estimate (uncompressed bytes the send would emit), a sanity check only:
# if the dry run fails the real send below will say why, so it is not fatal.
SIZE_BYTES="$(zfs send -nP "${SEND_FLAGS[@]}" "$SNAP" 2>/dev/null | awk '/^size/{print $2}' | tail -1)" || SIZE_BYTES=""
log "estimated uncompressed stream size: ${SIZE_BYTES:-unknown} bytes"

# zstd -T0 uses all cores; -3 is fast and the WAN is the bottleneck anyway.
# pv is nice for live throughput but optional — only insert if installed.
# pv only for a person watching: its progress line is noise in the log, and
# where SIGPIPE is ignored (systemd services, by default) a pv whose reader
# died sleeps in a retry loop instead of exiting -- a failed receive hung the
# restore for good (onyx, 2026-09-29). TTY is decided before the log's exec.
PV="cat"
if ((TTY)) && command -v pv >/dev/null 2>&1; then PV="pv -prtab"; fi

log "sending → ${REMOTE_HOST}:${REMOTE_DIR}/${REMOTE_NAME}"
# shellcheck disable=SC2086
if ! zfs send "${SEND_FLAGS[@]}" "$SNAP" |
    $PV |
    zstd -T0 -3 --long |
    ssh $SSH_OPTS "$REMOTE_HOST" "cat > '${REMOTE_DIR}/${REMOTE_NAME}'"; then
    log "FATAL: send pipeline failed (check ssh + remote disk space)"
    exit 1
fi

# Verify the remote file exists and grab its size.
# shellcheck disable=SC2086
REMOTE_SIZE="$(ssh $SSH_OPTS "$REMOTE_HOST" "stat -c %s '${REMOTE_DIR}/${REMOTE_NAME}'" 2>/dev/null || echo 0)"
[[ "$REMOTE_SIZE" -gt 0 ]] ||
    {
        log "FATAL: remote file is empty or missing"
        exit 1
    }
log "remote file: ${REMOTE_SIZE} bytes compressed"

# Sidecar metadata. Plain text so it's grep-able from any host.
# The heredoc is data for the remote cat's stdin, expanded HERE on purpose
# (these are this host's facts); SC2087 reads it as a remote script.
# shellcheck disable=SC2086,SC2087
ssh $SSH_OPTS "$REMOTE_HOST" "cat > '${REMOTE_DIR}/${REMOTE_META}'" <<META
source_host=${HOSTNAME_SHORT}
source_dataset=${SOURCE_DATASET}
source_snapshot=backup-${TS}
created_utc=${TS}
created_local=$(date -Is)
stream_bytes_compressed=${REMOTE_SIZE}
stream_bytes_estimated_raw=${SIZE_BYTES:-unknown}
send_raw=${RAW}
kldload_edition=$(cat /etc/kldload/edition 2>/dev/null || echo unknown)
kldload_profile=$(cat /etc/kldload/profile 2>/dev/null || echo unknown)
kernel=$(uname -r)
META

log "DONE"
log "  remote: ${REMOTE_HOST}:${REMOTE_DIR}/${REMOTE_NAME}"
log "  meta:   ${REMOTE_HOST}:${REMOTE_DIR}/${REMOTE_META}"
# the restore command as it must be typed: it has no default host either
_dir_arg=""
[[ "$REMOTE_DIR" == /var/lib/kldload-backups ]] || _dir_arg=" --src-dir ${REMOTE_DIR}"
log "  to restore: sudo kldload-backup-restore --host ${REMOTE_HOST}${_dir_arg} --file ${REMOTE_NAME}"
