#!/usr/bin/env bash
# kldload-autoinstall — unattended installer triggered by a KLDLOADSEED disk.
#
# Called by kldload-autoinstall.service on live ISO boot.
# Scans for a FAT32 volume labelled KLDLOADSEED, reads answers.env from it,
# and runs kldload-install-target --config <answers>.
#
# To create a seed disk (32 MB FAT32, label KLDLOADSEED, contains answers.env):
# No hyphen: a FAT label is 11 characters and KLDLOAD-SEED is 12, so
# mkfs.vfat refuses to create it. This header told operators to make a
# label that cannot exist until 2026-09-11; the lookup below has the
# longer form in its candidate list anyway, so nothing breaks either way.
#   ./deploy.sh seed-disk --answers /etc/kldload/answers/zfs-single-disk.env
#
# Exits 0 silently if no seed disk is found (safe to enable unconditionally).
#
# Test hooks (tests/smoke-unit.sh), all unset in real use:
#   KLDLOAD_AUTOINSTALL_CMDLINE  a file to read instead of /proc/cmdline
#   KLDLOAD_AUTOINSTALL_LOG      a log path instead of /var/log/installer
#   KLDLOAD_AUTOINSTALL_DRYRUN=1 print the assembled answers and exit 0 before
#                                anything is installed
#   KLDLOAD_AUTOINSTALL_RUNDIR   instead of /run/kldload, for the secrets handshake
#   KLDLOAD_AUTOINSTALL_STOP_BEFORE_EXEC=1  print the final answers and exit 0
#                                where the installer would be exec'd
#   KLDLOAD_SECRETS_TIMEOUT      seconds to wait for secrets typed on screen (3600)
set -Eeuo pipefail

LOG="${KLDLOAD_AUTOINSTALL_LOG:-/var/log/installer/autoinstall.log}"
_CMDLINE_FILE="${KLDLOAD_AUTOINSTALL_CMDLINE:-/proc/cmdline}"
mkdir -p "$(dirname "$LOG")"
# fd 3 keeps the ORIGINAL stdout: the test hooks print the assembled answers
# there, because everything on stdout below is also written to the log, and the
# answers can carry secrets typed at the netboot menu.
exec 3>&1
exec > >(tee -a "$LOG") 2>&1

log() { printf '[%(%F %T)T] [autoinstall] %s\n' -1 "$*"; }

# _whole_disk <dev> — resolve a partition/dev to its backing whole disk (/dev/…).
# Returns empty (rc 0) if it can't be resolved, so callers can compare safely.
_whole_disk() {
    local dev="$1" pk
    [[ "$dev" == /dev/* ]] || return 0
    pk="$(lsblk -no PKNAME "$dev" 2>/dev/null | awk 'NF{print;exit}')"
    if [[ -n "$pk" ]]; then
        echo "/dev/$pk"
    else # already a whole disk (no parent)
        echo "$dev"
    fi
}

# _live_disk — the whole disk the live ISO/USB booted from. NEVER an install
# target: auto-picking it would wipe the installer out from under itself, and
# the box then reboots into nothing. Empty if it can't be determined.
_live_disk() {
    local m src
    for m in /run/initramfs/live /run/live/medium /lib/live/mount/medium; do
        src="$(findmnt -no SOURCE "$m" 2>/dev/null)"
        [[ -n "$src" ]] && break
    done
    [[ -n "$src" ]] || src="$(findmnt -no SOURCE / 2>/dev/null)"
    _whole_disk "$src"
}

# ── Find seed disk ────────────────────────────────────────────────────────────

# ── Seed from the kernel cmdline (netboot) ───────────────────────────────────
# kldload.seed=http://deploy.example/answers/aa-bb-cc-dd-ee-ff.env
#
# WHY: the seed DISK is a physical opt-in -- somebody walked over and plugged
# it in, and that consent is what makes an unattended installer safe to enable
# unconditionally. Over PXE there is no stick to plug, so the equivalent
# instruction arrives on the kernel cmdline, which only the netboot server that
# armed this machine can set. That server is the opt-in.
#
# It is checked BEFORE the seed disk on purpose: a cmdline is per-boot intent,
# a forgotten USB stick in the front panel is not.
#
# SAFETY: a fetch that fails does NOT fall through to the seed disk or to the
# baked-in answers. A machine told to install from a specific URL must never
# quietly install something else instead -- and a 404 is the normal, expected
# answer for a machine that is simply not armed.
ANSWERS_TMP=""
# One seed, or none. The netboot menu puts typed text (a hostname) on this
# cmdline, and the parse below takes the LAST kldload.seed= -- so a second one
# typed into a field would silently replace the armed answers. A machine whose
# cmdline names two answer sources installs from neither (2026-09-18).
_seed_count="$(tr ' ' '\n' <"$_CMDLINE_FILE" 2>/dev/null | grep -c '^kldload\.seed=' || true)" # grep -c prints 0 and exits 1 on no match, the normal case
if [[ "${_seed_count:-0}" -gt 1 ]]; then
    log "REFUSING: ${_seed_count} kldload.seed= on the kernel cmdline — expected one. NOT installing."
    exit 1
fi
# (^|.*space), not just (space): an iPXE-built cmdline can put kldload.seed
# first with nothing before it. Caught by the parser test, not by reading it.
SEED_URL="$(sed -nE 's/(^|.*[[:space:]])kldload\.seed=([^[:space:]]*).*/\2/p' "$_CMDLINE_FILE" 2>/dev/null || true)"
if [[ -n "$SEED_URL" ]]; then
    case "$SEED_URL" in
    http://* | https://*) ;;
    *)
        log "REFUSING: kldload.seed must be http(s) — got: ${SEED_URL}"
        exit 0
        ;;
    esac
    log "Seed URL on cmdline: ${SEED_URL}"
    _tmp="$(mktemp /tmp/kldload-answers.XXXXXX.env)"
    # --retry covers a NIC that is up but whose switch port is still learning;
    # -f makes a 404 an error rather than a file full of HTML.
    if curl -fsS --retry 4 --retry-delay 2 --max-time 60 -o "$_tmp" "$SEED_URL"; then
        ANSWERS_TMP="$_tmp"
        log "Answers fetched from ${SEED_URL}"
    else
        rm -f "$_tmp"
        log "Seed URL did not answer (not armed, or unreachable) — NOT installing"
        exit 0
    fi
fi

[[ -n "$ANSWERS_TMP" ]] || log "Scanning for KLDLOADSEED disk..."

SEED_DEV=""

# Try /dev/disk/by-label first (udev symlink)
# KLDLOADSEED, not KLDLOAD-SEED: a FAT label is 11 characters and the
# hyphenated form is 12, so mkfs.vfat refuses to create it. This script
# searched for a label that could not exist on the filesystem a seed disk
# uses -- found 2026-09-07, the first time anyone tried to make one. The
# longer spellings stay in the list because they are achievable on ext4
# and cost nothing to check.
for candidate in /dev/disk/by-label/KLDLOADSEED /dev/disk/by-label/kldloadseed \
    /dev/disk/by-label/KLDLOAD-SEED /dev/disk/by-label/kldload-seed; do
    if [[ -b "$candidate" ]]; then
        SEED_DEV="$(readlink -f "$candidate")"
        break
    fi
done

# Fallback: blkid scan
if [[ -z "$SEED_DEV" ]]; then
    SEED_DEV="$(blkid -o device -t LABEL=KLDLOADSEED 2>/dev/null | head -1 ||
        blkid -o device -t LABEL=KLDLOAD-SEED 2>/dev/null | head -1 || true)"
fi

if [[ -z "$ANSWERS_TMP" && -n "$SEED_DEV" ]]; then
    log "Found seed disk: $SEED_DEV"

    # ── Mount and read answers from seed disk ────────────────────────────────
    SEED_MNT="$(mktemp -d)"
    mount -o ro "$SEED_DEV" "$SEED_MNT"

    ANSWERS="$SEED_MNT/answers.env"
    if [[ -f "$ANSWERS" ]]; then
        ANSWERS_TMP="$(mktemp /tmp/kldload-answers.XXXXXX.env)"
        cp "$ANSWERS" "$ANSWERS_TMP"
        log "Answers loaded from seed disk: $ANSWERS_TMP"
    else
        log "WARNING: answers.env not found on seed disk"
    fi
    umount "$SEED_MNT" || true
    rmdir "$SEED_MNT" || true
fi

# ── Fallback: baked-in answers file ──────────────────────────────────────────
if [[ -z "$ANSWERS_TMP" && -f /etc/kldload/autoinstall.env ]]; then
    ANSWERS_TMP="$(mktemp /tmp/kldload-answers.XXXXXX.env)"
    cp /etc/kldload/autoinstall.env "$ANSWERS_TMP"
    log "Answers loaded from baked-in /etc/kldload/autoinstall.env"
fi

# ── Answers from the kernel command line ─────────────────────────────────────
# kldload.distro=fedora kldload.profile=desktop kldload.timezone=America/Denver
#
# WHY: the PXE boot menu has to get the operator's choices to the installer, and
# a cascading iPXE menu can compose a cmdline but cannot write a file on the
# server. This is the same channel kldload.seed= already travels on, extended to
# carry the rest of the answers, so a netboot install needs no per-MAC file at
# all when the choices come from a menu.
#
# These keys OVERRIDE a seed file when both are present -- a cmdline is this
# boot's intent, a seed is standing configuration -- and on their own they are
# enough to drive a whole install.
#
# SECRETS (kldload.password, .passphrase, .rhel_user, .rhel_pass) come from the
# netboot menu's masked credentials form (operator, 2026-09-18: "asked during
# the install menu, not after"), URI-encoded. They live on THIS live boot's
# cmdline and in the 0600 answers below -- RAM, gone at the reboot. The
# installed system boots its own cmdline (ZFSBootMenu), never this one. So they
# are accepted, decoded, and NEVER logged; the effective config copied to the
# installed system redacts them by name (answers.sh). Anything missing is asked
# for on the screen further down.
#
# Values are validated against a per-key pattern, not merely quoted. The normal
# reader (k_answers_load_env_file) parses line by line and never executes, but
# kldload-install-target keeps a fallback that SOURCES the file under `set -a`
# when that library is missing, and there an unvalidated value is code execution
# as root during a disk wipe.
_cmdline_raw="$(cat "$_CMDLINE_FILE" 2>/dev/null || true)"

# Secrets from the menu, decoded; written below, after the seed is in place.
_urldecode() { printf '%b' "${1//%/\\x}"; }
declare -A _menu_secret=()
for _spec in password:KLDLOAD_PASSWORD passphrase:KLDLOAD_ZFS_PASSPHRASE \
    rhel_user:KLDLOAD_RHEL_USERNAME rhel_pass:KLDLOAD_RHEL_PASSWORD; do
    _k="${_spec%%:*}"
    _raw="$(sed -nE "s/(^|.*[[:space:]])kldload\.${_k}=([^[:space:]]*).*/\2/p" <<<"$_cmdline_raw")"
    [[ -n "$_raw" ]] || continue
    _val="$(_urldecode "$_raw")"
    if [[ "$_val" == *$'\n'* || "$_val" == *$'\r'* || ${#_val} -gt 256 ]]; then
        log "IGNORING kldload.${_k}= from the menu: a line break or over 256 characters (asked on screen instead)"
        continue
    fi
    if [[ "$_k" == passphrase && ${#_val} -lt 8 ]]; then
        log "IGNORING kldload.passphrase= from the menu: ZFS needs 8 or more characters (asked on screen instead)"
        continue
    fi
    _menu_secret["${_spec#*:}"]="$_val"
    log "  cmdline: ${_spec#*:}=(from the menu, not logged)"
done

# ── Action dispatch: install (default), deploy, rollback ─────────────────────
# The netboot menu offers more than "install". A machine that will not boot
# needs its previous boot environment back; a machine being provisioned from a
# golden wants a ZFS receive, not a package install. Both reuse this same
# cmdline channel, and both run in the SAME live environment the installer uses.
#
# WHY a receive rather than an install: it is one verified artefact instead of N
# package transactions, there is no upstream to fail, and there is no per-machine
# DKMS build -- the slowest and most fragile part of every install. It does NOT
# remove the package path, which is what builds the golden in the first place.
_kld_action="$(sed -nE 's/(^|.*[[:space:]])kldload\.action=([^[:space:]]*).*/\2/p' <<<"$_cmdline_raw")"
_kld_source="$(sed -nE 's/(^|.*[[:space:]])kldload\.source=([^[:space:]]*).*/\2/p' <<<"$_cmdline_raw")"
_kld_be="$(sed -nE 's/(^|.*[[:space:]])kldload\.be=([^[:space:]]*).*/\2/p' <<<"$_cmdline_raw")"
_kld_pool="$(sed -nE 's/(^|.*[[:space:]])kldload\.pool=([^[:space:]]*).*/\2/p' <<<"$_cmdline_raw")"
_kld_disk="$(sed -nE 's/(^|.*[[:space:]])kldload\.disk=([^[:space:]]*).*/\2/p' <<<"$_cmdline_raw")"
_kld_host="$(sed -nE 's/(^|.*[[:space:]])kldload\.hostname=([^[:space:]]*).*/\2/p' <<<"$_cmdline_raw")"
_kld_url="$(sed -nE 's/(^|.*[[:space:]])kldload\.archive-url=([^[:space:]]*).*/\2/p' <<<"$_cmdline_raw")"
: "${_kld_pool:=rpool}"

if [[ -n "$_kld_action" ]]; then
    case "$_kld_action" in
    install) ;; # fall through to the normal path below
    deploy)
        # kldload.action=deploy kldload.disk=/dev/X and ONE of:
        #   kldload.source=host:dataset   (ssh; the archive host sends)
        #   kldload.archive-url=http://…  (a golden stream over HTTP; no keys --
        #                                  what kldload-netboot-server arm-deploy
        #                                  writes, so a rack clones without ssh)
        if [[ -n "$_kld_url" ]]; then
            [[ -z "$_kld_source" ]] ||
                {
                    log "REFUSING: give kldload.source OR kldload.archive-url, not both"
                    exit 1
                }
            [[ "$_kld_url" =~ ^https?://[A-Za-z0-9._:/-]+$ ]] ||
                {
                    log "REFUSING: kldload.archive-url is not a plain http(s) URL — got '${_kld_url}'"
                    exit 1
                }
        else
            [[ "$_kld_source" =~ ^[a-zA-Z0-9._-]+:[a-zA-Z0-9._/-]+$ ]] ||
                {
                    log "REFUSING: kldload.source must be host:dataset — got '${_kld_source}'"
                    exit 1
                }
        fi
        [[ "$_kld_disk" =~ ^/dev/[a-zA-Z0-9/_-]{1,64}$ ]] ||
            {
                log "REFUSING: deploy needs kldload.disk=/dev/... (it REPARTITIONS that disk)"
                exit 1
            }
        [[ -b "$_kld_disk" ]] ||
            {
                log "REFUSING: ${_kld_disk} is not a block device on this machine"
                exit 1
            }
        [[ -x /usr/local/sbin/kldload-restore-machine ]] ||
            {
                log "FATAL: kldload-restore-machine is not in this image"
                exit 1
            }
        if [[ -n "$_kld_host" ]] && ! [[ "$_kld_host" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]]; then
            log "REFUSING: kldload.hostname='${_kld_host}' is not a valid hostname"
            exit 1
        fi
        [[ "$_kld_pool" =~ ^[a-zA-Z0-9._-]{1,64}$ ]] ||
            {
                log "REFUSING: kldload.pool='${_kld_pool}' is not a valid pool name"
                exit 1
            }
        # exec replaces this shell: anything we would have cleaned up must go
        # now. A seed file fetched earlier can hold KLDLOAD_PASSWORD.
        [[ -n "${ANSWERS_TMP:-}" && -f "$ANSWERS_TMP" ]] && rm -f "$ANSWERS_TMP"
        if [[ -n "$_kld_url" ]]; then
            log "DEPLOY: receiving golden ${_kld_url} onto ${_kld_disk}"
            log "  This REPARTITIONS ${_kld_disk}. Pool: ${_kld_pool}"
            exec /usr/local/sbin/kldload-restore-machine \
                --archive-url "$_kld_url" \
                --disk "$_kld_disk" --pool "$_kld_pool" \
                ${_kld_host:+--hostname "$_kld_host"} --yes
        fi
        _dep_host="${_kld_source%%:*}"
        _dep_ds="${_kld_source#*:}"
        log "DEPLOY: receiving ${_dep_ds} from ${_dep_host} onto ${_kld_disk}"
        log "  This REPARTITIONS ${_kld_disk}. Pool: ${_kld_pool}"
        exec /usr/local/sbin/kldload-restore-machine \
            --archive-host "$_dep_host" --archive "$_dep_ds" \
            --disk "$_kld_disk" --pool "$_kld_pool" \
            ${_kld_host:+--hostname "$_kld_host"} --yes
        ;;
    rollback)
        # Deliberately NOT automatic. A netboot server cannot know this
        # machine's boot environments, and picking one blind is how you roll a
        # machine back past the change you were trying to keep. Without an
        # explicit kldload.be= this LISTS and stops.
        # Import READ-ONLY to look. Only a named kldload.be= needs read-write
        # (zpool set bootfs), and only then is -f used -- forcing past an
        # "in use by another system" claim on shared SAS is a split-brain
        # import, so it is never done just to list.
        if [[ -z "$_kld_be" ]]; then
            log "ROLLBACK: importing ${_kld_pool} READ-ONLY to list its boot environments"
            _imp_flags=(-N -o readonly=on)
        else
            log "ROLLBACK: importing ${_kld_pool} read-write (forced) to set bootfs=${_kld_be}"
            _imp_flags=(-N -f)
        fi
        if ! zpool import "${_imp_flags[@]}" "$_kld_pool" 2>/dev/null && ! zpool list "$_kld_pool" >/dev/null 2>&1; then
            log "FATAL: could not import pool '${_kld_pool}' — nothing to roll back"
            exit 1
        fi
        log "  bootfs is currently: $(zpool get -H -o value bootfs "$_kld_pool" 2>/dev/null)"
        log "  available boot environments:"
        zfs list -H -o name -r "${_kld_pool}/ROOT" 2>/dev/null | sed 's/^/    /'
        if [[ -z "$_kld_be" ]]; then
            log ""
            log "  No kldload.be= given, so NOTHING was changed."
            log "  Re-netboot with kldload.action=rollback kldload.be=<one of the above>"
            log "  or work here directly: the pool is imported and zfs/zpool are present."
            exit 0
        fi
        zfs list -H -o name "$_kld_be" >/dev/null 2>&1 ||
            {
                log "REFUSING: '${_kld_be}' is not a dataset in this pool"
                exit 1
            }
        log "  setting bootfs=${_kld_be}"
        zpool set "bootfs=${_kld_be}" "$_kld_pool" ||
            {
                log "FATAL: could not set bootfs"
                exit 1
            }
        # Outcome, not exit code.
        [[ "$(zpool get -H -o value bootfs "$_kld_pool")" == "$_kld_be" ]] ||
            {
                log "FATAL: bootfs did not change"
                exit 1
            }
        log "ROLLBACK complete: ${_kld_pool} will boot ${_kld_be}. Reboot when ready."
        exit 0
        ;;
    *)
        log "REFUSING: unknown kldload.action='${_kld_action}' (install|deploy|rollback)"
        exit 1
        ;;
    esac
fi

# key:VARNAME:validation-regex. Anything not listed here is ignored, so a typo
# is inert rather than surprising, and adding a key is one line.
_cmdline_applied=0
for _spec in \
    "distro:KLDLOAD_DISTRO:^(arch|centos|debian|fedora|rhel|rocky|ubuntu)$" \
    "profile:KLDLOAD_PROFILE:^[a-z][a-z0-9-]{0,31}$" \
    "hostname:KLDLOAD_HOSTNAME:^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$" \
    "disk:KLDLOAD_DISK:^/dev/[a-zA-Z0-9/_-]{1,64}$" \
    "username:KLDLOAD_USERNAME:^[a-z_][a-z0-9_-]{0,31}$" \
    "timezone:KLDLOAD_TIMEZONE:^[A-Za-z0-9+_-]{1,24}(/[A-Za-z0-9+_-]{1,24}){0,2}$" \
    "locale:KLDLOAD_LOCALE:^[a-z]{2,3}_[A-Z]{2}\.(UTF-8|utf8)$" \
    "keyboard:KLDLOAD_KEYBOARD_LAYOUT:^[a-z0-9-]{1,16}$" \
    "suite:KLDLOAD_SUITE:^[a-z0-9._-]{1,32}$" \
    "zfs:KLDLOAD_ENABLE_ZFS:^[01]$" \
    "encrypt:KLDLOAD_ZFS_ENCRYPT:^[01]$" \
    "topology:KLDLOAD_ZFS_TOPOLOGY:^[a-z0-9]{1,16}$" \
    "secureboot:KLDLOAD_ENABLE_SECURE_BOOT:^[01]$" \
    "buildimages:KLDLOAD_BUILD_IMAGES:^[01]$" \
    "keepnetboot:KLDLOAD_KEEP_NETBOOT:^[01]$" \
    "kvm:KLDLOAD_ENABLE_KVM:^[01]$" \
    "k8s:KLDLOAD_ENABLE_K8S:^[01]$" \
    "k8sbootstrap:KLDLOAD_K8S_BOOTSTRAP:^[01]$" \
    "zfsdev:KLDLOAD_KLAB_ZFS_DEV:^[01]$" \
    "ai:KLDLOAD_ENABLE_AI:^[01]$" \
    "template:KLDLOAD_TEMPLATE:^(none|kvm|k8s|zfslab)$"; do
    _k="${_spec%%:*}"
    _rest="${_spec#*:}"
    _var="${_rest%%:*}"
    _re="${_rest#*:}"
    # (^|.*space) so a key sitting first on the line is still matched -- the
    # same shape kldload.seed= needed, and the same bug it had.
    _val="$(sed -nE "s/(^|.*[[:space:]])kldload\.${_k}=([^[:space:]]*).*/\2/p" <<<"$_cmdline_raw")"
    [[ -n "$_val" ]] || continue
    if ! [[ "$_val" =~ $_re ]]; then
        log "REFUSING: kldload.${_k}=${_val} does not match ${_re}"
        log "  An answers file is read as root just before a disk wipe. NOT installing."
        exit 1
    fi
    if [[ -z "$ANSWERS_TMP" ]]; then
        ANSWERS_TMP="$(mktemp /tmp/kldload-answers.XXXXXX.env)"
        log "Building answers from the kernel cmdline (no seed file present)"
    fi
    # template=none CLEARS the template: the netboot menu's checkboxes decide
    # what builds, and a k8s answers file must not bring Kubernetes back after
    # it was unticked (autodeploy turns the template itself into build work).
    [[ "$_k" == template && "$_val" == none ]] && _val=""
    if grep -q "^${_var}=" "$ANSWERS_TMP"; then
        sed -i "s|^${_var}=.*|${_var}=${_val}|" "$ANSWERS_TMP"
    else
        printf '%s=%s\n' "$_var" "$_val" >>"$ANSWERS_TMP"
    fi
    log "  cmdline: ${_var}=${_val}"
    _cmdline_applied=$((_cmdline_applied + 1))
done
((_cmdline_applied == 0)) || log "Applied ${_cmdline_applied} answer(s) from the kernel cmdline"
if [[ -n "${KLDLOAD_AUTOINSTALL_DRYRUN:-}" && -n "$ANSWERS_TMP" ]]; then
    cat "$ANSWERS_TMP" >&3
    rm -f "$ANSWERS_TMP"
    exit 0
fi

if [[ -z "$ANSWERS_TMP" ]]; then
    log "No answers file found (no seed disk, no cmdline keys, no /etc/kldload/autoinstall.env) — skipping autoinstall"
    exit 0
fi

# A cmdline-only install still has to name a distro: everything downstream keys
# off it, and an answers file without one installs nothing while looking fine.
if ! grep -q '^KLDLOAD_DISTRO=.' "$ANSWERS_TMP"; then
    log "REFUSING: no KLDLOAD_DISTRO in the answers — nothing to install."
    exit 1
fi

# ── Auto-detect disk if not set ───────────────────────────────────────────────

if ! grep -q "^KLDLOAD_DISK=" "$ANSWERS_TMP" ||
    grep -q "^KLDLOAD_DISK=$" "$ANSWERS_TMP"; then
    # ── Disk inventory and target selection ──────────────────────────────────
    # Replaces a five-entry hardcoded device list that only understood ZFS.
    #
    # The old loop looked at /dev/sda, vda, xvda, nvme0n1 and mmcblk0 and
    # nothing else, so on any chassis with more than a handful of bays it never
    # SAW most of the disks. Worse, it classified a disk as free unless blkid
    # called a partition zfs_member -- so LVM, mdraid, LUKS, a foreign
    # filesystem, or FreeBSD GELI all read as "empty" and became install
    # targets. abyss, 2026-09-11: eight 15 TB GELI members present as blank
    # unpartitioned disks to Linux, and were the most attractive candidates on
    # the machine.
    #
    # The rule now is that "I do not recognise this" and "this is empty" are
    # DIFFERENT answers, and only the second one makes a disk a candidate.
    _live="$(_live_disk)"
    _seed="$(_whole_disk "${SEED_DEV:-}")"
    log "Excluded from selection: live=${_live:-none} seed=${_seed:-none}"

    # _disk_ident <dev> — the STABLE identifier for this disk: a /dev/disk/by-id
    # path derived from the serial burned in at manufacture. The labeling
    # masterclass is unambiguous about this -- "a pool created with /dev/sda
    # through /dev/sdx is a ticking time bomb ... use /dev/disk/by-id/ always"
    # -- because a kernel name moves when you plug in a USB stick or replace a
    # drive at 3am.
    #
    # Prefers the vendor/model/serial path (ata-…, nvme-<model>_<serial>, scsi-…)
    # because that is what a human reads off the label; wwn- is the fallback
    # when no such path exists; the kernel name only when the device exposes no
    # stable identity at all. (An earlier comment claimed wwn first -- the code
    # never did that.) PERF: walks all of /dev/disk/by-id with a readlink per
    # link, per disk; ~10k forks on a 45-bay chassis. Slow, not wrong.
    _disk_ident() {
        local d="$1" _l _best="" _wwn=""
        for _l in /dev/disk/by-id/*; do
            [[ -L "$_l" ]] || continue
            [[ "$(readlink -f "$_l")" == "$d" ]] || continue
            case "${_l##*/}" in
            wwn-*) _wwn="$_l" ;;
            *-part*) ;;
            *) [[ -z "$_best" ]] && _best="$_l" ;;
            esac
        done
        printf '%s' "${_best:-${_wwn:-$d}}"
    }

    # _disk_slot <dev> — the physical enclosure slot, when the chassis reports
    # one. by-slot symlinks come from udev rules; SES is the fallback and is
    # what a JBOD actually exposes. Empty when neither is available.
    #
    # WHY model, serial, by-id and slot are gathered here and not just the
    # device name: they are the fields a physical drive label carries, and this
    # is the only place that already has to read every disk anyway.
    #
    # The labeling design they feed, decided 2026-09-11, NOT yet built:
    #   * the STICKER carries only immutable facts -- asset id, serial, model,
    #     vendor, RMA url. Printed once at procurement, before the drive ships.
    #     It can never go stale because nothing on it can change.
    #   * the POOL carries the mutable assignment as com.kldload: user
    #     properties, so a drive that moves takes its record with it and a
    #     replicated dataset arrives with its tags intact.
    #   * ansible reconciles the two and reports drift. It generates labels for
    #     NEW and REPLACEMENT drives only, which is the one case where printing
    #     happens on a trip to the rack you were already making. Regenerating a
    #     sticker for a drive that merely moved produces a correct label on a
    #     printer and a wrong one still stuck to the drive.
    #
    # The missing piece is a JSON emit mode so nothing downstream parses these
    # log lines. Deliberately deferred until the install path is proven.
    _disk_slot() {
        local d="$1" _l _enc _s _blk
        for _l in /dev/disk/by-slot/*; do
            [[ -L "$_l" ]] || continue
            [[ "$(readlink -f "$_l")" == "$d" ]] && {
                printf '%s' "${_l##*/}"
                return
            }
        done
        for _enc in /sys/class/enclosure/*/*/; do
            [[ -d "$_enc" ]] || continue
            _blk="$(ls "${_enc}device/block/" 2>/dev/null | head -1)"
            [[ -n "$_blk" && "/dev/${_blk}" == "$d" ]] && {
                printf 'slot%s' "$(basename "$_enc")"
                return
            }
        done
    }

    # _disk_contents <dev> — describe what occupies this disk, or echo nothing
    # when it is genuinely blank. Checks, in order: a partition table, any
    # signature blkid knows on the whole device or any partition, and finally
    # GELI, whose metadata lives in the LAST sector and which blkid cannot see
    # at all. That last check is the one that matters on a machine migrating
    # off FreeBSD.
    _disk_contents() {
        local d="$1" _pt _t _p _out=""
        # lsblk failing outright means the device vanished or errors; that is
        # "unreadable", never "empty". blkid exiting 2 (no signature) is the
        # normal empty case and is fine; anything else is a probe failure.
        if ! _pt="$(lsblk -dn -o PTTYPE "$d" 2>/dev/null | tr -d ' ')"; then
            printf 'unreadable'
            return
        fi
        _t="$(blkid -o value -s TYPE "$d" 2>/dev/null)"
        [[ -n "$_t" ]] && _out="${_t}"
        # lsblk, not two globs: "$d"?* and "$d"p?* BOTH match nvme0n1p1, so
        # every partition on an nvme was counted twice and the contents string
        # came out as "vfat,zfs:rpool,vfat,zfs:rpool" (fiend, 2026-09-11).
        while read -r _p; do
            _p="/dev/${_p}"
            [[ -b "$_p" ]] || continue
            _t="$(blkid -o value -s TYPE "$_p" 2>/dev/null)"
            [[ -z "$_t" ]] && continue
            if [[ "$_t" == zfs_member ]]; then
                _out="${_out:+$_out,}zfs:$(blkid -o value -s LABEL "$_p" 2>/dev/null || echo '?')"
            else
                _out="${_out:+$_out,}${_t}"
            fi
        done < <(lsblk -ln -o NAME,TYPE "$d" 2>/dev/null | awk '$2=="part"{print $1}')
        # GELI: magic string at the start of the final PROVIDER SECTOR. blkid
        # reports nothing for it, which is precisely why it is checked by hand.
        # Read the last 4096 bytes, not 512: on a native-4Kn drive the last
        # sector is 4096 wide and the magic sits at size-4096, outside a
        # 512-byte read. abyss's da* are 512e so the short read passed there;
        # a 4Kn SAS drive would have classified as empty (review, 2026-09-11).
        if [[ -z "$_out" ]]; then
            local _sz _tail
            if ! _sz="$(blockdev --getsize64 "$d" 2>/dev/null)" || ((_sz < 8192)); then
                # Cannot size it, or too small to carry anything: NOT "empty".
                _out="unreadable"
            elif ! _tail="$(dd if="$d" bs=4096 count=1 skip=$(((_sz / 4096) - 1)) status=none 2>/dev/null | tr -d '\0')"; then
                # A read error is the signature of a dying drive, which is the
                # most likely blank-looking disk on any chassis. Silence here
                # used to classify it as an install candidate.
                _out="unreadable"
            elif [[ "$_tail" == *"GEOM::ELI"* ]]; then
                _out="geli"
            fi
        fi
        [[ -z "$_out" && -n "$_pt" ]] && _out="${_pt}-table"
        printf '%s' "$_out"
    }

    # Every whole disk the kernel knows about, not a guessed list.
    _all_disks=()
    while read -r _n; do
        [[ -b "/dev/$_n" ]] && _all_disks+=("/dev/$_n")
    done < <(lsblk -dn -o NAME,TYPE 2>/dev/null |
        awk '$2=="disk" && $1 !~ /^(zram|loop|ram|sr)[0-9]*$/ {print $1}')

    _candidates=()
    _reinstall=""
    log "Disk inventory (${#_all_disks[@]} disks):"
    for dev in "${_all_disks[@]}"; do
        _sz="$(lsblk -dn -o SIZE "$dev" 2>/dev/null | tr -d ' ')"
        if [[ "$dev" == "$_live" ]]; then
            log "  $(printf '%-14s %-8s %s' "$dev" "$_sz" 'live boot medium — never a target')"
            continue
        fi
        if [[ -n "$_seed" && "$dev" == "$_seed" ]]; then
            log "  $(printf '%-14s %-8s %s' "$dev" "$_sz" 'seed disk — never a target')"
            continue
        fi
        _ident="$(_disk_ident "$dev")"
        _slot="$(_disk_slot "$dev")"
        _mdl="$(lsblk -dn -o MODEL "$dev" 2>/dev/null | sed 's/  *$//')"
        _ser="$(lsblk -dn -o SERIAL "$dev" 2>/dev/null | tr -d ' ')"
        _what="$(_disk_contents "$dev")"
        if [[ -z "$_what" ]]; then
            log "  $(printf '%-14s %-8s %s' "$dev" "$_sz" 'empty — candidate')"
            log "      $(printf '%s%s%s' "${_ident}" "${_ser:+  serial ${_ser}}" "${_slot:+  ${_slot}}")"
            _candidates+=("$dev")
        elif [[ ",${_what}," != *",zfs:"* || ",${_what}," == *",zfs:rpool,"* ]] &&
            [[ "$(printf '%s' "$_what" | tr ',' '\n' | grep -vE '^(vfat|zfs:rpool)$' | wc -l)" -eq 0 ]]; then
            # ONLY our own rpool and its ESP. Anything else on the disk, even
            # alongside rpool, means it is not ours alone to destroy. Exact
            # string matching failed here: the real value is "vfat,zfs:rpool".
            log "  $(printf '%-14s %-8s %s' "$dev" "$_sz" 'carries rpool — reinstall candidate')"
            [[ -z "$_reinstall" ]] && _reinstall="$dev"
        else
            log "  $(printf '%-14s %-8s %s' "$dev" "$_sz" "IN USE (${_what}) — refusing")"
            log "      $(printf '%s%s%s%s' "${_ident}" "${_mdl:+  ${_mdl}}" "${_ser:+  serial ${_ser}}" "${_slot:+  ${_slot}}")"
        fi
    done

    # One candidate is unambiguous. More than one is a guess, and a guess on a
    # storage chassis destroys somebody's array. Refuse and name them instead.
    DETECTED=""
    if ((${#_candidates[@]} == 1)); then
        DETECTED="${_candidates[0]}"
    elif ((${#_candidates[@]} > 1)); then
        log "REFUSING: ${#_candidates[@]} disks are empty and equally valid targets:"
        for dev in "${_candidates[@]}"; do
            log "    $dev  ($(lsblk -dn -o SIZE "$dev" 2>/dev/null | tr -d ' '))"
        done
        log "  Set KLDLOAD_DISK explicitly. Guessing here wipes the wrong one."
        exit 1
    elif [[ -n "$_reinstall" ]]; then
        DETECTED="$_reinstall"
        log "No empty disk; using the existing rpool disk (a reinstall of this machine)"
    else
        log "REFUSING: no disk is free. Every disk is the live medium, the seed,"
        log "  or carries data this installer will not destroy on a guess."
        log "  Set KLDLOAD_DISK explicitly if you mean to overwrite one."
        exit 1
    fi

    # Record the STABLE path. The installer resolves it back to a kernel name
    # for partitioning (see kldload-install-target), but what gets written into
    # the answers file, the logs and any label is the by-id path, because that
    # is the one that still means something after a reboot.
    _DETECTED_ID="$(_disk_ident "$DETECTED")"
    log "Selected install disk: $DETECTED"
    [[ "$_DETECTED_ID" != "$DETECTED" ]] && log "  stable path: $_DETECTED_ID"
    # Write the STABLE path. kldload-install-target resolves it back to a
    # kernel name for partitioning and keeps the stable one for the manifest.
    if grep -q "^KLDLOAD_DISK=" "$ANSWERS_TMP"; then
        sed -i "s|^KLDLOAD_DISK=.*|KLDLOAD_DISK=${_DETECTED_ID}|" "$ANSWERS_TMP"
    else
        echo "KLDLOAD_DISK=${_DETECTED_ID}" >>"$ANSWERS_TMP"
    fi
fi

# ─── secrets the answers do not carry: asked for on this machine's screen ────
# The netboot menu's manual override can tick encryption on a machine whose
# answers file has no passphrase, and never carries a secret itself: iPXE could
# only put it on the kernel cmdline (world-readable on the installed system for
# ever) or in a URL. So the machine asks. This names what it needs in
# $_RUN/install-needs, the install show draws a form, the web UI -- from this
# machine's own screen only -- writes $_RUN/install-secrets (0600), and the
# install goes on. Nothing has touched a disk yet. (operator, 2026-09-18: "it
# never prompted me for enc".)
_RUN="${KLDLOAD_AUTOINSTALL_RUNDIR:-/run/kldload}"

# _answers_put <KEY> <line> — replace KEY's line in $ANSWERS_TMP with <line>.
# SAFETY: the replacement is created under umask 077. It used to be written
# with the default 022 and mv'd over the 0600 mktemp file, so the answers went
# WORLD-READABLE at the exact moment they gained a secret: fiend 2026-09-19,
# /tmp/kldload-answers.*.env at 0644 holding the Red Hat password, readable by
# the live user (password "live", sshd up). The rm clears a stale .new, whose
# old mode a truncating redirect would otherwise keep.
_answers_put() {
    rm -f "${ANSWERS_TMP}.new"
    (
        umask 077
        awk -v k="${1}=" 'index($0, k) != 1' "$ANSWERS_TMP" >"${ANSWERS_TMP}.new"
        printf '%s\n' "$2" >>"${ANSWERS_TMP}.new"
    )
    mv -f "${ANSWERS_TMP}.new" "$ANSWERS_TMP"
}

# The menu's secrets first: single-quoted for the loader, replacing any line the
# seed had (the menu is this boot's intent).
for _k in "${!_menu_secret[@]}"; do
    _answers_put "$_k" "${_k}='${_menu_secret[$_k]}'"
done
unset _menu_secret
_ans() { sed -n "s/^${1}=//p" "$ANSWERS_TMP" | tail -n 1 | sed -E "s/^([\"'])(.*)\1\$/\2/"; }
_need=()
[[ -n "$(_ans KLDLOAD_PASSWORD)" ]] || _need+=(password)
if [[ "$(_ans KLDLOAD_ZFS_ENCRYPT)" == 1 && -z "$(_ans KLDLOAD_ZFS_PASSPHRASE)" ]]; then
    _need+=(passphrase)
fi
# RHEL registers with Red Hat during the install: a username and password, or an
# activation key and org (bootstrap.sh). Asked for only when neither pair is here.
if [[ "$(_ans KLDLOAD_DISTRO)" == rhel ]] &&
    [[ -z "$(_ans KLDLOAD_RHEL_USERNAME)" || -z "$(_ans KLDLOAD_RHEL_PASSWORD)" ]] &&
    [[ -z "$(_ans KLDLOAD_RHEL_KEY)" || -z "$(_ans KLDLOAD_RHEL_ORG)" ]]; then
    _need+=(rhel)
fi
if ((${#_need[@]})); then
    install -d -m 0755 "$_RUN"
    rm -f "$_RUN/install-secrets"
    printf '%s\n' "${_need[*]}" >"$_RUN/.install-needs.$$"
    mv -f "$_RUN/.install-needs.$$" "$_RUN/install-needs"
    log "Waiting for ${_need[*]}, typed on this machine's screen (the install show asks)"
    _limit="${KLDLOAD_SECRETS_TIMEOUT:-3600}"
    _waited=0
    while [[ ! -s "$_RUN/install-secrets" ]]; do
        if ((_waited >= _limit)); then
            rm -f "$_RUN/install-needs"
            log "REFUSING: no ${_need[*]} after ${_limit}s — NOT installing. Netboot it again."
            exit 1
        fi
        sleep 2
        _waited=$((_waited + 2))
    done
    # Only the two keys this asked for, each replacing any line the answers
    # already had. The values never reach the log.
    _got=0
    while IFS= read -r _line; do
        case "$_line" in
        KLDLOAD_PASSWORD=?* | KLDLOAD_ZFS_PASSPHRASE=?* | KLDLOAD_RHEL_USERNAME=?* | KLDLOAD_RHEL_PASSWORD=?*)
            _answers_put "${_line%%=*}" "$_line"
            _got=$((_got + 1))
            ;;
        esac
    done <"$_RUN/install-secrets"
    rm -f "$_RUN/install-secrets" "$_RUN/install-needs"
    # rhel is two lines (username and password), the others one each.
    _want=${#_need[@]}
    [[ " ${_need[*]} " == *" rhel "* ]] && _want=$((_want + 1))
    if ((_got != _want)); then
        log "REFUSING: asked for ${_need[*]} (${_want} values), received ${_got} — NOT installing."
        exit 1
    fi
    log "Received ${_need[*]} from the screen"
fi

if [[ -n "${KLDLOAD_AUTOINSTALL_STOP_BEFORE_EXEC:-}" ]]; then
    cat "$ANSWERS_TMP" >&3
    exit 0
fi

log "Starting unattended install..."
log "  Answers: $ANSWERS_TMP"
log "  Log:     /var/log/installer/"
log ""

exec 3>&-
exec /usr/sbin/kldload-install-target --config "$ANSWERS_TMP"
