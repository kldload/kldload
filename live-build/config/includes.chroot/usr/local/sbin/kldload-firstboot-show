#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# kldload-firstboot-show — hold the screen while first boot builds what the
# install asked for, then hand over a finished machine.
#
# WHAT IT DOES, IN ORDER:
#   check   1. Decide whether this boot gets the show. Exit 0 yes, 1 no.
#   run     2. Switch the console to its own virtual terminal and draw, once a
#              second: the stages (first boot, then autodeploy's phase plan),
#              a progress bar, and the tail of the live log.
#           3. If this machine can draw part 2 of the show (cage, a browser, a
#              DRM device), start kldload-firstboot-kiosk.service, which takes
#              tty1 and puts firstboot.html full screen as soon as the web UI
#              answers. The console screen keeps drawing on VT8 underneath and
#              comes back into view if the kiosk fails for good.
#           4. When the build settles, show the outcome — a short "complete"
#              screen, or what failed and where its log is — stop the kiosk,
#              switch back to tty1 and exit 0, which releases the login prompt or
#              the display manager that were ordered after this unit.
#   kiosk   Run by kldload-firstboot-kiosk.service as its unprivileged user: wait
#           for the page on 127.0.0.1:8099, then exec cage with Firefox in kiosk
#           mode on it (software renderer if cage has no GPU renderer).
#   status  Print building | ok | problem for the current state, and exit 0.
#   frame   Draw one frame to the terminal and exit (for tests and a quick look).
#   logtail [N]
#           Print the source, then the last N cleaned lines of the build output:
#           the newest of /var/log/installer/*.log during a live install (part 1
#           of the show), else the journal of kldload-firstboot, kldload-autodeploy
#           and klab-firstboot (part 2), falling back to the newest of their log
#           files. kldload-webui serves this to the graphical show, so the console
#           screen and the slides show the same, equally redacted text.
#
# WHY THIS EXISTS:
#   An install that asks for Kubernetes or golden images spends its first boot
#   building them, for up to an hour. The machine used to come up to a login or
#   a desktop in the middle of that, and the operator was invited to start using
#   a half-built system. The operator's rule (fiend, 2026-09-14): core, server
#   and a plain desktop come straight up, because they are ready; anything that
#   builds images, Kubernetes or KVM keeps the show on screen all the way
#   through, and "it reinforces to the user that they literally did not press a
#   button". The first cut was a console screen only; the operator then asked for
#   part 2 of the slide show instead of the terminal ("after first reboot the slide
#   show, part 2, should resume ASAP"), so the console screen became the fallback
#   and the first thing drawn while the kiosk starts.
#
# THE DECISION (check), in order:
#   kldload.firstboot_show=0 on the kernel cmdline   -> no (the escape hatch)
#   a live medium is mounted                          -> no (not an installed system)
#   firstboot-show-done or all-ready exists           -> no (already built)
#   `kldload-autodeploy --want` reports k8s=1, klab=1 or ai=1 -> yes
#   anything else                                     -> no
#   autodeploy's own rules decide what was requested; this file never
#   re-derives them from the manifest.
#
# SETTLED (status) — the same rule the build monitor uses (buildmon 7f63caf4):
#   ok       all-ready, or current-phase "ready", or first boot done with
#            autodeploy skipped / "nothing-requested"
#   problem  current-phase "partial"; kldload-firstboot or kldload-autodeploy
#            failed; or a plan whose phases have all stopped with one failed
#   building anything else
#
# INPUTS:   /var/lib/kldload/{firstboot-done,all-ready,current-phase,phases/,
#           autodeploy-skipped}, /var/log/kldload/{firstboot,autodeploy}.log,
#           /proc/cmdline, kldload-autodeploy --want, systemctl
# OUTPUTS:  the screen (VT8, then back to VT1); /var/lib/kldload/firstboot-show-done
#           when it hands over, so a later boot never shows it again
# EXIT:     check: 0 show, 1 no show. run/status/frame: 0. usage: 2.
#
# Notes:
#   - Draws on its own VT so the units that write journal+console (firstboot,
#     autodeploy, klab) keep printing to tty1 underneath, unseen. Alt+F1 shows
#     that raw output; the operator wants it one keypress away because it is the
#     visible proof of the work.
#   - Log text is untrusted on its way to a terminal: control sequences are
#     stripped (a log line must not be able to reprogram the console), redraws
#     from progress meters are flattened to their last frame, and anything that
#     looks like a credential is redacted.
#   - No ERR trap and no -e in the draw loop: a failed read or draw skips a
#     frame; it must never end the show early or, worse, leave the console on a
#     VT nobody is drawing.
#   - The kiosk is a separate unit, not a child of this process, because cage
#     needs a logind session on seat0 (PAMName=, User=, TTYPath=) and this unit
#     is a root oneshot holding the display manager back. It is started with
#     --no-block: a blocking start from inside a unit that multi-user.target is
#     waiting on would wait on jobs ordered behind that same target.
#   - kldload.firstboot_show=console on the cmdline keeps the console screen and
#     never starts the kiosk.
#   - Test hooks: KLDLOAD_FBSHOW_STATE, _LOGDIR, _CMDLINE, _ROOT (prefix for the
#     live-medium and kiosk probes), _TTY, _VT (none: do
#     not switch), _WANT (command printing the want line), _UNITSTATE (command
#     taking a unit name and printing its ActiveState), _SYSTEMCTL (command run
#     instead of systemctl for start/stop), _INTERVAL, _MAXSEC,
#     _HOLD_OK, _HOLD_PROBLEM, _COLS, _ROWS, _KIOSK_WAIT.
#   - SEE ALSO: kldload-firstboot-show.service, kldload-firstboot-kiosk.service,
#     firstboot.html, kldload-install-kiosk (part 1's kiosk), kldload-autodeploy,
#     kldload-initrd-show (the netboot console show this one follows),
#     kldload-buildmon (the same settle rule, in a window).
# ─────────────────────────────────────────────────────────────────────────────
# strict-mode: exempt — a display loop beside the build: a failed read or draw must skip a frame, never end the show
set -uo pipefail
export LC_ALL=C

STATE="${KLDLOAD_FBSHOW_STATE:-/var/lib/kldload}"
LOGDIR="${KLDLOAD_FBSHOW_LOGDIR:-/var/log/kldload}"
CMDLINE="${KLDLOAD_FBSHOW_CMDLINE:-/proc/cmdline}"
VT="${KLDLOAD_FBSHOW_VT:-8}"
TTY="${KLDLOAD_FBSHOW_TTY:-/dev/tty${VT}}"
INTERVAL="${KLDLOAD_FBSHOW_INTERVAL:-1}"
MAXSEC="${KLDLOAD_FBSHOW_MAXSEC:-21600}"
HOLD_OK="${KLDLOAD_FBSHOW_HOLD_OK:-8}"
HOLD_PROBLEM="${KLDLOAD_FBSHOW_HOLD_PROBLEM:-60}"
ROOT="${KLDLOAD_FBSHOW_ROOT:-}"
INSTLOGDIR="${KLDLOAD_FBSHOW_INSTLOGDIR:-/var/log/installer}"
INSTPHASE="${KLDLOAD_FBSHOW_INSTPHASE:-/run/kldload/install-phase}"
KLABLOGDIR="${KLDLOAD_FBSHOW_KLABLOGDIR:-/root/klab/goldens}"
KIOSK_UNIT=kldload-firstboot-kiosk.service
KIOSK_URL="http://127.0.0.1:8099/firstboot.html"
KIOSK_WAIT="${KLDLOAD_FBSHOW_KIOSK_WAIT:-180}"

_say() { printf 'kldload-firstboot-show: %s\n' "$*" >&2; }

_want_line() {
    if [[ -n "${KLDLOAD_FBSHOW_WANT:-}" ]]; then
        bash -c "${KLDLOAD_FBSHOW_WANT}"
    else
        /usr/sbin/kldload-autodeploy --want
    fi
}

_systemctl() {
    if [[ -n "${KLDLOAD_FBSHOW_SYSTEMCTL:-}" ]]; then
        bash -c "${KLDLOAD_FBSHOW_SYSTEMCTL}" _ "$@"
    else
        systemctl "$@"
    fi
}

# _page_up — 0 when the kiosk's page answers on the loopback listener.
_page_up() {
    if [[ -n "${KLDLOAD_FBSHOW_PAGEUP:-}" ]]; then
        bash -c "${KLDLOAD_FBSHOW_PAGEUP}"
    else
        curl -fs -o /dev/null --max-time 2 "${KIOSK_URL}"
    fi
}

_unit_state() {
    if [[ -n "${KLDLOAD_FBSHOW_UNITSTATE:-}" ]]; then
        bash -c "${KLDLOAD_FBSHOW_UNITSTATE}" _ "$1"
    else
        systemctl show -p ActiveState --value "$1" 2>/dev/null
    fi
}

# ─── check ───────────────────────────────────────────────────────────────────
show_wanted() {
    local _tok _want
    local -a _toks=()
    if read -ra _toks <"${CMDLINE}"; then
        for _tok in "${_toks[@]}"; do
            case "${_tok}" in
            kldload.firstboot_show=0 | kldload.firstboot_show=no | kldload.firstboot_show=off)
                _say "${_tok} on the cmdline — no show"
                return 1
                ;;
            esac
        done
    fi
    for _tok in /run/live/medium /run/initramfs/live /lib/live/mount/medium; do
        if [[ -d "${ROOT}${_tok}" ]]; then
            _say "live medium at ${_tok} — not an installed system"
            return 1
        fi
    done
    if [[ -e "${STATE}/firstboot-show-done" || -e "${STATE}/all-ready" ]]; then
        _say "this machine has already finished its first-boot build"
        return 1
    fi
    if ! _want="$(_want_line)"; then
        _say "kldload-autodeploy --want failed — no show, the boot goes on as usual"
        return 1
    fi
    case " ${_want} " in
    *" k8s=1 "* | *" klab=1 "* | *" ai=1 "*)
        _say "requested: ${_want} — first boot builds, the show holds the screen"
        return 0
        ;;
    esac
    _say "requested: ${_want} — nothing to build, the system comes straight up"
    return 1
}

# ─── state ───────────────────────────────────────────────────────────────────
# Globals filled by read_state: PH_NAME[] PH_STATE[] PH_START[], FB_DONE, CUR.
read_state() {
    PH_NAME=() PH_STATE=() PH_START=()
    FB_DONE=0
    [[ -e "${STATE}/firstboot-done" ]] && FB_DONE=1
    CUR=""
    [[ -r "${STATE}/current-phase" ]] && CUR="$(tr -d '[:space:]' <"${STATE}/current-phase")"
    local _f _b _s _t _body
    for _f in "${STATE}"/phases/[0-9][0-9]-*; do
        [[ -f "${_f}" ]] || continue
        _b="${_f##*/}"
        # Through a here-string, so a body with no trailing newline still reads.
        _body="$(<"${_f}")" || _body=""
        _s="" _t=""
        read -r _s _t <<<"${_body}"
        case "${_s}" in done | running | failed) : ;; *) _s=pending ;; esac
        [[ "${_t:-}" =~ ^[0-9]+$ ]] || _t=0
        PH_NAME+=("${_b#??-}")
        PH_STATE+=("${_s}")
        PH_START+=("${_t}")
    done
}

# Prints ok | problem | building.
settle() {
    local _st _i _open=0 _failed=0
    read_state
    [[ -e "${STATE}/all-ready" ]] && {
        echo ok
        return
    }
    case "${CUR}" in
    ready)
        echo ok
        return
        ;;
    partial)
        echo problem
        return
        ;;
    esac
    if ((FB_DONE)) && [[ "${CUR}" == nothing-requested || -e "${STATE}/autodeploy-skipped" ]]; then
        echo ok
        return
    fi
    for _st in kldload-firstboot.service kldload-autodeploy.service; do
        [[ "$(_unit_state "${_st}")" == failed ]] && {
            echo problem
            return
        }
    done
    for _i in "${!PH_STATE[@]}"; do
        case "${PH_STATE[_i]}" in
        running | pending) _open=1 ;;
        failed) _failed=1 ;;
        esac
    done
    if ((${#PH_STATE[@]} > 0 && !_open && _failed)); then
        echo problem
        return
    fi
    echo building
}

# ─── log text on its way to a terminal ───────────────────────────────────────
# 1. a progress meter's redraw (CR, cursor-up, column move) starts the line over;
# 2. every other escape sequence and control byte is dropped;
# 3. credentials are redacted, and a private key block is replaced whole.
clean_log() {
    sed -E \
        -e $'s/\x1b\\[[0-9;?]*[ -\\/]*[AG]/\r/g' \
        -e $'s/\x1b\\[[0-9;?]*[ -\\/]*[@-~]//g' \
        -e $'s/\x1b\\][^\a]*(\a|\x1b\\\\)//g' \
        -e $'s/.*\r(.)/\\1/' \
        -e '/BEGIN [A-Z ]*PRIVATE KEY/,/END [A-Z ]*PRIVATE KEY/c\[redacted private key]' \
        -e 's/((pass(word|wd|phrase)?|secret|token|api[_-]?key|private[_-]?key|psk)["'"'"']?[[:space:]]*[:=][[:space:]]*)[^[:space:]]+/\1[redacted]/Ig' \
        -e 's#(login:[[:space:]]*[^[:space:]/]+[[:space:]]*/[[:space:]]*)[^[:space:]]+#\1[redacted]#Ig' |
        tr -d '\000-\010\013-\037\177'
}

# _log_path — the build log being written right now.
#
# The newest by modification time, from a fixed list per part: never a global
# "newest file", which on a busy first boot is Grafana's log or the AI training
# corpus. HISTORY: the first cut followed autodeploy.log once first boot was
# done, and on 4-k8s (fiend 2026-09-14) that pane sat on "waiting for
# klab-firstboot..." for 36 minutes while three goldens were built, because klab
# logs each golden to its own file.
_log_path() {
    local -a cand=()
    local f best="" best_t=0 t
    if [[ -e "${INSTPHASE}" ]]; then
        cand=("${INSTLOGDIR}"/*.log)
    else
        cand=("${LOGDIR}/firstboot.log" "${LOGDIR}/autodeploy.log" "${KLABLOGDIR}"/*.log)
    fi
    for f in "${cand[@]}"; do
        [[ -f "${f}" && ! -L "${f}" ]] || continue
        t="$(stat -c %Y "${f}" 2>/dev/null)" || continue
        ((t > best_t)) && best="${f}" best_t="${t}"
    done
    printf '%s\n' "${best:-${LOGDIR}/firstboot.log}"
}

# _build_journal — the raw stdout of the units doing first boot's work, oldest first.
#
# WHY the journal and not the log files: klab writes a banner to each golden's log
# file when it starts (host, cores, NVIDIA) and the real work -- the cloud image
# download, virt-install, waiting for the guest -- goes to klab-firstboot's stdout.
# Part 2's output window sat on that banner while the build ran underneath (fiend,
# 3-kvm on build 18, 2026-09-15: "it just says the host and nvidia and memory
# instead of the actual output"). The journal of these units is also exactly what
# tty1 shows. KLDLOAD_FBSHOW_JOURNAL (a command printing lines) is the test hook.
FB_UNITS=(kldload-firstboot.service kldload-autodeploy.service klab-firstboot.service)
_build_journal() {
    if [[ -n "${KLDLOAD_FBSHOW_JOURNAL:-}" ]]; then
        bash -c "${KLDLOAD_FBSHOW_JOURNAL}"
        return
    fi
    command -v journalctl >/dev/null 2>&1 || return 0
    # -q: without it an empty result prints "-- No entries --" on stdout, which would
    # become the only line in the window.
    local -a args=(-q -b -o cat -n 400 --no-pager)
    local u
    for u in "${FB_UNITS[@]}"; do args+=(-u "${u}"); done
    journalctl "${args[@]}" 2>/dev/null
}

# _log_lines N — the source on the first line, then the last N cleaned lines of the
# build output: during a live install the newest installer log (part 1), after it
# the build units' journal (part 2), and the newest log file only if the journal
# has nothing (no journalctl, or the units have not written a line yet).
_log_lines() {
    local n="$1" src lines=""
    if [[ ! -e "${INSTPHASE}" ]]; then
        lines="$(_build_journal | clean_log | grep -v '^[[:space:]]*$' | tail -n "${n}")"
        if [[ -n "${lines}" ]]; then
            printf 'journal: first boot, autodeploy, klab\n%s\n' "${lines}"
            return 0
        fi
    fi
    src="$(_log_path)"
    printf '%s\n' "${src}"
    [[ -r "${src}" ]] || return 0
    tail -c 131072 "${src}" 2>/dev/null | clean_log | grep -v '^[[:space:]]*$' | tail -n "${n}"
}

# logtail [N] — see the header.
log_tail() {
    local n="${1:-40}"
    [[ "${n}" =~ ^[0-9]+$ ]] && ((n >= 1 && n <= 400)) || n=40
    _log_lines "${n}"
}

# ─── drawing ─────────────────────────────────────────────────────────────────
C_RST=$'\e[0m' C_DIM=$'\e[2m' C_B=$'\e[1m'
C_CYAN=$'\e[36m' C_MAG=$'\e[35m' C_GRN=$'\e[32m' C_YEL=$'\e[33m' C_RED=$'\e[31m' C_WHT=$'\e[37m'

_dur() {
    local s=$1
    ((s < 0)) && s=0
    if ((s >= 3600)); then
        printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
    else
        printf '%dm%02ds' $((s / 60)) $((s % 60))
    fi
}

_size() {
    COLS="${KLDLOAD_FBSHOW_COLS:-}" ROWS="${KLDLOAD_FBSHOW_ROWS:-}"
    if [[ -z "${COLS}" || -z "${ROWS}" ]]; then
        local _sz
        _sz="$(stty -F "${TTY}" size 2>/dev/null)" || _sz=""
        ROWS="${_sz% *}" COLS="${_sz#* }"
    fi
    [[ "${COLS}" =~ ^[0-9]+$ ]] && ((COLS >= 40)) || COLS=80
    [[ "${ROWS}" =~ ^[0-9]+$ ]] && ((ROWS >= 16)) || ROWS=25
}

# frame <verdict> <started-epoch> — the whole screen as one string on stdout.
frame() {
    local verdict=$1 t0=$2 now i n=0 done_n=0 w bar fill host ip log_path
    now="$(printf '%(%s)T' -1)"
    _size
    w=$((COLS - 4))
    host="$(hostname 2>/dev/null)" || host=""
    ip="$(ip -o -4 addr show scope global 2>/dev/null | sed -n 's/.* inet \([0-9.]*\)\/.*/\1/p' | head -n 2 | tr '\n' ' ')" || ip=""
    read_state

    local out=""
    out+=$'\e[H\e[2J'
    out+="  ${C_B}${C_MAG}kldload${C_RST}${C_WHT} - building this system${C_RST}"$'\n'
    out+="  ${C_DIM}${host}  ${ip}  |  running $(_dur $((now - t0)))  |  nobody pressed a button${C_RST}"$'\n\n'

    # Stages: first boot, then autodeploy's plan.
    local fb_state=running
    ((FB_DONE)) && fb_state="done"
    [[ "$(_unit_state kldload-firstboot.service)" == failed ]] && fb_state=failed
    local -a names=("first boot") states=("${fb_state}") starts=(0)
    for i in "${!PH_NAME[@]}"; do
        names+=("${PH_NAME[i]}") states+=("${PH_STATE[i]}") starts+=("${PH_START[i]}")
    done
    for i in "${!names[@]}"; do
        n=$((n + 1))
        local mark col right=""
        case "${states[i]}" in
        done) mark="[ok]" col="${C_GRN}" done_n=$((done_n + 1)) ;;
        running)
            mark="[>>]" col="${C_YEL}"
            ((starts[i] > 0)) && right="$(_dur $((now - starts[i])))"
            ;;
        failed) mark="[!!]" col="${C_RED}" ;;
        *) mark="[  ]" col="${C_DIM}" ;;
        esac
        out+="  ${col}${mark}${C_RST} $(printf '%-32.32s' "${names[i]}") ${C_DIM}${right}${C_RST}"$'\n'
    done
    ((${#PH_NAME[@]} == 0)) && out+="  ${C_DIM}[  ] the build plan is declared when first boot finishes${C_RST}"$'\n'

    # Bar: stages done of stages known. Honest about an undeclared plan.
    local bw=$((w - 20))
    ((bw < 10)) && bw=10
    fill=$((n > 0 ? done_n * bw / n : 0))
    bar="$(printf '%*s' "${fill}" '' | tr ' ' '#')$(printf '%*s' $((bw - fill)) '' | tr ' ' '.')"
    out+=$'\n'"  ${C_CYAN}${bar}${C_RST} ${done_n}/${n} stages"$'\n\n'

    # Verdict line.
    case "${verdict}" in
    ok) out+="  ${C_B}${C_GRN}Build complete.${C_RST} Handing the machine over."$'\n' ;;
    problem)
        out+="  ${C_B}${C_RED}The build did not finish cleanly.${C_RST}"
        for i in "${!PH_NAME[@]}"; do [[ "${PH_STATE[i]}" == failed ]] && out+=" failed: ${PH_NAME[i]}"; done
        out+=$'\n'"  Logs: ${LOGDIR}/firstboot.log  ${LOGDIR}/autodeploy.log  -  handing over in ${HOLD_PROBLEM}s"$'\n'
        ;;
    *) out+="  ${C_DIM}Do not power off. Alt+F1 raw output | Alt+F2 login | this screen hands over when the build is done.${C_RST}"$'\n' ;;
    esac

    # Log tail fills what is left: the same source and cleaning as part 2's window.
    local used rows_left block line first=1 got=0
    used="$(printf '%s' "${out}" | tr -cd '\n' | wc -c)"
    rows_left=$((ROWS - used - 3))
    ((rows_left < 3)) && rows_left=3
    block="$(_log_lines "${rows_left}")"
    while IFS= read -r line; do
        if ((first)); then
            first=0
            log_path="${line}"
            out+=$'\n'"  ${C_DIM}-- ${log_path} $(printf '%*s' $((w - ${#log_path} - 4)) '' | tr ' ' '-')${C_RST}"$'\n'
            continue
        fi
        got=1
        out+="  ${C_DIM}${line:0:w}${C_RST}"$'\n'
    done <<<"${block}"
    ((got)) || out+="  ${C_DIM}(waiting for the log)${C_RST}"$'\n'
    printf '%s' "${out}"
}

# ─── kiosk: part 2 of the show ───────────────────────────────────────────────
# _kiosk_browser — the browser binary to run, on stdout; 1 if there is none.
# Firefox, because it is the browser the offline mirrors carry for every target
# family that has cage (Fedora: firefox, Debian: firefox-esr). Chrome comes from
# Google's online repo and is not there (audit, 2026-09-14).
_kiosk_browser() {
    local b
    for b in firefox firefox-esr; do
        if [[ -x "${ROOT}/usr/bin/${b}" ]]; then
            printf '/usr/bin/%s\n' "${b}"
            return 0
        fi
    done
    return 1
}

# kiosk_capable — 0 if part 2 can be put on screen here, else 1 with the reason on
# stderr. Every missing piece falls back to the console screen, never a black one.
kiosk_capable() {
    local _tok _c
    local -a _toks=()
    if read -ra _toks <"${CMDLINE}"; then
        for _tok in "${_toks[@]}"; do
            [[ "${_tok}" == kldload.firstboot_show=console ]] && {
                _say "${_tok} on the cmdline — console screen only"
                return 1
            }
        done
    fi
    [[ -x "${ROOT}/usr/bin/cage" ]] || {
        _say "no cage — console screen only"
        return 1
    }
    _kiosk_browser >/dev/null || {
        _say "no firefox — console screen only"
        return 1
    }
    # pam_systemd is what turns the unit's PAM session into a logind session on
    # seat0, which is where cage gets XDG_RUNTIME_DIR and the DRM device from.
    # Without it cage exits at once ("XDG_RUNTIME_DIR is not set"): fiend, 3-kvm on
    # build 17 (2026-09-15), where a kvm install had no systemd-pam.
    [[ -e "${ROOT}/usr/lib64/security/pam_systemd.so" || -e "${ROOT}/usr/lib/x86_64-linux-gnu/security/pam_systemd.so" ||
        -e "${ROOT}/usr/lib/security/pam_systemd.so" ]] || {
        _say "no pam_systemd.so — the kiosk could not get a login session, console screen only"
        return 1
    }
    [[ -f "${ROOT}/usr/lib/systemd/system/${KIOSK_UNIT}" ]] || {
        _say "no ${KIOSK_UNIT} — console screen only"
        return 1
    }
    for _c in "${ROOT}"/dev/dri/card*; do
        [[ -e "${_c}" ]] && return 0
    done
    _say "no DRM device under /dev/dri — nothing for cage to draw on, console screen only"
    return 1
}

# Firefox preferences for a profile nobody will ever click in: no first-run pages,
# no default-browser question, no session restore after a crash (a crash plus a
# restart must show the page, not a "restore session" prompt), and no network
# checks against Mozilla or Google from a machine that may be air-gapped. The Safe
# Browsing lines are there because the first container run of the kiosk logged a
# fetch to safebrowsing.googleapis.com within a minute (2026-09-14).
_kiosk_prefs() {
    cat <<'PREFS'
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("browser.aboutwelcome.enabled", false);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.tabs.warnOnClose", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("toolkit.telemetry.reportingpolicy.firstRun", false);
user_pref("app.update.enabled", false);
user_pref("extensions.update.enabled", false);
user_pref("network.captive-portal-service.enabled", false);
user_pref("network.connectivity-service.enabled", false);
user_pref("browser.safebrowsing.malware.enabled", false);
user_pref("browser.safebrowsing.phishing.enabled", false);
user_pref("browser.safebrowsing.downloads.enabled", false);
user_pref("browser.safebrowsing.provider.google4.updateURL", "");
user_pref("browser.safebrowsing.provider.google.updateURL", "");
user_pref("browser.region.update.enabled", false);
user_pref("browser.search.update", false);
user_pref("extensions.getAddons.cache.enabled", false);
user_pref("app.normandy.enabled", false);
user_pref("browser.display.background_color", "#02030a");
user_pref("browser.display.use_system_colors", false);
user_pref("ui.systemUsesDarkTheme", 1);
PREFS
}

# kiosk_exec — see "kiosk" in the header. Exits non-zero, with the reason, when it
# cannot start; the unit's Restart= and start limit decide what happens next, and
# kldload-firstboot-show run notices a unit that has given up.
KIOSK_RENDERER_ERR='Unable to create the wlroots renderer'
kiosk_exec() {
    local browser profile i rc=0 errlog
    browser="$(_kiosk_browser)" || {
        _say "FATAL: no firefox to run"
        return 1
    }
    [[ -x /usr/bin/cage ]] || {
        _say "FATAL: no cage"
        return 1
    }
    profile="${HOME:?HOME must be set by the unit}/firefox-profile"
    mkdir -p "${profile}" || return 1
    _kiosk_prefs >"${profile}/user.js" || return 1
    # The page is served by the web UI behind nginx, both of which are still
    # starting this early in boot. Until they answer, the console screen on VT8 is
    # what is on screen, which is why this waits instead of letting Firefox paint
    # a connection error.
    for ((i = 0; i < KIOSK_WAIT; i += 2)); do
        curl -fs -o /dev/null --max-time 2 "${KIOSK_URL}" && break
        sleep 2
    done
    ((i < KIOSK_WAIT)) || {
        _say "the page at ${KIOSK_URL} did not answer in ${KIOSK_WAIT}s"
        return 1
    }
    export MOZ_ENABLE_WAYLAND=1
    local -a cmd=(/usr/bin/cage -d -s -- "${browser}" --kiosk --no-remote --profile "${profile}" "${KIOSK_URL}")
    if [[ "${WLR_RENDERER:-}" == pixman ]]; then
        exec "${cmd[@]}"
    fi
    # Renderer fallback, wider than part 1's (kldload-install-kiosk retries only on
    # the "no renderer" error). The live image runs nouveau, where that is the one
    # failure seen (fiend's RTX 3080, 2026-09-13); an installed machine runs the
    # proprietary NVIDIA driver, where wlroots can also fail on its allocator or
    # GBM with other words. A slideshow draws fine in software, so ANY failure in
    # the first 20 seconds retries once with pixman; a cage that ran longer and
    # then died is a crash, returned for Restart= to handle.
    # NVIDIA's cursor planes are a known wlroots problem; the kiosk has no pointer.
    [[ -d /sys/module/nvidia ]] && export WLR_NO_HARDWARE_CURSORS=1
    local started
    errlog="$(mktemp -t kldload-fbkiosk.XXXXXX)" || exec "${cmd[@]}"
    started="$(printf '%(%s)T' -1)"
    "${cmd[@]}" 2>"${errlog}" || rc=$?
    cat "${errlog}" >&2
    if ((rc != 0 && $(printf '%(%s)T' -1) - started < 20)); then
        if grep -qF "${KIOSK_RENDERER_ERR}" "${errlog}"; then
            _say "no GPU renderer for cage — retrying with the software renderer"
        else
            _say "cage exited ${rc} within 20s — retrying once with the software renderer"
        fi
        rm -f "${errlog}"
        WLR_RENDERER=pixman exec "${cmd[@]}"
    fi
    rm -f "${errlog}"
    return "${rc}"
}

# ─── run ─────────────────────────────────────────────────────────────────────
_vt_switch() {
    [[ "${VT}" == none ]] && return 0
    command -v chvt >/dev/null 2>&1 || return 0
    # swallow: a VT switch that fails leaves the show drawn where it is; nothing to recover
    chvt "$1" 2>/dev/null || true
}

KIOSK_STARTED=0
_hand_over() {
    printf '\e[?25h\e[0m' >>"${TTY}" 2>/dev/null
    if ((KIOSK_STARTED)); then
        _systemctl stop "${KIOSK_UNIT}" 2>/dev/null || _say "WARNING: could not stop ${KIOSK_UNIT}"
        # The kiosk Conflicts= with getty@tty1, so its stop leaves tty1 empty. A
        # display manager takes tty1 when this unit exits; without one, the login
        # prompt has to be started again or the machine hands over to a blank tty1.
        if ! _systemctl is-enabled --quiet display-manager.service 2>/dev/null; then
            _systemctl start --no-block getty@tty1.service 2>/dev/null || _say "WARNING: could not start getty@tty1 after the kiosk"
        fi
    fi
    if [[ "${VT}" != none ]]; then
        _vt_switch 1
        # Redraw the login prompt tty1's getty printed an hour ago, under the
        # post-installer output that has scrolled past it since.
        if [[ -z "${KLDLOAD_FBSHOW_UNITSTATE:-}" ]] &&
            [[ "$(_unit_state getty@tty1.service)" == active ]]; then
            # swallow: no getty on tty1 (a desktop's display manager owns it): nothing to redraw
            systemctl restart getty@tty1.service 2>/dev/null || true
        fi
    fi
}

run_show() {
    local t0 v held=0 hold kstate fell_back=0 handed=0
    t0="$(printf '%(%s)T' -1)"
    [[ -w "${TTY}" ]] || {
        _say "cannot write ${TTY} — no show, the boot goes on as usual"
        return 0
    }
    trap '_hand_over; exit 0' TERM INT
    printf '\e[?25l' >>"${TTY}" 2>/dev/null
    _vt_switch "${VT}"
    if kiosk_capable; then
        if _systemctl start --no-block "${KIOSK_UNIT}"; then
            KIOSK_STARTED=1
            _say "part 2 of the show is starting on tty1 (${KIOSK_UNIT})"
        else
            _say "WARNING: could not start ${KIOSK_UNIT} — console screen only"
        fi
    fi
    while :; do
        v="$(settle)"
        # The console screen is drawn on VT8 either way: it is what shows while the
        # kiosk waits for the web UI, and it is already current if the kiosk fails.
        frame "${v}" "${t0}" >"${TTY}" 2>/dev/null
        if ((KIOSK_STARTED && !fell_back)); then
            kstate="$(_unit_state "${KIOSK_UNIT}")"
            if [[ "${kstate}" == failed ]]; then
                fell_back=1
                _say "${KIOSK_UNIT} gave up — the console screen takes over"
                _vt_switch "${VT}"
            elif ((!handed)) && [[ "${kstate}" == active ]] && _page_up; then
                # A logind session is only ACTIVE while its VT is in front, and cage
                # waits ten seconds for an active session before it gives up. This
                # screen had put VT8 in front, so every cage timed out with "Timeout
                # waiting session to become active" (fiend, 3-kvm on build 17,
                # 2026-09-15). Hand tty1 over once the page answers: the kiosk
                # starts cage at that same moment.
                handed=1
                _say "the page answers — handing tty1 to the kiosk"
                # Blank tty1 first, so the moment between the switch and cage's first
                # frame is black instead of an hour of boot and build text.
                if [[ "${VT}" != none && -w /dev/tty1 ]]; then
                    printf '\e[0m\e[H\e[2J\e[3J\e[?25l' >/dev/tty1 2>/dev/null ||
                        _say "WARNING: could not blank tty1 before the kiosk"
                fi
                _vt_switch 1
            fi
        fi
        if [[ "${v}" != building ]]; then
            hold="${HOLD_OK}"
            [[ "${v}" == problem ]] && hold="${HOLD_PROBLEM}"
            if ((held >= hold)); then
                _say "build settled: ${v}"
                break
            fi
            held=$((held + INTERVAL))
        fi
        if (($(printf '%(%s)T' -1) - t0 > MAXSEC)); then
            _say "still building after ${MAXSEC}s — handing the machine over anyway"
            break
        fi
        sleep "${INTERVAL}"
    done
    : >"${STATE}/firstboot-show-done" 2>/dev/null || _say "WARNING: could not write ${STATE}/firstboot-show-done — the show may run again next boot"
    _hand_over
    return 0
}

usage() {
    cat <<'USAGE'
usage: kldload-firstboot-show <check|run|kiosk|status|frame|logtail [N]>

  check    Exit 0 if this boot should hold the screen while first boot builds
           what the install asked for (kldload-autodeploy --want reports k8s=1,
           klab=1 or ai=1), 1 if not. Prints its reason on stderr.
  run      Draw the build screen on VT8, start part 2 of the show on tty1 when
           this machine can draw it (cage, firefox, a DRM device), and when the
           build settles show the outcome, stop the kiosk, switch back to tty1
           and exit 0.
  kiosk    For kldload-firstboot-kiosk.service only: wait for the page on
           127.0.0.1:8099, then run cage with Firefox in kiosk mode on it.
  status   Print building, ok or problem for the current state.
  frame    Draw one frame on the terminal and exit.
  logtail  Print the path of the build log being written now, then its last N
           lines (default 40), cleaned and redacted. Used by the graphical show.

Kernel cmdline: kldload.firstboot_show=0 turns the show off for that boot;
kldload.firstboot_show=console keeps the console screen and skips the kiosk.
While it runs: Alt+F1 shows the raw post-installer output, Alt+F2 a login.
Exit: check 0/1; run, status and frame 0; usage 2.
USAGE
}

case "${1:-}" in
check) show_wanted ;;
run) run_show ;;
kiosk) kiosk_exec ;;
status) settle ;;
frame) frame "$(settle)" "$(printf '%(%s)T' -1)" >"${TTY}" ;;
logtail) log_tail "${2:-40}" ;;
-h | --help | help) usage ;;
*)
    usage >&2
    exit 2
    ;;
esac
