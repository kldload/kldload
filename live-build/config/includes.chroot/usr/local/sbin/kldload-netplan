#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# kldload-netplan — show and check the ranges kldload uses for its own networks.
#
#   kldload-netplan show        every range, one per line: KEY VALUE
#   kldload-netplan get KEY     one value (for scripts)
#   kldload-netplan check       exit 1 if any two kldload ranges overlap, if
#                               the VIP or MetalLB pool falls outside its node
#                               network, or if a range overlaps a route this
#                               host reaches through an interface kldload does
#                               not own (a LAN on br0, eth0, ...)
#
# WHY: the Kubernetes Services range (10.96.0.0/12) held the bench LAN
# 10.100.10.0/24 and nothing could say so (2026-09-29). This is the one place
# that can: the plan comes from /usr/lib/kldload/netplan.sh (defaults, then
# /etc/kldload/network-plan.env), and `check` compares it with the routes the
# kernel actually has. docs/NETWORK-PLAN.md.
#
# Output: show/get on stdout (data); check reports on stdout, one line each,
# ending "netplan: N ranges, M problems".
# Exit: 0 clean, 1 an overlap or a malformed range, 2 usage, 3 no plan file.
# See kldload-netplan(8).
# Environment: NETPLAN_DEFAULTS, NETPLAN_FILE (paths, for tests); NETPLAN_ROUTES
# a file of `ip -4 route` output to check against instead of this host's.
# ─────────────────────────────────────────────────────────────────────────────
set -Eeuo pipefail
trap 'echo "kldload-netplan: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

usage() {
    # asked for: stdout, 0; a usage error: stderr, 2
    local rc="${1:-2}"
    sed -n '2,/^# ──*$/{/^# ──/d; s/^# \{0,1\}//; p}' "$0" | sed -n '1,10p' >&$((rc == 0 ? 1 : 2))
    exit "$rc"
}
case "${1:-}" in -h | --help) usage 0 ;; show | get | check) ;; *) usage 2 ;; esac

LIB="${NETPLAN_LIB:-/usr/lib/kldload/netplan.sh}"
# shellcheck source=../../lib/kldload/netplan.sh
source "$LIB"
netplan_load || {
    echo "kldload-netplan: no plan file (${NETPLAN_DEFAULTS:-/usr/lib/kldload/network-plan.defaults})" >&2
    exit 3
}

case "$1" in
show)
    for k in "${NETPLAN_ORDER[@]}"; do printf '%-20s %s\n' "$k" "${NETPLAN[$k]}"; done
    exit 0
    ;;
get)
    [[ -n "${2:-}" ]] || usage 2
    netplan_get "$2" || {
        echo "kldload-netplan: no key $2 in the plan" >&2
        exit 1
    }
    exit 0
    ;;
esac

# ─── check ───────────────────────────────────────────────────────────────────
bad=0
say() { printf '  %-5s %s\n' "$1" "$2"; }
problem() {
    say FAIL "$*"
    bad=$((bad + 1))
}

# Ranges that are networks of their own. NET_BLOCK and KVM_MESH_BLOCK are
# containers (meshes are cut out of the latter), the VIP and pool are carved
# from K8S_NODE_NET and checked against it below.
for b in "${NETPLAN_BAD[@]}"; do problem "not a KEY=range line, ignored: ${b}"; done

nets=()
for k in "${NETPLAN_ORDER[@]}"; do
    v="${NETPLAN[$k]}"
    if ! span_bounds "$v" >/dev/null; then
        problem "${k}=${v} is not an address, a range or a CIDR"
        continue
    fi
    case "$k" in NET_BLOCK | K8S_VIP | K8S_LB_POOL) ;; *) nets+=("$k") ;; esac
done

for ((i = 0; i < ${#nets[@]}; i++)); do
    for ((j = i + 1; j < ${#nets[@]}; j++)); do
        a="${nets[i]}" b="${nets[j]}"
        if cidr_overlap "${NETPLAN[$a]}" "${NETPLAN[$b]}"; then
            problem "${a} ${NETPLAN[$a]} overlaps ${b} ${NETPLAN[$b]}"
        fi
    done
done

node="${NETPLAN[K8S_NODE_NET]:-}"
for k in K8S_VIP K8S_LB_POOL; do
    v="${NETPLAN[$k]:-}"
    [[ -n "$v" && -n "$node" ]] || continue
    span_within "$v" "$node" || problem "${k} ${v} is not inside K8S_NODE_NET ${node}"
done
if [[ -n "${NETPLAN[K8S_VIP]:-}" && -n "${NETPLAN[K8S_LB_POOL]:-}" ]] &&
    cidr_overlap "${NETPLAN[K8S_VIP]}" "${NETPLAN[K8S_LB_POOL]}"; then
    problem "K8S_VIP ${NETPLAN[K8S_VIP]} is inside K8S_LB_POOL ${NETPLAN[K8S_LB_POOL]}"
fi

# Routes through interfaces kldload does not own. virbr*/kld-*/wg*/cilium_*/
# lxc*/vnet*/tap*/fc-* are kldload's (or libvirt's, for kldload's networks);
# a route on anything else -- br0 carrying the LAN, eth0, a VPN -- is someone
# else's network, and a kldload range on it is the 10.96/12 mistake again.
routes="$(if [[ -n "${NETPLAN_ROUTES:-}" ]]; then cat "$NETPLAN_ROUTES"; else ip -4 route show; fi)"
nforeign=0
while read -r dst rest; do
    [[ "$dst" == */* ]] || continue
    dev="$(sed -n 's/.* dev \([^ ]*\).*/\1/p' <<<" $rest")"
    case "$dev" in virbr* | kld-* | wg* | cilium_* | lxc* | vnet* | tap* | fc-* | "") continue ;; esac
    nforeign=$((nforeign + 1))
    for k in "${nets[@]}"; do
        if cidr_overlap "${NETPLAN[$k]}" "$dst"; then
            problem "${k} ${NETPLAN[$k]} overlaps ${dst}, which this host reaches via ${dev} -- not a kldload network"
        fi
    done
done <<<"$routes"
say INFO "checked against ${nforeign} route(s) through interfaces kldload does not own"

block="${NETPLAN[NET_BLOCK]:-}"
if [[ -n "$block" ]]; then
    out=()
    for k in "${nets[@]}"; do span_within "${NETPLAN[$k]}" "$block" || out+=("$k"); done
    ((${#out[@]} == 0)) || say INFO "outside ${block} (moved in phase 2 and 3 of docs/NETWORK-PLAN.md): ${out[*]}"
fi

echo "netplan: ${#NETPLAN_ORDER[@]} ranges, ${bad} problem(s)"
if ((bad)); then exit 1; fi
