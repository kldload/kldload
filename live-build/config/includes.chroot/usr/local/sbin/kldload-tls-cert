#!/usr/bin/env bash
# kldload-tls-cert — print a self-signed TLS cert + key on stdout for the
# kldload webui. kldload-webui calls this via subprocess and feeds the
# output to Python's ssl.SSLContext. Printing stdout (not writing files)
# keeps key material out of the filesystem — it lives only in the webui
# process's memory.
#
# Cert covers every hostname / IP the webui is likely reachable on so
# Chrome's SAN check doesn't bounce mic/camera permissions. Browsers
# will still show a one-time "certificate not trusted" warning — that's
# expected for self-signed. getUserMedia works once the user clicks
# through the warning.
set -euo pipefail

CERT_DIR="${KLDLOAD_TLS_CERT_DIR:-/var/lib/kldload/tls}"
KEY="${CERT_DIR}/webui.key"
CRT="${CERT_DIR}/webui.crt"

# Extra-SANs file — one entry per line (e.g. "DNS:kldload.example.com" or
# "IP:203.0.113.42"). Lets admins pin a stable DNS name or VIP that isn't
# auto-discoverable from `ip -4 -o addr show`. Blank lines + # comments
# ignored. File may not exist on fresh installs — that's fine.
EXTRA_SANS_FILE="${KLDLOAD_TLS_EXTRA_SANS:-/etc/kldload/tls-extra-sans.txt}"

# Generate once, reuse on every subsequent call. Regenerate if:
#   1. cert/key missing
#   2. cert expires within 24h
#   3. the machine has gained a non-loopback IP that isn't in the SAN
#      (e.g. fresh install: cert was created before DHCP completed, so
#      the SAN only has 127.0.0.1 — after the IP comes up, browsers
#      hitting :7681 or :3000 on that IP would get cert-mismatch and
#      the terminal iframe fails to load with no visible error)
_regen=0
if [[ ! -f "$CRT" || ! -f "$KEY" ]]; then
    _regen=1
elif ! openssl x509 -in "$CRT" -noout -checkend 86400 >/dev/null 2>&1; then
    _regen=1
else
    _san="$(openssl x509 -in "$CRT" -noout -ext subjectAltName 2>/dev/null || true)"
    # 1. drift on current non-loopback IPs
    while IFS= read -r _cur_ip; do
        [[ -z "$_cur_ip" ]] && continue
        if ! grep -qF "IP Address:${_cur_ip}" <<<"$_san"; then
            _regen=1
            break
        fi
    done < <(ip -4 -o addr show 2>/dev/null \
                | awk '{print $4}' \
                | cut -d/ -f1 \
                | grep -v '^127\.' || true)
    # 2. drift on IPv6 non-loopback addresses
    if [[ "$_regen" -eq 0 ]]; then
        while IFS= read -r _cur_ip6; do
            [[ -z "$_cur_ip6" ]] && continue
            # Skip link-local fe80::/10
            [[ "$_cur_ip6" == fe80:* ]] && continue
            if ! grep -qF "IP Address:${_cur_ip6}" <<<"$_san"; then
                _regen=1
                break
            fi
        done < <(ip -6 -o addr show 2>/dev/null \
                    | awk '{print $4}' \
                    | cut -d/ -f1 \
                    | grep -v '^::1$' || true)
    fi
    # 3. drift on hostname (handles hostname change via hostnamectl)
    if [[ "$_regen" -eq 0 ]]; then
        _cur_host="$(hostname -f 2>/dev/null || hostname 2>/dev/null || echo kldload-node)"
        if ! grep -qF "DNS:${_cur_host}" <<<"$_san"; then
            _regen=1
        fi
    fi
    # 4. drift on admin-supplied extra SANs
    if [[ "$_regen" -eq 0 && -r "$EXTRA_SANS_FILE" ]]; then
        while IFS= read -r _line; do
            # strip comments + whitespace, skip blanks
            _line="${_line%%#*}"
            _line="${_line## }"; _line="${_line%% }"
            [[ -z "$_line" ]] && continue
            # Line may be "DNS:foo.example.com" or "IP:203.0.113.1"
            # Convert to the SAN-check form that openssl emits
            if [[ "$_line" == DNS:* ]]; then
                _check="DNS:${_line#DNS:}"
            elif [[ "$_line" == IP:* ]]; then
                _check="IP Address:${_line#IP:}"
            else
                # Bare — guess by format
                if [[ "$_line" =~ ^[0-9a-fA-F:.]+$ ]]; then
                    _check="IP Address:${_line}"
                else
                    _check="DNS:${_line}"
                fi
            fi
            if ! grep -qF "$_check" <<<"$_san"; then
                _regen=1
                break
            fi
        done < "$EXTRA_SANS_FILE"
    fi
fi

if [[ "$_regen" -eq 1 ]]; then
    mkdir -p "$CERT_DIR"
    chmod 0700 "$CERT_DIR"

    # Collect every SAN the webui might serve under: hostname, short
    # hostname, every non-loopback IP. DNS / IP SANs both matter —
    # Chrome and Firefox won't accept a cert that only has CN.
    _hostname="$(hostname -f 2>/dev/null || hostname 2>/dev/null || echo kldload-node)"
    _short="$(hostname -s 2>/dev/null || echo kldload)"
    _ips=()
    # libvirt default network (virbr0) is deterministically 192.168.122.1
    # on every kldload install — add it unconditionally so the cert is
    # complete even if libvirtd hasn't finished starting yet when this
    # script first runs. Without this, a race between boot, tls-cert,
    # libvirtd and kldload-proxy leaves the proxy holding a pre-libvirt
    # cert while later browsers fetch a drifted one, causing
    # SSLV3_ALERT_CERTIFICATE_UNKNOWN on concurrent connections.
    _ips+=("192.168.122.1")
    while IFS= read -r ip; do
        [[ -n "$ip" ]] && _ips+=("$ip")
    done < <(ip -4 -o addr show 2>/dev/null \
                | awk '{print $4}' \
                | cut -d/ -f1 \
                | grep -v '^127\.' \
                | grep -v '^192\.168\.122\.1$' || true)
    # IPv6 — link-local (fe80::/10) excluded; they rotate + don't help
    _ips6=()
    while IFS= read -r ip6; do
        [[ -z "$ip6" ]] && continue
        [[ "$ip6" == fe80:* ]] && continue
        _ips6+=("$ip6")
    done < <(ip -6 -o addr show 2>/dev/null \
                | awk '{print $4}' \
                | cut -d/ -f1 \
                | grep -v '^::1$' || true)

    # Extra SANs from admin file
    _extra_dns=()
    _extra_ips=()
    if [[ -r "$EXTRA_SANS_FILE" ]]; then
        while IFS= read -r _line; do
            _line="${_line%%#*}"; _line="${_line## }"; _line="${_line%% }"
            [[ -z "$_line" ]] && continue
            if [[ "$_line" == DNS:* ]]; then
                _extra_dns+=("${_line#DNS:}")
            elif [[ "$_line" == IP:* ]]; then
                _extra_ips+=("${_line#IP:}")
            elif [[ "$_line" =~ ^[0-9a-fA-F:.]+$ ]]; then
                _extra_ips+=("$_line")
            else
                _extra_dns+=("$_line")
            fi
        done < "$EXTRA_SANS_FILE"
    fi

    {
        echo "[req]"
        echo "distinguished_name = dn"
        echo "x509_extensions    = v3_ca"
        echo "prompt             = no"
        echo "[dn]"
        echo "CN = ${_hostname}"
        echo "O  = kldload"
        echo "[v3_ca]"
        echo "subjectAltName = @alt"
        echo "basicConstraints = critical,CA:FALSE"
        echo "keyUsage         = digitalSignature,keyEncipherment"
        echo "extendedKeyUsage = serverAuth"
        echo "[alt]"
        echo "DNS.1 = ${_hostname}"
        echo "DNS.2 = ${_short}"
        echo "DNS.3 = localhost"
        echo "DNS.4 = kldload.local"
        _dns_i=5
        for _d in "${_extra_dns[@]}"; do
            echo "DNS.${_dns_i} = ${_d}"
            _dns_i=$((_dns_i + 1))
        done
        echo "IP.1  = 127.0.0.1"
        echo "IP.2  = ::1"
        # Not inside a function, so `local` is illegal under set -euo
        # pipefail — was aborting the whole script before openssl ran.
        _i=3
        for ip in "${_ips[@]}"; do
            echo "IP.${_i} = ${ip}"
            _i=$((_i + 1))
        done
        for ip6 in "${_ips6[@]}"; do
            echo "IP.${_i} = ${ip6}"
            _i=$((_i + 1))
        done
        for ip in "${_extra_ips[@]}"; do
            echo "IP.${_i} = ${ip}"
            _i=$((_i + 1))
        done
    } > "${CERT_DIR}/webui.cnf"

    # Prefer the kldload CA when present — every service on the box
    # chains to one root, which the system trust store + (optionally) the
    # user's browser trust ONCE. Falls back to the old self-signed path
    # if kldload-ca is missing or fails, so the boot path never regresses.
    _issued_via_ca=0
    if [[ -x /usr/local/sbin/kldload-ca ]]; then
        /usr/local/sbin/kldload-ca init >&2 2>/dev/null || true
        if [[ -f /etc/kldload/ca/root/ca.crt ]]; then
            _ca_args=(issue webui --days 365)
            _ca_args+=(--dns "${_hostname}" --dns "${_short}" --dns localhost --dns kldload.local)
            for _d in "${_extra_dns[@]}"; do _ca_args+=(--dns "${_d}"); done
            _ca_args+=(--ip 127.0.0.1 --ip ::1)
            for ip  in "${_ips[@]}";       do _ca_args+=(--ip "${ip}");  done
            for ip6 in "${_ips6[@]}";      do _ca_args+=(--ip "${ip6}"); done
            for ip  in "${_extra_ips[@]}"; do _ca_args+=(--ip "${ip}");  done
            if /usr/local/sbin/kldload-ca "${_ca_args[@]}" >&2; then
                cp /etc/kldload/ca/leaves/webui.key "$KEY"
                cp /etc/kldload/ca/leaves/webui.crt "$CRT"
                _issued_via_ca=1
            fi
        fi
    fi
    if [[ "$_issued_via_ca" -eq 0 ]]; then
        # Fallback — self-signed leaf. Preserves prior behavior on any
        # path where kldload-ca isn't yet installed or failed.
        openssl req -x509 -nodes -newkey rsa:2048 \
            -keyout "$KEY" -out "$CRT" \
            -days 3650 \
            -config "${CERT_DIR}/webui.cnf" >&2
    fi

    rm -f "${CERT_DIR}/webui.cnf"
    chmod 0600 "$KEY" "$CRT"

    # Cert just rotated. Try-restart every service that loaded the old
    # cert into memory — ttyd-k9s, kldload-webui, grafana-server — so the
    # browser sees the new SANs on next connect. Silent on services that
    # aren't installed (grafana-server only exists on obs profiles).
    # --no-block so we don't block boot if one of them is sluggish.
    if [[ -x /usr/local/sbin/kldload-bounce-tls-services ]]; then
        /usr/local/sbin/kldload-bounce-tls-services >/dev/null 2>&1 || true
    fi
fi

# Emit cert + key on stdout as one blob. kldload-webui splits it.
cat "$CRT"
cat "$KEY"
