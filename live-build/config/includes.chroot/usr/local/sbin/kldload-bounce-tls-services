#!/bin/bash
# Post-cert-regen: chmod the cert + bounce the services that use it.
#
# BUT: skip the bounce entirely if the installer or a klab run is in
# flight. Restarting webui during those operations kills the subprocess
# tree (webui cgroup). Observed failure: wifi join → NM fires
# network-online → kldload-tls-cert.service re-runs (it has
# Wants=network-online.target) → this script runs → webui restarts mid
# install-target → install dies with zero log output and a confused
# user staring at a blank browser tab.
#
# Flag files written by:
#   /var/run/kldload/installer-busy   — kldload-install-target on start,
#                                       removed on exit (trap)
#   /var/run/klab/current-run.env     — klab_test action in webui
#
# Skip conditions are cheap stat() calls, zero dependency. The cert
# regen itself still runs (fast) — we just defer the noisy bounce.
set -u

CERT=/var/lib/kldload/tls/webui.crt
KEY=/var/lib/kldload/tls/webui.key
[[ -e "$CERT" ]] && chmod 0644 "$CERT" 2>/dev/null || true
[[ -e "$KEY" ]] && chmod 0640 "$KEY" 2>/dev/null || true

# Only a CHANGED certificate is worth a restart. This runs as the unit's
# ExecStartPost, i.e. on every start of kldload-tls-cert, and the unit is
# started by the dispatcher on every network event; before this the
# restarts ran whether or not the cert script had regenerated anything
# (onyx 2026-09-05: 115 starts in a day, Grafana and the webui start-limited
# and dead). The last bounced cert's digest is remembered beside the cert.
_digest_file=/var/lib/kldload/tls/.bounced-sha256
_digest="$(sha256sum "$CERT" 2>/dev/null | awk '{print $1}')"
if [[ -n "$_digest" && -r "$_digest_file" && "$(cat "$_digest_file")" == "$_digest" ]]; then
    logger -t kldload-bounce-tls-services "cert unchanged — nothing to restart"
    exit 0
fi
if [[ -e /var/run/kldload/installer-busy ]]; then
    logger -t kldload-bounce-tls-services "installer busy — skipping webui/ttyd/grafana restart"
    exit 0
fi
if [[ -e /var/run/klab/current-run.env ]]; then
    logger -t kldload-bounce-tls-services "klab run in flight — skipping webui/ttyd/grafana restart"
    exit 0
fi

# TLS-terminating and TLS-consuming services need to re-read the cert
# after kldload-tls-cert regenerates it. There are two bounce modes:
#
#   1. RELOAD (graceful): nginx handles this via SIGHUP. New worker
#      processes spawn with the new cert, old workers drain in-flight
#      requests (including long-lived WebSockets — Grafana Live, ttyd
#      terminals, Headlamp exec streams don't drop). This is the
#      right move for 1.0.6.
#
#   2. RESTART (full): used for kldload-webui because it loads the
#      cert via kldload-tls-cert stdin and has no reload signal. Also
#      for ttyd-k9s / grafana-server on 1.0.5 images where the Python
#      kldload-proxy was the :8443 terminator.
#
# 1.0.6 rollout preserves rollback: we bounce BOTH kldload-proxy
# (1.0.5 path) and nginx (1.0.6 path). Whichever is running picks up
# the new cert; the other is a no-op. Keeps the upgrade safe.
#
# Observed drift-race history: on 1.0.5 .121/.122/.127 the old
# kldload-proxy held a stale cert in its SSLContext after kldload-tls-cert
# regenerated for the post-DHCP libvirt IP, and concurrent browser
# connections saw SSLV3_ALERT_CERTIFICATE_UNKNOWN. nginx's SIGHUP
# reload makes that class of bug structurally impossible.

# 1. Graceful nginx reload (1.0.6 path). `reload` ~= SIGHUP.
if systemctl is-active nginx >/dev/null 2>&1; then
    logger -t kldload-bounce-tls-services "nginx active — reloading gracefully"
    systemctl --no-block reload nginx 2>/dev/null || true
fi

# 2. Legacy kldload-proxy restart (1.0.5 rollback path). No-op if the
# service is not present or disabled on this install.
if systemctl list-unit-files kldload-proxy.service >/dev/null 2>&1; then
    systemctl --no-block try-restart kldload-proxy 2>/dev/null || true
fi

# 3. Services that consume the cert directly (not through nginx).
for svc in ttyd-k9s kldload-webui grafana-server; do
    systemctl --no-block try-restart "$svc" 2>/dev/null || true
done
[[ -z "$_digest" ]] || printf '%s\n' "$_digest" >"$_digest_file"
