#!/bin/bash
# Post-cert-regen: chmod the cert + bounce the services that use it.
#
# BUT: skip the bounce entirely if the installer or a klab run is in
# flight. Restarting webui during those operations kills the subprocess
# tree (webui cgroup). Observed failure: wifi join → NM fires
# network-online → kldload-tls-cert.service re-runs (it has
# Wants=network-online.target) → this script runs → webui restarts mid
# install-target → install dies with zero log output and a confused
# user staring at a blank browser tab.
#
# Flag files written by:
#   /var/run/kldload/installer-busy   — kldload-install-target on start,
#                                       removed on exit (trap)
#   /var/run/klab/current-run.env     — klab_test action in webui
#
# Skip conditions are cheap stat() calls, zero dependency. The cert
# regen itself still runs (fast) — we just defer the noisy bounce.
set -u

CERT=/var/lib/kldload/tls/webui.crt
KEY=/var/lib/kldload/tls/webui.key
[[ -e "$CERT" ]] && chmod 0644 "$CERT" 2>/dev/null || true
[[ -e "$KEY"  ]] && chmod 0640 "$KEY"  2>/dev/null || true

if [[ -e /var/run/kldload/installer-busy ]]; then
    logger -t kldload-bounce-tls-services "installer busy — skipping webui/ttyd/grafana restart"
    exit 0
fi
if [[ -e /var/run/klab/current-run.env ]]; then
    logger -t kldload-bounce-tls-services "klab run in flight — skipping webui/ttyd/grafana restart"
    exit 0
fi

# IMPORTANT: kldload-proxy must restart too. It's the ONLY thing now
# terminating TLS on :8443 (webui + grafana + ttyd all run plain HTTP
# on loopback behind it), so it holds the cert in its SSLContext. If
# cert regens happen while the proxy keeps serving the pre-regen cert
# from memory, browsers see SSLV3_ALERT_CERTIFICATE_UNKNOWN on
# new connections and the Grafana iframe shows "failed to load" or
# "charts for 10 seconds then dead" (first wave of connections was
# from before the drift, subsequent refresh waves hit the new cert
# and fail). Observed live on .121/.122/.127 all three times until
# this fix landed.
for svc in kldload-proxy ttyd-k9s kldload-webui grafana-server; do
    systemctl --no-block try-restart "$svc" 2>/dev/null || true
done
