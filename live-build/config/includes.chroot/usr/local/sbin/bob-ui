<script>
// ── State ──────────────────────────────────────────────
let conversationId = null;
let conversationHistory = [];
let streaming = false;

// ── Init ───────────────────────────────────────────────
window.onload = () => {
  addBobMessage('BOB_GREETING_TEXT');
  loadConversations();
  checkStatus();
  setInterval(checkStatus, 30000);
  document.getElementById('input').focus();
};

// ── Status ─────────────────────────────────────────────
function checkStatus() {
  fetch('/api/status')
    .then(r => r.json())
    .then(d => {
      const dot = document.getElementById('status-dot');
      dot.className = 'status-dot ' + (d.ollama ? 'online' : 'offline');
      dot.title = d.ollama ? 'Bob is ready' : 'Waiting for Ollama...';
    })
    .catch(() => {
      document.getElementById('status-dot').className = 'status-dot offline';
    });
}

// ── Sidebar ────────────────────────────────────────────
function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('collapsed');
}

function loadConversations() {
  fetch('/api/conversations')
    .then(r => r.json())
    .then(convs => {
      const list = document.getElementById('conv-list');
      list.innerHTML = '';
      if (convs.length === 0) return;

      const now = new Date();
      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const yesterday = new Date(today - 86400000);
      const weekAgo = new Date(today - 604800000);

      let lastGroup = '';
      for (const c of convs) {
        const d = new Date(c.updated_at + 'Z');
        let group = 'Older';
        if (d >= today) group = 'Today';
        else if (d >= yesterday) group = 'Yesterday';
        else if (d >= weekAgo) group = 'This week';

        if (group !== lastGroup) {
          const label = document.createElement('div');
          label.className = 'conv-group-label';
          label.textContent = group;
          list.appendChild(label);
          lastGroup = group;
        }

        const item = document.createElement('div');
        item.className = 'conv-item' + (c.id === conversationId ? ' active' : '');
        item.textContent = c.title || 'Untitled';
        item.onclick = () => loadConversation(c.id);

        const del = document.createElement('button');
        del.className = 'delete-btn';
        del.innerHTML = '&#10005;';
        del.onclick = (e) => { e.stopPropagation(); deleteConversation(c.id); };
        item.appendChild(del);

        list.appendChild(item);
      }
    })
    .catch(() => {});
}

function loadConversation(id) {
  fetch('/api/conversations/' + id + '/messages')
    .then(r => r.json())
    .then(msgs => {
      conversationId = id;
      conversationHistory = msgs;
      const el = document.getElementById('messages');
      el.innerHTML = '';
      for (const m of msgs) {
        if (m.role === 'user') addUserMessage(m.content, false);
        else addBobMessage(m.content, false);
      }
      el.scrollTop = el.scrollHeight;
      loadConversations();
    })
    .catch(() => {});
}

function deleteConversation(id) {
  fetch('/api/conversations/' + id, { method: 'DELETE' })
    .then(() => {
      if (id === conversationId) newChat();
      else loadConversations();
    })
    .catch(() => {});
}

function newChat() {
  conversationId = null;
  conversationHistory = [];
  document.getElementById('messages').innerHTML = '';
  addBobMessage('BOB_GREETING_TEXT');
  loadConversations();
  document.getElementById('input').focus();
}

// ── Messages ───────────────────────────────────────────
function addUserMessage(text, scroll = true) {
  const el = document.getElementById('messages');
  const div = document.createElement('div');
  div.className = 'msg user';
  div.textContent = text;
  el.appendChild(div);
  if (scroll) el.scrollTop = el.scrollHeight;
}

function addBobMessage(text, scroll = true) {
  const el = document.getElementById('messages');
  const div = document.createElement('div');
  div.className = 'msg bob';
  const content = document.createElement('div');
  content.className = 'content';
  content.innerHTML = renderMarkdown(text);
  div.appendChild(content);
  el.appendChild(div);
  if (scroll) el.scrollTop = el.scrollHeight;
  return content;
}

function createStreamingBubble() {
  const el = document.getElementById('messages');
  const div = document.createElement('div');
  div.className = 'msg bob';
  const content = document.createElement('div');
  content.className = 'content';
  const cursor = document.createElement('span');
  cursor.className = 'cursor';
  content.appendChild(cursor);
  div.appendChild(content);
  el.appendChild(div);
  el.scrollTop = el.scrollHeight;
  return content;
}

// ── Markdown ───────────────────────────────────────────
function renderMarkdown(text) {
  if (!text) return '';
  // Protect code blocks
  const codeBlocks = [];
  text = text.replace(/```(\w*)\n?([\s\S]*?)```/g, (_, lang, code) => {
    codeBlocks.push('<pre><code class="lang-' + (lang||'text') + '">' + escHtml(code.trim()) + '</code></pre>');
    return '\x00CB' + (codeBlocks.length - 1) + '\x00';
  });
  // Inline code
  text = text.replace(/`([^`]+)`/g, '<code>' + '$1' + '</code>');
  // Headers
  text = text.replace(/^### (.+)$/gm, '<h3>$1</h3>');
  text = text.replace(/^## (.+)$/gm, '<h2>$1</h2>');
  text = text.replace(/^# (.+)$/gm, '<h1>$1</h1>');
  // Bold + italic
  text = text.replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>');
  text = text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  text = text.replace(/\*(.+?)\*/g, '<em>$1</em>');
  // Blockquote
  text = text.replace(/^> (.+)$/gm, '<blockquote>$1</blockquote>');
  // Links
  text = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank">$1</a>');
  // Unordered lists
  text = text.replace(/^[-*] (.+)$/gm, '<li>$1</li>');
  text = text.replace(/((?:<li>.*<\/li>\n?)+)/g, '<ul>$1</ul>');
  // Ordered lists
  text = text.replace(/^\d+\. (.+)$/gm, '<li>$1</li>');
  // Horizontal rule
  text = text.replace(/^---$/gm, '<hr>');
  // Paragraphs
  text = text.replace(/\n\n+/g, '</p><p>');
  text = '<p>' + text + '</p>';
  text = text.replace(/<p><(h[1-3]|ul|ol|pre|blockquote|hr)/g, '<$1');
  text = text.replace(/<\/(h[1-3]|ul|ol|pre|blockquote)><\/p>/g, '</$1>');
  text = text.replace(/<hr><\/p>/g, '<hr>');
  text = text.replace(/<p><\/p>/g, '');
  // Restore code blocks
  text = text.replace(/\x00CB(\d+)\x00/g, (_, i) => codeBlocks[parseInt(i)]);
  // Line breaks within paragraphs
  text = text.replace(/\n/g, '<br>');
  return text;
}

function escHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── Streaming chat ─────────────────────────────────────
function isActionRequest(text) {
  const t = text.toLowerCase();
  const actions = [
    /^(open|launch|start|run|close|kill|stop)\b/,
    /^(play|pause|resume|mute|unmute|volume)\b/,
    /^(set|turn|dim|brighten|toggle)\b.*\b(light|volume|brightness)/,
    /^(send|text|message|notify|remind|post)\b/,
    /^(check|show|list|find|scan|what'?s)\b.*\b(process|service|disk|cpu|ram|weather|running|screen)/,
    /^(take|capture)\b.*\b(screenshot|photo)/,
    /^(install|setup|configure|create|deploy|restart)\b/,
    /terminal|htop|screenshot|notification|reminder|dictate|write.*file|write.*script|take.*note|clipboard|copied/,
    /^(find|search|where)\b.*\b(file|pdf|doc|photo|download)/,
    /^(add|remove|list|who)\b.*\b(contact|calendar|event|schedule)/,
    /\b(system|health|monitor|status|temperature|gpu temp)\b/,
    /\b(plex|jellyfin|hue|spotify|discord)\b/,
  ];
  return actions.some(r => r.test(t));
}

async function sendMessage() {
  if (streaming) return;
  const input = document.getElementById('input');
  const text = input.value.trim();
  if (!text) return;

  input.value = '';
  autoResize(input);
  addUserMessage(text);

  // Route actions to agent
  if (isActionRequest(text)) {
    streaming = true;
    document.getElementById('send-btn').disabled = true;
    const bubble = createStreamingBubble();
    bubble.innerHTML = '<p style="color:var(--dim)">Executing...</p>';

    try {
      const resp = await fetch('/api/agent', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({command: text})
      });
      const data = await resp.json();
      const output = data.output || data.error || 'Done';
      bubble.innerHTML = renderMarkdown(output);
      conversationHistory.push({role: 'user', content: text});
      conversationHistory.push({role: 'assistant', content: output});
      speakText(output);
      loadConversations();
    } catch(e) {
      bubble.innerHTML = '<p style="color:var(--neon-pink)">Agent failed</p>';
    }
    streaming = false;
    document.getElementById('send-btn').disabled = false;
    document.getElementById('input').focus();
    return;
  }

  streaming = true;
  document.getElementById('send-btn').disabled = true;
  const bubble = createStreamingBubble();
  let fullResponse = '';

  try {
    const resp = await fetch('/api/chat', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        message: text,
        conversation_id: conversationId,
        history: conversationHistory
      })
    });

    if (!resp.ok) {
      const err = await resp.json().catch(() => ({error: 'Something went wrong'}));
      bubble.innerHTML = '<p style="color:var(--neon-pink)">' + escHtml(err.error || 'Error') + '</p>';
      streaming = false;
      document.getElementById('send-btn').disabled = false;
      return;
    }

    const reader = resp.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';

    while (true) {
      const {done, value} = await reader.read();
      if (done) break;

      buffer += decoder.decode(value, {stream: true});
      const lines = buffer.split('\n');
      buffer = lines.pop();

      for (const line of lines) {
        if (!line.trim()) continue;
        try {
          const chunk = JSON.parse(line);
          if (chunk.conversation_id) conversationId = chunk.conversation_id;
          if (chunk.message && chunk.message.content) {
            fullResponse += chunk.message.content;
            bubble.innerHTML = renderMarkdown(fullResponse) + '<span class="cursor"></span>';
            document.getElementById('messages').scrollTop = document.getElementById('messages').scrollHeight;
          }
        } catch(e) {}
      }
    }

    // Final render without cursor
    bubble.innerHTML = renderMarkdown(fullResponse);
    conversationHistory.push({role: 'user', content: text});
    conversationHistory.push({role: 'assistant', content: fullResponse});
    speakText(fullResponse);
    loadConversations();

  } catch(e) {
    bubble.innerHTML = '<p style="color:var(--neon-pink)">Connection failed. Is Bob\'s brain loaded?</p>';
  }

  streaming = false;
  document.getElementById('send-btn').disabled = false;
  document.getElementById('input').focus();
}

// ── Input handling ─────────────────────────────────────
function handleKey(e) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendMessage();
  }
}

// Hold Ctrl+Space to talk — release to send
let pttActive = false;
document.addEventListener('keydown', (e) => {
  if (e.code === 'Space' && e.ctrlKey && !pttActive && !streaming) {
    e.preventDefault();
    pttActive = true;
    startRecording();
  }
});
document.addEventListener('keyup', (e) => {
  if (e.code === 'Space' && pttActive) {
    e.preventDefault();
    pttActive = false;
    stopRecording();
  }
});

// ── Voice input ────────────────────────────────────────
let mediaRecorder = null;
let audioChunks = [];
let isRecording = false;
let ttsEnabled = false;

function toggleTTS() {
  ttsEnabled = !ttsEnabled;
  const btn = document.getElementById('tts-btn');
  if (ttsEnabled) {
    btn.innerHTML = '&#128266; On';
    btn.style.color = 'var(--neon-blue)';
    btn.style.borderColor = 'var(--neon-blue)';
  } else {
    btn.innerHTML = '&#128264; Off';
    btn.style.color = 'var(--dim)';
    btn.style.borderColor = 'var(--border)';
  }
}

function speakText(text) {
  if (!ttsEnabled || !text) return;
  // Strip markdown for cleaner speech
  let clean = text.replace(/```[\s\S]*?```/g, ' code block ')
    .replace(/`[^`]+`/g, '')
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/\*([^*]+)\*/g, '$1')
    .replace(/#{1,3}\s*/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[-*] /g, '')
    .replace(/\n+/g, '. ')
    .trim();
  // Limit to ~500 chars for speed
  if (clean.length > 500) clean = clean.substring(0, 500) + '... and more.';
  fetch('/api/speak', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({text: clean})
  }).catch(() => {});
}

function toggleMic() {
  if (isRecording) {
    stopRecording();
  } else {
    startRecording();
  }
}

async function startRecording() {
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    // Try WAV first (sox can handle it), fall back to webm
    let mimeType = 'audio/webm';
    if (MediaRecorder.isTypeSupported('audio/wav')) mimeType = 'audio/wav';
    else if (MediaRecorder.isTypeSupported('audio/ogg')) mimeType = 'audio/ogg';
    mediaRecorder = new MediaRecorder(stream, { mimeType });
    audioChunks = [];

    mediaRecorder.ondataavailable = (e) => { if (e.data.size > 0) audioChunks.push(e.data); };
    mediaRecorder.onstop = async () => {
      stream.getTracks().forEach(t => t.stop());
      const blob = new Blob(audioChunks, { type: 'audio/webm' });
      await transcribeAudio(blob);
    };

    mediaRecorder.start();
    isRecording = true;
    document.getElementById('mic-btn').classList.add('recording');
    document.getElementById('mic-btn').title = 'Click to stop';
    document.getElementById('input').placeholder = 'Listening...';
  } catch(e) {
    alert('Microphone access denied. Check browser permissions.');
  }
}

function stopRecording() {
  if (mediaRecorder && mediaRecorder.state !== 'inactive') {
    mediaRecorder.stop();
  }
  isRecording = false;
  document.getElementById('mic-btn').classList.remove('recording');
  document.getElementById('mic-btn').title = 'Voice input';
  document.getElementById('input').placeholder = 'Transcribing...';
}

async function blobToWav(blob) {
  // Decode audio blob to PCM, encode as WAV for whisper
  const audioCtx = new (window.AudioContext || window.webkitAudioContext)({sampleRate: 16000});
  const arrayBuf = await blob.arrayBuffer();
  const audioBuf = await audioCtx.decodeAudioData(arrayBuf);
  const pcm = audioBuf.getChannelData(0);
  const wavBuf = new ArrayBuffer(44 + pcm.length * 2);
  const view = new DataView(wavBuf);
  // WAV header
  const writeStr = (o, s) => { for (let i=0;i<s.length;i++) view.setUint8(o+i, s.charCodeAt(i)); };
  writeStr(0, 'RIFF'); view.setUint32(4, 36 + pcm.length*2, true);
  writeStr(8, 'WAVE'); writeStr(12, 'fmt ');
  view.setUint32(16, 16, true); view.setUint16(20, 1, true);
  view.setUint16(22, 1, true); view.setUint32(24, 16000, true);
  view.setUint32(28, 32000, true); view.setUint16(32, 2, true);
  view.setUint16(34, 16, true); writeStr(36, 'data');
  view.setUint32(40, pcm.length*2, true);
  for (let i=0; i<pcm.length; i++) {
    let s = Math.max(-1, Math.min(1, pcm[i]));
    view.setInt16(44 + i*2, s < 0 ? s*0x8000 : s*0x7FFF, true);
  }
  audioCtx.close();
  return new Blob([wavBuf], {type: 'audio/wav'});
}

async function transcribeAudio(blob) {
  // Convert to WAV in browser — no ffmpeg needed
  try { blob = await blobToWav(blob); } catch(e) { console.log('WAV conversion failed, sending raw'); }
  const formData = new FormData();
  formData.append('audio', blob, 'recording.wav');

  try {
    const resp = await fetch('/api/transcribe', { method: 'POST', body: formData });
    const data = await resp.json();
    if (data.text && data.text.trim()) {
      document.getElementById('input').value = data.text.trim();
      document.getElementById('input').placeholder = 'Talk to Bob...';
      autoResize(document.getElementById('input'));
      // Auto-send
      sendMessage();
    } else {
      document.getElementById('input').placeholder = 'Talk to Bob...';
    }
  } catch(e) {
    document.getElementById('input').placeholder = 'Talk to Bob...';
  }
}

function autoResize(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 150) + 'px';
}
</script>
</body>
</html>"""

