<script>
let config = { model: 'bob', storage: 'none', persona: 'default', features: ['voice','desktop','bash'] };
let hwData = null;

window.onload = () => {
  fetch('/api/hardware').then(r=>r.json()).then(renderHardware).catch(()=>{});
  fetch('/api/disks').then(r=>r.json()).then(renderDisks).catch(()=>{});
  fetch('/api/personas').then(r=>r.json()).then(renderPersonas).catch(()=>{});
  fetch('/api/models').then(r=>r.json()).then(renderModels).catch(()=>{});
  fetch('/api/services/discover').then(r=>r.json()).then(renderDiscoveredServices).catch(()=>{});
  // Init feature checkboxes
  document.querySelectorAll('#feature-options .option').forEach(opt => {
    const cb = opt.querySelector('input[type=checkbox]');
    if (cb) opt.classList.toggle('selected', cb.checked);
  });
};

function renderDiscoveredServices(svcs) {
  if (!svcs || Object.keys(svcs).length === 0) return;
  // Show discovery banner
  const banner = document.createElement('div');
  banner.style.cssText = 'background:rgba(0,212,255,0.08);border:1px solid rgba(0,212,255,0.2);border-radius:8px;padding:0.8rem 1rem;margin-bottom:1.5rem;max-width:1000px;margin-left:auto;margin-right:auto;';
  let html = '<div style="font-size:0.75rem;color:var(--neon-blue);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.5rem">Services Found On Your Network</div>';
  for (const [key, svc] of Object.entries(svcs)) {
    html += '<div style="font-size:0.82rem;color:var(--white);margin-bottom:0.3rem">' +
      '<span style="color:var(--neon-blue)">&#10003;</span> ' + svc.name + ' at <code style="color:var(--chrome)">' + svc.url + '</code></div>';
  }
  html += '<div style="font-size:0.7rem;color:var(--dim);margin-top:0.5rem">Add your API keys below to connect Bob.</div>';
  banner.innerHTML = html;
  const grid = document.querySelector('.grid');
  grid.parentNode.insertBefore(banner, grid);

  // Auto-fill URLs
  if (svcs.plex) document.getElementById('plex-url').value = svcs.plex.url;
  if (svcs.jellyfin) document.getElementById('jellyfin-url').value = svcs.jellyfin.url;
  if (svcs.homeassistant) document.getElementById('ha-url').value = svcs.homeassistant.url;
}

function toggleFeature(name, on) {
  if (on && !config.features.includes(name)) config.features.push(name);
  if (!on) config.features = config.features.filter(f => f !== name);
  // Update checkbox visual
  document.querySelectorAll('#feature-options .option').forEach(opt => {
    const cb = opt.querySelector('input[type=checkbox]');
    if (cb) opt.classList.toggle('selected', cb.checked);
  });
}

let modelData = {};

function renderModels(data) {
  modelData = data;
  const container = document.getElementById('installed-models');
  if (!data.models || data.models.length === 0) return;

  let html = '';
  for (const m of data.models) {
    const active = (m.name === 'bob:latest' || m.name === 'bob') ? ' style="color:var(--neon-blue)"' : '';
    html += '<div' + active + '>' + m.name + ' — ' + m.size_gb + 'GB</div>';
  }
  container.innerHTML = html;

  // Show storage warning if no persistent storage
  if (!data.has_storage) {
    const warn = document.getElementById('model-storage-warn');
    if (warn) warn.style.display = 'block';
  }
}

function addCustomModel() {
  const input = document.getElementById('custom-model');
  const status = document.getElementById('model-pull-status');
  const model = input.value.trim();
  if (!model) return;

  if (!modelData.has_storage) {
    status.textContent = 'Set up persistent storage first — models need disk space.';
    status.style.color = 'var(--neon-pink)';
    return;
  }
  if (!modelData.online) {
    status.textContent = 'No internet connection — cannot download models.';
    status.style.color = 'var(--neon-pink)';
    return;
  }

  status.textContent = 'Pulling ' + model + '... this may take a while.';
  status.style.color = 'var(--neon-blue)';

  fetch('/api/config', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({model: model, pull_model: true})
  })
  .then(r => r.json())
  .then(d => {
    if (d.ok) {
      status.textContent = 'Pulling ' + model + '... check splash page for progress.';
      config.model = model;
    } else {
      status.textContent = d.error || 'Failed to pull model';
      status.style.color = 'var(--neon-pink)';
    }
  })
  .catch(() => {
    status.textContent = 'Connection failed';
    status.style.color = 'var(--neon-pink)';
  });
}

function renderPersonas(data) {
  const select = document.getElementById('persona-select');
  if (!data.personas || data.personas.length === 0) return;
  select.innerHTML = '';
  for (const p of data.personas) {
    const opt = document.createElement('option');
    opt.value = p.id;
    opt.textContent = p.name + (p.movie ? ' (' + p.movie + ')' : '') + ' — ' + p.tagline;
    if (p.id === 'default') opt.selected = true;
    select.appendChild(opt);
  }
}

function renderHardware(hw) {
  if (!hw || !hw.cpu) return;
  hwData = hw;
  let cpu = hw.cpu.replace(/\(R\)|\(TM\)|CPU|Processor|@ .*/gi, '').trim();

  let gpuBadge = '<span class="badge badge-low">CPU Only</span>';
  if (hw.gpu_type === 'nvidia') gpuBadge = '<span class="badge badge-good">GPU Accelerated</span>';
  else if (hw.gpu_type === 'amd' || hw.gpu_type === 'intel') gpuBadge = '<span class="badge badge-ok">Integrated</span>';

  let ramBadge = '<span class="badge badge-low">Limited</span>';
  if (hw.ram_gb >= 32) ramBadge = '<span class="badge badge-good">Excellent</span>';
  else if (hw.ram_gb >= 16) ramBadge = '<span class="badge badge-ok">Good</span>';

  document.getElementById('hw-info').innerHTML =
    '<div class="row"><span class="label">CPU</span><span class="value">' + cpu + ' &middot; ' + hw.cores + ' cores</span></div>' +
    '<div class="row"><span class="label">RAM</span><span class="value">' + hw.ram_gb + ' GB ' + ramBadge + '</span></div>' +
    '<div class="row"><span class="label">GPU</span><span class="value">' + (hw.gpu || 'None detected') + ' ' + gpuBadge + '</span></div>';

  // RAM warnings for big models
  if (hw.ram_gb < 32) document.getElementById('warn-32b').textContent = 'Your system has ' + hw.ram_gb + 'GB RAM — this model needs 32GB+';
  if (hw.ram_gb < 48) document.getElementById('warn-70b').textContent = 'Your system has ' + hw.ram_gb + 'GB RAM — this model needs 48GB+';
}

function renderDisks(disks) {
  const list = document.getElementById('disk-list');
  if (!disks || disks.length === 0) return;
  for (const d of disks) {
    const div = document.createElement('div');
    div.className = 'option';
    div.onclick = function() { selectOption(this, 'storage', '/dev/' + d.name); };
    div.innerHTML =
      '<div class="dot"></div>' +
      '<div class="info">' +
        '<div class="name">/dev/' + d.name + ' <span class="size">(' + d.size + ')</span></div>' +
        '<div class="desc">' + (d.model || 'Unknown disk') + '</div>' +
      '</div>';
    list.appendChild(div);
  }
}

function selectOption(el, key, value) {
  config[key] = value;
  el.parentElement.querySelectorAll('.option').forEach(o => o.classList.remove('selected'));
  // Also check sibling containers for storage
  if (key === 'storage') {
    document.getElementById('disk-options').querySelectorAll('.option').forEach(o => o.classList.remove('selected'));
    document.getElementById('disk-list').querySelectorAll('.option').forEach(o => o.classList.remove('selected'));
  }
  el.classList.add('selected');
}

function wakeBob() {
  const btn = document.querySelector('.wake-btn');
  const msg = document.getElementById('status-msg');
  btn.disabled = true;
  btn.textContent = 'WAKING BOB UP...';
  msg.textContent = 'Saving configuration...';

  // Collect API keys
  function v(id) { return (document.getElementById(id)||{}).value||''; }
  config.services = {
    plex: { url: v('plex-url'), token: v('plex-token') },
    jellyfin: { url: v('jellyfin-url'), key: v('jellyfin-key') },
    homeassistant: { url: v('ha-url'), token: v('ha-token') },
    spotify: { client_id: v('spotify-id'), client_secret: v('spotify-secret') },
    weather: { key: v('weather-key') },
    pushover: { user: v('pushover-user'), token: v('pushover-token') },
    twilio: { sid: v('twilio-sid'), token: v('twilio-token'), from: v('twilio-from') },
    mqtt: { url: v('mqtt-url'), user: v('mqtt-user') },
    discord: { webhook: v('discord-webhook') },
    hue: { ip: v('hue-ip'), user: v('hue-user') }
  };

  fetch('/api/config', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(config)
  })
  .then(r => r.json())
  .then(d => {
    if (d.ok) {
      msg.textContent = 'Configuration saved. Loading Bob...';
      setTimeout(() => { window.location.href = 'http://localhost:9090'; }, 1500);
    } else {
      msg.textContent = d.error || 'Something went wrong';
      btn.disabled = false;
      btn.textContent = 'WAKE BOB UP';
    }
  })
  .catch(() => {
    msg.textContent = 'Connection failed';
    btn.disabled = false;
    btn.textContent = 'WAKE BOB UP';
  });
}
</script>
</body>
</html>"""


# ---------------------------------------------------------------------------
# HTTP Handler
# ---------------------------------------------------------------------------
class BobHandler(http.server.BaseHTTPRequestHandler):

    def do_GET(self):
        path = self.path.split("?")[0]

        if path == "/":
            greeting = get_persona_greeting()
            html = CHAT_HTML.replace("BOB_GREETING_TEXT", greeting.replace('"', '&quot;').replace("'", "\\'"))
            self._html(html)
        elif path == "/builder":
            self._html(BUILDER_HTML)
        elif path == "/api/status":
            self._json({"ollama": check_ollama(), "model": BOB_MODEL})
        elif path == "/api/hardware":
            hw = get_hardware()
            self._json(hw if hw else {})
        elif path == "/api/disks":
            self._json(get_disks())
        elif path == "/api/models":
            try:
                resp = urllib.request.urlopen(f"{OLLAMA_URL}/api/tags", timeout=5)
                data = json.loads(resp.read())
                models = [{"name": m["name"], "size_gb": round(m.get("size", 0) / 1e9, 1)} for m in data.get("models", [])]
                online = False
                try:
                    urllib.request.urlopen("https://ollama.com", timeout=3)
                    online = True
                except Exception:
                    pass
                has_storage = os.path.islink(os.path.expanduser("~/.bob")) or os.path.ismount("/mnt/bob-persist")
                self._json({"models": models, "online": online, "has_storage": has_storage})
            except Exception:
                self._json({"models": [], "online": False})
        elif path == "/api/personas":
            self._json(load_personas())
        elif path == "/api/configured":
            configured = os.path.exists("/etc/bob/bob.conf")
            self._json({"configured": configured})
        elif path == "/api/services/discover":
            try:
                with open("/tmp/bob-services.json") as f:
                    self._json(json.load(f))
            except Exception:
                self._json({})
        elif path == "/api/conversations":
            self._json(get_conversations())
        elif path.startswith("/api/conversations/") and path.endswith("/messages"):
            conv_id = path.split("/")[3]
            self._json(get_conversation_messages(conv_id))
        else:
            self.send_error(404)

    def do_POST(self):
        path = self.path.split("?")[0]

        if path == "/api/agent":
            self._handle_agent()
        elif path == "/api/speak":
            self._handle_speak()
        elif path == "/api/transcribe":
            self._handle_transcribe()
        elif path == "/api/chat":
            self._handle_chat()
        elif path == "/api/config":
            self._handle_config()
        else:
            self.send_error(404)

    def do_DELETE(self):
        path = self.path.split("?")[0]
        if path.startswith("/api/conversations/"):
            conv_id = path.split("/")[3]
            delete_conversation(conv_id)
            self._json({"ok": True})
        else:
            self.send_error(404)

    # ── Agent — execute tools ───────────────────────────
    def _handle_agent(self):
        try:
            body = self._read_body()
            command = body.get("command", "").strip()
            if not command:
                self._json({"error": "No command"}, 400)
                return

            # Run bob-agent as the live user with their desktop session
            env_str = "DISPLAY=:0 WAYLAND_DISPLAY=wayland-0"
            for uid_dir in os.listdir("/run/user/"):
                bus = f"/run/user/{uid_dir}/bus"
                if os.path.exists(bus):
                    env_str += f" DBUS_SESSION_BUS_ADDRESS=unix:path={bus}"
                    env_str += f" XDG_RUNTIME_DIR=/run/user/{uid_dir}"
                    break

            result = subprocess.run(
                ["sudo", "-u", "live", "bash", "-c",
                 f"{env_str} /usr/local/bin/bob-agent '{command.replace(chr(39), chr(39)+chr(92)+chr(39)+chr(39))}'"],
                capture_output=True, text=True, timeout=120
            )
            output = result.stdout + result.stderr
            self._json({"output": output.strip(), "exit_code": result.returncode})
        except subprocess.TimeoutExpired:
            self._json({"output": "Command timed out", "exit_code": -1})
        except Exception as e:
            self._json({"error": str(e)}, 500)

    # ── Text to speech ────────────────────────────────────
    def _handle_speak(self):
        try:
            body = self._read_body()
            text = body.get("text", "").strip()
            if not text:
                self._json({"error": "No text"}, 400)
                return

            wav_path = "/tmp/bob-speech.wav"

            # Try piper first
            if os.path.exists("/opt/piper/piper"):
                result = subprocess.run(
                    ["/opt/piper/piper",
                     "--model", "/opt/piper/models/en_US-lessac-medium.onnx",
                     "--output_file", wav_path],
                    input=text, capture_output=True, text=True, timeout=30
                )
                if result.returncode == 0:
                    # Play through PipeWire (as live user) or fallback to ALSA devices
                    played = False
                    # Try paplay first (PipeWire/PulseAudio - best)
                    try:
                        r = subprocess.run(
                            ["sudo", "-u", "live", "bash", "-c",
                             f"XDG_RUNTIME_DIR=/run/user/1000 paplay {wav_path}"],
                            capture_output=True, timeout=30)
                        if r.returncode == 0:
                            played = True
                    except Exception:
                        pass
                    # Fallback to ALSA devices
                    if not played:
                        for dev in ["plughw:1,3", "plughw:0,0", "plughw:2,0", "default"]:
                            try:
                                r = subprocess.run(["aplay", "-q", "-D", dev, wav_path],
                                                 capture_output=True, timeout=15)
                                if r.returncode == 0:
                                    break
                            except Exception:
                                continue
                    self._json({"status": "speaking", "engine": "piper"})
                    return

            # Fallback to espeak-ng
            subprocess.run(
                ["sudo", "-u", "live", "bash", "-c",
                 f"XDG_RUNTIME_DIR=/run/user/1000 espeak-ng -s 160 '{text.replace(chr(39), chr(39)+chr(92)+chr(39)+chr(39))}'"],
                capture_output=True, timeout=30
            )
            if result.returncode == 0:
                self._json({"status": "speaking", "engine": "espeak-ng"})
                return

            self._json({"error": "No TTS engine available"}, 503)
        except Exception as e:
            self._json({"error": str(e)}, 500)

    # ── Voice transcription ─────────────────────────────
    def _handle_transcribe(self):
        try:
            import cgi
            import tempfile

            content_type = self.headers.get("Content-Type", "")
            if "multipart/form-data" not in content_type:
                self._json({"error": "Expected multipart/form-data"}, 400)
                return

            # Parse multipart form data
            boundary = content_type.split("boundary=")[-1].encode()
            length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(length)

            # Extract audio data (simple multipart parser)
            parts = body.split(b"--" + boundary)
            audio_data = None
            for part in parts:
                if b"filename=" in part:
                    # Find the blank line separating headers from content
                    header_end = part.find(b"\r\n\r\n")
                    if header_end != -1:
                        audio_data = part[header_end + 4:]
                        # Remove trailing boundary markers
                        if audio_data.endswith(b"\r\n"):
                            audio_data = audio_data[:-2]
                        break

            if not audio_data:
                self._json({"error": "No audio data received"}, 400)
                return

            # Save audio — browser sends WAV (converted client-side)
            wav_path = "/tmp/bob-voice-input.wav"
            with open(wav_path, "wb") as f:
                f.write(audio_data)

            # Transcribe with whisper
            whisper_bin = "/opt/whisper.cpp/build/bin/whisper-cli"
            whisper_model = "/opt/whisper.cpp/models/ggml-base.en.bin"

            if not os.path.exists(whisper_bin):
                self._json({"error": "Whisper not installed"}, 503)
                return

            result = subprocess.run(
                [whisper_bin, "-m", whisper_model, "-f", wav_path, "--no-timestamps"],
                capture_output=True, text=True, timeout=30
            )

            # Parse whisper output — skip metadata lines
            lines = [l.strip() for l in result.stdout.split("\n") if l.strip() and not l.startswith("[")]
            text = " ".join(lines[:5]).strip()

            self._json({"text": text})

        except Exception as e:
            self._json({"error": str(e)}, 500)

    # ── Chat streaming ──────────────────────────────────
    def _handle_chat(self):
        try:
            body = self._read_body()
            message = body.get("message", "").strip()
            conv_id = body.get("conversation_id")
            history = body.get("history", [])

            if not message:
                self._json({"error": "Empty message"}, 400)
                return

            # Save user message
            conv_id = save_message(conv_id, "user", message)

            # Build Ollama payload
            messages = [{"role": m["role"], "content": m["content"]} for m in history]
            messages.append({"role": "user", "content": message})

            payload = json.dumps({
                "model": BOB_MODEL,
                "messages": messages,
                "stream": True,
            }).encode()

            req = urllib.request.Request(
                f"{OLLAMA_URL}/api/chat",
                data=payload,
                headers={"Content-Type": "application/json"},
            )

            try:
                resp = urllib.request.urlopen(req, timeout=600)
            except (urllib.error.URLError, ConnectionRefusedError):
                self._json({"error": "Bob's brain isn't loaded yet. Give it a moment."}, 503)
                return

            # Stream response to client
            self.send_response(200)
            self.send_header("Content-Type", "application/x-ndjson")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("X-Accel-Buffering", "no")
            self.end_headers()

            # Send conversation_id first
            self.wfile.write(json.dumps({"conversation_id": conv_id}).encode() + b"\n")
            self.wfile.flush()

            full_response = ""
            for line in resp:
                line = line.strip()
                if not line:
                    continue
                try:
                    chunk = json.loads(line)
                    if "message" in chunk and "content" in chunk["message"]:
                        full_response += chunk["message"]["content"]
                    self.wfile.write(line + b"\n")
                    self.wfile.flush()
                except (json.JSONDecodeError, KeyError):
                    pass

            # Save assistant response
            if full_response:
                save_message(conv_id, "assistant", full_response)

        except BrokenPipeError:
            pass
        except Exception as e:
            try:
                self._json({"error": str(e)}, 500)
            except Exception:
                pass

    # ── Config save ─────────────────────────────────────
    def _handle_config(self):
        try:
            body = self._read_body()
            config_dir = "/etc/bob"
            os.makedirs(config_dir, exist_ok=True)

            config = {
                "model": body.get("model", "bob"),
                "storage": body.get("storage", "none"),
                "persona": body.get("persona", "default"),
                "features": body.get("features", []),
                "services": body.get("services", {}),
            }

            with open(os.path.join(config_dir, "bob.conf"), "w") as f:
                json.dump(config, f, indent=2)

            # Apply persona — generate Modelfile and recreate Ollama model
            persona_id = config["persona"]
            self._apply_persona(persona_id)

            # Switch to selected model — pull if needed and storage is available
            model = config.get("model", "bob")
            if model and model not in ("bob", "llama3.1:8b"):
                try:
                    resp = urllib.request.urlopen(f"{OLLAMA_URL}/api/tags", timeout=5)
                    installed = [m["name"] for m in json.loads(resp.read()).get("models", [])]
                    if model not in installed:
                        has_storage = os.path.islink(os.path.expanduser("~/.bob")) or os.path.ismount("/mnt/bob-persist")
                        if has_storage:
                            threading.Thread(
                                target=self._pull_model, args=(model,), daemon=True
                            ).start()
                        else:
                            model = "bob"
                except Exception:
                    model = "bob"

            # Handle storage setup
            storage = config["storage"]
            if storage and storage != "none" and storage.startswith("/dev/"):
                self._setup_storage(storage)

            self._json({"ok": True})
        except Exception as e:
            self._json({"error": str(e)}, 500)

    def _pull_model(self, model):
        """Pull a model from Ollama in the background, update status file."""
        try:
            with open("/tmp/bob-status", "w") as f:
                f.write(f"Downloading model {model}...")

            result = subprocess.run(
                ["ollama", "pull", model],
                capture_output=True, text=True, timeout=3600
            )

            if result.returncode == 0:
                # Update BOB_MODEL env and recreate bob persona with new base
                with open("/tmp/bob-status", "w") as f:
                    f.write(f"Model {model} ready — loading...")

                # Create bob persona on new model
                data = load_personas()
                try:
                    with open("/etc/bob/bob.conf") as f:
                        conf = json.load(f)
                    pid = conf.get("persona", "default")
                except Exception:
                    pid = "default"

                persona = next((p for p in data.get("personas", []) if p["id"] == pid), None)
                if persona:
                    core = data.get("core_rules", "")
                    voice = persona.get("system_voice", "")
                    greeting = persona.get("greeting", "Bob here. What do you need?")
                    system_prompt = f"{voice}\n\nYour first words in every conversation, no exceptions:\n\"{greeting}\"\n\n{core}"
                    modelfile = f'FROM {model}\n\nSYSTEM """\n{system_prompt}\n"""\n\nPARAMETER temperature 0.7\nPARAMETER num_ctx 8192\n'
                    mf_path = "/tmp/bob-persona-modelfile"
                    with open(mf_path, "w") as f:
                        f.write(modelfile)
                    subprocess.run(["ollama", "create", "bob", "-f", mf_path], capture_output=True, timeout=120)

                # Preload
                with open("/tmp/bob-status", "w") as f:
                    f.write("Loading AI model...")
                subprocess.run(
                    ["curl", "-sf", "--max-time", "600",
                     "http://localhost:11434/api/generate",
                     "-d", json.dumps({"model": "bob", "prompt": "hello", "stream": False, "keep_alive": "24h"})],
                    capture_output=True, timeout=600
                )
                with open("/tmp/bob-status", "w") as f:
                    f.write("Bob is ready")
            else:
                with open("/tmp/bob-status", "w") as f:
                    f.write(f"Model download failed — using default")
        except Exception as e:
            with open("/tmp/bob-status", "w") as f:
                f.write(f"Error: {str(e)[:100]}")

    def _apply_persona(self, persona_id):
        """Generate Modelfile from persona and recreate Ollama model."""
        data = load_personas()
        persona = None
        for p in data.get("personas", []):
            if p["id"] == persona_id:
                persona = p
                break
        if not persona:
            return

        core = data.get("core_rules", "")
        voice = persona.get("system_voice", "")
        greeting_line = f'Your first words in every conversation, no exceptions:\n"{persona.get("greeting", "Bob here. What do you need?")}"'

        system_prompt = f"{voice}\n\n{greeting_line}\n\n{core}"

        modelfile = f'FROM llama3.1:8b\n\nSYSTEM """\n{system_prompt}\n"""\n\nPARAMETER temperature 0.7\nPARAMETER num_ctx 8192\n'

        # Write Modelfile and recreate model
        mf_path = "/tmp/bob-persona-modelfile"
        with open(mf_path, "w") as f:
            f.write(modelfile)

        import subprocess
        subprocess.run(
            ["ollama", "create", "bob", "-f", mf_path],
            capture_output=True, timeout=120
        )

    def _setup_storage(self, device):
        """Mount a disk for Bob's persistent storage."""
        mount_point = "/mnt/bob-persist"
        bob_dir = os.path.expanduser("~/.bob")

        os.makedirs(mount_point, exist_ok=True)

        # Check if already mounted
        with open("/proc/mounts") as f:
            if mount_point in f.read():
                return

        # Look for existing bob partition or use first partition
        # This is intentionally conservative — won't format anything automatically
        result = subprocess.run(
            ["lsblk", "-J", "-o", "NAME,FSTYPE,MOUNTPOINT,SIZE", device],
            capture_output=True, text=True
        )
        if result.returncode != 0:
            return

        info = json.loads(result.stdout)
        parts = info.get("blockdevices", [{}])[0].get("children", [])

        for part in parts:
            if part.get("fstype") in ("ext4", "xfs", "btrfs") and not part.get("mountpoint"):
                part_dev = f"/dev/{part['name']}"
                os.system(f"mount {part_dev} {mount_point}")
                bob_persist = os.path.join(mount_point, ".bob")
                os.makedirs(bob_persist, exist_ok=True)
                # Symlink ~/.bob to persistent storage
                if os.path.islink(bob_dir):
                    os.unlink(bob_dir)
                elif os.path.isdir(bob_dir):
                    # Move existing data
                    os.system(f"cp -a {bob_dir}/* {bob_persist}/ 2>/dev/null; rm -rf {bob_dir}")
                os.symlink(bob_persist, bob_dir)
                init_db()  # Re-init DB at new location
                return

    # ── Helpers ─────────────────────────────────────────
    def _read_body(self):
        length = int(self.headers.get("Content-Length", 0))
        data = self.rfile.read(length) if length else b"{}"
        return json.loads(data)

    def _html(self, content):
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()
        self.wfile.write(content.encode())

    def _json(self, data, code=200):
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(json.dumps(data).encode())

    def log_message(self, *args):
        """Suppress HTTP request logging."""
        pass


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
if __name__ == "__main__":
    init_db()
    server = http.server.ThreadingHTTPServer(("0.0.0.0", BOB_PORT), BobHandler)
    print(f"Bob UI on :{BOB_PORT}")
    server.serve_forever()
