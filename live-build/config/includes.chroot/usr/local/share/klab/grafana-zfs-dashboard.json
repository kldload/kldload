{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "id": 1, "title": "ARC Hit Ratio", "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "klab_zfs_arc_hit_ratio", "legendFormat": "hit ratio"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.8}, {"color": "green", "value": 0.95}]}, "decimals": 2}},
      "options": {"graphMode": "area"}
    },
    {
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "id": 2, "title": "ARC Size", "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "klab_zfs_arc_size_bytes", "legendFormat": "size"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}},
      "options": {"graphMode": "area"}
    },
    {
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "id": 3, "title": "Pool Compression", "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "klab_pool_compress_ratio", "legendFormat": "ratio"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "yellow", "value": null}, {"color": "green", "value": 1.5}]}}}
    },
    {
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "id": 4, "title": "Pool Fragmentation", "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "klab_pool_fragmentation", "legendFormat": "frag %"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 30}, {"color": "red", "value": 60}]}}}
    },
    {
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 10, "title": "ARC Hit Ratio Over Time", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "klab_zfs_arc_hit_ratio", "legendFormat": "hit ratio"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"fillOpacity": 30, "lineWidth": 2}, "color": {"mode": "fixed", "fixedColor": "green"}}}
    },
    {
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 11, "title": "ARC Size vs Target", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "klab_zfs_arc_size_bytes", "legendFormat": "current"},
        {"expr": "klab_zfs_arc_target_bytes", "legendFormat": "target (c)"},
        {"expr": "klab_zfs_arc_max_bytes", "legendFormat": "max (c_max)"},
        {"expr": "klab_zfs_arc_min_bytes", "legendFormat": "min (c_min)"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"fillOpacity": 10}}}
    },
    {
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 12, "title": "ARC MRU vs MFU", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "klab_zfs_arc_mru_size_bytes", "legendFormat": "MRU (recently used)"},
        {"expr": "klab_zfs_arc_mfu_size_bytes", "legendFormat": "MFU (frequently used)"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"fillOpacity": 20, "stacking": {"mode": "normal"}}}}
    },
    {
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "id": 13, "title": "ARC Hits vs Misses (rate)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(klab_zfs_arc_hits_total[2m])", "legendFormat": "hits/s"},
        {"expr": "rate(klab_zfs_arc_misses_total[2m])", "legendFormat": "misses/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"fillOpacity": 15}}}
    },
    {
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "id": 20, "title": "Pool I/O — Operations", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "klab_zfs_pool_read_ops", "legendFormat": "reads/s"},
        {"expr": "klab_zfs_pool_write_ops", "legendFormat": "writes/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"fillOpacity": 15}}}
    },
    {
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "id": 21, "title": "Pool I/O — Bandwidth", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "klab_zfs_pool_read_bw_bytes", "legendFormat": "read"},
        {"expr": "klab_zfs_pool_write_bw_bytes", "legendFormat": "write"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"fillOpacity": 15}}}
    },
    {
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "id": 22, "title": "ARC Demand vs Prefetch Hits (rate)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(klab_zfs_arc_demand_hits_total[2m])", "legendFormat": "demand hits/s"},
        {"expr": "rate(klab_zfs_arc_prefetch_hits_total[2m])", "legendFormat": "prefetch hits/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"fillOpacity": 15}}}
    },
    {
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "id": 23, "title": "ARC Evictions (rate)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(klab_zfs_arc_evict_total[2m])", "legendFormat": "evictions/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"fillOpacity": 20}, "color": {"mode": "fixed", "fixedColor": "red"}}}
    },
    {
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 36},
      "id": 30, "title": "Dataset Usage", "type": "table",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "klab_zfs_dataset_used_bytes", "format": "table", "instant": true, "refId": "A"},
        {"expr": "klab_zfs_dataset_compress_ratio", "format": "table", "instant": true, "refId": "B"}
      ],
      "transformations": [
        {"id": "seriesToColumns", "options": {"byField": "dataset"}},
        {"id": "organize", "options": {
          "excludeByName": {"Time": true, "Time 1": true, "Time 2": true, "__name__": true, "__name__ 1": true, "__name__ 2": true, "instance": true, "instance 1": true, "instance 2": true, "job": true, "job 1": true, "job 2": true, "pool": true, "pool 1": true, "pool 2": true},
          "renameByName": {"dataset": "Dataset", "Value #A": "Used", "Value #B": "Compress Ratio"}
        }}
      ],
      "fieldConfig": {"overrides": [
        {"matcher": {"id": "byName", "options": "Used"}, "properties": [{"id": "unit", "value": "bytes"}]}
      ]}
    },
    {
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 44},
      "id": 31, "title": "Snapshot Counts", "type": "table",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "klab_zfs_snapshot_count", "format": "table", "instant": true}],
      "transformations": [
        {"id": "organize", "options": {
          "excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true},
          "renameByName": {"dataset": "Dataset", "Value": "Snapshots"}
        }}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["klab", "zfs"],
  "time": {"from": "now-1h", "to": "now"},
  "title": "klab ZFS Deep Dive",
  "uid": "klab-zfs",
  "version": 1
}
