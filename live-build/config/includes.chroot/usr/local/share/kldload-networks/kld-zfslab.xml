<!-- kld-zfslab — libvirt NAT network for the ZFS test lab: goldens and their clones.
     Defined and autostarted by kldload-networks(8). Subnet is fixed so a
     playbook can target a class by address as well as by inventory group,
     and so DHCP leases stay predictable across a rebuild. -->
<network>
  <name>kld-zfslab</name>
  <forward mode='nat'>
    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='virbr-zlab' stp='on' delay='0'/>
  <ip address='192.168.151.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='192.168.151.10' end='192.168.151.200'/>
    </dhcp>
  </ip>
</network>
