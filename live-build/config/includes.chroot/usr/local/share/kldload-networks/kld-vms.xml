<!-- kld-vms — libvirt NAT network for regular operator VMs created with kvm-create.
     Defined and autostarted by kldload-networks(8). Subnet is fixed so a
     playbook can target a class by address as well as by inventory group,
     and so DHCP leases stay predictable across a rebuild. -->
<network>
  <name>kld-vms</name>
  <forward mode='nat'>
    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='virbr-vms' stp='on' delay='0'/>
  <ip address='192.168.152.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='192.168.152.10' end='192.168.152.200'/>
    </dhcp>
  </ip>
</network>
