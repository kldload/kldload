[Unit]
Description=kldload TLS cert — regen after network is up (captures DHCP IP in SAN)
After=network-online.target
Wants=network-online.target

# On first boot, ttyd-k9s / kldload-webui / grafana-server start BEFORE
# DHCP assigns a real IP. Their ExecStartPre runs kldload-tls-cert which
# writes a cert whose SAN only has 127.0.0.1 — the browser refuses to
# iframe https://<real-ip>:7681/ from https://<real-ip>:8443/ with a
# silent "page may be down" error.
#
# This unit re-runs the cert generator once network-online fires AND a
# non-loopback IPv4 is actually bound, then bounces the dependent
# services asynchronously (--no-block) so they pick up the regenerated
# cert without deadlocking on each other.
#
# NO Before= — that would make dependent services wait on our
# ExecStartPost, which itself restarts those services → circular wait.

# NO START RATE LIMIT. The NM dispatcher try-restarts this unit on every
# `up`/`dhcp4-change`, and a single boot legitimately produces a burst of
# them: bringing br0 up moves the host address off the NIC and onto the
# bridge, so the slave goes down, the bridge comes up, and DHCP binds —
# several events within a second or two. systemd's default of 5 starts in
# 10s turns that burst into a PERMANENT `failed`, and because try-restart
# SIGTERMs the in-flight run the cert can be left mid-regeneration.
#
# This has now bitten twice from two different sources — the wg-mgmt/wg-k8s
# mesh coming up during `kube-cluster bootstrap` (.129, 2026-07-27) and the
# br0 handover at firstboot (.107, 2026-08-22) — and each time the fix was
# to add another interface to the dispatcher's skip list. That does not
# generalise: br0 CANNOT be skipped, because it carries the host's primary
# address and that address is exactly what the SAN needs.
#
# Rate-limiting is the wrong tool here. The unit is oneshot and idempotent
# (kldload-tls-cert drift-checks and short-circuits when the SAN already
# covers the current IPs), so an extra run costs a few milliseconds, while
# hitting the limit costs a broken cert and a `degraded` box until someone
# reset-failed's it by hand. Let it run as often as the network changes.
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=true
ExecStartPre=/usr/local/sbin/kldload-wait-for-ip
ExecStart=/usr/local/sbin/kldload-tls-cert
ExecStartPost=/usr/local/sbin/kldload-bounce-tls-services
# Chrome trust: import the cert into /etc/skel + every existing user's
# NSS DB so https://localhost:8443 is trusted from the moment the user
# logs in — no warning banner, no autostart race. Re-fires on every cert
# rotation. Per-user xdg-autostart kldload-trust-cert.desktop remains as
# a catch-all for users created LATER.
# `-` prefix: tolerate failure (e.g. nss-tools not yet installed — first
# boot's firstboot recovery installs it shortly after).
ExecStartPost=-/usr/local/bin/kldload-trust-cert --system
# SECURITY: kldload-tls-cert printed the certificate and private key on
# stdout until 2026-09-30, and this line is what kept this unit's copy out of
# the journal (.121 b640 had the whole key block on every regeneration). It
# prints nothing now unless given --emit; the line stays as a second failsafe.
# stderr (openssl's progress) still reaches the journal.
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
