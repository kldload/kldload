[Unit]
Description=kldload TLS cert — regen after network is up (captures DHCP IP in SAN)
After=network-online.target
Wants=network-online.target

# On first boot, ttyd-k9s / kldload-webui / grafana-server start BEFORE
# DHCP assigns a real IP. Their ExecStartPre runs kldload-tls-cert which
# writes a cert whose SAN only has 127.0.0.1 — the browser refuses to
# iframe https://<real-ip>:7681/ from https://<real-ip>:8443/ with a
# silent "page may be down" error.
#
# This unit re-runs the cert generator once network-online fires AND a
# non-loopback IPv4 is actually bound, then bounces the dependent
# services asynchronously (--no-block) so they pick up the regenerated
# cert without deadlocking on each other.
#
# NO Before= — that would make dependent services wait on our
# ExecStartPost, which itself restarts those services → circular wait.

[Service]
Type=oneshot
RemainAfterExit=true
ExecStartPre=/usr/local/sbin/kldload-wait-for-ip
ExecStart=/usr/local/sbin/kldload-tls-cert
ExecStartPost=/usr/local/sbin/kldload-bounce-tls-services
# Chrome trust: import the cert into /etc/skel + every existing user's
# NSS DB so https://localhost:8443 is trusted from the moment the user
# logs in — no warning banner, no autostart race. Re-fires on every cert
# rotation. Per-user xdg-autostart kldload-trust-cert.desktop remains as
# a catch-all for users created LATER.
# `-` prefix: tolerate failure (e.g. nss-tools not yet installed — first
# boot's firstboot recovery installs it shortly after).
ExecStartPost=-/usr/local/bin/kldload-trust-cert --system
# SECURITY: kldload-tls-cert intentionally prints the cert + private key
# on stdout (CLI-friendly: `kldload-tls-cert | tee /tmp/server.pem`).
# When systemd captures that to journal, anyone with journalctl read can
# extract the webui's private key. .121 b640 journal had the full
# BEGIN/END PRIVATE KEY block dumped on every regen. Route stdout to
# /dev/null at the unit level — the file-write paths inside the script
# don't depend on stdout, and stderr (openssl status via `>&2`) still
# reaches the journal for debugging.
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
