[Unit]
Description=ebpf_exporter — per-device block I/O latency histograms
After=network-online.target
[Service]
Type=simple
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE CAP_NET_ADMIN CAP_DAC_READ_SEARCH CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE CAP_NET_ADMIN CAP_DAC_READ_SEARCH CAP_SYS_ADMIN
LimitMEMLOCK=infinity
# Loopback: scraped only by this host's Prometheus (klab/prometheus.yml,
# targets localhost:9435).
ExecStart=/usr/local/bin/ebpf_exporter --config.dir=/etc/ebpf_exporter --config.names=biolatency --web.listen-address=127.0.0.1:9435
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
