[Unit]
Description=klab Prometheus Exporter — ZFS, VM, and test metrics on :9101
Documentation=https://kldload.com
After=network.target libvirtd.service
ConditionPathExists=/usr/local/bin/klab-exporter

[Service]
Type=simple
ExecStart=/usr/local/bin/klab-exporter
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
