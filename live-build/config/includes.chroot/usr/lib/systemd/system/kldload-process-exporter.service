[Unit]
Description=Prometheus process-exporter — per-process CPU/RSS/IO/threads visibility
Documentation=https://github.com/ncabatoff/process-exporter
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/bin/process-exporter
ConditionPathExists=/etc/kldload/process-exporter.yml

[Service]
Type=simple
ExecStart=/usr/local/bin/process-exporter \
    --config.path=/etc/kldload/process-exporter.yml \
    --web.listen-address=127.0.0.1:9256
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
