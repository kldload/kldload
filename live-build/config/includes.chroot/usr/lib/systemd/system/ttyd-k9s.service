[Unit]
Description=ttyd — kldload browser console (k9s + shell + logs via tmux)
# Same priority ordering as kldload-webui: start BEFORE any long-running
# firstboot/autodeploy so the browser terminal is usable immediately.
After=network-online.target
Wants=network-online.target
Before=kldload-firstboot.service kldload-autodeploy.service klab-firstboot.service
# Systemd default StartLimitBurst=5 inside StartLimitIntervalSec=10s is too
# tight for firstboot — observed 2026-05-12 RHEL 10 install: ttyd exited
# cleanly (status=0) in 44ms five times during the busy first-30-seconds
# of boot (port :7681 ephemeral conflict / tmux socket not yet writable /
# kldload-console exiting fast under contention) and hit the rate-limit
# circuit-breaker before the system settled down. Manual `systemctl start`
# 90 seconds later worked first try. Widen the budget to 10 attempts in
# 5 minutes — enough to ride through firstboot races without losing the
# protection against truly broken units.
StartLimitBurst=100
StartLimitIntervalSec=300
# Burst bumped 10 → 100 on 2026-05-17 after .131 still hit the limit even
# with `Restart=always` from the prior pass. The wrapped kldload-console /
# tmux / k9s pipeline exits cleanly (status=0) in ~1.5s when kubectl can't
# reach the cluster at firstboot, and with RestartSec=15 the unit burns
# through the budget in ~2.75 min — well within the 5-min window. 100 starts
# in 5 min gives 25 minutes of retry headroom which is comfortably past any
# realistic firstboot stabilization. The proper fix is in kldload-console
# itself — keep tmux alive even when k9s exits — but that's a wrapper change
# we'll do once we trace why `exec tmux attach-session` returns cleanly.

[Service]
Type=simple
Environment=HOME=/root
Environment=KUBECONFIG=/root/.kube/config
Environment=TERM=xterm-256color
# -W = writable (keyboard input). Session lives inside tmux so iframe
# reloads reattach instead of losing state.
# Bind 127.0.0.1 only — kldload-proxy on :8443 fronts us at /k9s/*
# over TLS using the same cert that covers the webui. Speaking plain
# HTTP on loopback means one browser cert prompt covers every origin.
# -b /k9s tells ttyd its URLs are under the /k9s sub-path so all
# generated hrefs/websocket URLs match what the browser requests
# through the proxy.

# Clipboard: xterm.js copies the selection to the browser's clipboard
# automatically (copyOnSelect=true) — drag to select, no key press
# needed. Paste with Ctrl+Shift+V (browser-level). Combined with tmux's
# `set-clipboard on` inside kldload-console, this covers both "grab
# text from a pane" and "paste a URL into a shell".
#
# disableLeaveAlert=true so the browser doesn't prompt on page close.
# rendererType=webgl for smoother scrolling on big live log streams.
# scrollback=10000 lets you scroll back further in panes like hubble.
ExecStart=/usr/local/bin/ttyd -W -i 127.0.0.1 -p 7681 -b /k9s \
    -t fontSize=14 \
    -t copyOnSelect=true \
    -t disableLeaveAlert=true \
    -t 'rendererType=webgl' \
    -t scrollback=10000 \
    /usr/local/bin/kldload-console
Restart=always
# `Restart=always` not `on-failure` — caught 2026-05-17 on .148: the
# wrapped kldload-console / tmux / k9s pipeline can exit *cleanly*
# (status=0) when firstboot prereqs aren't ready (kubeconfig missing,
# tmux socket dir not writable, ephemeral :7681 contention). With
# `on-failure`, systemd treats status=0 as "successfully completed" and
# the unit stays inactive forever — manual `systemctl start` recovers
# but a fresh boot is broken until someone notices the 502/501 on
# /k9s/ in the webui. `always` retries either way; StartLimitBurst
# above still protects against a truly broken unit.
#
# 15s between retries is long enough that whatever transient (port reuse,
# tmux socket racing kldload-tls-cert, etc.) had time to clear, but short
# enough that 10 retries fits in the StartLimitIntervalSec=300s window.
RestartSec=15

[Install]
WantedBy=multi-user.target
