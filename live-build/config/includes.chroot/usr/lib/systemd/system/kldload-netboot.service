# kldload-netboot.service — serve netboot to the rest of the rack from THIS
# installed machine's retained payload, entirely offline.
#
# OFF BY DEFAULT. Enable deliberately on the one box that is to become the
# provisioning server: `systemctl enable --now kldload-netboot`. It is not a
# WantedBy target anywhere, so a plain install never starts it.
#
# proxyDHCP means it answers PXE alongside the network's existing DHCP rather
# than replacing it, so enabling it does not knock other machines off the net.
[Unit]
Description=kldload netboot server (offline PXE for the rest of the rack)
Documentation=https://kldload.com/
# There is deliberately NO ConditionPathExists here any more.
#
# It named the payload path, and the tool's PAYLOAD is overridable now
# (NETBOOT_PAYLOAD), so a static condition cannot know where the payload
# actually is -- the build host serves from its own output tree. A condition
# that is wrong is the worst possible failure: systemd SKIPS the unit,
# `systemctl start` exits 0, is-active says inactive, and nothing anywhere says
# why. That exact mismatch meant this server could never start on any machine
# (found 2026-09-12).
#
# The tool checks the payload itself, honours the override, and dies with the
# reason. Loud beats silent.
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# Optional, hence the leading '-': NETBOOT_PORT and NETBOOT_IFACE live here
# so an operator never edits a shipped script to move the server off the
# default route or off port 8080.
EnvironmentFile=-/etc/kldload/netboot.env
ExecStart=/usr/local/sbin/kldload-netboot-server serve
Restart=on-failure
RestartSec=5
# nginx and dnsmasq need to bind low ports and write the tree.
User=root

[Install]
WantedBy=multi-user.target
