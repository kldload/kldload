[Unit]
Description=Prometheus ZFS Exporter
After=network-online.target

[Service]
Type=simple
# Loopback: the only scraper is the Prometheus on this host
# (usr/local/share/klab/prometheus.yml, targets localhost:9134). An exporter
# has no auth, so nothing off-box should be able to read it.
ExecStart=/usr/local/bin/zfs_exporter --web.listen-address=127.0.0.1:9134 --deadline=60s
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
