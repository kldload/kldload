[Unit]
Description=Nightly kldload RAG re-indexing
Documentation=man:kldload-rag-index

[Timer]
# Run nightly at 03:17 (off-peak, avoids exact-top-of-hour cron crowd).
OnCalendar=*-*-* 03:17:00
# If the machine was off, run within 30 min of boot.
Persistent=true
RandomizedDelaySec=10min
Unit=kldload-rag-index.service

[Install]
WantedBy=timers.target
