[Unit]
Description=kldload Web UI (installer + management frontend)
# Start as early as possible. The UI is how the user tracks every other
# slow boot-time operation (firstboot, autodeploy, klab goldens, K8s
# bootstrap). Gate on network-online.target (NOT network.target) because
# ExecStartPre runs kldload-tls-cert which needs the LAN IP assigned to
# build correct SANs. Ordering before the heavy units still holds — the
# UI comes up ~seconds after DHCP completes; heavy work runs in parallel.
After=network-online.target systemd-modules-load.service kldload-proxy.service
Wants=network-online.target systemd-modules-load.service kldload-proxy.service
Before=kldload-firstboot.service kldload-autodeploy.service klab-firstboot.service

[Service]
Type=simple
# HOME is required so kubectl finds ~/.kube/config and the Ansible code
# path resolves /root/.ansible/. Without it systemd starts services with
# HOME unset and kubectl looks in "/" — webui sees 0 nodes even when
# the cluster is fine.
Environment=HOME=/root
Environment=KUBECONFIG=/root/.kube/config
# TLS is now terminated by kldload-proxy on :8443 — the webui runs as
# plain HTTP on loopback :8444 and the proxy forwards to it. This is
# what lets ONE cert prompt (the proxy's) cover the webui + every
# iframed service (Grafana, ttyd-k9s, Bob) as a single origin. If the
# proxy is down, :8443 is simply unreachable — no half-working state.
ExecStart=/usr/local/bin/kldload-webui --port 8444 --bind 127.0.0.1 --no-tls --no-browser
# Post-condition: backend port actually answering. Keeps systemd from
# marking the unit "started" before the HTTP server is accept()-ing.
ExecStartPost=/bin/bash -c 'for i in $(seq 1 60); do ss -ltn 2>/dev/null | grep -q "127.0.0.1:8444 " && exit 0; sleep 1; done; exit 1'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
WorkingDirectory=/usr/local/share/kldload-webui

[Install]
WantedBy=multi-user.target
