[Unit]
Description=kldload Web UI (installer + management frontend)
# Start as early as possible. The UI is how the user tracks every other
# slow boot-time operation (firstboot, autodeploy, klab goldens, K8s
# bootstrap). Gate on network-online.target (NOT network.target) because
# ExecStartPre runs kldload-tls-cert which needs the LAN IP assigned to
# build correct SANs. Ordering before the heavy units still holds — the
# UI comes up ~seconds after DHCP completes; heavy work runs in parallel.
# nginx (NOT kldload-proxy) is the TLS terminator at :8443 since 1.0.6.
# Wanting it here was harmless on the old setup; under nginx it's the
# OPPOSITE of harmless — `Wants=kldload-proxy.service` revives a unit
# the build-iso.sh `systemctl disable` deliberately turned off, and
# kldload-proxy then races nginx for :8443 and wins because it starts
# first. Caught 2026-05-15 on live ISO .101 boot: nginx in restart loop
# with "Address already in use" while kldload-proxy held the port.
# Don't reference kldload-proxy.service here — nginx fronts the webui.
After=network-online.target systemd-modules-load.service nginx.service
Wants=network-online.target systemd-modules-load.service
Before=kldload-firstboot.service kldload-autodeploy.service klab-firstboot.service

[Service]
Type=simple
# HOME is required so kubectl finds ~/.kube/config and the Ansible code
# path resolves /root/.ansible/. Without it systemd starts services with
# HOME unset and kubectl looks in "/" — webui sees 0 nodes even when
# the cluster is fine.
Environment=HOME=/root
Environment=KUBECONFIG=/root/.kube/config
# TLS is terminated by nginx on :8443 — the webui runs as plain HTTP
# on loopback :8444 and nginx forwards to it. This is what lets ONE
# cert prompt (nginx's) cover the webui + every iframed service
# (Grafana, ttyd-k9s, Bob) as a single origin. If nginx is down, :8443
# is unreachable — no half-working state. The hand-rolled kldload-proxy
# was the predecessor of nginx and is now disabled at build time.
ExecStart=/usr/local/bin/kldload-webui --port 8444 --bind 127.0.0.1 --no-tls --no-browser
# Post-condition: backend port actually answering. Keeps systemd from
# marking the unit "started" before the HTTP server is accept()-ing.
ExecStartPost=/bin/bash -c 'for i in $(seq 1 60); do ss -ltn 2>/dev/null | grep -q "127.0.0.1:8444 " && exit 0; sleep 1; done; exit 1'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
WorkingDirectory=/usr/local/share/kldload-webui

# ── Brownout protection (2026-05-18) ──────────────────────────────────
# The webui browns out when the host is busy (ZFS scrub, K8s build,
# klab golden) because by default cgroup v2 gives every service the
# same CPU/IO share. These knobs ensure the webui gets ~2× the share
# of normal workloads under contention so the dashboard stays
# responsive even when the box is buried.
#
# Nice=-5            kernel scheduler priority bump (range -20..19;
#                    -5 is "noticeably preferred" without starving
#                    anything important).
# CPUWeight=200      cgroup v2 CPU weight (default 100); doubles the
#                    webui's CPU slice when there's contention. No
#                    effect when the system is idle, so this is pure
#                    upside.
# IOWeight=200       cgroup v2 IO weight (default 100); doubles disk
#                    bandwidth share so a scrub doesn't starve the
#                    webui's reads.
# IOSchedulingClass=best-effort + Priority=2
#                    Block-layer hint (separate from cgroup IOWeight)
#                    that moves webui reads to a higher-priority lane
#                    in the IO scheduler.
# MemoryHigh=512M    throttle webui memory growth before it competes
#                    with kubelet/etcd under pressure. Base footprint
#                    is ~80MB; 512M absorbs log buffers + WebSocket
#                    queues without OOMing.
Nice=-5
CPUWeight=200
IOWeight=200
IOSchedulingClass=best-effort
IOSchedulingPriority=2
MemoryHigh=512M

[Install]
WantedBy=multi-user.target
