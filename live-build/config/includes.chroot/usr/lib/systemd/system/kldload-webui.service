[Unit]
Description=kldload Web UI (installer + management frontend)
# Start as early as possible. The UI is how the user tracks every other
# slow boot-time operation (firstboot, autodeploy, klab goldens, K8s
# bootstrap). Gate on only the minimal network.target, and explicitly
# order BEFORE the heavy units so systemd brings the UI up first even
# under load. Users get a working dashboard + browser terminal within
# ~10 seconds of boot; heavy work runs in parallel behind.
After=network.target systemd-modules-load.service
Wants=systemd-modules-load.service
Before=kldload-firstboot.service kldload-autodeploy.service klab-firstboot.service

[Service]
Type=simple
# HOME is required so kubectl finds ~/.kube/config and the Ansible code
# path resolves /root/.ansible/. Without it systemd starts services with
# HOME unset and kubectl looks in "/" — webui sees 0 nodes even when
# the cluster is fine.
Environment=HOME=/root
Environment=KUBECONFIG=/root/.kube/config
ExecStart=/usr/local/bin/kldload-webui --port 8080 --no-browser
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
WorkingDirectory=/usr/local/share/kldload-webui

[Install]
WantedBy=multi-user.target
