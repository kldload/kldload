# kldload-snapshot-guard.timer — runs the snapshot space guard every 10 min
# and 5 min after boot. Enabled by `kldload-snapshot-policy apply`. Every 10
# minutes because a build or a VM import writes tens of GB in that time.
[Unit]
Description=kldload: snapshot space guard every 10 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=10min

[Install]
WantedBy=timers.target
