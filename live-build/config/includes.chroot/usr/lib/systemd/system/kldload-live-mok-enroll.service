[Unit]
Description=kldload Secure Boot MOK enrollment (live session)
Documentation=https://kldload.ca
DefaultDependencies=no
After=sysinit.target local-fs.target
Before=display-manager.service gdm.service kldload-live-tui.service kldload-webui.service
ConditionPathExists=/etc/kldload/mok/mok.der

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/kldload-live-mok-enroll
RemainAfterExit=yes
TimeoutStartSec=120
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
