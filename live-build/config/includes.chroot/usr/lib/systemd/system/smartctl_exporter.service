[Unit]
Description=Prometheus smartctl Exporter
After=network-online.target

[Service]
Type=simple
# Loopback: scraped only by this host's Prometheus (klab/prometheus.yml,
# targets localhost:9633); drive serials and SMART data stay on the box.
ExecStart=/usr/local/bin/smartctl_exporter --web.listen-address=127.0.0.1:9633 --smartctl.path=/usr/sbin/smartctl --smartctl.interval=60s --smartctl.rescan=10m
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
