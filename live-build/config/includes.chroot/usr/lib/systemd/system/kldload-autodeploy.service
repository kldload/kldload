[Unit]
# Top-level unattended deployment orchestrator. Runs after firstboot,
# invokes K8s bootstrap + klab goldens + AI pull in the right order,
# writes phase-ready markers that the web UI reads to show green.
Description=kldload unattended deployment (K8s + AI + klab)
After=network-online.target kldload-firstboot.service libvirtd.service kldload-webui.service
Wants=network-online.target kldload-firstboot.service
ConditionPathExists=!/var/lib/kldload/all-ready

[Service]
# Type=exec, NOT oneshot.
#
# systemd does not consider a target reached until every oneshot wanted by it
# has FINISHED its ExecStart. This unit is WantedBy=multi-user.target and its
# ExecStart builds a Kubernetes cluster and a set of golden VMs, so the box
# did not reach multi-user.target — and therefore did not reach
# graphical.target — until all of that completed:
#
#   graphical.target @1h 23min 34s
#   └─kldload-autodeploy.service @50.2s +1h 22min 44s
#
# An operator watched a boot screen for 84 minutes on a machine that was
# otherwise ready in under a minute, and if convergence ever hung, the desktop
# never arrived at all. Provisioning is background work; it was being modelled
# as a boot dependency.
#
# With Type=exec the unit is "started" once the binary is exec'd, the target is
# reached immediately, and convergence continues in the background — which is
# also what the Nice/IOSchedulingClass settings below were already assuming.
#
# Safe for the one unit that orders after this one: kldload-smoke-firstboot
# waits on the readiness MARKERS in its own ExecStartPre, not on this unit's
# exit, precisely because a oneshot reports "active (exited)" while its
# background work is still running (fiend, 2026-08-16).
Type=exec
ExecStart=/usr/sbin/kldload-autodeploy
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console
# 6-hour cap — klab + k8s + ai should fit in ~1.5hr worst case; padding for
# slow mirrors. systemd will SIGTERM after this if something hangs.
TimeoutStartSec=21600
# The default OOMPolicy for a oneshot unit is "stop": if the kernel OOM-kills
# any process in this cgroup, systemd tears the whole unit down. That is the
# wrong trade here — the heavy phases (model pull, golden VM builds) are the
# plausible OOM victims, and killing the orchestrator with them loses every
# remaining phase and every marker the web UI waits on. Convergence is
# idempotent and re-runnable, so keep the orchestrator alive and let the
# per-phase logging say what died (HISTORY: a fresh full-toggle install went
# unreachable and reboot-cycled on boot #1, 10.100.10.123 2026-06-15).
OOMPolicy=continue
# Convergence is background work: it must never outrank the operator's own
# session on a box that is also running a desktop. Nice only affects CPU, so
# the IO class matters more here — cloning goldens onto ZFS is what actually
# starves an interactive shell.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
