[Unit]
Description=kldload RAG Service
After=network.target ollama.service
Wants=ollama.service

# Do not start before firstboot has finished the AI half. bob-model.env is
# written only after the models are pulled, so its ABSENCE is the honest
# signal that there is nothing to serve yet — and EnvironmentFile= below is
# prefixed with '-', so without this condition the service starts anyway,
# with no model, and fails.
ConditionPathExists=/etc/kldload/bob-model.env

# Give up after ~10 failures in 5 minutes instead of respawning forever.
#
# HISTORY: 2026-08-13, user report — a machine rebooted while firstboot was
# still pulling models came back with systemd churning. Restart=on-failure
# with RestartSec=5 and NO start limit is an infinite loop by construction:
# systemd's default allowance is 5 starts per 10s, and one start every 5s
# sits permanently UNDER that, so the rate limiter never trips and the unit
# never enters failed state. It respawns every five seconds indefinitely,
# filling the journal and waking the CPU, with nothing in `systemctl
# --failed` to show for it. A service that cannot start should end up
# visibly failed, not quietly busy.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/kldload-rag/kldload_rag.py
Restart=on-failure
RestartSec=5
Environment=CHROMADB_PATH=/var/lib/kldload-rag/chromadb
Environment=OLLAMA_HOST=http://localhost:11434
# Written by kldload-firstboot after it picks BOB_GENERATE_MODEL +
# BOB_EMBED_MODEL based on hardware. The dash prefix means "absent is OK"
# (firstboot hasn't run yet on the live ISO, or this is a build before
# the env file was a thing). When present, it overrides the python
# module's defaults so RAG uses whatever model firstboot actually pulled.
EnvironmentFile=-/etc/kldload/bob-model.env

[Install]
WantedBy=multi-user.target
