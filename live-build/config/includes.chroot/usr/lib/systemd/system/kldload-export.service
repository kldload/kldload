[Unit]
Description=KLDload Deferred Image Export
After=multi-user.target zfs-mount.service
Wants=zfs-mount.service
ConditionPathExists=/etc/kldload/pending-export.env

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/kldload-export-deferred
ExecStartPost=/bin/rm -f /etc/kldload/pending-export.env
RemainAfterExit=no
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
