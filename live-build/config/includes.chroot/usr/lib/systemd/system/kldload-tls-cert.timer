[Unit]
Description=Re-check TLS cert SAN every hour (belt + suspenders vs NM dispatcher)

[Timer]
# First run 5 min after boot (let network-online + DHCP settle), then
# hourly. Script is idempotent — drift-check short-circuits when SAN
# already covers current state, so the extra-frequent firing costs ~0.
OnBootSec=5min
OnUnitActiveSec=1h
AccuracySec=60s
Persistent=false

[Install]
WantedBy=timers.target
