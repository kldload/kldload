// /etc/kldload-arcade/waybar/config.jsonc — the arcade session's toolbar.
// Read by waybar, started from /etc/kldload-arcade/sway/config. A slim bar at the
// bottom in the Blackbox manner: workspaces, the focused window, the clock.
{
  "layer": "top",
  "position": "bottom",
  "height": 24,
  "spacing": 0,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": ["cpu", "memory", "clock"],
  "sway/workspaces": { "disable-scroll": false, "all-outputs": false },
  "sway/window": { "max-length": 80 },
  "cpu": { "format": "cpu {usage}%", "interval": 5 },
  "memory": { "format": "mem {percentage}%", "interval": 10 },
  "clock": { "format": "{:%a %d %b  %H:%M}", "tooltip-format": "{:%Y-%m-%d}" }
}
