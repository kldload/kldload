# /etc/kldload-arcade/sway/config — the "kldload arcade" session.
#
# Role: sway's configuration for the optional arcade session, started by
# /usr/local/bin/kldload-arcade session from the GDM entry. GNOME stays the
# default session; this one exists when the install set KLDLOAD_ARCADE_SESSION=1.
#
# The operator's brief (2026-09-14): the keybindings are what matter, the same as
# Omarchy's; tiling AND floating; very Blackbox-like; lean, just the basics.
# Omarchy runs Hyprland, which Fedora does not package, so its bindings are mapped
# onto sway (Omarchy's are from the same i3 tradition). Taken from
# basecamp/omarchy default/hypr/bindings/{tiling,applications,utilities}.lua on
# 2026-09-14. Omarchy bindings with no sway equivalent, or for apps kldload does
# not ship, are left out rather than approximated.
#
# Lines starting "## " are the help text Super+K shows. Keep one above each binding.
#
# Consequence if missing: the arcade session starts with sway's stock config
# (Alt as the modifier, none of these keys).

set $mod Mod4
set $term foot

# ── Look: flat Blackbox-style title bars, no gaps, monospace ───────────────────
font pango:monospace Bold 10
default_border normal 2
default_floating_border normal 2
titlebar_padding 8 3
titlebar_border_thickness 1
gaps inner 0
focus_follows_mouse no
floating_modifier $mod normal
#  class                  border  bground text    indicator child_border
client.focused            #5c6b7a #3a4450 #f2f4f6 #3dff88   #5c6b7a
client.focused_inactive   #2a3038 #262b31 #b7bec6 #2a3038   #2a3038
client.unfocused          #1e2227 #1b1f24 #7d8690 #1e2227   #1e2227
client.urgent             #ff3b5c #6b1f2b #ffffff #ff3b5c   #ff3b5c
output * bg /usr/share/backgrounds/kldload/default-dark.png fill #0b0e12

# ── Applications ───────────────────────────────────────────────────────────────
## Super+Return  terminal
bindsym $mod+Return exec $term
## Super+Shift+Return, Super+Shift+B  browser
bindsym $mod+Shift+Return exec kldload-arcade browser
bindsym $mod+Shift+b exec kldload-arcade browser
## Super+Shift+F  file manager
bindsym $mod+Shift+f exec nautilus --new-window
## Super+Space  kldload menu
bindsym $mod+space exec kldload-arcade menu
## Super+Alt+Space  all applications
bindsym $mod+Mod1+space exec fuzzel
## Super+Escape  system menu: lock, log out, reboot, power off
bindsym $mod+Escape exec kldload-arcade system
## Super+K  this list
bindsym $mod+k exec kldload-arcade keys
## Super+Shift+Space  show or hide the toolbar
bindsym $mod+Shift+space exec pkill -USR1 -x waybar
## Print  screenshot a region (Super+Print: the whole screen)
bindsym Print exec kldload-arcade shot region
bindsym $mod+Print exec kldload-arcade shot full

# ── Windows: tiling by default, any window floats ─────────────────────────────
## Super+W, Super+Q  close window
bindsym $mod+w kill
bindsym $mod+q kill
## Super+T  toggle floating / tiling
bindsym $mod+t floating toggle
## Super+F  full screen
bindsym $mod+f fullscreen toggle
## Super+J  toggle split direction
bindsym $mod+j layout toggle split
## Super+G  toggle a tabbed group
bindsym $mod+g layout toggle tabbed split
## Super+Arrows  focus left / right / up / down
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
## Super+Shift+Arrows  swap the window left / right / up / down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down
## Alt+Tab, Alt+Shift+Tab  next / previous window
bindsym Mod1+Tab focus next
bindsym Mod1+Shift+Tab focus prev
## Super+Minus, Super+Equal  narrower / wider (Shift: height, Alt: a little, Ctrl: a lot)
bindsym $mod+minus resize shrink width 100 px or 5 ppt
bindsym $mod+equal resize grow width 100 px or 5 ppt
bindsym $mod+Shift+minus resize shrink height 100 px or 5 ppt
bindsym $mod+Shift+equal resize grow height 100 px or 5 ppt
bindsym $mod+Mod1+minus resize shrink width 25 px or 1 ppt
bindsym $mod+Mod1+equal resize grow width 25 px or 1 ppt
bindsym $mod+Ctrl+minus resize shrink width 300 px or 15 ppt
bindsym $mod+Ctrl+equal resize grow width 300 px or 15 ppt
## Super+drag  move a floating window (right button: resize)

# ── Workspaces ─────────────────────────────────────────────────────────────────
## Super+1 .. Super+0  switch to workspace 1-10
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
## Super+Shift+1 .. 0  move the window to a workspace and follow it
bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5; workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6; workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7; workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8; workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9; workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10; workspace number 10
## Super+Shift+Alt+1 .. 0  move the window to a workspace, stay here
bindsym $mod+Shift+Mod1+1 move container to workspace number 1
bindsym $mod+Shift+Mod1+2 move container to workspace number 2
bindsym $mod+Shift+Mod1+3 move container to workspace number 3
bindsym $mod+Shift+Mod1+4 move container to workspace number 4
bindsym $mod+Shift+Mod1+5 move container to workspace number 5
bindsym $mod+Shift+Mod1+6 move container to workspace number 6
bindsym $mod+Shift+Mod1+7 move container to workspace number 7
bindsym $mod+Shift+Mod1+8 move container to workspace number 8
bindsym $mod+Shift+Mod1+9 move container to workspace number 9
bindsym $mod+Shift+Mod1+0 move container to workspace number 10
## Super+Tab, Super+Shift+Tab  next / previous workspace
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev
## Super+Ctrl+Tab  the workspace you were on before
bindsym $mod+Ctrl+Tab workspace back_and_forth
## Super+Scroll  next / previous workspace
bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+button5 workspace next
## Super+S, Super+`  show the scratchpad
bindsym $mod+s scratchpad show
bindsym $mod+grave scratchpad show
## Super+Alt+S, Super+Shift+`  send the window to the scratchpad
bindsym $mod+Mod1+s move scratchpad
bindsym $mod+Shift+grave move scratchpad

# ── Toolbar, lock on idle, the desktop plumbing ────────────────────────────────
bar {
    swaybar_command waybar -c /etc/kldload-arcade/waybar/config.jsonc -s /etc/kldload-arcade/waybar/style.css
}
exec swayidle -w timeout 600 'swaylock -f -c 0b0e12' before-sleep 'swaylock -f -c 0b0e12'
# Portals (file pickers, screen sharing) and D-Bus activated apps need the session's
# WAYLAND_DISPLAY; Fedora's sway package ships the snippet that exports it.
include /etc/sway/config.d/*
# The first-boot build window, when a build is still running.
exec /usr/local/bin/kldload-build-monitor-autostart
