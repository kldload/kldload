// kldload: keep kernel headers installed so DKMS can always rebuild ZFS modules
// when a new kernel is installed via apt upgrade.
//
// Without linux-headers-amd64 (the meta-package that tracks the current kernel),
// DKMS has no build environment and ZFS modules will fail to compile for the
// new kernel — leaving the system unbootable if ZFS is on root.

// Both naming schemes are listed on purpose. Debian's kernel meta-packages are
// linux-{image,headers}-<arch>; Ubuntu's are linux-{image,headers}-generic. An
// entry for a package that is not installed is harmless, but a MISSING entry is
// silent — which is exactly how Ubuntu shipped with an unprotected DKMS build
// environment while Debian looked fine. (bootstrap.sh already installs the
// -generic names on Ubuntu; only these lists had not caught up.)
APT::NeverAutoRemove {
    "linux-headers-amd64";
    "linux-headers-arm64";
    "linux-image-amd64";
    "linux-image-arm64";
    "linux-headers-generic";
    "linux-image-generic";
    "linux-headers-virtual";
    "linux-image-virtual";
};

// Keep the DKMS source package for ZFS — removing it would mean no rebuild
// capability after a kernel upgrade.
APT::NeverAutoRemove {
    "zfs-dkms";
};
