#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# kupgrade — perform system upgrade with automatic boot environment snapshot
# Creates a pre-upgrade ZFS snapshot, runs the appropriate package manager
# upgrade, then verifies that ZFS modules are available for every installed
# kernel.
# ---------------------------------------------------------------------------

PROGNAME="$(basename "$0")"
LOG_DIR=/var/log/kldload
LOG="${LOG_DIR}/upgrade.log"

ts()  { date '+%Y-%m-%dT%H:%M:%S'; }
log() { echo "$(ts) [$PROGNAME] $*" | tee -a "$LOG" >&2; }
die() { log "ERROR: $*"; exit 1; }

[[ "$(id -u)" -eq 0 ]] || die "kupgrade must be run as root."

mkdir -p "$LOG_DIR"
log "==================================================================="
log "kldload upgrade started"
log "==================================================================="

# ---------------------------------------------------------------------------
# Distro detection — check for dnf first, then apt-get (same as kpkg)
# ---------------------------------------------------------------------------

if command -v dnf &>/dev/null; then
    PKG=dnf
elif command -v apt-get &>/dev/null; then
    PKG=apt-get
elif command -v pacman &>/dev/null; then
    PKG=pacman
else
    die "No supported package manager found (need dnf, apt-get, or pacman)"
fi

log "Detected package manager: ${PKG}"

# ---------------------------------------------------------------------------
# Detect the active boot environment dataset
# ---------------------------------------------------------------------------

BE_DATASET=""

# 1. Read from /etc/kldload/boot-environment if it exists
if [[ -f /etc/kldload/boot-environment ]]; then
    BE_DATASET="$(cat /etc/kldload/boot-environment 2>/dev/null | head -1)"
fi

# 2. Fall back to detecting from mount output
if [[ -z "${BE_DATASET}" ]]; then
    BE_DATASET="$(zfs list -Ho name / 2>/dev/null || true)"
fi

# 3. Fall back to rpool/ROOT/default
if [[ -z "${BE_DATASET}" ]]; then
    BE_DATASET="rpool/ROOT/default"
fi

log "Boot environment dataset: ${BE_DATASET}"

# ---------------------------------------------------------------------------
# Create pre-upgrade boot environment snapshot
# ---------------------------------------------------------------------------

SNAPSHOT_CREATED=""
if zfs list -H "${BE_DATASET}" >/dev/null 2>&1; then
    SNAP="${BE_DATASET}@pre-upgrade-$(date +%Y%m%d-%H%M%S)"
    log "Creating pre-upgrade boot environment: ${SNAP}"
    zfs snapshot "${SNAP}" 2>&1 | tee -a "$LOG"
    SNAPSHOT_CREATED="${SNAP}"
    log "Roll back with:  kldload-be rollback ${SNAP}"
else
    log "WARNING: ${BE_DATASET} not found — skipping boot environment snapshot"
fi

# ---------------------------------------------------------------------------
# Run system upgrade
# ---------------------------------------------------------------------------

if [[ "${PKG}" == "dnf" ]]; then
    log "Running: dnf upgrade"
    dnf upgrade -y 2>&1 | tee -a "$LOG"
elif [[ "${PKG}" == "pacman" ]]; then
    # Arch+ZFS: the kernel is pinned to whatever version archzfs supports.
    # A full pacman -Syu will fail if the repos have a newer kernel that
    # breaks zfs-linux. Strategy: try full upgrade first, if it fails due
    # to kernel/zfs conflict, hold the kernel back and upgrade everything else.
    log "Running: pacman -Syu"
    if ! pacman -Syu --noconfirm 2>&1 | tee -a "$LOG"; then
        log "Full upgrade failed (likely kernel/ZFS version conflict)"
        log "Holding kernel back — upgrading everything else"
        pacman -Syu --noconfirm --ignore linux,linux-headers,linux-firmware 2>&1 | tee -a "$LOG" || true
        log "Kernel held at $(pacman -Q linux 2>/dev/null | awk '{print $2}') (archzfs requires this version)"
        log "Kernel will upgrade automatically when archzfs releases a matching zfs-linux"
    fi
else
    log "Running: apt-get update"
    DEBIAN_FRONTEND=noninteractive apt-get update 2>&1 | tee -a "$LOG"

    log "Running: apt-get dist-upgrade"
    DEBIAN_FRONTEND=noninteractive apt-get dist-upgrade -y 2>&1 | tee -a "$LOG"

    log "Running: apt-get autoremove"
    DEBIAN_FRONTEND=noninteractive apt-get autoremove -y 2>&1 | tee -a "$LOG"
fi

# ---------------------------------------------------------------------------
# Verify ZFS modules for every installed kernel
#
# On RPM distros with kmod-zfs (kABI tracking), ZFS modules are shipped
# as pre-built RPMs — skip DKMS verification entirely.
# On DKMS systems, verify and rebuild if needed.
# ---------------------------------------------------------------------------

if [[ "${PKG}" == "dnf" ]] && rpm -q kmod-zfs &>/dev/null; then
    log "kmod-zfs detected — ZFS modules are kABI-tracked, skipping DKMS verification"
elif [[ "${PKG}" == "pacman" ]] && pacman -Q zfs-linux &>/dev/null; then
    log "zfs-linux detected — prebuilt ZFS modules, skipping DKMS verification"
else
    log "Verifying ZFS DKMS modules for all installed kernels..."

    DKMS_WARN=0
    while IFS= read -r kver; do
        [[ -n "${kver}" ]] || continue

        if dkms status -k "${kver}" 2>/dev/null | grep -qi 'zfs.*installed'; then
            log "  ZFS OK: ${kver}"
            continue
        fi

        log "  ZFS modules missing for ${kver} — attempting rebuild"

        if dkms autoinstall -k "${kver}" >> "$LOG" 2>&1; then
            log "  ZFS rebuilt OK: ${kver}"

            # Re-sign with MOK key if configured
            if [[ -x /etc/dkms/sign_helper.sh && -f /var/lib/dkms/mok.key ]]; then
                while IFS= read -r ko; do
                    /etc/dkms/sign_helper.sh "${kver}" "${ko}" >> "$LOG" 2>&1 || true
                done < <(find "/lib/modules/${kver}" \
                              -name '*.ko' -o -name '*.ko.gz' -o -name '*.ko.zst' \
                              2>/dev/null | grep -i zfs || true)
                log "  ZFS modules re-signed: ${kver}"
            fi
        else
            log "  WARNING: ZFS DKMS build FAILED for ${kver}"
            DKMS_WARN=1
        fi

    done < <(find /lib/modules -maxdepth 1 -mindepth 1 -type d -printf '%f\n' 2>/dev/null | sort)

    if [[ "${DKMS_WARN}" -eq 1 ]]; then
        cat >&2 <<'WARN'

  ┌─────────────────────────────────────────────────────────────┐
  │  kldload WARNING: ZFS DKMS build failed for one or more        │
  │  kernels. The previous kernel is still bootable via          │
  │  ZFSBootMenu. Check: /var/log/kldload/upgrade.log              │
  │                                                             │
  │  To fix:  dkms autoinstall -k <kver>                        │
  │  To roll back: kldload-be rollback <snapshot>                  │
  └─────────────────────────────────────────────────────────────┘

WARN
    fi
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

log "==================================================================="
log "kldload upgrade complete"
[[ -n "${SNAPSHOT_CREATED}" ]] && log "Pre-upgrade snapshot: ${SNAPSHOT_CREATED}"
log "Log: ${LOG}"
log "==================================================================="
