#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# kbe — boot environment management tool
# Usage:
#   kbe list
#   kbe create <name>                 snapshot the running root as @<name>, clone it to rpool/ROOT/<name>
#   kbe activate <dataset>            point the boot menu at that one for the next boot
#   kbe rollback <snapshot>           roll the running root back to <snapshot>
#   kbe delete <dataset|snapshot>     remove a boot environment and the snapshot it was made from
# ---------------------------------------------------------------------------

PROGNAME="$(basename "$0")"

log() {
    echo "[$PROGNAME] $*" >&2
}

die() {
    echo "[$PROGNAME] ERROR: $*" >&2
    exit 1
}

usage() {
    cat <<EOF
Usage: $PROGNAME <command> [args]

Commands:
  list                      List boot environments: rpool/ROOT, its datasets, their snapshots
  create <name>             Snapshot the running root as @<name> and clone it to
                            rpool/ROOT/<name>, so both appear in the boot menu
  activate <dataset>        Point the boot menu (pool bootfs) at that one for the next boot
  rollback <snapshot>       Roll the running root back to <snapshot> (discards newer changes)
  delete <dataset|snapshot> Remove a boot environment and the snapshot it was made from;
                            refuses the running root and the pool's bootfs

Examples:
  $PROGNAME list
  $PROGNAME create pre-upgrade
  $PROGNAME activate rpool/ROOT/pre-upgrade      # then reboot
  $PROGNAME activate rpool/ROOT/$(hostname)      # and back again
  $PROGNAME rollback rpool/ROOT/$(hostname)@pre-upgrade
  $PROGNAME delete rpool/ROOT/pre-upgrade
EOF
}

# Help needs neither the library nor root: `kbe --help` as admin used to answer
# "FATAL: This operation requires root privileges" (fiend, 2026-09-15).
case "${1:-}" in
help | --help | -h)
    usage
    exit 0
    ;;
"")
    usage >&2
    exit 2
    ;;
esac

# ---------------------------------------------------------------------------
# Locate and source bootenv.sh
# ---------------------------------------------------------------------------

BOOTENV_LIB=""
CANDIDATES=(
    "/usr/lib/kldload-installer/backend/bootenv.sh"
    "$(dirname "$(dirname "$(realpath "$0")")")/bootenv.sh"
    "/root/kldload/installer/backend/bootenv.sh"
)

for candidate in "${CANDIDATES[@]}"; do
    if [[ -f "$candidate" ]]; then
        BOOTENV_LIB="$candidate"
        break
    fi
done

[[ -n "$BOOTENV_LIB" ]] ||
    die "bootenv.sh not found. Checked: ${CANDIDATES[*]}"

# Also source common.sh for log/die/run helpers
COMMON_LIB="$(dirname "$BOOTENV_LIB")/common.sh"
[[ -f "$COMMON_LIB" ]] ||
    die "common.sh not found at $COMMON_LIB"

# shellcheck source=../common.sh
source "$COMMON_LIB"
# shellcheck source=../bootenv.sh
source "$BOOTENV_LIB"

# ---------------------------------------------------------------------------
# Require root
# ---------------------------------------------------------------------------

require_root

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

COMMAND="${1:-}"
# no arguments at all: shift has nothing to drop and the empty COMMAND prints usage
shift || true

case "$COMMAND" in
list)
    echo "Boot environments (rpool/ROOT):"
    echo "---"
    # -t filesystem,snapshot, NOT just filesystem: `kbe create` makes a boot
    # environment as a SNAPSHOT of the active root (rpool/ROOT/<host>@<name>),
    # so listing filesystems alone hid every BE the operator created — created
    # BEs never appeared in `kbe list` (verified on hardware 2026-07-24).
    # Do NOT swallow zfs's stderr here. "(no boot environments found)" reads
    # exactly like a healthy pool that happens to be empty, so a `zfs list`
    # that failed for any other reason -- pool suspended, dataset renamed,
    # ZFS module not loaded -- reported itself as "nothing to see".
    # HISTORY: fiend .117, 2026-09-01. The installed-system smoke test warned
    # "new BE not visible in kbe list" seconds after `kbe create` had logged
    # success and the snapshot really was on disk. The BE was fine; this line
    # had eaten the reason and printed the reassuring message instead.
    if _be_out="$(zfs list -r -t filesystem,snapshot -o name,creation,used rpool/ROOT 2>&1)"; then
        printf '%s\n' "$_be_out"
    else
        printf 'ERROR: could not list boot environments under rpool/ROOT:\n' >&2
        printf '%s\n' "$_be_out" >&2
        exit 1
    fi

    echo ""
    echo "Active bootfs:"
    zpool get -H -o value bootfs rpool 2>/dev/null || echo "(unknown)"
    ;;

create)
    NAME="${1:-}"
    [[ -n "$NAME" ]] || die "create requires a name argument. Usage: $PROGNAME create <name>"
    # If name doesn't look like a full snapshot path, treat as just the name
    if [[ "$NAME" != *"@"* ]]; then
        bootenv_create "$NAME"
    else
        die "For create, provide just the snapshot name (without @), e.g.: $PROGNAME create my-backup"
    fi
    ;;

activate)
    SNAP="${1:-}"
    [[ -n "$SNAP" ]] || die "activate requires a snapshot argument."
    bootenv_activate "$SNAP"
    log "Next boot will use: ${SNAP%%@*}"
    ;;

rollback)
    SNAP="${1:-}"
    [[ -n "$SNAP" ]] || die "rollback requires a snapshot argument."
    log "WARNING: Rolling back will DISCARD all changes made after $SNAP."
    log "Press Ctrl+C within 5 seconds to abort..."
    sleep 5
    bootenv_rollback "$SNAP"
    log "Rollback complete. Reboot to apply."
    ;;

delete)
    TARGET="${1:-}"
    [[ -n "$TARGET" ]] || die "delete requires a boot environment: a dataset or snapshot from '$PROGNAME list'"
    bootenv_delete "$TARGET"
    ;;

help | --help | -h | "")
    usage
    ;;

*)
    usage
    die "Unknown command: '$COMMAND'"
    ;;
esac
