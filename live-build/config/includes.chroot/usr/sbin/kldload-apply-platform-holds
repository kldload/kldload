#!/usr/bin/env bash
set -Eeuo pipefail

# Debian AND Ubuntu meta-package names. Only installed packages are held (see
# the dpkg-query filter below), so listing both schemes costs nothing — while
# omitting one fails SILENTLY, which is how Ubuntu boxes ended up with an
# unheld kernel.
PKGS=(
    linux-image-amd64
    linux-headers-amd64
    linux-image-generic
    linux-headers-generic
    linux-image-virtual
    linux-headers-virtual
    zfsutils-linux
    zfs-zed
    zfs-initramfs
    zfs-dkms
    grub-efi-amd64
    shim-signed
    mokutil
)

installed=()
for p in "${PKGS[@]}"; do
    if dpkg-query -W -f='${Status}\n' "$p" 2>/dev/null | grep -q installed; then
        installed+=("$p")
    fi
done

if ((${#installed[@]} > 0)); then
    apt-mark hold "${installed[@]}" || true
fi
