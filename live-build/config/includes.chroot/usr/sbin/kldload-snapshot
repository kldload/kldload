#!/usr/bin/env bash
# kldload-snapshot — take one @auto-YYYYMMDD-HHMMSS snapshot of the running
# boot environment (the pool's bootfs) and prune those snapshots to the
# newest KLDLOAD_ROOT_SNAP_KEEP (default 48, two days of hourly ones).
# Run by its timer; logs to /var/log/kldload/bootstrap.log. No arguments.
set -Eeuo pipefail

# --help answers without taking a snapshot: it took one (as root), since
# nothing read the arguments (2026-09-30).
case "${1:-}" in
-h | --help)
    sed -n '2,${/^#/!q; s/^# \{0,1\}//; p}' "$0"
    exit 0
    ;;
"") ;;
*)
    echo "kldload-snapshot: takes no arguments (got: $*)" >&2
    exit 2
    ;;
esac

LOG=/var/log/kldload/bootstrap.log
mkdir -p /var/log/kldload
touch "$LOG"

if ! command -v zfs >/dev/null 2>&1; then
    exit 0
fi

root_ds="$(zpool get -H -o value bootfs rpool 2>/dev/null || true)"
if [[ -n "$root_ds" && "$root_ds" != "-" ]]; then
    snap="${root_ds}@auto-$(date +%Y%m%d-%H%M%S)"
    {
        echo "[$(date '+%F %T')] creating snapshot ${snap}"
        zfs snapshot "$snap"
    } >>"$LOG" 2>&1 || true
    # retention: the hourly @auto- snapshots of the root were never pruned
    # and grew by 24 a day for the life of the machine (source audit
    # 2026-09-26). Two days of them are kept (KLDLOAD_ROOT_SNAP_KEEP); a
    # snapshot a boot environment was cloned from is kept by zfs itself,
    # and snapshot-prune reports it instead of failing.
    /usr/local/sbin/snapshot-prune.sh "$root_ds" auto- "${KLDLOAD_ROOT_SNAP_KEEP:-48}" >>"$LOG" 2>&1 ||
        echo "[$(date '+%F %T')] WARNING: pruning ${root_ds}@auto- failed — see above" >>"$LOG"
fi
