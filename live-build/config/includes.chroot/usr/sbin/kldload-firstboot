FFPOL
            log "Workstation profile: Firefox bookmarks set (no homepage override, no autostart)"
            # Ensure stale lab-profile autostart from a prior install is
            # removed if the user re-profiled to desktop.
            rm -f /etc/xdg/autostart/kldload-dashboard.desktop 2>/dev/null || true
            ;;
          *)
            log "Profile '${_prof}' is headless/stripped — no Firefox policy applied"
            ;;
        esac
        # Desktop notification
        if [[ "${ROLE}" == "desktop" || "${KLDLOAD_PROFILE:-}" == "desktop" ]]; then
          local _ip
          _ip=$(ip -o -4 addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
          # Send notification to all logged-in GNOME sessions
          for _uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
            local _user
            _user=$(id -nu "$_uid" 2>/dev/null || true)
            if [[ -n "$_user" ]]; then
              sudo -u "$_user" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${_uid}/bus" \
                notify-send -i dialog-information "kldload AI Ready" \
                "Open WebUI is running at http://${_ip:-localhost}:8080\nModel: llama3.1:8b\nCommands: kai, kai-voice, kai-do, kai-remote" 2>/dev/null || true
            fi
          done
        fi

        # MOTD for SSH users
        cat >> /etc/motd <<AIMOTD

  kldload AI Assistant — ready
  Open WebUI:  http://$(ip -o -4 addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1):8080
  Commands:    kai, kai-voice, kai-do, kai-remote
  Model:       llama3.1:8b ($(curl -s http://localhost:11434/api/tags 2>/dev/null | python3 -c "import sys,json;m=json.load(sys.stdin)['models'];print(f'{m[0][\"size\"]//1024//1024} MB')" 2>/dev/null || echo "loaded"))

AIMOTD

        ) # end AI subshell — errors above don't kill firstboot
        ok "AI setup complete"
      else
        log "WARNING: Ollama install failed (no internet?) — run 'curl -fsSL https://ollama.com/install.sh | sh' manually"
      fi
    fi

    # ── KVM Host profile setup ──────────────────────────────────────────────
    if [[ "$ROLE" == "kvm" || "${KLDLOAD_ENABLE_KVM:-0}" == "1" ]]; then
      log "KVM Host profile — configuring hypervisor..."

      # Create ZFS dataset for VMs — optimized for VM I/O
      zfs create -o compression=lz4 -o recordsize=64K -o primarycache=metadata rpool/vms 2>/dev/null || true
      ok "ZFS dataset rpool/vms created (compressed, 64K recordsize)"

      # libvirt storage pool for the ZFS zvols — DON'T DEFINE ONE.
      #
      # Three approaches that all fail on CentOS Stream 9:
      #
      #   1. <pool type='zfs'>  → libvirt is built without the zfs
      #      storage backend on CentOS 9; rejects with "missing
      #      backend for pool type 12 (zfs)".
      #
      #   2. <pool type='dir' target=/dev/zvol/rpool/vms> → libvirt
      #      defines it, but now virt-install sees /dev/zvol paths
      #      as "volumes inside a dir pool" and passes them to qemu
      #      with driver='file'. qemu then rejects: "'file' driver
      #      requires /dev/zvol/… to be a regular file". The symlinks
      #      under /dev/zvol point at block devices (/dev/zdN) but
      #      the dir-pool path treats them as files.
      #
      #   3. No pool at all → virt-install treats /dev/zvol/rpool/vms/<name>
      #      as an absolute path, stats it (S_ISBLK true on the
      #      underlying /dev/zdN), hands it to qemu with the correct
      #      driver='host_device'. This WORKS on every distro we ship.
      #
      # Approach 3 is what the klab golden build chain actually relies
      # on. We used to write a broken zfs-type pool XML and swallow
      # the error with 2>/dev/null, which happened to leave us in
      # approach-3 state by accident. Making that explicit here.
      #
      # libvirtd itself still needs to be up for virsh / virt-install,
      # and the 'isos' pool (cloud-init ISOs) is still useful — both
      # are set up elsewhere in firstboot.
      systemctl enable libvirtd 2>/dev/null || true
      systemctl start libvirtd 2>/dev/null || true
      ok "libvirt ready — zvols accessed as raw /dev/zvol/… paths (no pool needed)"

      # Set up bridge networking
      local _primary_nic
      _primary_nic=$(nmcli -t -f DEVICE,TYPE device | grep ':ethernet' | head -1 | cut -d: -f1)
      if [[ -n "$_primary_nic" && "$_primary_nic" != "br0" ]]; then
        log "Setting up bridge br0 on ${_primary_nic}..."
        nmcli connection add type bridge ifname br0 con-name br0 2>/dev/null || true
        nmcli connection add type bridge-slave ifname "${_primary_nic}" master br0 2>/dev/null || true
        # Copy IP config from primary NIC to bridge
        local _ip _gw _dns
        _ip=$(nmcli -g IP4.ADDRESS device show "${_primary_nic}" 2>/dev/null | head -1)
        _gw=$(nmcli -g IP4.GATEWAY device show "${_primary_nic}" 2>/dev/null | head -1)
        _dns=$(nmcli -g IP4.DNS device show "${_primary_nic}" 2>/dev/null | head -1)
        if [[ -n "$_ip" ]]; then
          nmcli connection modify br0 ipv4.addresses "${_ip}" ipv4.gateway "${_gw}" ipv4.dns "${_dns}" ipv4.method manual 2>/dev/null || true
        fi
        ok "Bridge br0 configured on ${_primary_nic}"
      fi

      # Enable IP forwarding
      echo "net.ipv4.ip_forward = 1" > /etc/sysctl.d/99-kvm-forward.conf
      sysctl -p /etc/sysctl.d/99-kvm-forward.conf 2>/dev/null || true

      # Keep default NAT network (virbr0) AND the host bridge (br0) both
      # alive. Previously we destroyed virbr0 here "because we use br0",
      # but klab, kspawn, kube-cluster, and the ZFS test lab all attach
      # their test VMs to virbr0 on 192.168.122.0/24 — destroying it
      # made `klab golden` fail with "Cannot get interface MTU on virbr0".
      # The two bridges coexist cleanly: br0 for user-facing VMs with
      # LAN-routable IPs, virbr0 for klab/internal lab VMs with NAT.
      virsh net-autostart default 2>/dev/null || true
      virsh net-start default 2>/dev/null || true

      ok "KVM Host ready — use kvm-create, kvm-snap, kvm-clone (br0 for LAN VMs, virbr0 for klab)"
      log "  Storage pool: zfs-vms (rpool/vms)"
      log "  Bridge: br0"
      log "  Tools: kvm-create, kvm-snap, kvm-clone"

      # ── klab observability: Prometheus + Grafana + klab-exporter on host ──
      # Any hw profile that has klab goldens / K8s / KVM on it benefits
      # from the obs stack — Prometheus scrapes cilium-agent, cilium-operator,
      # hubble-metrics, tetragon, kubelet on the cluster AND node_exporter
      # on every klab golden. Gating behind DEVOPS=1 alone meant the K8s
      # tile and the ZFS Lab tile shipped with no metrics plane at all.
      if [[ "${KLDLOAD_ENABLE_DEVOPS:-0}" == "1" \
         || "${KLDLOAD_ENABLE_K8S:-0}"    == "1" \
         || "${KLDLOAD_ENABLE_KVM:-0}"    == "1" \
         || "${KLDLOAD_KLAB_ZFS_DEV:-0}"  == "1" \
         || "${KLDLOAD_ZFSLAB_MODE:-0}"   == "1" ]]; then
        log "Setting up klab observability stack on host..."

        # ── Grafana (from official repo — RPM available online) ──
        if ! command -v grafana >/dev/null 2>&1; then
          cat > /etc/yum.repos.d/grafana.repo <<'GREPO'
[grafana]
name=Grafana OSS
baseurl=https://rpm.grafana.com
gpgcheck=1
gpgkey=https://rpm.grafana.com/gpg.key
enabled=1
GREPO
          dnf install -y grafana 2>/dev/null || true
        fi

        # ── Prometheus (binary — not in CentOS/EPEL repos) ──
        if ! command -v prometheus >/dev/null 2>&1; then
          log "  Installing Prometheus from binary..."
          curl -fsSL https://github.com/prometheus/prometheus/releases/download/v2.54.1/prometheus-2.54.1.linux-amd64.tar.gz \
            | tar -xz -C /tmp 2>/dev/null
          install -m 755 /tmp/prometheus-*/prometheus /usr/local/bin/
          install -m 755 /tmp/prometheus-*/promtool /usr/local/bin/
          mkdir -p /etc/prometheus /var/lib/prometheus
          rm -rf /tmp/prometheus-*

          cat > /etc/systemd/system/prometheus.service <<'PROMSVC'
[Unit]
Description=Prometheus
After=network-online.target
[Service]
Type=simple
ExecStart=/usr/local/bin/prometheus --config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/var/lib/prometheus --web.listen-address=0.0.0.0:9090
Restart=always
[Install]
WantedBy=multi-user.target
PROMSVC
        fi

        # ── node_exporter (binary) ──
        if ! command -v node_exporter >/dev/null 2>&1; then
          curl -fsSL https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-amd64.tar.gz \
            | tar -xz -C /tmp 2>/dev/null
          install -m 755 /tmp/node_exporter-*/node_exporter /usr/local/bin/
          rm -rf /tmp/node_exporter-*

          cat > /etc/systemd/system/node_exporter.service <<'NESVC'
[Unit]
Description=Node Exporter
After=network-online.target
[Service]
Type=simple
ExecStart=/usr/local/bin/node_exporter
Restart=always
[Install]
WantedBy=multi-user.target
NESVC
        fi

        # ── Prometheus config ──
        if [[ -f /usr/local/share/klab/prometheus.yml ]]; then
          cp /usr/local/share/klab/prometheus.yml /etc/prometheus/prometheus.yml
          mkdir -p /etc/prometheus/rules
          ok "Prometheus configured with klab scrape targets"
        fi

        # ── Grafana provisioning ──
        mkdir -p /etc/grafana/provisioning/datasources /etc/grafana/provisioning/dashboards /var/lib/grafana/dashboards

        # Remove default sample configs that conflict
        rm -f /etc/grafana/provisioning/datasources/sample.yaml 2>/dev/null
        rm -f /etc/grafana/provisioning/dashboards/sample.yaml 2>/dev/null

        cat > /etc/grafana/provisioning/datasources/klab.yaml <<'GRAFDS'
apiVersion: 1
datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://localhost:9090
    isDefault: true
    uid: prometheus
GRAFDS

        # NB: do NOT write a klab.yaml provisioner here — the rich
        # kldload.yaml (shipped via includes.chroot/etc/grafana/
        # provisioning/dashboards/kldload.yaml) has 7 folder-providers
        # (Estate / Host / Storage / Virtual Machines / klab Operations
        # / ZFS Test Lab / Kubernetes) each pointing at the right
        # subdirectory. The old klab.yaml stomped it with a single
        # top-level provider, so subfolders weren't traversed and only
        # the 6 top-level JSONs landed. Caught .142 2026-05-17.
        # Remove any stale klab.yaml that pre-existed.
        rm -f /etc/grafana/provisioning/dashboards/klab.yaml 2>/dev/null || true

        # Copy pre-built dashboard
        if [[ -f /usr/local/share/klab/grafana-dashboard.json ]]; then
          cp /usr/local/share/klab/grafana-dashboard.json /var/lib/grafana/dashboards/klab-estate.json
          ok "Grafana dashboard provisioned"
        fi

        # Additional community dashboards — node_exporter full + Cilium +
        # Hubble + Tetragon. Deploy.sh pre-fetches them into
        # /usr/local/share/klab/grafana-dashboards/ at build time so firstboot
        # is fully offline. Fall back to online fetch if the cache is empty
        # (dev or old builds only).
        for id in 1860 16611 16612 16613; do
          _cached="/usr/local/share/klab/grafana-dashboards/grafana-${id}.json"
          _target="/var/lib/grafana/dashboards/grafana-${id}.json"
          if [[ -f "$_cached" ]]; then
            cp "$_cached" "$_target"
            ok "Grafana dashboard ${id} provisioned (offline)"
          else
            curl -fsSL "https://grafana.com/api/dashboards/${id}/revisions/latest/download" \
              -o "$_target" 2>/dev/null \
              && ok "Grafana dashboard ${id} provisioned (online)" || true
          fi
        done

        # Tetragon dashboard — bundled (no Grafana.com ID exists). Ships in
        # the ISO. This one is required for the Observability group in the
        # web UI's Metrics tab.
        if [[ -f /usr/local/share/klab/grafana-dashboards/tetragon.json ]]; then
          cp /usr/local/share/klab/grafana-dashboards/tetragon.json \
             /var/lib/grafana/dashboards/tetragon.json
          ok "Grafana dashboard Tetragon eBPF provisioned"
        fi

        # Pin Node Exporter Full (1860) default "job" to node_exporter.
        # Upstream ships with no default, so Grafana picks alphabetically —
        # which means if klab-blue / klab-green scrapes also exist, those
        # get selected first and every panel shows "No data" (those klab
        # target IPs are empty until klab VMs are actually running).
        python3 - <<'PYFIX' 2>/dev/null || true
import json, os, glob, re
# Two fixes applied to every provisioned dashboard:
#   1) Strip __inputs / __requires / __elements and rewrite any
#      ${DS_PROMETHEUS*} placeholder to our real datasource UID
#      "prometheus". Grafana.com dashboards ship packaged for UI import
#      where the user maps the placeholder at import time — file-drop
#      provisioning has no such step, so panels silently query a
#      non-existent datasource and show "No data".
#   2) Pin Node Exporter Full (1860) default job to node_exporter,
#      otherwise Grafana picks the first job alphabetically and lands
#      on stale klab-blue targets with no data.
TARGET_DS = {"type": "prometheus", "uid": "prometheus"}
def walk(o):
    if isinstance(o, dict):
        ds = o.get("datasource")
        if isinstance(ds, str) and ds.startswith("${"):
            o["datasource"] = dict(TARGET_DS)
        elif isinstance(ds, dict):
            uid = ds.get("uid", "")
            if uid.startswith("${") or uid in ("", "$datasource"):
                o["datasource"] = dict(TARGET_DS)
        for v in o.values(): walk(v)
    elif isinstance(o, list):
        for v in o: walk(v)
for p in glob.glob("/var/lib/grafana/dashboards/*.json"):
    try: d = json.load(open(p))
    except Exception: continue
    d.pop("__inputs", None); d.pop("__requires", None); d.pop("__elements", None)
    walk(d)
    for v in d.get("templating", {}).get("list", []):
        if v.get("name") == "job" and "node" in p.lower():
            v["current"] = {"selected": True, "text": "node_exporter", "value": "node_exporter"}
    txt = json.dumps(d, indent=2)
    txt = re.sub(r'"\$\{DS_PROMETHEUS[^"}]*\}"', '"prometheus"', txt)
    txt = txt.replace("${DS_PROMETHEUS}", "prometheus")
    open(p, "w").write(txt)
PYFIX
        chown -R grafana:grafana /var/lib/grafana/dashboards 2>/dev/null || true

        # Anonymous Viewer + iframe embedding — grafana binds loopback HTTP
        # only. kldload-proxy on :8443 terminates TLS and exposes grafana
        # at https://<host>:8443/grafana/. One cert prompt (proxy's)
        # covers the webui + grafana + ttyd-k9s as a single origin; no
        # second prompt, no cross-origin iframe block.
        if ! grep -q "^\[auth.anonymous\]" /etc/grafana/grafana.ini 2>/dev/null \
           || ! grep -A2 "^\[auth.anonymous\]" /etc/grafana/grafana.ini | grep -q "^enabled = true"; then
          cat >> /etc/grafana/grafana.ini <<'GRAFEMBED'

[server]
protocol = http
http_addr = 127.0.0.1
http_port = 3000
# Sub-path hosting + explicit proxy-facing URL. Grafana 13's preloader
# rejects the config if root_url doesn't resolve to a full URL, so we
# hardcode it — %(domain)s is populated below from the primary LAN
# IP (or a stable DNS entry via KLDLOAD_DOMAIN env). 8443 is the
# proxy port. If the user hits Grafana via a DIFFERENT origin
# (WireGuard IP, hostname), asset loads still work because appSubUrl
# comes out as /grafana and the browser resolves relative URLs
# against its current origin.
root_url = https://%(domain)s:8443/grafana/
domain = __KLDLOAD_LAN_IP__
serve_from_sub_path = true
enforce_domain = false

[auth.anonymous]
enabled = true
org_name = Main Org.
org_role = Viewer

[security]
allow_embedding = true
cookie_samesite = none
# SameSite=None cookies REQUIRE Secure=true per browser policy
# (Chrome 84+, Firefox 79+). Without this, the browser silently
# drops the Grafana session cookie, Grafana can't establish
# anonymous-viewer state, the app's init hangs and the preloader
# times out to its "failed to load application files" fallback.
# Safe to set true because the proxy terminates TLS on :8443.
cookie_secure = true
# CSRF: the proxy terminates TLS with an origin that differs from what
# grafana sees internally. Trust any origin — the proxy is literally
# the only thing that can reach grafana on 127.0.0.1:3000 anyway.
csrf_trusted_origins = *
csrf_additional_headers = X-Forwarded-For

[users]
default_theme = dark
GRAFEMBED
          # Substitute the real LAN IP for the %(domain)s placeholder in
          # root_url. Using the placeholder lets the heredoc stay static
          # while a per-install IP is baked in at firstboot time.
          _lan_ip="$(ip -o -4 addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
          if [[ -n "$_lan_ip" ]]; then
            sed -i "s|__KLDLOAD_LAN_IP__|${_lan_ip}|" /etc/grafana/grafana.ini
          else
            sed -i "s|__KLDLOAD_LAN_IP__|localhost|" /etc/grafana/grafana.ini
          fi
          systemctl restart grafana-server 2>/dev/null || true
          ok "Grafana anonymous + iframe embedding via proxy (/grafana) enabled"
        fi

        # Grafana 11+ default-enables kubernetesDashboards + dashboardsV2,
        # which route every dashboard read through the K8s-style API at
        # /apis/dashboard.grafana.app/v2/. We don't expose dashboards via
        # any K8s apiserver — they're file-provisioned into SQLite via
        # provisioning/dashboards/kldload.yaml. With the toggles on, the
        # UI hits the v2 endpoint, gets a 403, and shows "Failed to load
        # dashboard {status 403}" for Tetragon/Cilium/Host-Full/etc.
        # Disabling both toggles forces the classic /api/dashboards/uid/
        # path which our provisioning serves correctly.
        if ! grep -q "^\[feature_toggles\]" /etc/grafana/grafana.ini 2>/dev/null; then
          cat >> /etc/grafana/grafana.ini <<'GRAFTOGGLES'

[feature_toggles]
kubernetesDashboards = false
dashboardsV2 = false
GRAFTOGGLES
          systemctl restart grafana-server 2>/dev/null || true
          ok "Grafana feature_toggles: kubernetesDashboards/dashboardsV2 off (avoids dashboardsV2 403 on Tetragon/Cilium/Host-Full)"
        fi

        # Prometheus: add localhost:9100 (host node_exporter) scrape if
        # not already there. The klab prometheus.yml may list VM targets
        # but skip the host.
        if [[ -f /etc/prometheus/prometheus.yml ]] && ! grep -q "kldload-host\|localhost:9100" /etc/prometheus/prometheus.yml; then
          cat >> /etc/prometheus/prometheus.yml <<'PROMHOST'

  - job_name: kldload-host
    static_configs:
      - targets: [localhost:9100]
        labels:
          instance: kldload-host
PROMHOST
          ok "Prometheus: added kldload-host scrape"
        fi

        # ── Grafana anonymous access via systemd env override ──
        mkdir -p /etc/systemd/system/grafana-server.service.d
        cat > /etc/systemd/system/grafana-server.service.d/klab.conf <<'GFOVER'
[Service]
Environment="GF_AUTH_ANONYMOUS_ENABLED=true"
Environment="GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer"
Environment="GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/klab-estate.json"
Environment="GF_AUTH_DISABLE_LOGIN_FORM=false"
GFOVER

        # ── klab-exporter systemd ──
        cat > /etc/systemd/system/klab-exporter.service <<'KLABEXP'
[Unit]
Description=klab Prometheus Exporter
After=network-online.target
[Service]
Type=simple
ExecStart=/usr/local/bin/klab-exporter
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
KLABEXP

        # ── Start all services ──
        systemctl daemon-reload
        for _svc in prometheus node_exporter grafana-server klab-exporter; do
          systemctl enable "$_svc" 2>/dev/null || true
          systemctl start "$_svc" 2>/dev/null || true
        done
        ok "klab observability: Prometheus :9090, Grafana :3000, klab-exporter :9101"

        # ── Firefox homepage → Grafana ──
        mkdir -p /etc/firefox/policies
        cat > /etc/firefox/policies/policies.json <<'FFPOL'
{
  "policies": {
    "Homepage": {
      "URL": "http://localhost:3000/d/klab-estate/klab-estate?orgId=1&refresh=30s",
      "StartPage": "homepage"
    },
    "OverrideFirstRunPage": "http://localhost:3000/d/klab-estate/klab-estate?orgId=1&refresh=30s",
    "Bookmarks": [
      {"Title": "klab Dashboard", "URL": "http://localhost:3000/d/klab-estate/klab-estate", "Placement": "toolbar"},
      {"Title": "Prometheus", "URL": "http://localhost:9090", "Placement": "toolbar"},
      {"Title": "kldload Docs", "URL": "https://kldload.com", "Placement": "toolbar"}
    ],
    "DisplayBookmarksToolbar": "always"
  }
}
FFPOL
        ok "Firefox homepage set to Grafana klab dashboard"
      fi

      # klab golden builds are owned by kldload-autodeploy.service — NOT
      # firstboot. Prior versions had firstboot do a blocking for-loop
      # through every distro here, which:
      #   - held firstboot-done off for ~1 hr, blocking autodeploy
      #     (and therefore Ollama / Bob) from starting
      #   - raced with autodeploy if anything re-triggered a golden
      #     build while firstboot was still looping (partial cloud-image
      #     downloads, VM name collisions, parallel qemu on the same
      #     zvol)
      #   - duplicated work: autodeploy already runs `klab golden all`
      #     and, on ZFS-Lab mode, `klab golden-ztest all` in the klab
      #     phase after K8s is up.
      # Leaving a log breadcrumb so someone reading the firstboot log
      # knows where the builds moved to.
      log "klab golden builds deferred to kldload-autodeploy.service (runs after firstboot-done)"
    fi

    # Darksite cleanup vs LAN-mirror opt-in.
    #
    # Default: rehydrate Ollama weights OUT, then remove /root/darksite
    # (~1.8G) — install is done, the mirror just costs disk.
    # Opt-in: if /etc/kldload/keep-darksite exists (set at install time
    # via the web UI "keep darksite as LAN mirror" toggle, or manually
    # by `touch /etc/kldload/keep-darksite` before firstboot runs),
    # we leave the tree in place AND keep kldload-apt-mirror.service
    # so other machines on the LAN can use this box as their offline
    # package mirror. The repo file in /etc/yum.repos.d is removed
    # either way — `dnf` on this host should hit upstream once it has
    # internet, not the local mirror — but the mirror dir itself stays
    # so other machines can point at it.
    if [[ -d /root/darksite ]]; then
      if [[ -d /root/darksite/ollama/models ]] && [[ ! -f /srv/ollama/models/manifests/registry.ollama.ai/library/qwen2.5/14b && ! -f /srv/ollama/models/manifests/registry.ollama.ai/library/llama3.1/8b ]]; then
        mkdir -p /srv/ollama/models
        log "Rehydrating Ollama models from darksite (before darksite cleanup)..."
        rsync -a /root/darksite/ollama/models/ /srv/ollama/models/ 2>&1 | tail -3
        chown -R ollama:ollama /srv/ollama 2>/dev/null || true
        log "Ollama models rehydrated: $(du -sh /srv/ollama/models 2>/dev/null | cut -f1)"
      fi
      rm -f /etc/yum.repos.d/kldload-darksite.repo 2>/dev/null
      if [[ -f /etc/kldload/keep-darksite ]]; then
        log "LAN-mirror mode: keeping /root/darksite ($(du -sh /root/darksite 2>/dev/null | cut -f1)) and enabling kldload-apt-mirror.service"
        systemctl enable --now kldload-apt-mirror.service 2>/dev/null || true
      else
        log "Removing darksite directory ($(du -sh /root/darksite 2>/dev/null | cut -f1)) — touch /etc/kldload/keep-darksite before firstboot to retain as a LAN mirror"
        rm -rf /root/darksite
        systemctl disable --now kldload-apt-mirror.service 2>/dev/null || true
        log "Darksite removed."
      fi
    fi

    rm -f /tmp/kldload-firstboot-status
    log "kldload-firstboot complete (free edition)"
    return 0
  fi

  # ── PRO edition: full cluster-aware setup ──────────────────────────────────
  # Auto-discover hub.env before template dispatch so all firstboot scripts
  # can find the WireGuard hub when the network is up.
  _try_fetch_hub_env

  # Template-specific firstboot scripts override the standard role dispatch.
  # KLDLOAD_TEMPLATE is set in the answer file (e.g. template-monitoring.env).
  local template="${KLDLOAD_TEMPLATE:-}"
  if [[ -n "${template}" ]]; then
    local tscript="/usr/local/sbin/kldload-firstboot-${template}"
    if [[ -x "${tscript}" ]]; then
      log "Delegating to template firstboot: ${tscript}"
      exec "${tscript}" "$@"
    else
      log "WARNING: no template script at ${tscript} — falling through to role dispatch"
    fi
  fi

  # KLDLOAD_INFRA_MODE written by installer — dispatch to specialized firstboots
  local _infra_mode="${KLDLOAD_INFRA_MODE:-standalone}"
  case "${_infra_mode}" in
    cluster-manager)
      if [[ -x /usr/local/sbin/kldload-firstboot-master ]]; then
        log "Delegating to kldload-firstboot-master"
        exec /usr/local/sbin/kldload-firstboot-master "$@"
      fi
      ;;
    join)
      log "Join mode — role=${ROLE}"
      ;;
  esac

  case "${ROLE}" in
    master)
      setup_master
      ;;
    kvm)
      setup_wg_client; setup_kvm;        setup_salt_minion ;;
    storage)
      setup_wg_client; setup_storage;    setup_salt_minion ;;
    vdi)
      setup_wg_client; setup_vdi;        setup_salt_minion ;;
    monitoring)
      setup_wg_client; setup_monitoring; setup_salt_minion ;;
    proxmox)
      setup_wg_client; setup_proxmox ;;
    server|client|desktop)
      setup_wg_client; setup_salt_minion ;;
    *)
      log "Unknown role '${ROLE}' — base setup only"
      setup_wg_client; setup_salt_minion ;;
  esac

  # Zero-trust chain runs after all role setup (WireGuard must be up)
  setup_zero_trust

  # ── Darksite cleanup ──────────────────────────────────────────────────────
  # ZBM EFI already on EFI partition, APT pool not needed post-install —
  # reclaim the space.
  if [[ -d /root/darksite ]]; then
    log "Removing darksite directory (~1.8G)..."
    rm -rf /root/darksite
    rm -f /etc/yum.repos.d/kldload-darksite.repo 2>/dev/null
    log "Darksite removed."
  fi
  systemctl disable --now kldload-apt-mirror.service 2>/dev/null || true

  rm -f /tmp/kldload-firstboot-status
  log "kldload-firstboot complete (free edition)"
}

main "$@"
