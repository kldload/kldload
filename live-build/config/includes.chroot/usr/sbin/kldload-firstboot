            log "Lab profile (${_prof}): Firefox homepage + autostart set to webui on :8443"
            ;;
          desktop)
            # Workstation — bookmarks + first-run suppression, NO homepage
            # override, NO autostart. User's daily driver is theirs.
            mkdir -p /etc/firefox/policies
            cat > /etc/firefox/policies/policies.json <<FFPOL
{
  "policies": {
    "DontCheckDefaultBrowser": true,
    "DisplayBookmarksToolbar": "always",
    "Bookmarks": [
      {"Title": "kldload Web UI", "URL": "https://localhost:8443", "Placement": "toolbar"},
      {"Title": "kldload Docs",   "URL": "https://kldload.com",    "Placement": "toolbar"}
    ],
    "UserMessaging": {
      "WhatsNewMessaging": false,
      "ExtensionRecommendations": false,
      "SkipOnboarding": true
    }
  }
