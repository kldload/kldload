#!/usr/bin/env bash
set -Eeuo pipefail
trap 'echo "FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR
# ---------------------------------------------------------------------------
# rollback — put the system back the way it was before a package
# Installed as /usr/sbin/kldload-rollback with a `rollback` symlink beside it;
# `apt rollback` / `dnf rollback` reach it through kldload-pkg-wrapper. The
# operator-facing name is `rollback` — the kldload- prefix is kept only so the
# older name in scripts and docs keeps resolving.
#                    transaction, using boot environments.
#
# What it does, in order:
#   1. Finds the running boot environment (the pool's bootfs).
#   2. Lists / selects a snapshot of it — the apt and dnf hooks take one before
#      every transaction, so there is almost always a recent one.
#   3. CLONES that snapshot into a NEW boot environment.
#   4. Copies the boot-critical properties onto the clone.
#   5. Points the pool's bootfs at it. Next reboot lands in the old state.
#
# WHY a clone and not `zfs rollback`:
#   `zfs rollback` cannot run against a mounted root ("dataset is busy"), and
#   it DESTROYS every snapshot newer than the target — so the operation has no
#   way back if the rollback itself was the mistake. Cloning is reversible:
#   the environment you rolled away from is still there, untouched, and
#   `rollback cancel` re-points bootfs at it before you even reboot.
#   This is what boot environments are for, and what ZFSBootMenu boots from.
#
# WHY no daemon: nothing here runs in the background. The snapshots are made
#   by apt/dnf themselves via their own hook mechanisms; this tool only runs
#   when an operator invokes it.
#
# Inputs:  a snapshot name (or `last`), the rpool.
# Outputs: a new dataset under rpool/ROOT/, a changed bootfs, a log at
#          /var/log/kldload/rollback.log. Nothing is destroyed, ever.
#
# Notes:
#   - The clone holds a dependency on its origin snapshot: the old environment
#     cannot be destroyed while the clone exists. `zfs promote` breaks that
#     link once you are satisfied with the rollback. This tool never destroys.
#   - org.zfsbootmenu:commandline is copied EXPLICITLY. ZFSBootMenu builds the
#     kernel command line from that property and nowhere else — not from grub,
#     not from /etc/kernel/cmdline. A clone does not inherit a property that
#     was set LOCALLY on the origin, so a rollback that skipped this step would
#     boot without the nouveau blacklist and hang on an NVIDIA box.
#   - Rolling back the root does NOT roll back the pool's other datasets
#     (/home, /srv, zvols). That is deliberate: nobody wants a kernel rollback
#     to eat two days of their home directory.
# ---------------------------------------------------------------------------

LOG=/var/log/kldload/rollback.log

# A staged rollback is inert until the machine boots into it, and an operator
# who typed `rollback` has already decided. Staging and then STOPPING made them
# type a second command to get the thing they asked for, and on a demo bench it
# reads as "nothing happened" — the packages are still installed, because the
# old root is still mounted. So `last` and `to` reboot for you.
# --no-reboot (or KLDLOAD_ROLLBACK_REBOOT=0) restores the stage-and-stop
# behaviour for anything scripted; `cancel` still un-stages before the reboot.
REBOOT="${KLDLOAD_ROLLBACK_REBOOT:-1}"
REBOOT_DELAY="${KLDLOAD_ROLLBACK_DELAY:-10}"
mkdir -p "$(dirname "$LOG")"

_ts() { date '+%Y-%m-%dT%H:%M:%S'; }
log() { echo "$(_ts) $*" >>"$LOG"; }
# SIGPIPE is IGNORED, and a write to a closed stdout is not an error.
#
# WHY: this tool changes boot state. With the default disposition, piping it to
# `head`, or quitting a pager mid-output, kills it with 141 — and if that lands
# between `zpool set bootfs` and the restore that follows, the pool is left
# pointing at an environment that is then destroyed.
# HISTORY: onyx 2026-08-29. `rollback cancel 2>&1 | head -2` exited 141
# part-way through the cancel; the staged clone was removed afterwards and the
# pool was left with bootfs UNSET. Reproduced deterministically:
#     rollback status | head -2   -> 141
#     rollback status             -> 0
# Nobody reading the output is not a reason to abandon a half-applied change.
trap '' PIPE
say() { printf '%s\n' "$*" 2>/dev/null || true; }
die() {
    log "ERROR: $*"
    printf 'rollback: %s\n' "$*" >&2
    exit 1
}

command -v zfs >/dev/null 2>&1 || die "zfs is not installed — nothing to roll back"

# ─── Locating the running environment ──────────────────────────────────────
# bootfs is the authority: it is what ZFSBootMenu reads to pick a default, so
# it is also what has to change for a rollback to take effect. Fall back to
# the dataset actually mounted at / when bootfs is unset on an odd pool.
# NO early-exiting consumer on the right of a pipe anywhere in this file.
# `producer | awk '...{exit}'` and `producer | head -1` both make the PRODUCER
# take SIGPIPE, pipefail turns that into 141, and the ERR trap kills the tool.
# It is racy — it only fires when the producer is still writing as the consumer
# leaves — so it passes all day and then bites under load.
# HISTORY: onyx 2026-08-29. `rollback cancel` died at _running_be with
# "FAIL at line 114", having already repointed nothing back; the clone it had
# staged was then destroyed and the pool was left with bootfs UNSET. On the ZBM
# path that is an unbootable machine.
# The fix everywhere is an awk that reads to EOF (no exit, no head).
_pool() { zpool list -H -o name 2>/dev/null | awk 'NR==1'; }
_fsize() { stat -c %s "$1" 2>/dev/null || echo 0; }

# _esp_backup <src> <dst> — copy onto the ESP and PROVE the copy is whole.
# A short backup is worse than no backup: `cancel` restores these files
# unconditionally, so a truncated one becomes an unbootable machine. On any
# shortfall the partial is REMOVED, so cancel finds nothing and skips.
_esp_backup() {
    cp -a "$1" "$2" || {
        rm -f "$2"
        die "could not back up ${1##*/} onto the ESP"
    }
    [[ "$(_fsize "$1")" == "$(_fsize "$2")" ]] || {
        rm -f "$2"
        die "the backup of ${1##*/} came up short and was removed, so 'cancel' \
cannot restore a truncated file. The ESP is almost certainly full. bootfs was \
set; run 'rollback cancel' to undo it."
    }
}

_current_be() {
    local pool bootfs
    pool="$(_pool)"
    [[ -n "$pool" ]] || return 1
    # A pool with no bootfs set is a data pool, not a boot pool — skipped, not
    # an error.
    bootfs="$(zpool get -H -o value bootfs "$pool" 2>/dev/null || true)"
    if [[ -n "$bootfs" && "$bootfs" != "-" ]]; then
        printf '%s\n' "$bootfs"
        return 0
    fi
    mount | awk '$3=="/" && $5=="zfs" && !f {print $1; f=1}'
}

# The environment we are RUNNING from, which is not always the one bootfs
# names — after a rollback is staged, they differ until the reboot.
_running_be() { mount | awk '$3=="/" && $5=="zfs" && !f {print $1; f=1}'; }

BE="$(_current_be)" || die "could not find a ZFS pool"
[[ -n "$BE" ]] || die "could not determine the boot environment"
POOL="${BE%%/*}"
BE_PARENT="${BE%/*}"

# ─── Snapshot listing ──────────────────────────────────────────────────────
# _rule <n> — n box-drawing characters. See the call site for why this is not
# a printf precision cut.
_rule() {
    local n="$1" s=''
    while ((n-- > 0)); do s+='─'; done
    printf '%s' "$s"
}

# Grouped by who took it, because that is how an operator thinks about it:
# "the one from just before I ran apt".
_snapshots() {
    # No snapshots yet is the state of a fresh install before the first
    # transaction; the caller prints the 'take one first' guidance.
    zfs list -H -t snapshot -o name,creation,used -s creation "$BE" 2>/dev/null || true
}

# _snap_source <tag> — human label for where a snapshot came from.
# stdout: one short phrase; "-" when the prefix is not one we mint.
# Shared by `list` and the interactive picker so the two can never disagree.
_snap_source() {
    case "$1" in
    apt-pre-*) echo "before apt" ;;
    apt-post-*) echo "after apt" ;;
    dnf-pre-*) echo "before dnf" ;;
    dnf-post-*) echo "after dnf" ;;
    kpkg-*) echo "kpkg" ;;
    auto-*) echo "scheduled" ;;
    manual-*) echo "manual" ;;
    rollback-*) echo "pre-rollback" ;;
    # sanoid's own naming; these are the periodic retention snapshots and are
    # perfectly valid rollback targets, so they are labelled rather than left
    # as "-" for an operator to wonder about.
    autosnap_*) echo "sanoid" ;;
    install-*) echo "install" ;;
    smoketest-*) echo "smoke test" ;;
    *) echo "-" ;;
    esac
}

cmd_list() {
    local rows
    rows="$(_snapshots)"
    if [[ -z "$rows" ]]; then
        say "No snapshots of $BE."
        say ""
        say "The apt/dnf hooks take one before each transaction; if this is a"
        say "fresh install you may simply not have run one yet."
        return 0
    fi
    say "Snapshots of $BE (newest last):"
    say ""
    printf '  %-34s %-22s %8s  %s\n' "SNAPSHOT" "CREATED" "USED" "SOURCE"
    # Built by repetition rather than `printf '%.34s'`: that truncates by BYTE
    # and this rule is drawn with a 3-byte box character, so the precision cut
    # landed mid-character and printed a replacement glyph followed by short
    # columns. Repetition is encoding-agnostic.
    printf '  %s %s %s  %s\n' "$(_rule 34)" "$(_rule 22)" "$(_rule 8)" "$(_rule 12)"
    while IFS=$'\t' read -r name creation used; do
        [[ -z "$name" ]] && continue
        local tag="${name#*@}"
        printf '  %-34s %-22s %8s  %s\n' "${tag:0:34}" "${creation:0:22}" "$used" "$(_snap_source "$tag")"
    done <<<"$rows"
    say ""
    say "Roll back with:  rollback to <snapshot>"
    say "Or the newest pre-transaction one:  rollback last"
}

# _pick_last — newest snapshot taken BEFORE a package transaction.
# Returns the bare tag on stdout; empty if there is none.
# apt-post/dnf-post are excluded on purpose: those record the state AFTER the
# change, which is the state you are trying to get away from.
#
# WHY the guard: grep exits 1 when nothing matches, and "nothing matches" is a
# perfectly normal state — a freshly installed box has no pre-transaction
# snapshot yet, and neither does the environment you land in right after a
# rollback applies (its only snapshots are sanoid's autosnaps). Under pipefail
# that 1 propagated out of the command substitution and killed the caller, so
# `status` aborted mid-report and `last` never reached its own die() with the
# helpful message — the operator got an ERR trace instead.
# (.132, 2026-08-27: `apt rollback status` right after a successful rollback.)
_pick_last() {
    _snapshots | awk -F'\t' '{print $1}' | sed 's/.*@//' |
        # The true-guard below covers exactly one case: grep exits 1 when
        # nothing matches, which is the normal "no pre-transaction snapshot"
        # answer, not an error.
        { grep -E '^(apt-pre|dnf-pre|kpkg)-' || true; } | tail -1
}

# ─── The boot path actually in force ───────────────────────────────────────
# There are TWO ways a kldload box boots, and a rollback that only handles one
# of them fails silently on the other — which is the worst possible outcome
# for this particular tool.
#
#   ZBM path   (Secure Boot OFF): shim/GRUB chainloads /EFI/zbm/BOOTX64.EFI,
#              ZFSBootMenu reads the pool's bootfs and boots that dataset.
#              Setting bootfs is sufficient and nothing else is needed.
#
#   DIRECT path (Secure Boot ON): ZBM is a 64MB unsigned bundle and shim 15.8
#              refuses to chainload it, so the install writes a `direct` GRUB
#              entry that boots a COPY of the kernel from the ESP with
#              root=ZFS=<dataset> hardcoded in grub.cfg. bootfs is not
#              consulted at all. Verified on fiend 2026-08-16: Secure Boot
#              enabled, only Debian's CA enrolled, /proc/cmdline showed
#              BOOT_IMAGE=/EFI/BOOT/vmlinuz root=ZFS=rpool/ROOT/kldload-node.
#
# So on the direct path a rollback must also rewrite grub.cfg AND restore the
# kernel+initrd that belong to the snapshot: the ESP copy is whatever the last
# kernel upgrade put there, and booting a NEW vmlinuz against the OLD
# /lib/modules in the rolled-back root gives a system with no modules — no
# ZFS, no network, no disks.
ESP_GRUB_CFG=/boot/efi/EFI/BOOT/grub.cfg
ESP_DIR=/boot/efi/EFI/BOOT

# Backups of the ESP's boot trio do NOT live on the ESP.
#
# WHY: the ESP is a fixed, small FAT partition — 512M on installs before the
# 2G change — and kldload's portable initramfs is ~233MB of it. Keeping a
# .kldload-bak beside each live file DOUBLED the space a rollback needs, from
# 251MB to 502MB, which is more than a 512M ESP can ever hold. Meanwhile the
# pool has terabytes free. So they go to ZFS, and the ESP only ever has to fit
# the live pair plus the incoming pair.
# HISTORY: onyx 2026-08-29 — the backup ran the ESP to 100% and stopped
# halfway, leaving a truncated initrd that `cancel` would restore over the good
# one. Fixed by gating on space; fixed properly by not putting it there at all.
ESP_BAK_DIR=/var/lib/kldload/esp-backup

# _boot_mode — which entry does this machine ACTUALLY boot?
#
# stdout: "direct" (GRUB's signed direct-kernel entry) or "zbm" (ZFSBootMenu).
#
# It used to answer "direct" whenever grub.cfg merely CONTAINED the string
# root=ZFS= — but the installer always writes the direct and rescue entries,
# whatever the default is, so that string is present on every install and the
# answer was "direct" every time. On .137/.132 2026-08-26 (Secure Boot off) it
# reported "direct kernel (Secure Boot compatible)" for a machine with no GRUB
# in its boot chain at all: \EFI\BOOT\BOOTX64.EFI was byte-identical to the ZBM
# UKI, there was no grubx64.efi anywhere on the ESP, and NVRAM pointed straight
# at \EFI\ZBM\BOOTX64.EFI. /proc/cmdline said root=zfs: — ZBM's format, not
# GRUB's root=ZFS=.
#
# Asked properly, in order of how directly each source answers the question:
#   1. /proc/cmdline — how this kernel was ACTUALLY loaded. root=ZFS= is GRUB's
#      direct entry; root=zfs: is ZBM's. Nothing beats observing the real boot.
#   2. no grubx64.efi on the ESP -> GRUB cannot run, so it must be ZBM.
#   3. grub.cfg's `set default=` — GRUB exists; believe what it says it boots.
# Unknown falls to "direct", which only costs an inert ESP sync; guessing "zbm"
# on a machine that really boots GRUB would skip the sync it genuinely needs.
_boot_mode() {
    local cl
    cl="$(cat /proc/cmdline 2>/dev/null || true)"
    case "$cl" in
    *root=ZFS=*)
        echo direct
        return
        ;;
    *root=zfs:*)
        echo zbm
        return
        ;;
    esac

    if ! compgen -G "/boot/efi/EFI/*/grubx64.efi" >/dev/null 2>&1; then
        echo zbm
        return
    fi

    if [[ -f "$ESP_GRUB_CFG" ]] && grep -qE '^[[:space:]]*set default=zbm' "$ESP_GRUB_CFG" 2>/dev/null; then
        echo zbm
        return
    fi
    echo direct
}

# _sync_esp <new-be> — make the ESP boot the given environment.
# Args:    dataset name of the freshly cloned boot environment.
# Returns: 0 on success; dies on failure AFTER restoring what it touched.
# Side effects: rewrites grub.cfg and replaces vmlinuz/initrd.img on the ESP,
#               keeping copies of all three in ESP_BAK_DIR for `cancel`.
_sync_esp() {
    local newbe="$1"
    local mnt
    mnt="$(mktemp -d)"
    # shellcheck disable=SC2064  # expand $mnt now: the path must survive the trap
    trap "umount '$mnt' 2>/dev/null || true; rmdir '$mnt' 2>/dev/null || true" RETURN

    # zfsutil is required for a dataset whose mountpoint property is /; without
    # it mount(8) refuses rather than honouring the explicit target.
    mount -t zfs -o ro,zfsutil "$newbe" "$mnt" ||
        die "could not mount $newbe to read its kernel — bootfs was set but \
the ESP was NOT updated, so this system still boots the current environment. \
Nothing is broken; see $LOG"

    # `|| kern=""` / `|| initrd=""`: a missing or unreadable $mnt/boot makes
    # find exit 1, pipefail promotes it, and set -e kills the tool HERE — so
    # the two carefully worded refusals below ("no kernel under /boot ...
    # bootfs was set; run 'rollback cancel' to undo it") were unreachable in
    # exactly the case they were written for. The operator got a bare
    # "FAIL at line 339" instead, with bootfs already moved and no hint that
    # `cancel` was the way out.
    # HISTORY: onyx 2026-08-30, found while re-testing the b1268 ESP gate.
    local kern initrd
    kern="$(find "$mnt/boot" -maxdepth 1 -name 'vmlinuz-*' -printf '%T@ %p\n' 2>/dev/null |
        sort -rn | awk 'NR==1{sub(/^[^ ]* /, ""); print}')" || kern=""
    # BOTH naming conventions. initrd.img-<ver> is Debian/Ubuntu; the RPM
    # families (Fedora/RHEL/Rocky/CentOS) write initramfs-<ver>.img, and
    # matching only the deb name made every rollback on an RPM host die here —
    # AFTER the clone and `zpool set bootfs` had already happened, leaving the
    # pool pointed at a half-staged environment that `cancel` had to undo.
    # HISTORY: onyx 2026-08-29, F44 desktop. `dnf install vlc` then
    # `dnf rollback` → "the snapshot has a kernel but no initrd", with
    # /boot/initramfs-7.2.2-300.fc44.x86_64.img sitting in the snapshot the
    # whole time. bootloader.sh:1398 already globbed both; this did not.
    # kdump is excluded on purpose: it is a crash-capture initrd, it sorts
    # newest right after a kdump rebuild, and booting it strands the machine.
    initrd="$(find "$mnt/boot" -maxdepth 1 \
        \( -name 'initramfs-*.img' -o -name 'initrd.img-*' \) \
        ! -name '*kdump*' -printf '%T@ %p\n' 2>/dev/null |
        sort -rn | awk 'NR==1{sub(/^[^ ]* /, ""); print}')" || initrd=""

    [[ -n "$kern" && -f "$kern" ]] ||
        die "the snapshot contains no kernel under /boot — refusing to stage a \
rollback that would leave this machine unbootable. bootfs was set; run \
'rollback cancel' to undo it."
    [[ -n "$initrd" && -f "$initrd" ]] ||
        die "the snapshot has a kernel but no initrd — refusing to stage an \
unbootable rollback. Run 'rollback cancel' to undo the bootfs change."

    log "restoring kernel from snapshot: $(basename "$kern") / $(basename "$initrd")"

    # ── ESP capacity gate ───────────────────────────────────────────────────
    # The ESP is a fixed vfat (512MB on installs before the 2G change) and a
    # dracut initrd is ~233MB of it. What this has to fit is the two .new
    # temporaries alongside the live pair — the backup of the live trio goes
    # to ESP_BAK_DIR on ZFS, which is what made a 512MB ESP survivable at all.
    # So the budget is the INCOMING pair, and nothing else.
    # Check first, because a cp that dies halfway leaves a TRUNCATED file on a
    # partition the machine boots from.
    # HISTORY: onyx 2026-08-29 — ESP hit 100%, the initrd backup stopped at
    # 105MB of 233MB. Caught by hand before cancel ran; cancel would have moved
    # that stub over the good initrd and left the machine unbootable.
    # This gate is the second line: _clone_be checks the same budget up front,
    # before the clone and before bootfs moves, so the common case never gets
    # here with a full ESP.
    local _need _free
    _need=$(($(_fsize "$kern") + $(_fsize "$initrd")))
    _free="$(df -P --block-size=1 "$ESP_DIR" 2>/dev/null | awk 'NR==2 {print $4}')"
    [[ "$_free" =~ ^[0-9]+$ ]] || _free=0
    if ((_free < _need)); then
        die "the ESP has $((_free / 1048576))MB free but staging this rollback \
needs $((_need / 1048576))MB (the incoming kernel and initrd; backups go to \
ZFS, not here). Refusing BEFORE any copy, so nothing is half-written. bootfs \
was set; run 'rollback cancel' to undo it. Then free space on the ESP, or \
rebuild a host-only initrd (dracut -f --hostonly) to shrink it."
    fi

    # Back up before overwriting, so cancel is a real undo and not a rebuild.
    install -d -m 0700 "$ESP_BAK_DIR" || die "could not create $ESP_BAK_DIR"
    # There is only ever ONE backup set. Anything already here belongs to a
    # rollback that has since been cancelled or booted, and restoring it would
    # plant a stale kernel — so it goes before this set is written.
    # `|| true` covers exactly one case: an empty directory, where the glob
    # stays literal and rm -f is a no-op anyway.
    rm -f "$ESP_BAK_DIR"/* 2>/dev/null || true
    _esp_backup "$ESP_GRUB_CFG" "$ESP_BAK_DIR/grub.cfg"
    [[ -f "$ESP_DIR/vmlinuz" ]] && _esp_backup "$ESP_DIR/vmlinuz" "$ESP_BAK_DIR/vmlinuz"
    [[ -f "$ESP_DIR/initrd.img" ]] && _esp_backup "$ESP_DIR/initrd.img" "$ESP_BAK_DIR/initrd.img"
    # The marker is written LAST and is what `cancel` keys off, so a backup
    # interrupted partway leaves no marker and cancel skips it rather than
    # restoring a partial trio. It records WHICH environment these files came
    # from; see cmd_cancel for why that matters.
    printf '%s\n' "$(_running_be)" >"$ESP_BAK_DIR/for-be"

    # Write to a temp name and mv into place: a half-copied kernel on the ESP
    # is an unbootable machine, and vfat gives us no atomicity for free.
    cp "$kern" "$ESP_DIR/.vmlinuz.new" || die "could not stage the kernel onto the ESP"
    cp "$initrd" "$ESP_DIR/.initrd.img.new" || die "could not stage the initrd onto the ESP"
    mv -f "$ESP_DIR/.vmlinuz.new" "$ESP_DIR/vmlinuz" || die "could not install the kernel onto the ESP"
    mv -f "$ESP_DIR/.initrd.img.new" "$ESP_DIR/initrd.img" || die "could not install the initrd onto the ESP"

    # Point every hardcoded root= at the new environment. Both the `direct` and
    # `rescue` entries carry one; missing rescue would strand the operator in a
    # single-user shell on the WRONG environment exactly when they need it.
    local tmpcfg="${ESP_GRUB_CFG}.new"
    sed -E "s|root=ZFS=[^ ]+|root=ZFS=${newbe}|g" "$ESP_GRUB_CFG" >"$tmpcfg" ||
        die "could not rewrite grub.cfg"
    grep -q "root=ZFS=${newbe}" "$tmpcfg" ||
        die "grub.cfg rewrite did not take — refusing to install it"
    mv -f "$tmpcfg" "$ESP_GRUB_CFG" || die "could not install the rewritten grub.cfg"

    sync
    log "ESP updated: grub.cfg root=ZFS=$newbe, kernel $(basename "$kern")"
}

# ─── Package-database layout guard ─────────────────────────────────────────
# _pkgdb_outside_be — is the package database on a dataset the BE rollback
#                     will not touch?
#
# stdout: the offending dataset when the layout is wrong, nothing otherwise.
# Returns: 0 when the layout is BROKEN, 1 when it is correct.
#
# A rollback moves exactly one dataset: the boot environment. The package FILES
# live in /usr, which is part of it. The package DATABASE has to be part of it
# too, or the two land on different sides of the rollback and dpkg ends up
# insisting on packages whose binaries are gone. `apt-get check` does not catch
# that — it validates dependency consistency, not file presence — so the system
# reports healthy while being wrong.
#
# HISTORY .137 2026-08-26 (Secure Boot off, encrypted pool, ZBM boot path):
# seven packages installed, `rollback last`, reboot. Every mechanical
# step was correct — snapshot taken by the apt hook, clone made from it, bootfs
# re-pointed, ZBM booted the clone unattended, original BE left intact, and the
# binaries genuinely gone. dpkg still said 1128 packages instead of 1117 and
# listed all seven as installed, because /var/lib was its own dataset
# (rpool/var/lib) and survived. Fixed for new installs by giving /var/lib
# canmount=off so it belongs to the BE; existing pools cannot be fixed by that
# change, which is why this guard exists.
_pkgdb_outside_be() {
    local be db_ds
    be="$(_running_be)"
    [[ -n "$be" ]] || return 1

    local dbpath
    for dbpath in /var/lib/dpkg /var/lib/rpm /var/lib/pacman; do
        [[ -d "$dbpath" ]] || continue
        db_ds="$(findmnt -no SOURCE --target "$dbpath" 2>/dev/null)"
        [[ -n "$db_ds" ]] || continue
        if [[ "$db_ds" != "$be" ]]; then
            printf '%s %s\n' "$dbpath" "$db_ds"
            return 0
        fi
    done
    return 1
}

# ─── Staging a rollback ────────────────────────────────────────────────────
# _clone_be <snapshot-tag> — build the new environment and point bootfs at it.
# Args:    the bare snapshot tag (no dataset, no @).
# Returns: 0 on success; dies with a message on any failure.
# Failure modes the caller must expect: snapshot gone, name collision, a pool
# with no free space for the clone's metadata.
_clone_be() {
    local tag="$1"
    local snap="${BE}@${tag}"

    # Refuse BEFORE touching anything. A rollback that half-works is worse than
    # one that does not run: the operator reboots, sees the packages "installed",
    # and only finds out later that the files are gone.
    local _bad
    if _bad="$(_pkgdb_outside_be)"; then
        local _dbpath="${_bad%% *}" _dbds="${_bad##* }"
        printf 'rollback: REFUSING — the package database is not part of this boot environment.\n\n' >&2
        printf '  package database : %s\n' "$_dbpath" >&2
        printf '  lives on dataset : %s\n' "$_dbds" >&2
        printf '  boot environment : %s\n\n' "$BE" >&2
        printf 'A rollback moves only the boot environment. The package FILES (in /usr)\n' >&2
        printf 'would revert while the DATABASE above would not, leaving dpkg/rpm insisting\n' >&2
        printf 'on packages whose binaries are gone. Nothing reports that: `apt-get check`\n' >&2
        printf 'validates dependencies, not file presence.\n\n' >&2
        printf 'This pool predates the layout fix. To repair it, move the database into the\n' >&2
        printf 'boot environment (one reboot, no reinstall):\n\n' >&2
        printf '    rollback migrate-pkgdb\n\n' >&2
        printf 'Or override, understanding the result will be inconsistent:\n\n' >&2
        printf '    KLDLOAD_ROLLBACK_ALLOW_SPLIT_PKGDB=1 rollback %s\n' "${1:-last}" >&2
        if [[ "${KLDLOAD_ROLLBACK_ALLOW_SPLIT_PKGDB:-0}" != "1" ]]; then
            log "REFUSED: package DB on $_dbds, BE is $BE"
            exit 1
        fi
        printf '\nKLDLOAD_ROLLBACK_ALLOW_SPLIT_PKGDB=1 set — proceeding anyway.\n\n' >&2
        log "WARNING: proceeding with split package DB ($_dbds) by explicit override"
    fi

    zfs list -H -t snapshot "$snap" >/dev/null 2>&1 ||
        die "no such snapshot: $snap (see: rollback list)"

    # ── ESP capacity, checked BEFORE anything is created ────────────────────
    # This function's contract is "refuse before touching anything", and until
    # now the ESP check did not honour it: it lived in _sync_esp, which runs
    # after `zfs clone` AND after `zpool set bootfs`. So a host with a full ESP
    # got a refusal that had already repointed the pool, and the operator was
    # told both "Refusing BEFORE any copy" and "bootfs was set" in one message
    # — true, contradictory, and leaving them a `cancel` to run.
    # HISTORY: onyx 2026-08-29, reported from the console after exactly that.
    #
    # A snapshot's /boot is readable without cloning, via .zfs/snapshot/<tag>/,
    # so the whole budget can be computed up front.
    # `|| _sk=""` is load-bearing, not decoration: when the directory does not
    # exist `find` exits 1, pipefail promotes that out of the pipeline, and a
    # bare assignment under set -e kills the tool — the ERR trap prints
    # "FAIL at line 522" and the operator gets no diagnostic at all. That is
    # the OPPOSITE of the "not fatal" this block is documented to be, and it
    # fires whenever the snapshot lives on a BE other than the running one
    # (i.e. any second `rollback to` while one is already staged).
    # HISTORY: onyx 2026-08-30, reproduced by running `rollback last` where
    # /.zfs/snapshot/<tag>/boot was absent: died before the clone, line 522.
    local _sk _si _need _free
    _sk="$(find "/.zfs/snapshot/${tag}/boot" -maxdepth 1 -name 'vmlinuz-*' \
        -printf '%s\n' 2>/dev/null | sort -rn | awk 'NR==1')" || _sk=""
    _si="$(find "/.zfs/snapshot/${tag}/boot" -maxdepth 1 \
        \( -name 'initramfs-*.img' -o -name 'initrd.img-*' \) \
        ! -name '*kdump*' -printf '%s\n' 2>/dev/null | sort -rn | awk 'NR==1')" || _si=""
    # Unreadable snapshot dir (permissions, or an older layout) is not fatal —
    # _sync_esp still gates later. Only refuse on a number we actually have.
    if [[ "$_sk" =~ ^[0-9]+$ && "$_si" =~ ^[0-9]+$ ]]; then
        # Only the INCOMING pair is written to the ESP — the backup of the
        # live trio goes to ESP_BAK_DIR on ZFS, so it costs nothing here.
        _need=$((_sk + _si))
        _free="$(df -P --block-size=1 "$ESP_DIR" 2>/dev/null | awk 'NR==2 {print $4}')"
        [[ "$_free" =~ ^[0-9]+$ ]] || _free=0
        if ((_free < _need)); then
            die "the ESP has $((_free / 1048576))MB free but this rollback needs \
$((_need / 1048576))MB (the incoming kernel and initrd; the \
backup of the live pair goes to ZFS, not here). NOTHING has been changed — no clone, no bootfs, nothing to undo. \
Free space on the ESP, or install onto a machine with a larger one."
        fi
    fi

    # Name the new environment after what it restores, plus when the rollback
    # happened — two rollbacks to the same snapshot must not collide.
    local newbe="${BE_PARENT}/rollback-${tag}-$(date +%Y%m%d-%H%M%S)"

    log "cloning $snap -> $newbe"
    zfs clone "$snap" "$newbe" ||
        die "clone failed — see $LOG"

    # A boot environment must not auto-mount: ZFSBootMenu mounts the one it
    # boots and nothing else. canmount=on here would mount BOTH environments
    # over / at import and produce a system that is half one and half another.
    zfs set canmount=noauto "$newbe" || die "could not set canmount on $newbe"
    zfs set mountpoint=/ "$newbe" || die "could not set mountpoint on $newbe"

    # The ZBM kernel command line. Read from the ORIGIN, not from the parent:
    # a locally-set property is not inherited by a clone. If the origin has
    # none, inheriting from the parent is the correct default and we leave it.
    local cmdline
    # The property is unset on installs that boot the ESP kernel directly —
    # absence is the ZBM-not-in-use case, handled by the caller.
    cmdline="$(zfs get -H -o value org.zfsbootmenu:commandline "$BE" 2>/dev/null || true)"
    if [[ -n "$cmdline" && "$cmdline" != "-" ]]; then
        zfs set "org.zfsbootmenu:commandline=${cmdline}" "$newbe" ||
            die "could not set the ZBM command line on $newbe — refusing to \
leave a boot environment that would boot with the wrong kernel arguments"
        log "carried org.zfsbootmenu:commandline=${cmdline}"
    else
        log "origin has no local org.zfsbootmenu:commandline — inheriting"
    fi

    # Record where we came from, so `status` and a later operator can tell what
    # this environment is without reading the log.
    zfs set "org.kldload:rollback-from=${BE}" "$newbe" 2>/dev/null || true # cosmetic metadata only
    # The tag is a breadcrumb for the operator, not a correctness requirement:
    # failing to set it must not abort a rollback that already succeeded.
    zfs set "org.kldload:rollback-snapshot=${tag}" "$newbe" 2>/dev/null || true

    log "setting bootfs=$newbe on pool $POOL"
    zpool set "bootfs=${newbe}" "$POOL" ||
        die "clone succeeded but bootfs could not be set — the system will \
still boot the CURRENT environment, so nothing is broken. See $LOG"

    # bootfs alone is only enough on the ZBM path. On the direct/Secure-Boot
    # path GRUB never reads it, so without this the rollback would report
    # success and then boot the unchanged system.
    local mode
    mode="$(_boot_mode)"
    if [[ "$mode" == direct ]]; then
        log "direct boot path detected — updating the ESP"
        _sync_esp "$newbe"
    else
        log "ZBM boot path — bootfs is sufficient"
    fi

    say ""
    say "Rollback staged."
    say "  from snapshot  : $tag"
    say "  new environment: $newbe"
    if [[ "$mode" == direct ]]; then
        say "  boot path      : direct kernel (Secure Boot compatible)"
        say "                   grub.cfg and the ESP kernel were updated to match"
    else
        say "  boot path      : ZFSBootMenu (follows the pool's bootfs)"
    fi
    say "  the current environment ($BE) is untouched."
    say ""
}

# _reboot_now — apply a freshly staged rollback by rebooting into it.
# Args:    none. Reads REBOOT / REBOOT_DELAY.
# Returns: 0 when reboot is suppressed; otherwise does not return.
# The countdown is the confirmation: Ctrl-C leaves the rollback STAGED rather
# than unwinding it, because the operator asked for the rollback and only
# changed their mind about the timing. `cancel` is the way to undo the staging.
_reboot_now() {
    if ((REBOOT == 0)); then
        say "  reboot to apply   :  systemctl reboot"
        say "  changed your mind :  ${0##*/} cancel"
        say ""
        return 0
    fi
    say "  changed your mind :  ${0##*/} cancel   (until the reboot below)"
    say ""
    trap 'printf "\n"
        say "Reboot cancelled. The rollback is still STAGED and applies on the next boot."
        say "Un-stage it with:  ${0##*/} cancel"
        exit 0' INT
    local i
    for ((i = REBOOT_DELAY; i > 0; i--)); do
        printf '\r  rebooting in %2ds — Ctrl-C to stay here ' "$i"
        sleep 1
    done
    trap - INT
    printf '\r%*s\r' 46 ''
    log "rebooting to apply the staged rollback"
    say "Rebooting."
    systemctl reboot
}

# cmd_pick — what bare `rollback` does: show the snapshots, let the operator
# pick one, act on it. Args: none. Does not return when it reboots.
# The default is the newest PRE-transaction snapshot, which is what someone who
# just broke an install wants, so the whole interaction is `rollback`, Enter.
cmd_pick() {
    # No terminal and no verb is a USAGE ERROR, not a scripted rollback.
    #
    # HISTORY: onyx 2026-08-30. b1268 made bare `rollback` mean `pick`, and
    # sent the no-TTY case to cmd_last — which clones a BE, moves bootfs and
    # REBOOTS. So `ssh box rollback`, `rollback | tee log` or a cron line
    # rolled a machine back and restarted it for an operator who typed one
    # word and was shown no prompt. Before b1268 bare `rollback` printed help.
    # Verified by running it with stdin closed: it went straight to the clone.
    #
    # `rollback last` and `rollback to <snap>` still work unattended, and
    # kldload-pkg-wrapper passes `last` explicitly, so `apt rollback` /
    # `dnf rollback` are unaffected. exit 2, not return 2: a non-zero return
    # here would trip set -e and the ERR trap and bury the message.
    [[ -t 0 && -t 1 ]] || {
        printf 'rollback: refusing to choose a snapshot with no terminal.\n' >&2
        printf 'NOTHING has been changed. Name the one you mean:\n\n' >&2
        printf '    rollback last            newest pre-transaction snapshot\n' >&2
        printf '    rollback to <snapshot>   a specific one (see: rollback list)\n\n' >&2
        printf 'Both reboot into it; add --no-reboot to stage it and stop.\n' >&2
        exit 2
    }

    local rows
    rows="$(_snapshots)"
    if [[ -z "$rows" ]]; then
        cmd_list
        return 0
    fi

    local -a tags=()
    local n=0 default_n=0 dtag name creation used tag
    dtag="$(_pick_last)"

    say "Snapshots of $BE (newest last):"
    say ""
    printf '   #  %-34s %-22s %8s  %s\n' "SNAPSHOT" "CREATED" "USED" "SOURCE"
    printf '  %s  %s %s %s  %s\n' "$(_rule 2)" "$(_rule 34)" "$(_rule 22)" "$(_rule 8)" "$(_rule 12)"
    while IFS=$'\t' read -r name creation used; do
        [[ -z "$name" ]] && continue
        tag="${name#*@}"
        n=$((n + 1))
        tags+=("$tag")
        [[ "$tag" == "$dtag" ]] && default_n=$n
        printf '  %2d  %-34s %-22s %8s  %s\n' \
            "$n" "${tag:0:34}" "${creation:0:22}" "$used" "$(_snap_source "$tag")"
    done <<<"$rows"
    # No pre-transaction snapshot on this box yet: default to the newest of
    # whatever does exist rather than offering no default at all.
    ((default_n > 0)) || default_n=$n

    say ""
    local ans=""
    read -r -p "Roll back to which? [${default_n}] (q = quit): " ans || ans=q
    case "$ans" in
    q | Q) say "Nothing staged." && return 0 ;;
    "") ans="$default_n" ;;
    esac
    [[ "$ans" =~ ^[0-9]+$ ]] && ((ans >= 1 && ans <= n)) ||
        die "not one of the ${n} choices: ${ans}"

    say ""
    say "Rolling back to: ${tags[$((ans - 1))]}"
    _clone_be "${tags[$((ans - 1))]}"
    _reboot_now
}

cmd_to() {
    local tag="${1:-}"
    [[ -n "$tag" ]] || die "usage: rollback to <snapshot>"
    tag="${tag#*@}" # accept either the full name or the bare tag
    _clone_be "$tag"
    _reboot_now
}

cmd_last() {
    local tag
    tag="$(_pick_last)"
    [[ -n "$tag" ]] ||
        die "no pre-transaction snapshot found. 'rollback list' shows \
what exists; 'rollback to <snap>' takes any of them."
    say "Most recent pre-transaction snapshot: $tag"
    _clone_be "$tag"
    _reboot_now
}

cmd_cancel() {
    local running staged="$BE"
    running="$(_running_be)"
    [[ -n "$running" ]] || die "could not determine the running environment"

    # A backup set is restorable only if it was taken FROM the environment we
    # are running right now, and it is consumed the moment it is used.
    #
    # HISTORY: onyx 2026-08-30. ESP_BAK_DIR was written at stage time and never
    # removed, so esp_staged latched at 1 for the life of the install. b1275
    # turned the restore from `mv` (which consumed the backup) into `cp` (which
    # does not) and nothing took over the job. `rollback cancel` on a machine
    # with NOTHING staged then copied an old kernel and a grub.cfg naming a
    # destroyed BE over the live ESP — an unbootable machine, produced by the
    # one command whose whole purpose is to put things back. Reproduced with a
    # stubbed root: ESP vmlinuz went from NEW-KERNEL-v2 to OLD-KERNEL-v1 and
    # grub.cfg to root=ZFS=...-rollback-OLD, on a `cancel` that printed
    # "Cancelled" and exited 0.
    local esp_staged=0 bak_be=""
    [[ -f "$ESP_BAK_DIR/for-be" ]] && bak_be="$(<"$ESP_BAK_DIR/for-be")"
    if [[ -n "$bak_be" && "$bak_be" == "$running" ]]; then
        esp_staged=1
    elif [[ -e "$ESP_BAK_DIR" ]]; then
        # Either no marker (an interrupted backup) or one naming a different
        # environment, which describes an ESP state that is no longer current.
        # Neither can be restored safely, and keeping it re-arms the bug above.
        [[ -n "$bak_be" ]] &&
            log "discarding ESP backup taken from $bak_be (running $running)"
        rm -rf "$ESP_BAK_DIR"
    fi

    if [[ "$staged" == "$running" && $esp_staged -eq 0 ]]; then
        say "Nothing staged — this system already boots what it is running:"
        say "  $running"
        return 0
    fi

    if [[ "$staged" != "$running" ]]; then
        log "cancelling staged rollback: bootfs $staged -> $running"
        zpool set "bootfs=${running}" "$POOL" || die "could not reset bootfs"
    fi

    # Restore the ESP from the backups _sync_esp left. Do grub.cfg LAST: if we
    # die partway, a config still pointing at the staged environment with the
    # staged kernel in place is consistent, whereas the reverse is not.
    if [[ $esp_staged -eq 1 ]]; then
        log "restoring ESP from backup"
        # -s not -f: an empty backup is a failed copy, and restoring it is a
        # brick. _esp_backup removes short copies, so reaching here with one is
        # already abnormal — drop it rather than install it.
        [[ -s "$ESP_BAK_DIR/vmlinuz" ]] &&
            cp -f "$ESP_BAK_DIR/vmlinuz" "$ESP_DIR/vmlinuz"
        [[ -s "$ESP_BAK_DIR/initrd.img" ]] &&
            cp -f "$ESP_BAK_DIR/initrd.img" "$ESP_DIR/initrd.img"
        cp -f "$ESP_BAK_DIR/grub.cfg" "$ESP_GRUB_CFG" ||
            die "could not restore grub.cfg from backup"
        sync
        # CONSUMED. A backup that outlives the cancel that used it is the bug
        # in the HISTORY note above; removing it here is what `mv` used to do
        # for free.
        rm -rf "$ESP_BAK_DIR"
    fi

    say "Cancelled. Next boot returns to the running environment:"
    say "  $running"
    if [[ "$staged" != "$running" ]]; then
        say ""
        say "The staged environment was left in place; remove it with:"
        say "  zfs destroy $staged"
    fi
}

cmd_status() {
    local running
    running="$(_running_be)"
    local mode
    mode="$(_boot_mode)"
    say "Pool             : $POOL"
    say "Running from     : ${running:-unknown}"
    say "Next boot        : $BE"
    if [[ "$mode" == direct ]]; then
        # Show what GRUB will really do, not what bootfs says, because on this
        # path they can disagree and only one of them is the truth.
        local cfg_be
        cfg_be="$(grep -oE 'root=ZFS=[^ ]+' "$ESP_GRUB_CFG" 2>/dev/null | awk 'NR==1{n=split($0,a,"="); print a[n]}')"
        say "Boot path        : direct kernel (Secure Boot compatible)"
        say "grub.cfg boots   : ${cfg_be:-unknown}"
        if [[ -n "$cfg_be" && -n "$running" && "$cfg_be" != "$running" ]]; then
            say ""
            say "  ** A rollback is STAGED — GRUB will boot $cfg_be on next"
            say "     restart. 'rollback cancel' undoes it."
        fi
    else
        say "Boot path        : ZFSBootMenu (follows bootfs)"
        if [[ -n "$running" && "$BE" != "$running" ]]; then
            say ""
            say "  ** A rollback is STAGED — this system will boot a different"
            say "     environment on next restart. 'rollback cancel' undoes it."
        fi
    fi
    local n
    # grep -c exits 1 when the count is zero, which is a legitimate answer.
    n="$(_snapshots | grep -c . || true)"
    say ""
    say "Snapshots of the running environment: ${n:-0}"
    local last
    last="$(_pick_last)"
    [[ -n "$last" ]] && say "Newest pre-transaction snapshot     : $last"
    # Pins are the other half of the update model; surfacing them here means
    # one command answers "is this box pinned and can I get back?".
    #
    # Read the state file kldload-apply-platform-holds writes rather than any
    # one manager's CLI: this ran `apt-mark showhold` unconditionally, so on a
    # Fedora or Arch box the line simply did not print — indistinguishable, to
    # an operator, from a box with nothing pinned. Fall back to apt-mark for
    # systems installed before that file existed.
    local h=""
    if [[ -r /var/lib/kldload/platform-holds.list ]]; then
        # grep -c exits 1 on an empty file — zero pinned packages, reported as 0.
        h="$(grep -c . /var/lib/kldload/platform-holds.list 2>/dev/null || true)"
    elif command -v apt-mark >/dev/null 2>&1; then
        # Same: no holds is zero, not a failure.
        h="$(apt-mark showhold 2>/dev/null | grep -c . || true)"
    fi
    if [[ -n "$h" ]]; then
        say "Pinned platform packages           : ${h:-0}"
    else
        say "Pinned platform packages           : unknown (holds have not run)"
    fi
}

cmd_help() {
    cat <<'EOF'
rollback — return the system to a previous boot environment

  rollback                  Show the snapshots and ask which one, then REBOOT
                            into it. Needs a terminal: with none (a cron line,
                            `ssh box rollback`, a pipe) it changes nothing and
                            exits 2, because it will not restart a machine for
                            an operator who was shown no prompt.
  rollback list             Show snapshots of the current environment
  rollback last             Roll back to the newest PRE-transaction snapshot
                            (the one apt/dnf took before it changed anything),
                            then REBOOT into it
  rollback to <snapshot>    Roll back to a specific snapshot, then REBOOT into
                            it. `list` names the candidates.
  rollback cancel           Un-stage a rollback that has not booted yet
  rollback migrate-pkgdb    Move the package database into the boot
                            environment. For pools old enough to have it on
                            its own dataset. One reboot.
  rollback status           What is running, what boots next
  rollback help             This text

  Reachable as `apt rollback` / `dnf rollback` too — same tool, same verbs.

OPTIONS
  --no-reboot, -n           Stage the rollback and stop instead of rebooting
                            into it. It still applies on the next boot,
                            whenever that is. KLDLOAD_ROLLBACK_REBOOT=0 is
                            the same thing.

ENVIRONMENT
  KLDLOAD_ROLLBACK_REBOOT   0 to never reboot automatically (default 1).
  KLDLOAD_ROLLBACK_DELAY    Seconds to count down before rebooting
                            (default 10). Ctrl-C during the countdown leaves
                            the rollback staged.

HOW IT WORKS
  A rollback clones the chosen snapshot into a new boot environment and points
  the pool's bootfs at it, then reboots into it. Nothing is overwritten and
  nothing is destroyed — the environment you are running is still there
  afterwards, and `cancel` reverses the whole thing until you reboot.

  The reboot is not cosmetic. The old root stays mounted until the machine
  boots, so before it the packages you rolled back are all still installed and
  nothing looks like it worked. Ctrl-C during the countdown, or --no-reboot,
  leaves the rollback staged for the next boot.

  Snapshots are taken automatically before every apt/dnf transaction. There is
  no daemon; apt and dnf invoke the hook themselves.

WHAT IT DOES NOT DO
  Only the root environment moves. /home, /srv and any zvols are left alone,
  so rolling back a bad kernel does not also roll back your data.

EXAMPLES
  An upgrade broke the system; go back to just before it and reboot:
      rollback last

  Look first, then choose:
      rollback list
      rollback to apt-pre-20260816-141230

  Stage it now, reboot during the next maintenance window:
      rollback last --no-reboot

  Staged one by mistake:
      rollback cancel

EXIT STATUS
  0  success.
  1  failure (no snapshot, clone failed, bootfs unset, ESP too small). When a
     failure happens after bootfs was moved, the message says so and names
     `rollback cancel` as the undo.
  2  usage error: an unknown verb, or a bare `rollback` with no terminal to
     prompt on. Nothing is changed.

FILES
  /var/log/kldload/rollback.log    every action this tool takes
  /var/lib/kldload/esp-backup/     the ESP's boot trio as it was before a
                                   rollback was staged, plus a `for-be` marker
                                   naming the environment it was taken from.
                                   `cancel` restores it only when that marker
                                   matches what is running, and deletes it
                                   once used — a backup kept past its cancel
                                   is a stale kernel waiting to be installed.
EOF
}

# cmd_migrate_pkgdb — move the package database into the boot environment.
#
# For pools created before /var/lib was given canmount=off. Copies what the
# shared rpool/var/lib holds into the BE's own (currently shadowed) /var/lib
# directory, then stops the shared dataset from mounting. After one reboot the
# package database is part of the BE and a rollback moves it with the files.
#
# Order is chosen so a failure at ANY step leaves the machine exactly as it
# was: snapshot, copy, VERIFY the copy, and only then flip canmount. Nothing is
# ever deleted — the old dataset keeps its data and `canmount=on` restores it.
#
# Child datasets (containerd, containers, docker, etcd, kubelet, kldload state)
# are excluded: they mount at their own mountpoints and must NOT follow the BE.
cmd_migrate_pkgdb() {
    local bad be
    if ! bad="$(_pkgdb_outside_be)"; then
        say "Nothing to do: the package database is already part of $(_running_be)."
        return 0
    fi
    be="$(_running_be)"
    local dbds="${bad##* }" src_db="${bad%% *}"

    say "Migrating ${dbds} into the boot environment ${be}"
    say ""

    local stamp
    stamp="migrate-pkgdb-$(date +%Y%m%d-%H%M%S)"
    zfs snapshot "${dbds}@${stamp}" || die "could not snapshot ${dbds} — refusing to continue"
    zfs snapshot "${be}@${stamp}" || die "could not snapshot ${be} — refusing to continue"
    log "migrate-pkgdb: snapshots ${dbds}@${stamp} and ${be}@${stamp}"
    say "  snapshots taken: @${stamp} on both datasets (undo breadcrumb)"

    local mnt
    mnt="$(mktemp -d)"
    # shellcheck disable=SC2064  # expand now: the path must survive the trap
    trap "umount '$mnt' 2>/dev/null || true; rmdir '$mnt' 2>/dev/null || true" RETURN
    mount -t zfs -o zfsutil "$be" "$mnt" ||
        die "could not mount $be to reach its /var/lib — nothing has been changed"
    mkdir -p "${mnt}/var/lib"

    local -a excl=()
    local child
    while IFS= read -r child; do
        [[ -n "$child" ]] || continue
        excl+=(--exclude "./${child#/var/lib/}")
    done < <(zfs list -H -o mountpoint 2>/dev/null | grep '^/var/lib/' | sort)

    say "  copying (excluding ${#excl[@]} child dataset mountpoints)..."
    if ! tar -C /var/lib -cf - "${excl[@]}" . 2>/dev/null |
        tar -C "${mnt}/var/lib" -xf - 2>/dev/null; then
        die "copy failed — nothing has been changed; canmount is untouched"
    fi

    # VERIFY THE OUTCOME, not tar's exit status.
    local dst_db="${mnt}${src_db}"
    [[ -e "$dst_db" ]] ||
        die "copy reported success but ${dst_db} does not exist — canmount untouched"
    if [[ -f "${src_db}/status" ]]; then
        cmp -s "${src_db}/status" "${dst_db}/status" ||
            die "copied ${src_db}/status differs from the original — canmount untouched"
        say "  verified: ${src_db}/status matches byte for byte"
    fi

    umount "$mnt" || die "could not unmount the staging mount — canmount untouched"

    zfs set canmount=off "$dbds" || die "copy succeeded but could not set canmount=off on ${dbds}"
    log "migrate-pkgdb: ${dbds} canmount=off; data copied into ${be}"

    say ""
    say "Done. ${dbds} will no longer mount; /var/lib now comes from the boot environment."
    say "REBOOT to apply — until then the old dataset is still mounted and in use."
    say ""
    say "  undo:  zfs set canmount=on ${dbds}   (data untouched, plus @${stamp})"
}

# --no-reboot is positional-agnostic on purpose: `rollback --no-reboot to X`
# and `rollback to X --no-reboot` both read naturally and both must work.
_argv=()
for _arg in "$@"; do
    case "$_arg" in
    --no-reboot | -n) REBOOT=0 ;;
    *) _argv+=("$_arg") ;;
    esac
done
set -- ${_argv[@]+"${_argv[@]}"}

case "${1:-pick}" in
pick) cmd_pick ;;
list | ls) cmd_list ;;
last) cmd_last ;;
to)
    shift
    cmd_to "${1:-}"
    ;;
cancel) cmd_cancel ;;
migrate-pkgdb) cmd_migrate_pkgdb ;;
status) cmd_status ;;
help | -h | --help) cmd_help ;;
*)
    printf 'rollback: unknown command: %s\n\n' "$1" >&2
    cmd_help >&2
    # 2, not 1: a typo'd verb is a usage error and nothing was attempted, so a
    # caller can tell it apart from a rollback that genuinely failed.
    exit 2
    ;;
esac
