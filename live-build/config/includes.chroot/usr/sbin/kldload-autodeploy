#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════════════
# kldload-autodeploy — unattended "bring everything up" orchestrator
# ══════════════════════════════════════════════════════════════════════════════
#
# Runs once, after the first boot services have converged. Reads the install
# manifest to see what the user requested (K8s? AI? klab?), then orchestrates
# each subsystem in the right order, writes phase-ready marker files, and
# publishes a final /var/lib/kldload/all-ready flag.
#
# The web UI's firstboot_status endpoint reads these markers to drive the
# Dashboard's Lab Ready banner (green ✅ when everything requested is done).
#
# Ordering rules (enforced by this script):
#   1. AI pull runs FIRST in the background — it's ~5GB download, wants to
#      overlap with other long work. If AI wasn't requested, skipped.
#   2. Kubernetes bootstrap runs next (foreground) — ~15 min on fresh build,
#      ~5 min if golden cached. Blocks until cluster is Ready or fails.
#   3. klab golden-all runs last (foreground) — ~1hr for 5 distros. Takes
#      the longest, so we do it last to not block faster phases.
#   4. AI model gets pre-warmed once its pull completes (24h keepalive).
#   5. all-ready marker written only when every requested phase has its own
#      marker. Skipped phases don't block.
#
# Run status + current phase is written to /var/lib/kldload/current-phase so
# the UI can show "Kubernetes: step 4/9 — kubeadm init" instead of a generic
# spinner.
#
# Idempotent — safe to re-run. Won't redo phases that already have markers.
# Manual trigger: `sudo kldload-autodeploy`
# ══════════════════════════════════════════════════════════════════════════════

set -uo pipefail
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

MANIFEST=/etc/kldload/install-manifest.env
EFFECTIVE=/var/log/installer/effective-config.env
STATE_DIR=/var/lib/kldload
LOG_FILE=/var/log/kldload/autodeploy.log
PHASE_FILE="${STATE_DIR}/current-phase"

mkdir -p "$STATE_DIR" "$(dirname "$LOG_FILE")"
touch "$LOG_FILE"; chmod 644 "$LOG_FILE"

log()   { printf '[%(%F %T)T] [autodeploy] %s\n' -1 "$*" | tee -a "$LOG_FILE" >&2; }
phase() { printf '%s\n' "$1" > "$PHASE_FILE"; log "PHASE: $1"; }
mark()  { touch "${STATE_DIR}/$1-ready"; log "marker: $1-ready"; }

# ── Load install-time flags ───────────────────────────────────────────────────
# Two files:
#   /etc/kldload/install-manifest.env         — persisted manifest (user-set)
#   /var/log/installer/effective-config.env   — computed by installer
# Manifest is canonical, but K8S_BOOTSTRAP + KLAB_ZFS_DEV may only exist in
# effective-config depending on installer version. Load both; manifest wins
# on conflict.
declare -A WANT=(
    [k8s]=0 [ai]=0 [klab]=0
)
for _src in "$EFFECTIVE" "$MANIFEST"; do
    if [[ -r "$_src" ]]; then
        # shellcheck disable=SC1090
        . "$_src" 2>/dev/null || true
    fi
done
[[ "${KLDLOAD_K8S_BOOTSTRAP:-0}" == "1" || "${KLDLOAD_ENABLE_K8S:-0}" == "1" ]] && WANT[k8s]=1
[[ "${KLDLOAD_ENABLE_AI:-0}" == "1" ]] && WANT[ai]=1

# klab goldens — build all 5 ZFS-test-lab goldens automatically on any
# KVM-capable profile so "install completes" means "every lab distro is
# snapshot-ready for instant clone, no manual click". The user can still
# opt out with KLDLOAD_KLAB_NO_AUTO=1 in the install manifest.
# Explicit enable via KLDLOAD_KLAB_ZFS_DEV=1 still works for compatibility.
if [[ "${KLDLOAD_KLAB_NO_AUTO:-0}" != "1" ]]; then
    if [[ "${KLDLOAD_KLAB_ZFS_DEV:-0}" == "1" ]]; then
        WANT[klab]=1
    else
        case "${KLDLOAD_PROFILE:-}" in
            kvm|k8s|devops|ai) WANT[klab]=1 ;;
        esac
    fi
fi

log "Requested: k8s=${WANT[k8s]} ai=${WANT[ai]} klab=${WANT[klab]}"

# Early-out if nothing was requested — avoids a green "ready" banner on a
# plain install that didn't ask for any of these. The ConditionPathExists
# in the unit prevents re-firing; create the marker with a distinct name.
if [[ "${WANT[k8s]}${WANT[ai]}${WANT[klab]}" == "000" ]]; then
    phase "nothing-requested"
    touch "${STATE_DIR}/autodeploy-skipped"
    log "No extended services requested in install manifest — nothing to do."
    exit 0
fi

# ── Phase 0: Prereqs ──────────────────────────────────────────────────────────
phase "prereqs"
# Wait up to 5 min for network-online (first boot can race here)
for i in $(seq 1 60); do
    getent hosts cloud.centos.org >/dev/null 2>&1 && break
    sleep 5
done
# Ensure kldload web UI is up so the UI can watch progress
systemctl is-active kldload-webui >/dev/null 2>&1 || systemctl start kldload-webui 2>/dev/null || true

# kube-cluster + klab both invoke ansible-playbook for the VM provisioning
# path (replaces cloud-init runcmd). If the installer didn't install
# ansible-core (e.g. darksite missed it), install it now so downstream
# phases don't bail with "ansible-playbook not installed".
if ! command -v ansible-playbook >/dev/null 2>&1; then
    log "[prereqs] ansible-playbook missing — installing ansible-core"
    if command -v dnf >/dev/null 2>&1; then
        dnf install -y ansible-core >> "$LOG_FILE" 2>&1 || log "[prereqs] ansible-core install failed — K8s phase may fail"
    elif command -v apt-get >/dev/null 2>&1; then
        apt-get install -y ansible-core >> "$LOG_FILE" 2>&1 || log "[prereqs] ansible-core install failed"
    fi
fi

# ── Phase 1: AI model pull (background) ───────────────────────────────────────
# Runs in the background so it overlaps with K8s/klab. Model weights pull is
# bandwidth-bound; the rest of the work is CPU/disk-bound. Worst case they
# contend a little, but overall wall-clock is shorter with parallel.
AI_PID=""
if [[ "${WANT[ai]}" == "1" ]]; then
    phase "ai-pull-kicking"
    (
        set -e
        # Ollama CLI panics with "$HOME is not defined" when systemd execs
        # us without a login environment (which is always). Every ollama
        # invocation below needs HOME set so envconfig.Models() can find
        # the model store. Must come BEFORE any `ollama` call.
        export HOME="${HOME:-/root}"
        export OLLAMA_MODELS="${OLLAMA_MODELS:-/srv/ollama/models}"
        # qwen2.5:14b is the only chat model we ship. Better reasoning
        # and tool-calling than llama3.1:8b. On weak GPUs/CPU-only, falls
        # through to CPU inference — slower but still works. Override
        # with KLDLOAD_AI_MODEL=<name> if you want something different.
        _chat_model="${KLDLOAD_AI_MODEL:-qwen2.5:14b}"
        _vram_gb=0
        if command -v nvidia-smi >/dev/null 2>&1; then
            _vram_gb=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | sort -n | tail -1)
            _vram_gb=$(( ${_vram_gb:-0} / 1024 ))
        fi
        log "[ai] VRAM=${_vram_gb}GB → chat model: ${_chat_model}"
        log "[ai] installing ollama + pulling ${_chat_model}"
        command -v ollama >/dev/null 2>&1 || \
            curl -fsSL https://ollama.com/install.sh | sh >> "$LOG_FILE" 2>&1
        systemctl enable --now ollama 2>/dev/null || true
        for _ in $(seq 1 30); do
            curl -sf http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && break
            sleep 2
        done
        ollama pull "${_chat_model}" >> "$LOG_FILE" 2>&1
        # Vision model only for 10GB+ VRAM hosts
        _ram_gb=$(awk '/MemTotal/ {printf "%d", $2/1024/1024}' /proc/meminfo)
        if [[ $_vram_gb -ge 10 ]] && [[ $_ram_gb -ge 16 ]]; then
            ollama pull llama3.2-vision:11b >> "$LOG_FILE" 2>&1 || \
                log "[ai] vision pull failed — non-fatal"
        fi
        # Warm (keepalive 24h so first chat is instant)
        curl -sf -X POST http://127.0.0.1:11434/api/generate \
            -d "{\"model\":\"${_chat_model}\",\"prompt\":\"ok\",\"stream\":false,\"keep_alive\":\"24h\"}" \
            >/dev/null 2>&1 || true
        mark "ai"
        log "[ai] complete"
    ) &
    AI_PID=$!
    log "[ai] pull running as pid $AI_PID (backgrounded)"
fi

# ── Phase 2: Kubernetes bootstrap (foreground) ────────────────────────────────
# Note: `kube-cluster bootstrap` already does clean_slate → golden → clone →
# wg → kubeadm init → cilium/metallb/hubble/zfs-csi → join → smoke. We just
# invoke it and it streams to its own log file.
if [[ "${WANT[k8s]}" == "1" ]]; then
    phase "k8s-bootstrap"
    if [[ -f "${STATE_DIR}/k8s-ready" ]]; then
        log "[k8s] already marked ready — skipping"
    else
        log "[k8s] running kube-cluster bootstrap --workers 3"
        if kube-cluster bootstrap --workers 3 >> /var/log/kldload/kube-bootstrap.log 2>&1; then
            mark "k8s"
            log "[k8s] complete"

            # After cluster up, install Tetragon for eBPF syscall/process/file
            # observability. Installs from the ISO-shipped chart tarball
            # (/root/darksite/helm-charts/tetragon.tgz) so no internet needed.
            # Falls back to the helm repo if the tarball is missing (dev builds).
            log "[k8s] installing Tetragon for syscall-level observability..."
            export KUBECONFIG=/root/.kube/config
            _tetragon_tgz="/root/darksite/helm-charts/tetragon.tgz"
            if [[ -f "$_tetragon_tgz" ]]; then
                helm install tetragon "$_tetragon_tgz" -n kube-system \
                    --set tetragon.enableProcessCred=true \
                    --set tetragon.enableProcessNs=true \
                    --set tetragonOperator.install=true \
                    >> "$LOG_FILE" 2>&1 && log "[k8s] Tetragon installed (offline)" \
                    || log "[k8s] Tetragon install failed — non-fatal"
            else
                log "[k8s] Tetragon chart not in darksite — trying online helm repo"
                helm repo add cilium https://helm.cilium.io/ >> "$LOG_FILE" 2>&1 || true
                helm repo update >> "$LOG_FILE" 2>&1 || true
                helm install tetragon cilium/tetragon -n kube-system \
                    --set tetragon.enableProcessCred=true \
                    --set tetragon.enableProcessNs=true \
                    --set tetragonOperator.install=true \
                    >> "$LOG_FILE" 2>&1 && log "[k8s] Tetragon installed (online)" \
                    || log "[k8s] Tetragon install skipped — non-fatal"
            fi
        else
            log "[k8s] FAILED — see /var/log/kldload/kube-bootstrap.log"
        fi
    fi
fi

# ── Phase 3: klab goldens (foreground) ────────────────────────────────────────
# Last because it's the longest (~1hr). RHEL is auto-skipped if no creds
# in the secrets store.
if [[ "${WANT[klab]}" == "1" ]]; then
    phase "klab-goldens"
    if [[ -f "${STATE_DIR}/klab-ready" ]]; then
        log "[klab] already marked ready — skipping"
    else
        # Build BOTH golden lineages so the install is "complete":
        #   klab golden all         — blue-green goldens (site simulation, fault injection)
        #   klab golden-ztest all   — ZFS-test-lab goldens (zfs-tests.sh runners)
        # Both are needed for the full feature set of the web UI to work
        # out-of-the-box (blue-green tile, ZFS Test Lab tile). Running them
        # sequentially is ~2 hr on fresh build; subsequent boots are cached.
        _klab_ok=1
        log "[klab] running klab golden all (blue-green lineage)"
        klab golden all >> /var/log/kldload/klab-firstboot.log 2>&1 \
            || { _klab_ok=0; log "[klab] blue-green FAILED — see klab-firstboot.log"; }
        log "[klab] running klab golden-ztest all (ZFS test-lab lineage)"
        klab golden-ztest all >> /var/log/kldload/klab-firstboot.log 2>&1 \
            || { _klab_ok=0; log "[klab] ztest FAILED — see klab-firstboot.log"; }
        if [[ "$_klab_ok" -eq 1 ]]; then
            mark "klab"
            log "[klab] complete (blue-green + ztest goldens built)"
        fi

        # ZFS test goldens (separate lineage with zfs-tests.sh deps).
        # Gated on KLDLOAD_BUILD_ZTEST_GOLDENS: 1 during integration
        # testing (verify every pipeline builds end-to-end), 0 for
        # release (users trigger via the UI tile when they want them).
        if [[ "${KLDLOAD_BUILD_ZTEST_GOLDENS:-1}" == "1" ]]; then
            log "[klab] running klab golden-ztest all (test-mode flag ON)"
            if klab golden-ztest all >> /var/log/kldload/klab-firstboot.log 2>&1; then
                mark "klab-ztest"
                log "[klab] ztest goldens complete"
            else
                log "[klab] ztest FAILED — see /var/log/kldload/klab-firstboot.log (non-fatal)"
            fi
        else
            log "[klab] ztest goldens skipped (KLDLOAD_BUILD_ZTEST_GOLDENS=0 — use UI to build)"
        fi
    fi
fi

# ── Phase 4: Wait for backgrounded AI ────────────────────────────────────────
if [[ -n "$AI_PID" ]]; then
    phase "ai-wait"
    wait "$AI_PID" 2>/dev/null || true
fi

# ── Final: overall ready marker ──────────────────────────────────────────────
# All requested phases must have written their marker. Unrequested phases
# count as satisfied. This is what firstboot_status keys off.
_all_ok=1
for sub in k8s ai klab; do
    if [[ "${WANT[$sub]}" == "1" ]] && [[ ! -f "${STATE_DIR}/${sub}-ready" ]]; then
        _all_ok=0
        log "SKIP all-ready: ${sub} requested but no marker"
    fi
done
if [[ $_all_ok -eq 1 ]]; then
    mark "all"
    phase "ready"
    log "══════════════════════════════════════════════════════════════"
    log "  kldload is fully deployed. Everything requested is up."
    log "══════════════════════════════════════════════════════════════"
else
    phase "partial"
    log "autodeploy finished with partial success — see markers in $STATE_DIR"
fi
