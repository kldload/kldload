#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════════════
# kldload-autodeploy — unattended "bring everything up" orchestrator
# ══════════════════════════════════════════════════════════════════════════════
#
# Runs once, after the first boot services have converged. Reads the install
# manifest to see what the user requested (K8s? AI? klab?), then orchestrates
# each subsystem in the right order, writes phase-ready marker files, and
# publishes a final /var/lib/kldload/all-ready flag.
#
# The web UI's firstboot_status endpoint reads these markers to drive the
# Dashboard's Lab Ready banner (green ✅ when everything requested is done).
#
# Ordering rules (enforced by this script):
#   1. The AI phase starts FIRST in the background, but only its cheap part —
#      GPU probe, ollama service, darksite rehydrate. A real multi-GB model
#      DOWNLOAD holds until the k8s phase finishes, because running it
#      alongside kubeadm and the golden builds made boot #1 reboot-cycle
#      (2026-06-15). An air-gapped pull (weights already on disk) does not
#      wait. If AI wasn't requested, skipped.
#   2. Kubernetes bootstrap runs next (foreground) — ~15 min on fresh build,
#      ~5 min if golden cached. Blocks until cluster is Ready or fails, then
#      writes k8s-phase-done, which releases the AI download.
#   3. klab golden-all runs last (foreground) — ~1hr for 5 distros. Takes
#      the longest, so we do it last to not block faster phases.
#   4. AI model gets pre-warmed once its pull completes (24h keepalive).
#   5. all-ready marker written only when every requested phase has its own
#      marker. Skipped phases don't block.
#
# Run status + current phase is written to /var/lib/kldload/current-phase so
# the UI can show "Kubernetes: step 4/9 — kubeadm init" instead of a generic
# spinner.
#
# Idempotent — safe to re-run. Won't redo phases that already have markers.
# Manual trigger: `sudo kldload-autodeploy`
#
# Environment overrides (beyond the install manifest read below):
#   KLDLOAD_AUTODEPLOY_PARALLEL_AI=1 — let the model download run alongside the
#     k8s bootstrap again (the pre-2026-08-11 behaviour). Faster on a host with
#     headroom; it is what made a full-toggle first boot reboot-cycle.
# ══════════════════════════════════════════════════════════════════════════════

set -uo pipefail
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

MANIFEST=/etc/kldload/install-manifest.env
EFFECTIVE=/var/log/installer/effective-config.env
STATE_DIR=/var/lib/kldload
LOG_FILE=/var/log/kldload/autodeploy.log
PHASE_FILE="${STATE_DIR}/current-phase"

mkdir -p "$STATE_DIR" "$(dirname "$LOG_FILE")"
touch "$LOG_FILE"
chmod 644 "$LOG_FILE"

log() { printf '[%(%F %T)T] [autodeploy] %s\n' -1 "$*" | tee -a "$LOG_FILE" >&2; }
# ── Phase state, as DATA ─────────────────────────────────────────────────────
# current-phase alone answers "what is running" but not "how much is left", so
# anything rendering progress could only ever show a spinner and an elapsed
# time. PHASE_DIR gives the whole plan: one file per phase, named NN-<phase>
# so a plain `ls` sorts into run order, each holding "<state> <epoch>".
#
# States: pending | running | done | failed
#
# Read by kldload-build-monitor to draw a checklist. Deliberately files rather
# than one status file: each write is a single atomic create/replace, so a
# reader can never catch a half-written plan, and a crashed phase leaves its
# last honest state behind instead of an empty file.
PHASE_DIR="${STATE_DIR}/phases"

# phase_plan — declare the phases THIS run will execute, in order.
# Call once, after the enable-flags are known, so the plan reflects what is
# actually going to happen rather than everything that could.
phase_plan() {
    local _i=0 _p
    rm -rf "$PHASE_DIR"
    mkdir -p "$PHASE_DIR"
    for _p in "$@"; do
        _i=$((_i + 10))
        printf 'pending 0\n' >"${PHASE_DIR}/$(printf '%02d' "$_i")-${_p}"
    done
    log "plan: $* ($# phases)"
}

# _phase_file — the plan file for a phase name, or empty if not planned.
_phase_file() {
    local _f
    _f="$(compgen -G "${PHASE_DIR}/[0-9][0-9]-$1" 2>/dev/null | head -1)"
    printf '%s' "$_f"
}

# phase_state — set a phase's state explicitly (used for failures).
phase_state() {
    local _f
    _f="$(_phase_file "$1")"
    [[ -n "$_f" ]] && printf '%s %s\n' "$2" "$(date +%s)" >"$_f"
}

phase() {
    local _f _prev
    # Close out whatever was running: reaching a new phase means the previous
    # one finished. A phase that FAILED calls phase_state explicitly first, and
    # this must not overwrite that.
    for _prev in "$PHASE_DIR"/[0-9][0-9]-*; do
        [[ -e "$_prev" ]] || continue
        [[ "$(cut -d' ' -f1 "$_prev" 2>/dev/null)" == "running" ]] &&
            printf 'done %s\n' "$(date +%s)" >"$_prev"
    done
    _f="$(_phase_file "$1")"
    [[ -n "$_f" ]] && printf 'running %s\n' "$(date +%s)" >"$_f"
    printf '%s\n' "$1" >"$PHASE_FILE"
    log "PHASE: $1"
}
mark() {
    touch "${STATE_DIR}/$1-ready"
    log "marker: $1-ready"
}

# ── Power a VM down the moment it is finished with ───────────────────────────
#
# WHY THIS IS NOT LEFT TO THE QUIESCE PASS AT THE END: quiesce_idle_vms() runs
# after every phase, so during the run itself nothing is ever released. The
# ztest phase builds five VMs one at a time over about an hour and each one
# stayed powered on until the whole install finished — stacked on top of the
# eight blue/green clones and the six cluster nodes. Peak memory pressure
# therefore landed in the middle of the LONGEST phase, and the box spent that
# hour starved: the remaining builds ran slower, which made the window during
# which everything was up longer still.
#
# HISTORY: 2026-08-15, .145. 15 VMs running while the installer was only on
# phase 6 of 7. Operator: "you're just killing the system resources, making
# the install slower." Build it, set it up, shut it down — during the install,
# not after it.
#
# Args:    $1 — libvirt domain name.
# Returns: 0 always. Powering a build VM down is a courtesy, never a reason to
#          fail an install that otherwise succeeded.
# Notes:   ACPI shutdown first, and the OUTCOME is then verified — see below.
#
# HISTORY: 2026-08-16, .145. This logged "powering it down" for six VMs and
# klab-green-ubuntu was still running afterwards. The bug was trusting the
# exit code: `virsh shutdown` returns 0 when it has SENT the ACPI request,
# not when the guest has stopped. A guest still booting, or without acpid
# listening, simply ignores it — so the log claimed success while the VM kept
# its RAM, which is the exact starvation this function exists to prevent.
# Verify the outcome, not the exit code.
#
# Args:    $1 — libvirt domain name.
#          $2 — 1 to destroy it if it will not stop gracefully (disposable
#               clones only), 0/absent to leave it running with a warning.
# Returns: 0 always. Powering a build VM down is a courtesy, never a reason to
#          fail an install that otherwise succeeded.
power_off_vm() {
    local _vm="$1" _force="${2:-0}"
    [[ -n "$_vm" ]] || return 0
    command -v virsh >/dev/null 2>&1 || return 0
    virsh domstate "$_vm" 2>/dev/null | grep -q running || return 0
    virsh shutdown "$_vm" >/dev/null 2>&1 ||
        log "[quiesce] WARN: ${_vm} did not accept the shutdown request"
    _await_power_off "$_vm" 90 "$_force"
    return 0
}

# _await_power_off — wait for a guest to actually stop, then say what happened.
#
# Args:    $1 domain, $2 seconds to wait, $3 destroy-on-timeout (1/0).
# Returns: 0 always.
#
# WHY DESTROY IS GATED: a golden image caught mid-write is a corrupt golden,
# and this same helper powers down the ztest goldens. Blue/green sites are
# disposable clones and pass 1; anything that a later phase reads from passes
# 0 and is left running with a warning loud enough to find.
_await_power_off() {
    local _vm="$1" _wait="${2:-90}" _force="${3:-0}" _i
    for ((_i = 0; _i < _wait; _i += 3)); do
        virsh domstate "$_vm" 2>/dev/null | grep -q running || {
            log "[quiesce] ${_vm} is down (virsh start ${_vm} to use it)"
            return 0
        }
        sleep 3
    done
    if [[ "$_force" == "1" ]]; then
        # It had 90 seconds of ACPI and ignored it. This is a clone that
        # exists to be thrown away, and its RAM is needed now.
        virsh destroy "$_vm" >/dev/null 2>&1 &&
            log "[quiesce] ${_vm} ignored ACPI for ${_wait}s — stopped it (disposable clone)" &&
            return 0
    fi
    log "[quiesce] WARN: ${_vm} is STILL RUNNING after ${_wait}s of ACPI — it keeps its RAM"
    return 0
}

# power_off_group — power down every running VM whose name matches a glob.
#
# Args:    $1 — a shell glob, e.g. 'klab-blue-*'
#          $2 — 1 to destroy stragglers (disposable clones), 0/absent not to.
# Returns: 0 always.
#
# The request is sent to EVERY match first, and only then does it wait. Doing
# it one at a time meant up to 90s of waiting per VM — twelve minutes for the
# eight blue/green sites, serially, in the middle of an install.
# _ai_payload_reclaim — free /root/darksite/ollama once it has been consumed.
#
# The payload is 3.3G: the ollama runtime tarball, the Open WebUI OCI image and
# the Whisper weights. All three are one-shot — the runtime is installed, the
# image is loaded into the container store, the weights are rsynced into
# /srv/open-webui. After that the copy under /root is dead weight on every
# installed machine.
#
# WHY HERE AND NOT IN firstboot's _darksite_reclaim: because that is the
# mistake this codebase already made once. Reclaiming there removed the helm
# charts EIGHT MINUTES before autodeploy went looking for them, and an
# air-gapped install pulled 138 images off the internet. The consumer has to be
# the one that frees it, after it has actually consumed it — which is here.
#
# Args: none.  Returns: 0 always — reclaiming disk must never fail a deploy.
_ai_payload_reclaim() {
    [[ -d /root/darksite/ollama ]] || return 0
    if [[ -f /etc/kldload/keep-darksite ]]; then
        log "[ai] LAN-mirror mode: keeping /root/darksite/ollama"
        return 0
    fi
    local _sz
    _sz="$(du -sh /root/darksite/ollama 2>/dev/null | cut -f1)" || _sz="?"
    rm -rf /root/darksite/ollama
    log "[ai] darksite AI payload reclaimed (${_sz}) — runtime installed, interface loaded, weights staged"
    return 0
}

power_off_group() {
    local _glob="$1" _force="${2:-0}" _vm
    local _targets=()
    command -v virsh >/dev/null 2>&1 || return 0
    while read -r _vm; do
        [[ -n "$_vm" ]] || continue
        # shellcheck disable=SC2254  # the glob is the whole point of this call
        case "$_vm" in
        $_glob)
            virsh shutdown "$_vm" >/dev/null 2>&1 || true
            _targets+=("$_vm")
            ;;
        esac
    done < <(virsh list --name --state-running 2>/dev/null)
    for _vm in "${_targets[@]}"; do
        _await_power_off "$_vm" 90 "$_force"
    done
    return 0
}

# ── Load install-time flags ───────────────────────────────────────────────────
# Two files:
#   /etc/kldload/install-manifest.env         — persisted manifest (user-set)
#   /var/log/installer/effective-config.env   — computed by installer
# Manifest is canonical, but K8S_BOOTSTRAP + KLAB_ZFS_DEV may only exist in
# effective-config depending on installer version. Load both; manifest wins
# on conflict.
declare -A WANT=(
    [k8s]=0 [ai]=0 [klab]=0
)
for _src in "$EFFECTIVE" "$MANIFEST"; do
    if [[ -r "$_src" ]]; then
        # shellcheck disable=SC1090
        . "$_src" 2>/dev/null || true
    fi
done

# ── 4-template architecture (1.1.0+) ────────────────────────────────────
# KLDLOAD_TEMPLATE is the tile the user picked — drives autodeploy phases.
# (KLDLOAD_PROFILE is the package set; all four workload tiles share the
# kvm package set, so KLDLOAD_PROFILE alone can't distinguish them. The UI
# emits KLDLOAD_TEMPLATE in addition for tile-level dispatch.)
#
#   kvm    — libvirt + ZFS + OS lean goldens (5 distros). NO K8s.
#   k8s    — lean K8s (1 CP + 3 workers locked) + full obs stack. NO goldens.
#   klab   — kvm + K8s (1 CP + 0 workers, scalable post-install) + obs.
#            "Everything sandbox" — all goldens except ZFS-test variant.
#   zfslab — K8s (1 CP + 0 workers, fixed) + obs + ZFS-test goldens.
#            No OS lean goldens (host budget for ZFS test runs).
#
# Legacy compat: devops + ai TEMPLATE values map to klab. Pre-1.1.0 installs
# only have KLDLOAD_PROFILE + the ENABLE_* / *_MODE flags; we infer the
# template from those when KLDLOAD_TEMPLATE is unset.
TEMPLATE="${KLDLOAD_TEMPLATE:-}"
if [[ -z "$TEMPLATE" ]]; then
    # Legacy fall-back: reconstruct the template from the old env-var
    # combination so an existing 1.0.x install upgrading in place still
    # gets the right phases on the next autodeploy run.
    if [[ "${KLDLOAD_ZFSLAB_MODE:-0}" == "1" || "${KLDLOAD_KLAB_ZFS_DEV:-0}" == "1" ]]; then
        TEMPLATE="zfslab"
    elif [[ "${KLDLOAD_ENABLE_K8S:-0}" == "1" || "${KLDLOAD_K8S_BOOTSTRAP:-0}" == "1" ]]; then
        TEMPLATE="k8s"
    elif [[ "${KLDLOAD_PROFILE:-}" == "kvm" ]]; then
        TEMPLATE="kvm"
    fi
fi

case "$TEMPLATE" in
k8s | klab | zfslab | devops | ai) WANT[k8s]=1 ;;
esac
case "$TEMPLATE" in
kvm | klab | zfslab | devops | ai) WANT[klab]=1 ;;
esac

# Explicit env-var overrides (still honored for kickstart / smoke-test flows)
[[ "${KLDLOAD_ENABLE_AI:-0}" == "1" ]] && WANT[ai]=1
# Honor the explicit cluster/lab toggles even when a template IS set. The
# template case above only matches k8s/klab/zfslab/devops/ai, so a 'desktop'
# install that ticked the Kubernetes or klab tiles previously had its
# K8S_BOOTSTRAP/KLAB flags silently ignored — the "K8s never came up on a
# desktop install" gap (.147, 2026-06-02).
[[ "${KLDLOAD_K8S_BOOTSTRAP:-0}" == "1" ]] && WANT[k8s]=1
[[ "${KLDLOAD_KLAB_ZFS_DEV:-0}" == "1" ]] && WANT[klab]=1
# Webui "Build all images" tile sets KLDLOAD_BUILD_IMAGES=1 in the install
# manifest — operator on .137 b628 reported "I checked off build all images
# in the gui when i installed.. my assumption was that that checkbox would
# have indicated these images should have been built automatically on
# install" but autodeploy ignored it because only KLAB_ZFS_DEV / template
# triggered the klab phase. Manifest flag now maps to WANT[klab]=1 directly.
[[ "${KLDLOAD_BUILD_IMAGES:-0}" == "1" ]] && WANT[klab]=1
[[ "${KLDLOAD_KLAB_NO_AUTO:-0}" == "1" ]] && WANT[klab]=0

# K8s cluster sizing — klab and k8s templates both land with a fully
# bootstrapped 4-node cluster (1 CP + 3 workers). zfslab stays at 0
# workers so the host budget goes to ZFS test VMs instead of empty
# K8s nodes. Override via KLDLOAD_K8S_WORKERS.
# Caught 2026-05-17 on .142 — klab landed with 0 workers because the
# prior default was conservative; user expected the full cluster.
case "$TEMPLATE" in
k8s | klab | devops | ai) K8S_WORKERS_DEFAULT=3 ;;
zfslab) K8S_WORKERS_DEFAULT=0 ;; # intentional — budget for ZFS test VMs
*)
    # desktop/other: a lone control plane isn't a useful cluster. If the
    # operator explicitly ticked the Kubernetes tile (K8S_BOOTSTRAP=1), give
    # them the full 3-worker cluster like the k8s template — otherwise 0
    # (no bootstrap was requested anyway). .147 2026-06-03 came up CP-only.
    [[ "${KLDLOAD_K8S_BOOTSTRAP:-0}" == "1" ]] && K8S_WORKERS_DEFAULT=3 || K8S_WORKERS_DEFAULT=0
    ;;
esac
K8S_WORKERS="${KLDLOAD_K8S_WORKERS:-$K8S_WORKERS_DEFAULT}"

# klab golden flavor — zfslab template builds ZFS-test goldens (with
# zfs-tests.sh + ksh + vdev images); everything else builds lean OS
# goldens. KLAB_GOLDEN_KIND used by phase 3 below to pick the right
# subcommand and skip the irrelevant lineage.
KLAB_GOLDEN_KIND="lean"
if [[ "$TEMPLATE" == "zfslab" ||
    "${KLDLOAD_KLAB_ZFS_DEV:-0}" == "1" ||
    "${KLDLOAD_ZFSLAB_MODE:-0}" == "1" ]]; then
    KLAB_GOLDEN_KIND="ztest"
fi

log "Template: ${TEMPLATE:-<none>} → k8s=${WANT[k8s]}(workers=${K8S_WORKERS}) ai=${WANT[ai]} klab=${WANT[klab]}(${KLAB_GOLDEN_KIND})"

# Early-out if nothing was requested — avoids a green "ready" banner on a
# plain install that didn't ask for any of these. The ConditionPathExists
# in the unit prevents re-firing; create the marker with a distinct name.
if [[ "${WANT[k8s]}${WANT[ai]}${WANT[klab]}" == "000" ]]; then
    phase "nothing-requested"
    touch "${STATE_DIR}/autodeploy-skipped"
    log "No extended services requested in install manifest — nothing to do."
    exit 0
fi

# ── Declare the plan ──────────────────────────────────────────────────────────
# Built from the WANT flags so it lists only what this run will actually do —
# a plan promising a cluster on a box that never asked for one is worse than no
# plan at all. Kept in the same order the phases execute below; if you add a
# phase() call, add it here or the checklist silently under-reports.
# ORDER MATTERS. Kubernetes and a usable Bob come BEFORE golden images:
# goldens are the longest phase on the box (≈1 hr for 5 distros) and nothing
# depends on them, whereas the operator wants kubectl and Ollama answering as
# early as possible. Building images first meant the AI model download — which
# is deliberately held until k8s finishes so boot #1 does not thrash — only
# started after an hour of golden builds.
# Operator decision 2026-08-14: "I want ollama up and running along with
# kubernetes before images are built".
_plan=(prereqs)
[[ "${WANT[ai]}" == "1" ]] && _plan+=(ai-pull-kicking)
[[ "${WANT[k8s]}" == "1" ]] && _plan+=(k8s-bootstrap)
[[ "${WANT[ai]}" == "1" ]] && _plan+=(ai-wait)
[[ "${WANT[klab]}" == "1" ]] && _plan+=(klab-goldens)
# Desktop goldens are planned only when they will actually run, for the same
# reason the ztest phase is: a phase in the plan that never fires leaves the
# progress bar permanently short of its own total, which reads as a stall.
[[ "${WANT[klab]}" == "1" && "${KLDLOAD_BUILD_IMAGES:-0}" == "1" ]] &&
    _plan+=(klab-desktop-goldens)
# The ztest phase is PLANNED only when it will actually run. A phase in the
# plan that never runs leaves the progress bar permanently short of its own
# total, which reads as a stalled install.
if [[ "${WANT[klab]}" == "1" ]] &&
    { [[ "${KLAB_GOLDEN_KIND:-}" == "ztest" ]] ||
        [[ "${KLDLOAD_BUILD_ZTEST_GOLDENS:-0}" == "1" ]]; }; then
    _plan+=(klab-ztest-goldens)
fi
_plan+=(ready)
phase_plan "${_plan[@]}"

# ── Phase 0: Prereqs ──────────────────────────────────────────────────────────
phase "prereqs"
# Wait up to 5 min for network-online (first boot can race here)
for i in $(seq 1 60); do
    getent hosts cloud.centos.org >/dev/null 2>&1 && break
    sleep 5
done
# Ensure kldload web UI is up so the UI can watch progress
systemctl is-active kldload-webui >/dev/null 2>&1 || systemctl start kldload-webui 2>/dev/null || true

# kube-cluster + klab both invoke ansible-playbook for the VM provisioning
# path (replaces cloud-init runcmd). If the installer didn't install
# ansible-core (e.g. darksite missed it), install it now so downstream
# phases don't bail with "ansible-playbook not installed".
if ! command -v ansible-playbook >/dev/null 2>&1; then
    log "[prereqs] ansible-playbook missing — installing ansible-core"
    if command -v dnf >/dev/null 2>&1; then
        dnf install -y ansible-core >>"$LOG_FILE" 2>&1 || log "[prereqs] ansible-core install failed — K8s phase may fail"
    elif command -v apt-get >/dev/null 2>&1; then
        apt-get install -y ansible-core >>"$LOG_FILE" 2>&1 || log "[prereqs] ansible-core install failed"
    fi
fi

# ── Phase 1: AI model pull (background) ───────────────────────────────────────
# Runs in the background so it overlaps with K8s/klab. Model weights pull is
# bandwidth-bound; the rest of the work is CPU/disk-bound. Worst case they
# contend a little, but overall wall-clock is shorter with parallel.
AI_PID=""
if [[ "${WANT[ai]}" == "1" ]]; then
    phase "ai-pull-kicking"
    (
        # ERR trap before set -e: without this the subshell exits on the
        # first non-zero command and the parent never knows which line.
        # Symptom seen 2026-05-05 on .109: autodeploy log had only
        # "[ai] pull running as pid X (backgrounded)" and then silence —
        # ai-pull subshell died somewhere with no trace. The trap names
        # the failing LINENO + BASH_COMMAND so we can fix the next one.
        set -E
        trap 'log "[ai] FAILED at line ${LINENO}: ${BASH_COMMAND} (exit $?)"; mark "ai-failed"; exit 1' ERR
        set -e
        # Ollama CLI panics with "$HOME is not defined" when systemd execs
        # us without a login environment (which is always). Every ollama
        # invocation below needs HOME set so envconfig.Models() can find
        # the model store. Must come BEFORE any `ollama` call.
        export HOME="${HOME:-/root}"
        export OLLAMA_MODELS="${OLLAMA_MODELS:-/srv/ollama/models}"
        # Chat model resolution (in priority order):
        #   1. KLDLOAD_AI_MODEL — direct model-name override (kickstart, custom)
        #   2. KLDLOAD_BOB_MODEL — tier name from the Bob panel radio.
        #      Default is qwen3:14b (~9 GB, fits 10 GB VRAM consumer GPUs
        #      such as RTX 3080 / 3060 12G / 4070 / A4000). Larger spills
        #      to qwen3:30b-a3b (MoE, 22+ GB VRAM or CPU spill).
        #      All other models: post-install via `ollama pull <name>`.
        #   3. Legacy tier names (mini/small/code/massive) are aliased to
        #      the default for safety. To use them, set KLDLOAD_AI_MODEL
        #      directly to the exact ollama model string.
        _chat_model="${KLDLOAD_AI_MODEL:-}"
        if [[ -z "$_chat_model" ]]; then
            case "${KLDLOAD_BOB_MODEL:-recommended}" in
            recommended) _chat_model="qwen3:14b" ;;
            large) _chat_model="qwen3:30b-a3b" ;;
            *) _chat_model="qwen3:14b" ;;
            esac
        fi

        # ── A model already on this machine ALWAYS beats a download ──────────
        #
        # The tier above picks by VRAM alone, which ignores what is already
        # here. Two ways that goes wrong, both seen on fiend 2026-08-14:
        #
        #   1. The ISO ships a model in the darksite, but the VRAM tier asks
        #      for a DIFFERENT one. The darksite check below then reports MISS
        #      and pulls ~9 GB over the network — on a machine that already had
        #      working weights on disk. The offline model was never usable
        #      because nothing compared it to what was wanted.
        #   2. A re-run (or a reinstall over an existing /srv/ollama) already
        #      has weights pulled, and this pulls them again.
        #
        # So: if ollama already serves a model, or the darksite carries one,
        # take it. An explicit KLDLOAD_AI_MODEL is still honoured above — this
        # only overrides the automatic tier choice, never an operator's request.
        # The embedding model is NOT a chat model. nomic-embed-text ships
        # alongside the chat weights in every darksite (RAG needs it), but it
        # cannot answer a prompt — pointing Bob at it yields errors on every
        # message. Both discovery paths below therefore skip it.
        #
        # WHY THIS IS LOAD-BEARING: (b) takes whatever `find` returns first,
        # which is arbitrary directory order. While the darksite carried three
        # models the chat one happened to come back first and this was latent.
        # The darksite now ships exactly two manifests — one chat, one embed —
        # so without this filter it is a coin flip whether an air-gapped
        # install configures Bob with a model that cannot talk (2026-08-15).
        # kldload-firstboot has always filtered it; this is the same guard.
        _embed_model="nomic-embed-text"
        if [[ -z "${KLDLOAD_AI_MODEL:-}" ]]; then
            _have_model=""
            # (a) already pulled — ollama is authoritative about its own store
            if command -v ollama >/dev/null 2>&1; then
                _have_model="$(ollama list 2>/dev/null |
                    awk -v skip="^${_embed_model}" 'NR>1 && $1 != "" && $1 !~ skip {print $1; exit}')"
            fi
            # (b) not pulled, but shipped in the darksite: take the first
            #     CHAT manifest present rather than demanding one specific name.
            if [[ -z "$_have_model" && -d /root/darksite/ollama/models/manifests/registry.ollama.ai/library ]]; then
                _have_model="$(
                    find /root/darksite/ollama/models/manifests/registry.ollama.ai/library \
                        -mindepth 2 -maxdepth 2 -type f 2>/dev/null |
                        grep -v "/${_embed_model}/" |
                        head -1 |
                        awk -F/ '{printf "%s:%s", $(NF - 1), $NF}'
                )"
            fi
            if [[ -n "$_have_model" && "$_have_model" != "$_chat_model" ]]; then
                log "[ai] using the model already present (${_have_model}) instead of pulling ${_chat_model}"
                log "[ai] to force a different one: KLDLOAD_AI_MODEL=<model> kldload-autodeploy"
                _chat_model="$_have_model"
            elif [[ -n "$_have_model" ]]; then
                log "[ai] ${_chat_model} is already present — no download needed"
            fi
        fi
        # VRAM probe. Try nvidia-smi (dedicated NVIDIA GPU), fall back to
        # rocminfo (AMD), then DRM sysfs (Intel Arc / fallback). 0 GB means
        # no GPU or an unrecognisable one → Bob is CPU-bound.
        # Wrap in `set +e` because nvidia-smi/rocminfo legitimately exit
        # non-zero on hosts without their respective GPU. Without this the
        # ERR trap above marks the entire AI subshell as failed when there's
        # just no GPU to probe — bug seen 2026-05-05 on .113 (no GPU box).
        _vram_gb=0
        # Disable the ERR trap during the probe. `set +e` alone isn't enough
        # under `set -E` (errtrace) — the ERR trap inherits into command
        # substitutions and subshells, so a failing pipe stage inside
        # $(nvidia-smi | sort | tail) fires the trap even when errexit is off
        # in the parent. Caught 2026-05-13 on .109 F44 zfslab install:
        # nvidia-smi didn't exist yet at firstboot (akmod-nvidia takes
        # ~30-90 sec to build), the pipe failed, ERR trap marked
        # ai-failed-ready, the AI phase gave up — even though the GPU was
        # fully functional 90 seconds later. The fix is two-part:
        #   1. Save + disable the ERR trap during probe (so transient
        #      failures don't kill the AI install).
        #   2. Wait for nvidia-smi to become available if NVIDIA hardware
        #      is present per lspci. Bounded wait, up to 3 minutes.
        # NOTE: bare assignment, NOT `local`. The AI phase runs in a
        # subshell (backgrounded), not a function — `local` errors out
        # with exit 1 outside a function. Caught 2026-05-14 on .111 when
        # this fix shipped and immediately produced the same ai-failed-ready
        # marker it was supposed to prevent.
        _saved_err_trap=$(trap -p ERR 2>/dev/null)
        trap - ERR
        set +e
        if lspci 2>/dev/null | grep -qi nvidia; then
            log "[ai] NVIDIA hardware detected — waiting up to 3 min for nvidia-smi (akmod-nvidia build)"
            for _i in $(seq 1 36); do
                command -v nvidia-smi >/dev/null 2>&1 &&
                    nvidia-smi -L 2>/dev/null | grep -q GPU && break
                sleep 5
            done
            if command -v nvidia-smi >/dev/null 2>&1; then
                log "[ai] nvidia-smi available after ${_i} probes (~$((_i * 5))s)"
            else
                log "[ai] WARN: nvidia-smi never appeared — akmod-nvidia may have failed; treating as no-GPU"
            fi
        fi
        if command -v nvidia-smi >/dev/null 2>&1; then
            # Retry memory.total until it returns a positive number (up to ~30s).
            # Right after the akmod loads, `nvidia-smi -L` already lists the card
            # but `--query-gpu=memory.total` can transiently return 0 or a
            # NON-numeric NVML error (init/driver-library still settling) — on
            # fiend 2026-07-27 that momentary 0 made autodeploy skip Bob on a
            # multi-GB card and mark it PERMANENTLY (ai-skipped is terminal).
            # Also: a non-numeric bareword ("NVIDIA-SMI…") fed to $(( )) is an
            # unbound var under `set -u` → kills the whole AI subshell; force
            # numeric-or-zero. Caught 2026-07-26 on fiend.
            _vram_raw=0
            for _q in $(seq 1 15); do
                _vram_raw=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | sort -n | tail -1)
                [[ "${_vram_raw}" =~ ^[0-9]+$ ]] && [[ "${_vram_raw}" -gt 0 ]] && break
                sleep 2
            done
            [[ "${_vram_raw}" =~ ^[0-9]+$ ]] || _vram_raw=0
            _vram_gb=$((_vram_raw / 1024))
            # NVIDIA hardware present but VRAM still unreadable after the retries:
            # the driver almost certainly needs a clean reboot to finish loading
            # (nouveau is blacklisted via the ZBM cmdline; the akmod built THIS
            # boot but a reboot loads it cleanly). Don't lie about "insufficient
            # VRAM" — tell the operator the real remediation. Bob is still
            # skipped this boot rather than wedging on a pull the GPU can't serve.
            if [[ "$_vram_gb" -eq 0 ]] && lspci 2>/dev/null | grep -qi nvidia; then
                log "[ai] WARN: NVIDIA GPU present but VRAM reads 0 after ~30s — driver not fully initialised yet (akmod built this boot; a reboot loads it). After reboot, install Bob with: sudo kldload-autodeploy   (or KLDLOAD_FORCE_AI=1 for CPU inference)."
            fi
        elif command -v rocminfo >/dev/null 2>&1; then
            # rocminfo prints bytes; take the largest local memory pool.
            _bytes=$(rocminfo 2>/dev/null | awk '/Size:.*\(.*\)/ {gsub(/[^0-9]/,"",$2); if ($2+0 > max) max=$2+0} END {print max+0}')
            _vram_gb=$((_bytes / 1024 / 1024 / 1024))
        fi
        set -e
        # Restore ERR trap (only if we actually had one saved — fresh shells
        # without an ERR trap return empty from `trap -p ERR`).
        [[ -n "$_saved_err_trap" ]] && eval "$_saved_err_trap"
        # NOTE: the VRAM gate used to live HERE, in front of everything. It has
        # moved below, to immediately before the model download — the only step
        # it was ever really about. See "VRAM gate" further down.
        log "[ai] VRAM=${_vram_gb}GB → candidate chat model: ${_chat_model}"
        # Darksite-vs-internet branch. KLDLOAD_BOB_DARKSITE=1 comes from the
        # Bob panel "use darksite" checkbox. We still need the ollama binary
        # itself — darksite only ships model weights, not the runtime — so
        # the install.sh path runs either way. But if the darksite has the
        # selected model's manifest, rehydrate /srv/ollama/models/ BEFORE
        # starting ollama. The subsequent `ollama pull` then hash-matches
        # every blob and is a no-op — no internet touched for weights.
        # Detection is UNCONDITIONAL. It used to be gated on
        # KLDLOAD_BOB_DARKSITE=1 — that is, on the operator having found and
        # ticked an "Airgapped (darksite)" box in the Bob panel — so an ISO
        # built with KLDLOAD_INCLUDE_OLLAMA_DARKSITE=1, carrying 5.4 GB of
        # weights, ignored them unless asked twice. The operator either waited
        # on an internet pull they had already paid for in ISO size, or landed
        # on a working Ollama with an empty model list.
        #
        # If the weights are on the disk, use them. Asking a human to confirm
        # something the filesystem can answer is what produced the bug.
        _bob_darksite="${KLDLOAD_BOB_DARKSITE:-0}"
        _darksite_has_model=0
        _model_name="${_chat_model%%:*}"
        _model_tag="${_chat_model##*:}"
        if [[ -d /root/darksite/ollama/models ]] &&
            compgen -G "/root/darksite/ollama/models/manifests/registry.ollama.ai/library/${_model_name}/${_model_tag}" >/dev/null; then
            _darksite_has_model=1
            log "[ai] darksite HIT: ${_chat_model} weights present under /root/darksite/ollama/"
        elif [[ "$_bob_darksite" == "1" ]]; then
            # Only an ERROR when air-gapped was explicitly requested: that
            # operator has no fallback and needs to know before the reboot.
            log "[ai] darksite MISS: ${_chat_model} not in /root/darksite/ollama/models/"
            log "[ai] air-gapped install was requested but the weights are absent —"
            log "[ai] build with KLDLOAD_INCLUDE_OLLAMA_DARKSITE=1, or stage them"
            log "[ai] under /root/darksite/ollama/models/ before first boot."
        else
            log "[ai] no darksite weights for ${_chat_model} — will pull if requested"
        fi
        log "[ai] installing ollama runtime"
        command -v ollama >/dev/null 2>&1 ||
            curl -fsSL https://ollama.com/install.sh | sh >>"$LOG_FILE" 2>&1
        # ZFS-backed model store: pre-create /srv/ollama/models with the
        # right ownership BEFORE ollama starts. The systemd override (see
        # kldload-firstboot) sets OLLAMA_MODELS=/srv/ollama/models, and
        # the ollama service runs as the unprivileged 'ollama' user — if
        # the directory doesn't exist, ollama.service hits
        # "Error: mkdir /srv/ollama: permission denied" and crashloops.
        # Operator on .142 b641: ollama silently used the default
        # ~/.ollama/models on first boot (because the override hadn't kicked
        # in yet), then a later restart picked up the override and crashed
        # — Bob looked alive until anything bounced ollama.
        # ALWAYS create + chown, independent of whether darksite weights
        # are being rehydrated below.
        mkdir -p /srv/ollama/models
        chown -R ollama:ollama /srv/ollama 2>/dev/null || true
        # Rehydrate from darksite BEFORE first ollama start so the models
        # are already visible in /api/tags when serve comes up.
        if [[ "$_darksite_has_model" == "1" ]]; then
            log "[ai] rehydrating /srv/ollama/models/ from darksite (air-gap path)"
            rsync -a /root/darksite/ollama/models/ /srv/ollama/models/ >>"$LOG_FILE" 2>&1 &&
                log "[ai] darksite rehydrate ok" ||
                log "[ai] WARNING: darksite rehydrate failed — ollama pull will need internet"
            chown -R ollama:ollama /srv/ollama 2>/dev/null || true
        fi
        systemctl enable --now ollama 2>/dev/null || true
        for _ in $(seq 1 30); do
            curl -sf http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && break
            sleep 2
        done
        # ── The interface, BEFORE any model work ────────────────────────────
        #
        # Open WebUI is a frontend. It needs no model, no VRAM and no GPU: it
        # starts with an empty model list and offers a picker. So it is stood up
        # here — as soon as the engine answers — and nothing below can prevent
        # it.
        #
        # WHY THE ORDER IS THE FIX: this used to run at the very END of the
        # phase, behind two `exit 0`s — the VRAM gate and a failed model pull.
        # The machines that took either exit got no interface at all, which is
        # backwards: a box with no GPU, or one whose download failed, is exactly
        # the box whose owner needs a working UI to choose and fetch a model
        # from. As of 2026-08-15 no weights ship by default
        # (KLDLOAD_INCLUDE_OLLAMA_DARKSITE=0), so the old order would have made
        # "no model" mean "no AI stack whatsoever" on every default install.
        #
        # HISTORY: 2026-08-15, .145. The call was made once, its non-zero return
        # treated as advisory, one WARN logged, and the phase marked complete.
        # The script exited non-zero having written NOTHING — not to its own log,
        # not to this one — though every exit path in it is `exit 0`. The desktop
        # reported AI as installed while the tile opened http://ollama:8080/ and
        # found nothing listening. Running the same script by hand afterwards
        # worked first time. That signature — instant, silent, unreproducible —
        # is a transient, and a transient nothing retries is a permanent failure
        # to the person looking at the screen. Hence: verify the OUTCOME (does
        # :8080 answer) rather than the exit code, and retry once.
        _owui_ok=0
        if [[ -x /usr/local/bin/kldload-ai-webui ]]; then
            for _try in 1 2; do
                log "[ai] setting up Open WebUI (attempt ${_try})"
                /usr/local/bin/kldload-ai-webui >>"$LOG_FILE" 2>&1 ||
                    log "[ai] WARN: kldload-ai-webui returned non-zero on attempt ${_try}"
                if curl -sf -o /dev/null --max-time 5 http://localhost:8080 2>/dev/null; then
                    _owui_ok=1
                    break
                fi
                log "[ai] :8080 not answering after attempt ${_try}"
                sleep 5
            done
        else
            log "[ai] WARN: kldload-ai-webui missing — the Ollama tile will have no interface"
        fi
        if [[ "$_owui_ok" -eq 1 ]]; then
            log "[ai] Open WebUI verified answering on :8080"
        else
            log "[ai] WARN: Open WebUI is NOT answering on :8080 — the desktop tile will fail."
            log "[ai]       The Ollama engine and CLI still work. Repair with: sudo kldload-ai-webui"
        fi

        # ── Is a model wanted at all? ───────────────────────────────────────
        #
        # Default: NO. The AI checkbox means "install Ollama + Open WebUI",
        # which is now done — engine running, interface answering, empty model
        # list. WHICH model to run is a question the operator is better placed
        # to answer than the ISO is, and a multi-GB download nobody asked for is
        # a poor default on a metered or slow link.
        #
        # Three ways a machine ends up with weights:
        #   1. baked into the ISO at build time
        #      (KLDLOAD_INCLUDE_OLLAMA_DARKSITE=1) — the air-gapped path;
        #      _darksite_has_model is already 1 here and the rehydrate above
        #      has run, so there is nothing to download;
        #   2. the installer's "download an AI model" checkbox
        #      (KLDLOAD_AI_PULL_MODEL=1) — pull it during first boot;
        #   3. the operator, later, from the Open WebUI picker or `ollama pull`.
        #
        # Case 3 is the default and it costs nothing: the picker is right there
        # in a working UI.
        if [[ "$_darksite_has_model" != "1" && "${KLDLOAD_AI_PULL_MODEL:-0}" != "1" ]]; then
            log "[ai] no model requested — Ollama and Open WebUI are installed and running with an empty model list."
            log "[ai] Pull one from the Open WebUI model picker, or run: ollama pull llama3.2:3b"
            log "[ai] To have the installer do it, tick 'Download an AI model' (KLDLOAD_AI_PULL_MODEL=1);"
            log "[ai] for an air-gapped machine, build the ISO with KLDLOAD_INCLUDE_OLLAMA_DARKSITE=1."
            mark "ai"
            _ai_payload_reclaim
            log "[ai] complete (engine + interface, no model)"
            exit 0
        fi

        # ── VRAM gate — governs the DOWNLOAD only ───────────────────────────
        #
        # Below 8 GB a 14b-class model will not load and CPU fallback is ~30
        # tok/min, so pulling several GB for it wastes the operator's bandwidth
        # and disk. Skip the download — but the engine and the interface are
        # already up by this point, so "skipped" now means "no model yet",
        # not "no AI". The operator can pull a small model from the Open WebUI
        # picker, and on CPU a 3b one is perfectly usable.
        # Override with KLDLOAD_FORCE_AI=1 to pull regardless.
        _min_vram_gb="${KLDLOAD_MIN_AI_VRAM_GB:-8}"
        if [[ "$_vram_gb" -lt "$_min_vram_gb" && "${KLDLOAD_FORCE_AI:-0}" != "1" ]]; then
            log "[ai] no model will be downloaded — ${_vram_gb}GB VRAM is below the ${_min_vram_gb}GB minimum for ${_chat_model}."
            log "[ai] Ollama and Open WebUI ARE installed and running; pull a model you can run from the picker,"
            log "[ai] e.g. 'ollama pull llama3.2:3b' (runs on CPU), or force this one with KLDLOAD_FORCE_AI=1."
            mark "ai-skipped"
            exit 0
        fi

        # ── Hold the download until the cluster is up ────────────────────────
        # WHY: on a fresh install with ENABLE_K8S + K8S_BOOTSTRAP + BUILD_IMAGES
        # + ENABLE_AI all set, boot #1 ran kubeadm/Cilium, the klab golden
        # builds AND a 9.3 GB model pull at once. The box went unreachable for
        # long stretches and reboot-cycled — too unstable to even ssh in
        # (HISTORY: 10.100.10.123, 2026-06-15). The old comment above claimed
        # the pull is bandwidth-bound so overlap is free; on a box that is also
        # cloning VMs and writing them to ZFS, it is not.
        #
        # Only the real download waits. An air-gapped install (darksite carries
        # the weights) does a local hash check, costs nothing, and proceeds —
        # which is the common kldload case, so Bob is ready as early as ever
        # there. Cap the wait at 30 min so a wedged bootstrap cannot strand
        # Bob; KLDLOAD_AUTODEPLOY_PARALLEL_AI=1 restores the old overlap.
        if [[ "${WANT[k8s]}" == "1" && "$_darksite_has_model" != "1" &&
            "${KLDLOAD_AUTODEPLOY_PARALLEL_AI:-0}" != "1" ]]; then
            log "[ai] holding the ${_chat_model} download until the k8s phase finishes (KLDLOAD_AUTODEPLOY_PARALLEL_AI=1 to overlap)"
            for _ in $(seq 1 360); do
                # `if`, not `[[ … ]] && break`: a false test as the loop's last
                # command makes the whole `for` return 1, which `set -e` in this
                # subshell would turn into a silent AI phase death.
                if [[ -f "${STATE_DIR}/k8s-phase-done" ]]; then
                    break
                fi
                sleep 5
            done
            if [[ -f "${STATE_DIR}/k8s-phase-done" ]]; then
                log "[ai] k8s phase finished — starting the download"
            else
                log "[ai] WARNING: k8s phase still running after 30 min — starting the download anyway"
            fi
        fi
        # Pull with retry + verification. `ollama pull` can silently exit 0 on
        # transient network issues, leaving no model loaded. Check /api/tags
        # afterward; retry up to 3 times if the model didn't land. Without this,
        # the ai-ready marker gets set on a Bob that has no model, and the chat
        # tab opens to an empty model dropdown.
        _pull_ok=0
        for _try in 1 2 3; do
            ollama pull "${_chat_model}" >>"$LOG_FILE" 2>&1 || true
            if curl -sf http://127.0.0.1:11434/api/tags 2>/dev/null | grep -q "\"name\":\"${_chat_model}\""; then
                _pull_ok=1
                log "[ai] model ${_chat_model} confirmed loaded (try ${_try})"
                break
            fi
            log "[ai] model ${_chat_model} not in /api/tags after pull — retrying (try ${_try}/3)"
            sleep 10
        done
        if [[ "$_pull_ok" != "1" ]]; then
            log "[ai] FAILED to pull ${_chat_model} after 3 tries — Bob will have no model. Check network + /srv/ollama/models/. Marking ai-failed."
            mark "ai-failed"
            exit 0
        fi
        # Create the 'bob' model alias from /etc/bob/Modelfile.bob — bob-agent
        # defaults to BOB_MODEL=bob, so without this `bob` CLI fails with
        # "Can't reach Ollama" (misleading; it's actually "model not found").
        # The Modelfile.bob (shipped in includes.chroot/etc/bob/) wires the
        # kldload-operator system prompt to the just-pulled base model, so
        # Bob behaves as a kldload operator (drives the tmux cockpit, knows
        # the ops tool catalog) rather than generic chat. Operator on .142:
        # "Can't reach Ollama" was this missing step.
        if [[ -f /etc/bob/Modelfile.bob ]] && ! curl -sf http://127.0.0.1:11434/api/tags 2>/dev/null | grep -q '"name":"bob:'; then
            log "[ai] creating 'bob' model from /etc/bob/Modelfile.bob..."
            if ollama create bob -f /etc/bob/Modelfile.bob >>"$LOG_FILE" 2>&1; then
                log "[ai] bob model created and ready"
            else
                log "[ai] WARNING: bob model creation failed — bob-agent will fall back to BOB_MODEL=${_chat_model} or fail with 'Can't reach Ollama'. Inspect with: ollama list ; cat /etc/bob/Modelfile.bob"
            fi
        elif curl -sf http://127.0.0.1:11434/api/tags 2>/dev/null | grep -q '"name":"bob:'; then
            log "[ai] bob model already present — skipping create"
        else
            log "[ai] WARNING: /etc/bob/Modelfile.bob missing — bob-agent will fall back to base model"
        fi
        # Pre-warm bob into VRAM so the webui's Bob nav item is visible from
        # first paint. ai_ollama in kldload-webui's /status response gates the
        # sidebar Bob entry on /api/ps (resident-in-VRAM models). Without a
        # warm model, Bob is silently hidden — operator on .142 b641: "i
        # dont see bob in the ui is this still failing". keep_alive=-1 +
        # OLLAMA_KEEP_ALIVE=-1 (systemd override) → pinned forever. Cost ~9
        # GB VRAM, gain instant Bob + visible nav item. Fire-and-forget so
        # autodeploy doesn't block 30-60s on the load.
        log "[ai] pre-warming bob into VRAM (background; takes ~30-60s on first load)..."
        (curl -sS -m 180 -o /dev/null -X POST http://127.0.0.1:11434/api/generate \
            -d '{"model":"bob","prompt":"warm","stream":false,"keep_alive":-1}' \
            >>"$LOG_FILE" 2>&1 &&
            log "[ai] bob warmed — resident in VRAM" ||
            log "[ai] WARNING: bob warm-up did not complete in 180s — first user message will pay the cold-start tax") &
        # Vision model (llama3.2-vision:11b) is NO LONGER auto-pulled — it's
        # 6 GB of weights and ~8 GB of VRAM for a capability used on <5% of
        # Bob sessions (pasted screenshots of non-text images). Text models
        # plus tesseract OCR cover screenshots-of-logs/errors in 30 MB, and
        # the user can opt in to the vision model via the Bob panel
        # ("Install vision model") if they really want photo analysis.
        # Gate with KLDLOAD_PULL_VISION_MODEL=1 if you need it from autodeploy.
        if [[ "${KLDLOAD_PULL_VISION_MODEL:-0}" == "1" ]]; then
            _ram_gb=$(awk '/MemTotal/ {printf "%d", $2/1024/1024}' /proc/meminfo)
            if [[ $_vram_gb -ge 10 ]] && [[ $_ram_gb -ge 16 ]]; then
                log "[ai] KLDLOAD_PULL_VISION_MODEL=1 — pulling llama3.2-vision:11b"
                ollama pull llama3.2-vision:11b >>"$LOG_FILE" 2>&1 ||
                    log "[ai] vision pull failed — non-fatal"
            fi
        else
            log "[ai] vision model skipped (opt in via Bob panel or set KLDLOAD_PULL_VISION_MODEL=1)"
        fi
        # Warm (keepalive 24h so first chat is instant)
        curl -sf -X POST http://127.0.0.1:11434/api/generate \
            -d "{\"model\":\"${_chat_model}\",\"prompt\":\"ok\",\"stream\":false,\"keep_alive\":\"24h\"}" \
            >/dev/null 2>&1 || true
        # The engine is up; now put an interface in front of it.
        #
        # HISTORY: 2026-08-13. autodeploy installed Ollama and stopped there,
        # while the desktop tile opened http://ollama:8080/ and reported "site
        # not found". The Open WebUI setup existed only inside
        # kldload-firstboot's AI block — the block autodeploy's own presence
        # causes firstboot to skip. Shared script, called from both, so the two
        # paths cannot disagree about whether the AI stack has a UI.
        mark "ai"
        # Same reclaim as the no-model path: by here the runtime is installed,
        # the interface is loaded and any darksite weights have been rsynced
        # into /srv/ollama, so the copy under /root is spent.
        _ai_payload_reclaim
        log "[ai] complete"
        # kldload-rag-firstboot.service is WantedBy=multi-user.target but its
        # ConditionPathExists gates skip it at boot — ollama.service didn't
        # exist yet and /var/lib/kldload/ai-ready hadn't been set. Now that
        # both are true, kick it explicitly so the RAG corpus is indexed
        # against the freshly-pulled model. `--no-block` keeps autodeploy from
        # waiting on the 1800s index TimeoutStartSec.
        if [[ -f /usr/lib/systemd/system/kldload-rag-firstboot.service ]] &&
            [[ ! -f /var/lib/kldload-rag/.first-index-done ]]; then
            log "[ai] kicking kldload-rag-firstboot.service (post-AI)"
            systemctl start --no-block kldload-rag-firstboot.service \
                >>"$LOG_FILE" 2>&1 || log "[ai] rag-firstboot start failed (non-fatal)"
        fi
    ) &
    AI_PID=$!
    log "[ai] pull running as pid $AI_PID (backgrounded)"
fi

# ── Phase 2: Kubernetes bootstrap (foreground) ────────────────────────────────
# Note: `kube-cluster bootstrap` already does clean_slate → golden → clone →
# wg → kubeadm init → cilium/metallb/hubble/zfs-csi → join → smoke. We just
# invoke it and it streams to its own log file.
if [[ "${WANT[k8s]}" == "1" ]]; then
    phase "k8s-bootstrap"
    if [[ -f "${STATE_DIR}/k8s-ready" ]]; then
        log "[k8s] already marked ready — skipping"
    else
        # Worker count picked by profile above:
        #   k8s tile     → 3 workers (production-reference cluster)
        #   klab tile    → 0 workers (user scales via post-install UI)
        #   zfslab tile  → 0 workers (host budget reserved for ZFS test VMs)
        # Bug seen 2026-05-05 on fiend: pre-1.1.0 auto-scaled cluster pods
        # to a third of host RAM each, hitting 30 vCPU / 51 GB on a 24-core
        # / 63 GB host. Fixed defaults in kube-cluster keep this bounded.
        log "[k8s] running kube-cluster bootstrap --workers ${K8S_WORKERS}"
        if kube-cluster bootstrap --workers "${K8S_WORKERS}" >>/var/log/kldload/kube-bootstrap.log 2>&1; then
            mark "k8s"
            log "[k8s] complete"

            # After cluster up, install Tetragon for eBPF syscall/process/file
            # observability. Installs from the ISO-shipped chart tarball
            # (/root/darksite/helm-charts/tetragon.tgz) so no internet needed.
            # Falls back to the helm repo if the tarball is missing (dev builds).
            log "[k8s] installing Tetragon for syscall-level observability..."
            export KUBECONFIG=/root/.kube/config
            # Make install idempotent — kube-cluster bootstrap may have already
            # installed Tetragon (line 380 of bootstrap), in which case the
            # autodeploy step here would fail with "cannot re-use a name".
            # Pre-uninstall (best-effort) so a re-run lands cleanly. Caught
            # .142 2026-05-17.
            helm uninstall tetragon -n kube-system >>"$LOG_FILE" 2>&1 || true
            _tetragon_tgz="/root/darksite/helm-charts/tetragon.tgz"
            if [[ -f "$_tetragon_tgz" ]]; then
                helm install tetragon "$_tetragon_tgz" -n kube-system \
                    --set tetragon.enableProcessCred=true \
                    --set tetragon.enableProcessNs=true \
                    --set tetragonOperator.install=true \
                    >>"$LOG_FILE" 2>&1 && log "[k8s] Tetragon installed (offline)" ||
                    log "[k8s] Tetragon install failed — non-fatal"
            else
                log "[k8s] Tetragon chart not in darksite — trying online helm repo"
                helm repo add cilium https://helm.cilium.io/ >>"$LOG_FILE" 2>&1 || true
                helm repo update >>"$LOG_FILE" 2>&1 || true
                helm install tetragon cilium/tetragon -n kube-system \
                    --set tetragon.enableProcessCred=true \
                    --set tetragon.enableProcessNs=true \
                    --set tetragonOperator.install=true \
                    >>"$LOG_FILE" 2>&1 && log "[k8s] Tetragon installed (online)" ||
                    log "[k8s] Tetragon install skipped — non-fatal"
            fi

            # ── ArgoCD — GitOps reconciler for the kldload demo workload ──
            # Full ArgoCD (not Core) — operator UI at MetalLB VIP
            # 10.100.10.31. Same offline-first install pattern as
            # Tetragon: vendored chart first, online fallback.
            #
            # The "kldload Demo Mode" UX leans on ArgoCD as the
            # reconciliation layer for the full-stack PetClinic demo
            # workload — click "Demo Mode" → CLI applies an Argo
            # Application CRD → Argo syncs the chart → workload comes
            # up reconciled and stays reconciled. Disaster + recover
            # buttons stay clean because Argo brings drift back to
            # truth after `zfs rollback` repoints the PVC.
            #
            # Values strategy: minimal overrides at install time —
            # most config lives in the values file shipped alongside
            # this script at /usr/local/share/kldload/argocd-values.yaml
            # so re-tuning the install doesn't require touching this
            # script.
            log "[k8s] installing ArgoCD (full server + UI + repo-server + controller + dex + redis + notifications)..."
            helm uninstall argocd -n argocd >>"$LOG_FILE" 2>&1 || true
            kubectl create namespace argocd >>"$LOG_FILE" 2>&1 || true
            _argo_tgz="/root/darksite/helm-charts/argo-cd.tgz"
            _argo_values="/usr/local/share/kldload/argocd-values.yaml"
            _argo_helm_args=()
            [[ -f "$_argo_values" ]] && _argo_helm_args+=(-f "$_argo_values")

            # Pin the LoadBalancer to a named MetalLB pool ONLY when the
            # operator named one. Un-annotated, MetalLB assigns from any pool
            # with autoAssign, which is what works on a cluster whose pool the
            # operator called something we cannot guess.
            #
            # And check the pool EXISTS before asking for it by name: MetalLB
            # answers an unknown pool by declining to allocate, the Service
            # then never leaves <pending>, and `helm --wait` below burns its
            # full 15 minutes looking exactly like a hung install — which is
            # how this was reported (fiend, 2026-08-19). If the named pool is
            # absent, say so and let auto-assign have it rather than stall.
            if [[ -n "${METALLB_POOL_NAME:-}" ]]; then
                if kubectl -n metallb-system get ipaddresspool \
                    "$METALLB_POOL_NAME" >/dev/null 2>&1; then
                    _argo_helm_args+=(--set-string
                        "server.service.annotations.metallb\\.universe\\.tf/address-pool=${METALLB_POOL_NAME}")
                    log "[k8s] ArgoCD will request MetalLB pool ${METALLB_POOL_NAME}"
                else
                    log "[k8s] WARNING: METALLB_POOL_NAME=${METALLB_POOL_NAME} does not exist — letting MetalLB auto-assign"
                fi
            fi
            if [[ -f "$_argo_tgz" ]]; then
                helm install argocd "$_argo_tgz" -n argocd \
                    "${_argo_helm_args[@]}" \
                    --set server.service.type=LoadBalancer \
                    --set configs.params."server\.insecure"=true \
                    --set notifications.enabled=true \
                    --set applicationSet.enabled=true \
                    --set dex.enabled=true \
                    --wait --timeout 15m \
                    >>"$LOG_FILE" 2>&1 && log "[k8s] ArgoCD installed (offline) — UI at https://10.100.10.31" ||
                    log "[k8s] ArgoCD did not become ready within the timeout — non-fatal, it may still converge"
            else
                log "[k8s] ArgoCD chart not in darksite — trying online helm repo"
                helm repo add argo https://argoproj.github.io/argo-helm >>"$LOG_FILE" 2>&1 || true
                helm repo update >>"$LOG_FILE" 2>&1 || true
                helm install argocd argo/argo-cd -n argocd \
                    "${_argo_helm_args[@]}" \
                    --set server.service.type=LoadBalancer \
                    --set configs.params."server\.insecure"=true \
                    --set notifications.enabled=true \
                    --set applicationSet.enabled=true \
                    --set dex.enabled=true \
                    --wait --timeout 15m \
                    >>"$LOG_FILE" 2>&1 && log "[k8s] ArgoCD installed (online) — UI at https://10.100.10.31" ||
                    log "[k8s] ArgoCD did not become ready within the timeout — non-fatal, it may still converge"
            fi

            # 15m, not 5m. `--wait` blocks until every pod is Ready, and this
            # runs while the same box is bringing up six k8s guests and, on an
            # AI profile, pulling model weights. Five minutes was optimistic
            # enough that a healthy cluster reported "INSTALLATION FAILED:
            # context deadline exceeded" and moved on, leaving ArgoCD half
            # deployed and the log claiming it was skipped (fiend,
            # 2026-08-16). The release was converging fine; only the patience
            # was wrong.

            # Surface the initial admin password to the webui by
            # writing it to a file the webui has read access to.
            # ArgoCD stores it as a Secret on install, then expects
            # the operator to log in once and change it. We don't
            # change it (this is a demo platform); we just expose it.
            # Webui's "Demo Mode → Open ArgoCD UI" button reads this
            # file to populate a click-to-copy widget.
            if kubectl -n argocd get secret argocd-initial-admin-secret >/dev/null 2>&1; then
                kubectl -n argocd get secret argocd-initial-admin-secret \
                    -o jsonpath='{.data.password}' | base64 -d \
                    >/var/lib/kldload/argocd-admin-password 2>>"$LOG_FILE" || true
                chmod 0640 /var/lib/kldload/argocd-admin-password 2>/dev/null || true
                chgrp kldload /var/lib/kldload/argocd-admin-password 2>/dev/null || true
                log "[k8s] ArgoCD initial-admin password exposed at /var/lib/kldload/argocd-admin-password"
            fi

            # ── The operator's own charts ─────────────────────────────────────
            # Any *.tgz dropped into /root/darksite/helm-charts/workloads is
            # installed here, into the cluster this box just built. That is the
            # whole "bring your own workload" story: no registry to reach, no
            # values plumbing, no pipeline — put the chart on the stick and it
            # is running when the machine finishes booting.
            #
            # HISTORY: build-iso.sh created this directory and a comment
            # promised it was "installed at first boot", the changelog and the
            # README repeated it, and NOTHING read it. The directory shipped
            # empty and inert for the whole 1.4.0 cycle. Caught 2026-08-17 while
            # writing the website copy that would have advertised it. This is
            # the code that makes the sentence true.
            #
            # Release name comes from the filename, so `wordpress.tgz` becomes
            # release `wordpress`. Namespace is the release name too, created on
            # demand: a chart the operator supplied should not land in
            # kube-system next to the platform's own components.
            #
            # Each chart is its own transaction and a failure is logged and
            # skipped, never fatal — one bad chart must not take the other
            # charts, or the rest of first boot, with it. Same rule as the
            # package transactions: nothing optional shares a fate with
            # something required.
            _wl_dir=/root/darksite/helm-charts/workloads
            if [[ -d "$_wl_dir" ]]; then
                shopt -s nullglob
                _wl_charts=("$_wl_dir"/*.tgz)
                shopt -u nullglob
                if ((${#_wl_charts[@]} == 0)); then
                    log "[k8s] no operator charts in ${_wl_dir} (drop a .tgz there to have it installed at first boot)"
                else
                    log "[k8s] installing ${#_wl_charts[@]} operator chart(s) from ${_wl_dir}"
                    _wl_ok=0
                    for _wl in "${_wl_charts[@]}"; do
                        _wl_name="$(basename "$_wl" .tgz)"
                        # Helm release names must be a lowercase RFC1123 label.
                        _wl_rel="$(printf '%s' "$_wl_name" | tr '[:upper:]_' '[:lower:]-' |
                            sed 's/[^a-z0-9-]//g; s/^-*//; s/-*$//' | cut -c1-53)"
                        if [[ -z "$_wl_rel" ]]; then
                            log "[k8s]   ${_wl_name}: no usable release name after sanitising — skipped"
                            continue
                        fi
                        # --values <name>.values.yaml alongside the chart, if the
                        # operator supplied one. Optional by design: a chart that
                        # needs no values should need no file.
                        _wl_args=(--create-namespace --namespace "$_wl_rel" --wait --timeout 10m)
                        [[ -f "${_wl_dir}/${_wl_name}.values.yaml" ]] &&
                            _wl_args+=(--values "${_wl_dir}/${_wl_name}.values.yaml") &&
                            log "[k8s]   ${_wl_rel}: using ${_wl_name}.values.yaml"
                        if helm upgrade --install "$_wl_rel" "$_wl" "${_wl_args[@]}" \
                            >>"$LOG_FILE" 2>&1; then
                            _wl_ok=$((_wl_ok + 1))
                            log "[k8s]   ${_wl_rel}: installed into namespace ${_wl_rel}"
                        else
                            log "[k8s]   ${_wl_rel}: FAILED — see $LOG_FILE; other charts continue"
                        fi
                    done
                    # Outcome, not exit code: say how many of how many landed.
                    log "[k8s] operator charts: ${_wl_ok}/${#_wl_charts[@]} installed"
                fi
            fi
        else
            phase_state "k8s-bootstrap" failed
            log "[k8s] FAILED — see /var/log/kldload/kube-bootstrap.log"
        fi
    fi
fi
# The AI subshell waits on this before starting a multi-GB download (see the
# hold in phase 1). Written whether the bootstrap succeeded, failed, or was
# skipped as already-ready — a failed cluster must not strand Bob forever.
[[ "${WANT[k8s]}" != "1" ]] || touch "${STATE_DIR}/k8s-phase-done"

# ── Phase 3: klab goldens (foreground) ────────────────────────────────────────
# Last because it's the longest (~1hr). RHEL is auto-skipped if no creds
# in the secrets store. KLAB_GOLDEN_KIND (set above from PROFILE):
#   lean  → run 3a only (kvm/klab/devops/ai)
#   ztest → run 3b only (zfslab) — saves ~30 min by skipping the lean
#           lineage that zfslab doesn't use.
# ── Phase 3: Wait for backgrounded AI — BEFORE the golden builds ────────────
# Moved ahead of klab on 2026-08-14. The model download is held until the k8s
# phase finishes (so boot #1 does not thrash), and golden builds take ~1 hr —
# so leaving this after klab meant Ollama was unusable for an hour after
# Kubernetes was already serving. Nothing in the golden pipeline depends on
# the model, so waiting here costs the goldens nothing and gets Bob answering
# as soon as the cluster is up.
if [[ -n "$AI_PID" ]]; then
    phase "ai-wait"
    wait "$AI_PID" 2>/dev/null || true
fi

if [[ "${WANT[klab]}" == "1" ]]; then
    # ── 3a: blue-green lean OS goldens — DEFERRED to klab-firstboot.service ────
    # klab-firstboot.service has its own per-distro ExecStart lines, each with
    # the `-` prefix that lets one distro failure not abort the rest. Running
    # `klab golden all` from here too was a leftover from the pre-systemd
    # orchestration era and caused two parallel klab pipelines fighting over
    # the same zvols (caught 2026-05-12: TWO klab-golden-centos process trees
    # at the same time during firstboot, each clobbering the other's zvol).
    # Wait for klab-firstboot.service to complete instead.
    # "Build all images" means all three lineages, whatever the profile said.
    # KLAB_GOLDEN_KIND is a per-profile PREFERENCE (zfslab wants only the ztest
    # lineage); Build Images is an explicit operator request that overrides it.
    # Without this, a zfslab kickstart with Build Images ticked silently skipped
    # the lean goldens — "all" that quietly meant "some".
    if [[ "${KLAB_GOLDEN_KIND}" == "lean" || "${KLDLOAD_BUILD_IMAGES:-0}" == "1" ]]; then
        phase "klab-goldens"
        if [[ -f "${STATE_DIR}/klab-ready" ]]; then
            log "[klab] blue-green already marked ready — skipping"
            _klab_ok=1
        else
            log "[klab] waiting for klab-firstboot.service to finish lean goldens..."
            _klab_ok=1
            # Poll for klab-firstboot-done up to 2 hours (per-distro timeout in
            # the unit is 7200s; full sequence takes ~30-60 min on typical hw).
            # 1-hour poll budget here covers a reasonable real run; longer than
            # that and the operator should investigate manually.
            _deadline=$(($(date +%s) + 7200))
            while (($(date +%s) < _deadline)); do
                [[ -f /var/lib/kldload/klab-firstboot-done ]] && break
                # If klab-firstboot.service is no longer activating AND the
                # done-marker hasn't appeared, the unit must have failed —
                # don't poll forever. Check unit state every 30s.
                if ! systemctl is-active --quiet klab-firstboot.service &&
                    ! systemctl is-failed --quiet klab-firstboot.service &&
                    [[ "$(systemctl is-active klab-firstboot.service 2>/dev/null)" != "activating" ]]; then
                    log "[klab] klab-firstboot.service not running — proceeding without it"
                    break
                fi
                sleep 30
            done
            if [[ -f /var/lib/kldload/klab-firstboot-done ]]; then
                mark "klab"
                log "[klab] klab-firstboot.service finished — blue-green ready"
                # The blue/green sites are clones waiting for a test run, and
                # the ztest phase below runs for another ~hour. Handing that
                # phase eight idle VMs' worth of RAM is the whole difference
                # between a build that finishes and one that thrashes.
                # force=1: these are disposable clones of the goldens,
                # re-made by `klab deploy` in seconds. Nothing later reads
                # from them, so a straggler that ignores ACPI is stopped
                # rather than left holding RAM for the rest of the install.
                power_off_group 'klab-blue-*' 1
                power_off_group 'klab-green-*' 1
            else
                _klab_ok=0
                log "[klab] klab-firstboot.service did not complete within timeout — see /var/log/klab/"
            fi
        fi
        # ── GNOME desktop goldens ─────────────────────────────────────
        # ONLY when the operator ticked "Build all images". A desktop is
        # ~6 GB of packages and about five minutes per distro on top of the
        # lean golden, so it is not something to hand someone who asked for
        # a workstation and got a 30 GB surprise.
        #
        # WHY IT EXISTS: the point of the golden is that the second desktop
        # VM and the fiftieth both cost a zvol clone rather than a package
        # install. Without this the operator has lean OS goldens and no way
        # to spin up a demo fleet of workstations without building each one.
        #
        # Separate lineage: klab-desktop-<distro>, alongside
        # klab-golden-<distro>. Non-fatal — a failed desktop leaves the lean
        # goldens intact and the install still finishes.
        if [[ "${KLDLOAD_BUILD_IMAGES:-0}" == "1" ]] && command -v klab >/dev/null 2>&1; then
            phase "klab-desktop-goldens"
            log "[klab] building GNOME desktop goldens (~6GB + ~5 min per distro)"
            if klab golden-desktop >>"$LOG_FILE" 2>&1; then
                log "[klab] desktop goldens ready — clone one with: kvm-clone klab-desktop-debian <name>"
            else
                log "[klab] WARNING desktop goldens incomplete — lean goldens are unaffected; see /var/log/klab/"
            fi
        fi
    else
        log "[klab] KLAB_GOLDEN_KIND=ztest — skipping lean OS goldens (zfslab profile)"
        _klab_ok=1
    fi

    # ── 3b: ztest goldens (separate phase so the installer UI can
    #       distinguish the two and not flip to "finished" while the
    #       ztest lineage is still building for another ~60 min) ─────
    # Runs when KLAB_GOLDEN_KIND=ztest (zfslab profile) OR the
    # integration-test override KLDLOAD_BUILD_ZTEST_GOLDENS=1 is set.
    _ztest_requested=0
    [[ "${KLAB_GOLDEN_KIND}" == "ztest" ]] && _ztest_requested=1
    [[ "${KLDLOAD_BUILD_ZTEST_GOLDENS:-0}" == "1" ]] && _ztest_requested=1
    # "Build all images" NO LONGER implies the ztest lineage.
    #
    # It used to, and it cost an hour of every install that ticked the box:
    # five VMs built one at a time, each installing the full OpenZFS test
    # toolchain, while the operator waited. Almost nobody wants that — the
    # ZFS test goldens are for people who develop OpenZFS, and they were
    # being built on machines that would never run a test.
    #
    # ztxplore owns that lineage now: the app ships on every install and
    # builds the goldens ON DEMAND, when somebody opens it and asks for a
    # run. Available everywhere, built where it is actually wanted.
    #
    # The zfslab profile and the explicit override still build them at
    # install time, because that profile exists precisely to be a lab.

    if [[ "$_ztest_requested" == "1" ]]; then
        phase "klab-ztest-goldens"
        if [[ -f "${STATE_DIR}/klab-ztest-ready" ]]; then
            log "[klab] ztest already marked ready — skipping"
        else
            # Build the distros ONE AT A TIME instead of `golden-ztest all`.
            #
            # WHY: `all` is a single opaque call that takes about an hour, and
            # nothing published progress until it returned — so every progress
            # surface (the build monitor checklist, the web console, vmxplore)
            # honestly reported nothing built for the whole run and then jumped
            # to done. Operator on .131 watched centos finish and asked why
            # nothing registered; there was simply no per-distro signal to read.
            #
            # A second win: one distro failing no longer takes the other four
            # with it. Each is independent, so a broken mirror for one release
            # costs that release only, and the log names which.
            _zt_distros=(centos rocky fedora debian ubuntu)
            _zt_total="${#_zt_distros[@]}"
            _zt_ok=0
            _zt_failed=()
            log "[klab] building ${_zt_total} ztest goldens, one at a time (~60 min total)"
            for _zt_d in "${_zt_distros[@]}"; do
                log "[klab] ztest ${_zt_d} — starting ($((_zt_ok + ${#_zt_failed[@]} + 1))/${_zt_total})"
                if klab golden-ztest "$_zt_d" >>/var/log/kldload/klab-firstboot.log 2>&1; then
                    _zt_ok=$((_zt_ok + 1))
                    log "[klab] ztest ${_zt_d} — done (${_zt_ok}/${_zt_total} built)"
                    # Release it NOW, not in the quiesce pass an hour from now.
                    # The next distro builds on a box with that memory back.
                    power_off_vm "klab-ztest-${_zt_d}"
                else
                    _zt_failed+=("$_zt_d")
                    log "[klab] ztest ${_zt_d} — FAILED (continuing with the rest)"
                fi
            done
            if ((${#_zt_failed[@]} == 0)); then
                mark "klab-ztest"
                log "[klab] ztest goldens complete (${_zt_ok}/${_zt_total})"
            else
                phase_state "klab-ztest-goldens" failed
                log "[klab] ztest finished ${_zt_ok}/${_zt_total}; failed: ${_zt_failed[*]} — see /var/log/kldload/klab-firstboot.log (non-fatal)"
            fi
        fi
    else
        log "[klab] ztest goldens skipped (not a ZFS Lab install)"
    fi
fi

# ── Quiesce: built is not the same as running ────────────────────────────────
# Everything above BUILDS VMs. Almost none of them need to stay powered on, and
# leaving them up is what makes a freshly-built machine feel broken:
#
#   .131, 2026-08-15 — a full-toggle install finished with 16 VMs running and
#   3 GB of 62 GB free. Chromium could not allocate, so every desktop tile and
#   the web console "did not launch". Nothing had failed; the host was simply
#   out of memory because a build left its scaffolding standing.
#
# What stays up, and why:
#   - KEEP_CPS control planes + KEEP_WORKERS workers, so the cluster is usable
#     the moment the operator looks at it. Default 2+2. Two of a three-member
#     etcd is still a strict majority, so quorum holds with one CP powered off;
#     this is why the cluster is BUILT with three and RUN with two.
#   - Everything else is off: goldens are templates that exist to be cloned,
#     blue/green sites are clones waiting for a test run, and ztest images are
#     inputs to a suite that starts them itself.
#
# Nothing is destroyed — `virsh start <vm>` brings any of it back, and the
# tools that use these VMs start them on demand.
#
# Override with KLDLOAD_KEEP_CPS / KLDLOAD_KEEP_WORKERS; 0 powers all of them
# down, which is right for a build host that is not also the lab.
quiesce_idle_vms() {
    command -v virsh >/dev/null 2>&1 || return 0
    local _keep_cp="${KLDLOAD_KEEP_CPS:-2}" _keep_w="${KLDLOAD_KEEP_WORKERS:-2}"
    local _vm _cp_seen=0 _w_seen=0 _off=0

    log "[quiesce] powering down idle VMs (keeping ${_keep_cp} CP + ${_keep_w} workers)"
    while read -r _vm; do
        [[ -n "$_vm" ]] || continue
        case "$_vm" in
        *-cp | *-cp-*)
            _cp_seen=$((_cp_seen + 1))
            ((_cp_seen <= _keep_cp)) && continue
            ;;
        *-w-*)
            _w_seen=$((_w_seen + 1))
            ((_w_seen <= _keep_w)) && continue
            ;;
        esac
        # A guest that ignores ACPI is not a failure worth aborting for — it is
        # reported and left running, because forcing it off could corrupt a
        # golden mid-write.
        if virsh shutdown "$_vm" >/dev/null 2>&1; then
            _off=$((_off + 1))
            log "[quiesce]   shutdown ${_vm}"
        else
            log "[quiesce]   WARN ${_vm} did not accept shutdown — left running"
        fi
    done < <(virsh list --name --state-running 2>/dev/null)

    log "[quiesce] ${_off} VM(s) powered down; start any of them with: virsh start <name>"
}

# Only quiesce when this run actually built something. A re-run that did no
# work must not power off VMs the operator started themselves since.
if [[ "${WANT[klab]}" == "1" || "${WANT[k8s]}" == "1" ]]; then
    quiesce_idle_vms
fi

# ── Final: overall ready marker ──────────────────────────────────────────────
# All requested phases must have written their marker. Unrequested phases
# count as satisfied. This is what firstboot_status keys off.
_all_ok=1
for sub in k8s ai klab; do
    if [[ "${WANT[$sub]}" == "1" ]] && [[ ! -f "${STATE_DIR}/${sub}-ready" ]]; then
        _all_ok=0
        log "SKIP all-ready: ${sub} requested but no marker"
    fi
done
# ── Reclaim the AI darksite, once every piece of it is demonstrably spent ────
# 5.4 GB of /root/darksite/ollama survived on every install: the model weights,
# the ollama runtime tarball and the Open WebUI OCI image. kldload-firstboot's
# _darksite_reclaim removes the DISTRO package mirrors and deliberately stops
# there, and that is correct — it runs long before this script, and deleting the
# helm charts at that point is what once sent an "air-gapped" box to the public
# internet for 138 container images.
#
# But the ollama payload is consumed HERE, not in firstboot: the weights are
# rehydrated by firstboot, while the runtime is installed and the webui image is
# loaded by this script. So this is the earliest point at which all three are
# spent, and the right place to free the space. Found by the post-install smoke
# test asserting /root/darksite was gone when 5.4 GB of it was not (.113,
# 2026-08-17); the install had two copies of the weights on disk.
#
# Each piece is gated on PROOF that it was consumed, not on "autodeploy got this
# far". A missing proof keeps the source, because 2 GB of disk is cheaper than an
# air-gapped machine that has to fetch a model it already shipped with.
_reclaim_ai_darksite() {
    local d=/root/darksite/ollama
    [[ -d "$d" ]] || return 0
    [[ -f /etc/kldload/keep-darksite ]] && {
        log "[ai] LAN-mirror mode — keeping $d"
        return 0
    }
    local freed=0

    # models: proven by ollama listing at least one model from /srv.
    if [[ -d "$d/models" ]]; then
        if [[ -n "$(find /srv/ollama/models -name 'sha256-*' -size +1M 2>/dev/null | head -1)" ]]; then
            rm -rf "$d/models" && freed=1
            log "[ai] darksite models reclaimed — weights are live under /srv/ollama/models"
        else
            log "[ai] KEEPING darksite models — nothing rehydrated under /srv/ollama/models yet"
        fi
    fi
    # runtime: proven by the binary existing.
    if [[ -d "$d/runtime" ]]; then
        if command -v ollama >/dev/null 2>&1; then
            rm -rf "$d/runtime" && freed=1
            log "[ai] darksite runtime reclaimed — $(ollama --version 2>/dev/null | head -1) is installed"
        else
            log "[ai] KEEPING darksite runtime — no ollama binary on PATH"
        fi
    fi
    # webui: proven by the image being present in whichever runtime loaded it.
    if [[ -d "$d/webui" ]]; then
        if podman image exists ghcr.io/open-webui/open-webui:main 2>/dev/null ||
            docker image inspect ghcr.io/open-webui/open-webui:main >/dev/null 2>&1; then
            rm -rf "$d/webui" && freed=1
            log "[ai] darksite webui image reclaimed — it is loaded in the container runtime"
        else
            log "[ai] KEEPING darksite webui image — not found in podman or docker"
        fi
    fi
    # Only remove the parent if it is genuinely empty; helm-charts lives beside
    # it and must survive (see _darksite_reclaim's header for what happens when
    # it does not).
    rmdir "$d" 2>/dev/null && log "[ai] $d removed"
    ((freed)) && log "[ai] darksite now $(du -sh /root/darksite 2>/dev/null | cut -f1) (helm charts kept)"
    return 0
}
_reclaim_ai_darksite

if [[ $_all_ok -eq 1 ]]; then
    mark "all"
    phase "ready"
    log "══════════════════════════════════════════════════════════════"
    log "  kldload autodeploy complete — subsystem summary:"
    # "Everything requested is up" hid the common surprise where the operator
    # expected K8s/klab but the bootstrap flag was 0 (e.g. a plain desktop
    # install enables the K8s *tools* but not the cluster). Spell out what's on
    # vs off, with the one command to add each, so a gap is never silent.
    [[ "${WANT[ai]}" == "1" ]] && log "    AI:   deployed" ||
        log "    AI:   off — enable the Bob/AI tile at install"
    [[ "${WANT[k8s]}" == "1" ]] && log "    K8s:  deployed (${K8S_WORKERS} workers)" ||
        log "    K8s:  off — to add now: kube-cluster bootstrap --workers 3"
    [[ "${WANT[klab]}" == "1" ]] && log "    klab: deployed" ||
        log "    klab: off — enable the klab option at install"
    log "══════════════════════════════════════════════════════════════"
else
    phase "partial"
    log "autodeploy finished with partial success — see markers in $STATE_DIR"
fi
