#!/usr/bin/env bash
# kldload-recovery — import and list the pools of a machine that will not
# boot, from the live image. `krecovery` does the chroot, rollback and
# boot-loader repair; this is the first step before it.
# Exit: 0 done; 1 a zpool/zfs command failed; 2 an unknown command.
set -Eeuo pipefail
trap 'echo "kldload-recovery: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

case "${1:-help}" in
import)
    # -a: import every pool found; -f: pools from the installed system are
    # never cleanly exported when you're here, so a hostid mismatch is the
    # normal case, not an error. -N so nothing auto-mounts over the live env;
    # use krecovery chroot (or zfs mount) for that. A bare `zpool import`
    # only LISTS importable pools — which is what this command did until
    # 2026-07-22, silently importing nothing while claiming success.
    #
    # SAFETY: never -a. On a KVM host every guest's own pool is visible
    # through its zvol (/dev/zd*): onyx lists twenty, several "last accessed
    # by another system" -- a running guest. `zpool import -a -f` would force
    # them into the host, and two kernels writing one pool destroys it. On
    # the live image that happens on a SECOND run, once the first has
    # imported the host pool and its zvols appeared (2026-09-30). So each
    # importable pool is read from `zpool import`'s own listing, one on a
    # zvol is skipped and named, and the rest are imported by id.
    _listing="$(zpool import 2>/dev/null)" || _listing="" # exit 1: nothing importable
    mapfile -t _pools < <(awk '
        function flush() { if (id != "") print (zd ? "skip" : "take"), id, name; id = ""; name = ""; zd = 0 }
        /^ *pool:/ { flush(); name = $2; next }
        /^ *id:/ { id = $2; next }
        /(^|[^a-z])zd[0-9]+/ { zd = 1 }
        END { flush() }' <<<"$_listing")
    _ok=0 _bad=0 _skip=0
    for _p in "${_pools[@]}"; do
        read -r _what _id _name <<<"$_p"
        if [[ "$_what" == skip ]]; then
            echo "skipped ${_name} (${_id}): it is on a zvol, a virtual machine's disk" >&2
            _skip=$((_skip + 1))
        elif zpool import -f -N "$_id"; then
            echo "imported ${_name} (${_id})"
            _ok=$((_ok + 1))
        else
            echo "FAILED to import ${_name} (${_id})" >&2
            _bad=$((_bad + 1))
        fi
    done
    echo "imported ${_ok}, failed ${_bad}, skipped ${_skip} on zvols"
    zpool list
    ((_bad == 0)) || exit 1
    ;;
scan)
    # exit 1 "no pools available to import" is the benign empty case —
    # the message above is the answer the operator asked for
    zpool import || true
    ;;
list-pools)
    zpool list
    ;;
list-datasets)
    zfs list
    ;;
help | -h | --help)
    _usage=1
    ;&
*)
    # an unknown command is a usage error: the text on stderr, exit 2
    # (it printed the usage and exited 0 until 2026-09-30)
    [[ -n "${_usage:-}" ]] || exec >&2
    cat <<'EOH'
Usage:
  kldload-recovery import          import every pool found on a disk, forced, not
                                   mounted (-f -N); pools on zvols are VMs' and
                                   are skipped
  kldload-recovery scan            list importable pools without importing
  kldload-recovery list-pools      list imported pools
  kldload-recovery list-datasets   list datasets of imported pools

For chroot/rollback/bootloader repair, see: krecovery help
EOH
    [[ -n "${_usage:-}" ]] || exit 2
    ;;
esac
