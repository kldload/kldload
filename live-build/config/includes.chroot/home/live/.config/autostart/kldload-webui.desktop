[Desktop Entry]
Type=Application
Name=kldload Web UI
# webui runs on HTTPS :8443 (self-signed cert generated by kldload-tls-cert
# on first webui start). Wait for the port to answer TLS — `echo >/dev/tcp`
# only confirms the TCP handshake completes, which it will even if the cert
# script failed; so we also curl -sk to verify the HTTP side is actually
# serving. Old port 8080 was Bob's Open WebUI — not the installer URL.
#
# Cert auto-trust: certutil adds the cert to the Firefox NSS DB so the
# "Warning: Potential Security Risk Ahead" page never appears on a fresh
# live boot. Requires a live profile to exist; we touch it first with a
# headless Firefox run that creates cert9.db, then import into the real
# profile. Skipped if certutil isn't present (falls back to the user
# clicking "Accept the Risk" once, same as before).
Exec=bash -c '\
  systemctl start kldload-webui 2>/dev/null; \
  for i in $(seq 1 30); do \
    curl -sk -o /dev/null https://localhost:8443/ 2>/dev/null && break; \
    sleep 1; \
  done; \
  PROF=/home/live/.mozilla/firefox/kldload.default; \
  mkdir -p "$PROF"; \
  if command -v certutil >/dev/null 2>&1 && [[ -f /var/lib/kldload/tls/webui.crt ]]; then \
    [[ -f "$PROF/cert9.db" ]] || timeout 5 firefox --headless --profile "$PROF" about:blank >/dev/null 2>&1; \
    certutil -A -n kldload-webui-selfsigned -t "CT,," \
      -i /var/lib/kldload/tls/webui.crt -d sql:"$PROF" 2>/dev/null; \
  fi; \
  firefox --profile "$PROF" https://localhost:8443 https://kldload.ca'
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=4
