[Desktop Entry]
Type=Application
Name=kldload Web UI
# Chrome (the kldload default browser) in app-mode, via kldload-webui-launch
# which waits for the :8443 SPA to answer, then opens it. kldload-webview/WebKit
# was retired (Bob's voice needs the Chromium-only Web Speech API) and Firefox
# is no longer the shipped browser. The kldload-webui cert is pre-trusted in
# ~/.pki/nssdb (seeded from /etc/skel by kldload-trust-cert), so Chrome shows no
# warning — no per-browser NSS import needed here anymore.
#
# NOTE: this per-user file intentionally shares its filename with the system
# /etc/xdg/autostart entry written by build-iso.sh so it overrides it; keep both
# pointed at the same Chrome launcher to avoid a split-brain (firefox vs chrome)
# autostart like the one caught on .142 b644.
Exec=/usr/local/bin/kldload-webui-launch
Icon=kldload-webui
StartupWMClass=com.kldload.webui
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=4
