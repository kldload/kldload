#!/usr/bin/env bash
set -Eeuo pipefail
trap 'echo "9990-kldload-live-ssh: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

# This file's own options line is `set -eu`, and that is the author's
# intent. The 2026-09-15 strict sweep put `set -Eeuo pipefail` above it, which
# additionally forced pipefail here; a LATER set line cannot clear an
# option an earlier one set, so the file ran that way regardless. That is the
# mechanic that killed build 21 on onyx through dracut. The drop has to be
# explicit. See project_strict-sweep-overrode-soft-set-lines.
set +o pipefail

LOG=/var/log/kldload-live-ssh.log
exec >>"$LOG" 2>&1

echo "=== kldload live ssh setup start ==="
date

USER_NAME="live"
USER_PASS="live"

if id "$USER_NAME" >/dev/null 2>&1; then
    echo "$USER_NAME:$USER_PASS" | chpasswd
    echo "password set for $USER_NAME"
else
    echo "user $USER_NAME does not exist yet"
fi

mkdir -p /run/sshd
chmod 0755 /run/sshd

echo "=== kldload live ssh setup end ==="
date
