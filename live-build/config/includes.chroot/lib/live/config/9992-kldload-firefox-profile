#!/usr/bin/env bash
# Clean stale Firefox lock files from the live profile so Firefox always
# starts cleanly on boot without "already running" errors.

set -Eeuo pipefail
trap 'echo "9992-kldload-firefox-profile: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

# This file's own options line is `set -eu`, and that is the author's
# intent. The 2026-09-15 strict sweep put `set -Eeuo pipefail` above it, which
# additionally forced pipefail here; a LATER set line cannot clear an
# option an earlier one set, so the file ran that way regardless. That is the
# mechanic that killed build 21 on onyx through dracut. The drop has to be
# explicit. See project_strict-sweep-overrode-soft-set-lines.
set +o pipefail

PROFILE_DIR="/home/live/.mozilla/firefox/kldload.default"
mkdir -p "$PROFILE_DIR"
rm -f "$PROFILE_DIR/lock" "$PROFILE_DIR/.parentlock"
chown -R live:live /home/live/.mozilla 2>/dev/null || true
