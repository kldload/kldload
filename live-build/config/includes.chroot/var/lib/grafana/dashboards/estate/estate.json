{
  "annotations": {
    "list": []
  },
  "title": "Estate",
  "uid": "kldload-estate",
  "tags": [
    "kldload",
    "home"
  ],
  "schemaVersion": 39,
  "timezone": "",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "kldload home dashboard. Fleet overview + drill-down links to specialized views. VMs auto-appear here as libvirt creates them.",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet at a glance",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "stat",
      "title": "VMs",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "(count(libvirt_domain_info_state{job=\"libvirt-vms\"}) or vector(0)) + (sum(kldload_firecracker_instances) or vector(0))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "description": "libvirt domains plus Firecracker microVMs. A microVM is not a libvirt domain, so the libvirt count alone misses every clone kfire makes \u2014 kfire-exporter supplies the second term."
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Running",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "(count(libvirt_domain_info_state{job=\"libvirt-vms\"} == 1) or vector(0)) + (sum(kldload_firecracker_running) or vector(0))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background"
      },
      "description": "libvirt domains plus Firecracker microVMs. A microVM is not a libvirt domain, so the libvirt count alone misses every clone kfire makes \u2014 kfire-exporter supplies the second term."
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Host CPU",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background"
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Host RAM used",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "rpool health",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "zfs_pool_health{pool=\"rpool\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "ONLINE",
                  "color": "green"
                },
                "1": {
                  "text": "DEGRADED",
                  "color": "yellow"
                },
                "2": {
                  "text": "FAULTED",
                  "color": "red"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background"
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "expr": "(time() - node_boot_time_seconds)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Every VM (click name \u2192 metrics for that VM)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false
    },
    {
      "id": 30,
      "type": "table",
      "title": "VM Estate \u2014 auto-discovered, click to drill down",
      "description": "Every libvirt domain on the host \u2014 templates AND running VMs. Filter by Type column to focus. Click a VM name \u2192 opens that VM's metrics dashboard.",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "libvirt_domain_info_state",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "libvirt_domain_info_virtual_cpus",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "expr": "libvirt_domain_info_maximum_memory_bytes/1024/1024",
          "refId": "C",
          "format": "table",
          "instant": true
        },
        {
          "expr": "rate(libvirt_domain_info_cpu_time_seconds_total[1m])",
          "refId": "D",
          "format": "table",
          "instant": true
        },
        {
          "expr": "libvirt_domain_info_memory_usage_bytes",
          "refId": "E",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "domain",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "domain": "VM",
              "state_desc": "State",
              "Value #A": "state_code",
              "Value #B": "vCPUs",
              "Value #C": "RAM (MB)",
              "Value #D": "CPU (cores)",
              "Value #E": "RAM used (bytes)"
            },
            "excludeByName": {
              "state_code": true,
              "__name__": true,
              "Value": true,
              "instance": true,
              "job": true,
              "source_host_name": true
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reduce": {
              "reducer": "allValues"
            },
            "alias": "Type",
            "binary": {
              "left": "VM",
              "operator": "/",
              "right": "VM"
            },
            "replaceFields": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "VM"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Drill down \u2014 $__value.text metrics",
                    "url": "/grafana/d/klab-vm-estate/?var-vm=${__value.text}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM used (bytes)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU (cores)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Type"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".*-golden.*",
                      "result": {
                        "text": "\ud83d\udccb Template",
                        "color": "orange"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null+nan",
                      "result": {
                        "text": "\ud83d\udda7 VM",
                        "color": "blue"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 100,
      "type": "text",
      "title": "Specialized dashboards",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "options": {
        "mode": "markdown",
        "content": "### Drill in\n\n- **[Host Full](/grafana/d/rYdddlPWk/node-exporter-full)** \u2014 every CPU/RAM/disk/network metric the kernel exposes\n- **[Storage / ZFS Pool Health](/grafana/d/zfs-pool-health)** + scrub + compression\n- **[Per-VM \u2014 VM Estate](/grafana/d/klab-vm-estate)** \u2014 pick a VM, see its baseline\n- **[ZFS Test Lab \u2014 Run Matrix](/grafana/d/klab-test-matrix)** \u2014 every test run + pass/fail by distro\n- **[ZFS Test Lab \u2014 VM Debug](/grafana/d/klab-test-debug)** \u2014 drill into one test VM during a failed run\n- **[Kubernetes \u2014 Cilium Hubble](/grafana/d/5HftnJAWz/cilium-v1-12-hubble-metrics)** \u2014 L4-L7 network flow\n- **[Kubernetes \u2014 Tetragon Security](/grafana/d/tetragon-ebpf)** \u2014 eBPF security events"
      }
    },
    {
      "id": 101,
      "type": "table",
      "title": "Firecracker microVMs \u2014 cloned from a golden, not defined in libvirt",
      "description": "The other half of the estate. A microVM is a ZFS clone plus a Firecracker process, so it never appears in libvirt and the table above cannot see it. kfire-exporter emits one series per instance; this lists them beside the domains so the whole estate is one page. State is 1 while its unit is active.",
      "datasource": null,
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "expr": "kldload_firecracker_instance",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "name": "Machine",
              "golden": "Golden",
              "ip": "Address",
              "vcpus": "vCPU",
              "ram_mb": "RAM (MB)",
              "Value": "Running"
            },
            "indexByName": {
              "name": 0,
              "golden": 1,
              "ip": 2,
              "vcpus": 3,
              "ram_mb": 4,
              "Value": 5
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Machine"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Running"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "stopped",
                        "color": "text",
                        "index": 0
                      },
                      "1": {
                        "text": "running",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": true,
          "reducer": [
            "count"
          ],
          "fields": [
            "Machine"
          ]
        }
      }
    }
  ]
}
