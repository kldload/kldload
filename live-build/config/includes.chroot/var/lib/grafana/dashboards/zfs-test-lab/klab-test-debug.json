{
  "title": "ZFS Test Lab \u2014 VM Debug",
  "uid": "klab-test-debug",
  "tags": [
    "zfs",
    "klab",
    "kldload",
    "debug"
  ],
  "timezone": "",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-12h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "vm",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({host=~\"klab-test.*\"}, vm)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "ubuntu",
          "value": "ubuntu"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "hung_task warnings (THE money row)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{vm=\"$vm\"} |~ \"hung_task|blocked for more than|INFO: task\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 2,
      "title": "Kernel ring (full)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{vm=\"$vm\",transport=\"kernel\"}",
          "refId": "A"
        },
        {
          "expr": "{vm=\"$vm\",job=\"dmesg-backfill\"}",
          "refId": "B"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 3,
      "title": "ZFS module debug (dbgmsg)",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{vm=\"$vm\",job=\"zfs-dbgmsg\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 4,
      "title": "ZFS ioctl / zio / spa / arc",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{vm=\"$vm\"} |~ \"(?i)zio_|spa_|arc_|zfs_ioctl|dmu_|dsl_|zpool\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 5,
      "title": "Systemd errors / FAIL markers / kernel BUGs",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{vm=\"$vm\"} |~ \"(?i)(error|failed|panic|oops|call trace|bug:|warn[: ]|hung_task)\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 6,
      "title": "klab test progression (from host /root/klab/latest/<vm>.log)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{host=\"kldload-node\",job=\"klab-test-logs\",vm=\"$vm\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 100,
      "title": "Debug bundles captured (auto on timeout/fail)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{job=\"klab-bundle\",vm=\"$vm\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}