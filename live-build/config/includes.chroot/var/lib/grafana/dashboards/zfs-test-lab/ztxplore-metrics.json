{
  "uid": "ztxplore-metrics",
  "title": "OpenZFS Test Lab \u2014 Metrics",
  "description": "Every ZFS and test-lab panel on one board, composed from the shipped dashboards. This is the board ztxplore's Metrics tab opens. Copy it and edit freely \u2014 the sources it was built from are still there untouched.",
  "tags": [
    "zfs",
    "openzfs",
    "test-lab",
    "ztxplore"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "pool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(zfs_pool_health, pool)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "rpool",
          "value": "rpool"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Live test bench \u2014 what the lab is doing right now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "txg sync rate (/s)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "description": "klab_zfs_txg_synced_total \u2014 how many transaction groups committed per second. Spikes during write-heavy phases. A stuck flat counter while writes are flowing = txg sync stall.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(klab_zfs_txg_synced_total[1m])) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "hertz",
          "color": {
            "mode": "continuous-GrYlRd"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Pool read ops (/s)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 3,
      "description": "klab_zfs_pool_read_ops \u2014 read operations the pool serviced. Includes both ARC hits and disk reads. Pair with ARC hit ratio to see what fraction was cache-served.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(klab_zfs_pool_read_ops) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "continuous-BlPu"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Pool write ops (/s)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "description": "klab_zfs_pool_write_ops \u2014 write operations queued to the pool. Goes through ZIL for sync writes, async writes batch into txg.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(klab_zfs_pool_write_ops) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "continuous-RdYlGr"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "ARC hit ratio",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 5,
      "description": "klab_zfs_arc_hit_ratio \u2014 fraction of reads served from ARC vs disk. >0.95 = warm cache. A dive to 0.5 mid-test means the test is reading data that doesn't fit in ARC (cold-miss thrashing).",
      "targets": [
        {
          "refId": "A",
          "expr": "avg(klab_zfs_arc_hit_ratio) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.6
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Pool throughput \u2014 bytes/sec (read = blue, write = orange)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "id": 6,
      "description": "klab_zfs_pool_read_bw_bytes vs klab_zfs_pool_write_bw_bytes \u2014 actual byte rates through the pool. The read line going flat while ops climb = ARC absorbing them; the read line tracking ops = disk-bound.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(klab_zfs_pool_read_bw_bytes) or vector(0)",
          "legendFormat": "read"
        },
        {
          "refId": "B",
          "expr": "sum(klab_zfs_pool_write_bw_bytes) or vector(0)",
          "legendFormat": "write"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "txg syncs/sec over test run",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "id": 7,
      "description": "Sustained txg sync rate during a test. Watch for: cliffs (test phase change), plateaus (steady-state write pressure), spikes during the dirty-data flush cycle.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(klab_zfs_txg_synced_total[1m])) or vector(0)",
          "legendFormat": "txg/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "hertz",
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 2,
            "gradientMode": "opacity"
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "ARC composition \u2014 MRU vs MFU vs target",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 8,
      "description": "klab_zfs_arc_mru_size_bytes + klab_zfs_arc_mfu_size_bytes vs target. When MRU dominates \u2192 working set is being introduced fresh. When MFU dominates \u2192 test is re-reading. The target line is what ZFS's heuristic wants the total to be.",
      "targets": [
        {
          "refId": "A",
          "expr": "avg(klab_zfs_arc_mru_size_bytes)",
          "legendFormat": "MRU"
        },
        {
          "refId": "B",
          "expr": "avg(klab_zfs_arc_mfu_size_bytes)",
          "legendFormat": "MFU"
        },
        {
          "refId": "C",
          "expr": "avg(klab_zfs_arc_target_bytes)",
          "legendFormat": "target"
        },
        {
          "refId": "D",
          "expr": "avg(klab_zfs_arc_size_bytes)",
          "legendFormat": "total size"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            }
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "ARC hits, misses, evictions \u2014 the cache's verdict per second",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 9,
      "description": "rate of klab_zfs_arc_hits/misses/evict_total. Misses spike when the test reads cold data. Evictions spike when the working set exceeds ARC size and entries are being pushed out. The relationship between these three is the cache management story.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(klab_zfs_arc_hits_total[1m])) or vector(0)",
          "legendFormat": "hits"
        },
        {
          "refId": "B",
          "expr": "sum(rate(klab_zfs_arc_misses_total[1m])) or vector(0)",
          "legendFormat": "misses"
        },
        {
          "refId": "C",
          "expr": "sum(rate(klab_zfs_arc_evict_total[1m])) or vector(0)",
          "legendFormat": "evictions"
        },
        {
          "refId": "D",
          "expr": "sum(rate(klab_zfs_arc_demand_hits_total[1m])) or vector(0)",
          "legendFormat": "demand hits"
        },
        {
          "refId": "E",
          "expr": "sum(rate(klab_zfs_arc_prefetch_hits_total[1m])) or vector(0)",
          "legendFormat": "prefetch hits"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "hertz",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          }
        }
      }
    },
    {
      "type": "heatmap",
      "title": "Block READ latency during test",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 10,
      "description": "ebpf_exporter_bio_latency_seconds_bucket{operation='read'} \u2014 every block read serviced by the kernel.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(ebpf_exporter_bio_latency_seconds_bucket{operation=\"read\"}[2m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s",
          "decimals": 4
        },
        "color": {
          "scheme": "Spectral",
          "mode": "scheme",
          "exponent": 0.5
        },
        "cellGap": 1
      }
    },
    {
      "type": "heatmap",
      "title": "Block WRITE latency during test",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 11,
      "description": "ebpf_exporter_bio_latency_seconds_bucket{operation='write'} \u2014 every block write the kernel committed. Wide spread during txg flushes.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(ebpf_exporter_bio_latency_seconds_bucket{operation=\"write\"}[2m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s",
          "decimals": 4
        },
        "color": {
          "scheme": "Spectral",
          "mode": "scheme",
          "exponent": 0.5
        },
        "cellGap": 1
      }
    },
    {
      "type": "stat",
      "title": "Pool used %",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 33
      },
      "id": 12,
      "description": "klab_zfs_pool_used_bytes / size. Tests that create big datasets push this number; cleanup phases pull it back.",
      "targets": [
        {
          "refId": "A",
          "expr": "avg(klab_zfs_pool_used_bytes / klab_zfs_pool_size_bytes)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Pool fragmentation",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 33
      },
      "id": 13,
      "description": "klab_zfs_pool_fragmentation. Higher = freer space is more fractured. Climbs during random-write tests, stays put during sequential.",
      "targets": [
        {
          "refId": "A",
          "expr": "avg(klab_zfs_pool_fragmentation)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Compression ratio",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 33
      },
      "id": 14,
      "description": "klab_zfs_pool_compress_ratio. >1 means data on disk is smaller than logical. Tests that write compressible data raise this.",
      "targets": [
        {
          "refId": "A",
          "expr": "avg(klab_zfs_pool_compress_ratio)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2
        }
      }
    },
    {
      "type": "stat",
      "title": "Snapshots",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 33
      },
      "id": 15,
      "description": "klab_zfs_snapshot_count \u2014 total snapshots on pool. Tests that take/destroy snapshots churn this number; the kldload klab-pre snapshot is here too.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(klab_zfs_snapshot_count)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "logs",
      "title": "zfs-dbgmsg \u2014 live",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "id": 16,
      "description": "Loki tail of {job='zfs-dbgmsg'} \u2014 the kernel ZFS module's own narration during the test. Wraps to fit; scroll for history.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"zfs-dbgmsg\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "type": "logs",
      "title": "klab test output \u2014 every distro, every test, live",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "id": 17,
      "description": "Loki tail of {job='klab-test-logs'} \u2014 what zfs-tests.sh is printing as it runs. Pair this panel with the ARC + txg + dbgmsg panels above to correlate test events with kernel-side behavior.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"klab-test-logs\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "type": "row",
      "title": "Test matrix \u2014 pass/fail across distros and runs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 66
      },
      "id": 18,
      "panels": []
    },
    {
      "id": 19,
      "title": "Tests PASS \u2014 current run",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 67
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(klab_test_pass_total)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      }
    },
    {
      "id": 20,
      "title": "Tests FAIL \u2014 current run",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 67
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(klab_test_fail_total)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      }
    },
    {
      "id": 21,
      "title": "Tests SKIP",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 67
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(klab_test_skip_total)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          }
        }
      }
    },
    {
      "id": 22,
      "title": "Test VMs active",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 67
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(klab_test_vm_running)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 23,
      "title": "Per-distro PASS/FAIL/SKIP",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 71
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "klab_test_pass_total",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "klab_test_fail_total",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "expr": "klab_test_skip_total",
          "refId": "C",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "run": true
            },
            "renameByName": {
              "Value #A": "PASS",
              "Value #B": "FAIL",
              "Value #C": "SKIP"
            }
          }
        }
      ]
    },
    {
      "id": 24,
      "title": "Per-distro current status",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 71
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "klab_test_status",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "Value": true
            }
          }
        }
      ]
    },
    {
      "id": 25,
      "title": "Current test (last test line seen per distro)",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 81
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "klab_test_last_test_info",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "Value": true
            }
          }
        }
      ]
    },
    {
      "id": 26,
      "title": "Test progression timeline (all distros)",
      "type": "logs",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 87
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{job=\"klab-test-logs\"} |~ \"\\\\[PASS\\\\]|\\\\[FAIL\\\\]|\\\\[SKIP\\\\]|Finished:\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      }
    },
    {
      "id": 27,
      "title": "Goldens ready (per distro, kernel + ZFS version)",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 97
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "klab_golden_info",
