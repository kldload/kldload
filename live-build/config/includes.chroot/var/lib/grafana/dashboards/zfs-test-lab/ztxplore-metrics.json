      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "zfs_arcstat{metric=\"size\"}",
          "refId": "A",
          "legendFormat": "size"
        },
        {
          "expr": "zfs_arcstat{metric=\"c\"}",
