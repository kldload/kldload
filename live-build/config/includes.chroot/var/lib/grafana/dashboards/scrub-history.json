{
  "title": "ZFS Scrub History & Errors",
  "uid": "scrub-history",
  "tags": ["zfs","kldload","scrub"],
  "timezone": "",
  "refresh": "60s",
  "schemaVersion": 39,
  "time": {"from": "now-7d", "to": "now"},
  "templating": {"list": [{
    "name": "pool", "type": "query",
    "datasource": {"type":"prometheus","uid":"prometheus"},
    "query": "label_values(zpool_scrub_in_progress, pool)",
    "refresh": 2, "multi": false, "includeAll": false,
    "current": {"text":"rpool","value":"rpool"}
  }]},
  "panels": [
    {"id":1,"title":"Days since last scrub","type":"stat","gridPos":{"x":0,"y":0,"w":6,"h":5},
     "datasource":{"type":"prometheus","uid":"prometheus"},
     "targets":[{"expr":"(time() - zpool_scrub_last_timestamp{pool=\"$pool\"}) / 86400","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"none","decimals":1,"thresholds":{"steps":[{"value":0,"color":"green"},{"value":14,"color":"orange"},{"value":30,"color":"red"}]}}}},
    {"id":2,"title":"Last scrub duration","type":"stat","gridPos":{"x":6,"y":0,"w":6,"h":5},
     "datasource":{"type":"prometheus","uid":"prometheus"},
     "targets":[{"expr":"zpool_scrub_last_duration_seconds{pool=\"$pool\"}","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"s"}}},
    {"id":3,"title":"Last scrub errors","type":"stat","gridPos":{"x":12,"y":0,"w":6,"h":5},
     "datasource":{"type":"prometheus","uid":"prometheus"},
     "targets":[{"expr":"zpool_scrub_last_errors{pool=\"$pool\"}","refId":"A"}],
     "fieldConfig":{"defaults":{"thresholds":{"steps":[{"value":0,"color":"green"},{"value":1,"color":"red"}]}}}},
    {"id":4,"title":"Scrub in progress","type":"stat","gridPos":{"x":18,"y":0,"w":6,"h":5},
     "datasource":{"type":"prometheus","uid":"prometheus"},
     "targets":[{"expr":"zpool_scrub_in_progress{pool=\"$pool\"}","refId":"A"}],
     "fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"IDLE","color":"green"},"1":{"text":"SCRUBBING","color":"blue"}}}]}}},
    {"id":5,"title":"Scrub progress (when running)","type":"gauge","gridPos":{"x":0,"y":5,"w":12,"h":6},
     "datasource":{"type":"prometheus","uid":"prometheus"},
     "targets":[{"expr":"zpool_scrub_progress_ratio{pool=\"$pool\"} * 100","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100}}},
    {"id":6,"title":"Per-vdev error counts","type":"table","gridPos":{"x":12,"y":5,"w":12,"h":6},
     "datasource":{"type":"prometheus","uid":"prometheus"},
     "targets":[
       {"expr":"zpool_read_errors{pool=\"$pool\"}","refId":"A","format":"table","instant":true,"legendFormat":"read"},
       {"expr":"zpool_write_errors{pool=\"$pool\"}","refId":"B","format":"table","instant":true,"legendFormat":"write"},
       {"expr":"zpool_checksum_errors{pool=\"$pool\"}","refId":"C","format":"table","instant":true,"legendFormat":"cksum"}
     ],
     "transformations":[{"id":"organize","options":{"excludeByName":{"Time":true,"__name__":true,"instance":true,"job":true,"pool":true}}}]},
    {"id":7,"title":"Scrub timeline (zed events)","type":"logs","gridPos":{"x":0,"y":11,"w":24,"h":10},
     "datasource":{"type":"loki","uid":"loki"},
     "targets":[{"expr":"{job=\"zed\",pool=\"$pool\"} |~ \"scrub|resilver|trim\"","refId":"A"}],
     "options":{"showTime":true,"wrapLogMessage":true,"sortOrder":"Descending","dedupStrategy":"none","enableLogDetails":true}},
    {"id":8,"title":"All zed events on this pool","type":"logs","gridPos":{"x":0,"y":21,"w":24,"h":10},
     "datasource":{"type":"loki","uid":"loki"},
     "targets":[{"expr":"{job=\"zed\",pool=\"$pool\"}","refId":"A"}],
     "options":{"showTime":true,"wrapLogMessage":true,"sortOrder":"Descending","dedupStrategy":"none","enableLogDetails":true}}
  ]
}
