              "destination": "Destination",
              "destination_namespace": "Dst NS",
              "verdict": "Verdict",
              "Value": "Flows/sec"
            },
            "indexByName": {
              "Source": 0,
              "Src NS": 1,
              "Destination": 2,
              "Dst NS": 3,
              "Verdict": 4,
              "Flows/sec": 5
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [{ "field": "Flows/sec", "desc": true }]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Flows/sec", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Verdict" },
