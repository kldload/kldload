                { "type": "value", "options": { "FORWARDED": { "color": "green", "index": 0 } } },
                { "type": "value", "options": { "DROPPED":   { "color": "red",   "index": 1 } } },
                { "type": "value", "options": { "ERROR":     { "color": "orange","index": 2 } } }
              ]
            },
            { "id": "custom.cellOptions", "value": { "type": "color-text" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Flows/sec" },
            "properties": [
              { "id": "decimals", "value": 2 },
              { "id": "unit", "value": "reqps" }
            ]
          }
        ]
      },
      "description": "Top 50 src→dst workload pairs by flow rate, including verdict. DROPPED rows are policy enforcement; ERROR rows are kernel-side errors (rare). Use this as the data sanity check when the topology panel looks empty — if rows are here, the data path is working."
    },
