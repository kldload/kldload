          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "source": "Source",
              "source_namespace": "Src NS",
              "reason": "Drop reason",
              "Value": "Drops/sec"
            },
            "indexByName": {
              "Source": 0,
              "Src NS": 1,
              "Drop reason": 2,
              "Drops/sec": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [{ "field": "Drops/sec", "desc": true }]
          }
        }
      ],
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [{
          "matcher": { "id": "byName", "options": "Drops/sec" },
          "properties": [
            { "id": "decimals", "value": 2 },
            { "id": "unit", "value": "reqps" }
          ]
        }]
      },
      "description": "Every kernel-level packet drop in the last 5 minutes, attributed to the source workload and grouped by reason. Common reasons: POLICY_DENIED (a NetworkPolicy / CiliumNetworkPolicy blocked it), CT_INVALID (conntrack state mismatch), UNSUPPORTED_L3_PROTOCOL (IPv6 traffic on an IPv4-only datapath). The source attribution comes from the BPF endpoint identity map — the same identity Cilium uses for policy enforcement."
    }
