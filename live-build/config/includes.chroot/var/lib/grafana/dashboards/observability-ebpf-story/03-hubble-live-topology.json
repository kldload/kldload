        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(50, sum by (source, source_namespace, destination, destination_namespace, verdict) (rate(hubble_flows_processed_total{source!=\"\",destination!=\"\"}[5m])))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "source": "Source",
