            "fillOpacity": 25,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            }
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Cached + Buffers vs Free",
      "description": "Page cache is the workload's friend (re-read avoidance) \u2014 Linux uses all free RAM for it. Sudden cache drop = something forced reclaim hard.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "id": 132,
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_Cached_bytes",
          "legendFormat": "page cache"
        },
        {
          "refId": "B",
          "expr": "node_memory_Buffers_bytes",
          "legendFormat": "buffers"
        },
        {
          "refId": "C",
          "expr": "node_memory_MemFree_bytes",
          "legendFormat": "free"
        }
      ],
      "fieldConfig": {
