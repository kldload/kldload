    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "id": 121,
      "options": {
        "mode": "markdown",
        "content": "Cilium stores connection state, identity mappings, policy decisions, and load-balancer state in BPF maps. Each map has a fixed size; when it fills, Cilium starts evicting or rejecting entries. **Map pressure > 0.85** is the early-warning signal for a busy cluster."
      }
    },
    {
      "type": "timeseries",
      "title": "BPF map pressure \u2014 top 15 maps (fullness ratio)",
      "description": "1.0 = map is full. >0.85 = consider sizing up via Cilium config.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "id": 122,
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, cilium_bpf_map_pressure)",
          "legendFormat": "{{map_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            }
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "BPF map operations/sec (top 10)",
      "description": "Operations breakdown by map. lookup=read, update=write. Heavy update on conntrack = high connection churn.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "id": 123,
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (map_name, operation) (rate(cilium_bpf_map_ops_total[2m])))",
          "legendFormat": "{{map_name}}:{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
