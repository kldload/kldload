        "h": 5,
        "w": 6,
        "x": 12,
        "y": 7
      },
      "id": 113,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hubble_tcp_flags_total{flag='RST'}[2m])) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        }
      }
    },
    {
      "type": "stat",
      "title": "ICMP/sec",
      "description": "Pings + diagnostics + path-MTU.",
