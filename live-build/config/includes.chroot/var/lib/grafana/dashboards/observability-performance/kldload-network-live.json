    {
      "type": "timeseries",
      "title": "TCP state transitions/sec (every flag)",
      "description": "Every TCP state event the datapath saw. SYN/ACK ratio tells you connection success. FIN dominates clean shutdowns. RST surge = something is aborting.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 115,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (flag) (rate(hubble_tcp_flags_total[1m])) or vector(0)",
          "legendFormat": "{{flag}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Drops by verdict \u2014 root cause is in the labels",
