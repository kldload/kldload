{
  "annotations": {
    "list": []
  },
  "title": "Host \u2014 Kernel & System Logs",
  "uid": "kernel-messages",
  "tags": [
    "host",
    "logs",
    "kldload",
    "loki"
  ],
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "Live log streams kldload's promtail ships to Loki \u2014 ZED ZFS events, kldload tooling output, ZFS module debug, klab test runs. Plus journald (when promtail has read access \u2014 see footer note).",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Counters \u2014 last 15min",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "ZED events (24h)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "ZFS Event Daemon \u2014 pool import, scrub start/finish, errors. Every state change in any zpool fires here.",
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"zed\"}[24h]))",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green"
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "kldload-apps (24h)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Output of kldload's own tools \u2014 kube-cluster, klab, install-target, firstboot, webui.",
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"kldload-apps\"}[24h]))",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "ZFS dbgmsg (24h)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "ZFS module's kernel debug ring \u2014 txg sync stats, ARC events, async destroy progress.",
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"zfs-dbgmsg\"}[24h]))",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "klab tests (24h)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Output from klab test runs.",
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"klab-test-logs\"}[24h]))",
