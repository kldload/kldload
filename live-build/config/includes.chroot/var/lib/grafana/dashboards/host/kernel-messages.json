    {
      "id": 14,
      "type": "stat",
      "title": "systemd journal (24h)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Empty box \u2192 promtail can't read /run/log/journal/ (usually a perms issue \u2014 see footer for the fix).",
