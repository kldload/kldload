{
  "annotations": {"list": []},
  "title": "Kubernetes — Cilium Agent",
  "uid": "vtuWtdumz",
  "tags": ["cilium", "kubernetes", "kldload", "ebpf"],
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-30m", "to": "now"},
  "description": "Cilium agent runtime — endpoints, BPF maps, policies, drops/forwards, controllers. Uses metric names that current Cilium (1.18-class) actually emits on kldload's K8s cluster — not the generic community names that don't match.",
  "panels": [
    {"id":1,"type":"row","title":"Agent state","gridPos":{"h":1,"w":24,"x":0,"y":0},"collapsed":false},
    {"id":10,"type":"stat","title":"Endpoints managed","gridPos":{"h":4,"w":4,"x":0,"y":1},
     "targets":[{"expr":"sum(cilium_endpoint)","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"short","color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green"}]}}},
     "options":{"colorMode":"background"}},
    {"id":11,"type":"stat","title":"Cluster identities","gridPos":{"h":4,"w":4,"x":4,"y":1},
     "targets":[{"expr":"sum(cilium_identity)","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"short"}}},
    {"id":12,"type":"stat","title":"NetworkPolicies","gridPos":{"h":4,"w":4,"x":8,"y":1},
     "targets":[{"expr":"sum(cilium_policy)","refId":"A"}]},
    {"id":13,"type":"stat","title":"Failing controllers","gridPos":{"h":4,"w":4,"x":12,"y":1},
     "targets":[{"expr":"sum(cilium_controllers_failing)","refId":"A"}],
     "fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green"},{"color":"red","value":1}]}}},
     "options":{"colorMode":"background"}},
    {"id":14,"type":"stat","title":"Unreachable nodes","gridPos":{"h":4,"w":4,"x":16,"y":1},
     "targets":[{"expr":"sum(cilium_unreachable_nodes)","refId":"A"}],
     "fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green"},{"color":"red","value":1}]}}},
     "options":{"colorMode":"background"}},
    {"id":15,"type":"stat","title":"K8s nodes seen","gridPos":{"h":4,"w":4,"x":20,"y":1},
     "targets":[{"expr":"sum(cilium_nodes_all_num)","refId":"A"}]},

    {"id":20,"type":"row","title":"BPF data path","gridPos":{"h":1,"w":24,"x":0,"y":5}},
    {"id":21,"type":"timeseries","title":"BPF map pressure — top 10","gridPos":{"h":8,"w":12,"x":0,"y":6},
     "description":"Fullness ratio per BPF map. Approaching 1.0 = the map's about to evict — sizing should be increased.",
     "targets":[{"expr":"topk(10, cilium_bpf_map_pressure)","legendFormat":"{{map_name}}","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"percentunit","custom":{"drawStyle":"line","lineWidth":2,"fillOpacity":15}}}},
    {"id":22,"type":"timeseries","title":"BPF map ops/sec","gridPos":{"h":8,"w":12,"x":12,"y":6},
     "targets":[{"expr":"sum by (operation) (rate(cilium_bpf_map_ops_total[1m]))","legendFormat":"{{operation}}","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"ops","custom":{"drawStyle":"line","lineWidth":2,"fillOpacity":15,"stacking":{"mode":"normal"}}}}},
    {"id":23,"type":"stat","title":"BPF maps memory","gridPos":{"h":4,"w":6,"x":0,"y":14},
     "targets":[{"expr":"sum(cilium_bpf_maps_virtual_memory_max_bytes)","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"bytes"}}},
    {"id":24,"type":"stat","title":"BPF programs memory","gridPos":{"h":4,"w":6,"x":6,"y":14},
     "targets":[{"expr":"sum(cilium_bpf_progs_virtual_memory_max_bytes)","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"bytes"}}},
    {"id":25,"type":"stat","title":"Conntrack entries","gridPos":{"h":4,"w":6,"x":12,"y":14},
     "targets":[{"expr":"sum(cilium_datapath_conntrack_gc_entries)","refId":"A"}]},
    {"id":26,"type":"stat","title":"Conntrack GC runs/sec","gridPos":{"h":4,"w":6,"x":18,"y":14},
     "targets":[{"expr":"sum(rate(cilium_datapath_conntrack_gc_runs_total[5m]))","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"ops","decimals":3}}},

    {"id":30,"type":"row","title":"Traffic & drops","gridPos":{"h":1,"w":24,"x":0,"y":18}},
    {"id":31,"type":"timeseries","title":"Forward bytes/sec","gridPos":{"h":7,"w":12,"x":0,"y":19},
     "targets":[{"expr":"sum by (direction) (rate(cilium_forward_bytes_total[1m]))","legendFormat":"{{direction}}","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"Bps","custom":{"drawStyle":"line","lineWidth":2,"fillOpacity":15}}}},
    {"id":32,"type":"timeseries","title":"Drop bytes/sec — by reason","gridPos":{"h":7,"w":12,"x":12,"y":19},
     "description":"Top reasons Cilium dropped packets. Sustained drops = real problem; transient = normal cluster churn.",
     "targets":[{"expr":"sum by (reason) (rate(cilium_drop_bytes_total[1m]))","legendFormat":"{{reason}}","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"Bps","custom":{"drawStyle":"line","lineWidth":2,"fillOpacity":15,"stacking":{"mode":"normal"}}}}},

    {"id":40,"type":"row","title":"API + K8s control plane interaction","gridPos":{"h":1,"w":24,"x":0,"y":26}},
    {"id":41,"type":"heatmap","title":"Agent API process time (heatmap)","gridPos":{"h":8,"w":12,"x":0,"y":27},
     "description":"Distribution of API handler durations. Hot top-right = slow API. Solid stripe at bottom = healthy fast responses.",
     "targets":[{"expr":"sum by (le) (rate(cilium_agent_api_process_time_seconds_bucket[1m]))","format":"heatmap","refId":"A"}],
     "options":{"calculate":false,"yAxis":{"unit":"s"}}},
    {"id":42,"type":"timeseries","title":"K8s workqueue depth","gridPos":{"h":8,"w":12,"x":12,"y":27},
     "description":"How deep are the K8s event queues — sustained depth means cilium is falling behind cluster events.",
     "targets":[{"expr":"sum by (name) (cilium_k8s_workqueue_depth)","legendFormat":"{{name}}","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"short","custom":{"drawStyle":"line","lineWidth":2,"fillOpacity":15}}}},

    {"id":50,"type":"row","title":"Process","gridPos":{"h":1,"w":24,"x":0,"y":35}},
    {"id":51,"type":"timeseries","title":"Cilium-agent CPU","gridPos":{"h":6,"w":12,"x":0,"y":36},
     "targets":[{"expr":"rate(cilium_process_cpu_seconds_total[1m])","legendFormat":"cilium-agent","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"percentunit","custom":{"drawStyle":"line","lineWidth":2,"fillOpacity":15}}}},
    {"id":52,"type":"timeseries","title":"Cilium-agent resident memory","gridPos":{"h":6,"w":12,"x":12,"y":36},
     "targets":[{"expr":"cilium_process_resident_memory_bytes","legendFormat":"cilium-agent","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"bytes","custom":{"drawStyle":"line","lineWidth":2,"fillOpacity":15}}}}
  ]
}
