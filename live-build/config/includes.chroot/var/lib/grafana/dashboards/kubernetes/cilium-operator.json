{
  "annotations": {"list": []},
  "title": "Kubernetes — Cilium Operator",
  "uid": "1GC0TT4Wz",
  "tags": ["cilium", "operator", "kubernetes", "kldload"],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "description": "Cilium Operator — cluster-wide reconciliation. Manages identities, IPAM (LB-IPAM if enabled), CES batching, errors+warnings. One per cluster; failures here cascade.",
  "panels": [
    {"id":1,"type":"row","title":"Operator process","gridPos":{"h":1,"w":24,"x":0,"y":0}},
    {"id":10,"type":"stat","title":"Operator CPU","gridPos":{"h":5,"w":6,"x":0,"y":1},
     "targets":[{"expr":"rate(cilium_operator_process_cpu_seconds_total[5m])","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"percentunit","decimals":3,"color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green"},{"color":"yellow","value":0.5},{"color":"red","value":1.0}]}}},
     "options":{"colorMode":"background","graphMode":"area"}},
    {"id":11,"type":"stat","title":"Operator RSS","gridPos":{"h":5,"w":6,"x":6,"y":1},
     "targets":[{"expr":"cilium_operator_process_resident_memory_bytes","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"bytes"}}},
    {"id":12,"type":"stat","title":"Open file descriptors","gridPos":{"h":5,"w":6,"x":12,"y":1},
     "targets":[{"expr":"cilium_operator_process_open_fds","refId":"A"}]},
    {"id":13,"type":"stat","title":"FD limit","gridPos":{"h":5,"w":6,"x":18,"y":1},
     "targets":[{"expr":"cilium_operator_process_max_fds","refId":"A"}]},

    {"id":20,"type":"row","title":"Errors & warnings","gridPos":{"h":1,"w":24,"x":0,"y":6}},
    {"id":21,"type":"timeseries","title":"Errors/warnings/sec — by subsystem","gridPos":{"h":8,"w":24,"x":0,"y":7},
     "description":"Sustained errors here = cluster-wide reconciliation pain. Investigate immediately.",
     "targets":[{"expr":"sum by (subsystem, level) (rate(cilium_operator_errors_warnings_total[1m]))","legendFormat":"{{subsystem}} ({{level}})","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"short","custom":{"drawStyle":"line","lineWidth":2,"fillOpacity":15}}}},

    {"id":30,"type":"row","title":"Identity garbage collection","gridPos":{"h":1,"w":24,"x":0,"y":15}},
    {"id":31,"type":"stat","title":"Identity GC runs","gridPos":{"h":5,"w":8,"x":0,"y":16},
     "description":"Cilium identities accrue as workloads come and go. GC reclaims them.",
     "targets":[{"expr":"cilium_operator_identity_gc_runs","refId":"A"}]},
    {"id":32,"type":"timeseries","title":"Identity GC entries — over time","gridPos":{"h":5,"w":16,"x":8,"y":16},
     "targets":[{"expr":"cilium_operator_identity_gc_entries","legendFormat":"{{status}}","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"short","custom":{"drawStyle":"line","lineWidth":2,"fillOpacity":15}}}},

    {"id":40,"type":"row","title":"LoadBalancer IPAM (LBIPAM)","gridPos":{"h":1,"w":24,"x":0,"y":21}},
    {"id":41,"type":"stat","title":"Services matched","gridPos":{"h":5,"w":8,"x":0,"y":22},
     "targets":[{"expr":"sum(cilium_operator_lbipam_services_matching_total)","refId":"A"}],
     "fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green"}]}}},"options":{"colorMode":"background"}},
    {"id":42,"type":"stat","title":"Services unsatisfied","gridPos":{"h":5,"w":8,"x":8,"y":22},
     "description":"LB-IPAM couldn't allocate an IP for the service. Pool exhausted or misconfigured.",
     "targets":[{"expr":"sum(cilium_operator_lbipam_services_unsatisfied_total)","refId":"A"}],
     "fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green"},{"color":"red","value":1}]}}},"options":{"colorMode":"background"}},
    {"id":43,"type":"stat","title":"Pool conflicts","gridPos":{"h":5,"w":8,"x":16,"y":22},
     "targets":[{"expr":"sum(cilium_operator_lbipam_conflicting_pools_total)","refId":"A"}],
     "fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green"},{"color":"red","value":1}]}}},"options":{"colorMode":"background"}},

    {"id":50,"type":"row","title":"CiliumEndpointSlice (CES) batching","gridPos":{"h":1,"w":24,"x":0,"y":27}},
    {"id":51,"type":"heatmap","title":"CES queueing delay (heatmap)","gridPos":{"h":7,"w":12,"x":0,"y":28},
     "description":"Time CES updates spend in the queue before processing. Hot top = operator falling behind.",
     "targets":[{"expr":"sum by (le) (rate(cilium_operator_ces_queueing_delay_seconds_bucket[5m]))","format":"heatmap","refId":"A"}],
     "options":{"calculate":false,"yAxis":{"unit":"s"}}},
    {"id":52,"type":"heatmap","title":"Endpoints per CES (heatmap)","gridPos":{"h":7,"w":12,"x":12,"y":28},
     "description":"How many endpoints per batched CES object. Higher = better batching = less kube-apiserver pressure.",
     "targets":[{"expr":"sum by (le) (rate(cilium_operator_number_of_ceps_per_ces_bucket[5m]))","format":"heatmap","refId":"A"}],
     "options":{"calculate":false,"yAxis":{"unit":"short"}}}
  ]
}
