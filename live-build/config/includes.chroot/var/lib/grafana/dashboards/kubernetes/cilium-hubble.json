{
  "annotations": {"list": []},
  "title": "Kubernetes — Hubble (Network L4-L7)",
  "uid": "5HftnJAWz",
  "tags": ["hubble", "cilium", "kubernetes", "kldload", "ebpf"],
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-15m", "to": "now"},
  "description": "Hubble — Cilium's eBPF-powered network observability layer. Shows L4/L7 flow stats from inside the kernel, not from app-level instrumentation. The 'no app cooperation needed' demo — Hubble sees every TCP/UDP/ICMP packet pod-to-pod even when the apps don't log them.",
  "panels": [
    {"id":1,"type":"row","title":"Live flow stats","gridPos":{"h":1,"w":24,"x":0,"y":0}},
    {"id":10,"type":"stat","title":"Flows/sec (last 1m)","gridPos":{"h":5,"w":6,"x":0,"y":1},
     "description":"Every packet pod-to-pod that Hubble's BPF programs saw — kernel-level truth.",
     "targets":[{"expr":"sum(rate(hubble_flows_processed_total[1m]))","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"flows/s","decimals":1,"color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green"}]}}},
     "options":{"colorMode":"background","graphMode":"area"}},
    {"id":11,"type":"stat","title":"Drops/sec","gridPos":{"h":5,"w":6,"x":6,"y":1},
     "targets":[{"expr":"sum(rate(hubble_drop_total[1m]))","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"flows/s","decimals":2,"color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green"},{"color":"yellow","value":1},{"color":"red","value":10}]}}},
     "options":{"colorMode":"background","graphMode":"area"}},
    {"id":12,"type":"stat","title":"Lost events/sec","gridPos":{"h":5,"w":6,"x":12,"y":1},
     "description":"Hubble's ring buffer overflowed — sustained loss = sizing problem.",
     "targets":[{"expr":"sum(rate(hubble_lost_events_total[1m]))","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"flows/s","decimals":2,"color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green"},{"color":"red","value":1}]}}},
     "options":{"colorMode":"background"}},
    {"id":13,"type":"stat","title":"ICMP/sec","gridPos":{"h":5,"w":6,"x":18,"y":1},
     "targets":[{"expr":"sum(rate(hubble_icmp_total[1m]))","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"flows/s","decimals":2}}},

    {"id":20,"type":"row","title":"Drops — what & why","gridPos":{"h":1,"w":24,"x":0,"y":6}},
    {"id":21,"type":"timeseries","title":"Drops/sec — by reason","gridPos":{"h":8,"w":12,"x":0,"y":7},
     "description":"Common reasons: 'Policy denied' (NetworkPolicy did its job), 'No route' (misconfig), 'Stale or unroutable IP' (pod churn). Sustained one-reason spike = real problem.",
     "targets":[{"expr":"sum by (reason) (rate(hubble_drop_total[1m]))","legendFormat":"{{reason}}","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"flows/s","custom":{"drawStyle":"line","lineWidth":2,"fillOpacity":15,"stacking":{"mode":"normal"}}}}},
    {"id":22,"type":"timeseries","title":"Drops/sec — by protocol","gridPos":{"h":8,"w":12,"x":12,"y":7},
     "targets":[{"expr":"sum by (protocol) (rate(hubble_drop_total[1m]))","legendFormat":"{{protocol}}","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"flows/s","custom":{"drawStyle":"bars","lineWidth":1,"fillOpacity":40,"stacking":{"mode":"normal"}}}}},

    {"id":30,"type":"row","title":"Traffic shape","gridPos":{"h":1,"w":24,"x":0,"y":15}},
    {"id":31,"type":"piechart","title":"TCP flag distribution (last 5m)","gridPos":{"h":8,"w":8,"x":0,"y":16},
     "description":"Heavy SYN = lots of connection attempts. Heavy RST = lots of forced closes (apps crashing, scans). Healthy clusters tend to look ACK-heavy.",
     "targets":[{"expr":"sum by (flag) (increase(hubble_tcp_flags_total[5m]))","legendFormat":"{{flag}}","refId":"A"}],
     "options":{"displayLabels":["name","percent"],"legend":{"showLegend":true,"placement":"right"},"pieType":"donut"}},
    {"id":32,"type":"bargauge","title":"Top 15 ports (by flows last 5m)","gridPos":{"h":8,"w":8,"x":8,"y":16},
     "description":"Which ports are seeing the most traffic. Spike on an unexpected port = investigate.",
     "targets":[{"expr":"topk(15, sum by (port) (increase(hubble_port_distribution_total[5m])))","legendFormat":"{{port}}","refId":"A","instant":true}],
     "options":{"displayMode":"gradient","valueMode":"color"}},
    {"id":33,"type":"timeseries","title":"Flows by verdict (forward vs drop)","gridPos":{"h":8,"w":8,"x":16,"y":16},
     "targets":[{"expr":"sum by (verdict) (rate(hubble_flows_processed_total[1m]))","legendFormat":"{{verdict}}","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"flows/s","custom":{"drawStyle":"line","lineWidth":2,"fillOpacity":15}}}},

    {"id":40,"type":"row","title":"Hubble exporter health","gridPos":{"h":1,"w":24,"x":0,"y":24}},
    {"id":41,"type":"heatmap","title":"Hubble HTTP handler latency (heatmap)","gridPos":{"h":7,"w":12,"x":0,"y":25},
     "description":"How fast Hubble's own metric exporter responds. Slow = check Hubble pod resources.",
     "targets":[{"expr":"sum by (le) (rate(hubble_metrics_http_handler_request_duration_seconds_bucket[1m]))","format":"heatmap","refId":"A"}],
     "options":{"calculate":false,"yAxis":{"unit":"s"}}},
    {"id":42,"type":"timeseries","title":"Hubble HTTP handler requests/sec","gridPos":{"h":7,"w":12,"x":12,"y":25},
     "targets":[{"expr":"sum by (code) (rate(hubble_metrics_http_handler_requests_total[1m]))","legendFormat":"HTTP {{code}}","refId":"A"}],
     "fieldConfig":{"defaults":{"unit":"reqps","custom":{"drawStyle":"line","lineWidth":2,"fillOpacity":15}}}}
  ]
}
