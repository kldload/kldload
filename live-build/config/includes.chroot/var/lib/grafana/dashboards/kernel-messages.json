{
  "title": "Kernel & System Messages",
  "uid": "kernel-messages",
  "tags": [
    "kernel",
    "logs",
    "kldload"
  ],
  "timezone": "",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Log Volume (last hr)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (transport) (rate({job=\"systemd-journal\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{transport}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s"
        }
      }
    },
    {
      "id": 2,
      "title": "Kernel ring buffer",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{transport=\"kernel\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "exact",
        "enableLogDetails": true
      }
    },
    {
      "id": 3,
      "title": "ZFS-related messages (kernel + modules)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{host=\"kldload-node\"} |~ \"(?i)(zfs|zpool|arc_|spa_|dsl_)\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true
      }
    },
    {
      "id": 4,
      "title": "Systemd unit errors (last hr)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{job=\"systemd-journal\"} |~ \"(?i)(error|failed|fatal)\" != \"non-fatal\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true
      }
    }
  ]
}