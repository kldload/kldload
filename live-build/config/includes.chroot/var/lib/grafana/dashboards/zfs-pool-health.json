{
  "title": "ZFS Pool Health",
  "uid": "zfs-pool-health",
  "tags": [
    "zfs",
    "kldload"
  ],
  "timezone": "",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "pool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(zfs_pool_health, pool)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "rpool",
          "value": "rpool"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Health",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "zfs_pool_health{pool=\"$pool\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ONLINE",
                  "color": "green"
                },
                "1": {
                  "text": "DEGRADED",
                  "color": "orange"
                },
                "2": {
                  "text": "FAULTED",
                  "color": "red"
                },
                "3": {
                  "text": "OFFLINE",
                  "color": "red"
                },
                "4": {
                  "text": "UNAVAIL",
                  "color": "red"
                },
                "5": {
                  "text": "REMOVED",
                  "color": "red"
                },
                "6": {
                  "text": "SUSPENDED",
                  "color": "red"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Capacity",
      "type": "gauge",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * zfs_pool_allocated_bytes{pool=\"$pool\"} / zfs_pool_size_bytes{pool=\"$pool\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 70,
                "color": "orange"
              },
              {
                "value": 85,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Fragmentation",
      "type": "gauge",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "zfs_pool_fragmentation_ratio{pool=\"$pool\"} * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 50,
                "color": "orange"
              },
              {
                "value": 70,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Dedup Ratio",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "zfs_pool_deduplication_ratio{pool=\"$pool\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2
        }
      }
    },
    {
      "id": 5,
      "title": "Free Space",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "zfs_pool_free_bytes{pool=\"$pool\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 6,
      "title": "Allocated",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "zfs_pool_allocated_bytes{pool=\"$pool\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 7,
      "title": "ARC Hit Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(zfs_arcstat{metric=\"hits\"}[5m])) / sum(rate(zfs_arcstat{metric=~\"hits|misses\"}[5m]))",
          "refId": "A",
          "legendFormat": "ARC hit %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 8,
      "title": "ARC Size vs Target",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "zfs_arcstat{metric=\"size\"}",
          "refId": "A",
          "legendFormat": "size"
        },
        {
          "expr": "zfs_arcstat{metric=\"c\"}",
          "refId": "B",
          "legendFormat": "target"
        },
        {
          "expr": "zfs_arcstat{metric=\"c_max\"}",
          "refId": "C",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 9,
      "title": "Dataset Top 10 \u2014 Used",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "topk(10, zfs_dataset_used_bytes{pool=\"$pool\"})",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pool": true,
              "type": true
            },
            "renameByName": {
              "name": "Dataset",
              "Value": "Used"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "title": "Dataset Top 10 \u2014 Compression Ratio (logical/physical)",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "topk(10, zfs_dataset_logical_used_bytes{pool=\"$pool\"} / ignoring(__name__) zfs_dataset_used_bytes{pool=\"$pool\"})",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pool": true,
              "type": true
            },
            "renameByName": {
              "name": "Dataset",
              "Value": "Ratio"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2
        }
      }
    },
    {
      "id": 11,
      "title": "ZFS Module Debug Messages (dbgmsg)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{job=\"zfs-dbgmsg\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true
      }
    },
    {
      "id": 12,
      "title": "ZFS Events (zed) \u2014 checksum, resilver, scrub, vdev state",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{job=\"zed\",pool=\"$pool\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}