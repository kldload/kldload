[Desktop Entry]
# Default Konsole profile = kldload.profile (ships at /usr/share/konsole/).
# That profile enables AutoCopySelectedText so mouse-drag selections land
# in the system clipboard on release. Without DefaultProfile here, Konsole
# opens with the FALLBACK profile that doesn't auto-copy on drag — operator
# on .142 b644: "copy paste functionality and buttons is missing."
DefaultProfile=kldload.profile

[MainWindow]
# Re-enable menubar so the operator has visible Edit menu (Copy / Paste /
# Find / etc.) buttons. Earlier sysdiag setup hid the menubar for
# minimalism but operator on .142 b644 noted: "buttons is missing" —
# i.e. nothing visible to click for copy/paste. The menubar adds one
# row of chrome but gives every Konsole action a visible affordance.
MenuBar=Enabled

[Shortcuts]
# kldload: free F11 from Konsole's "Toggle Fullscreen" action so it can
# reach the inner tmux session. The sysdiag cockpit (kldload-sysdiag) and
# the klab cockpit (kldload-console) both bind F11 to a _kgroup mini-
# cockpit. Without this, F11 toggles Konsole's fullscreen state — sysdiag
# spawns the windows underneath but the user just sees the terminal shrink.
view-full-screen=none
View Fullscreen=none
View:FullScreen=none
view_fullscreen=none
fullscreen=none

[FileLocation]
scrollbackUseCacheLocation=true
scrollbackUseSystemLocation=false

[UiSettings]
ColorScheme=
