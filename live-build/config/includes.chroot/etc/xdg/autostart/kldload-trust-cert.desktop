[Desktop Entry]
Type=Application
Name=kldload Trust Cert
Comment=Import kldload TLS cert into Chrome NSS DB so https://localhost:8443 is trusted without --ignore-certificate-errors
Exec=/usr/local/bin/kldload-trust-cert
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=2
StartupNotify=false
