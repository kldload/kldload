#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# 98-kldload-heal-pending — retry failed desktop-package heals when a network
# actually exists.
#
# What it does, in order:
#   1. Fires on NetworkManager 'up' / 'connectivity-change' events only.
#   2. If /var/lib/kldload/heal-pending lists packages (written by
#      kldload-firstboot's healing net when a dnf install missed), probes for
#      real reachability, ensures RPM Fusion when steam is queued (Fedora,
#      GPU-agnostic), then retries each package.
#   3. Successes leave the queue; failures stay queued for the next event.
#      When the queue empties, the file is removed and desktop/icon caches
#      are rebuilt so late-healed apps appear in the grid WITHOUT a re-login.
#
# WHY: kldload-firstboot runs exactly once (firstboot-done gate). Before this
# hook, a package that missed there — most often because first boot raced the
# network, or a repo prerequisite was absent — stayed missing forever with
# only a log-line WARNING (steam on the XPS 13, 2026-08-05). Retrying on
# network-up matches the failure cause instead of a blind timer.
#
# INPUT:  $1 = interface, $2 = action (NetworkManager dispatcher contract).
# STATE:  /var/lib/kldload/heal-pending — one package name per line.
# OUTPUT: /var/log/kldload/heal.log
# Notes:  flock guard — dispatcher can fire for several interfaces at once.
# ─────────────────────────────────────────────────────────────────────────────
set -Eeuo pipefail

IFACE="${1:-}"
ACTION="${2:-}"
PENDING=/var/lib/kldload/heal-pending
LOG=/var/log/kldload/heal.log

case "$ACTION" in
up | connectivity-change) ;;
*) exit 0 ;;
esac
[[ -s "$PENDING" ]] || exit 0

# Which package manager is this? The hook used to be `command -v dnf || exit 0`,
# which meant a Debian desktop queued packages that nothing ever drained: the
# queue grew forever and Steam never arrived (fiend, 2026-08-15 — a Debian
# desktop install with no Steam at all, and no log line explaining why).
if command -v dnf >/dev/null 2>&1; then
    _pm=dnf
elif command -v apt-get >/dev/null 2>&1; then
    _pm=apt
else
    exit 0
fi

exec 9>/run/kldload-heal.lock
flock -n 9 || exit 0

mkdir -p /var/log/kldload
_log() { printf '[%s] [heal] %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }

# _have_pkg / _install_pkg — the two operations this hook needs, per package
# manager, so the drain loop below stays one loop.
#
# Steam is the reason apt needs a special case: Debian's package is
# steam-installer (a bootstrap that fetches the client on first launch), so a
# queue entry of "steam" would never resolve.
_have_pkg() {
    case "$_pm" in
    dnf) rpm -q "$1" >/dev/null 2>&1 ;;
    apt) dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "ok installed" ;;
    esac
}
_install_pkg() {
    case "$_pm" in
    dnf) dnf install -y "$1" >>"$LOG" 2>&1 ;;
    apt) DEBIAN_FRONTEND=noninteractive apt-get install -y "$1" >>"$LOG" 2>&1 ;;
    esac
}

# Real-reachability probe — dispatcher 'up' can precede usable routes/DNS.
# The probe targets the archive this box actually installs from; probing
# Fedora's mirrors on a Debian host fails for the wrong reason and keeps the
# queue parked forever.
if [[ "$_pm" == dnf ]]; then
    _probes=(https://mirrors.rpmfusion.org/ https://fedoraproject.org/)
else
    _probes=(https://deb.debian.org/ https://security.debian.org/)
fi
_reachable=0
for _u in "${_probes[@]}"; do
    curl -fsS -m 8 -o /dev/null "$_u" 2>/dev/null && _reachable=1 && break
done
if ((_reachable == 0)); then
    _log "network probe failed on ${IFACE}/${ACTION} — queue kept for next event"
    exit 0
fi

# apt needs its index before it can locate anything; on the first successful
# network event the lists are still the darksite mirror's.
if [[ "$_pm" == apt ]]; then
    DEBIAN_FRONTEND=noninteractive apt-get update >>"$LOG" 2>&1 || true
fi

# steam prerequisite: RPM Fusion release packages, Fedora only, any GPU —
# same ensure kldload-firstboot does; duplicated here because this hook must
# stand alone on systems whose firstboot predates that fix.
if [[ "$_pm" == dnf ]] && grep -qx steam "$PENDING" 2>/dev/null &&
    rpm -E %fedora 2>/dev/null | grep -qE '^[0-9]+$' &&
    ! rpm -q rpmfusion-nonfree-release >/dev/null 2>&1; then
    _fedver="$(rpm -E %fedora)"
    dnf install -y \
        "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-${_fedver}.noarch.rpm" \
        "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-${_fedver}.noarch.rpm" \
        >>"$LOG" 2>&1 || _log "WARNING: RPM Fusion release install failed — steam retry will miss"
fi

_still=()
while IFS= read -r _pkg; do
    [[ -n "$_pkg" ]] || continue
    if _have_pkg "$_pkg" || _install_pkg "$_pkg"; then
        _log "healed: $_pkg"
    else
        _log "still missing: $_pkg — kept queued"
        _still+=("$_pkg")
    fi
done <"$PENDING"

if ((${#_still[@]})); then
    printf '%s\n' "${_still[@]}" >"$PENDING"
else
    rm -f "$PENDING"
    _log "heal queue empty — all pending packages installed"
fi

# akmod-nvidia is not done when the RPM lands: akmods still has to build
# nvidia.ko against the running kernel, and dracut has to pick it up. The
# per-package loop above only knows "rpm -q succeeds", which for a driver is
# exactly the state that still leaves the desktop on nouveau.
#
# Only runs when nvidia was actually healed THIS pass and no module exists
# yet, so a normal steam retry never pays for a dracut run.
if rpm -q akmod-nvidia >/dev/null 2>&1 &&
    ! compgen -G "/lib/modules/$(uname -r)/extra/nvidia.ko*" >/dev/null 2>&1; then
    _log "akmod-nvidia present but nvidia.ko is not built — building"
    if command -v akmods >/dev/null 2>&1 &&
        akmods --force --kernels "$(uname -r)" >>"$LOG" 2>&1; then
        command -v dracut >/dev/null 2>&1 &&
            { dracut --force --regenerate-all >>"$LOG" 2>&1 ||
                _log "WARNING: dracut regenerate failed after the nvidia build"; }
        _log "nvidia.ko built — reboot once to load it"
    else
        _log "WARNING: akmods build failed — desktop stays on nouveau, see $LOG"
    fi
fi

# Late-healed apps stay invisible until the desktop DB + icon caches rebuild
# (same lesson as firstboot's own heal block, found on .111 2026-07-25).
command -v update-desktop-database >/dev/null 2>&1 &&
    update-desktop-database /usr/share/applications >>"$LOG" 2>&1 || true
command -v gtk-update-icon-cache >/dev/null 2>&1 &&
    gtk-update-icon-cache -f /usr/share/icons/hicolor >>"$LOG" 2>&1 || true
