<!-- kldload-managed pool: per-VM cloud-init seed ISOs (kube-cluster + klab + vm_create_cloud)
     Fixed UUID so virt-install never tries to auto-define this path. -->
<pool type='dir'>
  <name>cloud-init</name>
  <uuid>aa00cccd-0001-4d10-ad10-cd0010c100ad</uuid>
  <capacity unit='bytes'>0</capacity>
  <allocation unit='bytes'>0</allocation>
  <available unit='bytes'>0</available>
  <source/>
  <target>
    <path>/var/lib/kldload/cloud-init</path>
    <permissions><mode>0755</mode><owner>0</owner><group>0</group></permissions>
  </target>
</pool>
