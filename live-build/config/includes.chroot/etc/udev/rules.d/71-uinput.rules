# kldload: grant the local desktop user access to /dev/uinput so Steam (and
# emulators / remap tools) can create virtual gamepads. uaccess tags the node
# for the active-seat user via logind ACLs; the input-group + 0660 fallback
# covers non-seat / headless-with-input cases. Module is loaded by
# modules-load.d/uinput.conf.
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput", GROUP="input", MODE="0660"
