[Unit]
Description=Run kldload-zfs-dbgmsg-collector every 10s
Documentation=file:///usr/local/bin/kldload-zfs-dbgmsg-collector

[Timer]
# First fire shortly after boot so the panel has data on the dashboard's
# first refresh. After that, every 10s on top of the last completion —
# never overlapping with itself.
OnBootSec=15s
OnUnitInactiveSec=10s
AccuracySec=1s
Unit=kldload-zfs-dbgmsg.service

[Install]
WantedBy=timers.target
