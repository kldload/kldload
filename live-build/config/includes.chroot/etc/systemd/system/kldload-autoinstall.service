[Unit]
Description=KLDload Unattended Installer (seed disk or baked-in autoinstall.env)
Documentation=https://kldload.com/
# network-online because the seed can now arrive over HTTP: a netboot install
# is driven by kldload.seed=<url> on the kernel cmdline, and without this the
# unit races the NIC and the fetch fails on a machine that is perfectly fine.
# Harmless for the USB path -- a seed disk does not care that the link is up.
After=local-fs.target systemd-udev-settle.service network-online.target
Wants=systemd-udev-settle.service network-online.target
# Only run in the live environment, not on the installed system
ConditionPathExists=!/var/lib/kldload-installer/install-done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/kldload-autoinstall
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes
# Give udev time to settle and label disks before scanning
ExecStartPre=/bin/sleep 3
# Backstop for failures no trap can see -- SIGKILL, the OOM killer, a refusal
# in kldload-autoinstall before it execs the installer: the install show must
# say the install stopped (fiend, 2026-09-18, played on for an hour). Only when
# the unit failed and the installer left no result of its own. A live boot
# with no seed exits 0 ("skipping autoinstall"), so it never trips this.
# "-": a failed write here must not turn into a second failure.
ExecStopPost=-/bin/sh -c 'test "$$SERVICE_RESULT" = success || test -e /run/kldload/install-result || { mkdir -p /run/kldload && printf "failed\t%%s\t%%s\tkldload-autoinstall.service ended: %%s (%%s)\n" "$$EXIT_STATUS" "$$(date +%%s)" "$$SERVICE_RESULT" "$$EXIT_CODE" >/run/kldload/install-result; }'

[Install]
WantedBy=multi-user.target
