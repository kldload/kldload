[Unit]
Description=Bob AI Assistant — live boot setup
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/kldload/bob-live

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/bob-live
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
