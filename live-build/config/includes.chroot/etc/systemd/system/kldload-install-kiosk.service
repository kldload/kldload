# kldload-install-kiosk.service — the install show, with no desktop under it.
#
# Role: owns tty1 during an unattended install and runs ONE Wayland client
# full screen — Chrome on https://localhost:8443/, which is the install show.
# Read by: systemd, on the live image only.
#
# WHY THIS UNIT EXISTS: the show used to need a full GNOME session, because the
# autostart entry that opens it lives in one. On fiend mid-install (2026-09-12)
# gnome-shell was 530 MB RSS and 326-407% CPU while the installer was writing
# 1678 packages to ZFS — all of it for a screen with nothing to click on. cage
# measured 56 MB RSS and 0.6% CPU showing the same SPA (onyx, 2026-09-12).
#
# WHO STARTS IT: nothing in this file. There is deliberately no [Install]
# section and no ExecCondition=. kldload-kiosk-generator decides at the very
# start of boot, before systemd has built a transaction, and only when the
# answer is yes does it add this unit to multi-user.target and mask tty1's
# other owners (getty@tty1, kldload-live-tui, the display manager).
#
# HISTORY — the decision was made too late, twice, on 2026-09-13:
#   1. Conflicts= on tty1's owners plus ExecCondition=. Conflicts are resolved
#      when the transaction is built; ExecCondition runs much later. Every
#      hands-on USB boot lost GDM and the text installer to a kiosk that then
#      skipped itself.
#   2. No Conflicts=, and the run path stopped getty itself. That never ran:
#      StandardInput=tty-fail is acquired for the ExecCondition process too,
#      getty@tty1 already held tty1, and the unit died with "Failed to set up
#      standard input: Operation not permitted" before any of its code executed
#      (fiend netboot, build 14:54Z). Stopping getty by hand made it start in
#      one second, which is what proved the cause.
# A generator cannot have either fault: what it masks is never started, and a
# boot it says no to is byte-for-byte the boot without this unit.
#
# Consequence if missing: an unattended boot shows the text installer on tty1.
# The install itself is unaffected; only the show is gone.

[Unit]
Description=kldload install show (cage kiosk, no desktop)
Documentation=https://kldload.com/
Documentation=man:cage(1)
After=plymouth-quit.service systemd-user-sessions.service systemd-logind.service

# The show is served by nginx over a unix socket from kldload-webui. Wants, not
# Requires: if the backend is late or broken, cage should still paint and let
# the operator read the connection error, rather than leave a black screen with
# no clue on it. kldload-webui-launch polls the URL for 60s before it gives up.
Wants=nginx.service kldload-webui.service
After=nginx.service kldload-webui.service

# Never on an installed machine, whatever enabled the unit.
ConditionPathExists=!/var/lib/kldload-installer/install-done

# A genuine crash loop has to end somewhere visible: five failures in a minute
# and the unit stays failed. These are [Unit] keys; `systemd-analyze verify`
# ignores them in [Service] (2026-09-12).
StartLimitIntervalSec=60
StartLimitBurst=5

# Failsafe once the restarts above are exhausted: a plain login on tty1. Not
# getty@tty1.service, which the generator has masked for this boot and which
# OnFailure= therefore cannot start.
#
# HISTORY: this used to be OnFailure=getty@tty1.service with the default
# restart mode. A unit passes through "failed" on every crash before it
# restarts, so the FIRST cage crash on fiend (nouveau, no GL renderer) started
# getty, getty took tty1, and every restart after that died on the terminal
# again: one crash turned into a permanent skip (2026-09-13).
OnFailure=kldload-install-kiosk-fallback.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/kldload-install-kiosk run

# A kiosk comes back. Closing the window is not a way out of an install.
Restart=always
RestartSec=2
# direct: an automatic restart does not enter the failed state, so OnFailure=
# fires only when StartLimitBurst gives up, not on the first crash.
RestartMode=direct

User=live
# PAMName is what makes this work at all as a non-root user. The PAM session
# stack (see /etc/pam.d/kldload-kiosk) runs pam_systemd, which registers a
# logind session on seat0 for this VT; libseat then asks logind for the DRM and
# input devices. Without it cage exits immediately with "Could not create
# backend" and Chrome would be left with nowhere to draw.
PAMName=kldload-kiosk
TTYPath=/dev/tty1
StandardInput=tty-fail
StandardOutput=journal
# journal+console for errors only: a fatal line has to reach the screen the
# operator is already looking at, and normal chatter must not scribble over the
# compositor.
StandardError=journal+console
UtmpIdentifier=tty1
UtmpMode=user

# kldload-chrome-app reads XDG_SESSION_TYPE to choose its ozone platform. It
# defaults to "auto" when unset, which is a coin toss; say wayland, because
# cage is a Wayland compositor and there is no X server on this screen.
Environment=XDG_SESSION_TYPE=wayland
Environment=HOME=/home/live
# No keyring here and no gnome-keyring to unlock one: kldload-chrome-app
# already passes --password-store=basic, which is the flag that stops Chrome
# popping a blocking "create a password for your keyring" dialog on a session
# with no keyring daemon.
