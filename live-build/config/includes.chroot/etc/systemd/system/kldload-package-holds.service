# Applies the platform package holds (kernel, ZFS, NVIDIA, shim) and records
# what it pinned to /var/lib/kldload/platform-holds.list, which the web console
# and `kldload-rollback status` read to answer "is this box pinned?".
#
# The After= lines are the whole point of this file. /var/lib/kldload is its OWN
# dataset (rpool/kldload/state), and without ordering this unit ran before
# zfs-mount: the tool wrote the list into the directory UNDERNEATH the
# mountpoint, the dataset then mounted on top, and the file became unreachable.
# The tool logged "[apt] pinned 56 package(s)" and exited 0 the whole time, so
# nothing anywhere reported a problem — `kldload-rollback status` simply said
# "holds have not run" on a machine with 56 holds in force. Seen on .101, .105,
# .111 and .132; every install, both distros, since the state dataset was
# introduced. (2026-08-28)
#
# Same failure shape as the journal: correct work, written somewhere a later
# mount hides. kldload-journal-flush.service carries the identical ordering for
# the identical reason.
[Unit]
Description=Apply KLDload platform package holds
ConditionPathExists=/usr/sbin/kldload-apply-platform-holds
After=zfs-mount.service local-fs.target
Wants=zfs-mount.service
# RequiresMountsFor is the one that actually works, and the reason is subtle.
# /var/lib/kldload is NOT mounted by zfs-mount.service -- it gets a GENERATED
# var-lib-kldload.mount unit, and that activates later. Measured on .105
# 2026-08-28: zfs-mount finished 19:03:16, this unit ran 19:03:17, and
# var-lib-kldload.mount did not go active until 19:03:27. Ten seconds in which
# the ordering above is satisfied and the directory is still bare, so the tool
# wrote platform-holds.list into the underlying directory and the mount covered
# it. The read-back check stayed silent because at write time the file really
# did exist and really was readable -- it only became invisible ten seconds
# later. Ordering on the SERVICE is not ordering on the MOUNT.
RequiresMountsFor=/var/lib/kldload

[Service]
Type=oneshot
ExecStart=/usr/sbin/kldload-apply-platform-holds
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
