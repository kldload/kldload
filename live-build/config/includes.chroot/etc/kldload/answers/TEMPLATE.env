# ─────────────────────────────────────────────────────────────────────────────
# kldload answers file — the complete operator-facing set.
#
# WHAT THIS IS: an unattended install's entire configuration. A netbooting
# machine fetches one of these as its seed (kldload.seed=<url>) and installs
# with no console interaction. The same keys work on the kernel command line
# under short names (disk=, encrypt=, secureboot=, buildimages=, …).
#
# HOW IT IS USED:
#     kldload-netboot-server arm-install <mac> <this-file>
# Arming COPIES the file at that moment. Editing it afterwards changes nothing
# until you re-arm.
#
# WARNING: the password and the ZFS passphrase are in CLEAR here, and the seed
# is served unauthenticated to the LAN while a machine is armed. Disarm when
# the install finishes.
#
# Every key is shown with its default. Commented keys are optional.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────
KLDLOAD_DISTRO=fedora           # fedora debian ubuntu rocky centos rhel arch alpine openbsd
KLDLOAD_PROFILE=desktop         # desktop server kvm core

# The disk to install on. ALWAYS a /dev/disk/by-id path: a kernel name is a
# ticking time bomb the moment a card moves, and this is the one value that
# decides which disk gets repartitioned.
KLDLOAD_DISK=/dev/disk/by-id/CHANGE-ME

# ── Identity ────────────────────────────────────────────────────────────────
KLDLOAD_HOSTNAME=kldload-node
KLDLOAD_USERNAME=admin
KLDLOAD_PASSWORD=CHANGE-ME      # arm-install REFUSES the literal CHANGE-ME
KLDLOAD_TIMEZONE=America/Los_Angeles
KLDLOAD_LOCALE=en_US.UTF-8
#KLDLOAD_KEYBOARD_LAYOUT=us
#KLDLOAD_ADMIN_SSH_PUBKEY=      # authorised key for the admin user

# ── Storage ─────────────────────────────────────────────────────────────────
KLDLOAD_ENABLE_ZFS=1
KLDLOAD_ZFS_ENCRYPT=0           # 1 REQUIRES the passphrase below
#KLDLOAD_ZFS_PASSPHRASE=        # written in clear to the seed AND to
                                # /etc/kldload/zfs-passphrase on the target so
                                # the machine boots unattended: this protects a
                                # stolen disk, not a running host.
#KLDLOAD_ZFS_TOPOLOGY=          # single mirror raidz1 raidz2 …

# ── Boot ────────────────────────────────────────────────────────────────────
# Prepares shim + MOK on the INSTALLED system. Secure Boot must be OFF in
# firmware to netboot at all, because ipxe.efi is unsigned. Turn it on in
# firmware afterwards, and expect the MOK enrolment prompt at that reboot.
KLDLOAD_ENABLE_SECURE_BOOT=0

# ── What converges on first boot ────────────────────────────────────────────
# The template decides which subsystems are wanted. UNSET means zfslab
# defaults apply, and zfslab sets ZERO k8s workers on purpose to leave capacity
# for ZFS test VMs. That is why an install naming no template comes up with
# three control planes and no workers.
#KLDLOAD_TEMPLATE=              # k8s klab zfslab devops ai kvm
#KLDLOAD_K8S_CONTROL_PLANES=3
#KLDLOAD_K8S_WORKERS=           # unset = template default: 3 for
                                # k8s/klab/devops/ai, 0 for zfslab
#KLDLOAD_K8S_BOOTSTRAP=0
#KLDLOAD_ENABLE_K8S=0
#KLDLOAD_ENABLE_AI=0
#KLDLOAD_AI_PULL_MODEL=0        # pull model weights on first boot (GBs)

# Build every golden, klab image and appliance on first boot. Wants 24 GB RAM
# or more. Combined with a k8s bootstrap this is the convergence that has
# reboot-cycled machines: five goldens, a cluster and a model pull racing on
# boot one. Prefer building images on a deploy that is not also bootstrapping
# a cluster.
KLDLOAD_BUILD_IMAGES=0

# ── Netboot ─────────────────────────────────────────────────────────────────
# Retain the kernel, initrd and squashfs this machine installed FROM, so it can
# serve PXE for the rest of the rack. Costs the payload's size on disk.
KLDLOAD_KEEP_NETBOOT=1
