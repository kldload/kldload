# =============================================================================
# kldload answers file — one machine's complete unattended install.
#
# HOW TO USE
#   1. Copy this file, one per machine. Name it by the machine's MAC with dashes,
#      e.g. f0-2f-74-cd-27-50.env, so a directory of them is the estate.
#   2. Fill in the GLOBAL block (every install needs it) and WHAT TO INSTALL.
#   3. Arm it:   sudo kldload-netboot-server arm-install <mac> <this-file>
#      or a whole directory:   sudo kldload-netboot-server arm-all <dir>
#      or a USB seed stick:    ./deploy.sh seed-disk --answers <this-file> --device /dev/sdX
#   4. Netboot the machine (or boot it with the stick). It installs with nobody at
#      the console and reboots into the finished system.
#   5. Disarm:   sudo kldload-netboot-server disarm <mac>
# Arming COPIES the file at that moment: edit, then arm again.
#
# WARNING: passwords here are in clear, and an armed file is served
# unauthenticated to the LAN until you disarm.
#
# FORMAT (read line by line by the installer, not by a shell):
#   KEY=value, one per line, no spaces around =, no export, no $VARIABLES.
#   Comments on their own line only. A comment after a value on the same line
#   is REFUSED, because a value (a password) may contain a # of its own; quote
#   the value when it does.
# =============================================================================

# -- GLOBAL: every install needs these -----------------------------------------
# Distro to install: fedora | debian | ubuntu | rocky | centos | rhel | arch | alpine
KLDLOAD_DISTRO=fedora
# Profile: core | server | desktop | kvm
KLDLOAD_PROFILE=server
# The disk to install on, ALWAYS as /dev/disk/by-id/...: a kernel name like
# /dev/nvme0n1 changes when a card moves, and this disk is wiped.
KLDLOAD_DISK=/dev/disk/by-id/CHANGE-ME
# Hostname (lowercase letters, digits, dashes). Also names the boot environment.
KLDLOAD_HOSTNAME=kldload-node
# Admin user: passwordless sudo, member of wheel, libvirt and kvm.
KLDLOAD_USERNAME=admin
# SECRET. Arming refuses the literal CHANGE-ME.
KLDLOAD_PASSWORD=CHANGE-ME
# rhel only: registration with Red Hat, which RHEL needs for every package (they
# come from Red Hat's CDN, never a mirror). EITHER a portal login OR an activation
# key + org ID; with both, the login wins. Missing, the installer asks on the
# machine's screen before anything is erased. The account needs an active RHEL
# subscription: a lapsed one registers fine and then gets 403 for every repo.
# SECRET (the password and the key): redacted on the installed system, but held
# in clear here and served to the LAN while the machine is armed -- an
# activation key can be revoked without touching the account.
#KLDLOAD_RHEL_USERNAME=
#KLDLOAD_RHEL_PASSWORD=
#KLDLOAD_RHEL_KEY=
#KLDLOAD_RHEL_ORG=
KLDLOAD_TIMEZONE=America/Vancouver
KLDLOAD_LOCALE=en_US.UTF-8
KLDLOAD_KEYBOARD_LAYOUT=us
# 1 encrypts the pool and REQUIRES KLDLOAD_ZFS_PASSPHRASE (see Storage below).
KLDLOAD_ZFS_ENCRYPT=0
# Secure Boot preparation (shim + MOK) on the installed system. Always state it:
# an ABSENT value means 1 to the installer, and a MOK enrolment waits at the
# console on the next boot. Netbooting itself needs Secure Boot OFF in firmware.
KLDLOAD_ENABLE_SECURE_BOOT=0

# -- WHAT TO INSTALL -----------------------------------------------------------
# The first-boot sets. The defaults are a lean machine; switch on what it is for.
# core: set everything here to 0.
# Kubernetes cluster on first boot, with its size.
KLDLOAD_K8S_BOOTSTRAP=0
#KLDLOAD_K8S_CONTROL_PLANES=3
#KLDLOAD_K8S_WORKERS=3
# Build every golden image on first boot (wants 24 GB+ RAM).
KLDLOAD_BUILD_IMAGES=0
# Ollama + Open WebUI.
KLDLOAD_ENABLE_AI=0
# ZFS-test lab.
KLDLOAD_KLAB_ZFS_DEV=0
# Metrics (Prometheus + Grafana).
KLDLOAD_ENABLE_DEVOPS=1
# Keep this machine's boot payload so it can netboot the next one.
KLDLOAD_KEEP_NETBOOT=0

# =============================================================================
# EVERY OTHER OPTION — commented out, shown with the default the installer uses
# when the key is absent (Fedora, kldload-install-target, 2026-09-13 audit).
# Uncomment a line and change the value to use it.
#
# FORMAT RULES (the loader is line-by-line, not a shell):
#   KEY=value on its own line, no spaces around =, no `export`, no $VARS.
#   A comment is a line that STARTS with # in column 0. Never put a comment at
#   the end of a value line — it becomes part of the value. Never indent a comment.
#   Quotes around a value are optional and stripped.
# =============================================================================

# -- Identity -----------------------------------------------------------------
# Keyboard layout written to /etc/vconsole.conf.
#KLDLOAD_KEYBOARD_LAYOUT=us
# SECRET. Root's password; empty leaves root locked.
#KLDLOAD_ROOT_PASSWORD=
# One OpenSSH public key line added to the ADMIN USER's authorized_keys.
#KLDLOAD_SSH_PUBKEY=
# Another OpenSSH public key line for the admin user (merged with the ISO's default keys).
#KLDLOAD_ADMIN_SSH_KEYS=
# One OpenSSH public key line added to ROOT's authorized_keys (not the admin user's,
# despite the name). Empty: the installer generates /etc/kldload/secrets/admin-ssh.
#KLDLOAD_ADMIN_SSH_PUBKEY=

# -- Distro release -----------------------------------------------------------
# Fedora release to install.
#KLDLOAD_FEDORA_RELEASE=44
# EL major version for centos / rocky / rhel.
#KLDLOAD_RELEASE=10
# apt suite codename (debian: trixie, ubuntu: noble).
#KLDLOAD_SUITE=trixie
# Debian only: 0 leaves trixie-backports out of apt sources.
#KLDLOAD_DEBIAN_BACKPORTS=1
# apt mirror URL (debian / ubuntu); a local darksite mirror wins when present.
#KLDLOAD_MIRROR=https://mirror.it.ubc.ca/debian
# dnf only: an extra repository baseurl written to kldload-custom.repo (gpgcheck=0).
#KLDLOAD_CUSTOM_REPO=
# dnf only: 1 keeps upstream repos enabled during an offline install (forced 1 for centos/rocky).
#KLDLOAD_ALLOW_INTERNET_FALLBACK=0
# dnf only: 1 leaves the base repos disabled on the installed system.
#KLDLOAD_KEEP_OFFLINE_REPOS=0
# apt only: 1 together with KLDLOAD_CUSTOM_MIRROR_URL makes that mirror the target's sources.list.
#KLDLOAD_KEEP_DARKSITE=0
#KLDLOAD_CUSTOM_MIRROR_URL=

# -- Storage ------------------------------------------------------------------
# Pool layout: single | mirror | raidz1 | mirror-stripe. Anything but single puts
# rpool on KLDLOAD_ZFS_DATA_DISKS (space-separated whole disks, WIPED, no in-use
# check) and only the ESP on KLDLOAD_DISK.
#KLDLOAD_ZFS_TOPOLOGY=single
#KLDLOAD_ZFS_DATA_DISKS=
# Special vdev: one disk, or a mirror of the first two listed.
#KLDLOAD_ZFS_SPECIAL_DISKS=
# SECRET. Required when KLDLOAD_ZFS_ENCRYPT=1. Stored in clear in this file and in
# /etc/kldload/zfs-passphrase on the target; ZFSBootMenu still prompts at boot.
#KLDLOAD_ZFS_PASSPHRASE=
# EFI system partition size.
#KLDLOAD_ESP_SIZE=2G
# ZFSBootMenu timeout in seconds; 0 = no menu, -1 = wait for a key.
#KLDLOAD_ZBM_TIMEOUT=2
# 1 continues when another importable pool named rpool exists on a non-target disk.
#KLDLOAD_ALLOW_DUPLICATE_POOL_NAME=0
# 1 drops to an interactive shell to build the pool by hand (blocks an unattended install).
#KLDLOAD_STORAGE_MANUAL=0

# -- Network ------------------------------------------------------------------
# dhcp | static. Static requires IP and GW (the install aborts without them).
#KLDLOAD_NET_METHOD=dhcp
#KLDLOAD_NET_IFACE=eth0
#KLDLOAD_NET_IP=
#KLDLOAD_NET_PREFIX=24
#KLDLOAD_NET_GW=
#KLDLOAD_NET_DNS=1.1.1.1,8.8.8.8
# A WiFi profile is written when the SSID is set. PSK is SECRET.
#KLDLOAD_WIFI_SSID=
#KLDLOAD_WIFI_PSK=
# 1 generates a WireGuard wg0 private key and wg0.pub on the target.
#KLDLOAD_WIREGUARD=0

# -- Boot and drivers ---------------------------------------------------------
# auto installs NVIDIA drivers when an NVIDIA display device is present; 1 always, 0 never.
#KLDLOAD_NVIDIA_DRIVERS=auto
# SECRET. MokManager one-time password shown at the enrolment reboot.
#KLDLOAD_MOK_PASSWORD=kldload
# Bring-your-own MOK keypair (paths on the live system). KEY is SECRET.
#KLDLOAD_MOK_KEY_FILE=
#KLDLOAD_MOK_CERT_FILE=

# -- Packages and consoles ----------------------------------------------------
# Adds bpftool, bcc-tools, libbpf-tools, bpftrace and perf.
#KLDLOAD_ENABLE_EBPF=0
# Adds qemu, libvirt and ksmtuned packages.
#KLDLOAD_ENABLE_KVM=0
# Adds containerd and conntrack packages.
#KLDLOAD_ENABLE_K8S=0
# server profile only: 0 disables the web UI, its proxy and ttyd-k9s.
#KLDLOAD_ENABLE_WEBUI=0
# 0 skips the zxplore launchers and units.
#KLDLOAD_ENABLE_ZXPLORE=1

# -- First boot (kldload-autodeploy) ------------------------------------------
# Template: k8s | klab | zfslab | kvm | devops | ai. Empty = inferred from the flags
# below (zfslab if KLAB_ZFS_DEV, k8s if K8S_BOOTSTRAP, kvm if PROFILE=kvm).
#KLDLOAD_TEMPLATE=
# Cluster, AI and the ZFS-test lab are OFF unless asked for (installers built
# before 2026-09-13 defaulted all three ON for every profile except core).
# Bootstrap the Kubernetes cluster on first boot.
#KLDLOAD_K8S_BOOTSTRAP=0
# Install Ollama + Open WebUI (model only per KLDLOAD_AI_PULL_MODEL or the darksite).
#KLDLOAD_ENABLE_AI=0
# ZFS-test lab: infers the zfslab template and ZFS-test goldens.
#KLDLOAD_KLAB_ZFS_DEV=0
# Host Prometheus / Grafana metrics: on for every profile except core.
#KLDLOAD_ENABLE_DEVOPS=1
#KLDLOAD_ZFSLAB_MODE=0
# Cluster size. Workers default: 3 for k8s/klab/devops/ai, 0 for zfslab.
#KLDLOAD_K8S_CONTROL_PLANES=3
#KLDLOAD_K8S_WORKERS=3
# Nodes left running at the end-of-deploy quiesce.
#KLDLOAD_KEEP_CPS=999
#KLDLOAD_KEEP_WORKERS=999
# Build every golden image (lean, desktop, appliances) on first boot; wants 24 GB+ RAM.
#KLDLOAD_BUILD_IMAGES=0
# Also build the ZFS-test goldens when images are built.
#KLDLOAD_BUILD_ZTEST_GOLDENS=0
# 1 never builds klab goldens, whatever else says.
#KLDLOAD_KLAB_NO_AUTO=0
# AI model: pull on first boot (GBs), exact name, tier, vision model, VRAM floor.
#KLDLOAD_AI_PULL_MODEL=0
#KLDLOAD_AI_MODEL=
#KLDLOAD_BOB_MODEL=recommended
#KLDLOAD_PULL_VISION_MODEL=0
#KLDLOAD_MIN_AI_VRAM_GB=8
#KLDLOAD_FORCE_AI=0
#KLDLOAD_AUTODEPLOY_PARALLEL_AI=0

# -- Installer behaviour ------------------------------------------------------
# 1 leaves the finished installer on screen instead of rebooting.
#KLDLOAD_NO_AUTO_REBOOT=0
# Copy this machine's boot payload to the target so it can serve netboot itself.
#KLDLOAD_KEEP_NETBOOT=0
# none | qcow2 | raw | vhd | vmdk | ova — seals and exports the disk image instead
# of leaving a bootable machine. SCP_PASS and SCP_KEY are SECRET.
#KLDLOAD_EXPORT_FORMAT=none
#KLDLOAD_EXPORT_SCP_HOST=
#KLDLOAD_EXPORT_SCP_USER=root
#KLDLOAD_EXPORT_SCP_PATH=/root/
#KLDLOAD_EXPORT_SCP_KEY=
#KLDLOAD_EXPORT_SCP_PASS=
