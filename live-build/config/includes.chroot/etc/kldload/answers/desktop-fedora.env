# Unattended install: ZFS on root, one disk, no extras.
# Unattended install: Fedora desktop, GNOME and the full toolset.
# The minimum that produces a bootable machine. Referenced by name in
# kldload-autoinstall's header since it was written; it did not exist until
# 2026-09-07, because the unit that reads it had never started (its enablement
# symlink pointed at a debz-* name that was renamed away).

KLDLOAD_DISTRO=fedora
KLDLOAD_PROFILE=desktop
# Empty = auto-pick, excluding the live medium and the seed disk.
KLDLOAD_DISK=
KLDLOAD_HOSTNAME=kldload-desktop
KLDLOAD_USERNAME=admin
# CHANGE THIS. It is the login on every machine this file installs.
KLDLOAD_PASSWORD=Passw0rd
KLDLOAD_TIMEZONE=UTC
KLDLOAD_LOCALE=en_US.UTF-8
KLDLOAD_ENABLE_ZFS=1
# Off for unattended work: MOK enrolment needs a human at the console
# confirming in MokManager, and there is no unattended path through it.
KLDLOAD_ENABLE_SECURE_BOOT=0
# Golden images take about an hour of firstboot. Off by default so a netboot
# install finishes in minutes; turn it on where the wait is acceptable.
KLDLOAD_BUILD_IMAGES=0
