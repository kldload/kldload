# Basic deb+zfs server install — single disk, no encryption.
# KLDLOAD_DISK left blank so kldload-autoinstall auto-detects the first available disk
# (/dev/sda, /dev/vda, /dev/nvme0n1 in that order).
# Set explicitly if the target has multiple disks and you need a specific one.
KLDLOAD_PROFILE=server
KLDLOAD_STORAGE_MODE=zfs
KLDLOAD_ENABLE_ZFS=1
KLDLOAD_ENABLE_EBPF=0
KLDLOAD_DISK=
KLDLOAD_HOSTNAME=kldload
KLDLOAD_USERNAME=admin
KLDLOAD_PASSWORD=changeme
KLDLOAD_ROOT_PASSWORD=changeme
KLDLOAD_NET_METHOD=dhcp
KLDLOAD_ZFS_ENCRYPT=0
KLDLOAD_ZFS_TOPOLOGY=single
KLDLOAD_ZFS_ASHIFT=12
KLDLOAD_FORCE_WIPE=1
KLDLOAD_TIMEZONE=UTC
KLDLOAD_LOCALE=en_US.UTF-8
KLDLOAD_KEYBOARD_LAYOUT=us
