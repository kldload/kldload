# AI Appliance — plug in a USB, get a free AI assistant.
#
# Boot this on any x86_64 machine. It auto-detects the disk, installs
# everything, pulls a language model, and reboots into a working AI box.
#
# After reboot:
#   Open WebUI → http://<ip>:8080  (ChatGPT-like interface)
#   SSH        → ssh admin@<ip>     (password: admin)
#   CLI        → kai "your question" (terminal AI with system context)
#
# Requirements: 16GB+ RAM, 40GB+ disk, internet (for model download)
# GPU: NVIDIA auto-detected. Works fine on CPU — just slower.

KLDLOAD_DISTRO=centos
KLDLOAD_PROFILE=desktop
KLDLOAD_STORAGE_MODE=zfs
KLDLOAD_ENABLE_ZFS=1
KLDLOAD_ENABLE_EBPF=1
KLDLOAD_ENABLE_AI=1
KLDLOAD_NVIDIA_DRIVERS=auto
KLDLOAD_DISK=
KLDLOAD_HOSTNAME=ai
KLDLOAD_USERNAME=admin
KLDLOAD_PASSWORD=admin
KLDLOAD_ROOT_PASSWORD=admin
KLDLOAD_NET_METHOD=dhcp
KLDLOAD_ZFS_ENCRYPT=0
KLDLOAD_ZFS_TOPOLOGY=single
KLDLOAD_ZFS_ASHIFT=12
KLDLOAD_FORCE_WIPE=1
KLDLOAD_TIMEZONE=UTC
KLDLOAD_LOCALE=en_US.UTF-8
KLDLOAD_KEYBOARD_LAYOUT=us
