# kexport: format completion
_kexport() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"
    case "$COMP_CWORD" in
        1) # disk device
            COMPREPLY=($(compgen -W "$(lsblk -dno NAME 2>/dev/null | sed 's|^|/dev/|')" -- "$cur"))
            ;;
        2) # format
            COMPREPLY=($(compgen -W "qcow2 vmdk vhd raw ova" -- "$cur"))
            ;;
    esac
}
complete -F _kexport kexport

