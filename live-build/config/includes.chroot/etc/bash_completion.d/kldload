# kbe: list create activate rollback destroy
_kbe() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"
    case "$prev" in
        kbe)
            COMPREPLY=($(compgen -W "list create activate rollback destroy" -- "$cur"))
            ;;
        activate|rollback|destroy)
            # Complete with boot environment names
            COMPREPLY=($(compgen -W "$(zfs list -H -r -o name rpool/ROOT 2>/dev/null | tail -n+2)" -- "$cur"))
            ;;
    esac
}
complete -F _kbe kbe

