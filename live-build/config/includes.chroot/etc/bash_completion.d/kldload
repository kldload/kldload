# kldload bash completions

# ksnap: snap create list rollback destroy all
_ksnap() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"
    case "$prev" in
        ksnap)
            COMPREPLY=($(compgen -W "create list rollback destroy all" -- "$cur"))
            ;;
        rollback|destroy)
            # Complete with snapshot names
            COMPREPLY=($(compgen -W "$(zfs list -H -t snapshot -o name 2>/dev/null)" -- "$cur"))
            ;;
        create)
            # Complete with dataset names
            COMPREPLY=($(compgen -W "$(zfs list -H -o name 2>/dev/null)" -- "$cur"))
            ;;
    esac
}
complete -F _ksnap ksnap

