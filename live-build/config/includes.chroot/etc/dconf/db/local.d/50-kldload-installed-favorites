# The installed-system dock, in the order the icons appear.
#
# Files, Chrome and Terminal are the three things every operator reaches for
# that have nothing to do with kldload. Then the three xplore consoles —
# VMs, ZFS, WireGuard — the estate tools this system exists to run, kept
# adjacent so they read as one family (they share an icon idiom too).
# Metrics and k9s follow: the pair you open *while* something is wrong, so
# they earn a click rather than a trip through Super+A. sysdiag anchors the
# right end — it opens a terminal running the tmux cockpit, which is a
# different job from the plain shell three pins to its left.
#
# Deliberately NOT pinned: Kubernetes (grid, Super+A — a configuration
# surface, opened rarely and on purpose, unlike the two observability tools
# beside it), and every kldload-* tool that vmxplore's kldload tab hosts.
#
# The grid keeps exactly two folders, System and Apps. Everything that is
# not one of those two, or a top-level tool, belongs in one of them.
#
# WARN: this is locked (see locks/) so a stray drag cannot scatter it, which
# also means GNOME Shell only re-reads it on the next login — a change here
# will not appear in a running session.
[org/gnome/shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'google-chrome.desktop', 'org.gnome.Terminal.desktop', 'vmxplore.desktop', 'zxplore.desktop', 'wgxplore.desktop', 'kldload-metrics.desktop', 'kldload-k9s.desktop', 'kldload-sysdiag.desktop']
