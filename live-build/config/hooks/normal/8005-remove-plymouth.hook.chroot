#!/usr/bin/env bash
# Remove Plymouth splash screen — we want to see real boot output.

set -Eeuo pipefail
trap 'echo "8005-remove-plymouth.hook.chroot: FAIL at line $LINENO: $BASH_COMMAND" >&2' ERR

set -e
apt-get purge -y plymouth plymouth-themes 2>/dev/null || true
apt-get autoremove -y 2>/dev/null || true
