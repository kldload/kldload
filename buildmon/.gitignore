# Build artefacts. The GUI binary is ~33MB and the static one ~4MB; neither
# belongs in git, and builder/build-iso.sh compiles both from source anyway.
kldload-buildmon
kldload-buildmon-tui
# `go build ./...` names the executable after the DIRECTORY, not the Makefile
# target, so a bare build in here drops a 33MB "buildmon" that the two rules
# above do not cover.
/buildmon

# `go test` execs its compiled test binary out of TMPDIR, and hardened hosts
# mount /tmp noexec — which fails as an opaque "fork/exec: permission denied"
# that looks like a broken suite. The Makefile points TMPDIR here instead.
.testtmp/
